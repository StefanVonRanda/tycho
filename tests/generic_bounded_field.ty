
struct Box($T):
    xs: bounded[4]$T

struct Tagged($T):
    tag: $T
    ns: bounded[3]int

fn fill(b: inout Box($T), v: $T):
    push(b.xs, v)

fn main():
    xs: bounded[4]int = [1, 2]
    p := Box(xs)
    println("int len=" + str(len(p.xs)) + " head=" + str(p.xs[0]))
    fill(&p, 3)
    println("after push len=" + str(len(p.xs)) + " last=" + str(p.xs[2]))

    ss: bounded[4]string = ["a"]
    q := Box(ss)
    fill(&q, "b")
    println("str len=" + str(len(q.xs)) + " joined=" + q.xs[0] + q.xs[1])

    ns: bounded[3]int = [7, 8]
    t := Tagged("k", ns)
    println("tagged " + t.tag + " len=" + str(len(t.ns)) + " head=" + str(t.ns[0]))
