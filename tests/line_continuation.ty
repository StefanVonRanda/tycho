
fn add3(a: int, b: int, c: int) -> int:
    return a + b + c

fn main():
    # arithmetic, continued at a deeper indent
    x := 1 +
            2 +
        3
    println(str(x))

    # a comparison operator, and a comment after the operator: the comment is
    # not a token, so the continuation still sees `<` as the last one
    small := x <      # keep going
        100
    println(str(small))

    # `and` / `or` are words, but they are operators here
    both := small and
        x > 0
    println(str(both))

    # a trailing comma inside a call argument list -- brackets already joined
    # this one; it is here so the two mechanisms are exercised together
    s := add3(1,
              2,
              3)
    println(str(s))

    # `:=` itself continues, so the value may start on the next line
    y :=
        x * 2
    println(str(y))

    # a line that ends on a VALUE still terminates: these are two statements,
    # not one continued expression
    a := 5
    b := 6
    println(str(a + b))

    # a block header still ends its line -- `:` is excluded from the rule
    if a < b:
        println("lt")
