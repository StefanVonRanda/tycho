struct Box($T):
    items: [$T]

fn empty() -> Box($T):
    return Box([]$T)

fn put(b: inout Box($T), v: $T):
    push(b.items, v)

fn main():
    bs := empty$(string)()
    put(&bs, "a")
    put(&bs, "b")
    bi := empty$(int)()
    put(&bi, 7)
    println(str(len(bs.items)) + " " + str(len(bi.items)) + " " + bs.items[0] + " " + str(bi.items[0]))
