
const B31      = 2147483647 + 1              # 2^31      = 2147483648
const B31_MUL  = 65536 * 32768               # 2^31      = 2147483648
const B32      = 2147483648 * 2              # 2^32      = 4294967296
const B32_SHL  = 1 << 32                     # 2^32      = 4294967296
const B32_MUL  = 65536 * 65536               # 2^32      = 4294967296
const IMAX     = 9223372036854775807         # 2^63 - 1  (largest legal literal)
const IMIN     = -9223372036854775807 - 1    # -2^63     (must be computed)
const IMAX_M1  = 9223372036854775807 - 1
const WRAP_HI  = 9223372036854775807 + 1     # wraps to -2^63 (defined, spec 5.2.1)
const WRAP_LO  = (-9223372036854775807 - 1) - 1   # wraps to 2^63-1
const P62      = 1 << 62
const P63_NEG  = 1 << 63                     # 2^63 has no positive int -> -2^63
const DIV_BIG  = 4294967296 / 65536          # 65536
const MOD_BIG  = 4294967296 % 1000000007

fn main():
    println(str(B31))         # 2147483648
    println(str(B31_MUL))     # 2147483648
    println(str(B32))         # 4294967296
    println(str(B32_SHL))     # 4294967296
    println(str(B32_MUL))     # 4294967296
    println(str(IMAX))        # 9223372036854775807
    println(str(IMIN))        # -9223372036854775808
    println(str(IMAX_M1))     # 9223372036854775806
    println(str(WRAP_HI))     # -9223372036854775808
    println(str(WRAP_LO))     # 9223372036854775807
    println(str(P62))         # 4611686018427387904
    println(str(P63_NEG))     # -9223372036854775808
    println(str(DIV_BIG))     # 65536
    println(str(MOD_BIG))     # see golden
