struct Holder:
    pair: (float, u8)

fn ret_pair() -> (float, u8):
    return (1, 2)

fn take_pair(p: (float, u8)) -> u8:
    return p.1

fn main():
    p: (float, u8) = (1, 2)
    println(str(p.0) + "," + str(p.1))

    q: (f32, i8) = (1.5, 7)
    println(str(q.0) + "," + str(q.1))

    r := ret_pair()
    println(str(r.0) + "," + str(r.1))
    println(str(take_pair((1, 3))))

    h := Holder((1, 4))
    println(str(h.pair.0) + "," + str(h.pair.1))

    xs := [] (float, u8)
    push(xs, (1, 5))
    println(str(xs[0].0) + "," + str(xs[0].1))

    o: Option((float, u8)) = Some((1, 6))
    println(str(o is Some))
    match o:
        Some(v):
            println(str(v.0) + "," + str(v.1))
        None:
            println("none")
