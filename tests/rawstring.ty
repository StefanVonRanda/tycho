# Backtick raw string literals -- `...`.
#
# HISTORY: this fixture was written into tests/postfreeze/ on 2026-07-29, because
# the frozen compiler/tychoc0.ty has no backtick token at all and refused the
# character outright, and that directory was the one the two tychoc0-derived
# lanes never globbed. Those lanes were retired the same day and the fixture came
# home to tests/, where the main golden loop scores it.
#
# Semantics under test (lexer: src/tychoc.c:463-510):
#   - no escape is interpreted -- a backslash is a backslash;
#   - an embedded newline is a literal newline byte, so the form is genuinely
#     multi-line;
#   - there is no escape for a backtick, so a raw literal cannot contain one;
#   - a raw piece MAY join with an adjacent normal piece, because the scanner
#     stores re-escaped text and the join at src/tychoc.c:2306-2318 is sound on
#     any text whose escapes are all exactly two characters.

fn main():
    # 1. single-line: an ordinary `string` value.
    a := `hello raw`
    println(a)
    println(str(len(a)))

    # 2. no escape is interpreted: the two characters \ and n stay two
    #    characters. The normal literal it is compared against needs \\ to say
    #    the same thing, which is the whole point of the form.
    b := `a\nb`
    println(b)
    println(str(len(b)))
    println(str(b == "a\\nb"))

    # 3. three source lines, two literal newline bytes.
    c := `one
two
three`
    println(c)
    println(str(len(c)))
    println(str(c == "one\ntwo\nthree"))

    # 4. adjacent-literal join, both orders. `"a" "b"` is one literal "ab"
    #    (src/tychoc.c:2306-2318) and a raw piece takes part.
    d := `raw ` "and normal"
    println(d)
    e := "normal and " `raw`
    println(e)

    # 5. a raw literal ending in a backslash: nothing escapes the closing
    #    backtick, so this is the four bytes  C : \ .
    f := `C:\`
    println(f)
    println(str(len(f)))

    # 6. a double quote needs no escape inside a raw literal.
    g := `he said "hi"`
    println(g)
    println(str(len(g)))
