# A method nothing answers on a builtin type was typed `?` and passed the checker;
# the C emitter then refused it with no line ("unsupported call"). Found in
# Urani: `c.scrolls.remove_key(k)` (the map form is `delete m[k]`).
struct C:
    m: [int: float]

fn main():
    c := C([1: 2.0])
    c.m.remove_key(1)
    println(str(len(c.m)))
