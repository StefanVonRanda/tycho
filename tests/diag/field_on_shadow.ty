# A later `sc := ...` in an inner block hides the outer `sc` of another type;
# `.field` on it then fails far from the declaration that caused it. The note
# names both declarations (found in Urani's main loop: the sun colour hid the
# script).
struct Script:
    on: bool

fn main():
    sc := Script(true)
    for i := 0; i < 1; i += 1:
        sc := [0.5, 0.5]
        if sc.on:
            println("on")
