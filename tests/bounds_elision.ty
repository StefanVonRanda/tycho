fn main():
    a := []int
    for i := 0; i < 20; i += 1:
        push(a, i * 3)

    # read elision
    s := 0
    for i := 0; i < len(a); i += 1:
        s = s + a[i]

    # in-place write elision (a[i] = ...), then read under an `if`
    for i := 0; i < len(a); i += 1:
        a[i] = a[i] + 1
    t := 0
    for i := 0; i < len(a); i += 1:
        if a[i] > 30:
            t = t + a[i]

    # nested loops over two distinct arrays — inner indexes b, outer indexes a;
    # neither array is reassigned or passed to a call, so both elide
    b := []int
    for i := 0; i < 5; i += 1:
        push(b, i + 100)
    cross := 0
    for i := 0; i < len(a); i += 1:
        for j := 0; j < len(b); j += 1:
            cross = cross + a[i] * b[j]

    println("s=" + str(s))
    println("t=" + str(t))
    println("cross=" + str(cross))
