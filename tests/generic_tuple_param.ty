
struct Holder($T):
    p: (int, T)

fn second(p: (int, $T)) -> T:          # match_type must descend into the tuple
    return p.1

fn mk(x: $T) -> (int, T):              # subst_type must rebuild the return tuple
    return (1, x)

fn swap(p: ($A, $B)) -> (B, A):        # two parameters, both inside one tuple
    return (p.1, p.0)

fn label(n: int) -> string:
    return "s" + str(n)

fn main():
    # 1. a tuple parameter that mentions $T, at a scalar and a heap element
    println(str(second((1, 7))))                   # 7
    println(second((1, label(2))))                 # s2

    # 2. a tuple RETURN built inside the generic
    t := mk(5)
    println(str(t.0) + " " + str(t.1))             # 1 5
    u := mk(label(3))
    println(str(u.0) + " " + u.1)                  # 1 s3

    # 3. two type parameters inside one tuple, order swapped by the instance
    w := swap((9, "nine"))
    println(w.0 + " " + str(w.1))                  # nine 9

    # 4. a generic STRUCT whose field type is a tuple mentioning $T
    h := Holder((4, label(4)))
    println(str(h.p.0) + " " + h.p.1)              # 4 s4

    # 5. a nested tuple: the descent must be recursive, not one level
    n := second((0, (2, 3)))
    println(str(n.0 + n.1))                        # 5
