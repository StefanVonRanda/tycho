# push(xs, b): append every byte of a `bytes` as one [int] element, in order.
# Covers a non-empty target, a packed struct with high bytes, an empty source,
# and growth past one doubling. Then the same inside loops, which cache an
# array's spine in locals: the bulk append once wrote around that cache and the
# loop's write-back erased everything it appended (FRICTION 229). And
# push([u8], b), the byte-builder form: the bytes as they are.
# Pushes onto an inout array in a loop fuse too (its spine cached, written back
# after the loop) -- unless the loop can leave the function early, which would
# skip the write-back: these must keep every push made before the exit.
fn fill_until(xs: inout [int], n: int, stop: int):
    for i := 0; i < n; i += 1:
        push(xs, i)
        if i == stop:
            return

fn fill_break(xs: inout [int], n: int, stop: int):
    for i := 0; i < n; i += 1:
        push(xs, i)
        if i == stop:
            break
    push(xs, 99)

fn fill_nested(xs: inout [int]):
    for i := 0; i < 3; i += 1:
        for j := 0; j < 2; j += 1:
            push(xs, 10 * i + j)
            if j == 1 and i == 2:
                return

fn three(i: int) -> Result(int, string):
    if i == 3:
        return Err("three")
    return Ok(i)

fn fill_or_return(xs: inout [int]) -> Result(int, string):
    for i := 0; i < 10; i += 1:
        push(xs, i)
        v := three(i) or_return
        if v < 0:
            println("never")
    return Ok(0)

packed struct Rec:
    tag: u8
    n: i32

fn main():
    xs := [7, 8]
    push(xs, to_bytes("AB"))
    println(str(len(xs)) + " " + str(xs[0]) + " " + str(xs[1]) + " " +
        str(xs[2]) + " " + str(xs[3]))

    push(xs, to_bytes(Rec(to_u8(1), to_i32(-2))))
    ln := len(xs)
    println(str(ln) + " " + str(xs[4]) + " " + str(xs[5]) + " " + str(xs[6]) +
        " " + str(xs[7]) + " " + str(xs[8]))

    e := to_bytes("")
    push(xs, e)
    println(str(len(xs)))

    big := []int
    i := 0
    for i < 4096:
        push(big, i % 251)
        i += 1
    push(xs, to_bytes(big))
    sum := 0
    for v in xs:
        sum += v
    println(str(len(xs)) + " " + str(xs[0]) + " " + str(xs[len(xs) - 1]) + " " + str(sum))

    # in a loop, alone and interleaved with single pushes, and nested
    lp := []int
    for k := 0; k < 1000; k += 1:
        push(lp, to_bytes("xyz"))
    mixed := []int
    for k := 0; k < 100; k += 1:
        push(mixed, k)
        push(mixed, to_bytes("c"))
        for j := 0; j < 2; j += 1:
            push(mixed, to_bytes("z"))
    println(str(len(lp)) + " " + str(lp[2999]) + " " + str(len(mixed)) + " " + str(mixed[4]) + " " + str(mixed[399]))

    # [u8]: each byte as itself
    ub := []u8
    push(ub, to_bytes("AB"))
    push(ub, to_u8(0))
    push(ub, to_bytes(Rec(to_u8(1), to_i32(-2))))
    for k := 0; k < 1000; k += 1:
        push(ub, to_bytes("q"))
    println(str(len(ub)) + " " + str(ub[0]) + " " + str(ub[2]) + " " + str(ub[4]) + " " + str(ub[len(ub) - 1]) +
        " " + str(len(to_bytes(ub))))

    fa := [7]
    fill_until(&fa, 10, 4)
    fb := [7]
    fill_break(&fb, 10, 2)
    fc := []int
    fill_nested(&fc)
    fd := [7]
    match fill_or_return(&fd):
        Ok(_): println("unexpected")
        Err(e): println(str(fa) + " " + str(fb) + " " + str(fc) + " " + e + " " + str(fd))
