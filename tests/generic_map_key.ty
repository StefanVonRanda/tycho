struct P:
    x: int
    y: int

fn distinct(xs: [$K]) -> int where hashable(K):
    m := []$K: int
    for x in xs:
        m[x] = 1
    return len(m)

fn evens(xs: [$T], f: fn($T) -> bool) -> [$T]:
    out := []$T
    for x in xs:
        if f(x):
            push(out, x)
    return out

fn main():
    println(str(distinct(["a", "b", "a"])))
    println(str(distinct([1, 2, 2, 3])))
    println(str(distinct([P(1, 2), P(1, 2), P(3, 4)])))
    println(str(len(evens([1, 2, 3, 4], fn(n: int) -> bool: n % 2 == 0))))
