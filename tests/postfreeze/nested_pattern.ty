# CANARY for the post-freeze fixture lane.
#
# This directory exists for fixtures that exercise syntax the LIVE compiler
# accepts and the FROZEN `compiler/tychoc0.ty` does not. `tests/run.sh` runs it
# (its own loop, goldens at tests/postfreeze/<name>.out); `compiler/fixpoint.sh`
# and `scripts/frontparity.sh` deliberately never glob it, because both feed
# their corpus to a tychoc0-derived binary that predates the syntax below.
#
# The canary itself is a NESTED PATTERN (docs/spec/10-statements.md:47-55): an
# `Ok`/`Err`/`Some` arm refining its single payload with one nested pattern.
# docs/spec/appendix-e-conformance.md:150 records §14.3.1 as having no `tests/`
# fixture for exactly this reason, and `scripts/frontparity.sh` records
# `examples/corelib/result/main.ty` being held out of the parity lane over it.
#
# Its job is to FAIL LOUDLY if this directory ever leaks into a tychoc0 lane.
# Measured, not assumed: a tychoc0 built at HEAD (`./tychoc compiler/tychoc0.ty
# -o /tmp/h0`) refuses this file with `parse: line 34: unexpected token` — line
# 34 is the `Err(TooBig(n))` arm, the nested pattern that also binds. (Line 33's
# `Err(NotFound)` alone does NOT redden tychoc0: its grammar reads that as a
# payload BINDING named `NotFound`, which is precisely the "never silently read
# as a binding" rule at docs/spec/10-statements.md:61-64. The payload-carrying
# nested pattern is the one its grammar cannot spell, so the canary carries it.)
# If either tychoc0 gate ever starts globbing tests/postfreeze/, it reddens here.

enum Why:
    NotFound
    IsDir
    TooBig(int)

fn describe(r: Result(int, Why)) -> string:
    match r:
        Ok(n): return "ok " + str(n)
        Err(NotFound): return "no such thing"
        Err(TooBig(n)): return "too big by " + str(n)
        _: return "other"

fn main():
    println(describe(Ok(7)))
    println(describe(Err(NotFound)))
    println(describe(Err(TooBig(3))))
    println(describe(Err(IsDir)))
