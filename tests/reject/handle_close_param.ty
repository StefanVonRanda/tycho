# src/tychoc.c@close_param_check -- a handle parameter is a borrow (spec §25,
# "Borrow on pass"). close(h) in the callee nulls only its own copy of the
# pointer, so the caller's scope-exit free ran the destructor a second time: a
# double free. Only the owning scope may close a handle.
# expect: 'h' is a handle parameter -- the caller owns it
handle H:
    free: hc

extern fn ho(i: int) -> H
extern fn hc(h: H) -> int

fn done(h: H):
    close(h)

fn main():
    h := ho(1)
    done(h)
