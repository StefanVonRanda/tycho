# src/tychoc.c:6931 -- wait(t) joins exactly one task.
# tychoc1 ACCEPTED this under --typecheck and died only in codegen
# (`unsupported call 'wait' with 2 argument(s)`) until the arity check was
# ported into compiler/types/tcheck.ty; both now word it identically.
# expect: wait(t) takes one task
fn work() -> int:
    return 1
fn main():
    t := spawn work()
    x := wait(t, 1)
    println(str(x))
