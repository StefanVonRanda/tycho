# main's ok payload must be void. `Result(int, string)` would make the exit
# status ambiguous -- is the int a status, or a value nobody reads? -- so the
# shape is refused rather than given a meaning nobody asked for.
#
#   error: 'main' returns nothing or Result(void, string), not Result(int, string)
fn main() -> Result(int, string):
    return Ok(0)
