# tychoc roots its DFS at every struct in declaration order, so A greys the
# Option BEFORE B is entered and the cycle closes on that node, not on B.
# tychoc1 three-colours the same graph now, so the whole message is pinned.
# expect: infinite type: an Option contains itself by value — use Option([T]) for indirection
# src/tychoc.c:13005
struct A:
    b: Option(B)

struct B:
    x: Option(B)

fn main():
    println("unreachable")
