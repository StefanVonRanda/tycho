# src/tychoc.c:6235 -- taking a fn with an inout parameter AS A VALUE. The
# sibling tests/reject/inout_fnvalue.ty is the other direction: a fn value
# passed AS an inout parameter.
# expect: 'bump' has an inout parameter, so it can't be a function value
fn bump(a: inout int):
    a = a + 1

fn main():
    f := bump
    n := 1
    f(n)
    println(str(n))
