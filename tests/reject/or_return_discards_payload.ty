# expect: here produces int, which this statement discards
# `or_return` as a bare statement is only legal when the ok payload is void;
# otherwise it would silently drop the value it unwrapped.
fn g() -> Result(int, string):
    return Ok(1)
fn f() -> Result(void, string):
    g() or_return
    return Ok()
fn main():
    match f():
        Ok: println("ok")
        Err(e): println(e)
