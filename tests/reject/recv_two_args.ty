# src/tychoc.c:6884 -- recv takes exactly one channel.
# tychoc1 ACCEPTED this under --typecheck until the arity check was ported
# into compiler/types/tcheck.ty; both now word it identically.
# expect: recv(ch) takes one channel
fn main():
    ch := channel(int, 1)
    match recv(ch, 1):
        Some(x): println(str(x))
        None: println("none")
