# src/tychoc.c:8430 -- a nested pattern refines a payload by VARIANT, so the
# payload has to be an enum. Here it is an int.
# expect: a nested pattern needs an enum payload, but Ok here carries int
fn mk() -> Result(int, string):
    return Ok(1)

fn main():
    match mk():
        Ok(Foo(x)): println(str(x))
        Err(e): println(e)
