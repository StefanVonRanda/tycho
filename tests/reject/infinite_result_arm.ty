# tychoc roots its DFS at every struct in declaration order, so A greys the
# Result BEFORE B is entered and the cycle closes on that node, not on B.
# tychoc1 three-colours the same graph now, so the whole message is pinned.
# expect: infinite type: a Result contains itself by value — use indirection (e.g. Result([T], E))
# src/tychoc.c:12848
struct A:
    b: Result(B, string)

struct B:
    x: Result(B, string)

fn main():
    println("unreachable")
