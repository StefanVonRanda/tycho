# src/tychoc.c:7069 -- reserve's argument must be rooted at a variable.
# tychoc1 ACCEPTED this under --typecheck until the check was ported into
# compiler/types/tcheck.ty; both now word it identically.
# expect: reserve's first argument must be an array variable or field
fn mk() -> [int]:
    return [1, 2]

fn main():
    reserve(mk(), 8)
