# src/tychoc.c:8724 -- the plain-enum twin of match_bind_payload_variant: `A(Q)`
# would bind a name that is already a variant of the payload enum, and match every A.
# expect: 'Q' is a variant of Inner, not a binding name
enum Inner:
    P(int)
    Q

enum E:
    A(Inner)
    B

fn main():
    e := A(Q)
    match e:
        A(Q): println("q")
        B: println("b")
