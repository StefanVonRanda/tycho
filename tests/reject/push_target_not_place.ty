# src/tychoc.c:7114 -- push's first argument must bottom out at a variable, not
# at a call result. tychoc1 ACCEPTED this until the rule was ported into
# compiler/types/tcheck.ty; both now word it identically.
# expect: push's first argument must be an array variable or field
fn f() -> [int]:
    return []int
fn main():
    push(f(), 1)
    println("x")
