# The scalar-arm parser is entered by `1 | ...`, and the SET separator is `|`,
# not `,` -- which is why R21d could not reach this rule and left it in [c].
# src/tychoc.c:3543. Both compilers word it identically.
# expect: a match arm must be a variant name, a scalar literal, a range, or `_`
fn main():
    x := 1
    match x:
        1 | "a":
            println("y")
        _:
            println("n")
