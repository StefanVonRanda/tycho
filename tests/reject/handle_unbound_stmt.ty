# src/tychoc.c@resolve_expr -- the same rule as
# tests/reject/handle_unbound_arg.ty, in the shape that leaks most quietly: an
# opener called for effect, its result dropped on the floor. Tycho makes an
# unused `int` a hard error ('x' declared and not used); before this check it
# accepted a leaked OS resource. Measured: five gave 15 opens / 5 closes.
# expect: is a handle and must be bound to a variable
handle R:
    free: hc
extern fn ho(i: int) -> R
extern fn hc(h: R) -> int

fn main():
    ho(1)
    println("unreachable by the gate")
