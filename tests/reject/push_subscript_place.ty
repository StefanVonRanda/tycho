# src/tychoc.c:7994 -- push's first argument must bottom out at a variable, not
# at a subscript call: the reference never inlines subscripts before this
# check, so a projection is refused even though it names a place.
# tychoc1 ACCEPTED this until the root walk was ported into
# compiler/types/tcheck.ty (_root_ident: Field/Index only); both now word it
# identically.
# expect: push's first argument must be an array variable or field
struct C:
    fs: [[int]]

subscript fr(c: C, i: int) -> inout [int]:
    yield &c.fs[i]

fn main():
    g := C([[]int])
    push(g.fr(0), 1)
    println("x")
