# 02-grammar.md:97 / 12-aggregates.md:484 / 03-types.md:232: an enum variant
# carries "a payload of zero to eight types". src/tychoc.c:3841. This one has 9.
enum E:
    V(int, int, int, int, int, int, int, int, int)
    W

fn main():
    e := V(0, 1, 2, 3, 4, 5, 6, 7, 8)
    match e:
        V(x0, x1, x2, x3, x4, x5, x6, x7, x8):
            print(str(x0))
        W:
            print("w")
