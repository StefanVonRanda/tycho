# src/tychoc.c:6254 -- a payload-carrying variant written bare is not a value.
# The match below exists so tychoc1 reaches the rule rather than dying first on
# `'e' declared and not used`.
# expect: A carries a payload — write A(...)
enum E:
    A(int)
    B
fn main():
    e := A
    match e:
        A(n): println(str(n))
        B: println("b")
