# src/tychoc.c:8580 -- every branch dies, so the value if/match has no tail to
# bind and the local would be declared void.
# expect: every branch of this value if/match diverges, so there is no value to bind to 'x' -- write the if/match as a plain statement
fn main():
    x := if true:
        die("a")
    else:
        die("b")
    println(str(x))
