# src/tychoc.c:5977 -- a grounding use whose type cannot stand as a value. The
# COMPOSITION is what fails: push composes arr(void), so a bare void test misses it.
# tychoc1 ACCEPTED this until _pend_ground was ported.
# expect: cannot infer the type of 'xs' from this use
fn nop():
    print("x")

fn main():
    xs := []
    push(xs, nop())
