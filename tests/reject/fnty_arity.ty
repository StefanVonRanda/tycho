# 02-grammar.md:170 / 03-types.md:246: "A function type has up to 8 parameters."
# src/tychoc.c:1806. This one has 9.
fn g(a0: int, a1: int, a2: int, a3: int, a4: int, a5: int, a6: int, a7: int, a8: int) -> int:
    return a0

fn main():
    f: fn(int, int, int, int, int, int, int, int, int) -> int = g
    print(str(f(0, 1, 2, 3, 4, 5, 6, 7, 8)))
