# The lifted proc takes [captures][params] and the arity is bounded. Nine
# parameters is one past the ceiling. src/tychoc.c:6069.
# expect: a lambda has at most 8 parameters
fn main():
    f := fn(a: int, b: int, c: int, d: int, e: int, g: int, h: int, i: int, j: int): a + b + c + d + e + g + h + i + j
    println(str(f(1, 2, 3, 4, 5, 6, 7, 8, 9)))
