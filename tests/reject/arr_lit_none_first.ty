# src/tychoc.c:6328 -- the first element fixes the array's type, and a bare None
# names no Option. With a DECLARED element type it is fine, which is why this
# fixture must not annotate: `xs: [Option(int)] = [None, Some(1)]` compiles.
# expect: cannot infer the array's element type from None
fn main():
    xs := [None, Some(1)]
    println(str(len(xs)))
