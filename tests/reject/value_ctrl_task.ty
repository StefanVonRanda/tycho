# src/tychoc.c:8438 -- a Task is affine and scope-bound; binding one through a
# value if/match would hand it out of the arm it was spawned in. tychoc1
# ACCEPTED this before 2026-09-03.
# expect: a value if/match cannot produce a task handle
fn work() -> int:
    return 1

fn main():
    t := if true:
        spawn work()
    else:
        spawn work()
    println(str(wait(t)))
