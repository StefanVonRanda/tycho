# tychoc roots its DFS at every struct in declaration order, so A greys the
# tuple BEFORE B is entered and the cycle closes on that node, not on B.
# tychoc1 three-colours the same graph now, so the whole message is pinned.
# expect: infinite type: a tuple contains itself by value
# src/tychoc.c:13010
struct A:
    b: (B, int)

struct B:
    x: (B, int)

fn main():
    println("unreachable")
