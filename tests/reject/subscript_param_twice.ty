# A subscript parameter may appear at most once in the yielded place (v1), so an
# argument is never double-evaluated on substitution.
# expect: is used more than once in the yielded place
struct G:
    a: [[int]]
subscript bad(g: G, i: int) -> inout int:
    yield &g.a[i][i]
fn main():
    print("x")
