# src/tychoc.c:6283 -- or_return on an Option propagates None, which only an
# Option-returning function can do.
# expect: or_return on an Option requires the enclosing function to return an Option, but it returns int
fn g() -> Option(int):
    return Some(1)

fn f() -> int:
    v := g() or_return
    return v

fn main():
    println(str(f()))
