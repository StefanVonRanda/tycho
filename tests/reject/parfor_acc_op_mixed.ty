# src/tychoc.c:7995 -- a chunk's private partial is seeded from the op's identity,
# so + and * on one name have no single seed.
# expect: accumulator 't' must use one reduction op consistently
fn main():
    t := 1
    parallel for i in 0..<3:
        t = t + i
        t = t * i
    println(str(t))
