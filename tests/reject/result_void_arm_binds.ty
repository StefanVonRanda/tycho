# An `Ok(v)` arm on a void payload. The arm shape follows the constructor: a
# void payload is built by `Ok()` and matched by a bare `Ok:`, the same as a
# fieldless enum variant, so a binding name here has nothing to name.
#
# Caught in the resolver, not the parser: only the resolver knows the scrutinee's
# ok type. The codegen side of the same rule is a `plain` arm with no binds[0] to
# read -- gen_match_side emits the body and binds nothing.
#
#   error: Ok carries no value here -- write a bare `Ok:` arm
fn f() -> Result(void, string):
    return Ok()

fn main():
    match f():
        Ok(v):
            println("ok")
        Err(e):
            println(e)
