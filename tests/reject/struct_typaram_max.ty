# 05-generics.md:20: 16 type parameters per generic -- structs included.
# src/tychoc.c:3736. 17 SLOTS here (one repeated name, so the distinct-name cap
# at :1714 is not what fires).
struct Box($T, $T, $T, $T, $T, $T, $T, $T, $T, $T, $T, $T, $T, $T, $T, $T, $T):
    f: $T

fn main():
    b := Box(1)
    print(str(b.f))
