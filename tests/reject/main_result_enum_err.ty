# expect: 'main' returns nothing or Result(void, string), not Result(void, Fault) -- an Err reaching the entry point is printed, so the error type is the message. For a status other than 0 or 1 (diff(1)'s 0/1/2, say), call the `exit(code)` builtin
enum Fault:
    Io
    Bad(string)

fn main() -> Result(void, Fault):
    return Err(Io)
