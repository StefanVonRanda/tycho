# main's error type must be `string`. An Err reaching the entry point is PRINTED,
# and `has_str` (src/tychoc.c) covers int/bool/float/string and no enum -- so an
# enum error would arrive at the exit path with nothing to print. The error IS
# the message.
#
#   error: 'main' returns nothing or Result(void, string), not Result(void, Fault)
enum Fault:
    Io
    Bad(string)

fn main() -> Result(void, Fault):
    return Err(Io)
