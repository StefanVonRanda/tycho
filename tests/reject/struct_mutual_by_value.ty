# Types are order-free (tests/type_forward_ref.ty), so `struct A` naming `B` and
# `struct B` naming `A` now PARSES. A value-semantic language cannot store two
# structs inside each other, so the pair must still be refused -- by the
# containment DFS, with the same infinite-type message a direct self-reference
# gets. Order-freedom made this expressible; it must not make it accepted.
# expect: infinite type
# expect: contains itself by value

struct A:
    b: B
    n: int

struct B:
    a: A
    n: int

fn main():
    println("unreachable")
