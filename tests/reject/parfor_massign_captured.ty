# src/tychoc.c:7876 -- the DESTRUCTURING arm. A single `a = ...` is diverted to the
# reduction rule at src/tychoc.c:7888; a multi-assign has no reduction form at all,
# and the message names the first offending name.
# expect: parallel for cannot assign to captured variable 'a'
fn two() -> (int, int):
    return (1, 2)

fn main():
    a := 0
    b := 0
    parallel for i in 0..<3:
        a, b = two()
    println(str(a + b))
