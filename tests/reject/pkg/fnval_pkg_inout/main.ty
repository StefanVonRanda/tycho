# src/tychoc.c:6848@inout -- the qualified twin of the bare-name rule at src/tychoc.c:6674@inout. A fn
# value is called through a pointer, so an inout parameter has no place to bind.
# expect: 'lib.bump' has an inout parameter, so it can't be a function value
package main
import "lib"

fn main():
    f := lib.bump
    n := 1
    f(&n)
    println(str(n))
