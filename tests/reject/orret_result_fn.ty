# src/tychoc.c:6181 -- or_return on a Result propagates Err, which only a
# Result-returning function can do. The Option twin is orret_option_fn.ty.
# expect: or_return requires the enclosing function to return a Result, but it returns int
fn g() -> Result(int, string):
    return Ok(1)

fn f() -> int:
    v := g() or_return
    return v

fn main():
    println(str(f()))
