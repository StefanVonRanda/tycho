# src/tychoc.c:8040 -- `parallel for x in EXPR` lifts the body over a collection,
# so an int is not a source. The parallel form's set is NARROWER than the
# sequential one: an array, a string or a channel, and not bytes, a map or a soa.
# expect: parallel for expects an array, string, or channel
fn main():
    n := 5
    parallel for x in n:
        println(str(x))
