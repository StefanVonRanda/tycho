fn main():
    lo := "abc"
    sp := "   "
    a  := [char_at(lo, 0), char_at(lo, 1), char_at(lo, 2)]   # ['a','b','c']
    sh := [char_at(sp, 0), char_at(sp, 1), char_at(sp, 2)]   # three 0x20 bytes

    # element-wise `-` on [char]: subtract the case bit, three chars at a time
    up := a - sh
    println(str(up[0] == 'A') + "," + str(up[1] == 'B') + "," + str(up[2] == 'C'))

    # element-wise `+` on [char]: and back again
    back := up + sh
    println(str(back[0] == 'a') + "," + str(back[1] == 'b') + "," + str(back[2] == 'c'))

    s := ""
    for i := 0; i < 3; i += 1:
        s = s + up[i]
    println(s)
