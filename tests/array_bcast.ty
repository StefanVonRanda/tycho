# Scalar broadcast on arrays: `a OP s` and `s OP a` build a fresh array whose
# i-th element is `a[i] OP s` (resp. `s OP a[i]`). Post-freeze -- the frozen
# tychoc0 refuses every line of this file as a type error, which is why it lives
# here rather than in tests/.
#
# The operator set is the SAME one array-OP-array derives, because the rule is
# the same: `a OP s` is legal iff `a[i] OP s` is legal for the element type.
#   int, u8..u64/i8..i64   + - * / %
#   float, f32             + - * /
#   newtype over int/float + - * /
#   char                   + -
#
# Two things this file exists to catch, neither of which "it compiled" would:
#
#  1. A QUIET SWAP. `-`, `/` and `%` are not commutative, so an implementation
#     that normalises `s OP a` into `a OP s` would still typecheck and still
#     produce an array of the right length. Every non-commutative operator below
#     is therefore printed in BOTH orders with operands chosen so the two
#     answers differ, and differ visibly: `2 - [5,1]` is [-3, 1] and
#     `[5,1] - 2` is [3, -1] -- a swap turns one into the other.
#  2. AN OFF-BY-ONE or a mis-sized allocation, which yields plausible garbage
#     rather than a crash. Hence real values on every line.
type Meters = float
type Count = int

fn main():
    # --- int, both orders, all five operators -------------------------------
    a := [1, 2, 3]
    println(str(a + 10))           # [11, 12, 13]
    println(str(10 + a))           # [11, 12, 13]
    println(str(a - 10))           # [-9, -8, -7]
    println(str(10 - a))           # [9, 8, 7]      -- not [-9, -8, -7]
    println(str(a * 2))            # [2, 4, 6]
    println(str(2 * a))            # [2, 4, 6]
    println(str(a / 2))            # [0, 1, 1]      -- int / truncates
    println(str(12 / a))           # [12, 6, 4]
    println(str(a % 2))            # [1, 0, 1]
    println(str(7 % a))            # [0, 1, 1]

    # --- THE SWAP TESTS: each pair must differ ------------------------------
    println(str(2 - [5, 1]))       # [-3, 1]
    println(str([5, 1] - 2))       # [3, -1]        -- a swap would print [-3, 1]
    println(str(4 / [8, 2]))       # [0, 2]
    println(str([8, 2] / 4))       # [2, 0]         -- exact mirror image
    println(str(3 % [7, 2]))       # [3, 1]
    println(str([7, 2] % 3))       # [1, 2]

    # --- float, both orders. `f * 2` is an INT LITERAL against a float array:
    # the literal adapts to the element type exactly as it does in the all-scalar
    # `1.0 * 2`, so these three lines must agree. A variable never widens --
    # `f * n` for an int variable n is refused, as `1.0 * n` is.
    f := [1.0, 2.0]
    println(str(f * 2))            # [2.0, 4.0]     -- int literal adapts
    println(str(f * 2.0))          # [2.0, 4.0]     -- ... same as the float
    println(str(2 * f))            # [2.0, 4.0]     -- ... and on the left
    println(str(f + 2))            # [3.0, 4.0]
    println(str(2 + f))            # [3.0, 4.0]
    println(str(f - 2))            # [-1.0, 0.0]
    println(str(2 - f))            # [1.0, 0.0]
    println(str(f / 2))            # [0.5, 1.0]
    println(str(2 / f))            # [2.0, 1.0]

    # --- f32: an int literal AND a float literal both adapt to the element ---
    ff := []f32
    push(ff, to_f32(1.5))
    push(ff, to_f32(2.0))
    println(str(ff * to_f32(2.0))) # [3.0, 4.0]
    println(str(ff * 2))           # [3.0, 4.0]     -- int literal -> f32
    println(str(ff * 2.0))         # [3.0, 4.0]     -- float literal -> f32
    println(str(ff - to_f32(0.5))) # [1.0, 1.5]
    println(str(to_f32(4.0) - ff)) # [2.5, 2.0]
    println(str(ff / to_f32(2.0))) # [0.75, 1.0]
    println(str(to_f32(3.0) / ff)) # [2.0, 1.5]
    println(str(ff + to_f32(0.5))) # [2.0, 2.5]
    println(str(to_f32(0.5) + ff)) # [2.0, 2.5]

    # --- u8: unsigned, wraps at its own width, takes %, and adapts a literal --
    u := []u8
    push(u, to_u8(200))
    push(u, to_u8(100))
    println(str(u + to_u8(100)))   # [44, 200]      -- 300 wraps mod 256
    println(str(to_u8(100) + u))   # [44, 200]
    println(str(u - to_u8(100)))   # [100, 0]
    println(str(to_u8(100) - u))   # [156, 0]       -- 100-200 wraps
    println(str(u * to_u8(3)))     # [88, 44]       -- 600 and 300 mod 256
    println(str(u * 3))            # [88, 44]       -- int literal -> u8
    println(str(to_u8(3) * u))     # [88, 44]
    println(str(u / to_u8(3)))     # [66, 33]
    println(str(to_u8(3) / u))     # [0, 0]
    println(str(u % to_u8(3)))     # [2, 1]
    println(str(to_u8(3) % u))     # [3, 3]

    # --- i8: signed sized, wraps too ----------------------------------------
    s := []i8
    push(s, to_i8(100))
    push(s, to_i8(-9))
    println(str(s + to_i8(100)))   # [-56, 91]      -- 200 wraps into i8
    println(str(to_i8(100) + s))   # [-56, 91]
    println(str(s - to_i8(100)))   # [0, -109]
    println(str(to_i8(100) - s))   # [0, 109]       -- exact negation
    println(str(s % to_i8(7)))     # [2, -2]
    println(str(to_i8(7) % s))     # [7, 7]

    # --- char: + and - only, both orders, staying in the byte domain --------
    cs := ['a', 'b']
    println(str(cs + '\t'))        # [j, k]         -- 97+9=106, 98+9=107
    println(str('\t' + cs))        # [j, k]
    println(str(cs - '\t'))        # [X, Y]         -- 97-9=88, 98-9=89
    println(str('z' - ['\t', '\n'])) # [q, p]       -- 122-9=113, 122-10=112

    # --- newtype over float: the unit survives, and the scalar must wear it --
    ms := [Meters(1.5), Meters(2.5)]
    println(str(ms + Meters(0.5))) # [2.0, 3.0]
    println(str(Meters(0.5) + ms)) # [2.0, 3.0]
    println(str(ms - Meters(0.5))) # [1.0, 2.0]
    println(str(Meters(4.0) - ms)) # [2.5, 1.5]
    println(str(ms * Meters(2.0))) # [3.0, 5.0]
    println(str(Meters(2.0) * ms)) # [3.0, 5.0]
    println(str(ms / Meters(2.0))) # [0.75, 1.25]

    # --- newtype over int ----------------------------------------------------
    cq := [Count(7), Count(9)]
    println(str(cq + Count(1)))    # [8, 10]
    println(str(cq - Count(2)))    # [5, 7]
    println(str(Count(2) - cq))    # [-5, -7]
    println(str(cq * Count(2)))    # [14, 18]
    println(str(Count(2) * cq))    # [14, 18]
    println(str(cq / Count(2)))    # [3, 4]
    println(str(Count(20) / cq))   # [2, 2]

    # --- fixed [N]T: the same five operators, both orders -------------------
    p: [3]int = [10, 20, 30]
    r := p * 2
    println(str(r[0]) + " " + str(r[1]) + " " + str(r[2]))     # 20 40 60
    r2 := 2 * p
    println(str(r2[0]) + " " + str(r2[1]) + " " + str(r2[2]))  # 20 40 60
    r3 := p - 100
    println(str(r3[0]) + " " + str(r3[1]) + " " + str(r3[2]))  # -90 -80 -70
    r4 := 100 - p
    println(str(r4[0]) + " " + str(r4[1]) + " " + str(r4[2]))  # 90 80 70
    r5 := p / 4
    println(str(r5[0]) + " " + str(r5[1]) + " " + str(r5[2]))  # 2 5 7
    r6 := 100 / p
    println(str(r6[0]) + " " + str(r6[1]) + " " + str(r6[2]))  # 10 5 3
    r7 := p % 7
    println(str(r7[0]) + " " + str(r7[1]) + " " + str(r7[2]))  # 3 6 2
    r8 := 100 % p
    println(str(r8[0]) + " " + str(r8[1]) + " " + str(r8[2]))  # 0 0 10

    # a fixed float array, with an int literal adapting to the element type
    fp: [2]float = [1.5, 2.5]
    fr := fp * 2
    println(str(fr[0]) + " " + str(fr[1]))                     # 3.0 5.0
    fr2 := 2 - fp
    println(str(fr2[0]) + " " + str(fr2[1]))                   # 0.5 -0.5

    # --- an empty [T] broadcasts to an empty array, both orders -------------
    e1 := []int
    println(str(e1 * 5))           # []
    println(str(5 * e1))           # []
    println(str(len(e1 * 5)))      # 0
