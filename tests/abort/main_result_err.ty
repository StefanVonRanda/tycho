fn step(n: int) -> Result(int, string):
    if n > 1:
        return Err("step " + str(n) + " failed")
    return Ok(n)

fn main() -> Result(void, string):
    a := step(1) or_return
    println("did " + str(a))          # stdout still flushes before the exit
    b := step(2) or_return            # propagates out of main
    println("never " + str(b))
    return Ok()
