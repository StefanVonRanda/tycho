# User-defined projections (ROADMAP 2.4): `subscript name(recv, args) -> inout U`
# yields a PLACE into an argument, generalizing the built-in `&m[k]`. A call inlines
# to the yielded place at compile time (no runtime object); it is usable as a place
# (write / compound / &inout-field) or an rvalue read, exactly like the place it names.
struct Node:
    weight: int

struct Graph:
    nodes: [Node]

struct Row:
    cells: [int]

subscript edge(g: Graph, i: int) -> inout Node:      # composite-value projection
    yield &g.nodes[i]

subscript at(r: Row, i: int) -> inout int:           # scalar-value projection
    yield &r.cells[i]

struct Person:
    name: string
    age: int

struct Club:
    members: [Person]
    friends: [[int]]

subscript member(c: Club, i: int) -> inout Person:   # struct projection, heap member
    yield &c.members[i]

subscript pals(c: Club, i: int) -> inout [int]:      # array projection
    yield &c.friends[i]

fn grow(xs: inout [int], v: int):                     # push must go through a
    push(xs, v)                                       # helper's inout param

fn befriend(c: inout Club, a: int, b: int):          # push through the projection
    grow(&c.pals(a), b)

struct Store2:
    ms: [int: Person]

subscript entry(s: Store2, k: int) -> inout Person:  # projection rooted in a map
    yield &s.ms[k]

fn bump2(p: inout Person):
    p.age += 1

fn rename(p: Person) -> Person:
    p.name = p.name + "!"
    return p

fn set_member(c: inout Club, id: int, f: fn(Person) -> Person):
    c.member(id) = f(c.member(id))

fn bump(n: inout int):
    n = n + 100

fn main():
    g := Graph([Node(1), Node(2), Node(3)])
    g.edge(1).weight = 99                             # write through the projection
    println("w1=" + str(g.edge(1).weight))           # read through it -> 99
    println("w0=" + str(g.edge(0).weight))           # 1 (unchanged)
    g.edge(2).weight = g.edge(2).weight + 5          # read + write same projection
    println("w2=" + str(g.edge(2).weight))           # 8
    bump(&g.edge(0).weight)                           # projection's field as an inout arg
    println("w0b=" + str(g.edge(0).weight))          # 101

    r := Row([10, 20, 30])
    r.at(0) = 11                                      # scalar element write
    r.at(1) = r.at(1) + r.at(0)                       # scalar read + write (20+11)
    println("r=" + str(r.at(0)) + "," + str(r.at(1)) + "," + str(r.at(2)))   # 11,31,30

    c := Club([Person("ann", 3), Person("bo", 4)], [[]int, []int])
    befriend(&c, 0, 1)                                # push through an array-typed
    befriend(&c, 1, 0)                                # projection: grows the buffer
    befriend(&c, 1, 1)                                # in the club's own arena
    println("f=" + str(c.pals(0)) + str(c.pals(1)))   # [1] [0,1]
    set_member(&c, 0, rename)                         # whole-struct writeback with
    println("n=" + c.member(0).name)                  # a heap member -> ann!
    c.member(0) = c.member(1)                         # place-to-place: deep copy,
    c.member(1).age = 999                             # later mutation independent
    println("p2p=" + c.member(0).name + str(c.member(0).age))
    c.member(0).age += 10                             # compound assign through
    println("ca=" + str(c.member(0).age))             # the projection
    s2 := Store2([])                                  # subscript rooted in a map:
    s2.entry(7) = Person("z", 1)                         # write, read, inout and
    println("mroot=" + s2.entry(7).name + str(s2.entry(7).age))
    bump2(&s2.entry(7))
    println("mroot2=" + str(s2.entry(7).age))
    s2.entry(7).name = s2.entry(7).name + "!"
    println("mroot3=" + s2.entry(7).name)
