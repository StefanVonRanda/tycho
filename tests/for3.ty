fn main():
    # ascending
    asc := ""
    for i := 0; i < 5; i += 1:
        asc = asc + str(i)
    println("asc=" + asc)                  # 01234

    # descending: the post clause counts down and the condition is `>`
    desc := ""
    for i := 5; i > 0; i -= 1:
        desc = desc + str(i)
    println("desc=" + desc)                # 54321

    # `continue` MUST run the post clause. `i` advances ONLY there, so a
    # `continue` that skipped it would not print a wrong answer -- it would
    # never terminate. That is deliberate: this is the one shape that fails
    # loudly instead of quietly if the post clause is jumped over.
    odd := ""
    for i := 0; i < 8; i += 1:
        if i / 2 * 2 == i:
            continue
        odd = odd + str(i) + ","
    println("odd=" + odd)                  # 1,3,5,7,

    # `break` leaves WITHOUT running the post clause
    stop := 0
    for i := 0; i < 100; i += 1:
        if i == 4:
            break
        stop = i
    println("stop=" + str(stop))           # 3

    # nesting: the inner break binds to the inner loop only
    tot := 0
    grid := ""
    for r := 0; r < 3; r += 1:
        for c := 0; c < 3; c += 1:
            if c == 2:
                break
            grid = grid + str(r) + str(c) + " "
            tot = tot + 1
    println("grid=" + grid)                # 00 01 10 11 20 21
    println("tot=" + str(tot))             # 6

    # a `continue` in the OUTER loop of a nest still runs the outer post clause,
    # and the inner loop's own `continue` is unaffected
    pairs := ""
    for a := 0; a < 4; a += 1:
        if a == 1:
            continue
        for b := 0; b < 3; b += 1:
            if b == 1:
                continue
            pairs = pairs + str(a) + str(b) + " "
    println("pairs=" + pairs)              # 00 02 20 22 30 32

    # the init variable is scoped to the loop: the outer `i` is untouched
    i := 99
    for i := 0; i < 2; i += 1:
        tot = tot + 1
    println("outer_i=" + str(i))           # 99
    println("tot2=" + str(tot))            # 8

    # Body-local shadows must never capture the loop-scope post clause.
    shadows := 0
    for j := 0; j < 4; j += 1:
        j := 100
        shadows += j
    println("shadows=" + str(shadows))     # 400, not an infinite loop

    continued := 0
    for j := 0; j < 4; j += 1:
        if j == 0:
            continue                         # before the shadow exists
        outer := j
        j := 100
        if outer == 2:
            continue                         # after the shadow exists
        continued += j
    println("shadow_continue=" + str(continued))

    step := 1
    rhs := 0
    for j := 0; j < 3; j += step:
        step := "body"                       # a different type in post's RHS
        rhs += len(step)
    println("shadow_rhs=" + str(rhs))

    text := ""
    heap_sum := 0
    for j := 0; j < 3; text = text + "x":
        j += 1
        text := [j]                          # post must append to the OUTER string
        heap_sum += text[0]
    println("shadow_heap=" + text + ":" + str(heap_sum))

    cursor := 0
    stopped := 0
    for cursor = 0; cursor < 5; cursor += 1:
        outer := cursor
        cursor := 100
        if outer == 2:
            break
        stopped += cursor
    println("shadow_break=" + str(stopped) + ":" + str(cursor))

    nested := 0
    for a := 0; a < 2; a += 1:
        outer := a
        a := 10
        for b := 0; b < 3; b += 1:
            inner := b
            b := 100
            nested += a + b + outer + inner
    println("shadow_nested=" + str(nested))

    worker_sum := 0
    parallel(2) for p in 0..<4:
        local := p
        for j := 0; j < 3; j += 1:
            j := 100
            local += j
        worker_sum += local
    println("shadow_workers=" + str(worker_sum))
