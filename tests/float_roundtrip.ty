# str(float) must produce text that parses back to the SAME double.
#
# THE DEFECT THIS LOCKS. tycho_float_to_str formatted with `%.15g` until
# 2026-08-12. Fifteen significant digits is DBL_DIG, which guarantees
# text -> double -> text; binary64 needs DBL_DECIMAL_DIG = 17 for the direction
# `str` is actually used in, double -> text -> double. So:
#
#   str(0.1 + 0.2)          was "0.3"                   a DIFFERENT double
#   str(9007199254740992.0) was "9.00719925474099e+15"  not an integer any more
#   str(DBL_MAX)            was "1.79769313486232e+308" ABOVE DBL_MAX, so this
#                               project's own strings.parse_float refuses it
#
# The renderer now emits the SHORTEST of %.15g/%.16g/%.17g that strtod reads back
# unchanged, so the common values below keep the short text they always had and
# only the ones that need more digits get them.
#
# WHAT THE TWO COLUMNS MEAN, AND WHY BOTH ARE HERE.
#   rt=1    str(x) re-read with strtod is bit-identical to x (sign compared, so
#           -0.0 does not pass as 0.0). Every finite line must be 1.
#   rt15=   the NEGATIVE CONTROL. Same check against a forced `%.15g` -- the old
#           renderer. The 0s in this column are the defect, reproduced in the
#           golden. A column of all-1s would prove only that the hook is
#           cheerful; these lines prove it can say no.
#
# The str= column is load-bearing too: it pins the exact digits, so a silent
# regression to a fixed precision moves this file whether or not rt does.
#
# NO INF/NAN HERE. docs/spec/appendix-f-impl-defined.md records their text as
# implementation-defined, and tests/float_str_locale.ty already covers them.
# Locale is that file's subject as well; this one is about digits.
#
# The extern is a runtime test hook, declared here and in that file, never a
# builtin -- see the block above tycho_test_float_roundtrip in runtime/tycho_rt.c.
extern fn tycho_test_float_roundtrip(x: float) -> int
extern fn tycho_test_float_roundtrip_prec(x: float, prec: int) -> int

fn show(label: string, x: float):
    println(label + " str=" + str(x) + "  rt=" + str(tycho_test_float_roundtrip(x))
            + " rt15=" + str(tycho_test_float_roundtrip_prec(x, 15)))

fn main():
    # The three from the bug report.
    tenth := 0.1
    fifth := 0.2
    show("0.1+0.2     ", tenth + fifth)
    show("2^53        ", 9007199254740992.0)
    show("DBL_MAX     ", 1.7976931348623157e308)

    # The rest of the range: both ends, normal and subnormal.
    show("DBL_MIN     ", 2.2250738585072014e-308)
    show("DBL_TRUE_MIN", 5e-324)
    show("1e308       ", 1e308)
    show("1e-308      ", 1e-308)

    # Values a program actually prints. These keep their short text.
    show("0.1         ", 0.1)
    show("1.5         ", 1.5)
    show("1/3         ", 1.0 / 3.0)

    # Integral floats keep the ".0" the guard appends -- str(3.0) is "3.0",
    # never "3", and the round trip has to survive that suffix too.
    show("3.0         ", 3.0)
    show("1e22        ", 1e22)

    # Signs, including the zero whose sign only a bit compare can see.
    show("-2.5        ", -2.5)
    show("-0.1-0.2    ", 0.0 - (tenth + fifth))
    show("0.0         ", 0.0)
    show("-0.0        ", -0.0)
