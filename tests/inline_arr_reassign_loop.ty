# A fixed array, a bounded and a vector reassigned from a call inside a loop,
# each read twice. tychoc's in-loop spine recycle took them for dynamic arrays
# and emitted `.data`/`.cap` on a struct that stores inline -- a cc error.
# tychoc1 never had it. Found by tools/tycho-grade.

fn mk(x: int) -> [4]int:
    return [x, x, x, x]

fn mkv(x: f32) -> vector[4]f32:
    v: vector[4]f32 = [x, x, x, x]
    return v

fn mkb(x: int) -> bounded[4]int:
    return [x]

fn main():
    h: [4]int = [1, 1, 1, 1]
    g: vector[4]f32 = [1.0, 1.0, 1.0, 1.0]
    b := mkb(0)
    for i := 0; i < 3; i += 1:
        h = mk(i + 5)
        g = mkv(to_f32(i))
        b = mkb(i * 10)
        println(str(h[0]) + " " + str(g.x) + " " + str(b[0]))
    println(str(h) + " " + str(g) + " " + str(len(b)))
