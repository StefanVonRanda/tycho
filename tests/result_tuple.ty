
enum Local:
    Nope
    Worse
    Sized(int, string)

# The construct under test: both arms build the Result inline, in the tuple
# literal, with no typed local to ground it.
fn outcome(ok: bool) -> (Result(int, Local), string):
    if ok:
        return (Ok(3), "full")
    return (Err(Worse), "partial")

# A payload-carrying Err variant in the same position, and a heap Ok payload --
# the grounding must reach through the variant's own arguments too.
fn sized(n: int) -> (Result([int], Local), string):
    if n < 0:
        return (Err(Sized(n, "negative")), "rejected")
    xs := []int
    for i := 0; i < n; i += 1:
        push(xs, i * i)
    return (Ok(xs), "built")

fn show(r: Result(int, Local)) -> string:
    match r:
        Ok(v):
            return "ok:" + str(v)
        Err(Nope):
            return "err:nope"
        Err(Worse):
            return "err:worse"
        Err(Sized(n, why)):
            return "err:sized:" + str(n) + ":" + why

fn main():
    r1, s1 := outcome(true)
    r2, s2 := outcome(false)
    println("ok_arm    = " + show(r1) + " / " + s1)
    println("err_arm   = " + show(r2) + " / " + s2)

    # a tuple literal built at a call site rather than in a return
    pair := outcome(true)
    println("call_site = " + show(pair.0) + " / " + pair.1)

    b1, w1 := sized(4)
    match b1:
        Ok(xs):
            println("heap_ok   = len=" + str(len(xs)) + " last=" + str(xs[3]) + " / " + w1)
        Err(e):
            println("heap_ok   = unexpected err / " + w1)

    b2, w2 := sized(-2)
    match b2:
        Ok(xs):
            println("heap_err  = unexpected ok len=" + str(len(xs)) + " / " + w2)
        Err(Sized(n, why)):
            println("heap_err  = sized:" + str(n) + ":" + why + " / " + w2)
        Err(e):
            println("heap_err  = other / " + w2)
