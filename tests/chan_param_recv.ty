fn pump(ch: Channel(int), v: int):
    send(ch, v)

fn main():
    ch := channel(int, 4)
    pump(ch, 7)
    println(str(recv(ch)))       # Some(7) -- an Option(int), not an int
    pump(ch, 7)
    match recv(ch):
        Some(v):
            println(str(v))      # 7 -- the unwrapped element
        None:
            println("closed")
    close(ch)
