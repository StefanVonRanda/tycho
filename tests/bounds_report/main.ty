# Fixture for scripts/bounds_report_check.sh: each annotated line must get
# that verdict from `tychoc --bounds-report`, and no other line may report.

fn total(xs: [int]) -> int:
    s := 0
    for i := 0; i < len(xs); i += 1:
        s += xs[i]                   # bounds: elide
    return s

fn gather(xs: [int], ids: [int]) -> int:
    s := 0
    for i := 0; i < len(ids); i += 1:
        j := ids[i]                  # bounds: elide
        s += xs[j]                   # bounds: keep
    return s

fn bump(xs: inout [int], k: int):
    xs[k] = xs[k] + 1                # bounds: keep

fn main():
    xs := [3, 1, 4, 1, 5]
    bump(&xs, 2)
    println(str(total(xs)) + " " + str(gather(xs, [0, 2, 4])))
