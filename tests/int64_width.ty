# ILP32 conformance fixture: every value here exceeds 2^31, so it would TRUNCATE
# if Tycho `int` lowered to a 32-bit C `long` (the old LP64-only lowering, still
# 4 bytes on ILP32/LLP64). With the fixed-width `tycho_int` (int64_t) they are
# exact on every data model. This is the fixture the `make ilp32` gate rebuilds
# under -m32 to prove the width fix; its golden is the 64-bit-correct output.
fn main():
    big := 5000000000              # > 2^31 (2147483648); a 32-bit long cannot hold it
    println(str(big))              # 5000000000
    prod := 100000 * 100000        # 10^10 -- overflows 32 bits mid-arithmetic
    println(str(prod))             # 10000000000
    shifted := 1 << 40             # 1099511627776 -- bit past the 32-bit range
    println(str(shifted))          # 1099511627776
    total := big + prod + shifted  # 1114511627776
    println(str(total))            # 1114511627776
