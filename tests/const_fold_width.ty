const SHIFT_BIG  = 1 << 40                  # 1099511627776
const SHIFT_HUGE = 1 << 62                  # 4611686018427387904
const MUL_BIG    = 100000 * 100000          # 10000000000
const ADD_BIG    = 4000000000 + 1000000000  # 5000000000
const MASK_BIG   = (1 << 40) - 1            # 1099511627775
const SHR_BIG    = (1 << 62) >> 20          # 4398046511104

fn main():
    println(str(SHIFT_BIG))     # 1099511627776
    println(str(SHIFT_HUGE))    # 4611686018427387904
    println(str(MUL_BIG))       # 10000000000
    println(str(ADD_BIG))       # 5000000000
    println(str(MASK_BIG))      # 1099511627775
    println(str(SHR_BIG))       # 4398046511104
