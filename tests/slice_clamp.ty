# A `bytes` or `string` slice CLAMPS -- it is not a bounds check. Go panics and
# Odin traps on every shape below, so this divergence is deliberate, not a gap;
# `at()` keeps each bound off the constant path, so what is pinned is the RUNTIME
# behaviour. An ARRAY slice aborts on these same four shapes (docs/spec/03-types.md).
fn at(n: int) -> int:
    return n

fn main():
    b := to_bytes("abcde")
    s := "abcde"
    println("b past=" + str(len(b[2:at(10)])) + " far=" + str(len(b[at(7):at(9)])))
    println("b neg =" + str(len(b[at(-3):at(2)])) + " inv=" + str(len(b[at(4):at(1)])))
    println("s past=" + str(len(s[2:at(10)])) + " far=" + str(len(s[at(7):at(9)])))
    println("s neg =" + str(len(s[at(-3):at(2)])) + " inv=" + str(len(s[at(4):at(1)])))
