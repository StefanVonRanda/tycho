# reserve(m, n): pre-size a MAP's entry + index arrays so a known-size workload
# skips the retained growth intermediates (the lru bench's fix). Entries must
# survive a later re-size; a tombstone must be reclaimed; the composite (mapc)
# family must reserve too. (Sibling: map_reserve_map.ty tests reserve(m[k], n)
# -- reserving the array VALUE inside a map.)
fn main():
    m := []int: int
    reserve(m, 1000)
    m[1] = 10
    m[2] = 20
    reserve(m, 10000)          # re-size: entries must survive
    s := []string: int
    reserve(s, 100)
    s["k"] = 5
    delete s["k"]              # tombstone + churn
    s["j"] = 6
    c := []string: string      # composite map (emitted mapc reserve)
    reserve(c, 100)
    c["a"] = "x"
    c["b"] = "y"
    reserve(c, 1000)
    print(str(m.get(1, -1)) + " " + str(m.get(2, -1)) + " " + str(len(m)) + " | ")
    print(str(s.get("k", -1)) + " " + str(s.get("j", -1)) + " " + str(len(s)) + " | ")
    print(c.get("a", "") + c.get("b", "") + " " + str(len(c)))
