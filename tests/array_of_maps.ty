fn main():
    arr := [][int:int]
    push(arr, []int: int)
    push(arr, []int: int)
    arr[0][1] = 10
    arr[0][2] = 20
    arr[1][3] = 30
    delete arr[0][1]              # delete from a map that is an array element
    arr[0][5] = 50               # reinsert appends to that element's order
    out := ""
    for i := 0; i < len(arr); i += 1:
        ks := keys(arr[i])
        for j := 0; j < len(ks); j += 1:
            out = out + str(i) + ":" + str(ks[j]) + "=" + str(arr[i][ks[j]]) + " "
    println(out)            # 0:2=20 0:5=50 1:3=30
    println(str(1 in arr[0]) + " " + str(5 in arr[0]) + " " + str(3 in arr[1]) + " n0=" + str(len(arr[0])))
