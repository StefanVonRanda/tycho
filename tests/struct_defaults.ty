# FRICTION 261: field defaults. A named construction that leaves a field
# out gets its default; P() takes every default when every field has one;
# positional construction still gives every field.
struct Cfg:
    name: string
    width: int = 640
    scale: float = 1.5
    tags: [string] = []
    flags: (bool, int) = (false, -1)
    off: [float] = [0.0, -2.5]
    seen: [string: int] = []string: int

struct All:
    a: int = 7
    b: string = "b"

struct Box:
    cfg: Cfg
    n: int = 2

fn make(w: int) -> Cfg:
    return Cfg(name: "m", width: w)

fn main():
    c := Cfg(name: "x")
    println(c.name + " " + str(c.width) + " " + str(c.scale) + " " + str(len(c.tags)) + " " + str(c.flags.1) + " " + str(c.off[1]) + " " + str(len(c.seen)))
    d := Cfg(width: 3, name: "y", tags: ["t"])
    println(d.name + " " + str(d.width) + " " + str(len(d.tags)))
    e := All()
    println(str(e.a) + e.b)
    f := Cfg("z", 1, 2.0, [], (true, 1), [], []string: int)
    println(f.name + str(f.width))
    bx := Box(cfg: Cfg(name: "in"))
    println(bx.cfg.name + " " + str(bx.cfg.width) + " " + str(bx.n))
    cs := [Cfg(name: "q"), make(9)]
    push(cs[0].tags, "added")
    println(str(cs[1].width) + " " + str(len(cs[0].tags)) + " " + str(len(Cfg(name: "fresh").tags)))
