package main

# BOTH halves of the corelib-warning mute (commit 8f4367d), in one golden.
# `core:json` declares `keys`, which collides with the builtin, and warned in the
# stderr of any program that merely imported it -- a diagnostic about a file the
# user cannot edit. The mute silences warnings raised while parsing an imported
# corelib package, and nothing but this fixture holds it:
#   half 1 -- json.ty's own `keys` warning must NOT be in the golden below;
#   half 2 -- this file's `len` shadow MUST be, or a mute that silenced
#             everything would pass half 1 on its own.
import "core:json"

fn len(s: string) -> int:
    return 7

fn main():
    println(json.kind(json.parse("{\"a\":1}")))
    println(str(len("abcd")))
