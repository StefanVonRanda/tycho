# `len` here is a MAIN-PROGRAM procedure named after a builtin: spec §3.7 makes
# that an error, but `len` is one of the 28 names the compiler only warns about
# (§3.7's documented gap), so the warning is what there is to pin. The builtin
# is selected at every unqualified call and this local is unreachable by that
# name; core:utf8 hit it and renamed `len` to `count`. A PACKAGE-level
# declaration is legal instead (`json.keys`). This lane captures stderr and
# never runs, so `tests/shadow_builtin_selection.ty` locks the answers.
fn len(s: string) -> int:
    return 7

fn four(s: string) -> int:
    return len(s)                # the BUILTIN, not the `len` above

fn main():
    print(str(four("abcd")))     # 4 -- see the selection fixture
