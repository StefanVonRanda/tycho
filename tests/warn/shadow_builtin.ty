# Declaring a procedure whose name is a builtin does NOT shadow it (spec §3.7,
# rewritten 2026-08-12): the builtin is selected at every unqualified call and
# the local is unreachable by that name, so the declaration warns. core:utf8 hit
# this -- its `decode` called `len` and got the builtin -- and renamed its own
# entry point to `count`. The warning is the assertion here; this lane captures
# stderr only and never runs the program, so
# `tests/shadow_builtin_selection.ty` runs the calls and locks the answers.
fn len(s: string) -> int:
    return 7

fn four(s: string) -> int:
    return len(s)                # the BUILTIN, not the `len` above

fn main():
    print(str(four("abcd")))     # 4 -- see the selection fixture
