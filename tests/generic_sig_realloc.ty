# Regression: `sig_find` returns a pointer INTO the growable `g_sigs` table.
# Resolving a call's arguments can instantiate a generic, which appends to
# `g_sigs` and reallocs it -- leaving the callee's `Sig *` dangling for the
# inout/arity/type checks that follow. This forces 200 distinct
# instantiations inside the arguments of `print`/`str`, crossing several
# realloc boundaries whatever capacity the table starts at. Before the fix
# the freed slot read back garbage: "argument 1 of 'print' is inout".
# The fat generic bodies are load-bearing: instantiating them allocates enough
# to overwrite the freed slot before it is read. Trim them and this goes silent.

fn tag(x: $T) -> int:
    a0 := x
    a1 := x
    a2 := x
    a3 := x
    a4 := x
    a5 := x
    a6 := x
    a7 := x
    a8 := x
    a9 := x
    a10 := x
    a11 := x
    a12 := x
    a13 := x
    a14 := x
    a15 := x
    a16 := x
    a17 := x
    a18 := x
    a19 := x
    a20 := x
    a21 := x
    a22 := x
    a23 := x
    a24 := x
    a25 := x
    a26 := x
    a27 := x
    a28 := x
    a29 := x
    a30 := x
    a31 := x
    a32 := x
    a33 := x
    a34 := x
    a35 := x
    a36 := x
    a37 := x
    a38 := x
    a39 := x
    return 1

fn tag2(y: $U) -> int:
    b0 := y
    b1 := y
    b2 := y
    b3 := y
    b4 := y
    b5 := y
    b6 := y
    b7 := y
    b8 := y
    b9 := y
    b10 := y
    b11 := y
    b12 := y
    b13 := y
    b14 := y
    b15 := y
    b16 := y
    b17 := y
    b18 := y
    b19 := y
    b20 := y
    b21 := y
    b22 := y
    b23 := y
    b24 := y
    b25 := y
    b26 := y
    b27 := y
    b28 := y
    b29 := y
    b30 := y
    b31 := y
    b32 := y
    b33 := y
    b34 := y
    b35 := y
    b36 := y
    b37 := y
    b38 := y
    b39 := y
    return 1

