
struct Flags:
    bits: [bool]

fn main():
    arr := [true, false]

    # the repro: bool array element straight into `if`
    if arr[0]:
        println("if-elem")
    if not arr[1]:
        println("if-not-elem")

    # the while-form `for`, the second cond_unwrap call site
    i := 0
    for arr[0]:
        i = i + 1
        if i > 2:
            arr[0] = false
    println(str(i))                        # 3

    # nested arrays, struct field, map value -- same lowering, deeper base
    n := [[true], [false, true]]
    if n[1][1]:
        println("if-nested")

    s := Flags(bits: [false, true])
    if s.bits[1]:
        println("if-field")

    m := ["k": [true, false]]
    if m["k"][0]:
        println("if-map")

    # a statement-expression that is only PART of the condition: the outer
    # paren really is redundant here and stripping it stays valid C
    if arr[1] == false:
        println("if-elem-eq")
    if n[0][0] and s.bits[1]:
        println("if-elem-and")

    # plain conditions that must still unwrap cleanly
    a := 1
    b := 2
    if a < b:
        println("if-lt")
    if (a + 1) == b:
        println("if-paren-eq")
    t := "x"
    if t == "x":
        println("if-str-eq")

    # a paren inside a string literal must not fool the matcher
    if t == ")":
        println("unreachable")
    else:
        println("if-rparen-lit")

    v := if arr[1]:
        10
    else:
        20
    println(str(v))                        # 20

    w := if n[1][1]:
        "vif-nested"
    else:
        "unreachable"
    println(w)
