# WHICH procedure a builtin's name actually selects -- run, not just compiled.
# tests/warn/shadow_builtin.ty locks the WARNING, but that lane captures stderr
# and never executes the program, so nothing in the tree checked which body ran.
#
# docs/spec/01-lexical.md is normative and, since 2026-08-12, matches what this
# golden records: a builtin name may not be shadowed, the BUILTIN is selected at
# every unqualified call, and the same-named local is unreachable by that name
# (a package-QUALIFIED `pkg.len(...)` is a different construct and does reach
# it). So this golden pins the RULE. A change that makes the local win here is
# a spec violation, not a fix.

fn len(s: string) -> int:
    return 7

fn hash(x: int) -> int:
    return 14

# NEGATIVE CONTROL: `mylen` is not a builtin, so nothing can outrank it. If this
# printed 4 the fixture would be measuring something other than shadowing, and
# if the two `true`s below ever agree with it the test has stopped discriminating.
fn mylen(s: string) -> int:
    return 7

fn main():
    println(str(len("abcd")))          # 4 -- the BUILTIN, not the `len` above
    println(str(hash(7) == 14))        # false -- the BUILTIN's hash, not 14
    println(str(mylen("abcd")))        # 7 -- negative control: the local wins
