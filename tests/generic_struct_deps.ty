
struct Point:
    x: int
    y: int

struct Box($T):
    v: T

struct Holder:
    inner: Box(Point)

fn main():
    b := Box(Point(3, 4))
    println(str(b.v.x) + "," + str(b.v.y))    # 3,4
    println(str(Box(5).v))                     # 5 (scalar instance too)
    h := Holder(Box(Point(7, 8)))
    println(str(h.inner.v.y))                  # 8
