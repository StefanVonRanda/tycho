fn score(n: int) -> int:
    return n * n

fn main():
    total := 0
    parallel for i in 0..<1000:
        total += score(i)
    print(str(total))

    s := 0
    p := 1
    # counts 1..10. `0..<N` counts from zero by construction (src/tychoc.c:3378),
    # so the non-zero lower bound moves into the body as `i + 1` rather than into
    # the header. s and p are unchanged: s = 1+..+10 = 55, p = 1*2*3*4*5 = 120.
    parallel for i in 0..<10:
        s = s + (i + 1)
        if i + 1 < 6:
            p = p * (i + 1)
    print(str(s))
    print(str(p))

    xs := [3, 1, 4, 1, 5, 9, 2, 6]
    sum := 0
    parallel for x in xs:
        sum += x * 10
    print(str(sum))

    f := 0.0
    parallel for i in 0..<4:
        f = f + 1.5
    print(str(to_int(f)))
