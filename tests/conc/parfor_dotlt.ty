# Phase 5: `parallel for i in 0..<N:` -- the counting spelling for `parallel
# for`. Implicit step 1, ascending, EXCLUSIVE upper bound, so the body runs for
# i in 0 .. N-1 and there is no zero-step case at all (unlike `range()`, which
# rejects a literal 0 step and aborts on a runtime one).
#
# Parsed at src/tychoc.c:3396-3437 into the same S_FORRANGE node `range(0, N)`
# builds, so the whole CC-3 path below it -- resolve_parfor's capture/reduction
# scan, the lifted `__parN` chunk proc, the fan-out over K = tycho_ncpu() tasks
# at src/tychoc.c:10087 -- is the code that was already there and already
# exercised. Nothing about chunking is new; only the spelling is.
#
# Every value here is a closed form, checked by hand before the golden was
# recorded, and every one is chunk-count-independent: integer + and * are
# associative and exact, so the answers do not depend on how many threads the
# host has (float reductions may reassociate, which is why there are none).

fn score(n: int) -> int:
    return n * n

fn main():
    # Every index in 0..999 exactly once: sum of i*i = 999*1000*1999/6.
    # A dropped or repeated chunk boundary moves this number.
    total := 0
    parallel for i in 0..<1000:
        total += score(i)
    println(str(total))

    # N is an ordinary expression, evaluated once at the spawn site.
    n := 3
    hits := 0
    parallel for i in 0..<(n * 4):
        hits += 1
    println(str(hits))

    # Exclusive bound, smallest non-empty space: one iteration, with i == 0.
    one := 0
    idx := 0
    parallel for i in 0..<1:
        one += 1
        idx += i
    println(str(one))
    println(str(idx))

    # Empty iteration space: the body must not run at all.
    z := 0
    parallel for i in 0..<0:
        z += 1
    println(str(z))

    # A product reduction over the same shape: 1*2*3*4*5.
    p := 1
    parallel for i in 0..<6:
        if i > 0:
            p = p * i
    println(str(p))
