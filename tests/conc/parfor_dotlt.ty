
fn score(n: int) -> int:
    return n * n

fn main():
    # Every index in 0..999 exactly once: sum of i*i = 999*1000*1999/6.
    # A dropped or repeated chunk boundary moves this number.
    total := 0
    parallel for i in 0..<1000:
        total += score(i)
    println(str(total))

    # N is an ordinary expression, evaluated once at the spawn site.
    n := 3
    hits := 0
    parallel for i in 0..<(n * 4):
        hits += 1
    println(str(hits))

    # Exclusive bound, smallest non-empty space: one iteration, with i == 0.
    one := 0
    idx := 0
    parallel for i in 0..<1:
        one += 1
        idx += i
    println(str(one))
    println(str(idx))

    # Empty iteration space: the body must not run at all.
    z := 0
    parallel for i in 0..<0:
        z += 1
    println(str(z))

    # A product reduction over the same shape: 1*2*3*4*5.
    p := 1
    parallel for i in 0..<6:
        if i > 0:
            p = p * i
    println(str(p))
