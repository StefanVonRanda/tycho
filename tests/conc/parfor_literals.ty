
fn tag(n: int) -> string:
    k := n % 8
    if k == 0:
        return "alpha"
    if k == 1:
        return "bravo"
    if k == 2:
        return "charlie"
    if k == 3:
        return "delta"
    if k == 4:
        return "echo"
    if k == 5:
        return "foxtrot"
    if k == 6:
        return "golf"
    return "hotel"

fn main():
    # len of each tag, summed. 250 * (5+5+7+5+4+7+4+5) = 250 * 42.
    total := 0
    parallel for i in 0..<2000:
        total += len(tag(i))
    print(str(total))

    # concat and compare against literals, both inside the body: the pieces are
    # interned in the worker too, not just the returned tag.
    marks := 0
    parallel for i in 0..<2000:
        s := "<" + tag(i) + ">"
        if s == "<alpha>":
            marks += 1
        if len(s) > 8:
            marks += 100
    print(str(marks))
