
fn yes() -> bool:
    return true

fn no() -> bool:
    return false

fn main():
    t := spawn yes()
    if wait(t):
        println("wait-true")

    u := spawn no()
    if wait(u):
        println("unreachable")
    else:
        println("wait-false")

    # statement-expression as only PART of the condition: the outer paren is
    # genuinely redundant there and must still be stripped, staying valid C
    v := spawn yes()
    if wait(v) == true:
        println("wait-eq")

    w := spawn yes()
    x := spawn no()
    if wait(w) and not wait(x):
        println("wait-and")
