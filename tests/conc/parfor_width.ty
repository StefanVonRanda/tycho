fn produce(ch: Channel(int), n: int) -> int:
    for i := 0; i < n; i += 1:
        send(ch, i)
    close(ch)
    return n

fn drain(w: int) -> int:
    jobs := channel(int, 16)
    pr := spawn produce(jobs, 100)
    sum := 0
    if w == 1:
        parallel(1) for x in jobs:
            sum = sum + x * x
    elif w == 3:
        parallel(3) for x in jobs:
            sum = sum + x * x
    else:
        parallel for x in jobs:
            sum = sum + x * x
    _n := wait(pr)
    return sum

fn main():
    println(str(drain(1)))
    println(str(drain(3)))
    println(str(drain(0)))
