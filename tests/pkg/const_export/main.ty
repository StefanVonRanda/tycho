# Consts cross a package boundary (2026-08-10). Before this a package that wanted
# to publish a level had to ship it as a function -- `levels.debug()` -- because
# `levels.DEBUG` resolved as an enum variant and died "has no variant".
#
# They stay FOLDED: no runtime global is emitted, which is why this needed no new
# syntax and no export keyword. Privacy is the rule the language already had --
# `levels._INTERNAL` is refused from here, and tests/reject/ has that case.
package main
import "levels"

fn main():
    println(str(levels.DEBUG))
    println(str(levels.INFO * 2))          # in an expression
    println(levels.LABEL)                  # a string const
    println(str(levels.SCALE))             # a float const
    println(str(levels.threshold()))       # the package reading its own private const

    if levels.WARN > levels.INFO:
        println("ordered")
