package lib2

# The same three names again, in a second package. Each package must see its own.
enum Fault:
    EmptyInput
    Garbage
    OutOfBounds

fn classify(n: int) -> Fault:
    if n == 0:
        return EmptyInput        # bare in-package variant: lib2's, not main's and not lib's
    if n == 1:
        return Garbage
    return OutOfBounds

fn name(f: Fault) -> string:
    match f:
        EmptyInput:  return "lib2-empty"
        Garbage:     return "lib2-garbage"
        OutOfBounds: return "lib2-oob"
