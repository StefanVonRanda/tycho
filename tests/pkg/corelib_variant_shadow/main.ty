package main

import "core:strings"

# The real repro tests/pkg/variant_shadow could not write (its note explains why:
# this lane could not link a corelib shim until run.sh learned --print-shims).
# main declares Syntax and Empty WITH payloads; core:strings' FloatErr declares
# both without. Variant names are package-scoped, so parse_float's own
# `return Err(Syntax)` inside corelib/strings/strings.ty must keep seeing
# corelib's payload-free one, not main's payload-carrying one.
enum Mine:
    Syntax(string)
    Empty(int)

fn describe(s: string) -> string:
    r := strings.parse_float(s)
    match r:
        Ok(v):  return "ok " + str(v)
        Err(e):
            match e:
                strings.Empty:  return "empty"
                strings.Syntax: return "syntax"
                _:              return "other"

fn main():
    println(describe("2.5"))
    println(describe("x"))
    println(describe(""))
    m := Syntax("mine")
    match m:
        Syntax(s): println(s)
        Empty(n):  println(str(n))
