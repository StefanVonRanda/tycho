package main

import "core:strings"

enum Mine:
    Syntax(string)
    Empty(int)

fn describe(s: string) -> string:
    r := strings.parse_float(s)
    match r:
        Ok(v):  return "ok " + str(v)
        Err(e):
            match e:
                strings.Empty:  return "empty"
                strings.Syntax: return "syntax"
                _:              return "other"

fn main():
    println(describe("2.5"))
    println(describe("x"))
    println(describe(""))
    m := Syntax("mine")
    match m:
        Syntax(s): println(s)
        Empty(n):  println(str(n))
