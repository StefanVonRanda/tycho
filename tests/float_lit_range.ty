
fn main():
    # underflow: a legal denormal-or-zero, not an error
    tiny := 1e-400
    println("1e-400         = " + str(tiny))
    println("1e-300         = " + str(1e-300))

    # the inclusive boundary, and its negative twin
    dmax := 1.7976931348623157e308
    dmin := -1.7976931348623157e308
    if dmax > 1e308 and dmin < -1e308:
        println("DBL_MAX        = accepted, finite")
    else:
        println("DBL_MAX        = LOST")

    # finite, not exactly representable: rounds, as it always did
    inexact := 0.1
    if inexact + 0.2 == 0.30000000000000004:
        println("0.1 round trip = exact")
    else:
        println("0.1 round trip = LOST")

    # infinity and NaN remain reachable as VALUES, per the spec
    zero := 0.0
    pinf := 1.0 / zero
    ninf := -1.0 / zero
    nan := zero / zero
    if pinf > dmax and ninf < dmin:
        println("1.0/0.0        = +inf, -1.0/0.0 = -inf")
    else:
        println("1.0/0.0        = LOST")
    # NaN is unordered: it compares false against everything, itself included.
    if nan == nan or nan < 0.0 or nan > 0.0:
        println("0.0/0.0        = LOST")
    else:
        println("0.0/0.0        = NaN, unordered")
