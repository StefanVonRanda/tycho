# the generics actually used come LAST, so their ids are the highest in each table
struct Box($BoxT):
    v: $BoxT

enum Maybe($MaybeT):
    Yep($MaybeT)
    Nothing

fn ident(x: $Zed) -> $Zed:
    return x

fn firstof(xs: [$Wye]) -> $Wye:
    return xs[0]

fn unbox(b: Box($BoxT)) -> $BoxT:
    return b.v

fn unmaybe(m: Maybe($MaybeT), d: $MaybeT) -> $MaybeT:
    match m:
        Yep(v): return v
        Nothing: return d

fn lastof(xs: [$Nz]int) -> int:
    return xs[Nz - 1]

fn main():
    println(str(ident(41)))                  # 41  instantiate_generic: binds + sizebinds
    println(ident("ok"))                     # ok  a second instance of the same template
    xs := [10, 20, 30]
    println(str(xs.firstof()))               # 10  ufcs_generic's bind vector
    b := Box(7)
    println(str(unbox(b)))                   # 7   generic struct literal inference
    bb: Box(int) = Box(8)
    println(str(unbox(bb)))                  # 8   generic struct in TYPE position
    m := Yep(9)
    println(str(unmaybe(m, 0)))              # 9   generic enum variant constructor
    mm: Maybe(int) = Nothing$(int)
    println(str(unmaybe(mm, 5)))             # 5   generic enum in TYPE position
    fx: [3]int = [4, 5, 6]
    println(str(lastof(fx)))                 # 6   `[$N]T` size inference
