fn first_even(xs: [int]) -> Option(int):
    i := 0
    for i < len(xs):
        if xs[i] - (xs[i] / 2) * 2 == 0:
            return Some(xs[i])
        i = i + 1
    return None

# chains two or_returns: both must be Some, else the whole thing is None
fn doubled_even(xs: [int]) -> Option(int):
    v := first_even(xs) or_return
    w := first_even([8, 9]) or_return        # always Some(8)
    return Some(v * 10 + w)

fn show(o: Option(int)) -> string:
    match o:
        Some(n):
            return "Some(" + str(n) + ")"
        None:
            return "None"

fn main():
    println(show(doubled_even([1, 3, 4, 5])))   # Some(48)
    println(show(doubled_even([1, 3, 5])))        # None
    println(show(doubled_even([6])))              # Some(68)
