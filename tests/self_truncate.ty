# FRICTION 251: `xs = xs[0:n]` shrinks xs where it stands -- it copied the kept
# prefix twice. The value must be exactly what the slice gives (and a `hi`
# outside 0..len traps as the slice did: tests/abort/self_truncate_oob.ty).
struct P:
    name: string
    v: int

fn cut(xs: inout [int], n: int):
    xs = xs[0:n]

fn show(xs: [int]) -> string:
    out := ""
    for x in xs:
        out = out + str(x) + ","
    return out

fn main():
    a := [1, 2, 3, 4, 5]
    a = a[0:3]
    println(show(a) + " " + str(len(a)))
    a = a[0:0]                        # empty
    println(show(a) + " " + str(len(a)))
    b := [7, 8, 9]
    b = b[:len(b) - 1]                # hi reads the old length
    println(show(b))
    c := [10, 20, 30, 40]
    keep := c                         # a copy taken before the shrink stays whole
    cut(&c, 2)
    println(show(c) + " " + show(keep))
    push(c, 99)                       # push after a shrink writes past the new end
    println(show(c) + " " + str(len(c)))
    ss := ["x", "yy", "zzz"]
    ss = ss[0:2]
    push(ss, "w")
    println(ss[0] + ss[1] + ss[2] + " " + str(len(ss)))
    ps := [P("a", 1), P("b", 2), P("c", 3)]
    ps = ps[0:1]
    println(ps[0].name + str(ps[0].v) + " " + str(len(ps)))
    d := [1, 2, 3, 4, 5, 6]
    for len(d) > 2:
        d = d[0:len(d) - 2]
    println(show(d))
    e := [5, 6]
    e = e[0:]                          # keeps everything
    println(show(e))
