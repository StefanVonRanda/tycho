{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tycho",
  "scopeName": "source.tycho",
  "patterns": [
    { "name": "comment.line.number-sign.tycho", "match": "#.*$" },
    {
      "name": "string.interpolated.tycho",
      "begin": "f\"",
      "end": "\"",
      "patterns": [
        { "name": "constant.character.escape.tycho", "match": "\\\\x[0-9a-fA-F]{2}|\\\\." },
        {
          "name": "meta.interpolation.tycho",
          "begin": "\\{",
          "end": "\\}",
          "patterns": [{ "include": "$self" }]
        }
      ]
    },
    {
      "name": "string.quoted.double.tycho",
      "begin": "\"",
      "end": "\"",
      "patterns": [{ "name": "constant.character.escape.tycho", "match": "\\\\x[0-9a-fA-F]{2}|\\\\." }]
    },
    {
      "comment": "raw string `...`: no escapes at all, and it may span lines (src/tychoc.c:455-502), so no nested patterns and no end-of-line anchor",
      "name": "string.quoted.other.raw.tycho",
      "begin": "`",
      "end": "`"
    },
    { "name": "constant.character.tycho", "match": "'(\\\\.|[^'])'" },
    { "name": "constant.numeric.tycho", "match": "\\b[0-9]+(\\.[0-9]+)?\\b" },
    {
      "match": "\\b(fn)\\s+([A-Za-z_][A-Za-z0-9_]*)",
      "captures": {
        "1": { "name": "keyword.other.fn.tycho" },
        "2": { "name": "entity.name.function.tycho" }
      }
    },
    { "name": "keyword.control.tycho", "match": "\\b(if|elif|else|for|while|in|match|select|parallel|spawn|return|break|continue|or_return|pass)\\b" },
    { "name": "keyword.other.tycho", "match": "\\b(fn|struct|enum|type|import|package|extern|inout|soa)\\b" },
    { "name": "keyword.operator.word.tycho", "match": "\\b(and|or|not|is)\\b" },
    { "name": "constant.language.tycho", "match": "\\b(true|false|null)\\b" },
    { "name": "storage.type.tycho", "match": "\\b(int|float|string|bool|char|ptr|void)\\b" },
    { "name": "support.function.builtin.tycho", "match": "\\b(print|println|str|len|push|pop|split|substr|find|read_file|write_file|read_all|list_dir|args|getenv|input|chr|die|is_null|sqrt|pow|floor|fabs|map_get|map_set|reserve)\\b" },
    {
      "comment": "`..<` (src/tychoc.c:536) must precede the general operator rule: it is three characters and TextMate takes the first matching pattern, not the longest, so the `<` alternative below would otherwise claim it",
      "name": "keyword.operator.range.tycho",
      "match": "\\.\\.<"
    },
    { "name": "keyword.operator.tycho", "match": ":=|->|==|!=|<=|>=|[-+*/%<>=&|^~]" },
    {
      "comment": "clause separator of `for init; cond; post:` (src/tychoc.c:560); scoped as a separator, like `,`, not as an operator",
      "name": "punctuation.separator.tycho",
      "match": ";"
    }
  ]
}
