#!/bin/sh
# tycho pre-push gate. (Local. No GitHub Actions, ever.) Cheap checks only: the
# link + `path:line` citation gate, the script parse, the version bump, the
# grammar-drift half of spec-check, the frozen-surface lock, the runtime-surface
# oracle, and a quick fuzz smoke. All of them score THE SHA BEING PUSHED, not the
# working tree.
#
# IT DOES NOT RUN THE SWEEP, since 2026-08-10. `make ci N=0` was here and was
# removed on the owner's instruction: ~274s on every push, usually re-running
# what a `make ci` minutes earlier had already run. A pre-push hook earns its
# place by being too cheap to argue with; past that it just teaches people to
# bypass it.
#
# So THE SWEEP IS YOURS TO RUN: `make ci` before a substantial push. What that
# buys, and this hook no longer does, is the wide lanes -- a `datetime`-FFI link
# break in the `site` dogfood and cross-package type-mangling divergences are
# invisible to `make test` and were caught by the sweep. Nothing here replaces
# it; the trade is explicit.
#
# THE gh-pages BRANCH HAS NEVER REACHED THIS HOOK, until 2026-08-17. `git rev-parse
# --git-path hooks/pre-push` in the site worktree resolved to `.githooks/pre-push`
# RELATIVE TO THAT WORKTREE, and the gh-pages tree holds five files -- CNAME, fonts,
# index.html, og-card.html, og.png. No .githooks, so no hook, so every site push
# went out ungated and silently. `make hooks` sets an ABSOLUTE core.hooksPath now,
# which is what makes the two site checks below reachable at all.
#
# Activate once:  make hooks   (sets core.hooksPath to <repo>/.githooks, absolute)
# Emergency bypass (avoid): git push --no-verify
set -eu

# Resolve the repo from THIS FILE, not from the cwd: when the site worktree
# pushes, `git rev-parse --show-toplevel` is that worktree and has no Makefile.
REPO="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"

# pre-push is fed "<local ref> <local sha> <remote ref> <remote sha>" per ref on
# stdin. Read it once -- it cannot be read twice -- and decide from it which
# gates can actually redden for what is being pushed.
REFS="$(cat)"
cd "$REPO"

# What every `make` gate below is scored against. Usually the checkout itself;
# a detached worktree at the pushed sha when the two disagree (see below).
GATEROOT="$REPO"

# Private per-run log (mktemp, not a fixed world-shared /tmp path): no multi-user
# collision/symlink risk. Each step APPENDS under a header; kept on failure (path
# printed), removed on success.
LOG="$(mktemp "${TMPDIR:-/tmp}/tycho-prepush.XXXXXX")"

gate() {   # gate "<label>" <make args...>
    label="$1"; shift
    printf 'pre-push: %s ... ' "$label"
    printf '\n===== %s =====\n' "$label" >>"$LOG"
    if make -s -C "$GATEROOT" "$@" >>"$LOG" 2>&1; then
        printf 'ok\n'
    else
        printf 'FAILED\n\n'; tail -25 "$LOG"
        printf '\npre-push BLOCKED: %s failed (full log: %s). Push aborted.\n' "$label" "$LOG"
        exit 1
    fi
}

run() {   # run "<label>" <command...>   -- like gate(), for non-make lanes
    label="$1"; shift
    printf 'pre-push: %s ... ' "$label"
    printf '\n===== %s =====\n' "$label" >>"$LOG"
    if "$@" >>"$LOG" 2>&1; then
        printf 'ok\n'
    else
        printf 'FAILED\n\n'; tail -25 "$LOG"
        printf '\npre-push BLOCKED: %s failed (full log: %s). Push aborted.\n' "$label" "$LOG"
        exit 1
    fi
}

# The site. Scored at the SHA BEING PUSHED, never at a branch name: the local
# gh-pages ref in this checkout sat 30 commits behind origin while the page was
# rewritten in a worktree, so a gate keyed on the branch would have scored a
# design that had not been live for a week. A deletion (all-zero sha) is skipped.
SITE_SHA="$(printf '%s\n' "$REFS" | awk '$3 == "refs/heads/gh-pages" && $2 !~ /^0+$/ { print $2; exit }')"
if [ -n "$SITE_SHA" ]; then
    # Verdict first, then the proof the verdict could have gone the other way.
    # The reverse order is worse to read: the selfcheck's [c0] baseline fails on
    # an already-broken page, which reports "the checker is broken" when what is
    # broken is the page.
    run "check_contrast (WCAG 1.4.3 / 1.4.11 on the pushed page)" \
        python3 scripts/check_contrast.py --rev "$SITE_SHA"
    run "contrast selfcheck (the checker's own negative controls)" \
        python3 scripts/check_contrast.py --selfcheck --rev "$SITE_SHA"
    # The page's own code. Added 2026-08-17 after the first listing a visitor saw
    # was found to use removed syntax -- by accident, because nothing on the site
    # had ever executed it. Contrast, links and citations all read a code block
    # as text; only this compiles and runs it.
    run "check_site_code (the page's listings compile and run)" \
        python3 scripts/check_site_code.py --rev "$SITE_SHA"
    run "site-code selfcheck (both legs redden)" \
        python3 scripts/check_site_code.py --selfcheck --rev "$SITE_SHA"
fi

# Everything else. Skipped on a gh-pages-only push: no .ty, .md or .c is moving,
# so neither lane below can redden, and the site worktree has no Makefile anyway.
if printf '%s\n' "$REFS" | awk '$3 != "refs/heads/gh-pages" { found = 1 } END { exit !found }'; then
    # SCORE THE SHA BEING PUSHED, not the working tree -- the site half above has
    # done this since 2026-08-17 and this half had not. `make <target>` reads the
    # CHECKOUT, so a dirty tree passed gates the pushed commit fails (and the
    # reverse: a broken commit pushed from a fixed tree went out green). Fast path
    # when they agree, which is every ordinary push: no worktree, no cost. When
    # they disagree, gate a detached worktree at that sha -- the same trick as
    # `--rev`, spelled for lanes that need a tree rather than one file. Measured
    # 2026-09-04: the fast path is free, the worktree path 87 s -- a fresh tree
    # has no tychoc1, and rtparity and fuzz-quick both want one.
    PUSH_SHA="$(printf '%s\n' "$REFS" | awk '$3 != "refs/heads/gh-pages" && $2 !~ /^0+$/ { print $2; exit }')"
    if [ -n "$PUSH_SHA" ] && \
       { [ "$PUSH_SHA" != "$(git rev-parse HEAD)" ] || ! git diff --quiet HEAD --; }; then
        WT="$(mktemp -d "${TMPDIR:-/tmp}/tycho-prepush-wt.XXXXXX")"
        trap 'git worktree remove --force "$WT" >/dev/null 2>&1 || rm -rf "$WT"' EXIT INT TERM
        printf 'pre-push: tree != pushed commit -- gating a worktree at %s\n' "$(git rev-parse --short "$PUSH_SHA")"
        git worktree add --detach --quiet "$WT" "$PUSH_SHA"
        GATEROOT="$WT"
    fi
    # Both sub-second-to-seconds. `make ci N=0` was here until 2026-08-10 and was
    # removed on the owner's instruction: at ~274s it made every push a coffee break,
    # and it re-ran what a `make ci` before the push had usually just run. The gate a
    # push should not be able to skip is the one that is too cheap to think about;
    # the sweep is a thing you run when you want it.
    # cheap, and it guards the shape that reached a push on 2026-08-17: a
    # sweep deleted a branch header and python ran the orphaned body silently
    gate "make script-check (.py/.sh parse, no unreachable code)" script-check
    gate "make check-links (links + path:line citations)" check-links
    # 0.15s, and the moment it exists for is a push: the 0.6->0.7 bump left five
    # files announcing the old release and every gate stayed green.
    gate "make version-check (docs name the shipped version)" version-check
    # 0.03s, and the push it exists for already happened: `packed` shipped with
    # Appendix A carrying a production that docs/spec/02-grammar.md did not, and
    # spec_check.sh was RED at HEAD for two commits. The ~20s examples half stays
    # out -- it builds and runs every runnable snippet in the spec, which is a
    # `make spec-check` job, and --fast says on every run that it skipped it.
    gate "make spec-fast (Appendix A vs the chapters, Appendix E citations)" spec-fast
    # 0.17s. It lived ONLY in `make ci` step [1d], and the standing instruction
    # here is not to run the sweep -- so the freeze was enforced by nobody: it was
    # RED at HEAD across 7f207bcc and 9a4a5e5c, both of which pushed clean.
    gate "make surface-check (keywords/builtins frozen, corelib additive)" surface-check
    # 0.04s, and the same shape surface-check was in: its only home was `make ci`
    # step [2d], which nobody runs, and it had been RED since 51dcb45b -- two
    # packed-struct traps emitted with no oracle entry, across 9 clean pushes.
    gate "make rtparity (emitted runtime surface vs the oracle)" rtparity
    gate "make fuzz-quick (soundness smoke)"     fuzz-quick
fi

rm -f "$LOG"
printf 'pre-push: gates green -- allowing push. NOT run here: `make ci`, and the\n'
printf '  runnable-examples half of `make spec-check` (~20s). Run them yourself before a\n'
printf '  substantial push.\n'
