package main

import "core:strings"
import "driver"

fn usage():
    die("usage: tychoc1 <file.ty> (--emit-c -o <name> [--runtime P] | --dump-tokens | --round-trip | --dump-dnotes | --parse | --parse-census | --resolve | --resolve-census | --dump-symbols | --typecheck | --type-census)")

fn main():
    av := args()
    src := ""
    out := ""
    rt := "runtime/tycho_rt.c"
    emit_c := false
    mode := "compile"
    i := 1
    for i < len(av):
        a := av[i]
        if a == "--emit-c":
            emit_c = true
        elif a == "--dump-tokens":
            mode = "dump"
        elif a == "--round-trip":
            mode = "rt"
        elif a == "--dump-dnotes":
            mode = "dnotes"
        elif a == "--parse":
            mode = "parse"
        elif a == "--parse-census":
            mode = "census"
        elif a == "--resolve":
            mode = "resolve"
        elif a == "--resolve-census":
            mode = "rcensus"
        elif a == "--dump-symbols":
            mode = "symbols"
        elif a == "--typecheck":
            mode = "typecheck"
        elif a == "--type-census":
            mode = "tcensus"
        elif a == "-o":
            i += 1
            if i >= len(av):
                usage()
            out = av[i]
        elif a == "--runtime":
            i += 1
            if i >= len(av):
                usage()
            rt = av[i]
        elif strings.starts_with(a, "-"):
            die("tychoc1: unknown option '" + a + "'")
        else:
            src = a
        i += 1
    if len(src) == 0:
        usage()
    if mode == "dump":
        driver.dump_tokens(src)
        return
    if mode == "rt":
        driver.roundtrip(src)
        return
    if mode == "dnotes":
        driver.dump_dnotes(src)
        return
    if mode == "parse":
        driver.parse_only(src)
        return
    if mode == "census":
        driver.parse_census(src)
        return
    if mode == "resolve":
        driver.resolve_only(src, av[0])
        return
    if mode == "rcensus":
        driver.resolve_census(src, av[0])
        return
    if mode == "typecheck":
        driver.typecheck_only(src, av[0])
        return
    if mode == "tcensus":
        driver.type_census(src, av[0])
        return
    if mode == "symbols":
        driver.dump_symbols(src, av[0])
        return
    if len(out) == 0 or not emit_c:
        usage()
    driver.compile(src, rt, out + ".c", av[0])
    print("wrote " + out + ".c")
