package main

import "core:strings"
import "core:os"
import "driver"

# Kept in step with src/tychoc.c's TYCHO_VERSION by hand; --version must agree.
fn VERSION() -> string:
    return "0.8.6"

# `foo.ty` -> `foo`, the default output base when no -o is given.
fn _strip_ext(p: string) -> string:
    i := len(p)
    for i > 0:
        i -= 1
        if p[i] == 46:
            return p[0:i]
        if p[i] == 47:
            break
    return p

# src/tychoc.c@tychoc_usage's text, so the binary that ships as `tychoc` answers
# --help the same way. One line differs: --emit-c with no -o writes to stdout
# there, and core:io has no stdout stream, so here -o is required.
fn _help() -> string:
    return "tychoc " + VERSION() + " -- the Tycho compiler: transpiles .ty to C and compiles it.\n" +
        "\n" +
        "usage: tychoc <file.ty> [options]\n" +
        "\n" +
        "  With no options, writes a native binary beside the source and removes the\n" +
        "  intermediate .c once cc succeeds. The .c is KEPT when cc fails, as evidence.\n" +
        "\n" +
        "Output\n" +
        "  -o <name>          name the output (with --emit-c, writes <name>.c)\n" +
        "  --                 end of flags: the next argument is the source, even if it\n" +
        "                     starts with '-' (put -o and other flags BEFORE it)\n" +
        "  --emit-c           stop at the C; needs -o <name>\n" +
        "  -g                 build with debug information\n" +
        "  --native           tune the build for this machine\n" +
        "  --target <level>   raise the baseline for this build: x86-64-v2, x86-64-v3,\n" +
        "                     x86-64-v4, or baseline (the default -- adds nothing)\n" +
        "\n" +
        "Linking and the FFI\n" +
        "  --cc <compiler>    use <compiler> instead of the default cc\n" +
        "  -L<dir> -I<dir>    library and include paths (attached or separated)\n" +
        "  --link <lib>       link <lib> -- a bare -l for a library not named in source\n" +
        "  --shim <file.c>    compile and link a companion C file\n" +
        "  --pkg <name>       add pkg-config --cflags --libs for <name>\n" +
        "\n" +
        "Reporting -- these print and exit, they do not build\n" +
        "  --print-shims      the <pkg>_shim.c files this program needs, transitively,\n" +
        "                     one per line: what a hand-written link line passes to cc\n" +
        "  --print-deps       the pkg-config names it needs, transitively, one per line:\n" +
        "                     what a build probes to decide whether to skip\n" +
        "  --symbols          a symbol index for the language server; no code generated\n" +
        "  --bundle           the whole import graph as one post-order source stream\n" +
        "  --version          print the version and exit\n" +
        "  --help, -h         this message\n" +
        "\n" +
        "Environment\n" +
        "  TYCHO_CORELIB              where corelib lives (default: beside this binary)\n" +
        "  TYCHOC_NO_BOUNDS_ELISION   keep every bounds check, even provably redundant\n"

# No source, or a flag missing its argument: the help, on stderr, exit 1.
fn usage():
    eprint(_help())
    exit(1)

fn main():
    av := args()
    src := ""
    out := ""
    rt := "runtime/tycho_rt.c"
    emit_c := false
    cc9 := "cc"
    xtra := []string
    shim9 := []string
    nat := false
    tgt := ""
    dbg := false
    mode := "compile"
    eof := false
    i := 1
    for i < len(av):
        a := av[i]
        if not eof and a == "--":
            eof = true
        elif eof:
            src = a
        elif a == "--emit-c":
            emit_c = true
        elif a == "--dump-tokens":
            mode = "dump"
        elif a == "--round-trip":
            mode = "rt"
        elif a == "--dump-dnotes":
            mode = "dnotes"
        elif a == "--parse":
            mode = "parse"
        elif a == "--parse-census":
            mode = "census"
        elif a == "--resolve":
            mode = "resolve"
        elif a == "--resolve-census":
            mode = "rcensus"
        elif a == "--dump-symbols":
            mode = "symbols"
        elif a == "--typecheck":
            mode = "typecheck"
        elif a == "--type-census":
            mode = "tcensus"
        elif a == "--bundle":
            mode = "bundle"
        elif a == "--print-shims":
            mode = "shims"
        elif a == "--print-deps":
            mode = "deps"
        elif a == "-o":
            i += 1
            if i >= len(av):
                usage()
            out = av[i]
        elif a == "--native":
            nat = true
        elif a == "--target":
            i += 1
            if i >= len(av):
                die("tychoc: --target: missing level (want one of: baseline x86-64-v2 x86-64-v3 x86-64-v4)")
            tgt = av[i]
            if not driver.target_known(tgt):
                die("tychoc: --target: unknown level '" + tgt + "' (want one of: baseline x86-64-v2 x86-64-v3 x86-64-v4)")
        elif a == "-g":
            dbg = true
        elif a == "--version":
            print("tychoc " + VERSION() + "\n")
            return
        elif a == "--help" or a == "-h":
            print(_help())
            return
        elif a == "--symbols":
            mode = "lspsym"
        elif a == "--cc":
            i += 1
            if i >= len(av):
                usage()
            cc9 = av[i]
        elif a == "--link":
            i += 1
            if i >= len(av):
                usage()
            push(xtra, "-l" + driver.cc_safe(av[i], "--link"))
        elif a == "--shim":
            i += 1
            if i >= len(av):
                usage()
            push(shim9, av[i])
        elif a == "--pkg":
            i += 1
            if i >= len(av):
                usage()
            r9 := os.run("pkg-config --cflags --libs " + driver.cc_safe(av[i], "--pkg"))
            if r9.code != 0:
                die("tychoc: pkg-config failed for '" + av[i] + "'")
            for w9 in split(strings.trim(r9.out), " "):
                if len(strings.trim(w9)) > 0:
                    push(xtra, strings.trim(w9))
        # -L/-I take the attached (-L/path) and separated (-L /path) forms
        elif strings.starts_with(a, "-L") or strings.starts_with(a, "-I"):
            push(xtra, a)
            if len(a) == 2 and i + 1 < len(av):
                i += 1
                push(xtra, av[i])
        elif a == "--runtime":
            i += 1
            if i >= len(av):
                usage()
            rt = av[i]
        elif strings.starts_with(a, "-"):
            die("tychoc: unknown option '" + a + "'")
        else:
            src = a
        i += 1
    if len(src) == 0:
        usage()
    if mode == "dump":
        driver.dump_tokens(src)
        return
    if mode == "rt":
        driver.roundtrip(src)
        return
    if mode == "dnotes":
        driver.dump_dnotes(src)
        return
    if mode == "parse":
        driver.parse_only(src)
        return
    if mode == "census":
        driver.parse_census(src)
        return
    if mode == "resolve":
        driver.resolve_only(src, av[0])
        return
    if mode == "rcensus":
        driver.resolve_census(src, av[0])
        return
    if mode == "typecheck":
        driver.typecheck_only(src, av[0])
        return
    if mode == "tcensus":
        driver.type_census(src, av[0])
        return
    if mode == "lspsym":
        driver.emit_symbols(src, av[0])
        return
    if mode == "symbols":
        driver.dump_symbols(src, av[0])
        return
    if mode == "bundle":
        driver.bundle(src, av[0])
        return
    if mode == "shims":
        driver.print_shims(src, av[0])
        return
    if mode == "deps":
        driver.print_deps(src, av[0])
        return
    if not emit_c:
        # The default is a BINARY: emit the C beside it, run cc, remove the C.
        base := out
        if len(base) == 0:
            base = _strip_ext(src)
        driver.build(src, rt, base, av[0], cc9, xtra, shim9, nat, dbg, tgt)
        return
    if len(out) == 0:
        usage()
    driver.compile(src, rt, out + ".c", av[0], dbg, tgt, nat)
    print("wrote " + out + ".c\n")
