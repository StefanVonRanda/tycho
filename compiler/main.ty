package main

import "core:strings"
import "core:os"
import "driver"

# Kept in step with src/tychoc.c's TYCHO_VERSION by hand; --version must agree.
fn VERSION() -> string:
    return "0.7.0"

# `foo.ty` -> `foo`, the default output base when no -o is given.
fn _strip_ext(p: string) -> string:
    i := len(p)
    for i > 0:
        i -= 1
        if p[i] == 46:
            return p[0:i]
        if p[i] == 47:
            break
    return p

fn usage():
    die("usage: tychoc1 <file.ty> ([-o <name>] [--emit-c] [--runtime P] | --bundle | --dump-tokens | --round-trip | --dump-dnotes | --parse | --parse-census | --resolve | --resolve-census | --dump-symbols | --typecheck | --type-census)")

fn main():
    av := args()
    src := ""
    out := ""
    rt := "runtime/tycho_rt.c"
    emit_c := false
    cc9 := "cc"
    xtra := []string
    shim9 := []string
    nat := false
    dbg := false
    mode := "compile"
    eof := false
    i := 1
    for i < len(av):
        a := av[i]
        if not eof and a == "--":
            eof = true
        elif eof:
            src = a
        elif a == "--emit-c":
            emit_c = true
        elif a == "--dump-tokens":
            mode = "dump"
        elif a == "--round-trip":
            mode = "rt"
        elif a == "--dump-dnotes":
            mode = "dnotes"
        elif a == "--parse":
            mode = "parse"
        elif a == "--parse-census":
            mode = "census"
        elif a == "--resolve":
            mode = "resolve"
        elif a == "--resolve-census":
            mode = "rcensus"
        elif a == "--dump-symbols":
            mode = "symbols"
        elif a == "--typecheck":
            mode = "typecheck"
        elif a == "--type-census":
            mode = "tcensus"
        elif a == "--bundle":
            mode = "bundle"
        elif a == "--print-shims":
            mode = "shims"
        elif a == "--print-deps":
            mode = "deps"
        elif a == "-o":
            i += 1
            if i >= len(av):
                usage()
            out = av[i]
        elif a == "--native":
            nat = true
        elif a == "-g":
            dbg = true
        elif a == "--version":
            print("tychoc " + VERSION() + "\n")
            return
        elif a == "--help" or a == "-h":
            usage()
        elif a == "--symbols":
            mode = "lspsym"
        elif a == "--cc":
            i += 1
            if i >= len(av):
                usage()
            cc9 = av[i]
        elif a == "--link":
            i += 1
            if i >= len(av):
                usage()
            push(xtra, "-l" + av[i])
        elif a == "--shim":
            i += 1
            if i >= len(av):
                usage()
            push(shim9, av[i])
        elif a == "--pkg":
            i += 1
            if i >= len(av):
                usage()
            r9 := os.run("pkg-config --cflags --libs " + av[i])
            if r9.code != 0:
                die("tychoc1: pkg-config failed for '" + av[i] + "'")
            for w9 in split(strings.trim(r9.out), " "):
                if len(strings.trim(w9)) > 0:
                    push(xtra, strings.trim(w9))
        # -L/-I take the attached (-L/path) and separated (-L /path) forms
        elif strings.starts_with(a, "-L") or strings.starts_with(a, "-I"):
            push(xtra, a)
            if len(a) == 2 and i + 1 < len(av):
                i += 1
                push(xtra, av[i])
        elif a == "--runtime":
            i += 1
            if i >= len(av):
                usage()
            rt = av[i]
        elif strings.starts_with(a, "-"):
            die("tychoc1: unknown option '" + a + "'")
        else:
            src = a
        i += 1
    if len(src) == 0:
        usage()
    if mode == "dump":
        driver.dump_tokens(src)
        return
    if mode == "rt":
        driver.roundtrip(src)
        return
    if mode == "dnotes":
        driver.dump_dnotes(src)
        return
    if mode == "parse":
        driver.parse_only(src)
        return
    if mode == "census":
        driver.parse_census(src)
        return
    if mode == "resolve":
        driver.resolve_only(src, av[0])
        return
    if mode == "rcensus":
        driver.resolve_census(src, av[0])
        return
    if mode == "typecheck":
        driver.typecheck_only(src, av[0])
        return
    if mode == "tcensus":
        driver.type_census(src, av[0])
        return
    if mode == "lspsym":
        driver.emit_symbols(src, av[0])
        return
    if mode == "symbols":
        driver.dump_symbols(src, av[0])
        return
    if mode == "bundle":
        driver.bundle(src, av[0])
        return
    if mode == "shims":
        driver.print_shims(src, av[0])
        return
    if mode == "deps":
        driver.print_deps(src, av[0])
        return
    if not emit_c:
        # The default is a BINARY: emit the C beside it, run cc, remove the C.
        base := out
        if len(base) == 0:
            base = _strip_ext(src)
        driver.build(src, rt, base, av[0], cc9, xtra, shim9, nat, dbg)
        return
    if len(out) == 0:
        usage()
    driver.compile(src, rt, out + ".c", av[0])
    print("wrote " + out + ".c")
