fn main():
    s := 0
    for i := 0; i < 5; i += 1:              # 0..5
        s = s + i
    println("sum0to4 = " + str(s))          # 10
    t := 0
    for i := 1; i < 6; i += 1:           # 1..6
        t = t + i
    println("sum1to5 = " + str(t))          # 15
    for k := 0; k < 10; k += 2:       # 0,2,4,6,8
        print(str(k) + " ")
    println("")
