package ast

# A node-kind census of a parsed unit. It exists because an accept/reject count
# is blind to a parse that SUCCEEDS with the wrong tree: drop a precedence level
# or a postfix form and every file still parses, with a different shape. The
# census is what moves when that happens.

fn _ct(t: Ty, out: inout [string]):
    match t:
        TPrim(n): push(out, "t.TPrim")
        TParam(n): push(out, "t.TParam")
        TName(q, n, args):
            push(out, "t.TName")
            for a in args:
                _ct(a, &out)
        TArr(k):
            push(out, "t.TArr")
            _ct(k[0], &out)
        TFix(sz, k):
            push(out, "t.TFix")
            _ct(k[0], &out)
        TMap(ks):
            push(out, "t.TMap")
            for a in ks:
                _ct(a, &out)
        TTup(ks):
            push(out, "t.TTup")
            for a in ks:
                _ct(a, &out)
        TFn(hr, ks):
            push(out, "t.TFn")
            for a in ks:
                _ct(a, &out)
        TSoa(k):
            push(out, "t.TSoa")
            _ct(k[0], &out)
        TBnd(sz, k):
            push(out, "t.TBnd")
            _ct(k[0], &out)
        TVec(sz, k):
            push(out, "t.TVec")
            _ct(k[0], &out)

fn _cts(ts: [Ty], out: inout [string]):
    for a in ts:
        _ct(a, &out)

fn _cps(ps: [Param], out: inout [string]):
    for p in ps:
        push(out, "d.Param")
        if p.is_inout:
            push(out, "d.inout")
        if p.is_sink:
            push(out, "d.sink")
        if p.is_variadic:
            push(out, "d.variadic")
        _cts(p.ty, &out)

fn _ces(es: [Expr], out: inout [string]):
    for a in es:
        _ce(a, &out)

fn _ce(e: Expr, out: inout [string]):
    match e:
        IntLit(l, v): push(out, "e.IntLit")
        FloatLit(l, v): push(out, "e.FloatLit")
        StrLit(l, v): push(out, "e.StrLit")
        FStrLit(l, v, hs):
            push(out, "e.FStrLit")
            _ces(hs, &out)
        CharLit(l, v): push(out, "e.CharLit")
        BoolLit(l, v): push(out, "e.BoolLit")
        NullLit(l): push(out, "e.NullLit")
        Name(l, v): push(out, "e.Name")
        Field(l, k, f):
            push(out, "e.Field")
            _ces(k, &out)
        TupIdx(l, k, n):
            push(out, "e.TupIdx")
            _ces(k, &out)
        Index(l, k):
            push(out, "e.Index")
            _ces(k, &out)
        Slice(l, hl, hh, k):
            push(out, "e.Slice")
            _ces(k, &out)
        Call(l, q, n, tas, args):
            push(out, "e.Call")
            if len(q) > 0:
                push(out, "e.CallQual")
            if len(tas) > 0:
                push(out, "e.CallTypeArgs")
            _cts(tas, &out)
            _ces(args, &out)
        CallVal(l, k):
            push(out, "e.CallVal")
            _ces(k, &out)
        Named(l, n, k):
            push(out, "e.Named")
            _ces(k, &out)
        Binop(l, o, k):
            push(out, "e.Binop:" + o)
            _ces(k, &out)
        Unop(l, o, k):
            push(out, "e.Unop:" + o)
            _ces(k, &out)
        IsVar(l, k, q, n):
            push(out, "e.IsVar")
            _ces(k, &out)
        ArrLit(l, k):
            push(out, "e.ArrLit")
            _ces(k, &out)
        MapLit(l, k):
            push(out, "e.MapLit")
            _ces(k, &out)
        EmptyArr(l, ts):
            push(out, "e.EmptyArr")
            _cts(ts, &out)
        EmptyMap(l, ts):
            push(out, "e.EmptyMap")
            _cts(ts, &out)
        SoaLit(l, ts):
            push(out, "e.SoaLit")
            _cts(ts, &out)
        Tuple(l, k):
            push(out, "e.Tuple")
            _ces(k, &out)
        SomeE(l, k):
            push(out, "e.SomeE")
            _ces(k, &out)
        OkE(l, k):
            push(out, "e.OkE")
            _ces(k, &out)
        ErrE(l, k):
            push(out, "e.ErrE")
            _ces(k, &out)
        NoneE(l): push(out, "e.NoneE")
        SpawnE(l, k):
            push(out, "e.SpawnE")
            _ces(k, &out)
        OrRet(l, b, k):
            push(out, "e.OrRet")
            _ces(k, &out)
        Spread(l, k):
            push(out, "e.Spread")
            _ces(k, &out)
        Addr(l, k):
            push(out, "e.Addr")
            _ces(k, &out)
        ChanE(l, ts, k):
            push(out, "e.ChanE")
            _cts(ts, &out)
            _ces(k, &out)
        Lambda(l, ps, r, b):
            push(out, "e.Lambda")
            _cps(ps, &out)
            _cts(r, &out)
            _ces(b, &out)

fn _carms(arms: [Arm], out: inout [string]):
    for a in arms:
        push(out, "a." + a.kind)
        if len(a.qual) > 0:
            push(out, "a.qual")
        if len(a.sub) > 0:
            push(out, "a.nested")
        for b in a.binds:
            push(out, "a.bind")
        for b in a.subbinds:
            push(out, "a.subbind")
        for p in a.pats:
            push(out, "a.pat." + p.kind)
            if p.ranged:
                push(out, "a.range")
        _ces(a.ch, &out)
        _cb(a.body, &out)

fn _cb(b: [Stmt], out: inout [string]):
    for s in b:
        _cs(s, &out)

fn _cs(s: Stmt, out: inout [string]):
    match s:
        ExprStmt(l, k):
            push(out, "s.ExprStmt")
            _ces(k, &out)
        Decl(l, n, an, rhs, ctrl):
            push(out, "s.Decl")
            if len(an) > 0:
                push(out, "s.DeclTyped")
            if len(ctrl) > 0:
                push(out, "s.DeclCtrl")
            _cts(an, &out)
            _ces(rhs, &out)
            _cb(ctrl, &out)
        MDecl(l, isd, ns, rhs):
            if isd:
                push(out, "s.MDecl")
            else:
                push(out, "s.MAssign")
            _ces(rhs, &out)
        Assign(l, n, k):
            push(out, "s.Assign")
            _ces(k, &out)
        PlaceSet(l, k):
            push(out, "s.PlaceSet")
            _ces(k, &out)
        ConstS(l, n, k):
            push(out, "s.ConstS")
            _ces(k, &out)
        PassS(l): push(out, "s.PassS")
        ReturnS(l, k):
            push(out, "s.ReturnS")
            _ces(k, &out)
        BreakS(l): push(out, "s.BreakS")
        ContinueS(l): push(out, "s.ContinueS")
        IfS(l, arms, e):
            push(out, "s.IfS")
            for i := 0; i < len(arms); i += 1:
                if i > 0:
                    push(out, "s.IfS")
                if i + 1 < len(arms) or len(e) > 0:
                    push(out, "s.Else")
                _ces(arms[i].cond, &out)
                _cb(arms[i].body, &out)
            _cb(e, &out)
        WhileS(l, c, b):
            push(out, "s.WhileS")
            _ces(c, &out)
            _cb(b, &out)
        For3(l, ip, c, b):
            push(out, "s.For3")
            _cb(ip, &out)
            _ces(c, &out)
            _cb(b, &out)
        ForIn(l, n, c, b, zpf):
            push(out, "s.ForIn")
            _ces(c, &out)
            _cb(b, &out)
        ForRange(l, n, c, b):
            push(out, "s.ForRange")
            _ces(c, &out)
            _cb(b, &out)
        ParallelS(l, w, b):
            push(out, "s.ParallelS")
            _ces(w, &out)
            _cb(b, &out)
        MatchS(l, c, arms):
            push(out, "s.MatchS")
            _ces(c, &out)
            _carms(arms, &out)
        SelectS(l, arms):
            push(out, "s.SelectS")
            _carms(arms, &out)
        DeleteS(l, k):
            push(out, "s.DeleteS")
            _ces(k, &out)

fn census(u: Unit) -> [string]:
    out := []string
    if len(u.pkg) > 0:
        push(out, "d.package")
    for im in u.imports:
        push(out, "d.import")
    for f in u.fns:
        if f.is_extern:
            push(out, "d.extern")
        else:
            push(out, "d.fn")
        if len(f.typarams) > 0:
            push(out, "d.generic")
        if len(f.dnote) > 0:
            push(out, "d.deprecated")
        for w in f.wheres:
            push(out, "d.where")
        _cps(f.params, &out)
        _cts(f.ret, &out)
        _cb(f.body, &out)
    for st in u.structs:
        push(out, "d.struct")
        for fl in st.fields:
            push(out, "d.field")
            _ct(fl.ty, &out)
    for en in u.enums:
        push(out, "d.enum")
        for v in en.variants:
            push(out, "d.variant")
            _cts(v.payload, &out)
    for nt in u.newtypes:
        push(out, "d.newtype")
        _ct(nt.under, &out)
    for h in u.handles:
        push(out, "d.handle")
    for c in u.consts:
        push(out, "d.const")
        _ce(c.value, &out)
    for sb in u.subscripts:
        push(out, "d.subscript")
        _cps(sb.params, &out)
        _ct(sb.ret, &out)
        _ce(sb.place, &out)
    return out
