# --- O5: discover `t = f(t, ...)` and build owned variants -------------------
# Mirrors src/tychoc.c@collect_owned_variants / owned_site_callee. The variant
# shares the original body; _fnbody selects the owned rules from own_idx.

fn _own_param(f: ast.Fn, n: string) -> bool:
    for p in f.params:
        if p.name == n:
            return true
    return false

fn _own_binds_a(arms: [ast.Arm], n: string) -> bool:
    for a in arms:
        for b in a.binds:
            if b == n:
                return true
        for b in a.subbinds:
            if b == n:
                return true
        if _own_binds_b(a.body, n):
            return true
    return false

fn _own_binds_b(b: [ast.Stmt], n: string) -> bool:
    for s in b:
        match s:
            ast.MatchS(l, c, a):
                if _own_binds_a(a, n):
                    return true
            ast.SelectS(l, a):
                if _own_binds_a(a, n):
                    return true
            _: pass
        for sb in _stmt_bs(s):
            if _own_binds_b(sb, n):
                return true
    return false

fn _own_fn_for(cs: inout C, program: types.Program, fi: int) -> ast.Fn:
    for i := 0; i < len(program.files); i += 1:
        cs.cf = i
        for f in program.files[i].unit.fns:
            if f.is_extern or len(f.typarams) > 0:
                continue
            if _fidx(&cs, f.name) == fi:
                return f
    _bad("internal error: an owned variant has no source function")
    return ast.Fn("", []ast.Param, []ast.Ty, []string, []string, []ast.Stmt, false, "", "", 0)

fn _own_make(cs: inout C, program: types.Program, fi: int, idx: int):
    fd := cs.fds[fi]
    key := fd.name + "|" + str(idx)
    if key in cs.own_sel:
        return
    vn := fd.name + "__own" + str(idx)
    n := 2
    for true:
        if _fidx(&cs, vn) < 0:
            break
        vn = fd.name + "__own" + str(idx) + "_" + str(n)
        n += 1
    push(cs.fds, FD(vn, fd.pnames, fd.ptypes, fd.pinout, fd.psink, fd.pvar, fd.ret, fd.psize))
    push(cs.own_fd, len(cs.fds) - 1)
    push(cs.own_fns, _own_fn_for(&cs, program, fi))
    push(cs.own_cf, cs.cf)
    cs.own_sel[key] = vn
    cs.own_idxv[vn] = idx + 1
    cs.own_orgv[vn] = fd.name

fn _own_scan_site(cs: inout C, program: types.Program, f: ast.Fn, s: ast.Stmt):
    match s:
        ast.Assign(l, n, rhs):
            if len(rhs) == 1:
                match rhs[0]:
                    ast.Call(l2, q, cn, ts, args):
                        nm := cn
                        if len(q) > 0:
                            nm = _qpfx(&cs, q) + cn
                        fi := _fidx(&cs, nm)
                        if fi >= 0 and not _isext(&cs, cs.fds[fi].name) and
                                _heap(&cs, cs.fds[fi].ret) and not _own_param(f, n) and
                                not _own_binds_b(f.body, n) and _creads_l(rhs, n) == 1:
                            idx := -1
                            dup := false
                            for j := 0; j < len(args); j += 1:
                                match args[j]:
                                    ast.Name(l3, jn):
                                        if jn == n:
                                            if idx >= 0:
                                                dup = true
                                            idx = j
                                    _: pass
                            if idx >= 0 and not dup and idx < len(cs.fds[fi].ptypes) and
                                    not cs.fds[fi].pinout[idx] and not cs.fds[fi].psink[idx] and
                                    not (cs.fds[fi].pvar and idx == len(cs.fds[fi].ptypes) - 1) and
                                    _heap(&cs, cs.fds[fi].ptypes[idx]):
                                _own_make(&cs, program, fi, idx)
                    _: pass
        _: pass

fn _own_scan_block(cs: inout C, program: types.Program, f: ast.Fn, b: [ast.Stmt]):
    for s in b:
        _own_scan_site(&cs, program, f, s)
        for sb in _stmt_bs(s):
            _own_scan_block(&cs, program, f, sb)

fn _own_find(cs: inout C, program: types.Program):
    # Benchmark control: the same compiler, variants not generated.
    if len(getenv("TYCHOC_NO_DEST_PASS")) > 0:
        return
    for i := 0; i < len(program.files); i += 1:
        cs.cf = i
        for f in program.files[i].unit.fns:
            if f.is_extern or len(f.typarams) > 0:
                continue
            _own_scan_block(&cs, program, f, f.body)
    cs.cf = -1
