        return (c, "bytes")
    if n == "to_float" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("((double)(" + c + "))", "float")
    if n == "sqrt" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("sqrt(" + c + ")", "float")
    if n == "pow" and len(args) == 2:
        a, at := _ex(&cs, args[0])
        b, bt := _ex(&cs, args[1])
        return ("pow(" + a + ", " + b + ")", "float")
    if n == "floor" and len(args) == 1:
        c, t := _ex(&cs, args[0])
