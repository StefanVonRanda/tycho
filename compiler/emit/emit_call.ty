        pc9 := pfn + "(" + ow + ", &(" + rc + "), " + vc + ")"
        if mapidx and cap9 == 0 and fi9 < 0:
            apt9 := _ctyz(&cs, rt) + " *"
            mb9 := _vcname(&cs, _rootname(args[0]))
            cond9 := "(" + mb9 + ").len < 8192 && _mapv->len == 0"
            return (_with_pre(hp, "({ " + apt9 + "_mapv = &(" + rc + "); if (" + cond9 + ") " +
                _arrf(&cs, et, "_reserve") + "(" + ow + ", _mapv, 768); " +
