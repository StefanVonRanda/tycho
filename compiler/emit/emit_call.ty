            pb := _fresh(&cs, "_pb")
            return (_with_pre(hp, "(__extension__ ({ char *" + pb + " = " + vc + "; " + fsy0 +
                _u(&cs, "tycho_arr_int_append_bytes") + "(" + ow + ", &(" + rc + "), " + pb +
                ", tycho_str_len(" + pb + ")); " + fsy1 + "}))"), "void")
