package emit

import "../ast"
import "../parse"
import "core:strings"

# ast -> C, against the same runtime ABI src/tychoc.c targets: one
# `RET h_<fn>(Arena *_parent, ...)` per function, an `arena_child` scope inside
# it, and every allocation made in that scope. A returned value is deep-copied
# into the CALLER's arena before the scope is freed, which is the unoptimised
# form of src/tychoc.c's return-only-escape pass -- correct, and slower.
#
# None of src/tychoc.c's eight optimisation passes are ported. Scope is the core
# language: scalars, strings, arrays, structs, enums, control flow, functions.
# Everything else dies by name so a fixture fails loudly rather than silently.

struct SD:
    name: string
    fnames: [string]
    ftypes: [string]

struct VD:
    name: string
    ptypes: [string]

struct ED:
    name: string
    vnames: [string]
    vpay: [VD]

struct FD:
    name: string
    pnames: [string]
    ptypes: [string]
    pinout: [bool]
    pvar: bool
    ret: string

struct C:
    sds: [SD]
    eds: [ED]
    fds: [FD]
    akinds: [string]
    cnames: [string]
    ctypes: [string]
    ccode: [string]
    vnames: [string]
    vtypes: [string]
    vcn: [string]
    vown: [string]
    ntn: [string]
    ntu: [string]
    tks: [string]
    mks: [string]
    gks: [string]
    gs: [ast.StructD]
    ge: [ast.EnumD]
    gf: [ast.Fn]
    tpn: [string]
    tpv: [string]
    pk: [int]
    ptv: [string]
    ikey: [string]
    iname: [string]
    iarg: [string]
    pendk: [int]
    want: string
    tmp: int
    cur_ret: string
    loopdepth: int
    arena: string

fn _new() -> C:
    return C([], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], "", 0, "void", 0, "&_scope")

fn _bad(msg: string):
    die("tychoc1: " + msg)

# --- type strings -----------------------------------------------------------
# "int" "float" "bool" "string" "char" "void"; "[T]"; "S~Name"; "E~Name".

fn _is_arr(t: string) -> bool:
    return len(t) > 2 and t[0] == 91

fn _elem(t: string) -> string:
    return t[1:len(t) - 1]

fn _is_struct(t: string) -> bool:
    return strings.starts_with(t, "S~")

fn _is_enum(t: string) -> bool:
    return strings.starts_with(t, "E~")

fn _tname(t: string) -> string:
    return t[2:]

# A newtype is ERASED in lowering (spec 5.4): it is represented exactly as its
# underlying type, so `_ty` resolves the name away and nothing downstream ever
# sees one.
fn _ntidx(cs: inout C, n: string) -> int:
    for i := 0; i < len(cs.ntn); i += 1:
        if cs.ntn[i] == n:
            return i
    return -1

# A tuple type is stamped out like an array kind: the registry key is the
# element type strings joined by "|", and the type string is "T~<index>".
fn _is_tup(t: string) -> bool:
    return strings.starts_with(t, "T~")

fn _tkind(cs: inout C, key: string) -> int:
    for i := 0; i < len(cs.tks); i += 1:
        if cs.tks[i] == key:
            return i
    push(cs.tks, key)
    return len(cs.tks) - 1

fn _tjoin(es: [string]) -> string:
    k := ""
    for i := 0; i < len(es); i += 1:
        if i > 0:
            k = k + "|"
        k = k + es[i]
    return k

fn _telems(cs: inout C, t: string) -> [string]:
    i := strings.parse_int(_tname(t))
    return split(cs.tks[i], "|")

fn _tup_of(cs: inout C, es: [string]) -> string:
    return "T~" + str(_tkind(&cs, _tjoin(es)))

# A map type is stamped out per (key, value) pair exactly as a tuple kind is:
# the registry key is "K|V" and the type string is "M~<index>". The emitted C
# mirrors src/tychoc.c:12894's compact indexed dict -- an int32 index table over
# dense insertion-ordered entries -- so keys() order and str() form agree.
fn _is_map(t: string) -> bool:
    return strings.starts_with(t, "M~")

fn _mkind(cs: inout C, key: string) -> int:
    for i := 0; i < len(cs.mks); i += 1:
        if cs.mks[i] == key:
            return i
    push(cs.mks, key)
    return len(cs.mks) - 1

fn _map_of(cs: inout C, k: string, v: string) -> string:
    return "M~" + str(_mkind(&cs, k + "|" + v))

fn _mparts(cs: inout C, t: string) -> [string]:
    i := strings.parse_int(_tname(t))
    return split(cs.mks[i], "|")

fn _mkey(cs: inout C, t: string) -> string:
    return _mparts(&cs, t)[0]

fn _mval(cs: inout C, t: string) -> string:
    return _mparts(&cs, t)[1]

fn _mpfx(cs: inout C, t: string) -> string:
    return "tycho_mapM" + _tname(t)

# How a key is REPRESENTED in the entry table: a fieldless enum is stored as its
# tag, so `keys()` has to rebuild the singleton (src/tychoc.c:12926).
fn _kclass(cs: inout C, k: string) -> string:
    if k == "string":
        return "str"
    if k == "int" or k == "char" or k == "bool":
        return "int"
    if _is_enum(k):
        return "enum"
    if _is_struct(k) or _is_tup(k) or _is_arr(k):
        return "comp"
    _bad("a map key of type '" + k + "' is not hashable")
    return ""

fn _kslot(cs: inout C, k: string) -> string:
    c := _kclass(&cs, k)
    if c == "str":
        return "char *"
    if c == "int" or c == "enum":
        return "tycho_int "
    return _cty(&cs, k) + " "

# The key as the generated functions take it, from a Tycho-level value.
fn _keyrt(cs: inout C, k: string, code: string) -> string:
    if _kclass(&cs, k) == "enum":
        return "((tycho_int)((" + code + ")->tag))"
    return code

fn _khash(cs: inout C, k: string, e: string) -> string:
    c := _kclass(&cs, k)
    if c == "str":
        return "tycho_si_hash(" + e + ")"
    if c == "int" or c == "enum":
        return "tycho_ik_hash((tycho_int)(" + e + "))"
    return _hash(&cs, k, e)

fn _kmatch(cs: inout C, k: string, ek: string, q: string) -> string:
    c := _kclass(&cs, k)
    if c == "str":
        return "(strcmp(" + ek + ", " + q + ") == 0)"
    if c == "int" or c == "enum":
        return "(" + ek + " == " + q + ")"
    return _eq(&cs, ek, q, k)

fn _kcopy(cs: inout C, k: string) -> string:
    c := _kclass(&cs, k)
    if c == "str":
        return "tycho_str_copy(a, k)"
    if c == "int" or c == "enum":
        return "k"
    return _copy(&cs, "k", k, "a")

# A struct/tuple key hashes field-wise, FNV-folded from the per-process seed --
# src/tychoc.c:10170's gen_hash, which is what makes `==`-equal values hash equal.
fn _hashable(cs: inout C, t: string) -> bool:
    return _hashable_d(&cs, t, 0)

# Depth-bounded: a struct whose field is an array OF ITSELF is a legal recursive
# shape and would otherwise recurse forever here.
fn _hashable_d(cs: inout C, t: string, d: int) -> bool:
    if d > 8:
        return false
    if t == "int" or t == "char" or t == "bool" or t == "float" or t == "string":
        return true
    if _is_enum(t):
        i := _eidx(&cs, t[2:])
        if i < 0:
            return false
        for v in cs.eds[i].vpay:
            if len(v.ptypes) > 0:
                return false
        return true
    if _is_arr(t):
        return _hashable_d(&cs, _elem(t), d + 1)
    if _is_struct(t):
        i2 := _sidx(&cs, _tname(t))
        if i2 < 0:
            return false
        for ft in cs.sds[i2].ftypes:
            if not _hashable_d(&cs, ft, d + 1):
                return false
        return true
    if _is_tup(t):
        for et in _telems(&cs, t):
            if not _hashable_d(&cs, et, d + 1):
                return false
        return true
    return false

fn _hash(cs: inout C, t: string, v: string) -> string:
    if t == "string":
        return "tycho_si_hash(" + v + ")"
    if t == "float":
        return "tycho_ik_hash((tycho_int)((union { double _d; tycho_int _l; }){ ._d = (" +
            v + ") })._l)"
    if _is_enum(t):
        return "tycho_ik_hash((tycho_int)((" + v + ")->tag))"
    if _is_struct(t):
        return "tycho_hash_S_" + _tname(t) + "(" + v + ")"
    if _is_tup(t):
        return "tycho_hash_T" + _tname(t) + "(" + v + ")"
    if _is_arr(t):
        e := _elem(t)
        if e == "int":
            return "tycho_arr_int_hash(" + v + ")"
        if e == "float":
            return "tycho_arr_float_hash(" + v + ")"
        if e == "string":
            return "tycho_arr_str_hash(" + v + ")"
        return "tycho_arr_K" + str(_akind(&cs, e)) + "_hash(" + v + ")"
    return "tycho_ik_hash((tycho_int)(" + v + "))"

# Option and Result are monomorphised into ordinary enums, one per
# instantiation, named `_G<n>` so `_bare_variant` can tell them from a user
# enum -- otherwise a bare `Ok` would resolve into a generated one.
fn _gname(cs: inout C, key: string) -> string:
    for i := 0; i < len(cs.gks); i += 1:
        if cs.gks[i] == key:
            return "_G" + str(i)
    push(cs.gks, key)
    return "_G" + str(len(cs.gks) - 1)

fn _is_gen(n: string) -> bool:
    return strings.starts_with(n, "_G")

fn _opt_of(cs: inout C, t: string) -> string:
    nm := _gname(&cs, "O|" + t)
    if _eidx(&cs, nm) < 0:
        vs := []VD
        push(vs, VD("None", []string))
        ps := []string
        push(ps, t)
        push(vs, VD("Some", ps))
        push(cs.eds, ED(nm, ["None", "Some"], vs))
    return "E~" + nm

fn _res_of(cs: inout C, t: string, e: string) -> string:
    nm := _gname(&cs, "R|" + t + "|" + e)
    if _eidx(&cs, nm) < 0:
        ok := []string
        if t != "void":
            push(ok, t)
        er := []string
        push(er, e)
        vs := []VD
        push(vs, VD("Ok", ok))
        push(vs, VD("Err", er))
        push(cs.eds, ED(nm, ["Ok", "Err"], vs))
    return "E~" + nm

# `want` is the type an expression is being built FOR. `None` and `Err(e)` carry
# no way to name their own instantiation, so without it they cannot be emitted.
fn _is_optT(cs: inout C, t: string) -> bool:
    if not _is_enum(t):
        return false
    i := _eidx(&cs, _tname(t))
    return i >= 0 and _is_gen(_tname(t)) and cs.eds[i].vnames[0] == "None"

fn _is_resT(cs: inout C, t: string) -> bool:
    if not _is_enum(t):
        return false
    i := _eidx(&cs, _tname(t))
    return i >= 0 and _is_gen(_tname(t)) and cs.eds[i].vnames[0] == "Ok"

# A type whose value owns arena memory: copying it means a deep copy.
fn _heap(cs: inout C, t: string) -> bool:
    if t == "string":
        return true
    if _is_arr(t) or _is_enum(t) or _is_map(t):
        return true
    if _is_struct(t):
        i := _sidx(&cs, _tname(t))
        if i < 0:
            return false
        for ft in cs.sds[i].ftypes:
            if _heap(&cs, ft):
                return true
    if _is_tup(t):
        for et in _telems(&cs, t):
            if _heap(&cs, et):
                return true
    return false

fn _sidx(cs: inout C, n: string) -> int:
    for i := 0; i < len(cs.sds); i += 1:
        if cs.sds[i].name == n:
            return i
    return -1

fn _eidx(cs: inout C, n: string) -> int:
    for i := 0; i < len(cs.eds); i += 1:
        if cs.eds[i].name == n:
            return i
    return -1

fn _fidx(cs: inout C, n: string) -> int:
    for i := 0; i < len(cs.fds); i += 1:
        if cs.fds[i].name == n:
            return i
    return -1

# The generated-array registry. int/float/string reuse the runtime's own three
# array types; everything else gets a stamped-out TychoArrK<n>.
fn _akind(cs: inout C, elem: string) -> int:
    for i := 0; i < len(cs.akinds); i += 1:
        if cs.akinds[i] == elem:
            return i
    push(cs.akinds, elem)
    return len(cs.akinds) - 1

fn _apfx(cs: inout C, elem: string) -> string:
    if elem == "int":
        return "tycho_arr_int"
    if elem == "float":
        return "tycho_arr_float"
    if elem == "string":
        return "tycho_arr_str"
    return "tycho_arr_K" + str(_akind(&cs, elem))

# --- generics: monomorphised, one deep instance per distinct binding ---------
# src/tychoc.c:12773 clones the template body per instance and resolves it; the
# same shape here, with a `tpn/tpv` binding stack instead of a substitution pass.
# A binding is pushed while an instance's types (or body) are resolved and popped
# after, so a nested instantiation sees only its own parameters.

fn _gsidx(cs: inout C, n: string) -> int:
    for i := 0; i < len(cs.gs); i += 1:
        if cs.gs[i].name == n:
            return i
    return -1

fn _geidx(cs: inout C, n: string) -> int:
    for i := 0; i < len(cs.ge); i += 1:
        if cs.ge[i].name == n:
            return i
    return -1

fn _gfidx(cs: inout C, n: string) -> int:
    for i := 0; i < len(cs.gf); i += 1:
        if cs.gf[i].name == n:
            return i
    return -1

fn _tpget(cs: inout C, n: string) -> string:
    for i := len(cs.tpn) - 1; i >= 0; i -= 1:
        if cs.tpn[i] == n:
            return cs.tpv[i]
    return ""

fn _bind(cs: inout C, ns: [string], vs: [string]) -> int:
    m := len(cs.tpn)
    for i := 0; i < len(ns); i += 1:
        push(cs.tpn, ns[i])
        if i < len(vs):
            push(cs.tpv, vs[i])
        else:
            push(cs.tpv, "")
    return m

fn _unbind(cs: inout C, m: int):
    for len(cs.tpn) > m:
        pop(cs.tpn)
        pop(cs.tpv)

fn _iidx(cs: inout C, key: string) -> int:
    for i := 0; i < len(cs.ikey); i += 1:
        if cs.ikey[i] == key:
            return i
    return -1

fn _inst_struct(cs: inout C, n: string, targs: [string]) -> string:
    key := "S|" + n + "|" + _tjoin(targs)
    ex := _iidx(&cs, key)
    if ex >= 0:
        return "S~" + cs.iname[ex]
    gi := _gsidx(&cs, n)
    mang := n + "__" + str(len(cs.ikey))
    push(cs.ikey, key)
    push(cs.iname, mang)
    push(cs.iarg, _tjoin(targs))
    push(cs.pendk, -1)
    push(cs.sds, SD(mang, [], []))
    si := len(cs.sds) - 1
    m := _bind(&cs, cs.gs[gi].typarams, targs)
    for f in cs.gs[gi].fields:
        push(cs.sds[si].fnames, f.name)
        push(cs.sds[si].ftypes, _ty(&cs, f.ty))
    _unbind(&cs, m)
    return "S~" + mang

fn _inst_enum(cs: inout C, n: string, targs: [string]) -> string:
    key := "E|" + n + "|" + _tjoin(targs)
    ex := _iidx(&cs, key)
    if ex >= 0:
        return "E~" + cs.iname[ex]
    gi := _geidx(&cs, n)
    mang := n + "__" + str(len(cs.ikey))
    push(cs.ikey, key)
    push(cs.iname, mang)
    push(cs.iarg, _tjoin(targs))
    push(cs.pendk, -1)
    push(cs.eds, ED(mang, [], []))
    ei := len(cs.eds) - 1
    m := _bind(&cs, cs.ge[gi].typarams, targs)
    for v in cs.ge[gi].variants:
        push(cs.eds[ei].vnames, v.name)
        ps := []string
        for pt in v.payload:
            push(ps, _ty(&cs, pt))
        push(cs.eds[ei].vpay, VD(v.name, ps))
    _unbind(&cs, m)
    return "E~" + mang

# The instance's own type arguments, read back out of the registry so a call
# site can unify a template type against a concrete instance.
fn _inst_of(cs: inout C, mang: string) -> [string]:
    for i := 0; i < len(cs.iname); i += 1:
        if cs.iname[i] == mang:
            return split(cs.iarg[i], "|")
    return []string

fn _inst_base(cs: inout C, mang: string) -> string:
    for i := 0; i < len(cs.iname); i += 1:
        if cs.iname[i] == mang:
            return split(cs.ikey[i], "|")[1]
    return ""

# A call site binds the type parameters by matching the DECLARED parameter type
# against the argument's concrete type -- the same shape src/tychoc.c infers,
# structurally and left to right, first binding wins.
fn _unify(cs: inout C, t: ast.Ty, a: string, tps: [string], bs: inout [string]):
    if len(a) == 0:
        return
    match t:
        ast.TParam(n):
            for i := 0; i < len(tps); i += 1:
                if tps[i] == n and len(bs[i]) == 0:
                    bs[i] = a
            return
        ast.TArr(es):
            if _is_arr(a):
                _unify(&cs, es[0], _elem(a), tps, &bs)
            return
        ast.TMap(es):
            if _is_map(a):
                _unify(&cs, es[0], _mkey(&cs, a), tps, &bs)
                _unify(&cs, es[1], _mval(&cs, a), tps, &bs)
            return
        ast.TTup(es):
            if _is_tup(a):
                el := _telems(&cs, a)
                for i := 0; i < len(es) and i < len(el); i += 1:
                    _unify(&cs, es[i], el[i], tps, &bs)
            return
        ast.TName(q, n, targs):
            if len(targs) == 0:
                for i := 0; i < len(tps); i += 1:
                    if tps[i] == n and len(bs[i]) == 0:
                        bs[i] = a
                return
            if n == "Option" and _is_optT(&cs, a):
                ei := _eidx(&cs, _tname(a))
                _unify(&cs, targs[0], cs.eds[ei].vpay[1].ptypes[0], tps, &bs)
                return
            if n == "Result" and _is_resT(&cs, a):
                ei2 := _eidx(&cs, _tname(a))
                ok := cs.eds[ei2].vpay[0].ptypes
                if len(targs) > 0 and len(ok) > 0:
                    _unify(&cs, targs[0], ok[0], tps, &bs)
                er := cs.eds[ei2].vpay[1].ptypes
                if len(targs) > 1 and len(er) > 0:
                    _unify(&cs, targs[1], er[0], tps, &bs)
                return
            if not (_is_struct(a) or _is_enum(a)):
                return
            if _inst_base(&cs, _tname(a)) != n:
                return
            ia := _inst_of(&cs, _tname(a))
            for i := 0; i < len(targs) and i < len(ia); i += 1:
                _unify(&cs, targs[i], ia[i], tps, &bs)
            return
        _: return
    return

fn _blank(n: int) -> [string]:
    out := []string
    for i := 0; i < n; i += 1:
        push(out, "")
    return out

fn _inst_fn(cs: inout C, n: string, targs: [string]) -> int:
    key := "F|" + n + "|" + _tjoin(targs)
    ex := _iidx(&cs, key)
    if ex >= 0:
        return _fidx(&cs, cs.iname[ex])
    gi := _gfidx(&cs, n)
    mang := n + "__" + str(len(cs.ikey))
    push(cs.ikey, key)
    push(cs.iname, mang)
    push(cs.iarg, _tjoin(targs))
    push(cs.pendk, -1)
    ii := len(cs.ikey) - 1
    m := _bind(&cs, cs.gf[gi].typarams, targs)
    pn := []string
    pt := []string
    pio := []bool
    pv := false
    for prm in cs.gf[gi].params:
        if len(prm.ty) == 0:
            _bad("untyped parameter on '" + n + "'")
        one := _ty(&cs, prm.ty[0])
        if prm.is_variadic:
            pv = true
            one = "[" + one + "]"
        push(pn, prm.name)
        push(pt, one)
        push(pio, prm.is_inout)
    rt := _tyo(&cs, cs.gf[gi].ret)
    _unbind(&cs, m)
    push(cs.fds, FD(mang, pn, pt, pio, pv, rt))
    cs.pendk[ii] = len(cs.fds) - 1
    return len(cs.fds) - 1

fn _cty(cs: inout C, t: string) -> string:
    if t == "int" or t == "char":
        return "tycho_int"
    if t == "float":
        return "double"
    if t == "bool":
        return "int"
    if t == "string":
        return "char *"
    if t == "void":
        return "void"
    if _is_struct(t):
        return "S_" + _tname(t)
    if _is_enum(t):
        return "E_" + _tname(t) + " *"
    if _is_tup(t):
        return "TychoTup" + _tname(t)
    if _is_map(t):
        return "TychoMapM" + _tname(t)
    if _is_arr(t):
        e := _elem(t)
        if e == "int":
            return "TychoArrInt"
        if e == "float":
            return "TychoArrFloat"
        if e == "string":
            return "TychoArrStr"
        return "TychoArrK" + str(_akind(&cs, e))
    _bad("no C type for '" + t + "'")
    return ""

# --- syntactic type -> type string ------------------------------------------

fn _ty(cs: inout C, t: ast.Ty) -> string:
    match t:
        ast.TPrim(p):
            if p == "int" or p == "float" or p == "bool" or p == "string" or p == "char" or p == "void":
                return p
            _bad("unsupported primitive type '" + p + "' -- Phase 8")
        ast.TName(q, n, targs):
            if len(q) == 0 and len(targs) == 0 and n == "void":
                return "void"
            if len(q) == 0 and n == "Option" and len(targs) == 1:
                return _opt_of(&cs, _ty(&cs, targs[0]))
            if len(q) == 0 and n == "Result" and len(targs) == 2:
                return _res_of(&cs, _ty(&cs, targs[0]), _ty(&cs, targs[1]))
            if len(q) == 0 and len(targs) > 0:
                as2 := []string
                for a in targs:
                    push(as2, _ty(&cs, a))
                if _gsidx(&cs, n) >= 0:
                    return _inst_struct(&cs, n, as2)
                if _geidx(&cs, n) >= 0:
                    return _inst_enum(&cs, n, as2)
            if len(q) > 0 or len(targs) > 0:
                _bad("qualified or generic type '" + n + "' -- Phase 8")
            tv := _tpget(&cs, n)
            if len(tv) > 0:
                return tv
            ni := _ntidx(&cs, n)
            if ni >= 0:
                if len(cs.ntu[ni]) == 0:
                    _bad("newtype '" + n + "' used before its underlying type resolves")
                return cs.ntu[ni]
            if _sidx(&cs, n) >= 0:
                return "S~" + n
            if _eidx(&cs, n) >= 0:
                return "E~" + n
            _bad("unknown type '" + n + "'")
        ast.TArr(es):
            return "[" + _ty(&cs, es[0]) + "]"
        ast.TParam(n):
            v := _tpget(&cs, n)
            if len(v) == 0:
                _bad("unbound type parameter '$" + n + "'")
            return v
        ast.TFix(n, e): _bad("type:TFix -- Phase 8")
        ast.TMap(e):
            kt := _ty(&cs, e[0])
            return _map_of(&cs, kt, _ty(&cs, e[1]))
        ast.TTup(e):
            es2 := []string
            for x in e:
                push(es2, _ty(&cs, x))
            return _tup_of(&cs, es2)
        ast.TFn(h, e): _bad("type:TFn -- Phase 8")
        ast.TSoa(e): _bad("type:TSoa -- Phase 8")
        ast.TBnd(n, e): _bad("type:TBnd -- Phase 8")
        _: _bad("unsupported type form -- Phase 8")
    return ""

# True when every name in `t` already resolves -- used to order newtype
# resolution without letting `_ty` die on a forward reference.
fn _ty_ready(cs: inout C, t: ast.Ty) -> bool:
    match t:
        ast.TPrim(p): return true
        ast.TParam(n): return len(_tpget(&cs, n)) > 0
        ast.TName(q, n, targs):
            if len(q) > 0:
                return false
            if len(targs) > 0:
                for a in targs:
                    if not _ty_ready(&cs, a):
                        return false
                return _gsidx(&cs, n) >= 0 or _geidx(&cs, n) >= 0
            if len(_tpget(&cs, n)) > 0:
                return true
            ni := _ntidx(&cs, n)
            if ni >= 0:
                return len(cs.ntu[ni]) > 0
            return _sidx(&cs, n) >= 0 or _eidx(&cs, n) >= 0
        ast.TArr(es): return _ty_ready(&cs, es[0])
        ast.TMap(es):
            return _ty_ready(&cs, es[0]) and _ty_ready(&cs, es[1])
        ast.TTup(es):
            for x in es:
                if not _ty_ready(&cs, x):
                    return false
            return true
        _: return false
    return false

fn _tyo(cs: inout C, ts: [ast.Ty]) -> string:
    if len(ts) == 0:
        return "void"
    if len(ts) > 1:
        es := []string
        for x in ts:
            push(es, _ty(&cs, x))
        return _tup_of(&cs, es)
    return _ty(&cs, ts[0])

# --- local scope ------------------------------------------------------------

fn _mark(cs: inout C) -> int:
    return len(cs.vnames)

fn _restore(cs: inout C, m: int):
    for len(cs.vnames) > m:
        pop(cs.vnames)
        pop(cs.vtypes)
        pop(cs.vcn)
        pop(cs.vown)

# A nested `x := x + 1` shadows the outer x, and in C the new declarator is
# already in scope inside its own initialiser -- so the inner read would see
# the uninitialised copy. A shadowing binding gets a fresh C name instead.
fn _push(cs: inout C, n: string, t: string) -> string:
    cn := "h_" + n
    if len(_vtype(&cs, n)) > 0:
        cs.tmp += 1
        cn = "h_" + n + "_s" + str(cs.tmp)
    push(cs.vnames, n)
    push(cs.vtypes, t)
    push(cs.vcn, cn)
    push(cs.vown, "&_scope")
    return cn

fn _vtype(cs: inout C, n: string) -> string:
    for i := len(cs.vnames) - 1; i >= 0; i -= 1:
        if cs.vnames[i] == n:
            return cs.vtypes[i]
    return ""

# Ground a PENDING binding at its first assignment (a value-if/value-match).
fn _vset(cs: inout C, n: string, t: string):
    for i := len(cs.vnames) - 1; i >= 0; i -= 1:
        if cs.vnames[i] == n:
            cs.vtypes[i] = t
            return

fn _vcname(cs: inout C, n: string) -> string:
    for i := len(cs.vnames) - 1; i >= 0; i -= 1:
        if cs.vnames[i] == n:
            return cs.vcn[i]
    return ""

# A heap value reached through an `inout` parameter belongs to the CALLER's
# arena: allocating its growth in this function's `_scope` leaves the buffer
# dangling the moment the callee returns. Each such parameter therefore carries
# its owning arena alongside it, exactly as src/tychoc.c@owner_arena_of does
# with its `_ina_<name>`.
fn _rootname(e: ast.Expr) -> string:
    match e:
        ast.Name(l, n): return n
        ast.Field(l, r, f): return _rootname(r[0])
        ast.Index(l, k): return _rootname(k[0])
        ast.TupIdx(l, k, i): return _rootname(k[0])
        ast.Addr(l, k): return _rootname(k[0])
        _: return ""
    return ""

fn _ownerof(cs: inout C, e: ast.Expr) -> string:
    n := _rootname(e)
    if len(n) == 0:
        return "&_scope"
    for i := len(cs.vnames) - 1; i >= 0; i -= 1:
        if cs.vnames[i] == n:
            return cs.vown[i]
    return "&_scope"

fn _fresh(cs: inout C, p: string) -> string:
    cs.tmp += 1
    return p + str(cs.tmp)

# --- deep copy / str / eq ---------------------------------------------------

fn _copy(cs: inout C, code: string, t: string, arena: string) -> string:
    if t == "string":
        return "tycho_str_copy(" + arena + ", " + code + ")"
    if _is_arr(t):
        return _apfx(&cs, _elem(t)) + "_copy(" + arena + ", " + code + ")"
    if _is_enum(t):
        return "tycho_copy_E_" + _tname(t) + "(" + arena + ", " + code + ")"
    if _is_map(t):
        return _mpfx(&cs, t) + "_copy(" + arena + ", " + code + ")"
    if _is_struct(t) and _heap(&cs, t):
        return "tycho_copy_S_" + _tname(t) + "(" + arena + ", " + code + ")"
    if _is_tup(t) and _heap(&cs, t):
        return "tycho_copy_T" + _tname(t) + "(" + arena + ", " + code + ")"
    return code

fn _tostr(cs: inout C, code: string, t: string) -> string:
    if t == "string":
        return code
    if t == "int":
        return "tycho_int_to_str(" + cs.arena + ", " + code + ")"
    if t == "char":
        return "tycho_chr(" + cs.arena + ", " + code + ")"
    if t == "float":
        return "tycho_float_to_str(" + cs.arena + ", " + code + ")"
    if t == "bool":
        return "tycho_bool_to_str(" + cs.arena + ", " + code + ")"
    if _is_struct(t):
        return "tycho_str_S_" + _tname(t) + "(" + cs.arena + ", " + code + ")"
    if _is_tup(t):
        return "tycho_str_T" + _tname(t) + "(" + cs.arena + ", " + code + ")"
    if _is_enum(t):
        return "tycho_str_E_" + _tname(t) + "(" + cs.arena + ", " + code + ")"
    if _is_map(t):
        return "tycho_str_mapM" + _tname(t) + "(" + cs.arena + ", " + code + ")"
    if _is_arr(t):
        e := _elem(t)
        if e == "int":
            return "tycho_arr_int_str(" + cs.arena + ", " + code + ")"
        if e == "float":
            return "tycho_arr_float_str(" + cs.arena + ", " + code + ")"
        if e == "string":
            return "tycho_arr_str_str(" + cs.arena + ", " + code + ")"
        return "tycho_str_arr_K" + str(_akind(&cs, e)) + "(" + cs.arena + ", " + code + ")"
    _bad("str() of unsupported type '" + t + "'")
    return ""

# The value a missing map key reads as. A Tycho string carries a length header
# in front of the pointer, so a NULL `char *` is not the empty string -- it
# crashes the first read (tests/map_index_read.ty prints exactly that case).
fn _zero(cs: inout C, t: string) -> string:
    if t == "string":
        return "TYCHO_LIT(\"\")"
    if t == "float":
        return "0.0"
    if t == "int" or t == "char" or t == "bool":
        return "0LL"
    return "(" + _cty(&cs, t) + "){0}"

fn _eq(cs: inout C, a: string, b: string, t: string) -> string:
    if t == "string":
        return "(tycho_str_cmp(" + a + ", " + b + ") == 0)"
    if _is_struct(t):
        return "tycho_eq_S_" + _tname(t) + "(" + a + ", " + b + ")"
    if _is_tup(t):
        return "tycho_eq_T" + _tname(t) + "(" + a + ", " + b + ")"
    if _is_enum(t):
        return "tycho_eq_E_" + _tname(t) + "(" + a + ", " + b + ")"
    if _is_map(t):
        return _mpfx(&cs, t) + "_eq(" + a + ", " + b + ")"
    if _is_arr(t):
        return _apfx(&cs, _elem(t)) + "_eq(" + a + ", " + b + ")"
    return "(" + a + " == " + b + ")"

# --- expressions ------------------------------------------------------------
# Every `_ex` returns the C text; `_ty_of` the type string. They are computed
# together and returned as a tuple so an expression is walked once.

# A key that can be evaluated twice with no observable difference.
fn _simple(e: ast.Expr) -> bool:
    match e:
        ast.Name(l, n): return true
        ast.IntLit(l, v): return true
        ast.StrLit(l, v): return true
        ast.CharLit(l, v): return true
        ast.BoolLit(l, v): return true
        ast.FloatLit(l, v): return true
        _: return false
    return false

fn _place(e: ast.Expr) -> bool:
    match e:
        ast.Name(l, n): return true
        ast.Field(l, r, f): return true
        ast.Index(l, k): return true
        ast.TupIdx(l, k, n): return true
        _: return false
    return false

fn _num2(a: string, b: string) -> string:
    if a == "float" or b == "float":
        return "float"
    if a == "char" or b == "char":
        return "char"
    return "int"

fn _lit_float(v: float) -> string:
    s := str(v)
    has := false
    for i := 0; i < len(s); i += 1:
        if s[i] == 46 or s[i] == 101 or s[i] == 69:
            has = true
    if has:
        return s
    return s + ".0"

fn _ex(cs: inout C, e: ast.Expr) -> (string, string):
    match e:
        ast.IntLit(l, v):
            return (str(v) + "LL", "int")
        ast.FloatLit(l, v):
            return (_lit_float(v), "float")
        ast.CharLit(l, v):
            return (str(v) + "LL", "char")
        ast.BoolLit(l, v):
            if v:
                return ("1", "bool")
            return ("0", "bool")
        ast.StrLit(l, s):
            return ("TYCHO_LIT(\"" + s + "\")", "string")
        ast.Name(l, n):
            t := _vtype(&cs, n)
            if len(t) > 0:
                return (_vcname(&cs, n), t)
            for i := 0; i < len(cs.cnames); i += 1:
                if cs.cnames[i] == n:
                    return (cs.ccode[i], cs.ctypes[i])
            ei := _bare_variant(&cs, n)
            if ei >= 0:
                return _variant(&cs, ei, n, [])
            _bad("unknown name '" + n + "'")
        ast.Field(l, r, f):
            rc, rt := _ex(&cs, r[0])
            if not _is_struct(rt):
                _bad("field '" + f + "' on non-struct")
            si := _sidx(&cs, _tname(rt))
            for i := 0; i < len(cs.sds[si].fnames); i += 1:
                if cs.sds[si].fnames[i] == f:
                    return ("((" + rc + ").f_" + f + ")", cs.sds[si].ftypes[i])
            _bad("no field '" + f + "' on " + _tname(rt))
        ast.Index(l, k):
            rc, rt := _ex(&cs, k[0])
            ic, it := _ex(&cs, k[1])
            if rt == "string":
                return ("tycho_str_get(" + rc + ", " + ic + ")", "int")
            if _is_map(rt):
                vt := _mval(&cs, rt)
                g := _mpfx(&cs, rt) + "_get(" + rc + ", " +
                    _keyrt(&cs, _mkey(&cs, rt), ic) + ", " + _zero(&cs, vt) + ")"
                return (_copy(&cs, g, vt, cs.arena), vt)
            if not _is_arr(rt):
                _bad("indexing a non-array")
            et := _elem(rt)
            return (_apfx(&cs, et) + "_get(" + rc + ", " + ic + ")", et)
        ast.Slice(l, hl, hh, k):
            rc, rt := _ex(&cs, k[0])
            lo := "0LL"
            hi := ""
            j := 1
            if hl:
                lc, lt := _ex(&cs, k[j])
                lo = lc
                j += 1
            if hh:
                hc, ht := _ex(&cs, k[j])
                hi = hc
            if rt == "string":
                if len(hi) == 0:
                    hi = "tycho_str_len(" + rc + ")"
                return ("tycho_str_substr(" + cs.arena + ", " + rc + ", " + lo + ", " + hi + ")", "string")
            if not _is_arr(rt):
                _bad("slicing '" + rt + "'")
            sv := _fresh(&cs, "_sv")
            act := _cty(&cs, rt)
            if len(hi) == 0:
                hi = "(" + sv + ".len)"
            sl := "({ " + act + " " + sv + " = " + rc + "; tycho_int " + sv + "lo = " + lo +
                ", " + sv + "hi = " + hi + "; if (" + sv + "lo < 0 || " + sv + "hi > " + sv +
                ".len || " + sv + "lo > " + sv + "hi) { fprintf(stderr, \"tycho: slice [%\" TY_PRId \":%\" TY_PRId \"] out of bounds (len %\" TY_PRId \")\\n\", " +
                sv + "lo, " + sv + "hi, " + sv + ".len); exit(1); } (" + act + "){ " + sv +
                ".data + " + sv + "lo, " + sv + "hi - " + sv + "lo, 0 }; })"
            return (_copy(&cs, sl, rt, "&_scope"), rt)
        ast.Unop(l, op, k):
            c, t := _ex(&cs, k[0])
            if op == "not":
                return ("(!" + c + ")", "bool")
            if op == "-":
                return ("(-" + c + ")", t)
            if op == "~":
                return ("(~" + c + ")", t)
            _bad("unsupported unary '" + op + "'")
        ast.Binop(l, op, k):
            return _binop(&cs, op, k[0], k[1])
        ast.Call(l, q, n, tas, args):
            return _call(&cs, l, q, n, tas, args)
        ast.ArrLit(l, k):
            return _arrlit(&cs, k)
        ast.EmptyArr(l, ts):
            et := ""
            if len(ts) == 0 and _is_map(cs.want):
                # `m: [K: V] = []` -- a bare [] under a map annotation is the
                # empty map, not an empty array.
                mv2 := _fresh(&cs, "_mp")
                return ("({ " + _cty(&cs, cs.want) + " " + mv2 + " = " +
                    _mpfx(&cs, cs.want) + "_with_cap(&_scope, 0); " + mv2 + "; })", cs.want)
            if len(ts) > 0:
                et = _ty(&cs, ts[0])
            else:
                if not _is_arr(cs.want):
                    _bad("a bare [] needs an element type here")
                et = _elem(cs.want)
            v := _fresh(&cs, "_l")
            ct := _cty(&cs, "[" + et + "]")
            return ("({ " + ct + " " + v + " = " + _apfx(&cs, et) +
                "_with_cap(&_scope, 0); " + v + ".len = 0; " + v + "; })", "[" + et + "]")
        ast.IsVar(l, k, q, vn):
            sc, st := _ex(&cs, k[0])
            if not _is_enum(st):
                _bad("`is` on a non-enum")
            ei := _eidx(&cs, _tname(st))
            tag := _tag(&cs, ei, vn)
            return ("((" + sc + ")->tag == " + str(tag) + ")", "bool")
        ast.TupIdx(l, k, n):
            rc, rt := _ex(&cs, k[0])
            if not _is_tup(rt):
                _bad("`.` index on a non-tuple")
            es := _telems(&cs, rt)
            if n < 0 or n >= len(es):
                _bad("tuple has no element " + str(n))
            return ("((" + rc + ").f" + str(n) + ")", es[n])
        ast.Tuple(l, k):
            ecs := []string
            ets := []string
            for x in k:
                xc, xt := _ex_scope(&cs, x)
                if _place(x) and _heap(&cs, xt):
                    xc = _copy(&cs, xc, xt, "&_scope")
                push(ecs, xc)
                push(ets, xt)
            tt := _tup_of(&cs, ets)
            v := _fresh(&cs, "_tp")
            out := "({ " + _cty(&cs, tt) + " " + v + "; "
            for i := 0; i < len(ecs); i += 1:
                out = out + v + ".f" + str(i) + " = " + ecs[i] + "; "
            return (out + v + "; })", tt)
        ast.SomeE(l, k):
            w := cs.want
            if not _is_optT(&cs, w):
                pc, pt := _ex(&cs, k[0])
                w = _opt_of(&cs, pt)
            return _variant(&cs, _eidx(&cs, _tname(w)), "Some", k)
        ast.NoneE(l):
            if not _is_optT(&cs, cs.want):
                _bad("`None` here has no Option type to belong to")
            return _variant(&cs, _eidx(&cs, _tname(cs.want)), "None", []ast.Expr)
        ast.OkE(l, k):
            if not _is_resT(&cs, cs.want):
                _bad("`Ok` here has no Result type to belong to")
            return _variant(&cs, _eidx(&cs, _tname(cs.want)), "Ok", k)
        ast.ErrE(l, k):
            if not _is_resT(&cs, cs.want):
                _bad("`Err` here has no Result type to belong to")
            return _variant(&cs, _eidx(&cs, _tname(cs.want)), "Err", k)
        ast.OrRet(l, k):
            return _orret(&cs, k[0])
        ast.FStrLit(l, v): _bad("expr:FStrLit -- Phase 8")
        ast.NullLit(l): _bad("expr:NullLit -- Phase 8")
        ast.CallVal(l, k):
            return _callval(&cs, k)
        ast.Named(l, n, k): _bad("expr:Named -- Phase 8")
        ast.MapLit(l, k):
            return _maplit(&cs, k)
        ast.EmptyMap(l, t):
            mt := _map_of(&cs, _ty(&cs, t[0]), _ty(&cs, t[1]))
            mv := _fresh(&cs, "_mp")
            return ("({ " + _cty(&cs, mt) + " " + mv + " = " + _mpfx(&cs, mt) +
                "_with_cap(&_scope, 0); " + mv + "; })", mt)
        ast.SoaLit(l, t): _bad("expr:SoaLit -- Phase 8")
        ast.SpawnE(l, k): _bad("expr:SpawnE -- Phase 8")
        ast.Spread(l, k): _bad("expr:Spread -- Phase 8")
        ast.Addr(l, k): _bad("expr:Addr -- Phase 8")
        ast.ChanE(l, t, k): _bad("expr:ChanE -- Phase 8")
        ast.Lambda(l, p, r, b): _bad("expr:Lambda -- Phase 8")
        _: _bad("unsupported expression -- Phase 8")
    return ("", "")

# A value that is STORED outlives the statement that built it, so it is built in
# the scope arena even inside an expression statement's temp arena. Without this
# `push(xs, P("p" + str(i)))` leaves the field pointing into freed memory.
fn _ex_scope(cs: inout C, e: ast.Expr) -> (string, string):
    sav := cs.arena
    cs.arena = "&_scope"
    c, t := _ex(&cs, e)
    cs.arena = sav
    return (c, t)

fn _tag(cs: inout C, ei: int, vn: string) -> int:
    for i := 0; i < len(cs.eds[ei].vnames); i += 1:
        if cs.eds[ei].vnames[i] == vn:
            return i
    _bad("enum " + cs.eds[ei].name + " has no variant '" + vn + "'")
    return 0

fn _bare_variant(cs: inout C, n: string) -> int:
    if _is_enum(cs.want):
        w := _eidx(&cs, _tname(cs.want))
        if w >= 0 and not _is_gen(cs.eds[w].name):
            for v in cs.eds[w].vnames:
                if v == n:
                    return w
    for i := 0; i < len(cs.eds); i += 1:
        if _is_gen(cs.eds[i].name) or _is_inst(&cs, cs.eds[i].name):
            continue
        for v in cs.eds[i].vnames:
            if v == n:
                return i
    return -1

# An INSTANCE of a generic enum is reachable only through the wanted type or by
# inferring its arguments -- never by a bare variant name, which would otherwise
# resolve `Has("hi")` into whichever instance happened to be stamped first.
fn _is_inst(cs: inout C, n: string) -> bool:
    for i := 0; i < len(cs.iname); i += 1:
        if cs.iname[i] == n:
            return true
    return false

fn _variant(cs: inout C, ei: int, vn: string, args: [ast.Expr]) -> (string, string):
    en := cs.eds[ei].name
    tag := _tag(&cs, ei, vn)
    pay := cs.eds[ei].vpay[tag].ptypes
    if len(pay) != len(args):
        _bad("variant " + vn + " takes " + str(len(pay)) + " payload value(s)")
    if len(pay) == 0:
        return ("(&_sing_" + en + "_" + str(tag) + ")", "E~" + en)
    v := _fresh(&cs, "_v")
    out := "({ E_" + en + " *" + v + " = (E_" + en + " *)arena_alloc(&_scope, offsetof(E_" +
        en + ", u) + sizeof(E_" + en + "_" + vn + ")); " + v + "->tag = " + str(tag) + "; "
    for i := 0; i < len(args); i += 1:
        sw := cs.want
        cs.want = pay[i]
        ac, at := _ex_scope(&cs, args[i])
        cs.want = sw
        if pay[i] == "float" and at == "int":
            ac = "(double)(" + ac + ")"
        if _place(args[i]) and _heap(&cs, pay[i]):
            ac = _copy(&cs, ac, pay[i], "&_scope")
        out = out + v + "->u." + vn + ".f" + str(i) + " = " + ac + "; "
    return (out + v + "; })", "E~" + en)

# `x or_return` -- on the failing tag it returns the SAME failure from the
# enclosing function, rebuilt in the caller's arena because this scope is freed
# on the way out.
fn _orret(cs: inout C, e: ast.Expr) -> (string, string):
    sw := cs.want
    cs.want = ""
    c, t := _ex_scope(&cs, e)
    cs.want = sw
    if not (_is_optT(&cs, t) or _is_resT(&cs, t)):
        _bad("`or_return` on a value that is not an Option or a Result")
    ei := _eidx(&cs, _tname(t))
    rt := cs.cur_ret
    if not (_is_optT(&cs, rt) or _is_resT(&cs, rt)):
        _bad("`or_return` inside a function that returns neither Option nor Result")
    ri := _eidx(&cs, _tname(rt))
    v := _fresh(&cs, "_or")
    r2 := _fresh(&cs, "_or")
    bad := 0
    if _is_resT(&cs, t):
        bad = 1
    rbad := 0
    if _is_resT(&cs, rt):
        rbad = 1
    rn := _tname(rt)
    rvn := cs.eds[ri].vnames[rbad]
    rpay := cs.eds[ri].vpay[rbad].ptypes
    mk := "(&_sing_" + rn + "_" + str(rbad) + ")"
    if len(rpay) > 0:
        src := "(" + v + "->u." + cs.eds[ei].vnames[bad] + ".f0)"
        if len(cs.eds[ei].vpay[bad].ptypes) == 0:
            _bad("`or_return` cannot carry a payload the source variant does not have")
        mk = "({ E_" + rn + " *" + r2 + " = (E_" + rn + " *)arena_alloc(_parent, offsetof(E_" +
            rn + ", u) + sizeof(E_" + rn + "_" + rvn + ")); " + r2 + "->tag = " + str(rbad) +
            "; " + r2 + "->u." + rvn + ".f0 = " + _copy(&cs, src, rpay[0], "_parent") + "; " +
            r2 + "; })"
    ok := cs.eds[ei].vpay[1 - bad].ptypes
    got := "((void)0)"
    gt := "void"
    if len(ok) > 0:
        got = "(" + v + "->u." + cs.eds[ei].vnames[1 - bad] + ".f0)"
        gt = ok[0]
    return ("({ E_" + _tname(t) + " *" + v + " = " + c + "; if (" + v + "->tag == " +
        str(bad) + ") { E_" + rn + " *_orr = " + mk +
        "; arena_free(&_scope); return _orr; } " + got + "; })", gt)

fn _arrlit(cs: inout C, k: [ast.Expr]) -> (string, string):
    if len(k) == 0:
        _bad("an empty array literal needs a type")
    c0, et := _ex_scope(&cs, k[0])
    sw := cs.want
    cs.want = et
    v := _fresh(&cs, "_l")
    ct := _cty(&cs, "[" + et + "]")
    out := "({ " + ct + " " + v + " = " + _apfx(&cs, et) + "_with_cap(&_scope, " +
        str(len(k)) + "LL); "
    for i := 0; i < len(k); i += 1:
        ac := c0
        if i > 0:
            ac2, at2 := _ex_scope(&cs, k[i])
            ac = ac2
        if _place(k[i]) and _heap(&cs, et):
            ac = _copy(&cs, ac, et, "&_scope")
        out = out + v + ".data[" + str(i) + "] = " + ac + "; "
    cs.want = sw
    return (out + v + ".len = " + str(len(k)) + "LL; " + v + "; })", "[" + et + "]")

fn _maplit(cs: inout C, k: [ast.Expr]) -> (string, string):
    if len(k) < 2:
        _bad("an empty map literal needs a type")
    kc0, kt := _ex_scope(&cs, k[0])
    vc0, vt := _ex_scope(&cs, k[1])
    mt := _map_of(&cs, kt, vt)
    v := _fresh(&cs, "_mp")
    n := len(k) / 2
    out := "({ " + _cty(&cs, mt) + " " + v + " = " + _mpfx(&cs, mt) +
        "_with_cap(&_scope, " + str(n) + "LL); "
    for i := 0; i < len(k); i += 2:
        sw := cs.want
        cs.want = kt
        kc, kct := _ex_scope(&cs, k[i])
        cs.want = vt
        vc, vct := _ex_scope(&cs, k[i + 1])
        cs.want = sw
        if vt == "float" and vct == "int":
            vc = "(double)(" + vc + ")"
        out = out + _mpfx(&cs, mt) + "_put(&_scope, &" + v + ", " +
            _keyrt(&cs, kt, kc) + ", " + vc + "); "
    return (out + v + "; })", mt)

# `m.get(k)` / `m.get(k, default)` reach emit as a call on a field expression;
# the map read is the only receiver method the language has (fn values are 7b's).
fn _mapget(cs: inout C, mc: string, mt: string, args: [ast.Expr]) -> (string, string):
    if len(args) != 1 and len(args) != 2:
        _bad("m.get(key) or m.get(key, default)")
    kc, kct := _ex(&cs, args[0])
    vt := _mval(&cs, mt)
    d := _zero(&cs, vt)
    if len(args) == 2:
        sw := cs.want
        cs.want = vt
        dc, dt := _ex(&cs, args[1])
        cs.want = sw
        if vt == "float" and dt == "int":
            dc = "(double)(" + dc + ")"
        d = dc
    g := _mpfx(&cs, mt) + "_get(" + mc + ", " + _keyrt(&cs, _mkey(&cs, mt), kc) +
        ", " + d + ")"
    return (_copy(&cs, g, vt, cs.arena), vt)

fn _callval(cs: inout C, k: [ast.Expr]) -> (string, string):
    match k[0]:
        ast.Field(l, r, f):
            if f != "get" or not _is_map(_argtypes(&cs, r)[0]):
                # UFCS: `x.f(a)` is `f(x, a)` for any free function f.
                ua := []ast.Expr
                push(ua, r[0])
                for i := 1; i < len(k); i += 1:
                    push(ua, k[i])
                return _call(&cs, l, "", f, []ast.Ty, ua)
            mc, mt := _ex(&cs, r[0])
            if not _is_map(mt):
                _bad(".get() on a non-map")
            rest := []ast.Expr
            for i := 1; i < len(k); i += 1:
                push(rest, k[i])
            return _mapget(&cs, mc, mt, rest)
        _: _bad("call of a value -- Phase 7b")
    return ("", "")

fn _binop(cs: inout C, op: string, ea: ast.Expr, eb: ast.Expr) -> (string, string):
    a, at := _ex(&cs, ea)
    b, bt := _ex(&cs, eb)
    if op == "in":
        if not _is_map(bt):
            _bad("`in` tests membership in a map")
        return (_mpfx(&cs, bt) + "_has(" + b + ", " + _keyrt(&cs, _mkey(&cs, bt), a) + ")", "bool")
    if op == "and":
        return ("(" + a + " && " + b + ")", "bool")
    if op == "or":
        return ("(" + a + " || " + b + ")", "bool")
    if op == "==":
        return (_eq(&cs, a, b, at), "bool")
    if op == "!=":
        return ("(!" + _eq(&cs, a, b, at) + ")", "bool")
    if op == "<" or op == ">" or op == "<=" or op == ">=":
        if at == "string":
            return ("(tycho_str_cmp(" + a + ", " + b + ") " + op + " 0)", "bool")
        a, b = _widen(a, at, b, bt)
        return ("(" + a + " " + op + " " + b + ")", "bool")
    if op == "+" and at == "string":
        if bt == "char":
            return ("tycho_str_concat_char(" + cs.arena + ", " + a + ", " + b + ")", "string")
        return ("tycho_str_concat(" + cs.arena + ", " + a + ", " + b + ")", "string")
    if op == "/" and at == "int" and bt == "int":
        return ("tycho_idiv(" + a + ", " + b + ")", "int")
    if op == "%" and at == "int" and bt == "int":
        return ("tycho_imod(" + a + ", " + b + ")", "int")
    if op == "+" or op == "-" or op == "*" or op == "/" or op == "%":
        rt := _num2(at, bt)
        a, b = _widen(a, at, b, bt)
        return ("(" + a + " " + op + " " + b + ")", rt)
    if op == "&" or op == "|" or op == "^" or op == "<<" or op == ">>":
        return ("(" + a + " " + op + " " + b + ")", "int")
    _bad("unsupported operator '" + op + "'")
    return ("", "")

fn _widen(a: string, at: string, b: string, bt: string) -> (string, string):
    if at == "float" and bt != "float":
        return (a, "(double)(" + b + ")")
    if bt == "float" and at != "float":
        return ("(double)(" + a + ")", b)
    return (a, b)

# --- calls ------------------------------------------------------------------

fn _call(cs: inout C, l: int, q: string, n: string, tas: [ast.Ty], args: [ast.Expr]) -> (string, string):
    if len(q) > 0:
        # `m.get(k)` lexes as a qualifier-dot-name call; a local of map type
        # named `m` is the map-read, not a package.
        qt := _vtype(&cs, q)
        if n == "get" and _is_map(qt):
            return _mapget(&cs, _vcname(&cs, q), qt, args)
        if len(qt) > 0:
            # UFCS: `x.f(a)` on a local value is `f(x, a)`.
            ua := []ast.Expr
            push(ua, ast.Name(l, q))
            for a in args:
                push(ua, a)
            return _call(&cs, l, "", n, tas, ua)
        _bad("package-qualified call '" + q + "." + n + "' -- Phase 8")
    ta := []string
    for t in tas:
        push(ta, _ty(&cs, t))
    if n == "zero" and len(ta) == 1 and len(args) == 0:
        return (_zero(&cs, ta[0]), ta[0])
    gfi := _gfidx(&cs, n)
    if gfi >= 0:
        tps := cs.gf[gfi].typarams
        bs := ta
        if len(bs) < len(tps):
            bs = _blank(len(tps))
            for j := 0; j < len(ta); j += 1:
                bs[j] = ta[j]
            ats := _argtypes(&cs, args)
            for j := 0; j < len(cs.gf[gfi].params) and j < len(ats); j += 1:
                if len(cs.gf[gfi].params[j].ty) > 0:
                    _unify(&cs, cs.gf[gfi].params[j].ty[0], ats[j], tps, &bs)
        for j := 0; j < len(bs); j += 1:
            if len(bs[j]) == 0:
                _bad("cannot infer '$" + tps[j] + "' at a call to '" + n + "'")
        fj := _inst_fn(&cs, n, bs)
        return _call(&cs, l, "", cs.fds[fj].name, []ast.Ty, args)
    gsi := _gsidx(&cs, n)
    if gsi >= 0:
        tps2 := cs.gs[gsi].typarams
        bs2 := ta
        if len(bs2) < len(tps2):
            bs2 = _blank(len(tps2))
            for j := 0; j < len(ta); j += 1:
                bs2[j] = ta[j]
            if _is_struct(cs.want) and _inst_base(&cs, _tname(cs.want)) == n:
                wa := _inst_of(&cs, _tname(cs.want))
                for j := 0; j < len(bs2) and j < len(wa); j += 1:
                    if len(bs2[j]) == 0:
                        bs2[j] = wa[j]
            ats2 := _argtypes(&cs, _reorder(&cs, _fieldnames(&cs, gsi), args, n))
            for j := 0; j < len(cs.gs[gsi].fields) and j < len(ats2); j += 1:
                _unify(&cs, cs.gs[gsi].fields[j].ty, ats2[j], tps2, &bs2)
        for j := 0; j < len(bs2); j += 1:
            if len(bs2[j]) == 0:
                _bad("cannot infer '$" + tps2[j] + "' constructing '" + n + "'")
        it := _inst_struct(&cs, n, bs2)
        return _call(&cs, l, "", _tname(it), []ast.Ty, args)
    gei := _geidx(&cs, n)
    if gei >= 0:
        _bad("a generic enum is named by a variant, not by the enum")
    ni := _ntidx(&cs, n)
    if ni >= 0:
        if len(args) != 1:
            _bad("newtype " + n + " takes exactly one value")
        ac, at := _ex(&cs, args[0])
        u := cs.ntu[ni]
        if u == "float" and at == "int":
            ac = "(double)(" + ac + ")"
        return (ac, u)
    ei := _bare_variant(&cs, n)
    if ei >= 0:
        return _variant(&cs, ei, n, args)
    gv := _gen_variant(&cs, n, ta, args)
    if len(gv) > 0:
        return _variant(&cs, _eidx(&cs, _tname(gv)), n, args)
    si := _sidx(&cs, n)
    if si >= 0:
        args = _reorder(&cs, cs.sds[si].fnames, args, n)
        if len(args) != len(cs.sds[si].ftypes):
            _bad("struct " + n + " takes " + str(len(cs.sds[si].ftypes)) + " field(s)")
        out := "((S_" + n + "){ "
        for i := 0; i < len(args); i += 1:
            ft := cs.sds[si].ftypes[i]
            sw := cs.want
            cs.want = ft
            ac, at := _ex_scope(&cs, args[i])
            cs.want = sw
            if _place(args[i]) and _heap(&cs, ft):
                ac = _copy(&cs, ac, ft, "&_scope")
            if i > 0:
                out = out + ", "
            out = out + ac
        return (out + " })", "S~" + n)
    if len(tas) > 0:
        _bad("explicit type arguments -- Phase 8")
    fi := _fidx(&cs, n)
    if fi >= 0 and not _shadowable(n):
        np := len(cs.fds[fi].ptypes)
        args = _reorder(&cs, cs.fds[fi].pnames, args, n)
        if cs.fds[fi].pvar:
            if len(args) < np - 1:
                _bad("'" + n + "' takes at least " + str(np - 1) + " argument(s)")
        else:
            if len(args) != np:
                _bad("'" + n + "' takes " + str(np) + " argument(s)")
        out2 := "h_" + n + "(" + cs.arena
        for i := 0; i < np; i += 1:
            pt := cs.fds[fi].ptypes[i]
            if cs.fds[fi].pvar and i == np - 1:
                out2 = out2 + ", " + _pack(&cs, _elem(pt), args, i)
                continue
            if cs.fds[fi].pinout[i]:
                out2 = out2 + ", " + _addr_of(&cs, args[i])
                if _heap(&cs, pt):
                    out2 = out2 + ", " + _ownerof(&cs, args[i])
                continue
            sw := cs.want
            cs.want = pt
            ac, at := _ex(&cs, args[i])
            cs.want = sw
            if pt == "float" and at == "int":
                ac = "(double)(" + ac + ")"
            if _place(args[i]) and _heap(&cs, pt):
                ac = _copy(&cs, ac, pt, "&_scope")
            out2 = out2 + ", " + ac
        return (out2 + ")", cs.fds[fi].ret)
    return _builtin(&cs, n, args)

# An `inout` argument is written `&place` at the call and is a pointer in the
# ABI, so the place is taken as an lvalue rather than read.
# A variant name that belongs to a GENERIC enum template: the instance is the
# wanted type when there is one, otherwise it is inferred from the payload.
fn _gen_variant(cs: inout C, n: string, ta: [string], args: [ast.Expr]) -> string:
    for gi := 0; gi < len(cs.ge); gi += 1:
        vi := -1
        for j := 0; j < len(cs.ge[gi].variants); j += 1:
            if cs.ge[gi].variants[j].name == n:
                vi = j
        if vi < 0:
            continue
        tps := cs.ge[gi].typarams
        if _is_enum(cs.want) and _inst_base(&cs, _tname(cs.want)) == cs.ge[gi].name:
            return cs.want
        bs := _blank(len(tps))
        for j := 0; j < len(ta) and j < len(bs); j += 1:
            bs[j] = ta[j]
        ats := _argtypes(&cs, args)
        pl := cs.ge[gi].variants[vi].payload
        for j := 0; j < len(pl) and j < len(ats); j += 1:
            _unify(&cs, pl[j], ats[j], tps, &bs)
        ok := true
        for j := 0; j < len(bs); j += 1:
            if len(bs[j]) == 0:
                ok = false
        if not ok:
            continue
        return _inst_enum(&cs, cs.ge[gi].name, bs)
    return ""

fn _fieldnames(cs: inout C, gi: int) -> [string]:
    out := []string
    for f in cs.gs[gi].fields:
        push(out, f.name)
    return out

# The concrete type of each argument, computed by walking it with no `want`.
# The walk is pure string building, so doing it again for the real emission
# costs only temp numbers.
fn _argtypes(cs: inout C, args: [ast.Expr]) -> [string]:
    out := []string
    sw := cs.want
    cs.want = ""
    for a in args:
        match a:
            ast.NoneE(l): push(out, "")
            ast.OkE(l, k): push(out, "")
            ast.ErrE(l, k): push(out, "")
            ast.EmptyArr(l, ts):
                if len(ts) == 0:
                    push(out, "")
                else:
                    ac, at := _ex(&cs, a)
                    push(out, at)
            ast.Named(l, nm, k):
                ac2, at2 := _ex(&cs, k[0])
                push(out, at2)
            _:
                ac3, at3 := _ex(&cs, a)
                push(out, at3)
    cs.want = sw
    return out

fn _addr_of(cs: inout C, e: ast.Expr) -> string:
    match e:
        ast.Addr(l, k):
            lc, lt := _lvalue(&cs, k[0])
            return "&(" + lc + ")"
        _:
            lc2, lt2 := _lvalue(&cs, e)
            return "&(" + lc2 + ")"
    return ""

# A variadic tail is packed into a fresh array; `xs...` passes one through.
fn _pack(cs: inout C, et: string, args: [ast.Expr], from: int) -> string:
    if len(args) == from + 1:
        match args[from]:
            ast.Spread(l, k):
                sc, st := _ex(&cs, k[0])
                return sc
            _: pass
    v := _fresh(&cs, "_va")
    n := len(args) - from
    out := "({ " + _cty(&cs, "[" + et + "]") + " " + v + " = " + _apfx(&cs, et) +
        "_with_cap(&_scope, " + str(n) + "LL); "
    for i := from; i < len(args); i += 1:
        sw := cs.want
        cs.want = et
        ac, at := _ex_scope(&cs, args[i])
        cs.want = sw
        if et == "float" and at == "int":
            ac = "(double)(" + ac + ")"
        if _place(args[i]) and _heap(&cs, et):
            ac = _copy(&cs, ac, et, "&_scope")
        out = out + v + ".data[" + str(i - from) + "] = " + ac + "; "
    return out + v + ".len = " + str(n) + "LL; " + v + "; })"

# A `name: value` argument is positional once the declared names are known.
fn _reorder(cs: inout C, names: [string], args: [ast.Expr], who: string) -> [ast.Expr]:
    any := false
    for a in args:
        match a:
            ast.Named(l, n, k): any = true
            _: pass
    if not any:
        return args
    out := []ast.Expr
    for i := 0; i < len(names); i += 1:
        push(out, ast.NullLit(0))
    seen := []bool
    for i := 0; i < len(names); i += 1:
        push(seen, false)
    for i := 0; i < len(args); i += 1:
        match args[i]:
            ast.Named(l, n, k):
                j := -1
                for q := 0; q < len(names); q += 1:
                    if names[q] == n:
                        j = q
                if j < 0:
                    _bad("'" + who + "' has no parameter named '" + n + "'")
                out[j] = k[0]
                seen[j] = true
            _:
                out[i] = args[i]
                seen[i] = true
    for i := 0; i < len(names); i += 1:
        if not seen[i]:
            _bad("'" + who + "' is missing an argument for '" + names[i] + "'")
    return out

fn _shadowable(n: string) -> bool:
    return n == "str" or n == "len" or n == "print" or n == "println" or n == "eprint" or
        n == "die" or n == "exit" or n == "push" or n == "pop" or n == "reserve" or
        n == "chr" or n == "to_char" or n == "char_at" or n == "to_int" or
        n == "to_float" or n == "sqrt" or n == "find" or n == "split" or
        n == "substr" or n == "input" or n == "read_all" or n == "clock" or n == "hash"

# push/pop/reserve MUTATE their first argument, so it has to be reached as a
# place: `push(m["g"], 3)` on a map element is the map's value slot, not the
# copy a read would hand back.
fn _target(cs: inout C, e: ast.Expr) -> (string, string):
    if _place(e):
        return _lvalue(&cs, e)
    return _ex(&cs, e)

fn _builtin(cs: inout C, n: string, args: [ast.Expr]) -> (string, string):
    if n == "str" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return (_tostr(&cs, c, t), "string")
    if n == "len" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        if t == "string":
            return ("tycho_str_len(" + c + ")", "int")
        if _is_arr(t) or _is_map(t):
            return ("((" + c + ").len)", "int")
        _bad("len() of unsupported type '" + t + "'")
    if n == "print" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("tycho_print_s(" + c + ")", "void")
    if n == "println" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("(tycho_print_s(" + c + "), tycho_print(\"\\n\"))", "void")
    if n == "eprint" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("tycho_eprint(" + c + ")", "void")
    if n == "die" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("tycho_die(" + c + ")", "void")
    if n == "exit" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("exit((int)(" + c + "))", "void")
    if n == "push" and len(args) == 2:
        rc, rt := _target(&cs, args[0])
        vc, vt := _ex_scope(&cs, args[1])
        if strings.starts_with(rt, "?A"):
            pi := strings.parse_int(rt[2:])
            rt = "[" + vt + "]"
            cs.ptv[pi] = rt
            _vset(&cs, _rootname(args[0]), rt)
        if not _is_arr(rt):
            _bad("push() on a non-array")
        et := _elem(rt)
        if et == "float" and vt == "int":
            vc = "(double)(" + vc + ")"
        ow := _ownerof(&cs, args[0])
        if _place(args[1]) and _heap(&cs, et):
            vc = _copy(&cs, vc, et, ow)
        return (_apfx(&cs, et) + "_push(" + ow + ", &(" + rc + "), " + vc + ")", "void")
    if n == "pop" and len(args) == 1:
        rc, rt := _target(&cs, args[0])
        if not _is_arr(rt):
            _bad("pop() on a non-array")
        et := _elem(rt)
        return (_apfx(&cs, et) + "_pop(" + _ownerof(&cs, args[0]) + ", &(" + rc + "))", et)
    if n == "keys" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        if not _is_map(t):
            _bad("keys() takes a map")
        kt := _mkey(&cs, t)
        return (_mpfx(&cs, t) + "_keys(" + cs.arena + ", " + c + ")", "[" + kt + "]")
    if n == "reserve" and len(args) == 2:
        rc, rt := _target(&cs, args[0])
        vc, vt := _ex(&cs, args[1])
        ow2 := _ownerof(&cs, args[0])
        if _is_map(rt):
            return (_mpfx(&cs, rt) + "_reserve(" + ow2 + ", &(" + rc + "), " + vc + ")", "void")
        if not _is_arr(rt):
            _bad("reserve() on a non-array")
        return (_apfx(&cs, _elem(rt)) + "_reserve(" + ow2 + ", &(" + rc + "), " + vc + ")", "void")
    if n == "chr" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("tycho_chr(" + cs.arena + ", " + c + ")", "string")
    if n == "to_char" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("((tycho_int)(unsigned char)tycho_chr(" + cs.arena + ", " + c + ")[0])", "char")
    if n == "char_at" and len(args) == 2:
        c, t := _ex(&cs, args[0])
        ic, it := _ex(&cs, args[1])
        return ("tycho_str_get(" + c + ", " + ic + ")", "char")
    if (n == "to_under" or n == "to_str" or n == "to_bool") and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return (c, t)
    if n == "to_int" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        if t == "float":
            return ("tycho_f2i(" + c + ")", "int")
        return ("((tycho_int)(" + c + "))", "int")
    if n == "to_float" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("((double)(" + c + "))", "float")
    if n == "sqrt" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("sqrt(" + c + ")", "float")
    if n == "find" and len(args) == 2:
        c, t := _ex(&cs, args[0])
        sc, st := _ex(&cs, args[1])
        return ("tycho_str_find(" + c + ", " + sc + ")", "int")
    if n == "split" and len(args) == 2:
        c, t := _ex(&cs, args[0])
        sc, st := _ex(&cs, args[1])
        return ("tycho_str_split(" + cs.arena + ", " + c + ", " + sc + ")", "[string]")
    if n == "substr" and len(args) == 3:
        c, t := _ex(&cs, args[0])
        ac, at := _ex(&cs, args[1])
        bc, bt := _ex(&cs, args[2])
        return ("tycho_str_substr(" + cs.arena + ", " + c + ", " + ac + ", " + bc + ")", "string")
    if n == "input" and len(args) == 0:
        return ("tycho_input(" + cs.arena + ")", "string")
    if n == "read_all" and len(args) == 0:
        return ("tycho_read_all(" + cs.arena + ")", "string")
    if n == "args" and len(args) == 0:
        return ("tycho_args(" + cs.arena + ")", "[string]")
    if n == "now" and len(args) == 0:
        return ("tycho_now()", "int")
    if n == "read_file" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("tycho_read_file(" + cs.arena + ", " + c + ")", "string")
    if n == "write_file" and len(args) == 2:
        c, t := _ex(&cs, args[0])
        d, dt := _ex(&cs, args[1])
        return ("tycho_write_file(" + c + ", " + d + ")", "int")
    if n == "clock" and len(args) == 0:
        return ("tycho_clock()", "int")
    _bad("unsupported call '" + n + "' with " + str(len(args)) + " argument(s)")
    return ("", "")

# --- places (assignment targets) --------------------------------------------

fn _lvalue(cs: inout C, e: ast.Expr) -> (string, string):
    match e:
        ast.Name(l, n):
            t := _vtype(&cs, n)
            if len(t) == 0:
                _bad("assignment to unknown name '" + n + "'")
            return (_vcname(&cs, n), t)
        ast.Field(l, r, f):
            rc, rt := _lvalue(&cs, r[0])
            si := _sidx(&cs, _tname(rt))
            if si < 0:
                _bad("field assignment on a non-struct")
            for i := 0; i < len(cs.sds[si].fnames); i += 1:
                if cs.sds[si].fnames[i] == f:
                    return ("((" + rc + ").f_" + f + ")", cs.sds[si].ftypes[i])
            _bad("no field '" + f + "' on " + _tname(rt))
        ast.TupIdx(l, k, n):
            rc, rt := _lvalue(&cs, k[0])
            if not _is_tup(rt):
                _bad("`.` assignment on a non-tuple")
            es := _telems(&cs, rt)
            return ("((" + rc + ").f" + str(n) + ")", es[n])
        ast.Index(l, k):
            rc, rt := _lvalue(&cs, k[0])
            ic, it := _ex(&cs, k[1])
            if _is_map(rt):
                vt := _mval(&cs, rt)
                return ("(*" + _mpfx(&cs, rt) + "_slotptr(" + _ownerof(&cs, k[0]) + ", &(" + rc + "), " +
                    _keyrt(&cs, _mkey(&cs, rt), ic) + "))", vt)
            if not _is_arr(rt):
                _bad("indexed assignment on a non-array")
            et := _elem(rt)
            return ("(*" + _apfx(&cs, et) + "_ptr(&(" + rc + "), " + ic + "))", et)
        _: _bad("unsupported assignment target")
    return ("", "")

# --- statements -------------------------------------------------------------

fn _rhs(cs: inout C, e: ast.Expr, want: string) -> (string, string):
    return _rhs2(&cs, e, want, "&_scope")

fn _rhs2(cs: inout C, e: ast.Expr, want: string, arena: string) -> (string, string):
    sw := cs.want
    cs.want = want
    c, t := _ex(&cs, e)
    cs.want = sw
    if _place(e) and _heap(&cs, t):
        c = _copy(&cs, c, t, arena)
    if len(want) > 0 and want == "float" and t == "int":
        c = "(double)(" + c + ")"
        t = "float"
    return (c, t)

fn _block(cs: inout C, body: [ast.Stmt], ind: string) -> string:
    m := _mark(&cs)
    out := ""
    for s in body:
        out = out + _stmt(&cs, s, ind)
    _restore(&cs, m)
    return out

fn _stmt(cs: inout C, s: ast.Stmt, ind: string) -> string:
    match s:
        ast.PassS(l):
            return ind + ";\n"
        ast.ExprStmt(l, es):
            sav := cs.arena
            sw := cs.want
            cs.want = ""
            cs.arena = "&_t"
            c, t := _ex(&cs, es[0])
            cs.arena = sav
            cs.want = sw
            return ind + "{ Arena _t = arena_new(0); " + c + "; arena_free(&_t); }\n"
        ast.Decl(l, n, ann, rhs, vv):
            if len(vv) > 0:
                # `x := if c: a else: b` -- declare the variable, then run the
                # control statement with every value tail rewritten to assign it.
                t0 := ""
                if len(ann) > 0:
                    t0 = _ty(&cs, ann[0])
                if len(t0) == 0:
                    t0 = "?"
                cn0 := _push(&cs, n, t0)
                slot := len(cs.vnames) - 1
                body := _stmt(&cs, parse.rewrite_tails(vv[0], "assign", n, []ast.Expr), ind)
                if cs.vtypes[slot] == "?":
                    _bad("a value-if/value-match with no value tail to type it")
                return ind + _cty(&cs, cs.vtypes[slot]) + " " + cn0 + ";\n" + body
            want := ""
            if len(ann) > 0:
                want = _ty(&cs, ann[0])
            if len(rhs) == 0:
                _bad("a declaration with no initialiser")
            if len(ann) == 0 and not _is_arr(cs.want):
                # `out := []` -- the element type comes from the first push into
                # it, which is only known once the rest of the body is walked.
                # The declaration is emitted with a placeholder and patched in
                # _fnbody, the same shape the value-if declaration uses.
                match rhs[0]:
                    ast.EmptyArr(l2, ts):
                        if len(ts) == 0:
                            cs.tmp += 1
                            kk := cs.tmp
                            push(cs.pk, kk)
                            push(cs.ptv, "")
                            cnp := _push(&cs, n, "?A" + str(len(cs.pk) - 1))
                            return ind + "_PT" + str(kk) + " " + cnp + " = _PE" + str(kk) + ";\n"
                    _: pass
            c, t := _rhs(&cs, rhs[0], want)
            if len(want) > 0:
                t = want
            cn := _push(&cs, n, t)
            return ind + _cty(&cs, t) + " " + cn + " = " + c + ";\n"
        ast.ConstS(l, n, k):
            c, t := _ex(&cs, k[0])
            cn2 := _push(&cs, n, t)
            return ind + _cty(&cs, t) + " " + cn2 + " = " + c + ";\n"
        ast.Assign(l, n, k):
            t := _vtype(&cs, n)
            if len(t) == 0:
                _bad("assignment to unknown name '" + n + "'")
            if t == "?":
                t = ""
            rc, rt := _rhs(&cs, k[0], t)
            if len(t) == 0:
                _vset(&cs, n, rt)
            return ind + _vcname(&cs, n) + " = " + rc + ";\n"
        ast.PlaceSet(l, k):
            # `m[f()] += 1` desugars to `m[f()] = m[f()] + 1` with the SAME key
            # node on both sides; hoist a side-effecting key into a temp so it
            # is evaluated exactly once, as src/tychoc.c does.
            lhs := k[0]
            rhs := k[1]
            pre := ""
            match lhs:
                ast.Index(l2, ix):
                    if not _simple(ix[1]):
                        kc0, kt0 := _ex(&cs, ix[1])
                        cs.tmp += 1
                        kn := "_mk" + str(cs.tmp)
                        cn3 := _push(&cs, kn, kt0)
                        pre = ind + _cty(&cs, kt0) + " " + cn3 + " = " + kc0 + ";\n"
                        nk := ast.Name(l2, kn)
                        lhs = ast.Index(l2, [ix[0], nk])
                        match rhs:
                            ast.Binop(l3, op3, bk):
                                match bk[0]:
                                    ast.Index(l4, ix2):
                                        rhs = ast.Binop(l3, op3, [ast.Index(l4, [ix2[0], nk]), bk[1]])
                                    _: pass
                            _: pass
                _: pass
            k = [lhs, rhs]
            lc, lt := _lvalue(&cs, k[0])
            ow := _ownerof(&cs, k[0])
            sav2 := cs.arena
            cs.arena = ow
            rc2, rt2 := _rhs2(&cs, k[1], lt, ow)
            cs.arena = sav2
            return pre + ind + lc + " = " + rc2 + ";\n"
        ast.ReturnS(l, k):
            if len(k) == 0:
                return ind + "{ arena_free(&_scope); return; }\n"
            sw := cs.want
            cs.want = cs.cur_ret
            c, t := _ex(&cs, k[0])
            cs.want = sw
            rt := cs.cur_ret
            if rt == "float" and t == "int":
                c = "(double)(" + c + ")"
            c = _copy(&cs, c, rt, "_parent")
            v := _fresh(&cs, "_ret")
            return ind + "{ " + _cty(&cs, rt) + " " + v + " = " + c +
                "; arena_free(&_scope); return " + v + "; }\n"
        ast.BreakS(l):
            return ind + "break;\n"
        ast.ContinueS(l):
            return ind + "continue;\n"
        ast.IfS(l, c, b, e):
            cc, ct := _ex(&cs, c[0])
            out := ind + "if (" + cc + ") {\n" + _block(&cs, b, ind + "    ") + ind + "}"
            if len(e) > 0:
                out = out + " else {\n" + _block(&cs, e, ind + "    ") + ind + "}"
            return out + "\n"
        ast.WhileS(l, c, b):
            cc := "1"
            if len(c) > 0:
                c2, ct2 := _ex(&cs, c[0])
                cc = c2
            return ind + "while (" + cc + ") {\n" + _block(&cs, b, ind + "    ") + ind + "}\n"
        ast.For3(l, ip, c, b):
            m := _mark(&cs)
            init := _stmt(&cs, ip[0], "")
            cc, ct := _ex(&cs, c[0])
            post := _stmt(&cs, ip[1], "")
            out := ind + "{\n" + ind + "    " + _trim_nl(init) +
                ind + "    for (; " + cc + "; " + _strip_semi(post) + ") {\n" +
                _block(&cs, b, ind + "        ") + ind + "    }\n" + ind + "}\n"
            _restore(&cs, m)
            return out
        ast.ForIn(l, n, c, b):
            cc, ct := _ex(&cs, c[0])
            if ct == "string":
                fs := _fresh(&cs, "_fs")
                fj := _fresh(&cs, "_fj")
                ms := _mark(&cs)
                scn := _push(&cs, n, "char")
                outs := ind + "{\n" + ind + "    char *" + fs + " = " + cc + ";\n" +
                    ind + "    for (tycho_int " + fj + " = 0; " + fj +
                    " < tycho_str_len(" + fs + "); " + fj + " += 1) {\n" +
                    ind + "        tycho_int " + scn + " = tycho_str_get(" + fs + ", " + fj + ");\n" +
                    _block(&cs, b, ind + "        ") + ind + "    }\n" + ind + "}\n"
                _restore(&cs, ms)
                return outs
            if not _is_arr(ct):
                _bad("for-in over '" + ct + "' -- only arrays here, maps are Phase 8")
            et := _elem(ct)
            fc := _fresh(&cs, "_fc")
            fi := _fresh(&cs, "_fi")
            m := _mark(&cs)
            fcn := _push(&cs, n, et)
            out := ind + "{\n" + ind + "    " + _cty(&cs, "[" + et + "]") + " " + fc +
                " = " + _copy(&cs, cc, ct, "&_scope") + ";\n" +
                ind + "    for (tycho_int " + fi + " = 0; " + fi + " < " + fc +
                ".len; " + fi + " += 1) {\n" +
                ind + "        " + _cty(&cs, et) + " " + fcn + " = " + fc + ".data[" + fi + "];\n" +
                _block(&cs, b, ind + "        ") + ind + "    }\n" + ind + "}\n"
            _restore(&cs, m)
            return out
        ast.MatchS(l, subj, arms):
            return _match(&cs, subj[0], arms, ind)
        ast.MDecl(l, d, ns, r):
            rc, rt := _ex(&cs, r[0])
            if not _is_tup(rt):
                _bad("a destructuring list needs a tuple on the right")
            es := _telems(&cs, rt)
            if len(es) != len(ns):
                _bad("destructuring " + str(len(ns)) + " names from a " +
                    str(len(es)) + "-element tuple")
            tv := _fresh(&cs, "_ds")
            out := ind + _cty(&cs, rt) + " " + tv + " = " + rc + ";\n"
            # every target is read out of the temporary FIRST, so `a, b = b, a`
            # swaps rather than clobbering.
            cns := []string
            for i := 0; i < len(ns); i += 1:
                if d:
                    push(cns, "")
                else:
                    t2 := _vtype(&cs, ns[i])
                    if len(t2) == 0:
                        _bad("assignment to unknown name '" + ns[i] + "'")
                    push(cns, _vcname(&cs, ns[i]))
            for i := 0; i < len(ns); i += 1:
                v := "(" + tv + ".f" + str(i) + ")"
                if _heap(&cs, es[i]):
                    v = _copy(&cs, v, es[i], "&_scope")
                if d:
                    cn := _push(&cs, ns[i], es[i])
                    out = out + ind + _cty(&cs, es[i]) + " " + cn + " = " + v + ";\n"
                else:
                    out = out + ind + cns[i] + " = " + v + ";\n"
            return out
        ast.ForRange(l, n, c, b): _bad("stmt:ForRange -- Phase 8")
        ast.ParallelS(l, w, b): _bad("stmt:ParallelS -- Phase 8")
        ast.SelectS(l, a): _bad("stmt:SelectS -- Phase 8")
        ast.DeleteS(l, k):
            match k[0]:
                ast.Index(l2, ix):
                    mc, mt := _lvalue(&cs, ix[0])
                    kc, kt := _ex(&cs, ix[1])
                    if not _is_map(mt):
                        _bad("`delete` takes a map element")
                    return ind + _mpfx(&cs, mt) + "_del(&(" + mc + "), " +
                        _keyrt(&cs, _mkey(&cs, mt), kc) + ");\n"
                _: _bad("`delete` takes a map element")
            return ""
        _: _bad("unsupported statement -- Phase 8")
    return ""

# The first value tail of a value-if/value-match, which is what types the
# variable being declared when there is no annotation.
fn _tail_expr(s: ast.Stmt) -> [ast.Expr]:
    match s:
        ast.ExprStmt(l, es): return es
        ast.IfS(l, c, b, e):
            if len(b) > 0:
                r := _tail_expr(b[len(b) - 1])
                if len(r) > 0:
                    return r
            if len(e) > 0:
                return _tail_expr(e[len(e) - 1])
            return []ast.Expr
        ast.MatchS(l, sub, arms):
            for a in arms:
                if len(a.body) > 0:
                    r2 := _tail_expr(a.body[len(a.body) - 1])
                    if len(r2) > 0:
                        return r2
            return []ast.Expr
        _: return []ast.Expr
    return []ast.Expr

# A for-3 post clause has to run on `continue`, so the loop is a real C `for`
# and the post statement becomes its third clause -- an expression, not a
# statement. tests/for3.ty documents why: `i` advances only there.
fn _strip_semi(s: string) -> string:
    e := len(s)
    for e > 0 and (s[e - 1] == 10 or s[e - 1] == 59 or s[e - 1] == 32):
        e -= 1
    return s[0:e]

fn _trim_nl(s: string) -> string:
    if len(s) > 0 and s[len(s) - 1] == 10:
        return s[0:len(s) - 1] + "\n"
    return s + "\n"

# A scalar pattern is a literal or the NAME of a const, which src/tychoc.c has
# already folded to one literal by the time it reaches here.
fn _patv(cs: inout C, kind: string, v: int, nm: string) -> string:
    if kind == "name":
        for i := 0; i < len(cs.cnames); i += 1:
            if cs.cnames[i] == nm:
                return cs.ccode[i]
        t := _vtype(&cs, nm)
        if len(t) > 0:
            return _vcname(&cs, nm)
        _bad("unknown name '" + nm + "' in a match pattern")
    return str(v) + "LL"

fn _match(cs: inout C, subj: ast.Expr, arms: [ast.Arm], ind: string) -> string:
    sc, st := _ex(&cs, subj)
    v := _fresh(&cs, "_m")
    if _is_enum(st):
        ei := _eidx(&cs, _tname(st))
        out := ind + "{\n" + ind + "    E_" + _tname(st) + " *" + v + " = " + sc + ";\n"
        first := true
        deflt := ""
        for a in arms:
            if a.kind == "default" or a.name == "_":
                deflt = _block(&cs, a.body, ind + "        ")
                continue
            if a.kind != "variant":
                _bad("unsupported match arm on an enum")
            tag := _tag(&cs, ei, a.name)
            pay := cs.eds[ei].vpay[tag].ptypes
            head := ind + "    if"
            if not first:
                head = ind + "    else if"
            first = false
            m := _mark(&cs)
            binds := ""
            for i := 0; i < len(a.binds); i += 1:
                if i >= len(pay):
                    _bad("variant " + a.name + " binds more than its payload")
                bcn := _push(&cs, a.binds[i], pay[i])
                cs.vcn[len(cs.vcn) - 1] = "(*" + bcn + ")"
                binds = binds + ind + "        " + _cty(&cs, pay[i]) + " *" + bcn +
                    " = &" + v + "->u." + a.name + ".f" + str(i) + ";\n"
            body := _block(&cs, a.body, ind + "        ")
            _restore(&cs, m)
            out = out + head + " (" + v + "->tag == " + str(tag) + ") {\n" + binds + body +
                ind + "    }\n"
        if first:
            return out + deflt + ind + "}\n"
        if len(deflt) > 0:
            out = out + ind + "    else {\n" + deflt + ind + "    }\n"
        else:
            out = out + ind + "    else { fprintf(stderr, \"tycho: non-exhaustive match\\n\"); exit(1); }\n"
        return out + ind + "}\n"
    # scalar subject
    out2 := ind + "{\n" + ind + "    " + _cty(&cs, st) + " " + v + " = " + sc + ";\n"
    first2 := true
    deflt2 := ""
    for a in arms:
        if a.kind == "default" or a.name == "_":
            deflt2 = _block(&cs, a.body, ind + "        ")
            continue
        if a.kind != "scalar":
            _bad("unsupported match arm on a scalar")
        cond := ""
        for p in a.pats:
            one := ""
            if p.ranged:
                one = "(" + v + " >= " + _patv(&cs, p.kind, p.lo, p.loname) + " && " + v +
                    " <= " + _patv(&cs, p.kind, p.hi, p.hiname) + ")"
            else:
                one = "(" + v + " == " + _patv(&cs, p.kind, p.lo, p.loname) + ")"
            if len(cond) > 0:
                cond = cond + " || "
            cond = cond + one
        head2 := ind + "    if"
        if not first2:
            head2 = ind + "    else if"
        first2 = false
        out2 = out2 + head2 + " (" + cond + ") {\n" + _block(&cs, a.body, ind + "        ") +
            ind + "    }\n"
    if first2:
        return out2 + deflt2 + ind + "}\n"
    if len(deflt2) > 0:
        out2 = out2 + ind + "    else {\n" + deflt2 + ind + "    }\n"
    return out2 + ind + "}\n"

# --- declaration collection -------------------------------------------------

fn _collect(cs: inout C, u: ast.Unit):
    for sd in u.structs:
        if len(sd.typarams) > 0:
            push(cs.gs, sd)
        else:
            push(cs.sds, SD(sd.name, [], []))
    for ed in u.enums:
        if len(ed.typarams) > 0:
            push(cs.ge, ed)
        else:
            push(cs.eds, ED(ed.name, [], []))
    for nt in u.newtypes:
        push(cs.ntn, nt.name)
        push(cs.ntu, "")
    # A newtype over a LATER newtype is legal, so resolve only the ones whose
    # every named part is already known and repeat until nothing moves.
    for pas := 0; pas <= len(u.newtypes); pas += 1:
        for i := 0; i < len(u.newtypes); i += 1:
            if len(cs.ntu[i]) == 0 and _ty_ready(&cs, u.newtypes[i].under):
                cs.ntu[i] = _ty(&cs, u.newtypes[i].under)
    for i := 0; i < len(u.newtypes); i += 1:
        if len(cs.ntu[i]) == 0:
            cs.ntu[i] = _ty(&cs, u.newtypes[i].under)
    for i := 0; i < len(u.structs); i += 1:
        if len(u.structs[i].typarams) > 0:
            continue
        si := _sidx(&cs, u.structs[i].name)
        for f in u.structs[i].fields:
            push(cs.sds[si].fnames, f.name)
            push(cs.sds[si].ftypes, _ty(&cs, f.ty))
    for i := 0; i < len(u.enums); i += 1:
        if len(u.enums[i].typarams) > 0:
            continue
        ei := _eidx(&cs, u.enums[i].name)
        for v in u.enums[i].variants:
            push(cs.eds[ei].vnames, v.name)
            ps := []string
            for p in v.payload:
                push(ps, _ty(&cs, p))
            push(cs.eds[ei].vpay, VD(v.name, ps))
    for f in u.fns:
        if len(f.typarams) > 0:
            push(cs.gf, f)
            continue
        if f.is_extern:
            _bad("extern function '" + f.name + "' -- Phase 8")
        pn := []string
        pt := []string
        pio := []bool
        pv := false
        for p in f.params:
            if len(p.ty) == 0:
                _bad("untyped parameter on '" + f.name + "'")
            one := _ty(&cs, p.ty[0])
            if p.is_variadic:
                pv = true
                one = "[" + one + "]"
            push(pn, p.name)
            push(pt, one)
            push(pio, p.is_inout)
        push(cs.fds, FD(f.name, pn, pt, pio, pv, _tyo(&cs, f.ret)))
    for c in u.consts:
        cc, ct := _ex(&cs, c.value)
        push(cs.cnames, c.name)
        push(cs.ctypes, ct)
        push(cs.ccode, cc)

# --- the generated support code ---------------------------------------------

fn _arr_protos(cs: inout C) -> string:
    out := ""
    for i := 0; i < len(cs.akinds); i += 1:
        e := cs.akinds[i]
        k := "K" + str(i)
        ct := "TychoArr" + k
        et := _cty(&cs, e)
        p := "tycho_arr_" + k
        out = out +
            "static " + ct + " " + p + "_with_cap(Arena *, tycho_int);\n" +
            "static void " + p + "_push(Arena *, " + ct + " *, " + et + ");\n" +
            "static void " + p + "_reserve(Arena *, " + ct + " *, tycho_int);\n" +
            "static " + et + " " + p + "_pop(Arena *, " + ct + " *);\n" +
            "static " + et + " " + p + "_get(" + ct + ", tycho_int);\n" +
            "static " + et + " *" + p + "_ptr(" + ct + " *, tycho_int);\n" +
            "static " + ct + " " + p + "_copy(Arena *, " + ct + ");\n" +
            "static int " + p + "_eq(" + ct + ", " + ct + ");\n" +
            "static char *tycho_str_arr_" + k + "(Arena *, " + ct + ");\n"
        if _hashable(&cs, e):
            out = out + "static uint64_t " + p + "_hash(" + ct + ");\n"
    return out

fn _arr_defs(cs: inout C) -> (string, string, string):
    # (typedefs, struct bodies, function bodies) for every stamped array kind.
    td := ""
    sb := ""
    fb := ""
    i := 0
    for i < len(cs.akinds):
        e := cs.akinds[i]
        k := "K" + str(i)
        ct := "TychoArr" + k
        et := _cty(&cs, e)
        td = td + "typedef struct " + ct + "_ " + ct + ";\n"
        sb = sb + "struct " + ct + "_ { " + et + " *data; tycho_int len; tycho_int cap; };\n"
        p := "tycho_arr_" + k
        fb = fb +
            "static " + ct + " " + p + "_with_cap(Arena *a, tycho_int cap) {\n" +
            "    " + ct + " r; r.len = 0; r.cap = cap;\n" +
            "    r.data = cap > 0 ? (" + et + " *)arena_alloc(a, (size_t)cap * sizeof(" + et + ")) : 0;\n" +
            "    return r;\n}\n" +
            "static void " + p + "_push(Arena *a, " + ct + " *xs, " + et + " v) {\n" +
            "    if (xs->len == xs->cap) {\n" +
            "        tycho_int nc = xs->cap ? xs->cap * 2 : 4;\n" +
            "        " + et + " *nd = (" + et + " *)arena_alloc(a, (size_t)nc * sizeof(" + et + "));\n" +
            "        for (tycho_int i = 0; i < xs->len; i++) nd[i] = xs->data[i];\n" +
            "        xs->data = nd; xs->cap = nc;\n    }\n" +
            "    xs->data[xs->len++] = v;\n}\n" +
            "static void " + p + "_reserve(Arena *a, " + ct + " *xs, tycho_int n) {\n" +
            "    if (n <= xs->cap) return;\n" +
            "    " + et + " *nd = (" + et + " *)arena_alloc(a, (size_t)n * sizeof(" + et + "));\n" +
            "    for (tycho_int i = 0; i < xs->len; i++) nd[i] = xs->data[i];\n" +
            "    xs->data = nd; xs->cap = n;\n}\n" +
            "static " + et + " " + p + "_pop(Arena *a, " + ct + " *xs) {\n" +
            "    if (xs->len == 0) { fprintf(stderr, \"tycho: pop from an empty array\\n\"); exit(1); }\n" +
            "    xs->len--;\n    return xs->data[xs->len];\n}\n" +
            "static " + et + " " + p + "_get(" + ct + " xs, tycho_int i) {\n" +
            "    if (i < 0 || i >= xs.len) { fprintf(stderr, \"tycho: index %\" TY_PRId \" out of bounds (len %\" TY_PRId \")\\n\", i, xs.len); exit(1); }\n" +
            "    return xs.data[i];\n}\n" +
            "static " + et + " *" + p + "_ptr(" + ct + " *xs, tycho_int i) {\n" +
            "    if (i < 0 || i >= xs->len) { fprintf(stderr, \"tycho: index %\" TY_PRId \" out of bounds (len %\" TY_PRId \")\\n\", i, xs->len); exit(1); }\n" +
            "    return &xs->data[i];\n}\n" +
            "static " + ct + " " + p + "_copy(Arena *a, " + ct + " src) {\n" +
            "    " + ct + " r = " + p + "_with_cap(a, src.len); r.len = src.len;\n" +
            "    for (tycho_int i = 0; i < src.len; i++) r.data[i] = " +
            _copy(&cs, "src.data[i]", e, "a") + ";\n    return r;\n}\n" +
            "static int " + p + "_eq(" + ct + " x, " + ct + " y) {\n" +
            "    if (x.len != y.len) return 0;\n" +
            "    for (tycho_int i = 0; i < x.len; i++) if (!" +
            _eq(&cs, "x.data[i]", "y.data[i]", e) + ") return 0;\n    return 1;\n}\n" +
            "static char *tycho_str_arr_" + k + "(Arena *a, " + ct + " xs) {\n" +
            "    char *r = tycho_str_from_c(a, \"[\");\n" +
            "    for (tycho_int i = 0; i < xs.len; i++) {\n" +
            "        if (i) r = tycho_str_concat(a, r, tycho_str_from_c(a, \", \"));\n" +
            "        r = tycho_str_concat(a, r, " + _tostr_a(&cs, "xs.data[i]", e) + ");\n    }\n" +
            "    return tycho_str_concat(a, r, tycho_str_from_c(a, \"]\"));\n}\n"
        if _hashable(&cs, e):
            fb = fb + "static uint64_t " + p + "_hash(" + ct + " x) {\n" +
                "    uint64_t h = tycho_hash_k0;\n" +
                "    for (tycho_int i = 0; i < x.len; i++) h = h * UINT64_C(1099511628211) ^ " +
                _hash(&cs, e, "x.data[i]") + ";\n    return h;\n}\n"
        i += 1
    return (td, sb, fb)

# _tostr, but writing into an explicit arena rather than the caller's _scope.
fn _tup_plain(cs: inout C, i: int) -> bool:
    for e in split(cs.tks[i], "|"):
        if _is_struct(e) or _is_tup(e):
            return false
    return true

fn _tup_defs(cs: inout C) -> (string, string, string, string):
    # (typedefs, struct bodies, prototypes, function bodies) per tuple kind.
    td := ""
    sb := ""
    pr := ""
    fb := ""
    i := 0
    for i < len(cs.tks):
        es := split(cs.tks[i], "|")
        ct := "TychoTup" + str(i)
        fl := ""
        for j := 0; j < len(es); j += 1:
            fl = fl + " " + _cty(&cs, es[j]) + " f" + str(j) + ";"
        td = td + "typedef struct " + ct + "_ " + ct + ";\n"
        if _tup_plain(&cs, i):
            td = td + "struct " + ct + "_ {" + fl + " };\n"
        else:
            sb = sb + "struct " + ct + "_ {" + fl + " };\n"
        pr = pr + "static int tycho_eq_T" + str(i) + "(" + ct + ", " + ct + ");\n" +
            "static char *tycho_str_T" + str(i) + "(Arena *, " + ct + ");\n"
        eq := ""
        st := "    char *r = tycho_str_from_c(a, \"(\");\n"
        for j := 0; j < len(es); j += 1:
            if j > 0:
                eq = eq + " && "
                st = st + "    r = tycho_str_concat(a, r, tycho_str_from_c(a, \", \"));\n"
            eq = eq + _eq(&cs, "x.f" + str(j), "y.f" + str(j), es[j])
            st = st + "    r = tycho_str_concat(a, r, " + _tostr_a(&cs, "v.f" + str(j), es[j]) + ");\n"
        if len(eq) == 0:
            eq = "1"
        fb = fb + "static int tycho_eq_T" + str(i) + "(" + ct + " x, " + ct + " y) {\n" +
            "    return " + eq + ";\n}\n" +
            "static char *tycho_str_T" + str(i) + "(Arena *a, " + ct + " v) {\n" + st +
            "    return tycho_str_concat(a, r, tycho_str_from_c(a, \")\"));\n}\n"
        if _heap(&cs, "T~" + str(i)):
            pr = pr + "static " + ct + " tycho_copy_T" + str(i) + "(Arena *, " + ct + ");\n"
            cp := "static " + ct + " tycho_copy_T" + str(i) + "(Arena *a, " + ct + " v) {\n" +
                "    " + ct + " r = v;\n"
            for j := 0; j < len(es); j += 1:
                if _heap(&cs, es[j]):
                    cp = cp + "    r.f" + str(j) + " = " + _copy(&cs, "v.f" + str(j), es[j], "a") + ";\n"
            fb = fb + cp + "    return r;\n}\n"
        i += 1
    return (td, sb, pr, fb)

# One compact indexed dict per (key, value) kind: an int32 index table over a
# dense insertion-ordered entry list, with tombstones, backward-shift index
# delete and allocation-free compaction. Mirrors src/tychoc.c:13481 line for
# line -- the shape is what makes keys() insertion-ordered.
fn _map_defs(cs: inout C) -> (string, string, string, string):
    td := ""
    sb := ""
    pr := ""
    fb := ""
    i := 0
    for i < len(cs.mks):
        mt := "M~" + str(i)
        kt := _mkey(&cs, mt)
        vt := _mval(&cs, mt)
        ct := "TychoMapM" + str(i)
        p := "tycho_mapM" + str(i)
        ks := _kslot(&cs, kt)
        vc := _cty(&cs, vt) + " "
        kp := ks + "k"
        kcp := _kcopy(&cs, kt)
        vcp := _copy(&cs, "v", vt, "a")
        kat := _cty(&cs, "[" + kt + "]")
        kaf := _apfx(&cs, kt)
        kel := "m.ekeys[e]"
        if _kclass(&cs, kt) == "enum":
            kel = "_sing_tab_" + _tname(kt) + "[m.ekeys[e]]"
        td = td + "typedef struct " + ct + "_ " + ct + ";\n"
        sb = sb + "struct " + ct + "_ { " + ks + "*ekeys; " + vc +
            "*evals; unsigned char *elive; int *idx; tycho_int len; tycho_int ecount; tycho_int ecap; tycho_int icap; };\n"
        pr = pr +
            "static " + ct + " " + p + "_with_cap(Arena *, tycho_int);\n" +
            "static void " + p + "_reserve(Arena *, " + ct + " *, tycho_int);\n" +
            "static tycho_int " + p + "_find(" + ct + ", " + kp + ");\n" +
            "static void " + p + "_idxput(" + ct + " *, tycho_int);\n" +
            "static void " + p + "_idxgrow(Arena *, " + ct + " *);\n" +
            "static void " + p + "_compact(" + ct + " *);\n" +
            "static tycho_int " + p + "_append(Arena *, " + ct + " *, " + kp + ", " + vc + "v);\n" +
            "static void " + p + "_put(Arena *, " + ct + " *, " + kp + ", " + vc + "v);\n" +
            "static " + vc + "*" + p + "_slotptr(Arena *, " + ct + " *, " + kp + ");\n" +
            "static void " + p + "_del(" + ct + " *, " + kp + ");\n" +
            "static " + ct + " " + p + "_copy(Arena *, " + ct + ");\n" +
            "static " + vc + p + "_get(" + ct + ", " + kp + ", " + vc + "dflt);\n" +
            "static int " + p + "_has(" + ct + ", " + kp + ");\n" +
            "static " + kat + " " + p + "_keys(Arena *, " + ct + ");\n" +
            "static int " + p + "_eq(" + ct + ", " + ct + ");\n" +
            "static char *tycho_str_mapM" + str(i) + "(Arena *, " + ct + ");\n"
        fb = fb +
            "static " + ct + " " + p + "_with_cap(Arena *a, tycho_int cap) {\n" +
            "    " + ct + " m; m.len = 0; m.ecount = 0;\n" +
            "    if (cap <= 0) { m.ekeys = 0; m.evals = 0; m.elive = 0; m.idx = 0; m.ecap = 0; m.icap = 0; return m; }\n" +
            "    tycho_int ec = 4; while (ec < cap) ec *= 2; tycho_int ic = 8; while (ic < cap * 2) ic *= 2; m.ecap = ec; m.icap = ic;\n" +
            "    m.ekeys = (" + ks + "*)arena_alloc(a, (size_t)ec * sizeof(" + ks + "));\n" +
            "    m.evals = (" + vc + "*)arena_alloc(a, (size_t)ec * sizeof(" + vc + "));\n" +
            "    m.elive = (unsigned char *)arena_alloc(a, (size_t)ec);\n" +
            "    m.idx = (int *)arena_alloc(a, (size_t)ic * sizeof(int));\n" +
            "    for (tycho_int i = 0; i < ic; i++) m.idx[i] = 0; return m;\n}\n" +
            "static void " + p + "_reserve(Arena *a, " + ct + " *m, tycho_int cap) {\n" +
            "    if (cap <= 0) return;\n" +
            "    tycho_int ec = 4; while (ec < cap) ec *= 2; tycho_int ic = 8; while (ic < cap * 2) ic *= 2;\n" +
            "    if (m->ecap >= ec && m->icap >= ic) return;\n" +
            "    " + ks + "*nk = (" + ks + "*)arena_alloc(a, (size_t)ec * sizeof(" + ks + "));\n" +
            "    " + vc + "*nv = (" + vc + "*)arena_alloc(a, (size_t)ec * sizeof(" + vc + "));\n" +
            "    unsigned char *nl = (unsigned char *)arena_alloc(a, (size_t)ec);\n" +
            "    int *ni = (int *)arena_alloc(a, (size_t)ic * sizeof(int));\n" +
            "    for (tycho_int i = 0; i < ic; i++) ni[i] = 0;\n" +
            "    for (tycho_int e = 0; e < m->ecount; e++) { nk[e] = m->ekeys[e]; nv[e] = m->evals[e]; nl[e] = m->elive[e]; }\n" +
            "    m->ekeys = nk; m->evals = nv; m->elive = nl; m->ecap = ec;\n" +
            "    m->idx = ni; m->icap = ic;\n" +
            "    for (tycho_int e = 0; e < m->ecount; e++) if (m->elive[e]) " + p + "_idxput(m, e);\n}\n" +
            "static tycho_int " + p + "_find(" + ct + " m, " + kp + ") {\n" +
            "    if (m.icap == 0) return -1; uint64_t mask = (uint64_t)m.icap - 1; tycho_int i = (tycho_int)(" +
            _khash(&cs, kt, "k") + " & mask); int e;\n" +
            "    while ((e = m.idx[i]) != 0) { if (" + _kmatch(&cs, kt, "m.ekeys[e - 1]", "k") +
            ") return e - 1; i = (tycho_int)((i + 1) & mask); }\n    return -1;\n}\n" +
            "static void " + p + "_idxput(" + ct + " *m, tycho_int ei) {\n" +
            "    uint64_t mask = (uint64_t)m->icap - 1; tycho_int i = (tycho_int)(" +
            _khash(&cs, kt, "m->ekeys[ei]") + " & mask);\n" +
            "    while (m->idx[i] != 0) i = (tycho_int)((i + 1) & mask); m->idx[i] = (int)(ei + 1);\n}\n" +
            "static void " + p + "_idxgrow(Arena *a, " + ct + " *m) {\n" +
            "    tycho_int ic = m->icap ? m->icap * 2 : 8; int *ni = (int *)arena_alloc(a, (size_t)ic * sizeof(int));\n" +
            "    for (tycho_int i = 0; i < ic; i++) ni[i] = 0; m->idx = ni; m->icap = ic;\n" +
            "    for (tycho_int e = 0; e < m->ecount; e++) if (m->elive[e]) " + p + "_idxput(m, e);\n}\n" +
            "static void " + p + "_compact(" + ct + " *m) {\n" +
            "    tycho_int w = 0; for (tycho_int r = 0; r < m->ecount; r++) if (m->elive[r]) { if (w != r) { m->ekeys[w] = m->ekeys[r]; m->evals[w] = m->evals[r]; m->elive[w] = 1; } w++; }\n" +
            "    m->ecount = w; for (tycho_int i = 0; i < m->icap; i++) m->idx[i] = 0;\n" +
            "    for (tycho_int e = 0; e < m->ecount; e++) " + p + "_idxput(m, e);\n}\n" +
            "static tycho_int " + p + "_append(Arena *a, " + ct + " *m, " + kp + ", " + vc + "v) {\n" +
            "    if (m->ecount == m->ecap) { tycho_int dead = m->ecount - m->len;\n" +
            "        if (dead > m->ecap / 2) " + p + "_compact(m);\n" +
            "        else { tycho_int nc = m->ecap ? m->ecap * 2 : 4;\n" +
            "            " + ks + "*nk = (" + ks + "*)arena_alloc(a, (size_t)nc * sizeof(" + ks + ")); " +
            vc + "*nv = (" + vc + "*)arena_alloc(a, (size_t)nc * sizeof(" + vc + ")); unsigned char *nl = (unsigned char *)arena_alloc(a, (size_t)nc);\n" +
            "            for (tycho_int e = 0; e < m->ecount; e++) { nk[e] = m->ekeys[e]; nv[e] = m->evals[e]; nl[e] = m->elive[e]; }\n" +
            "            m->ekeys = nk; m->evals = nv; m->elive = nl; m->ecap = nc; } }\n" +
            "    tycho_int e = m->ecount++; m->ekeys[e] = k; m->evals[e] = v; m->elive[e] = 1; return e;\n}\n" +
            "static void " + p + "_put(Arena *a, " + ct + " *m, " + kp + ", " + vc + "v) {\n" +
            "    tycho_int e = " + p + "_find(*m, k); if (e >= 0) { m->evals[e] = " + vcp + "; return; }\n" +
            "    if ((m->len + 1) * 2 > m->icap) " + p + "_idxgrow(a, m);\n" +
            "    tycho_int ne = " + p + "_append(a, m, " + kcp + ", " + vcp + "); m->len++; " + p + "_idxput(m, ne);\n}\n" +
            "static " + vc + "*" + p + "_slotptr(Arena *a, " + ct + " *m, " + kp + ") {\n" +
            "    tycho_int e = " + p + "_find(*m, k); if (e >= 0) return &m->evals[e];\n" +
            "    if ((m->len + 1) * 2 > m->icap) " + p + "_idxgrow(a, m);\n" +
            "    tycho_int ne = " + p + "_append(a, m, " + kcp + ", " + _zero(&cs, vt) + "); m->len++; " + p + "_idxput(m, ne);\n" +
            "    return &m->evals[ne];\n}\n" +
            "static void " + p + "_del(" + ct + " *m, " + kp + ") {\n" +
            "    if (m->icap == 0) return; uint64_t mask = (uint64_t)m->icap - 1; tycho_int i = (tycho_int)(" +
            _khash(&cs, kt, "k") + " & mask), found = -1;\n" +
            "    while (m->idx[i] != 0) { if (" + _kmatch(&cs, kt, "m->ekeys[m->idx[i] - 1]", "k") +
            ") { found = i; break; } i = (tycho_int)((i + 1) & mask); }\n" +
            "    if (found < 0) return; tycho_int ei = m->idx[found] - 1; m->elive[ei] = 0; m->len--;\n" +
            "    tycho_int g = found;\n" +
            "    for (;;) { m->idx[g] = 0; tycho_int j = g;\n" +
            "        for (;;) { j = (tycho_int)((j + 1) & mask); if (m->idx[j] == 0) return;\n" +
            "            tycho_int h = (tycho_int)(" + _khash(&cs, kt, "m->ekeys[m->idx[j] - 1]") + " & mask);\n" +
            "            if (g <= j) { if (g < h && h <= j) continue; } else { if (g < h || h <= j) continue; } break; }\n" +
            "        m->idx[g] = m->idx[j]; g = j; }\n}\n" +
            "static " + ct + " " + p + "_copy(Arena *a, " + ct + " src) {\n" +
            "    " + ct + " r = " + p + "_with_cap(a, src.len ? src.len : 0);\n" +
            "    for (tycho_int e = 0; e < src.ecount; e++) if (src.elive[e]) " + p +
            "_put(a, &r, src.ekeys[e], src.evals[e]);\n    return r;\n}\n" +
            "static " + vc + p + "_get(" + ct + " m, " + kp + ", " + vc + "dflt) {\n" +
            "    tycho_int e = " + p + "_find(m, k); return e < 0 ? dflt : m.evals[e];\n}\n" +
            "static int " + p + "_has(" + ct + " m, " + kp + ") { return " + p + "_find(m, k) >= 0; }\n" +
            "static " + kat + " " + p + "_keys(Arena *a, " + ct + " m) {\n" +
            "    " + kat + " r = " + kaf + "_with_cap(a, m.len);\n" +
            "    for (tycho_int e = 0; e < m.ecount; e++) if (m.elive[e]) " + kaf +
            "_push(a, &r, " + kel + ");\n    return r;\n}\n" +
            "static int " + p + "_eq(" + ct + " x, " + ct + " y) {\n" +
            "    if (x.len != y.len) return 0;\n" +
            "    for (tycho_int e = 0; e < x.ecount; e++) if (x.elive[e]) { tycho_int s = " + p +
            "_find(y, x.ekeys[e]); if (s < 0 || !(" + _eq(&cs, "y.evals[s]", "x.evals[e]", vt) +
            ")) return 0; }\n    return 1;\n}\n" +
            "static char *tycho_str_mapM" + str(i) + "(Arena *a, " + ct + " m) {\n" +
            "    char *r = tycho_str_from_c(a, \"[\"); int first = 1;\n" +
            "    for (tycho_int e = 0; e < m.ecount; e++) if (m.elive[e]) {\n" +
            "        if (!first) r = tycho_str_concat(a, r, tycho_str_from_c(a, \", \")); first = 0;\n" +
            "        r = tycho_str_concat(a, r, " + _tostr_a(&cs, kel, kt) + ");\n" +
            "        r = tycho_str_concat(a, r, tycho_str_from_c(a, \": \"));\n" +
            "        r = tycho_str_concat(a, r, " + _tostr_a(&cs, "m.evals[e]", vt) + ");\n" +
            "    }\n    return tycho_str_concat(a, r, tycho_str_from_c(a, \"]\"));\n}\n"
        i += 1
    return (td, sb, pr, fb)

# A deep hash per hashable struct/tuple, folded FNV-style from the per-process
# seed so that ==-equal values always hash equal (src/tychoc.c:13255).
fn _hash_defs(cs: inout C) -> (string, string):
    pr := ""
    fb := ""
    for i := 0; i < len(cs.sds); i += 1:
        n := cs.sds[i].name
        if not _hashable(&cs, "S~" + n):
            continue
        pr = pr + "static uint64_t tycho_hash_S_" + n + "(S_" + n + ");\n"
        b := "static uint64_t tycho_hash_S_" + n + "(S_" + n + " v) {\n" +
            "    uint64_t h = tycho_hash_k0;\n"
        for j := 0; j < len(cs.sds[i].fnames); j += 1:
            b = b + "    h = h * UINT64_C(1099511628211) ^ " +
                _hash(&cs, cs.sds[i].ftypes[j], "v.f_" + cs.sds[i].fnames[j]) + ";\n"
        fb = fb + b + "    return h;\n}\n"
    for i := 0; i < len(cs.tks); i += 1:
        if not _hashable(&cs, "T~" + str(i)):
            continue
        pr = pr + "static uint64_t tycho_hash_T" + str(i) + "(TychoTup" + str(i) + ");\n"
        b2 := "static uint64_t tycho_hash_T" + str(i) + "(TychoTup" + str(i) + " v) {\n" +
            "    uint64_t h = tycho_hash_k0;\n"
        es := split(cs.tks[i], "|")
        for j := 0; j < len(es); j += 1:
            b2 = b2 + "    h = h * UINT64_C(1099511628211) ^ " +
                _hash(&cs, es[j], "v.f" + str(j)) + ";\n"
        fb = fb + b2 + "    return h;\n}\n"
    return (pr, fb)

fn _tostr_a(cs: inout C, code: string, t: string) -> string:
    s := _tostr(&cs, code, t)
    return _replace(s, "&_scope", "a")

fn _replace(s: string, from: string, to: string) -> string:
    out := ""
    i := 0
    for i < len(s):
        if i + len(from) <= len(s) and s[i:i + len(from)] == from:
            out = out + to
            i += len(from)
        else:
            out = out + s[i:i + 1]
            i += 1
    return out

fn _struct_order(cs: inout C) -> [int]:
    order := []int
    done := []bool
    for i := 0; i < len(cs.sds); i += 1:
        push(done, false)
    for len(order) < len(cs.sds):
        moved := false
        for i := 0; i < len(cs.sds); i += 1:
            if done[i]:
                continue
            ok := true
            for ft in cs.sds[i].ftypes:
                if _is_struct(ft):
                    j := _sidx(&cs, _tname(ft))
                    if j >= 0 and not done[j]:
                        ok = false
            if ok:
                done[i] = true
                push(order, i)
                moved = true
        if not moved:
            _bad("a cycle among struct definitions")
    return order

fn _struct_support(cs: inout C) -> (string, string):
    proto := ""
    body := ""
    for i := 0; i < len(cs.sds); i += 1:
        n := cs.sds[i].name
        proto = proto + "static int tycho_eq_S_" + n + "(S_" + n + ", S_" + n + ");\n"
        proto = proto + "static char *tycho_str_S_" + n + "(Arena *, S_" + n + ");\n"
        eq := ""
        st := "    char *r = tycho_str_from_c(a, \"" + n + "(\");\n"
        for j := 0; j < len(cs.sds[i].fnames); j += 1:
            f := cs.sds[i].fnames[j]
            ft := cs.sds[i].ftypes[j]
            if j > 0:
                eq = eq + " && "
                st = st + "    r = tycho_str_concat(a, r, tycho_str_from_c(a, \", \"));\n"
            eq = eq + _eq(&cs, "x.f_" + f, "y.f_" + f, ft)
            st = st + "    r = tycho_str_concat(a, r, " + _tostr_a(&cs, "v.f_" + f, ft) + ");\n"
        if len(eq) == 0:
            eq = "1"
        body = body + "static int tycho_eq_S_" + n + "(S_" + n + " x, S_" + n + " y) {\n" +
            "    return " + eq + ";\n}\n" +
            "static char *tycho_str_S_" + n + "(Arena *a, S_" + n + " v) {\n" + st +
            "    return tycho_str_concat(a, r, tycho_str_from_c(a, \")\"));\n}\n"
        if _heap(&cs, "S~" + n):
            proto = proto + "static S_" + n + " tycho_copy_S_" + n + "(Arena *, S_" + n + ");\n"
            cp := "static S_" + n + " tycho_copy_S_" + n + "(Arena *a, S_" + n + " v) {\n" +
                "    S_" + n + " r = v;\n"
            for j := 0; j < len(cs.sds[i].fnames); j += 1:
                f := cs.sds[i].fnames[j]
                ft := cs.sds[i].ftypes[j]
                if _heap(&cs, ft):
                    cp = cp + "    r.f_" + f + " = " + _copy(&cs, "v.f_" + f, ft, "a") + ";\n"
            body = body + cp + "    return r;\n}\n"
    return (proto, body)

fn _enum_support(cs: inout C) -> (string, string, string):
    defs := ""
    proto := ""
    body := ""
    for i := 0; i < len(cs.eds); i += 1:
        n := cs.eds[i].name
        un := ""
        for t := 0; t < len(cs.eds[i].vnames); t += 1:
            vn := cs.eds[i].vnames[t]
            ps := cs.eds[i].vpay[t].ptypes
            if len(ps) == 0:
                continue
            fl := ""
            for j := 0; j < len(ps); j += 1:
                fl = fl + " " + _cty(&cs, ps[j]) + " f" + str(j) + ";"
            defs = defs + "typedef struct {" + fl + " } E_" + n + "_" + vn + ";\n"
            un = un + " E_" + n + "_" + vn + " " + vn + ";"
        defs = defs + "struct E_" + n + " { int tag; union {" + un + " } u; };\n"
        allbare := true
        for t := 0; t < len(cs.eds[i].vnames); t += 1:
            if len(cs.eds[i].vpay[t].ptypes) == 0:
                defs = defs + "static E_" + n + " _sing_" + n + "_" + str(t) +
                    " = { " + str(t) + " };\n"
            else:
                allbare = false
        # a fieldless enum is stored in a map's key table as its TAG, so keys()
        # rebuilds the value through this table (src/tychoc.c:13100).
        if allbare and len(cs.eds[i].vnames) > 0:
            tab := "static E_" + n + " *const _sing_tab_" + n + "[] = {"
            for t := 0; t < len(cs.eds[i].vnames); t += 1:
                if t > 0:
                    tab = tab + ", "
                tab = tab + "&_sing_" + n + "_" + str(t)
            defs = defs + tab + "};\n"
        proto = proto + "static E_" + n + " *tycho_copy_E_" + n + "(Arena *, E_" + n + " *);\n" +
            "static int tycho_eq_E_" + n + "(E_" + n + " *, E_" + n + " *);\n" +
            "static char *tycho_str_E_" + n + "(Arena *, E_" + n + " *);\n"
        cp := "static E_" + n + " *tycho_copy_E_" + n + "(Arena *a, E_" + n + " *v) {\n"
        eq := "static int tycho_eq_E_" + n + "(E_" + n + " *x, E_" + n + " *y) {\n" +
            "    if (x->tag != y->tag) return 0;\n"
        st := "static char *tycho_str_E_" + n + "(Arena *a, E_" + n + " *v) {\n"
        for t := 0; t < len(cs.eds[i].vnames); t += 1:
            vn := cs.eds[i].vnames[t]
            ps := cs.eds[i].vpay[t].ptypes
            tg := str(t)
            if len(ps) == 0:
                st = st + "    if (v->tag == " + tg + ") return tycho_str_from_c(a, \"" + vn + "\");\n"
                eq = eq + "    if (x->tag == " + tg + ") return 1;\n"
                continue
            cp = cp + "    if (v->tag == " + tg + ") {\n" +
                "        E_" + n + " *d = (E_" + n + " *)arena_alloc(a, offsetof(E_" + n +
                ", u) + sizeof(E_" + n + "_" + vn + ")); d->tag = " + tg + ";\n"
            eqs := ""
            st = st + "    if (v->tag == " + tg + ") {\n" +
                "        char *r = tycho_str_from_c(a, \"" + vn + "(\");\n"
            for j := 0; j < len(ps); j += 1:
                fj := ".u." + vn + ".f" + str(j)
                cp = cp + "        d->u." + vn + ".f" + str(j) + " = " +
                    _copy(&cs, "v->u." + vn + ".f" + str(j), ps[j], "a") + ";\n"
                if j > 0:
                    eqs = eqs + " && "
                    st = st + "        r = tycho_str_concat(a, r, tycho_str_from_c(a, \", \"));\n"
                eqs = eqs + _eq(&cs, "x->" + fj[1:], "y->" + fj[1:], ps[j])
                st = st + "        r = tycho_str_concat(a, r, " +
                    _tostr_a(&cs, "v->" + fj[1:], ps[j]) + ");\n"
            cp = cp + "        return d;\n    }\n"
            eq = eq + "    if (x->tag == " + tg + ") return " + eqs + ";\n"
            st = st + "        return tycho_str_concat(a, r, tycho_str_from_c(a, \")\"));\n    }\n"
        body = body + cp + "    return v;\n}\n" + eq + "    return 1;\n}\n" +
            st + "    return tycho_str_from_c(a, \"<?>\");\n}\n"
    return (defs, proto, body)

fn _fnbody(cs: inout C, fi: int, body: [ast.Stmt]) -> (string, string):
    nm := cs.fds[fi].name
    rt := cs.fds[fi].ret
    cs.cur_ret = rt
    sig := _cty(&cs, rt) + " h_" + nm + "(Arena *_parent"
    m := _mark(&cs)
    for j := 0; j < len(cs.fds[fi].pnames); j += 1:
        pt := cs.fds[fi].ptypes[j]
        cn := _push(&cs, cs.fds[fi].pnames[j], pt)
        if cs.fds[fi].pinout[j]:
            sig = sig + ", " + _cty(&cs, pt) + " *" + cn
            cs.vcn[len(cs.vcn) - 1] = "(*" + cn + ")"
            if _heap(&cs, pt):
                sig = sig + ", Arena *_ina_" + cn
                cs.vown[len(cs.vown) - 1] = "_ina_" + cn
        else:
            sig = sig + ", " + _cty(&cs, pt) + " " + cn
    sig = sig + ")"
    pm := len(cs.pk)
    b := _block(&cs, body, "    ")
    for i := pm; i < len(cs.pk); i += 1:
        if len(cs.ptv[i]) == 0:
            _bad("a bare [] with nothing to type it")
        b = _replace(b, "_PT" + str(cs.pk[i]), _cty(&cs, cs.ptv[i]))
        b = _replace(b, "_PE" + str(cs.pk[i]),
            _apfx(&cs, _elem(cs.ptv[i])) + "_with_cap(&_scope, 0)")
    _restore(&cs, m)
    out := sig + " {\n" +
        "    Arena _scope = arena_child(_parent); _scope.name = \"" + nm + "\";\n" + b
    if rt == "void":
        out = out + "    arena_free(&_scope);\n}\n"
    else:
        out = out + "    arena_free(&_scope);\n" +
            "    { fprintf(stderr, \"tycho: fell off the end of " + nm + "\\n\"); exit(1); }\n}\n"
    return (sig + ";\n", out)

# --- the unit ---------------------------------------------------------------

fn unit(u: ast.Unit) -> string:
    cs := _new()
    if len(u.handles) > 0 or len(u.subscripts) > 0:
        _bad("handle/subscript declarations -- Phase 8")
    if len(u.imports) > 0:
        _bad("imports -- Phase 8")
    _collect(&cs, u)
    if _fidx(&cs, "main") < 0:
        _bad("no 'main' procedure")

    fns := ""
    protos := ""
    for f in u.fns:
        if len(f.typarams) > 0:
            continue
        pc, bc := _fnbody(&cs, _fidx(&cs, f.name), f.body)
        protos = protos + pc
        fns = fns + bc
    # Stage 2: every generic instance discovered while emitting -- and every one
    # discovered while emitting THOSE -- gets its own body. The registry only
    # ever grows at the end, so a forward scan reaches the whole closure.
    for k := 0; k < len(cs.ikey); k += 1:
        if cs.pendk[k] < 0:
            continue
        fj := cs.pendk[k]
        cs.pendk[k] = -1
        parts := split(cs.ikey[k], "|")
        gi := _gfidx(&cs, parts[1])
        tg := []string
        for q := 2; q < len(parts); q += 1:
            push(tg, parts[q])
        mb := _bind(&cs, cs.gf[gi].typarams, tg)
        pc2, bc2 := _fnbody(&cs, fj, cs.gf[gi].body)
        _unbind(&cs, mb)
        protos = protos + pc2
        fns = fns + bc2

    # Order matters in C: opaque typedefs, then the array structs (which name
    # element types only through pointers), then struct bodies in dependency
    # order, then the enum bodies (whose payloads may hold a struct by value).
    htd := "\n/* ---- generated from Tycho source ---- */\n\n"
    for sd in cs.sds:
        htd = htd + "typedef struct S_" + sd.name + "_ S_" + sd.name + ";\n"
    for ed in cs.eds:
        htd = htd + "typedef struct E_" + ed.name + " E_" + ed.name + ";\n"
    head := ""
    cs.arena = "&_scope"
    edefs, eproto, ebody := _enum_support(&cs)
    sproto, sbody := _struct_support(&cs)
    mtd, msb, mpr, mfb := _map_defs(&cs)
    nm := 0
    for nm != len(cs.mks):
        nm = len(cs.mks)
        mtd, msb, mpr, mfb = _map_defs(&cs)
    atd, asb, afb := _arr_defs(&cs)
    nk := 0
    for nk != len(cs.akinds):
        nk = len(cs.akinds)
        atd, asb, afb = _arr_defs(&cs)
    htd = htd + mtd
    head = head + atd + asb + msb
    for i in _struct_order(&cs):
        head = head + "struct S_" + cs.sds[i].name + "_ {\n"
        for j := 0; j < len(cs.sds[i].fnames); j += 1:
            head = head + "    " + _cty(&cs, cs.sds[i].ftypes[j]) + " f_" +
                cs.sds[i].fnames[j] + ";\n"
        if len(cs.sds[i].fnames) == 0:
            head = head + "    char _empty;\n"
        head = head + "};\n"
    ttd, tsb, tpr, tfb := _tup_defs(&cs)
    ntk := 0
    for ntk != len(cs.tks):
        ntk = len(cs.tks)
        ttd, tsb, tpr, tfb = _tup_defs(&cs)
    hpr, hfb := _hash_defs(&cs)
    head = htd + ttd + head + tsb + edefs + "\n" + _arr_protos(&cs) + sproto + eproto +
        tpr + mpr + hpr + "\n" + afb + sbody + ebody + tfb + hfb + mfb + "\n"

    entry := "\nint main(int argc, char **argv) {\n" +
        "    tycho_hash_seed_init();  /* random per-process map-hash seed, before any map use */\n" +
        "    tycho_argc = argc; tycho_argv = argv;  /* exposed to the program via args() */\n" +
        "    Arena _root = arena_new(0);  /* root arena; default block size */\n" +
        "    h_main(&_root);\n" +
        "    arena_free(&_root);\n" +
        "    return 0;\n}\n"
    return head + protos + "\n" + fns + entry
