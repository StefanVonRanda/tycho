package emit

import "../ast"
import "../lex"
import "../parse"
import "core:strings"

# ast -> C, against the same runtime ABI src/tychoc.c targets: one
# `RET h_<fn>(Arena *_parent, ...)` per function, an `arena_child` scope inside
# it, and every allocation made in that scope. A returned value is deep-copied
# into the CALLER's arena before the scope is freed, which is the unoptimised
# form of src/tychoc.c's return-only-escape pass -- correct, and slower.
#
# None of src/tychoc.c's eight optimisation passes are ported. Scope is the core
# language: scalars, strings, arrays, structs, enums, control flow, functions.
# Everything else dies by name so a fixture fails loudly rather than silently.

struct SD:
    name: string
    fnames: [string]
    ftypes: [string]

struct VD:
    name: string
    ptypes: [string]

struct ED:
    name: string
    vnames: [string]
    vpay: [VD]

struct FD:
    name: string
    pnames: [string]
    ptypes: [string]
    pinout: [bool]
    pvar: bool
    ret: string

struct C:
    sds: [SD]
    eds: [ED]
    fds: [FD]
    akinds: [string]
    cnames: [string]
    ctypes: [string]
    ccode: [string]
    vnames: [string]
    vtypes: [string]
    vcn: [string]
    vown: [string]
    ntn: [string]
    ntu: [string]
    tks: [string]
    mks: [string]
    fks: [string]
    clos: [string]
    lamd: [string]
    lamp: [string]
    gks: [string]
    gs: [ast.StructD]
    ge: [ast.EnumD]
    gf: [ast.Fn]
    tpn: [string]
    tpv: [string]
    pk: [int]
    ptv: [string]
    ikey: [string]
    iname: [string]
    iarg: [string]
    pendk: [int]
    fpfx: [string]
    ala: [string]
    alp: [string]
    cf: int
    gsf: [int]
    gef: [int]
    gff: [int]
    ntt: [ast.Ty]
    ntf: [int]
    edp: [string]
    want: string
    tmp: int
    cur_ret: string
    loopdepth: int
    arena: string
    oks: [string]
    ewlen: bool
    exn: [string]
    subn: [string]
    subp: [[ast.Param]]
    sube: [ast.Expr]

fn _new() -> C:
    return C([], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], -1, [], [], [], []ast.Ty, [], [], "", 0, "void", 0, "&_scope", [], false, [], [], [][ast.Param], []ast.Expr)

fn _bad(msg: string):
    die("tychoc1: " + msg)

# --- package mangling -------------------------------------------------------
# src/tychoc.c@pkg_prefix_for: a name declared in package `geom` is emitted as
# `geom__name`; the ENTRY package carries no prefix. A qualifier resolves
# through the alias table to the package's real name (an aliased import binds
# the alias to the path's last component). Diagnostics keep the source spelling
# -- nothing here is ever printed.

fn _pfx(cs: inout C) -> string:
    if cs.cf < 0 or cs.cf >= len(cs.fpfx):
        return ""
    return cs.fpfx[cs.cf]

fn _qpfx(cs: inout C, q: string) -> string:
    for i := 0; i < len(cs.ala); i += 1:
        if cs.ala[i] == q:
            return cs.alp[i] + "__"
    return q + "__"

fn _pkg_base(path: string) -> string:
    s := path
    if len(s) > 5 and s[0:5] == "core:":
        s = s[5:]
    cut := -1
    for i := 0; i < len(s); i += 1:
        if s[i] == 47:
            cut = i
    if cut < 0:
        return s
    return s[cut + 1:]

fn _ispkg(cs: inout C, q: string) -> bool:
    for i := 0; i < len(cs.ala); i += 1:
        if cs.ala[i] == q:
            return true
    return false

# --- type strings -----------------------------------------------------------
# "int" "float" "bool" "string" "char" "void"; "[T]"; "S~Name"; "E~Name".

# The fixed-width family. Their C types wrap natively at their own width, which
# is why every sized result is cast back to it -- integer promotion would take
# `u8 * u8` to `int` and 400 would print as 400 rather than 144.
fn _is_uint(t: string) -> bool:
    return t == "u8" or t == "u16" or t == "u32" or t == "u64"

fn _is_sint(t: string) -> bool:
    return t == "i8" or t == "i16" or t == "i32" or t == "i64"

fn _width(t: string) -> int:
    if t == "u8" or t == "i8":
        return 8
    if t == "u16" or t == "i16":
        return 16
    if t == "u32" or t == "i32":
        return 32
    return 64

fn _is_sized(t: string) -> bool:
    return _is_uint(t) or _is_sint(t) or t == "f32"

fn _is_arr(t: string) -> bool:
    return len(t) > 2 and t[0] == 91

fn _elem(t: string) -> string:
    return t[1:len(t) - 1]

fn _is_struct(t: string) -> bool:
    return strings.starts_with(t, "S~")

fn _is_enum(t: string) -> bool:
    return strings.starts_with(t, "E~")

fn _tname(t: string) -> string:
    return t[2:]

# A newtype is ERASED in lowering (spec 5.4): it is represented exactly as its
# underlying type, so `_ty` resolves the name away and nothing downstream ever
# sees one.
fn _ntidx(cs: inout C, n: string) -> int:
    p := _pfx(&cs)
    if len(p) > 0:
        for i := 0; i < len(cs.ntn); i += 1:
            if cs.ntn[i] == p + n:
                return i
    for i := 0; i < len(cs.ntn); i += 1:
        if cs.ntn[i] == n:
            return i
    return -1

# A tuple type is stamped out like an array kind: the registry key is the
# element type strings joined by "|", and the type string is "T~<index>".
fn _is_tup(t: string) -> bool:
    return strings.starts_with(t, "T~")

fn _tkind(cs: inout C, key: string) -> int:
    for i := 0; i < len(cs.tks); i += 1:
        if cs.tks[i] == key:
            return i
    push(cs.tks, key)
    return len(cs.tks) - 1

fn _tjoin(es: [string]) -> string:
    k := ""
    for i := 0; i < len(es); i += 1:
        if i > 0:
            k = k + "|"
        k = k + es[i]
    return k

fn _telems(cs: inout C, t: string) -> [string]:
    i := strings.parse_int(_tname(t))
    return split(cs.tks[i], "|")

fn _tup_of(cs: inout C, es: [string]) -> string:
    return "T~" + str(_tkind(&cs, _tjoin(es)))

# A map type is stamped out per (key, value) pair exactly as a tuple kind is:
# the registry key is "K|V" and the type string is "M~<index>". The emitted C
# mirrors src/tychoc.c:12894's compact indexed dict -- an int32 index table over
# dense insertion-ordered entries -- so keys() order and str() form agree.
fn _is_map(t: string) -> bool:
    return strings.starts_with(t, "M~")

fn _mkind(cs: inout C, key: string) -> int:
    for i := 0; i < len(cs.mks); i += 1:
        if cs.mks[i] == key:
            return i
    push(cs.mks, key)
    return len(cs.mks) - 1

fn _map_of(cs: inout C, k: string, v: string) -> string:
    return "M~" + str(_mkind(&cs, k + "|" + v))

fn _mparts(cs: inout C, t: string) -> [string]:
    i := strings.parse_int(_tname(t))
    return split(cs.mks[i], "|")

fn _mkey(cs: inout C, t: string) -> string:
    return _mparts(&cs, t)[0]

fn _mval(cs: inout C, t: string) -> string:
    return _mparts(&cs, t)[1]

fn _mpfx(cs: inout C, t: string) -> string:
    return "tycho_mapM" + _tname(t)

# A soa type is stamped out per ELEMENT STRUCT, keyed by the struct's type
# string, and spelled "O~<index>". src/tychoc.c:13034 emits the same shape: one
# growable arena buffer per field plus a shared len/cap.
fn _is_soa(t: string) -> bool:
    return strings.starts_with(t, "O~")

fn _okind(cs: inout C, key: string) -> int:
    for i := 0; i < len(cs.oks); i += 1:
        if cs.oks[i] == key:
            return i
    push(cs.oks, key)
    return len(cs.oks) - 1

fn _soa_of(cs: inout C, st: string) -> string:
    if not _is_struct(st):
        _bad("a soa element must be a struct, not '" + st + "'")
    return "O~" + str(_okind(&cs, st))

fn _selem(cs: inout C, t: string) -> string:
    return cs.oks[strings.parse_int(_tname(t))]

fn _spfx(cs: inout C, t: string) -> string:
    return "Soa" + _tname(t)

# `ps[i].x` -> `((ps).fN[SoaK_bound(&(ps), i)])`. The bound call is emitted per
# OCCURRENCE, matching ./tychoc: `ps[2].z = ps[2].z + 1` checks twice.
fn _soafld(cs: inout C, bc: string, bt: string, ic: string, f: string) -> (string, string):
    st := _selem(&cs, bt)
    si := _sidx(&cs, _tname(st))
    for i := 0; i < len(cs.sds[si].fnames); i += 1:
        if cs.sds[si].fnames[i] == f:
            return ("((" + bc + ").f" + str(i) + "[" + _spfx(&cs, bt) + "_bound(&(" +
                bc + "), " + ic + ")])", cs.sds[si].ftypes[i])
    _bad("no field '" + f + "' on " + _tname(st))
    return ("", "")

# How a key is REPRESENTED in the entry table: a fieldless enum is stored as its
# tag, so `keys()` has to rebuild the singleton (src/tychoc.c:12926).
fn _kclass(cs: inout C, k: string) -> string:
    if k == "string":
        return "str"
    if k == "int" or k == "char" or k == "bool":
        return "int"
    if _is_enum(k):
        return "enum"
    if _is_struct(k) or _is_tup(k) or _is_arr(k):
        return "comp"
    _bad("a map key of type '" + k + "' is not hashable")
    return ""

fn _kslot(cs: inout C, k: string) -> string:
    c := _kclass(&cs, k)
    if c == "str":
        return "char *"
    if c == "int" or c == "enum":
        return "tycho_int "
    return _cty(&cs, k) + " "

# The key as the generated functions take it, from a Tycho-level value.
fn _keyrt(cs: inout C, k: string, code: string) -> string:
    if _kclass(&cs, k) == "enum":
        return "((tycho_int)((" + code + ")->tag))"
    return code

fn _khash(cs: inout C, k: string, e: string) -> string:
    c := _kclass(&cs, k)
    if c == "str":
        return "tycho_si_hash(" + e + ")"
    if c == "int" or c == "enum":
        return "tycho_ik_hash((tycho_int)(" + e + "))"
    return _hash(&cs, k, e)

fn _kmatch(cs: inout C, k: string, ek: string, q: string) -> string:
    c := _kclass(&cs, k)
    if c == "str":
        return "(strcmp(" + ek + ", " + q + ") == 0)"
    if c == "int" or c == "enum":
        return "(" + ek + " == " + q + ")"
    return _eq(&cs, ek, q, k)

fn _kcopy(cs: inout C, k: string) -> string:
    c := _kclass(&cs, k)
    if c == "str":
        return "tycho_str_copy(a, k)"
    if c == "int" or c == "enum":
        return "k"
    return _copy(&cs, "k", k, "a")

# A struct/tuple key hashes field-wise, FNV-folded from the per-process seed --
# src/tychoc.c:10170's gen_hash, which is what makes `==`-equal values hash equal.
fn _hashable(cs: inout C, t: string) -> bool:
    return _hashable_d(&cs, t, 0)

# Depth-bounded: a struct whose field is an array OF ITSELF is a legal recursive
# shape and would otherwise recurse forever here.
fn _hashable_d(cs: inout C, t: string, d: int) -> bool:
    if d > 8:
        return false
    if t == "int" or t == "char" or t == "bool" or t == "float" or t == "string":
        return true
    if _is_enum(t):
        i := _eidx(&cs, t[2:])
        if i < 0:
            return false
        for v in cs.eds[i].vpay:
            if len(v.ptypes) > 0:
                return false
        return true
    if _is_arr(t):
        return _hashable_d(&cs, _elem(t), d + 1)
    if _is_struct(t):
        i2 := _sidx(&cs, _tname(t))
        if i2 < 0:
            return false
        for ft in cs.sds[i2].ftypes:
            if not _hashable_d(&cs, ft, d + 1):
                return false
        return true
    if _is_tup(t):
        for et in _telems(&cs, t):
            if not _hashable_d(&cs, et, d + 1):
                return false
        return true
    return false

fn _hash(cs: inout C, t: string, v: string) -> string:
    if t == "string":
        return "tycho_si_hash(" + v + ")"
    if t == "float":
        return "tycho_ik_hash((tycho_int)((union { double _d; tycho_int _l; }){ ._d = (" +
            v + ") })._l)"
    if _is_enum(t):
        return "tycho_ik_hash((tycho_int)((" + v + ")->tag))"
    if _is_struct(t):
        return "tycho_hash_S_" + _tname(t) + "(" + v + ")"
    if _is_tup(t):
        return "tycho_hash_T" + _tname(t) + "(" + v + ")"
    if _is_arr(t):
        e := _elem(t)
        if e == "int":
            return "tycho_arr_int_hash(" + v + ")"
        if e == "float":
            return "tycho_arr_float_hash(" + v + ")"
        if e == "string":
            return "tycho_arr_str_hash(" + v + ")"
        return "tycho_arr_K" + str(_akind(&cs, e)) + "_hash(" + v + ")"
    return "tycho_ik_hash((tycho_int)(" + v + "))"

# Option and Result are monomorphised into ordinary enums, one per
# instantiation, named `_G<n>` so `_bare_variant` can tell them from a user
# enum -- otherwise a bare `Ok` would resolve into a generated one.
fn _gname(cs: inout C, key: string) -> string:
    for i := 0; i < len(cs.gks); i += 1:
        if cs.gks[i] == key:
            return "_G" + str(i)
    push(cs.gks, key)
    return "_G" + str(len(cs.gks) - 1)

fn _is_gen(n: string) -> bool:
    return strings.starts_with(n, "_G")

fn _opt_of(cs: inout C, t: string) -> string:
    nm := _gname(&cs, "O|" + t)
    if _eidx(&cs, nm) < 0:
        vs := []VD
        push(vs, VD("None", []string))
        ps := []string
        push(ps, t)
        push(vs, VD("Some", ps))
        push(cs.eds, ED(nm, ["None", "Some"], vs))
        push(cs.edp, "")
    return "E~" + nm

fn _res_of(cs: inout C, t: string, e: string) -> string:
    nm := _gname(&cs, "R|" + t + "|" + e)
    if _eidx(&cs, nm) < 0:
        ok := []string
        if t != "void":
            push(ok, t)
        er := []string
        push(er, e)
        vs := []VD
        push(vs, VD("Ok", ok))
        push(vs, VD("Err", er))
        push(cs.eds, ED(nm, ["Ok", "Err"], vs))
        push(cs.edp, "")
    return "E~" + nm

# `want` is the type an expression is being built FOR. `None` and `Err(e)` carry
# no way to name their own instantiation, so without it they cannot be emitted.
fn _is_optT(cs: inout C, t: string) -> bool:
    if not _is_enum(t):
        return false
    i := _eidx(&cs, _tname(t))
    return i >= 0 and _is_gen(_tname(t)) and cs.eds[i].vnames[0] == "None"

fn _is_resT(cs: inout C, t: string) -> bool:
    if not _is_enum(t):
        return false
    i := _eidx(&cs, _tname(t))
    return i >= 0 and _is_gen(_tname(t)) and cs.eds[i].vnames[0] == "Ok"

# A type whose value owns arena memory: copying it means a deep copy.
fn _heap(cs: inout C, t: string) -> bool:
    if t == "string" or t == "bytes":
        return true
    if _is_fn(t):
        return true
    if _is_arr(t) or _is_enum(t) or _is_map(t) or _is_soa(t):
        return true
    if _is_struct(t):
        i := _sidx(&cs, _tname(t))
        if i < 0:
            return false
        for ft in cs.sds[i].ftypes:
            if _heap(&cs, ft):
                return true
    if _is_tup(t):
        for et in _telems(&cs, t):
            if _heap(&cs, et):
                return true
    return false

fn _sidx(cs: inout C, n: string) -> int:
    p := _pfx(&cs)
    if len(p) > 0:
        for i := 0; i < len(cs.sds); i += 1:
            if cs.sds[i].name == p + n:
                return i
    for i := 0; i < len(cs.sds); i += 1:
        if cs.sds[i].name == n:
            return i
    return -1

fn _eidx(cs: inout C, n: string) -> int:
    p := _pfx(&cs)
    if len(p) > 0:
        for i := 0; i < len(cs.eds); i += 1:
            if cs.eds[i].name == p + n:
                return i
    for i := 0; i < len(cs.eds); i += 1:
        if cs.eds[i].name == n:
            return i
    return -1

fn _cidx(cs: inout C, n: string) -> int:
    p := _pfx(&cs)
    if len(p) > 0:
        for i := 0; i < len(cs.cnames); i += 1:
            if cs.cnames[i] == p + n:
                return i
    for i := 0; i < len(cs.cnames); i += 1:
        if cs.cnames[i] == n:
            return i
    return -1

# An extern is called by its BARE C name with no arena: it is a foreign symbol,
# not a Tycho proc. `./tychoc` emits `strx_parse_double(h_s, &(h_st))`.
fn _isext(cs: inout C, n: string) -> bool:
    for i := 0; i < len(cs.exn); i += 1:
        if cs.exn[i] == n:
            return true
    return false

fn _fidx(cs: inout C, n: string) -> int:
    p := _pfx(&cs)
    if len(p) > 0:
        for i := 0; i < len(cs.fds); i += 1:
            if cs.fds[i].name == p + n:
                return i
    for i := 0; i < len(cs.fds); i += 1:
        if cs.fds[i].name == n:
            return i
    return -1

# The generated-array registry. int/float/string reuse the runtime's own three
# array types; everything else gets a stamped-out TychoArrK<n>.
fn _akind(cs: inout C, elem: string) -> int:
    for i := 0; i < len(cs.akinds); i += 1:
        if cs.akinds[i] == elem:
            return i
    push(cs.akinds, elem)
    return len(cs.akinds) - 1

fn _apfx(cs: inout C, elem: string) -> string:
    if elem == "int":
        return "tycho_arr_int"
    if elem == "float":
        return "tycho_arr_float"
    if elem == "string":
        return "tycho_arr_str"
    return "tycho_arr_K" + str(_akind(&cs, elem))

# --- generics: monomorphised, one deep instance per distinct binding ---------
# src/tychoc.c:12773 clones the template body per instance and resolves it; the
# same shape here, with a `tpn/tpv` binding stack instead of a substitution pass.
# A binding is pushed while an instance's types (or body) are resolved and popped
# after, so a nested instantiation sees only its own parameters.

fn _gsidx(cs: inout C, n: string) -> int:
    p := _pfx(&cs)
    if len(p) > 0:
        for i := 0; i < len(cs.gs); i += 1:
            if cs.gs[i].name == p + n:
                return i
    for i := 0; i < len(cs.gs); i += 1:
        if cs.gs[i].name == n:
            return i
    return -1

fn _geidx(cs: inout C, n: string) -> int:
    p := _pfx(&cs)
    if len(p) > 0:
        for i := 0; i < len(cs.ge); i += 1:
            if cs.ge[i].name == p + n:
                return i
    for i := 0; i < len(cs.ge); i += 1:
        if cs.ge[i].name == n:
            return i
    return -1

fn _gfidx(cs: inout C, n: string) -> int:
    p := _pfx(&cs)
    if len(p) > 0:
        for i := 0; i < len(cs.gf); i += 1:
            if cs.gf[i].name == p + n:
                return i
    for i := 0; i < len(cs.gf); i += 1:
        if cs.gf[i].name == n:
            return i
    return -1

fn _tpget(cs: inout C, n: string) -> string:
    for i := len(cs.tpn) - 1; i >= 0; i -= 1:
        if cs.tpn[i] == n:
            return cs.tpv[i]
    return ""

fn _bind(cs: inout C, ns: [string], vs: [string]) -> int:
    m := len(cs.tpn)
    for i := 0; i < len(ns); i += 1:
        push(cs.tpn, ns[i])
        if i < len(vs):
            push(cs.tpv, vs[i])
        else:
            push(cs.tpv, "")
    return m

fn _unbind(cs: inout C, m: int):
    for len(cs.tpn) > m:
        pop(cs.tpn)
        pop(cs.tpv)

fn _iidx(cs: inout C, key: string) -> int:
    for i := 0; i < len(cs.ikey); i += 1:
        if cs.ikey[i] == key:
            return i
    return -1

# Without this a recursive generic at a GROWING type (`grow([x])` binding $T to
# int, [int], [[int]] ...) never reaches the fixpoint and allocates until the
# OOM killer fires. src/tychoc.c caps at the same 1024 and refuses.
fn _inst_cap(n: int):
    if n > 1024:
        _bad("too many generic instantiations (> 1024) -- a recursive generic at a growing type?")

fn _inst_struct(cs: inout C, n: string, targs: [string]) -> string:
    gi := _gsidx(&cs, n)
    gn := cs.gs[gi].name
    key := "S|" + gn + "|" + _tjoin(targs)
    ex := _iidx(&cs, key)
    if ex >= 0:
        return "S~" + cs.iname[ex]
    _inst_cap(len(cs.ikey))
    mang := gn + "__" + str(len(cs.ikey))
    push(cs.ikey, key)
    push(cs.iname, mang)
    push(cs.iarg, _tjoin(targs))
    push(cs.pendk, -1)
    push(cs.sds, SD(mang, [], []))
    si := len(cs.sds) - 1
    m := _bind(&cs, cs.gs[gi].typarams, targs)
    save := cs.cf
    cs.cf = cs.gsf[gi]
    for f in cs.gs[gi].fields:
        push(cs.sds[si].fnames, f.name)
        push(cs.sds[si].ftypes, _ty(&cs, f.ty))
    cs.cf = save
    _unbind(&cs, m)
    return "S~" + mang

fn _inst_enum(cs: inout C, n: string, targs: [string]) -> string:
    gi := _geidx(&cs, n)
    gn := cs.ge[gi].name
    key := "E|" + gn + "|" + _tjoin(targs)
    ex := _iidx(&cs, key)
    if ex >= 0:
        return "E~" + cs.iname[ex]
    _inst_cap(len(cs.ikey))
    mang := gn + "__" + str(len(cs.ikey))
    push(cs.ikey, key)
    push(cs.iname, mang)
    push(cs.iarg, _tjoin(targs))
    push(cs.pendk, -1)
    push(cs.eds, ED(mang, [], []))
    push(cs.edp, cs.fpfx[cs.gef[gi]])
    ei := len(cs.eds) - 1
    m := _bind(&cs, cs.ge[gi].typarams, targs)
    save := cs.cf
    cs.cf = cs.gef[gi]
    for v in cs.ge[gi].variants:
        push(cs.eds[ei].vnames, v.name)
        ps := []string
        for pt in v.payload:
            push(ps, _ty(&cs, pt))
        push(cs.eds[ei].vpay, VD(v.name, ps))
    cs.cf = save
    _unbind(&cs, m)
    return "E~" + mang

# The instance's own type arguments, read back out of the registry so a call
# site can unify a template type against a concrete instance.
fn _inst_of(cs: inout C, mang: string) -> [string]:
    for i := 0; i < len(cs.iname); i += 1:
        if cs.iname[i] == mang:
            return split(cs.iarg[i], "|")
    return []string

fn _inst_base(cs: inout C, mang: string) -> string:
    for i := 0; i < len(cs.iname); i += 1:
        if cs.iname[i] == mang:
            return split(cs.ikey[i], "|")[1]
    return ""

# A call site binds the type parameters by matching the DECLARED parameter type
# against the argument's concrete type -- the same shape src/tychoc.c infers,
# structurally and left to right, first binding wins.
fn _unify(cs: inout C, t: ast.Ty, a: string, tps: [string], bs: inout [string]):
    if len(a) == 0:
        return
    match t:
        ast.TParam(n):
            for i := 0; i < len(tps); i += 1:
                if tps[i] == n and len(bs[i]) == 0:
                    bs[i] = a
            return
        ast.TArr(es):
            if _is_arr(a):
                _unify(&cs, es[0], _elem(a), tps, &bs)
            return
        ast.TSoa(es):
            if _is_soa(a):
                _unify(&cs, es[0], _selem(&cs, a), tps, &bs)
            return
        # A FUNCTION type. Without this arm `Plan($T)` holding
        # `[fn($T) -> $T]` cannot bind $T from a `[fn(int) -> int]` argument:
        # TArr recurses to the element, finds a fn, and stops. ast.TFn stores
        # the params in order with the return type LAST (compiler/ast/ast.ty:22).
        # `bounded[N]T` lowers to the dynamic array (Phase 7b), so its element
        # unifies exactly as an array's does -- `Box($T)` with `xs: bounded[4]$T`.
        ast.TBnd(nn, es):
            if _is_arr(a):
                _unify(&cs, es[0], _elem(a), tps, &bs)
            return
        ast.TFn(hr, es):
            if _is_fn(a):
                aps := _fps(&cs, a)
                np := len(es)
                if hr:
                    np = np - 1
                for fi := 0; fi < np and fi < len(aps); fi += 1:
                    _unify(&cs, es[fi], aps[fi], tps, &bs)
                if hr and np < len(es):
                    _unify(&cs, es[np], _fret(&cs, a), tps, &bs)
            return
        ast.TMap(es):
            if _is_map(a):
                _unify(&cs, es[0], _mkey(&cs, a), tps, &bs)
                _unify(&cs, es[1], _mval(&cs, a), tps, &bs)
            return
        ast.TTup(es):
            if _is_tup(a):
                el := _telems(&cs, a)
                for i := 0; i < len(es) and i < len(el); i += 1:
                    _unify(&cs, es[i], el[i], tps, &bs)
            return
        ast.TName(q, n, targs):
            if len(targs) == 0:
                for i := 0; i < len(tps); i += 1:
                    if tps[i] == n and len(bs[i]) == 0:
                        bs[i] = a
                return
            if n == "Option" and _is_optT(&cs, a):
                ei := _eidx(&cs, _tname(a))
                _unify(&cs, targs[0], cs.eds[ei].vpay[1].ptypes[0], tps, &bs)
                return
            if n == "Result" and _is_resT(&cs, a):
                ei2 := _eidx(&cs, _tname(a))
                ok := cs.eds[ei2].vpay[0].ptypes
                if len(targs) > 0 and len(ok) > 0:
                    _unify(&cs, targs[0], ok[0], tps, &bs)
                er := cs.eds[ei2].vpay[1].ptypes
                if len(targs) > 1 and len(er) > 0:
                    _unify(&cs, targs[1], er[0], tps, &bs)
                return
            if not (_is_struct(a) or _is_enum(a)):
                return
            if _inst_base(&cs, _tname(a)) != n:
                return
            ia := _inst_of(&cs, _tname(a))
            for i := 0; i < len(targs) and i < len(ia); i += 1:
                _unify(&cs, targs[i], ia[i], tps, &bs)
            return
        _: return
    return

fn _blank(n: int) -> [string]:
    out := []string
    for i := 0; i < n; i += 1:
        push(out, "")
    return out

fn _inst_fn(cs: inout C, n: string, targs: [string]) -> int:
    gi := _gfidx(&cs, n)
    gn := cs.gf[gi].name
    key := "F|" + gn + "|" + _tjoin(targs)
    ex := _iidx(&cs, key)
    if ex >= 0:
        return _fidx(&cs, cs.iname[ex])
    _inst_cap(len(cs.ikey))
    mang := gn + "__" + str(len(cs.ikey))
    push(cs.ikey, key)
    push(cs.iname, mang)
    push(cs.iarg, _tjoin(targs))
    push(cs.pendk, -1)
    ii := len(cs.ikey) - 1
    m := _bind(&cs, cs.gf[gi].typarams, targs)
    save := cs.cf
    cs.cf = cs.gff[gi]
    pn := []string
    pt := []string
    pio := []bool
    pv := false
    for prm in cs.gf[gi].params:
        if len(prm.ty) == 0:
            _bad("untyped parameter on '" + n + "'")
        one := _ty(&cs, prm.ty[0])
        if prm.is_variadic:
            pv = true
            one = "[" + one + "]"
        push(pn, prm.name)
        push(pt, one)
        push(pio, prm.is_inout)
    rt := _tyo(&cs, cs.gf[gi].ret)
    cs.cf = save
    _unbind(&cs, m)
    push(cs.fds, FD(mang, pn, pt, pio, pv, rt))
    cs.pendk[ii] = len(cs.fds) - 1
    return len(cs.fds) - 1

fn _cty(cs: inout C, t: string) -> string:
    if t == "int" or t == "char":
        return "tycho_int"
    if t == "float":
        return "double"
    if t == "bool":
        return "int"
    if t == "string" or t == "bytes":
        return "char *"
    if t == "ptr":
        return "void *"
    if t == "u8":
        return "unsigned char"
    if t == "u16":
        return "unsigned short"
    if t == "u32":
        return "unsigned int"
    if t == "u64":
        return "unsigned long long"
    if t == "i8":
        return "signed char"
    if t == "i16":
        return "short"
    if t == "i32":
        return "int"
    if t == "i64":
        return "long long"
    if t == "f32":
        return "float"
    if t == "void":
        return "void"
    if _is_struct(t):
        return "S_" + _tname(t)
    if _is_enum(t):
        return "E_" + _tname(t) + " *"
    if _is_tup(t):
        return "TychoTup" + _tname(t)
    if _is_fn(t):
        return "FnC" + _tname(t)
    if _is_map(t):
        return "TychoMapM" + _tname(t)
    if _is_soa(t):
        return "Soa" + _tname(t)
    if _is_arr(t):
        e := _elem(t)
        if e == "int":
            return "TychoArrInt"
        if e == "float":
            return "TychoArrFloat"
        if e == "string":
            return "TychoArrStr"
        return "TychoArrK" + str(_akind(&cs, e))
    _bad("no C type for '" + t + "'")
    return ""

# --- syntactic type -> type string ------------------------------------------

fn _ty(cs: inout C, t: ast.Ty) -> string:
    match t:
        ast.TPrim(p):
            if p == "int" or p == "float" or p == "bool" or p == "string" or p == "char" or p == "void":
                return p
            if _is_sized(p) or p == "bytes" or p == "ptr":
                return p
            _bad("unsupported primitive type '" + p + "' -- Phase 8")
        ast.TName(q, n0, targs):
            n := n0
            if len(q) > 0:
                n = _qpfx(&cs, q) + n0
            if len(q) == 0 and len(targs) == 0 and n == "void":
                return "void"
            if len(q) == 0 and n == "Option" and len(targs) == 1:
                return _opt_of(&cs, _ty(&cs, targs[0]))
            if len(q) == 0 and n == "Result" and len(targs) == 2:
                return _res_of(&cs, _ty(&cs, targs[0]), _ty(&cs, targs[1]))
            if len(targs) > 0:
                as2 := []string
                for a in targs:
                    push(as2, _ty(&cs, a))
                if _gsidx(&cs, n) >= 0:
                    return _inst_struct(&cs, n, as2)
                if _geidx(&cs, n) >= 0:
                    return _inst_enum(&cs, n, as2)
                _bad("generic type '" + n0 + "' -- Phase 8")
            tv := _tpget(&cs, n)
            if len(tv) > 0:
                return tv
            ni := _ntidx(&cs, n)
            if ni >= 0:
                if len(cs.ntu[ni]) == 0:
                    _bad("newtype '" + n + "' used before its underlying type resolves")
                return cs.ntu[ni]
            si0 := _sidx(&cs, n)
            if si0 >= 0:
                return "S~" + cs.sds[si0].name
            ei0 := _eidx(&cs, n)
            if ei0 >= 0:
                return "E~" + cs.eds[ei0].name
            _bad("unknown type '" + n0 + "'")
        ast.TArr(es):
            return "[" + _ty(&cs, es[0]) + "]"
        ast.TParam(n):
            v := _tpget(&cs, n)
            if len(v) == 0:
                _bad("unbound type parameter '$" + n + "'")
            return v
        ast.TFix(n, e):
            # `[N]T` lowers to the dynamic array. The static rules -- the length
            # being a compile-time constant, no push -- are the checker's, which
            # has already run by here; what is left for emit is the values.
            return "[" + _ty(&cs, e[0]) + "]"
        ast.TMap(e):
            kt := _ty(&cs, e[0])
            return _map_of(&cs, kt, _ty(&cs, e[1]))
        ast.TTup(e):
            es2 := []string
            for x in e:
                push(es2, _ty(&cs, x))
            return _tup_of(&cs, es2)
        ast.TFn(h, e):
            ps2 := []string
            nps := len(e)
            r2 := "void"
            if h:
                nps -= 1
                r2 = _ty(&cs, e[nps])
            for i := 0; i < nps; i += 1:
                push(ps2, _ty(&cs, e[i]))
            return _fn_of(&cs, r2, ps2)
        ast.TSoa(e):
            return _soa_of(&cs, _ty(&cs, e[0]))
        ast.TBnd(n, e):
            # `bounded[N]T` lowers to the dynamic array too. NOT covered by this:
            # the capacity trap on an over-cap push, which needs N carried in the
            # type string -- tests/bounded_const_cap.ty is what would show it.
            return "[" + _ty(&cs, e[0]) + "]"
        _: _bad("unsupported type form -- Phase 8")
    return ""

# True when every name in `t` already resolves -- used to order newtype
# resolution without letting `_ty` die on a forward reference.
fn _ty_ready(cs: inout C, t: ast.Ty) -> bool:
    match t:
        ast.TPrim(p): return true
        ast.TParam(n): return len(_tpget(&cs, n)) > 0
        ast.TName(q, n0, targs):
            n := n0
            if len(q) > 0:
                n = _qpfx(&cs, q) + n0
            if len(targs) > 0:
                for a in targs:
                    if not _ty_ready(&cs, a):
                        return false
                return _gsidx(&cs, n) >= 0 or _geidx(&cs, n) >= 0
            if len(_tpget(&cs, n)) > 0:
                return true
            ni := _ntidx(&cs, n)
            if ni >= 0:
                return len(cs.ntu[ni]) > 0
            return _sidx(&cs, n) >= 0 or _eidx(&cs, n) >= 0
        ast.TArr(es): return _ty_ready(&cs, es[0])
        ast.TMap(es):
            return _ty_ready(&cs, es[0]) and _ty_ready(&cs, es[1])
        ast.TTup(es):
            for x in es:
                if not _ty_ready(&cs, x):
                    return false
            return true
        _: return false
    return false

fn _tyo(cs: inout C, ts: [ast.Ty]) -> string:
    if len(ts) == 0:
        return "void"
    if len(ts) > 1:
        es := []string
        for x in ts:
            push(es, _ty(&cs, x))
        return _tup_of(&cs, es)
    return _ty(&cs, ts[0])

# --- local scope ------------------------------------------------------------

fn _mark(cs: inout C) -> int:
    return len(cs.vnames)

fn _restore(cs: inout C, m: int):
    for len(cs.vnames) > m:
        pop(cs.vnames)
        pop(cs.vtypes)
        pop(cs.vcn)
        pop(cs.vown)

# A nested `x := x + 1` shadows the outer x, and in C the new declarator is
# already in scope inside its own initialiser -- so the inner read would see
# the uninitialised copy. A shadowing binding gets a fresh C name instead.
fn _push(cs: inout C, n: string, t: string) -> string:
    cn := "h_" + n
    if len(_vtype(&cs, n)) > 0:
        cs.tmp += 1
        cn = "h_" + n + "_s" + str(cs.tmp)
    push(cs.vnames, n)
    push(cs.vtypes, t)
    push(cs.vcn, cn)
    push(cs.vown, "&_scope")
    return cn

fn _vtype(cs: inout C, n: string) -> string:
    for i := len(cs.vnames) - 1; i >= 0; i -= 1:
        if cs.vnames[i] == n:
            return cs.vtypes[i]
    return ""

# Ground a PENDING binding at its first assignment (a value-if/value-match).
fn _vset(cs: inout C, n: string, t: string):
    for i := len(cs.vnames) - 1; i >= 0; i -= 1:
        if cs.vnames[i] == n:
            cs.vtypes[i] = t
            return

fn _vcname(cs: inout C, n: string) -> string:
    for i := len(cs.vnames) - 1; i >= 0; i -= 1:
        if cs.vnames[i] == n:
            return cs.vcn[i]
    return ""

# A heap value reached through an `inout` parameter belongs to the CALLER's
# arena: allocating its growth in this function's `_scope` leaves the buffer
# dangling the moment the callee returns. Each such parameter therefore carries
# its owning arena alongside it, exactly as src/tychoc.c@owner_arena_of does
# with its `_ina_<name>`.
fn _rootname(e: ast.Expr) -> string:
    match e:
        ast.Name(l, n): return n
        ast.Field(l, r, f): return _rootname(r[0])
        ast.Index(l, k): return _rootname(k[0])
        ast.TupIdx(l, k, i): return _rootname(k[0])
        ast.Addr(l, k): return _rootname(k[0])
        _: return ""
    return ""

fn _ownerof(cs: inout C, e: ast.Expr) -> string:
    n := _rootname(e)
    if len(n) == 0:
        return "&_scope"
    for i := len(cs.vnames) - 1; i >= 0; i -= 1:
        if cs.vnames[i] == n:
            return cs.vown[i]
    return "&_scope"

fn _fresh(cs: inout C, p: string) -> string:
    cs.tmp += 1
    return p + str(cs.tmp)

# --- deep copy / str / eq ---------------------------------------------------

fn _copy(cs: inout C, code: string, t: string, arena: string) -> string:
    if t == "string" or t == "bytes":
        return "tycho_str_copy(" + arena + ", " + code + ")"
    if _is_fn(t):
        # re-home a returned closure's captures; a plain fn ref has env == 0
        return "({ " + _cty(&cs, t) + " _fcp = (" + code + "); if (_fcp.env) _fcp.env = _fcp.copyenv(" +
            arena + ", _fcp.env); _fcp; })"
    if _is_arr(t):
        return _apfx(&cs, _elem(t)) + "_copy(" + arena + ", " + code + ")"
    if _is_enum(t):
        return "tycho_copy_E_" + _tname(t) + "(" + arena + ", " + code + ")"
    if _is_map(t):
        return _mpfx(&cs, t) + "_copy(" + arena + ", " + code + ")"
    if _is_soa(t):
        return _spfx(&cs, t) + "_copy(" + arena + ", " + code + ")"
    if _is_struct(t) and _heap(&cs, t):
        return "tycho_copy_S_" + _tname(t) + "(" + arena + ", " + code + ")"
    if _is_tup(t) and _heap(&cs, t):
        return "tycho_copy_T" + _tname(t) + "(" + arena + ", " + code + ")"
    return code

fn _tostr(cs: inout C, code: string, t: string) -> string:
    if t == "string" or t == "bytes":
        return code
    if _is_uint(t):
        return "tycho_uint_to_str(" + cs.arena + ", " + code + ")"
    if _is_sint(t):
        return "tycho_int_to_str(" + cs.arena + ", " + code + ")"
    if t == "f32":
        return "tycho_float_to_str(" + cs.arena + ", (double)(" + code + "))"
    if _is_fn(t):
        # a closure has no printable form; the struct str() generator is eager
        # here and would otherwise refuse every struct holding a callback
        return "TYCHO_LIT(\"<fn>\")"
    if t == "int":
        return "tycho_int_to_str(" + cs.arena + ", " + code + ")"
    if t == "char":
        return "tycho_chr(" + cs.arena + ", " + code + ")"
    if t == "float":
        return "tycho_float_to_str(" + cs.arena + ", " + code + ")"
    if t == "bool":
        return "tycho_bool_to_str(" + cs.arena + ", " + code + ")"
    if _is_struct(t):
        return "tycho_str_S_" + _tname(t) + "(" + cs.arena + ", " + code + ")"
    if _is_tup(t):
        return "tycho_str_T" + _tname(t) + "(" + cs.arena + ", " + code + ")"
    if _is_enum(t):
        return "tycho_str_E_" + _tname(t) + "(" + cs.arena + ", " + code + ")"
    if _is_map(t):
        return "tycho_str_mapM" + _tname(t) + "(" + cs.arena + ", " + code + ")"
    if _is_soa(t):
        return "tycho_str_from_c(" + cs.arena + ", \"<soa [" + _tname(_selem(&cs, t)) + "]>\")"
    if _is_arr(t):
        e := _elem(t)
        if e == "int":
            return "tycho_arr_int_str(" + cs.arena + ", " + code + ")"
        if e == "float":
            return "tycho_arr_float_str(" + cs.arena + ", " + code + ")"
        if e == "string":
            return "tycho_arr_str_str(" + cs.arena + ", " + code + ")"
        return "tycho_str_arr_K" + str(_akind(&cs, e)) + "(" + cs.arena + ", " + code + ")"
    _bad("str() of unsupported type '" + t + "'")
    return ""

# The value a missing map key reads as. A Tycho string carries a length header
# in front of the pointer, so a NULL `char *` is not the empty string -- it
# crashes the first read (tests/map_index_read.ty prints exactly that case).
fn _zero(cs: inout C, t: string) -> string:
    if t == "string" or t == "bytes":
        return "TYCHO_LIT(\"\")"
    if _is_sized(t):
        return "0"
    if _is_fn(t):
        return "(" + _cty(&cs, t) + "){0, 0, 0}"
    if t == "float":
        return "0.0"
    if t == "int" or t == "char" or t == "bool":
        return "0LL"
    return "(" + _cty(&cs, t) + "){0}"

fn _eq(cs: inout C, a: string, b: string, t: string) -> string:
    if _is_fn(t):
        # identity: same thunk and same env -- src/tychoc.c:10214
        return "((" + a + ").call == (" + b + ").call && (" + a + ").env == (" + b + ").env)"
    if t == "string" or t == "bytes":
        return "(tycho_str_cmp(" + a + ", " + b + ") == 0)"
    if _is_struct(t):
        return "tycho_eq_S_" + _tname(t) + "(" + a + ", " + b + ")"
    if _is_tup(t):
        return "tycho_eq_T" + _tname(t) + "(" + a + ", " + b + ")"
    if _is_enum(t):
        return "tycho_eq_E_" + _tname(t) + "(" + a + ", " + b + ")"
    if _is_map(t):
        return _mpfx(&cs, t) + "_eq(" + a + ", " + b + ")"
    if _is_soa(t):
        return _spfx(&cs, t) + "_eq(" + a + ", " + b + ")"
    if _is_arr(t):
        return _apfx(&cs, _elem(t)) + "_eq(" + a + ", " + b + ")"
    return "(" + a + " == " + b + ")"

# --- expressions ------------------------------------------------------------
# Every `_ex` returns the C text; `_ty_of` the type string. They are computed
# together and returned as a tuple so an expression is walked once.

# A key that can be evaluated twice with no observable difference.
fn _simple(e: ast.Expr) -> bool:
    match e:
        ast.Name(l, n): return true
        ast.IntLit(l, v): return true
        ast.StrLit(l, v): return true
        ast.CharLit(l, v): return true
        ast.BoolLit(l, v): return true
        ast.FloatLit(l, v): return true
        _: return false
    return false

fn _place(e: ast.Expr) -> bool:
    match e:
        ast.Name(l, n): return true
        ast.Field(l, r, f): return true
        ast.Index(l, k): return true
        ast.TupIdx(l, k, n): return true
        _: return false
    return false

fn _num2(a: string, b: string) -> string:
    if a == "float" or b == "float":
        return "float"
    if a == "f32" or b == "f32":
        return "f32"
    if _is_sized(a):
        return a
    if _is_sized(b):
        return b
    if a == "char" or b == "char":
        return "char"
    return "int"

fn _lit_float(v: float) -> string:
    s := str(v)
    has := false
    for i := 0; i < len(s); i += 1:
        if s[i] == 46 or s[i] == 101 or s[i] == 69:
            has = true
    if has:
        return s
    return s + ".0"

fn _ex(cs: inout C, e: ast.Expr) -> (string, string):
    match e:
        ast.IntLit(l, v):
            return (str(v) + "LL", "int")
        ast.FloatLit(l, v):
            return (_lit_float(v), "float")
        ast.CharLit(l, v):
            return (str(v) + "LL", "char")
        ast.BoolLit(l, v):
            if v:
                return ("1", "bool")
            return ("0", "bool")
        ast.StrLit(l, s):
            return ("TYCHO_LIT(\"" + s + "\")", "string")
        ast.Name(l, n):
            t := _vtype(&cs, n)
            if len(t) > 0:
                return (_vcname(&cs, n), t)
            ci := _cidx(&cs, n)
            if ci >= 0:
                return (cs.ccode[ci], cs.ctypes[ci])
            ei := _bare_variant(&cs, n)
            if ei >= 0:
                return _variant(&cs, ei, n, [])
            fi2 := _fidx(&cs, n)
            if fi2 >= 0:
                _need_clo(&cs, fi2)
                ft2 := _fn_of(&cs, cs.fds[fi2].ret, cs.fds[fi2].ptypes)
                return ("(" + _cty(&cs, ft2) + "){0, " + cs.fds[fi2].name + "__clo, 0}", ft2)
            _bad("unknown name '" + n + "'")
        ast.Field(l, r, f):
            pm, pt2 := _pkgmember(&cs, r[0], f)
            if len(pt2) > 0:
                return (pm, pt2)
            # `ps[i].x` PROJECTS into the soa's own buffer for x -- it is never a
            # gather followed by a field read, which would copy every field.
            match r[0]:
                ast.Index(l2, k2):
                    bc2, bt2 := _ex(&cs, k2[0])
                    if _is_soa(bt2):
                        ic3, it3 := _ex(&cs, k2[1])
                        return _soafld(&cs, bc2, bt2, ic3, f)
                _: pass
            rc, rt := _ex(&cs, r[0])
            if not _is_struct(rt):
                _bad("field '" + f + "' on non-struct")
            si := _sidx(&cs, _tname(rt))
            for i := 0; i < len(cs.sds[si].fnames); i += 1:
                if cs.sds[si].fnames[i] == f:
                    return ("((" + rc + ").f_" + f + ")", cs.sds[si].ftypes[i])
            _bad("no field '" + f + "' on " + _tname(rt))
        ast.Index(l, k):
            rc, rt := _ex(&cs, k[0])
            ic, it := _ex(&cs, k[1])
            if rt == "string" or rt == "bytes":
                return ("tycho_str_get(" + rc + ", " + ic + ")", "int")
            if _is_soa(rt):
                return (_spfx(&cs, rt) + "_get(&(" + rc + "), " + ic + ")", _selem(&cs, rt))
            if _is_map(rt):
                vt := _mval(&cs, rt)
                g := _mpfx(&cs, rt) + "_get(" + rc + ", " +
                    _keyrt(&cs, _mkey(&cs, rt), ic) + ", " + _zero(&cs, vt) + ")"
                return (_copy(&cs, g, vt, cs.arena), vt)
            if not _is_arr(rt):
                _bad("indexing a non-array")
            et := _elem(rt)
            return (_apfx(&cs, et) + "_get(" + rc + ", " + ic + ")", et)
        ast.Slice(l, hl, hh, k):
            rc, rt := _ex(&cs, k[0])
            lo := "0LL"
            hi := ""
            j := 1
            if hl:
                lc, lt := _ex(&cs, k[j])
                lo = lc
                j += 1
            if hh:
                hc, ht := _ex(&cs, k[j])
                hi = hc
            if rt == "string" or rt == "bytes":
                if len(hi) == 0:
                    hi = "tycho_str_len(" + rc + ")"
                return ("tycho_str_substr(" + cs.arena + ", " + rc + ", " + lo + ", " + hi + ")", rt)
            # A soa slice offsets EVERY field pointer by lo and carries cap 0,
            # so it is a view; the copy-on-bind comes from _heap, as for arrays.
            if _is_soa(rt):
                ss := _fresh(&cs, "_sv")
                sl := _fresh(&cs, "_lo")
                sh := _fresh(&cs, "_hi")
                if len(hi) == 0:
                    hi = ss + ".len"
                st2 := _selem(&cs, rt)
                si2 := _sidx(&cs, _tname(st2))
                offs := ""
                for fi := 0; fi < len(cs.sds[si2].fnames); fi += 1:
                    offs = offs + ss + ".f" + str(fi) + " + " + sl + ", "
                # Copied, not returned as a view: the sliced Soa's field
                # pointers alias the SOURCE buffers, so `sl[0].x = -1` would
                # write through to q[1].x. ./tychoc wraps the same way.
                return (_spfx(&cs, rt) + "_copy(" + cs.arena + ", ({ " + _cty(&cs, rt) + " " + ss + " = " + rc + "; tycho_int " +
                    sl + " = " + lo + ", " + sh + " = " + hi + "; if (" + sl + " < 0 || " +
                    sh + " > " + ss + ".len || " + sl + " > " + sh + ") { fprintf(stderr, " +
                    "\"tycho: slice [%\" TY_PRId \":%\" TY_PRId \"] out of bounds (len %\" TY_PRId \")\\n\", " +
                    sl + ", " + sh + ", " + ss + ".len); exit(1); } (" + _cty(&cs, rt) + "){ " +
                    offs + sh + " - " + sl + ", 0 }; }))", rt)
            if not _is_arr(rt):
                _bad("slicing '" + rt + "'")
            sv := _fresh(&cs, "_sv")
            act := _cty(&cs, rt)
            if len(hi) == 0:
                hi = "(" + sv + ".len)"
            sl := "({ " + act + " " + sv + " = " + rc + "; tycho_int " + sv + "lo = " + lo +
                ", " + sv + "hi = " + hi + "; if (" + sv + "lo < 0 || " + sv + "hi > " + sv +
                ".len || " + sv + "lo > " + sv + "hi) { fprintf(stderr, \"tycho: slice [%\" TY_PRId \":%\" TY_PRId \"] out of bounds (len %\" TY_PRId \")\\n\", " +
                sv + "lo, " + sv + "hi, " + sv + ".len); exit(1); } (" + act + "){ " + sv +
                ".data + " + sv + "lo, " + sv + "hi - " + sv + "lo, 0 }; })"
            return (_copy(&cs, sl, rt, "&_scope"), rt)
        ast.Unop(l, op, k):
            c, t := _ex(&cs, k[0])
            if op == "not":
                return ("(!" + c + ")", "bool")
            if op == "-" or op == "~":
                if _is_sized(t):
                    return ("((" + _cty(&cs, t) + ")(" + op + c + "))", t)
                return ("(" + op + c + ")", t)
            _bad("unsupported unary '" + op + "'")
        ast.Binop(l, op, k):
            return _binop(&cs, op, k[0], k[1])
        ast.Call(l, q, n, tas, args):
            return _call(&cs, l, q, n, tas, args)
        ast.ArrLit(l, k):
            return _arrlit(&cs, k)
        ast.EmptyArr(l, ts):
            et := ""
            if len(ts) == 0 and _is_map(cs.want):
                # `m: [K: V] = []` -- a bare [] under a map annotation is the
                # empty map, not an empty array.
                mv2 := _fresh(&cs, "_mp")
                return ("({ " + _cty(&cs, cs.want) + " " + mv2 + " = " +
                    _mpfx(&cs, cs.want) + "_with_cap(&_scope, 0); " + mv2 + "; })", cs.want)
            if len(ts) > 0:
                et = _ty(&cs, ts[0])
            else:
                if not _is_arr(cs.want):
                    _bad("a bare [] needs an element type here")
                et = _elem(cs.want)
            v := _fresh(&cs, "_l")
            ct := _cty(&cs, "[" + et + "]")
            return ("({ " + ct + " " + v + " = " + _apfx(&cs, et) +
                "_with_cap(&_scope, 0); " + v + ".len = 0; " + v + "; })", "[" + et + "]")
        ast.IsVar(l, k, q, vn):
            sc, st := _ex(&cs, k[0])
            if not _is_enum(st):
                _bad("`is` on a non-enum")
            ei := _eidx(&cs, _tname(st))
            tag := _tag(&cs, ei, vn)
            return ("((" + sc + ")->tag == " + str(tag) + ")", "bool")
        ast.TupIdx(l, k, n):
            rc, rt := _ex(&cs, k[0])
            if not _is_tup(rt):
                _bad("`.` index on a non-tuple")
            es := _telems(&cs, rt)
            if n < 0 or n >= len(es):
                _bad("tuple has no element " + str(n))
            return ("((" + rc + ").f" + str(n) + ")", es[n])
        ast.Tuple(l, k):
            ecs := []string
            ets := []string
            # Each element is emitted under the CORRESPONDING element of the
            # wanted tuple type, so `return (Ok(3), "full")` tells the bare `Ok`
            # which Result it belongs to. Only the signature writes that down.
            swt := cs.want
            wts := []string
            if _is_tup(swt):
                wts = _telems(&cs, swt)
            ti := 0
            for x in k:
                if ti < len(wts):
                    cs.want = wts[ti]
                else:
                    cs.want = ""
                ti += 1
                xc, xt := _ex_scope(&cs, x)
                cs.want = swt
                if _place(x) and _heap(&cs, xt):
                    xc = _copy(&cs, xc, xt, "&_scope")
                push(ecs, xc)
                push(ets, xt)
            tt := _tup_of(&cs, ets)
            v := _fresh(&cs, "_tp")
            out := "({ " + _cty(&cs, tt) + " " + v + "; "
            for i := 0; i < len(ecs); i += 1:
                out = out + v + ".f" + str(i) + " = " + ecs[i] + "; "
            return (out + v + "; })", tt)
        ast.SomeE(l, k):
            w := cs.want
            if not _is_optT(&cs, w):
                pc, pt := _ex(&cs, k[0])
                w = _opt_of(&cs, pt)
            return _variant(&cs, _eidx(&cs, _tname(w)), "Some", k)
        ast.NoneE(l):
            if not _is_optT(&cs, cs.want):
                _bad("`None` here has no Option type to belong to")
            return _variant(&cs, _eidx(&cs, _tname(cs.want)), "None", []ast.Expr)
        ast.OkE(l, k):
            if not _is_resT(&cs, cs.want):
                _bad("`Ok` here has no Result type to belong to")
            return _variant(&cs, _eidx(&cs, _tname(cs.want)), "Ok", k)
        ast.ErrE(l, k):
            if not _is_resT(&cs, cs.want):
                _bad("`Err` here has no Result type to belong to")
            return _variant(&cs, _eidx(&cs, _tname(cs.want)), "Err", k)
        ast.OrRet(l, k):
            return _orret(&cs, k[0])
        ast.FStrLit(l, v): return _fstr(&cs, v)
        ast.NullLit(l):
            # `null` is the ptr literal; ptr is void* in the ABI.
            return ("((void *)0)", "ptr")
        ast.CallVal(l, k):
            sc, st3, ok3 := _subcallval(&cs, k, false)
            if ok3:
                return (sc, st3)
            return _callval(&cs, k)
        ast.Named(l, n, k): _bad("expr:Named -- Phase 8")
        ast.MapLit(l, k):
            return _maplit(&cs, k)
        ast.EmptyMap(l, t):
            mt := _map_of(&cs, _ty(&cs, t[0]), _ty(&cs, t[1]))
            mv := _fresh(&cs, "_mp")
            return ("({ " + _cty(&cs, mt) + " " + mv + " = " + _mpfx(&cs, mt) +
                "_with_cap(&_scope, 0); " + mv + "; })", mt)
        ast.SoaLit(l, t):
            ot := _soa_of(&cs, _ty(&cs, t[0]))
            return ("(" + _cty(&cs, ot) + "){0}", ot)
        ast.SpawnE(l, k): _bad("expr:SpawnE -- Phase 8")
        ast.Spread(l, k): _bad("expr:Spread -- Phase 8")
        ast.Addr(l, k):
            # `&x` reaching the EXPRESSION path. An inout ARGUMENT never gets
            # here -- `_addr_of` handles that -- so this is the residual case,
            # and it delegates rather than growing a second implementation.
            # Measured: the `&` here is not load-bearing for either fixture
            # (removing it moves no count), so what this arm buys is that Addr
            # stops aborting, not the address itself.
            _, at5 := _lvalue(&cs, k[0])
            return (_addr_of(&cs, e), at5)
        ast.ChanE(l, t, k): _bad("expr:ChanE -- Phase 8")
        ast.Lambda(l, p, r, b): return _lambda(&cs, p, r, b[0])
        _: _bad("unsupported expression -- Phase 8")
    return ("", "")

# A value that is STORED outlives the statement that built it, so it is built in
# the scope arena even inside an expression statement's temp arena. Without this
# `push(xs, P("p" + str(i)))` leaves the field pointing into freed memory.
# --- f-strings --------------------------------------------------------------
# The parser hands `FStrLit` its body UNPARSED (ast/ast.ty:45), so both the
# split and the hole's re-lex happen here. Mirrors src/tychoc.c@desugar_interp,
# except that the body arrives RAW -- lex.ty:503 keeps the escapes, and a nested
# string inside a hole is copied verbatim with its quotes unescaped
# (lex/lex.ty:158), so a hole's text is lexable as it stands.
# Returns the pieces and, per piece, 0 for literal text and 1 for a hole.
fn _fsplit(body: string) -> ([string], [int]):
    txt := []string
    kind := []int
    lit := ""
    i := 0
    n := len(body)
    for i < n:
        c := body[i]
        if c == 123 and i + 1 < n and body[i + 1] == 123:
            lit = lit + "{"
            i += 2
            continue
        if c == 125 and i + 1 < n and body[i + 1] == 125:
            lit = lit + "}"
            i += 2
            continue
        if c == 125:
            _bad("unmatched '}' in an interpolated string (use '}}' for a literal brace)")
        if c == 123:
            if len(lit) > 0:
                push(txt, lit)
                push(kind, 0)
                lit = ""
            i += 1
            start := i
            depth := 1
            for i < n and depth > 0:
                d := body[i]
                if d == 34:
                    i += 1
                    for i < n and body[i] != 34:
                        if body[i] == 92:
                            i += 1
                        i += 1
                    if i >= n:
                        _bad("unterminated string in an interpolated hole")
                    i += 1
                    continue
                if d == 123:
                    depth += 1
                elif d == 125:
                    depth -= 1
                    if depth == 0:
                        break
                i += 1
            if depth != 0:
                _bad("unterminated '{' in an interpolated string")
            if i == start:
                _bad("empty '{}' in an interpolated string")
            push(txt, body[start:i])
            push(kind, 1)
            i += 1
            continue
        if c == 92:
            lit = lit + body[i:i + 2]
            i += 2
            continue
        lit = lit + body[i:i + 1]
        i += 1
    if len(lit) > 0:
        push(txt, lit)
        push(kind, 0)
    return (txt, kind)

fn _fstr(cs: inout C, body: string) -> (string, string):
    txt, kind := _fsplit(body)
    if len(txt) == 0:
        return ("TYCHO_LIT(\"\")", "string")
    sw := cs.want
    cs.want = ""
    # One statement per piece, so the holes run LEFT TO RIGHT (spec 13.4).
    # Folding them into one concat call would leave the order unspecified --
    # exactly the defect tests/fstring_eval_order.ty pins.
    v := _fresh(&cs, "_fs")
    out := "({ char *" + v + "; "
    for i := 0; i < len(txt); i += 1:
        piece := "TYCHO_LIT(\"" + txt[i] + "\")"
        if kind[i] == 1:
            toks := lex.tokenize(txt[i])
            he, _hp := parse.expr(toks, 0)
            hc, ht := _ex(&cs, he)
            piece = _tostr(&cs, hc, ht)
        if i == 0:
            out = out + v + " = " + piece + "; "
        else:
            out = out + v + " = tycho_str_concat(" + cs.arena + ", " + v + ", " + piece + "); "
    cs.want = sw
    return (out + v + "; })", "string")

# --- function values --------------------------------------------------------
# A fn value is the same 3-word FAT POINTER src/tychoc.c:13007 emits:
# `{ void *env; RET (*call)(void*, Arena*, P...); void *(*copyenv)(Arena*, void*); }`.
# A reference to a named function has env == 0; a capturing lambda allocates an
# Env in the arena that owns the value and carries a copier so a returned
# closure re-homes its captures. The registry key is "ret|p0|p1|...", the type
# string "F~<index>", stamped exactly as a tuple kind is.
fn _is_fn(t: string) -> bool:
    return strings.starts_with(t, "F~")

fn _fkind(cs: inout C, key: string) -> int:
    for i := 0; i < len(cs.fks); i += 1:
        if cs.fks[i] == key:
            return i
    push(cs.fks, key)
    return len(cs.fks) - 1

fn _fn_of(cs: inout C, ret: string, ps: [string]) -> string:
    k := ret
    for p in ps:
        k = k + "|" + p
    return "F~" + str(_fkind(&cs, k))

fn _fparts(cs: inout C, t: string) -> [string]:
    return split(cs.fks[strings.parse_int(_tname(t))], "|")

fn _fret(cs: inout C, t: string) -> string:
    return _fparts(&cs, t)[0]

fn _fps(cs: inout C, t: string) -> [string]:
    p := _fparts(&cs, t)
    return p[1:len(p)]

# The `<name>__clo` trampoline: one per named function actually taken as a
# value, so an unused function grows no code and an `inout` parameter (which a
# fn value cannot carry) is never wrapped.
fn _need_clo(cs: inout C, fi: int):
    for x in cs.clos:
        if x == cs.fds[fi].name:
            return
    push(cs.clos, cs.fds[fi].name)

fn _clo_defs(cs: inout C) -> (string, string):
    pr := ""
    bd := ""
    for nm in cs.clos:
        fi := _fidx(&cs, nm)
        rt := cs.fds[fi].ret
        sig := _cty(&cs, rt) + " " + nm + "__clo(void *_env, Arena *_parent"
        call := "h_" + nm + "(_parent"
        for j := 0; j < len(cs.fds[fi].ptypes); j += 1:
            sig = sig + ", " + _cty(&cs, cs.fds[fi].ptypes[j]) + " _a" + str(j)
            call = call + ", _a" + str(j)
        sig = sig + ")"
        call = call + ")"
        r := "    return " + call + ";\n"
        if rt == "void":
            r = "    " + call + ";\n"
        pr = pr + sig + ";\n"
        bd = bd + sig + " {\n    (void)_env;\n" + r + "}\n"
    return (pr, bd)

fn _fn_defs(cs: inout C) -> string:
    out := ""
    for i := 0; i < len(cs.fks); i += 1:
        ps := split(cs.fks[i], "|")
        s := "typedef struct { void *env; " + _cty(&cs, ps[0]) + " (*call)(void *, Arena *"
        for j := 1; j < len(ps); j += 1:
            s = s + ", " + _cty(&cs, ps[j])
        out = out + s + "); void *(*copyenv)(Arena *, void *); } FnC" + str(i) + ";\n"
    return out

# A lambda body is one EXPRESSION (parse/parse.ty:310), so the only binder
# inside it is a nested lambda's parameter list -- which is what makes this
# free-variable walk short enough to be trustworthy.
fn _bound(bs: [string], n: string) -> bool:
    for b in bs:
        if b == n:
            return true
    return false

fn _fv(cs: inout C, e: ast.Expr, bs: [string], out: inout [string]):
    match e:
        ast.Name(l, n):
            if _bound(bs, n) or _bound(out, n):
                return
            if len(_vtype(&cs, n)) > 0:
                push(out, n)
        ast.Lambda(l, ps, r, b):
            bs2 := []string
            for x in bs:
                push(bs2, x)
            for p in ps:
                push(bs2, p.name)
            _fv(&cs, b[0], bs2, &out)
        ast.Field(l, k, f): _fv(&cs, k[0], bs, &out)
        ast.TupIdx(l, k, n2): _fv(&cs, k[0], bs, &out)
        ast.Call(l, q, n2, ts, k):
            # `g(f(x))`: f and g are the CALLEE names, and skipping them is the
            # regression tests/closure_fncap.ty pins.
            cn2 := q
            if len(q) == 0:
                cn2 = n2
            if not _bound(bs, cn2) and not _bound(out, cn2) and len(_vtype(&cs, cn2)) > 0:
                push(out, cn2)
            for x in k:
                _fv(&cs, x, bs, &out)
        ast.IsVar(l, k, q, n2): _fv(&cs, k[0], bs, &out)
        ast.EmptyArr(l, t): pass
        ast.EmptyMap(l, t): pass
        ast.SoaLit(l, t): pass
        ast.ChanE(l, t, k):
            for x in k:
                _fv(&cs, x, bs, &out)
        ast.IntLit(l, v): pass
        ast.FloatLit(l, v): pass
        ast.StrLit(l, v): pass
        ast.CharLit(l, v): pass
        ast.BoolLit(l, v): pass
        ast.NullLit(l): pass
        ast.NoneE(l): pass
        ast.FStrLit(l, v):
            txt, kind := _fsplit(v)
            for i := 0; i < len(txt); i += 1:
                if kind[i] == 1:
                    toks := lex.tokenize(txt[i])
                    he, _hp := parse.expr(toks, 0)
                    _fv(&cs, he, bs, &out)
        ast.Index(l, k): _fvs(&cs, k, bs, &out)
        ast.Slice(l, a, b2, k): _fvs(&cs, k, bs, &out)
        ast.CallVal(l, k): _fvs(&cs, k, bs, &out)
        ast.Named(l, n2, k): _fvs(&cs, k, bs, &out)
        ast.Binop(l, o, k): _fvs(&cs, k, bs, &out)
        ast.Unop(l, o, k): _fvs(&cs, k, bs, &out)
        ast.ArrLit(l, k): _fvs(&cs, k, bs, &out)
        ast.MapLit(l, k): _fvs(&cs, k, bs, &out)
        ast.Tuple(l, k): _fvs(&cs, k, bs, &out)
        ast.SomeE(l, k): _fvs(&cs, k, bs, &out)
        ast.OkE(l, k): _fvs(&cs, k, bs, &out)
        ast.ErrE(l, k): _fvs(&cs, k, bs, &out)
        ast.SpawnE(l, k): _fvs(&cs, k, bs, &out)
        ast.OrRet(l, k): _fvs(&cs, k, bs, &out)
        ast.Spread(l, k): _fvs(&cs, k, bs, &out)
        ast.Addr(l, k): _fvs(&cs, k, bs, &out)

fn _fvs(cs: inout C, k: [ast.Expr], bs: [string], out: inout [string]):
    for x in k:
        _fv(&cs, x, bs, &out)

fn _lambda(cs: inout C, ps: [ast.Param], ret: [ast.Ty], body: ast.Expr) -> (string, string):
    # The lambda's own type: an untyped parameter or an omitted return is read
    # off `cs.want`, which is the only place either is written down.
    want := cs.want
    wps := []string
    wr := ""
    if _is_fn(want):
        wps = _fps(&cs, want)
        wr = _fret(&cs, want)
    pts := []string
    for i := 0; i < len(ps); i += 1:
        if len(ps[i].ty) > 0:
            push(pts, _ty(&cs, ps[i].ty[0]))
        elif i < len(wps):
            push(pts, wps[i])
        else:
            _bad("a lambda parameter with no type and nothing to infer it from")
    caps := []string
    pn := []string
    for p in ps:
        push(pn, p.name)
    _fv(&cs, body, pn, &caps)
    cs.tmp += 1
    id := str(cs.tmp)
    capt := []string
    for c in caps:
        push(capt, _vtype(&cs, c))
    # Emit the body against a scope holding ONLY the captures and the params:
    # a lambda cannot see the enclosing function's other locals by construction.
    sv := cs.vnames
    svt := cs.vtypes
    svc := cs.vcn
    svo := cs.vown
    scr := cs.cur_ret
    sar := cs.arena
    cs.vnames = []string
    cs.vtypes = []string
    cs.vcn = []string
    cs.vown = []string
    cs.arena = "&_scope"
    env := ""
    for i := 0; i < len(caps); i += 1:
        _push(&cs, caps[i], capt[i])
        cs.vcn[len(cs.vcn) - 1] = "(_ec->c" + str(i) + ")"
        env = env + "    " + _cty(&cs, capt[i]) + " c" + str(i) + ";\n"
    sig := "(void *_env, Arena *_parent"
    for i := 0; i < len(ps); i += 1:
        cn := _push(&cs, ps[i].name, pts[i])
        sig = sig + ", " + _cty(&cs, pts[i]) + " " + cn
    sig = sig + ")"
    rt := wr
    if len(ret) > 0:
        rt = _ty(&cs, ret[0])
    if len(rt) == 0:
        rt = "?"
    cs.cur_ret = rt
    bc, bt := _ex(&cs, body)
    if rt == "?":
        rt = bt
        cs.cur_ret = rt
    cs.vnames = sv
    cs.vtypes = svt
    cs.vcn = svc
    cs.vown = svo
    cs.cur_ret = scr
    cs.arena = sar
    ft := _fn_of(&cs, rt, pts)
    fid := _tname(ft)
    pre := ""
    if len(caps) > 0:
        pre = "    Env" + id + " *_ec = (Env" + id + " *)_env;\n"
    ret2 := "    return " + _copy(&cs, bc, rt, "_parent") + ";\n"
    if rt == "void":
        ret2 = "    " + bc + ";\n"
    d := ""
    if len(caps) > 0:
        d = "typedef struct { \n" + env + "} Env" + id + ";\n" +
            "static void *Env" + id + "_copy(Arena *_a, void *_p) {\n" +
            "    Env" + id + " *_s = (Env" + id + " *)_p;\n" +
            "    Env" + id + " *_d = (Env" + id + " *)arena_alloc(_a, sizeof(Env" + id + "));\n"
        for i := 0; i < len(caps); i += 1:
            d = d + "    _d->c" + str(i) + " = " + _copy(&cs, "(_s->c" + str(i) + ")", capt[i], "_a") + ";\n"
        d = d + "    return _d;\n}\n"
    d = d + _cty(&cs, rt) + " __lam" + id + "__clo" + sig + " {\n" + pre +
        "    Arena _scope = arena_child(_parent);\n" + ret2 + "}\n"
    push(cs.lamd, d)
    push(cs.lamp, _cty(&cs, rt) + " __lam" + id + "__clo" + sig + ";\n")
    if len(caps) == 0:
        return ("(FnC" + fid + "){0, __lam" + id + "__clo, 0}", ft)
    mk := "({ Env" + id + " *_e = (Env" + id + " *)arena_alloc(" + cs.arena + ", sizeof(Env" + id + "));"
    for i := 0; i < len(caps); i += 1:
        cv := _vcname(&cs, caps[i])
        if _heap(&cs, capt[i]):
            cv = _copy(&cs, cv, capt[i], cs.arena)
        mk = mk + " _e->c" + str(i) + " = " + cv + ";"
    return (mk + " (FnC" + fid + "){_e, __lam" + id + "__clo, Env" + id + "_copy}; })", ft)

fn _ex_scope(cs: inout C, e: ast.Expr) -> (string, string):
    sav := cs.arena
    cs.arena = "&_scope"
    c, t := _ex(&cs, e)
    cs.arena = sav
    return (c, t)

# _tag DIES on an unknown variant, so it cannot be used to ASK whether a name
# is one. This is the asking form.
fn _tagopt(cs: inout C, ei: int, vn: string) -> int:
    for i := 0; i < len(cs.eds[ei].vnames); i += 1:
        if cs.eds[ei].vnames[i] == vn:
            return i
    return -1

fn _tag(cs: inout C, ei: int, vn: string) -> int:
    for i := 0; i < len(cs.eds[ei].vnames); i += 1:
        if cs.eds[ei].vnames[i] == vn:
            return i
    _bad("enum " + cs.eds[ei].name + " has no variant '" + vn + "'")
    return 0

# `levels.DEBUG` and `geom.Red` parse as a FIELD on a name. When that name is an
# imported package and not a local, the member is that package's const or its
# bare variant. Returns ("", "") when the receiver is an ordinary value.
# UFCS across a package boundary: `c.describe()` on a `geom.Circle` reaches
# `geom__describe`, because a method-style call follows its RECEIVER's package
# when the calling package has no such function.
# A subscript has NO runtime object: the call INLINES to the place its body
# yields (spec ROADMAP 2.4). Rather than substituting the AST, each parameter is
# bound as a variable whose C NAME is the argument's already-emitted text, so the
# yielded expression emits against the caller's own values. `lv` picks the place
# form (`*..._ptr`) over the rvalue form (`..._get`), which is the only thing
# that differs between a write through the projection and a read of it.
# `g.edge(1)` parses as CallVal with a Field callee, not as Call -- the same
# split Phase 4 found at src/tychoc.c:4136, where one E_CALL covers both.
fn _subcallval(cs: inout C, k: [ast.Expr], lv: bool) -> (string, string, bool):
    match k[0]:
        ast.Field(l6, r6, f6):
            si := _subidx(&cs, f6)
            if si >= 0:
                ua := []ast.Expr
                push(ua, r6[0])
                for ai := 1; ai < len(k); ai += 1:
                    push(ua, k[ai])
                c, t := _subinline(&cs, si, ua, lv)
                return (c, t, true)
        _: pass
    return ("", "", false)

fn _subidx(cs: inout C, n: string) -> int:
    for i := 0; i < len(cs.subn); i += 1:
        if cs.subn[i] == n:
            return i
    return -1

fn _subinline(cs: inout C, si: int, args: [ast.Expr], lv: bool) -> (string, string):
    ps := cs.subp[si]
    if len(args) != len(ps):
        _bad("subscript '" + cs.subn[si] + "' takes " + str(len(ps)) + " argument(s)")
    nsave := len(cs.vnames)
    for i := 0; i < len(ps); i += 1:
        ac := ""
        at := ""
        if lv and _place(args[i]):
            ac, at = _lvalue(&cs, args[i])
        else:
            ac, at = _ex(&cs, args[i])
        push(cs.vnames, ps[i].name)
        push(cs.vtypes, at)
        push(cs.vcn, ac)
        push(cs.vown, "&_scope")
    inner := cs.sube[si]
    match cs.sube[si]:
        ast.Addr(l, k): inner = k[0]
        _: pass
    rc := ""
    rt := ""
    if lv:
        rc, rt = _lvalue(&cs, inner)
    else:
        rc, rt = _ex(&cs, inner)
    for len(cs.vnames) > nsave:
        pop(cs.vnames)
        pop(cs.vtypes)
        pop(cs.vcn)
        pop(cs.vown)
    return (rc, rt)

fn _ufcs_name(cs: inout C, n: string, rt: string) -> string:
    if _fidx(&cs, n) >= 0:
        return n
    tn := ""
    if _is_struct(rt) or _is_enum(rt):
        tn = _tname(rt)
    if len(tn) == 0:
        return n
    best := ""
    for i := 0; i < len(cs.fpfx); i += 1:
        pf := cs.fpfx[i]
        if len(pf) == 0 or len(pf) > len(tn):
            continue
        if tn[0:len(pf)] != pf or len(pf) <= len(best):
            continue
        if _fidx(&cs, pf + n) >= 0:
            best = pf
    if len(best) == 0:
        return n
    return best + n

fn _pkgmember(cs: inout C, r: ast.Expr, f: string) -> (string, string):
    q := ""
    match r:
        ast.Name(l, nm): q = nm
        _: q = ""
    if len(q) == 0 or len(_vtype(&cs, q)) > 0 or not _ispkg(&cs, q):
        return ("", "")
    pf := _qpfx(&cs, q)
    for i := 0; i < len(cs.cnames); i += 1:
        if cs.cnames[i] == pf + f:
            return (cs.ccode[i], cs.ctypes[i])
    ei := _qvariant(&cs, pf, f)
    if ei >= 0:
        return _variant(&cs, ei, f, []ast.Expr)
    _bad("unknown package member '" + q + "." + f + "'")
    return ("", "")

fn _bare_variant(cs: inout C, n: string) -> int:
    if _is_enum(cs.want):
        w := _eidx(&cs, _tname(cs.want))
        if w >= 0 and not _is_gen(cs.eds[w].name):
            for v in cs.eds[w].vnames:
                if v == n:
                    return w
    return _qvariant(&cs, _pfx(&cs), n)

# A variant name is PACKAGE-scoped: `EmptyInput` in main is a different variant
# from a sibling package's, even spelt the same (tests/pkg/variant_shadow). So
# the search is confined to the enums declared with this prefix.
fn _qvariant(cs: inout C, pfx: string, n: string) -> int:
    for i := 0; i < len(cs.eds); i += 1:
        if cs.edp[i] != pfx:
            continue
        if _is_gen(cs.eds[i].name) or _is_inst(&cs, cs.eds[i].name):
            continue
        for v in cs.eds[i].vnames:
            if v == n:
                return i
    return -1

# An INSTANCE of a generic enum is reachable only through the wanted type or by
# inferring its arguments -- never by a bare variant name, which would otherwise
# resolve `Has("hi")` into whichever instance happened to be stamped first.
fn _is_inst(cs: inout C, n: string) -> bool:
    for i := 0; i < len(cs.iname); i += 1:
        if cs.iname[i] == n:
            return true
    return false

fn _variant(cs: inout C, ei: int, vn: string, args: [ast.Expr]) -> (string, string):
    en := cs.eds[ei].name
    tag := _tag(&cs, ei, vn)
    pay := cs.eds[ei].vpay[tag].ptypes
    if len(pay) != len(args):
        _bad("variant " + vn + " takes " + str(len(pay)) + " payload value(s)")
    if len(pay) == 0:
        return ("(&_sing_" + en + "_" + str(tag) + ")", "E~" + en)
    v := _fresh(&cs, "_v")
    out := "({ E_" + en + " *" + v + " = (E_" + en + " *)arena_alloc(&_scope, offsetof(E_" +
        en + ", u) + sizeof(E_" + en + "_" + vn + ")); " + v + "->tag = " + str(tag) + "; "
    for i := 0; i < len(args); i += 1:
        sw := cs.want
        cs.want = pay[i]
        ac, at := _ex_scope(&cs, args[i])
        cs.want = sw
        if pay[i] == "float" and at == "int":
            ac = "(double)(" + ac + ")"
        if _place(args[i]) and _heap(&cs, pay[i]):
            ac = _copy(&cs, ac, pay[i], "&_scope")
        out = out + v + "->u." + vn + ".f" + str(i) + " = " + ac + "; "
    return (out + v + "; })", "E~" + en)

# `x or_return` -- on the failing tag it returns the SAME failure from the
# enclosing function, rebuilt in the caller's arena because this scope is freed
# on the way out.
fn _orret(cs: inout C, e: ast.Expr) -> (string, string):
    sw := cs.want
    cs.want = ""
    c, t := _ex_scope(&cs, e)
    cs.want = sw
    if not (_is_optT(&cs, t) or _is_resT(&cs, t)):
        _bad("`or_return` on a value that is not an Option or a Result")
    ei := _eidx(&cs, _tname(t))
    rt := cs.cur_ret
    if not (_is_optT(&cs, rt) or _is_resT(&cs, rt)):
        _bad("`or_return` inside a function that returns neither Option nor Result")
    ri := _eidx(&cs, _tname(rt))
    v := _fresh(&cs, "_or")
    r2 := _fresh(&cs, "_or")
    bad := 0
    if _is_resT(&cs, t):
        bad = 1
    rbad := 0
    if _is_resT(&cs, rt):
        rbad = 1
    rn := _tname(rt)
    rvn := cs.eds[ri].vnames[rbad]
    rpay := cs.eds[ri].vpay[rbad].ptypes
    mk := "(&_sing_" + rn + "_" + str(rbad) + ")"
    if len(rpay) > 0:
        src := "(" + v + "->u." + cs.eds[ei].vnames[bad] + ".f0)"
        if len(cs.eds[ei].vpay[bad].ptypes) == 0:
            _bad("`or_return` cannot carry a payload the source variant does not have")
        mk = "({ E_" + rn + " *" + r2 + " = (E_" + rn + " *)arena_alloc(_parent, offsetof(E_" +
            rn + ", u) + sizeof(E_" + rn + "_" + rvn + ")); " + r2 + "->tag = " + str(rbad) +
            "; " + r2 + "->u." + rvn + ".f0 = " + _copy(&cs, src, rpay[0], "_parent") + "; " +
            r2 + "; })"
    ok := cs.eds[ei].vpay[1 - bad].ptypes
    got := "((void)0)"
    gt := "void"
    if len(ok) > 0:
        got = "(" + v + "->u." + cs.eds[ei].vnames[1 - bad] + ".f0)"
        gt = ok[0]
    return ("({ E_" + _tname(t) + " *" + v + " = " + c + "; if (" + v + "->tag == " +
        str(bad) + ") { E_" + rn + " *_orr = " + mk +
        "; arena_free(&_scope); return _orr; } " + got + "; })", gt)

fn _arrlit(cs: inout C, k: [ast.Expr]) -> (string, string):
    if len(k) == 0:
        _bad("an empty array literal needs a type")
    c0, et0 := _ex_scope(&cs, k[0])
    et := et0
    # `a: [u32] = [1, 2]` -- the elements adapt to the ANNOTATED element type,
    # which is the only place it is written down; taking it from element 0 alone
    # would type this [int] and then fail to initialise a TychoArrK.
    if _is_arr(cs.want) and _elem(cs.want) != et0:
        et = _elem(cs.want)
    sw := cs.want
    cs.want = et
    v := _fresh(&cs, "_l")
    ct := _cty(&cs, "[" + et + "]")
    out := "({ " + ct + " " + v + " = " + _apfx(&cs, et) + "_with_cap(&_scope, " +
        str(len(k)) + "LL); "
    for i := 0; i < len(k); i += 1:
        ac := c0
        at2 := et0
        if i > 0:
            ac2, at3 := _ex_scope(&cs, k[i])
            ac = ac2
            at2 = at3
        if at2 != et and not _heap(&cs, et):
            ac = "((" + _cty(&cs, et) + ")(" + ac + "))"
        if _place(k[i]) and _heap(&cs, et):
            ac = _copy(&cs, ac, et, "&_scope")
        out = out + v + ".data[" + str(i) + "] = " + ac + "; "
    cs.want = sw
    return (out + v + ".len = " + str(len(k)) + "LL; " + v + "; })", "[" + et + "]")

fn _maplit(cs: inout C, k: [ast.Expr]) -> (string, string):
    if len(k) < 2:
        _bad("an empty map literal needs a type")
    kc0, kt := _ex_scope(&cs, k[0])
    vc0, vt := _ex_scope(&cs, k[1])
    mt := _map_of(&cs, kt, vt)
    v := _fresh(&cs, "_mp")
    n := len(k) / 2
    out := "({ " + _cty(&cs, mt) + " " + v + " = " + _mpfx(&cs, mt) +
        "_with_cap(&_scope, " + str(n) + "LL); "
    for i := 0; i < len(k); i += 2:
        sw := cs.want
        cs.want = kt
        kc, kct := _ex_scope(&cs, k[i])
        cs.want = vt
        vc, vct := _ex_scope(&cs, k[i + 1])
        cs.want = sw
        if vt == "float" and vct == "int":
            vc = "(double)(" + vc + ")"
        out = out + _mpfx(&cs, mt) + "_put(&_scope, &" + v + ", " +
            _keyrt(&cs, kt, kc) + ", " + vc + "); "
    return (out + v + "; })", mt)

# `m.get(k)` / `m.get(k, default)` reach emit as a call on a field expression;
# the map read is the only receiver method the language has (fn values are 7b's).
fn _mapget(cs: inout C, mc: string, mt: string, args: [ast.Expr]) -> (string, string):
    if len(args) != 1 and len(args) != 2:
        _bad("m.get(key) or m.get(key, default)")
    kc, kct := _ex(&cs, args[0])
    vt := _mval(&cs, mt)
    d := _zero(&cs, vt)
    if len(args) == 2:
        sw := cs.want
        cs.want = vt
        dc, dt := _ex(&cs, args[1])
        cs.want = sw
        if vt == "float" and dt == "int":
            dc = "(double)(" + dc + ")"
        d = dc
    g := _mpfx(&cs, mt) + "_get(" + mc + ", " + _keyrt(&cs, _mkey(&cs, mt), kc) +
        ", " + d + ")"
    return (_copy(&cs, g, vt, cs.arena), vt)

fn _callval(cs: inout C, k: [ast.Expr]) -> (string, string):
    match k[0]:
        ast.Field(l, r, f):
            rt0 := _argtypes(&cs, r)[0]
            if _is_struct(rt0):
                si4 := _sidx(&cs, _tname(rt0))
                for j := 0; j < len(cs.sds[si4].fnames); j += 1:
                    if cs.sds[si4].fnames[j] == f and _is_fn(cs.sds[si4].ftypes[j]):
                        # a fn-typed FIELD is a value call, not UFCS
                        return _callfv(&cs, k)
            if f != "get" or not _is_map(rt0):
                # UFCS: `x.f(a)` is `f(x, a)` for any free function f.
                ua := []ast.Expr
                push(ua, r[0])
                for i := 1; i < len(k); i += 1:
                    push(ua, k[i])
                return _call(&cs, l, "", f, []ast.Ty, ua)
            mc, mt := _ex(&cs, r[0])
            if not _is_map(mt):
                _bad(".get() on a non-map")
            rest := []ast.Expr
            for i := 1; i < len(k); i += 1:
                push(rest, k[i])
            return _mapget(&cs, mc, mt, rest)
        _: pass
    return _callfv(&cs, k)

fn _callfv(cs: inout C, k: [ast.Expr]) -> (string, string):
    fc, ft := _ex(&cs, k[0])
    if not _is_fn(ft):
        _bad("call of a value that is not a function")
    fv := _fresh(&cs, "_fv")
    out := "({ " + _cty(&cs, ft) + " " + fv + " = " + fc + "; " + fv + ".call(" + fv +
        ".env, " + cs.arena
    fps := _fps(&cs, ft)
    sw := cs.want
    for i := 1; i < len(k); i += 1:
        cs.want = ""
        if i - 1 < len(fps):
            cs.want = fps[i - 1]
        ac, at := _rhs2(&cs, k[i], cs.want, cs.arena)
        out = out + ", " + ac
    cs.want = sw
    return (out + "); })", _fret(&cs, ft))

fn _binop(cs: inout C, op: string, ea: ast.Expr, eb: ast.Expr) -> (string, string):
    a, at := _ex(&cs, ea)
    b, bt := _ex(&cs, eb)
    if op == "in":
        if not _is_map(bt):
            _bad("`in` tests membership in a map")
        return (_mpfx(&cs, bt) + "_has(" + b + ", " + _keyrt(&cs, _mkey(&cs, bt), a) + ")", "bool")
    if op == "and":
        return ("(" + a + " && " + b + ")", "bool")
    if op == "or":
        return ("(" + a + " || " + b + ")", "bool")
    if op == "==":
        return (_eq(&cs, a, b, at), "bool")
    if op == "!=":
        return ("(!" + _eq(&cs, a, b, at) + ")", "bool")
    if op == "<" or op == ">" or op == "<=" or op == ">=":
        if at == "string" or at == "bytes":
            return ("(tycho_str_cmp(" + a + ", " + b + ") " + op + " 0)", "bool")
        a, b = _widen(a, at, b, bt)
        return ("(" + a + " " + op + " " + b + ")", "bool")
    # Element-wise array arithmetic, and the scalar BROADCAST form. Shape read
    # from `./tychoc tests/array_arith.ty --emit-c`: a fresh result array in the
    # current arena, filled by one loop, with a length guard on the two-array
    # form. Placed before the scalar operators so `a * b` on arrays never falls
    # through to a C `*` on two structs.
    if op == "*" or op == "/" or op == "%" or op == "+" or op == "-":
        ewa := _is_arr(at)
        ewb := _is_arr(bt)
        if ewa or ewb:
            et := at
            if ewa:
                et = _elem(at)
            else:
                et = _elem(bt)
            ct := ""
            if ewa:
                ct = _cty(&cs, at)
            else:
                ct = _cty(&cs, bt)
            ce := _cty(&cs, et)
            va := _fresh(&cs, "_ewa")
            vb := _fresh(&cs, "_ewb")
            vr := _fresh(&cs, "_ewr")
            vi := _fresh(&cs, "_ewi")
            hd := ""
            ln := ""
            lhs := ""
            rhs := ""
            if ewa and ewb:
                hd = ct + " " + va + " = (" + a + "); " + ct + " " + vb + " = (" + b + ");\n" +
                    "   if (" + va + ".len != " + vb + ".len) tycho_ew_len(" + va + ".len, " + vb + ".len);\n"
                ln = va + ".len"
                lhs = va + ".data[" + vi + "]"
                rhs = vb + ".data[" + vi + "]"
            elif ewa:
                hd = ct + " " + va + " = (" + a + "); " + ce + " " + vb + " = (" + b + ");\n"
                ln = va + ".len"
                lhs = va + ".data[" + vi + "]"
                rhs = vb
            else:
                hd = ce + " " + va + " = (" + a + "); " + ct + " " + vb + " = (" + b + ");\n"
                ln = vb + ".len"
                lhs = va
                rhs = vb + ".data[" + vi + "]"
            rt2 := "[" + et + "]"
            return ("({ " + hd +
                "   " + ct + " " + vr + "; " + vr + ".len = " + ln + "; " + vr + ".cap = " + ln + ";\n" +
                "   " + vr + ".data = " + vr + ".len ? (" + ce + " *)arena_alloc(" + cs.arena +
                ", (size_t)" + vr + ".len * sizeof(" + ce + " )) : 0;\n" +
                "   for (tycho_int " + vi + " = 0; " + vi + " < " + vr + ".len; " + vi + "++) " +
                vr + ".data[" + vi + "] = (" + lhs + " " + op + " " + rhs + ");\n" +
                "   " + vr + "; })", rt2)
    if op == "+" and (at == "string" or at == "bytes"):
        if bt == "char":
            return ("tycho_str_concat_char(" + cs.arena + ", " + a + ", " + b + ")", "string")
        return ("tycho_str_concat(" + cs.arena + ", " + a + ", " + b + ")", "string")
    if op == "/" and at == "int" and bt == "int":
        return ("tycho_idiv(" + a + ", " + b + ")", "int")
    if op == "%" and at == "int" and bt == "int":
        return ("tycho_imod(" + a + ", " + b + ")", "int")
    if op == "+" or op == "-" or op == "*" or op == "/" or op == "%":
        rt := _num2(at, bt)
        a, b = _widen(a, at, b, bt)
        if rt == "char":
            # char is one byte, so its arithmetic stays 0..255 -- src/tychoc.c:10709
            return ("((tycho_int)(unsigned char)(" + a + " " + op + " " + b + "))", rt)
        if _is_sized(rt):
            return ("((" + _cty(&cs, rt) + ")(" + a + " " + op + " " + b + "))", rt)
        return ("(" + a + " " + op + " " + b + ")", rt)
    if op == "<<" or op == ">>":
        # A count >= the operand's width is 0 and a negative one aborts, neither
        # of which C gives -- runtime/tycho_rt.c:250 onwards owns both.
        st := "int"
        if _is_sized(at):
            st = at
        f := "tycho_shl_i"
        if op == ">>":
            f = "tycho_shr_i"
        if st == "u32" or st == "u64":
            f = "tycho_shl_" + st
            if op == ">>":
                f = "tycho_shr_" + st
            return ("(" + f + "(" + a + ", " + b + "))", st)
        if _is_sized(st):
            sg := "0"
            if _is_sint(st):
                sg = "1"
            if op == "<<":
                return ("((" + _cty(&cs, st) + ")tycho_shln(" + a + ", " + b + ", " + str(_width(st)) + "))", st)
            return ("((" + _cty(&cs, st) + ")tycho_shrn(" + a + ", " + b + ", " + str(_width(st)) + ", " + sg + "))", st)
        return ("(" + f + "(" + a + ", " + b + "))", "int")
    if op == "&" or op == "|" or op == "^":
        bt2 := "int"
        if _is_sized(at):
            bt2 = at
        elif _is_sized(bt):
            bt2 = bt
        if _is_sized(bt2):
            return ("((" + _cty(&cs, bt2) + ")(" + a + " " + op + " " + b + "))", bt2)
        return ("(" + a + " " + op + " " + b + ")", "int")
    _bad("unsupported operator '" + op + "'")
    return ("", "")

fn _widen(a: string, at: string, b: string, bt: string) -> (string, string):
    if at == "float" and bt != "float":
        return (a, "(double)(" + b + ")")
    if bt == "float" and at != "float":
        return ("(double)(" + a + ")", b)
    return (a, b)

# --- calls ------------------------------------------------------------------

fn _call(cs: inout C, l: int, q: string, n: string, tas: [ast.Ty], args: [ast.Expr]) -> (string, string):
    if len(q) > 0:
        # `m.get(k)` lexes as a qualifier-dot-name call; a local of map type
        # named `m` is the map-read, not a package.
        qt := _vtype(&cs, q)
        if n == "get" and _is_map(qt):
            return _mapget(&cs, _vcname(&cs, q), qt, args)
        if _is_struct(qt):
            si3 := _sidx(&cs, _tname(qt))
            for j := 0; j < len(cs.sds[si3].fnames); j += 1:
                if cs.sds[si3].fnames[j] == n and _is_fn(cs.sds[si3].ftypes[j]):
                    kk2 := []ast.Expr
                    push(kk2, ast.Field(l, [ast.Name(l, q)], n))
                    for a in args:
                        push(kk2, a)
                    return _callval(&cs, kk2)
        if len(qt) > 0:
            # UFCS: `x.f(a)` on a local value is `f(x, a)`.
            ua := []ast.Expr
            push(ua, ast.Name(l, q))
            for a in args:
                push(ua, a)
            # `g.edge(1)` where edge is a subscript inlines to its yielded place.
            sxi := _subidx(&cs, n)
            if sxi >= 0:
                return _subinline(&cs, sxi, ua, false)
            return _call(&cs, l, "", _ufcs_name(&cs, n, qt), tas, ua)
        if _ispkg(&cs, q):
            qv := _qvariant(&cs, _qpfx(&cs, q), n)
            if qv >= 0:
                return _variant(&cs, qv, n, args)
            return _call(&cs, l, "", _qpfx(&cs, q) + n, tas, args)
        _bad("package-qualified call '" + q + "." + n + "' -- Phase 8")
    if _is_fn(_vtype(&cs, n)):
        # `f(5)` where f is a LOCAL of fn type: the parser cannot tell this from
        # a named call, so the local wins here exactly as it does for a map.
        kk := []ast.Expr
        push(kk, ast.Name(l, n))
        for a in args:
            push(kk, a)
        return _callval(&cs, kk)
    ta := []string
    for t in tas:
        push(ta, _ty(&cs, t))
    if n == "zero" and len(ta) == 1 and len(args) == 0:
        return (_zero(&cs, ta[0]), ta[0])
    gfi := _gfidx(&cs, n)
    if gfi >= 0:
        tps := cs.gf[gfi].typarams
        bs := ta
        if len(bs) < len(tps):
            bs = _blank(len(tps))
            for j := 0; j < len(ta); j += 1:
                bs[j] = ta[j]
            ats := _argtypes(&cs, args)
            for j := 0; j < len(cs.gf[gfi].params) and j < len(ats); j += 1:
                if len(cs.gf[gfi].params[j].ty) > 0:
                    _unify(&cs, cs.gf[gfi].params[j].ty[0], ats[j], tps, &bs)
        for j := 0; j < len(bs); j += 1:
            if len(bs[j]) == 0:
                _bad("cannot infer '$" + tps[j] + "' at a call to '" + n + "'")
        fj := _inst_fn(&cs, n, bs)
        return _call(&cs, l, "", cs.fds[fj].name, []ast.Ty, args)
    gsi := _gsidx(&cs, n)
    if gsi >= 0:
        tps2 := cs.gs[gsi].typarams
        bs2 := ta
        if len(bs2) < len(tps2):
            bs2 = _blank(len(tps2))
            for j := 0; j < len(ta); j += 1:
                bs2[j] = ta[j]
            if _is_struct(cs.want) and _inst_base(&cs, _tname(cs.want)) == n:
                wa := _inst_of(&cs, _tname(cs.want))
                for j := 0; j < len(bs2) and j < len(wa); j += 1:
                    if len(bs2[j]) == 0:
                        bs2[j] = wa[j]
            ats2 := _argtypes(&cs, _reorder(&cs, _fieldnames(&cs, gsi), args, n))
            for j := 0; j < len(cs.gs[gsi].fields) and j < len(ats2); j += 1:
                _unify(&cs, cs.gs[gsi].fields[j].ty, ats2[j], tps2, &bs2)
        for j := 0; j < len(bs2); j += 1:
            if len(bs2[j]) == 0:
                _bad("cannot infer '$" + tps2[j] + "' constructing '" + n + "'")
        it := _inst_struct(&cs, n, bs2)
        return _call(&cs, l, "", _tname(it), []ast.Ty, args)
    gei := _geidx(&cs, n)
    if gei >= 0:
        _bad("a generic enum is named by a variant, not by the enum")
    ni := _ntidx(&cs, n)
    if ni >= 0:
        if len(args) != 1:
            _bad("newtype " + n + " takes exactly one value")
        ac, at := _ex(&cs, args[0])
        u := cs.ntu[ni]
        if u == "float" and at == "int":
            ac = "(double)(" + ac + ")"
        return (ac, u)
    ei := _bare_variant(&cs, n)
    if ei >= 0:
        return _variant(&cs, ei, n, args)
    gv := _gen_variant(&cs, n, ta, args)
    if len(gv) > 0:
        return _variant(&cs, _eidx(&cs, _tname(gv)), n, args)
    si := _sidx(&cs, n)
    if si >= 0:
        sn := cs.sds[si].name
        args = _reorder(&cs, cs.sds[si].fnames, args, n)
        if len(args) != len(cs.sds[si].ftypes):
            _bad("struct " + n + " takes " + str(len(cs.sds[si].ftypes)) + " field(s)")
        out := "((S_" + sn + "){ "
        for i := 0; i < len(args); i += 1:
            ft := cs.sds[si].ftypes[i]
            sw := cs.want
            cs.want = ft
            ac, at := _ex_scope(&cs, args[i])
            cs.want = sw
            if _place(args[i]) and _heap(&cs, ft):
                ac = _copy(&cs, ac, ft, "&_scope")
            if i > 0:
                out = out + ", "
            out = out + ac
        return (out + " })", "S~" + sn)
    if len(tas) > 0:
        _bad("explicit type arguments -- Phase 8")
    fi := _fidx(&cs, n)
    if fi >= 0 and not _shadowable(n):
        np := len(cs.fds[fi].ptypes)
        args = _reorder(&cs, cs.fds[fi].pnames, args, n)
        if cs.fds[fi].pvar:
            if len(args) < np - 1:
                _bad("'" + n + "' takes at least " + str(np - 1) + " argument(s)")
        else:
            if len(args) != np:
                _bad("'" + n + "' takes " + str(np) + " argument(s)")
        out2 := "h_" + cs.fds[fi].name + "(" + cs.arena
        xtn := _isext(&cs, cs.fds[fi].name)
        if xtn:
            out2 = cs.fds[fi].name + "(@"
        for i := 0; i < np; i += 1:
            pt := cs.fds[fi].ptypes[i]
            if cs.fds[fi].pvar and i == np - 1:
                out2 = out2 + ", " + _pack(&cs, _elem(pt), args, i)
                continue
            if cs.fds[fi].pinout[i]:
                out2 = out2 + ", " + _addr_of(&cs, args[i])
                if _heap(&cs, pt):
                    out2 = out2 + ", " + _ownerof(&cs, args[i])
                continue
            sw := cs.want
            cs.want = pt
            ac, at := _ex(&cs, args[i])
            cs.want = sw
            if pt == "float" and at == "int":
                ac = "(double)(" + ac + ")"
            if _place(args[i]) and _heap(&cs, pt):
                ac = _copy(&cs, ac, pt, "&_scope")
            out2 = out2 + ", " + ac
        if xtn:
            # drop the separator the arena would have needed
            out2 = strings.replace(out2, "(@, ", "(")
            out2 = strings.replace(out2, "(@", "(")
            if cs.fds[fi].ret == "bytes":
                ov := _fresh(&cs, "_o")
                ol := _fresh(&cs, "_ol")
                sep2 := ", "
                if strings.ends_with(out2, "("):
                    sep2 = ""
                return ("({ unsigned char *" + ov + " = 0; tycho_int " + ol + " = 0; " +
                    out2 + sep2 + "&" + ov + ", &" + ol + "); tycho_bytes_from_c(" +
                    cs.arena + ", " + ov + ", " + ol + "); })", "bytes")
        return (out2 + ")", cs.fds[fi].ret)
    return _builtin(&cs, n, args)

# An `inout` argument is written `&place` at the call and is a pointer in the
# ABI, so the place is taken as an lvalue rather than read.
# A variant name that belongs to a GENERIC enum template: the instance is the
# wanted type when there is one, otherwise it is inferred from the payload.
fn _gen_variant(cs: inout C, n: string, ta: [string], args: [ast.Expr]) -> string:
    for gi := 0; gi < len(cs.ge); gi += 1:
        vi := -1
        for j := 0; j < len(cs.ge[gi].variants); j += 1:
            if cs.ge[gi].variants[j].name == n:
                vi = j
        if vi < 0:
            continue
        tps := cs.ge[gi].typarams
        if _is_enum(cs.want) and _inst_base(&cs, _tname(cs.want)) == cs.ge[gi].name:
            return cs.want
        bs := _blank(len(tps))
        for j := 0; j < len(ta) and j < len(bs); j += 1:
            bs[j] = ta[j]
        ats := _argtypes(&cs, args)
        pl := cs.ge[gi].variants[vi].payload
        for j := 0; j < len(pl) and j < len(ats); j += 1:
            _unify(&cs, pl[j], ats[j], tps, &bs)
        ok := true
        for j := 0; j < len(bs); j += 1:
            if len(bs[j]) == 0:
                ok = false
        if not ok:
            continue
        return _inst_enum(&cs, cs.ge[gi].name, bs)
    return ""

fn _fieldnames(cs: inout C, gi: int) -> [string]:
    out := []string
    for f in cs.gs[gi].fields:
        push(out, f.name)
    return out

# The concrete type of each argument, computed by walking it with no `want`.
# The walk is pure string building, so doing it again for the real emission
# costs only temp numbers.
fn _argtypes(cs: inout C, args: [ast.Expr]) -> [string]:
    out := []string
    sw := cs.want
    cs.want = ""
    for a in args:
        match a:
            ast.NoneE(l): push(out, "")
            ast.OkE(l, k): push(out, "")
            ast.ErrE(l, k): push(out, "")
            ast.EmptyArr(l, ts):
                if len(ts) == 0:
                    push(out, "")
                else:
                    ac, at := _ex(&cs, a)
                    push(out, at)
            ast.Named(l, nm, k):
                ac2, at2 := _ex(&cs, k[0])
                push(out, at2)
            _:
                ac3, at3 := _ex(&cs, a)
                push(out, at3)
    cs.want = sw
    return out

fn _addr_of(cs: inout C, e: ast.Expr) -> string:
    match e:
        ast.Addr(l, k):
            lc, lt := _lvalue(&cs, k[0])
            return "&(" + lc + ")"
        _:
            lc2, lt2 := _lvalue(&cs, e)
            return "&(" + lc2 + ")"
    return ""

# A variadic tail is packed into a fresh array; `xs...` passes one through.
fn _pack(cs: inout C, et: string, args: [ast.Expr], from: int) -> string:
    if len(args) == from + 1:
        match args[from]:
            ast.Spread(l, k):
                sc, st := _ex(&cs, k[0])
                return sc
            _: pass
    v := _fresh(&cs, "_va")
    n := len(args) - from
    out := "({ " + _cty(&cs, "[" + et + "]") + " " + v + " = " + _apfx(&cs, et) +
        "_with_cap(&_scope, " + str(n) + "LL); "
    for i := from; i < len(args); i += 1:
        sw := cs.want
        cs.want = et
        ac, at := _ex_scope(&cs, args[i])
        cs.want = sw
        if et == "float" and at == "int":
            ac = "(double)(" + ac + ")"
        if _place(args[i]) and _heap(&cs, et):
            ac = _copy(&cs, ac, et, "&_scope")
        out = out + v + ".data[" + str(i - from) + "] = " + ac + "; "
    return out + v + ".len = " + str(n) + "LL; " + v + "; })"

# A `name: value` argument is positional once the declared names are known.
fn _reorder(cs: inout C, names: [string], args: [ast.Expr], who: string) -> [ast.Expr]:
    any := false
    for a in args:
        match a:
            ast.Named(l, n, k): any = true
            _: pass
    if not any:
        return args
    out := []ast.Expr
    for i := 0; i < len(names); i += 1:
        push(out, ast.NullLit(0))
    seen := []bool
    for i := 0; i < len(names); i += 1:
        push(seen, false)
    for i := 0; i < len(args); i += 1:
        match args[i]:
            ast.Named(l, n, k):
                j := -1
                for q := 0; q < len(names); q += 1:
                    if names[q] == n:
                        j = q
                if j < 0:
                    _bad("'" + who + "' has no parameter named '" + n + "'")
                out[j] = k[0]
                seen[j] = true
            _:
                out[i] = args[i]
                seen[i] = true
    for i := 0; i < len(names); i += 1:
        if not seen[i]:
            _bad("'" + who + "' is missing an argument for '" + names[i] + "'")
    return out

fn _shadowable(n: string) -> bool:
    return n == "str" or n == "len" or n == "print" or n == "println" or n == "eprint" or
        n == "die" or n == "exit" or n == "push" or n == "pop" or n == "reserve" or
        n == "chr" or n == "to_char" or n == "char_at" or n == "to_int" or
        n == "to_float" or n == "sqrt" or n == "find" or n == "split" or
        n == "substr" or n == "input" or n == "read_all" or n == "clock" or n == "hash" or
        n == "fabs" or n == "list_dir" or n == "getenv"

# push/pop/reserve MUTATE their first argument, so it has to be reached as a
# place: `push(m["g"], 3)` on a map element is the map's value slot, not the
# copy a read would hand back.
fn _target(cs: inout C, e: ast.Expr) -> (string, string):
    if _place(e):
        return _lvalue(&cs, e)
    return _ex(&cs, e)

fn _builtin(cs: inout C, n: string, args: [ast.Expr]) -> (string, string):
    if n == "str" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return (_tostr(&cs, c, t), "string")
    if n == "len" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        if t == "string" or t == "bytes":
            return ("tycho_str_len(" + c + ")", "int")
        if _is_arr(t) or _is_map(t) or _is_soa(t):
            return ("((" + c + ").len)", "int")
        _bad("len() of unsupported type '" + t + "'")
    if n == "print" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("tycho_print_s(" + c + ")", "void")
    if n == "println" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("(tycho_print_s(" + c + "), tycho_print(\"\\n\"))", "void")
    if n == "eprint" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("tycho_eprint(" + c + ")", "void")
    if n == "die" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("tycho_die(" + c + ")", "void")
    if n == "exit" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("exit((int)(" + c + "))", "void")
    if n == "push" and len(args) == 2:
        rc, rt := _target(&cs, args[0])
        # The value is emitted under the target's ELEMENT type, so a bare
        # `None`/`Ok` in `push(xs, None)` knows which Option/Result it belongs
        # to. Without it the element type is only discoverable from the value,
        # which a bare None does not carry.
        swp := cs.want
        if _is_arr(rt):
            cs.want = _elem(rt)
        elif _is_soa(rt):
            cs.want = _selem(&cs, rt)
        vc, vt := _ex_scope(&cs, args[1])
        cs.want = swp
        if strings.starts_with(rt, "?A"):
            pi := strings.parse_int(rt[2:])
            rt = "[" + vt + "]"
            cs.ptv[pi] = rt
            _vset(&cs, _rootname(args[0]), rt)
        if _is_soa(rt):
            return (_spfx(&cs, rt) + "_push(" + _ownerof(&cs, args[0]) + ", &(" + rc +
                "), " + vc + ")", "void")
        if not _is_arr(rt):
            _bad("push() on a non-array")
        et := _elem(rt)
        if et == "float" and vt == "int":
            vc = "(double)(" + vc + ")"
        ow := _ownerof(&cs, args[0])
        if _place(args[1]) and _heap(&cs, et):
            vc = _copy(&cs, vc, et, ow)
        return (_apfx(&cs, et) + "_push(" + ow + ", &(" + rc + "), " + vc + ")", "void")
    if n == "pop" and len(args) == 1:
        rc, rt := _target(&cs, args[0])
        if _is_soa(rt):
            return (_spfx(&cs, rt) + "_pop(&(" + rc + "))", _selem(&cs, rt))
        if not _is_arr(rt):
            _bad("pop() on a non-array")
        et := _elem(rt)
        return (_apfx(&cs, et) + "_pop(" + _ownerof(&cs, args[0]) + ", &(" + rc + "))", et)
    if n == "keys" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        if not _is_map(t):
            _bad("keys() takes a map")
        kt := _mkey(&cs, t)
        return (_mpfx(&cs, t) + "_keys(" + cs.arena + ", " + c + ")", "[" + kt + "]")
    if n == "reserve" and len(args) == 2:
        rc, rt := _target(&cs, args[0])
        vc, vt := _ex(&cs, args[1])
        ow2 := _ownerof(&cs, args[0])
        if _is_map(rt):
            return (_mpfx(&cs, rt) + "_reserve(" + ow2 + ", &(" + rc + "), " + vc + ")", "void")
        if not _is_arr(rt):
            _bad("reserve() on a non-array")
        return (_apfx(&cs, _elem(rt)) + "_reserve(" + ow2 + ", &(" + rc + "), " + vc + ")", "void")
    if n == "chr" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("tycho_chr(" + cs.arena + ", " + c + ")", "string")
    if n == "to_char" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("((tycho_int)(unsigned char)tycho_chr(" + cs.arena + ", " + c + ")[0])", "char")
    if n == "char_at" and len(args) == 2:
        c, t := _ex(&cs, args[0])
        ic, it := _ex(&cs, args[1])
        return ("tycho_str_get(" + c + ", " + ic + ")", "char")
    if (n == "to_under" or n == "to_str" or n == "to_bool") and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return (c, t)
    if n == "to_int" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        if t == "float" or t == "f32":
            return ("tycho_f2i(" + c + ")", "int")
        return ("((tycho_int)(" + c + "))", "int")
    if len(n) > 3 and n[0:3] == "to_" and _is_sized(n[3:]) and len(args) == 1:
        c, t := _ex(&cs, args[0])
        w := n[3:]
        if t == "float" or t == "f32":
            if w == "f32":
                return ("((float)(" + c + "))", "f32")
            return ("((" + _cty(&cs, w) + ")tycho_f2i(" + c + "))", w)
        return ("((" + _cty(&cs, w) + ")(" + c + "))", w)
    if n == "to_bytes" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        if _is_arr(t):
            # [int] -> bytes is a real conversion (each element & 0xFF);
            # string -> bytes is the same buffer -- src/tychoc.c:10618
            return ("tycho_bytes_from_intarr(" + cs.arena + ", " + c + ")", "bytes")
        return (c, "bytes")
    if n == "to_float" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("((double)(" + c + "))", "float")
    if n == "sqrt" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("sqrt(" + c + ")", "float")
    if n == "fabs" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("fabs(" + c + ")", "float")
    if n == "list_dir" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("tycho_list_dir(" + cs.arena + ", " + c + ")", "[string]")
    if n == "getenv" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("tycho_getenv(" + cs.arena + ", " + c + ")", "string")
    if n == "find" and len(args) == 2:
        c, t := _ex(&cs, args[0])
        sc, st := _ex(&cs, args[1])
        return ("tycho_str_find(" + c + ", " + sc + ")", "int")
    if n == "split" and len(args) == 2:
        c, t := _ex(&cs, args[0])
        sc, st := _ex(&cs, args[1])
        return ("tycho_str_split(" + cs.arena + ", " + c + ", " + sc + ")", "[string]")
    if n == "substr" and len(args) == 3:
        c, t := _ex(&cs, args[0])
        ac, at := _ex(&cs, args[1])
        bc, bt := _ex(&cs, args[2])
        return ("tycho_str_substr(" + cs.arena + ", " + c + ", " + ac + ", " + bc + ")", "string")
    if n == "input" and len(args) == 0:
        return ("tycho_input(" + cs.arena + ")", "string")
    if n == "read_all" and len(args) == 0:
        return ("tycho_read_all(" + cs.arena + ")", "string")
    if n == "args" and len(args) == 0:
        return ("tycho_args(" + cs.arena + ")", "[string]")
    if n == "now" and len(args) == 0:
        return ("tycho_now()", "int")
    if n == "read_file" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("tycho_read_file(" + cs.arena + ", " + c + ")", "string")
    if n == "write_file" and len(args) == 2:
        c, t := _ex(&cs, args[0])
        d, dt := _ex(&cs, args[1])
        return ("tycho_write_file(" + c + ", " + d + ")", "int")
    if n == "clock" and len(args) == 0:
        return ("tycho_clock()", "int")
    _bad("unsupported call '" + n + "' with " + str(len(args)) + " argument(s)")
    return ("", "")

# --- places (assignment targets) --------------------------------------------

fn _lvalue(cs: inout C, e: ast.Expr) -> (string, string):
    match e:
        ast.Name(l, n):
            t := _vtype(&cs, n)
            if len(t) == 0:
                _bad("assignment to unknown name '" + n + "'")
            return (_vcname(&cs, n), t)
        ast.Field(l, r, f):
            # The scatter write `ps[i].x = v`. The projection is already a C
            # lvalue, so the read and write paths emit the same expression.
            match r[0]:
                ast.Index(l3, k3):
                    bc3, bt3 := _lvalue(&cs, k3[0])
                    if _is_soa(bt3):
                        ic4, it4 := _ex(&cs, k3[1])
                        return _soafld(&cs, bc3, bt3, ic4, f)
                _: pass
            rc, rt := _lvalue(&cs, r[0])
            si := _sidx(&cs, _tname(rt))
            if si < 0:
                _bad("field assignment on a non-struct")
            for i := 0; i < len(cs.sds[si].fnames); i += 1:
                if cs.sds[si].fnames[i] == f:
                    return ("((" + rc + ").f_" + f + ")", cs.sds[si].ftypes[i])
            _bad("no field '" + f + "' on " + _tname(rt))
        ast.TupIdx(l, k, n):
            rc, rt := _lvalue(&cs, k[0])
            if not _is_tup(rt):
                _bad("`.` assignment on a non-tuple")
            es := _telems(&cs, rt)
            return ("((" + rc + ").f" + str(n) + ")", es[n])
        ast.Index(l, k):
            rc, rt := _lvalue(&cs, k[0])
            ic, it := _ex(&cs, k[1])
            if _is_map(rt):
                vt := _mval(&cs, rt)
                return ("(*" + _mpfx(&cs, rt) + "_slotptr(" + _ownerof(&cs, k[0]) + ", &(" + rc + "), " +
                    _keyrt(&cs, _mkey(&cs, rt), ic) + "))", vt)
            if not _is_arr(rt):
                _bad("indexed assignment on a non-array")
            et := _elem(rt)
            return ("(*" + _apfx(&cs, et) + "_ptr(&(" + rc + "), " + ic + "))", et)
        ast.Call(l, q, n, tas, args):
            # A subscript call IS a place: `g.edge(1).weight = 99` writes
            # through the projection, so the lvalue path inlines it too.
            sxl := _subidx(&cs, n)
            if sxl < 0:
                _bad("unsupported assignment target")
            ua2 := []ast.Expr
            if len(q) > 0:
                push(ua2, ast.Name(l, q))
            for a in args:
                push(ua2, a)
            return _subinline(&cs, sxl, ua2, true)
        ast.CallVal(l, k):
            sc2, st4, ok4 := _subcallval(&cs, k, true)
            if not ok4:
                _bad("unsupported assignment target")
            return (sc2, st4)
        _: _bad("unsupported assignment target")
    return ("", "")

# --- statements -------------------------------------------------------------

fn _rhs(cs: inout C, e: ast.Expr, want: string) -> (string, string):
    return _rhs2(&cs, e, want, "&_scope")

fn _rhs2(cs: inout C, e: ast.Expr, want: string, arena: string) -> (string, string):
    sw := cs.want
    cs.want = want
    c, t := _ex(&cs, e)
    cs.want = sw
    if _place(e) and _heap(&cs, t):
        c = _copy(&cs, c, t, arena)
    if len(want) > 0 and want == "float" and t == "int":
        c = "(double)(" + c + ")"
        t = "float"
    return (c, t)

fn _block(cs: inout C, body: [ast.Stmt], ind: string) -> string:
    m := _mark(&cs)
    out := ""
    for s in body:
        out = out + _stmt(&cs, s, ind)
    _restore(&cs, m)
    return out

fn _stmt(cs: inout C, s: ast.Stmt, ind: string) -> string:
    match s:
        ast.PassS(l):
            return ind + ";\n"
        ast.ExprStmt(l, es):
            sav := cs.arena
            sw := cs.want
            cs.want = ""
            cs.arena = "&_t"
            c, t := _ex(&cs, es[0])
            cs.arena = sav
            cs.want = sw
            return ind + "{ Arena _t = arena_new(0); " + c + "; arena_free(&_t); }\n"
        ast.Decl(l, n, ann, rhs, vv):
            if len(vv) > 0:
                # `x := if c: a else: b` -- declare the variable, then run the
                # control statement with every value tail rewritten to assign it.
                t0 := ""
                if len(ann) > 0:
                    t0 = _ty(&cs, ann[0])
                if len(t0) == 0:
                    t0 = "?"
                cn0 := _push(&cs, n, t0)
                slot := len(cs.vnames) - 1
                body := _stmt(&cs, parse.rewrite_tails(vv[0], "assign", n, []ast.Expr), ind)
                if cs.vtypes[slot] == "?":
                    _bad("a value-if/value-match with no value tail to type it")
                return ind + _cty(&cs, cs.vtypes[slot]) + " " + cn0 + ";\n" + body
            want := ""
            if len(ann) > 0:
                want = _ty(&cs, ann[0])
            if len(rhs) == 0:
                _bad("a declaration with no initialiser")
            if len(ann) == 0 and not _is_arr(cs.want):
                # `out := []` -- the element type comes from the first push into
                # it, which is only known once the rest of the body is walked.
                # The declaration is emitted with a placeholder and patched in
                # _fnbody, the same shape the value-if declaration uses.
                match rhs[0]:
                    ast.EmptyArr(l2, ts):
                        if len(ts) == 0:
                            cs.tmp += 1
                            kk := cs.tmp
                            push(cs.pk, kk)
                            push(cs.ptv, "")
                            cnp := _push(&cs, n, "?A" + str(len(cs.pk) - 1))
                            return ind + "_PT" + str(kk) + " " + cnp + " = _PE" + str(kk) + ";\n"
                    _: pass
            c, t := _rhs(&cs, rhs[0], want)
            if len(want) > 0:
                t = want
            cn := _push(&cs, n, t)
            return ind + _cty(&cs, t) + " " + cn + " = " + c + ";\n"
        ast.ConstS(l, n, k):
            c, t := _ex(&cs, k[0])
            cn2 := _push(&cs, n, t)
            return ind + _cty(&cs, t) + " " + cn2 + " = " + c + ";\n"
        ast.Assign(l, n, k):
            t := _vtype(&cs, n)
            if len(t) == 0:
                _bad("assignment to unknown name '" + n + "'")
            if t == "?":
                t = ""
            rc, rt := _rhs(&cs, k[0], t)
            if len(t) == 0:
                _vset(&cs, n, rt)
            return ind + _vcname(&cs, n) + " = " + rc + ";\n"
        ast.PlaceSet(l, k):
            # `m[f()] += 1` desugars to `m[f()] = m[f()] + 1` with the SAME key
            # node on both sides; hoist a side-effecting key into a temp so it
            # is evaluated exactly once, as src/tychoc.c does.
            lhs := k[0]
            rhs := k[1]
            pre := ""
            match lhs:
                ast.Index(l2, ix):
                    if not _simple(ix[1]):
                        kc0, kt0 := _ex(&cs, ix[1])
                        cs.tmp += 1
                        kn := "_mk" + str(cs.tmp)
                        cn3 := _push(&cs, kn, kt0)
                        pre = ind + _cty(&cs, kt0) + " " + cn3 + " = " + kc0 + ";\n"
                        nk := ast.Name(l2, kn)
                        lhs = ast.Index(l2, [ix[0], nk])
                        match rhs:
                            ast.Binop(l3, op3, bk):
                                match bk[0]:
                                    ast.Index(l4, ix2):
                                        rhs = ast.Binop(l3, op3, [ast.Index(l4, [ix2[0], nk]), bk[1]])
                                    _: pass
                            _: pass
                _: pass
            k = [lhs, rhs]
            match k[0]:
                ast.Index(l5, k5):
                    bc5, bt5 := _lvalue(&cs, k5[0])
                    if _is_soa(bt5):
                        ic5, it5 := _ex(&cs, k5[1])
                        ow5 := _ownerof(&cs, k5[0])
                        sav5 := cs.arena
                        cs.arena = ow5
                        vc5, vt5 := _rhs2(&cs, k[1], _selem(&cs, bt5), ow5)
                        cs.arena = sav5
                        return pre + ind + _spfx(&cs, bt5) + "_set(" + ow5 + ", &(" +
                            bc5 + "), " + ic5 + ", " + vc5 + ");\n"
                _: pass
            lc, lt := _lvalue(&cs, k[0])
            ow := _ownerof(&cs, k[0])
            sav2 := cs.arena
            cs.arena = ow
            rc2, rt2 := _rhs2(&cs, k[1], lt, ow)
            cs.arena = sav2
            return pre + ind + lc + " = " + rc2 + ";\n"
        ast.ReturnS(l, k):
            if len(k) == 0:
                return ind + "{ arena_free(&_scope); return; }\n"
            sw := cs.want
            cs.want = cs.cur_ret
            c, t := _ex(&cs, k[0])
            cs.want = sw
            rt := cs.cur_ret
            if rt == "float" and t == "int":
                c = "(double)(" + c + ")"
            c = _copy(&cs, c, rt, "_parent")
            v := _fresh(&cs, "_ret")
            return ind + "{ " + _cty(&cs, rt) + " " + v + " = " + c +
                "; arena_free(&_scope); return " + v + "; }\n"
        ast.BreakS(l):
            return ind + "break;\n"
        ast.ContinueS(l):
            return ind + "continue;\n"
        ast.IfS(l, c, b, e):
            cc, ct := _ex(&cs, c[0])
            out := ind + "if (" + cc + ") {\n" + _block(&cs, b, ind + "    ") + ind + "}"
            if len(e) > 0:
                out = out + " else {\n" + _block(&cs, e, ind + "    ") + ind + "}"
            return out + "\n"
        ast.WhileS(l, c, b):
            cc := "1"
            if len(c) > 0:
                c2, ct2 := _ex(&cs, c[0])
                cc = c2
            return ind + "while (" + cc + ") {\n" + _block(&cs, b, ind + "    ") + ind + "}\n"
        ast.For3(l, ip, c, b):
            m := _mark(&cs)
            init := _stmt(&cs, ip[0], "")
            cc, ct := _ex(&cs, c[0])
            post := _stmt(&cs, ip[1], "")
            out := ind + "{\n" + ind + "    " + _trim_nl(init) +
                ind + "    for (; " + cc + "; " + _strip_semi(post) + ") {\n" +
                _block(&cs, b, ind + "        ") + ind + "    }\n" + ind + "}\n"
            _restore(&cs, m)
            return out
        ast.ForIn(l, n, c, b):
            cc, ct := _ex(&cs, c[0])
            if ct == "string":
                fs := _fresh(&cs, "_fs")
                fj := _fresh(&cs, "_fj")
                ms := _mark(&cs)
                scn := _push(&cs, n, "char")
                outs := ind + "{\n" + ind + "    char *" + fs + " = " + cc + ";\n" +
                    ind + "    for (tycho_int " + fj + " = 0; " + fj +
                    " < tycho_str_len(" + fs + "); " + fj + " += 1) {\n" +
                    ind + "        tycho_int " + scn + " = tycho_str_get(" + fs + ", " + fj + ");\n" +
                    _block(&cs, b, ind + "        ") + ind + "    }\n" + ind + "}\n"
                _restore(&cs, ms)
                return outs
            if not _is_arr(ct):
                _bad("for-in over '" + ct + "' -- only arrays here, maps are Phase 8")
            et := _elem(ct)
            fc := _fresh(&cs, "_fc")
            fi := _fresh(&cs, "_fi")
            m := _mark(&cs)
            fcn := _push(&cs, n, et)
            out := ind + "{\n" + ind + "    " + _cty(&cs, "[" + et + "]") + " " + fc +
                " = " + _copy(&cs, cc, ct, "&_scope") + ";\n" +
                ind + "    for (tycho_int " + fi + " = 0; " + fi + " < " + fc +
                ".len; " + fi + " += 1) {\n" +
                ind + "        " + _cty(&cs, et) + " " + fcn + " = " + fc + ".data[" + fi + "];\n" +
                _block(&cs, b, ind + "        ") + ind + "    }\n" + ind + "}\n"
            _restore(&cs, m)
            return out
        ast.MatchS(l, subj, arms):
            return _match(&cs, subj[0], arms, ind)
        ast.MDecl(l, d, ns, r):
            rc, rt := _ex(&cs, r[0])
            if not _is_tup(rt):
                _bad("a destructuring list needs a tuple on the right")
            es := _telems(&cs, rt)
            if len(es) != len(ns):
                _bad("destructuring " + str(len(ns)) + " names from a " +
                    str(len(es)) + "-element tuple")
            tv := _fresh(&cs, "_ds")
            out := ind + _cty(&cs, rt) + " " + tv + " = " + rc + ";\n"
            # every target is read out of the temporary FIRST, so `a, b = b, a`
            # swaps rather than clobbering.
            cns := []string
            for i := 0; i < len(ns); i += 1:
                if d:
                    push(cns, "")
                else:
                    t2 := _vtype(&cs, ns[i])
                    if len(t2) == 0:
                        _bad("assignment to unknown name '" + ns[i] + "'")
                    push(cns, _vcname(&cs, ns[i]))
            for i := 0; i < len(ns); i += 1:
                v := "(" + tv + ".f" + str(i) + ")"
                if _heap(&cs, es[i]):
                    v = _copy(&cs, v, es[i], "&_scope")
                if d:
                    cn := _push(&cs, ns[i], es[i])
                    out = out + ind + _cty(&cs, es[i]) + " " + cn + " = " + v + ";\n"
                else:
                    out = out + ind + cns[i] + " = " + v + ";\n"
            return out
        ast.ForRange(l, n, c, b): _bad("stmt:ForRange -- Phase 8")
        ast.ParallelS(l, w, b): _bad("stmt:ParallelS -- Phase 8")
        ast.SelectS(l, a): _bad("stmt:SelectS -- Phase 8")
        ast.DeleteS(l, k):
            match k[0]:
                ast.Index(l2, ix):
                    mc, mt := _lvalue(&cs, ix[0])
                    kc, kt := _ex(&cs, ix[1])
                    if not _is_map(mt):
                        _bad("`delete` takes a map element")
                    return ind + _mpfx(&cs, mt) + "_del(&(" + mc + "), " +
                        _keyrt(&cs, _mkey(&cs, mt), kc) + ");\n"
                _: _bad("`delete` takes a map element")
            return ""
        _: _bad("unsupported statement -- Phase 8")
    return ""

# The first value tail of a value-if/value-match, which is what types the
# variable being declared when there is no annotation.
fn _tail_expr(s: ast.Stmt) -> [ast.Expr]:
    match s:
        ast.ExprStmt(l, es): return es
        ast.IfS(l, c, b, e):
            if len(b) > 0:
                r := _tail_expr(b[len(b) - 1])
                if len(r) > 0:
                    return r
            if len(e) > 0:
                return _tail_expr(e[len(e) - 1])
            return []ast.Expr
        ast.MatchS(l, sub, arms):
            for a in arms:
                if len(a.body) > 0:
                    r2 := _tail_expr(a.body[len(a.body) - 1])
                    if len(r2) > 0:
                        return r2
            return []ast.Expr
        _: return []ast.Expr
    return []ast.Expr

# A for-3 post clause has to run on `continue`, so the loop is a real C `for`
# and the post statement becomes its third clause -- an expression, not a
# statement. tests/for3.ty documents why: `i` advances only there.
fn _strip_semi(s: string) -> string:
    e := len(s)
    for e > 0 and (s[e - 1] == 10 or s[e - 1] == 59 or s[e - 1] == 32):
        e -= 1
    return s[0:e]

fn _trim_nl(s: string) -> string:
    if len(s) > 0 and s[len(s) - 1] == 10:
        return s[0:len(s) - 1] + "\n"
    return s + "\n"

# A scalar pattern is a literal or the NAME of a const, which src/tychoc.c has
# already folded to one literal by the time it reaches here.
fn _patv(cs: inout C, kind: string, v: int, nm: string) -> string:
    if kind == "name":
        ci := _cidx(&cs, nm)
        if ci >= 0:
            return cs.ccode[ci]
        t := _vtype(&cs, nm)
        if len(t) > 0:
            return _vcname(&cs, nm)
        _bad("unknown name '" + nm + "' in a match pattern")
    return str(v) + "LL"

fn _match(cs: inout C, subj: ast.Expr, arms: [ast.Arm], ind: string) -> string:
    sc, st := _ex(&cs, subj)
    v := _fresh(&cs, "_m")
    if _is_enum(st):
        ei := _eidx(&cs, _tname(st))
        out := ind + "{\n" + ind + "    E_" + _tname(st) + " *" + v + " = " + sc + ";\n"
        first := true
        deflt := ""
        for a in arms:
            if a.kind == "default" or a.name == "_":
                deflt = _block(&cs, a.body, ind + "        ")
                continue
            if a.kind != "variant":
                _bad("unsupported match arm on an enum")
            tag := _tag(&cs, ei, a.name)
            pay := cs.eds[ei].vpay[tag].ptypes
            head := ind + "    if"
            if not first:
                head = ind + "    else if"
            first = false
            m := _mark(&cs)
            binds := ""
            nulsub := ""
            for i := 0; i < len(a.binds); i += 1:
                if i >= len(pay):
                    _bad("variant " + a.name + " binds more than its payload")
                # `Err(NotFound)` -- a NULLARY nested variant. It has no parens,
                # so the parser cannot tell it from a binding name and files it
                # under binds; only the payload's own variant list can. Without
                # this the arm emits no inner tag test and swallows every Err.
                pei := _eidx(&cs, _tname(pay[i]))
                nt := -1
                if pei >= 0:
                    nt = _tagopt(&cs, pei, a.binds[i])
                if nt >= 0:
                    nulsub = str(nt)
                    continue
                bcn := _push(&cs, a.binds[i], pay[i])
                cs.vcn[len(cs.vcn) - 1] = "(*" + bcn + ")"
                binds = binds + ind + "        " + _cty(&cs, pay[i]) + " *" + bcn +
                    " = &" + v + "->u." + a.name + ".f" + str(i) + ";\n"
            # A NESTED pattern -- `Err(TooBig(n))`. The Arm has carried
            # sub/subbinds since the parser, and nothing read them until now, so
            # the inner binding was simply never in scope. The payload is itself
            # an enum: test its tag too, and bind from ITS payload.
            cond := v + "->tag == " + str(tag)
            if len(nulsub) > 0:
                cond = "(" + cond + ") && ((" + v + "->u." + a.name + ".f0)->tag == " + nulsub + ")"
            if len(a.sub) > 0:
                if len(pay) != 1:
                    _bad("a nested pattern needs a single-payload variant")
                ii := _eidx(&cs, _tname(pay[0]))
                if ii < 0:
                    _bad("nested pattern on a non-enum payload '" + pay[0] + "'")
                itag := _tag(&cs, ii, a.sub)
                iv := v + "->u." + a.name + ".f0"
                cond = "(" + cond + ") && ((" + iv + ")->tag == " + str(itag) + ")"
                ipay := cs.eds[ii].vpay[itag].ptypes
                for j := 0; j < len(a.subbinds); j += 1:
                    if j >= len(ipay):
                        _bad("variant " + a.sub + " binds more than its payload")
                    scn := _push(&cs, a.subbinds[j], ipay[j])
                    cs.vcn[len(cs.vcn) - 1] = "(*" + scn + ")"
                    binds = binds + ind + "        " + _cty(&cs, ipay[j]) + " *" + scn +
                        " = &(" + iv + ")->u." + a.sub + ".f" + str(j) + ";\n"
            body := _block(&cs, a.body, ind + "        ")
            _restore(&cs, m)
            out = out + head + " (" + cond + ") {\n" + binds + body +
                ind + "    }\n"
        if first:
            return out + deflt + ind + "}\n"
        if len(deflt) > 0:
            out = out + ind + "    else {\n" + deflt + ind + "    }\n"
        else:
            out = out + ind + "    else { fprintf(stderr, \"tycho: non-exhaustive match\\n\"); exit(1); }\n"
        return out + ind + "}\n"
    # scalar subject
    out2 := ind + "{\n" + ind + "    " + _cty(&cs, st) + " " + v + " = " + sc + ";\n"
    first2 := true
    deflt2 := ""
    for a in arms:
        if a.kind == "default" or a.name == "_":
            deflt2 = _block(&cs, a.body, ind + "        ")
            continue
        if a.kind != "scalar":
            _bad("unsupported match arm on a scalar")
        cond := ""
        for p in a.pats:
            one := ""
            if p.ranged:
                one = "(" + v + " >= " + _patv(&cs, p.kind, p.lo, p.loname) + " && " + v +
                    " <= " + _patv(&cs, p.kind, p.hi, p.hiname) + ")"
            else:
                one = "(" + v + " == " + _patv(&cs, p.kind, p.lo, p.loname) + ")"
            if len(cond) > 0:
                cond = cond + " || "
            cond = cond + one
        head2 := ind + "    if"
        if not first2:
            head2 = ind + "    else if"
        first2 = false
        out2 = out2 + head2 + " (" + cond + ") {\n" + _block(&cs, a.body, ind + "        ") +
            ind + "    }\n"
    if first2:
        return out2 + deflt2 + ind + "}\n"
    if len(deflt2) > 0:
        out2 = out2 + ind + "    else {\n" + deflt2 + ind + "    }\n"
    return out2 + ind + "}\n"

# --- declaration collection -------------------------------------------------

# Two passes, because a package's files are collected in one go and a name may
# be declared in a LATER file of the same package -- src/tychoc.c merges every
# file's declarations before it resolves any of them. Pass 1 registers the
# names (already package-mangled); pass 2 resolves the types those names carry.

fn _collect1(cs: inout C, u: ast.Unit):
    p := _pfx(&cs)
    for sd in u.structs:
        if len(sd.typarams) > 0:
            push(cs.gs, ast.StructD(p + sd.name, sd.typarams, sd.fields, sd.line))
            push(cs.gsf, cs.cf)
        else:
            push(cs.sds, SD(p + sd.name, [], []))
    for ed in u.enums:
        if len(ed.typarams) > 0:
            push(cs.ge, ast.EnumD(p + ed.name, ed.typarams, ed.variants, ed.line))
            push(cs.gef, cs.cf)
        else:
            push(cs.eds, ED(p + ed.name, [], []))
            push(cs.edp, p)
    for nt in u.newtypes:
        push(cs.ntn, p + nt.name)
        push(cs.ntu, "")
        push(cs.ntt, nt.under)
        push(cs.ntf, cs.cf)
    for f in u.fns:
        if len(f.typarams) > 0:
            push(cs.gf, ast.Fn(p + f.name, f.params, f.ret, f.typarams, f.wheres,
                f.body, f.is_extern, f.lib, f.dnote, f.line))
            push(cs.gff, cs.cf)

# A newtype over a LATER newtype is legal -- and, across packages, over one
# declared in a file collected earlier -- so resolve only the ones whose every
# named part is already known and repeat until nothing moves. Each is resolved
# with its OWN file current, which is what makes an unqualified name in it
# resolve against its own package.
fn _collect_nt(cs: inout C):
    save := cs.cf
    for pas := 0; pas <= len(cs.ntn); pas += 1:
        for i := 0; i < len(cs.ntn); i += 1:
            cs.cf = cs.ntf[i]
            if len(cs.ntu[i]) == 0 and _ty_ready(&cs, cs.ntt[i]):
                cs.ntu[i] = _ty(&cs, cs.ntt[i])
    for i := 0; i < len(cs.ntn); i += 1:
        cs.cf = cs.ntf[i]
        if len(cs.ntu[i]) == 0:
            cs.ntu[i] = _ty(&cs, cs.ntt[i])
    cs.cf = save

fn _collect2(cs: inout C, u: ast.Unit):
    p := _pfx(&cs)
    for i := 0; i < len(u.structs); i += 1:
        if len(u.structs[i].typarams) > 0:
            continue
        si := _sidx(&cs, u.structs[i].name)
        for f in u.structs[i].fields:
            push(cs.sds[si].fnames, f.name)
            push(cs.sds[si].ftypes, _ty(&cs, f.ty))
    for i := 0; i < len(u.enums); i += 1:
        if len(u.enums[i].typarams) > 0:
            continue
        ei := _eidx(&cs, u.enums[i].name)
        for v in u.enums[i].variants:
            push(cs.eds[ei].vnames, v.name)
            ps := []string
            for pt2 in v.payload:
                push(ps, _ty(&cs, pt2))
            push(cs.eds[ei].vpay, VD(v.name, ps))
    for f in u.fns:
        if len(f.typarams) > 0:
            continue
        if f.is_extern:
            push(cs.exn, f.name)
        pn := []string
        pt := []string
        pio := []bool
        pv := false
        for pp in f.params:
            if len(pp.ty) == 0:
                _bad("untyped parameter on '" + f.name + "'")
            one := _ty(&cs, pp.ty[0])
            if pp.is_variadic:
                pv = true
                one = "[" + one + "]"
            push(pn, pp.name)
            push(pt, one)
            push(pio, pp.is_inout)
        nmf := p + f.name
        if f.is_extern:
            nmf = f.name
        push(cs.fds, FD(nmf, pn, pt, pio, pv, _tyo(&cs, f.ret)))
    for c in u.consts:
        cc, ct := _ex(&cs, c.value)
        push(cs.cnames, p + c.name)
        push(cs.ctypes, ct)
        push(cs.ccode, cc)

# --- the generated support code ---------------------------------------------

fn _arr_protos(cs: inout C) -> string:
    out := ""
    for i := 0; i < len(cs.akinds); i += 1:
        e := cs.akinds[i]
        k := "K" + str(i)
        ct := "TychoArr" + k
        et := _cty(&cs, e)
        p := "tycho_arr_" + k
        out = out +
            "static " + ct + " " + p + "_with_cap(Arena *, tycho_int);\n" +
            "static void " + p + "_push(Arena *, " + ct + " *, " + et + ");\n" +
            "static void " + p + "_reserve(Arena *, " + ct + " *, tycho_int);\n" +
            "static " + et + " " + p + "_pop(Arena *, " + ct + " *);\n" +
            "static " + et + " " + p + "_get(" + ct + ", tycho_int);\n" +
            "static " + et + " *" + p + "_ptr(" + ct + " *, tycho_int);\n" +
            "static " + ct + " " + p + "_copy(Arena *, " + ct + ");\n" +
            "static int " + p + "_eq(" + ct + ", " + ct + ");\n" +
            "static char *tycho_str_arr_" + k + "(Arena *, " + ct + ");\n"
        if _hashable(&cs, e):
            out = out + "static uint64_t " + p + "_hash(" + ct + ");\n"
    return out

# One growable arena buffer per FIELD plus a shared len/cap, which is the whole
# point of a soa. Shape read out of `./tychoc tests/soa_basic.ty --emit-c`, not
# designed here -- see plan.md's "The soa target" table for every call site.
fn _soa_defs(cs: inout C) -> (string, string):
    sb := ""
    fb := ""
    i := 0
    for i < len(cs.oks):
        st := cs.oks[i]
        ct := "Soa" + str(i)
        et := _cty(&cs, st)
        si := _sidx(&cs, _tname(st))
        fns := cs.sds[si].fnames
        fts := cs.sds[si].ftypes
        flds := ""
        for j := 0; j < len(fns); j += 1:
            flds = flds + _cty(&cs, fts[j]) + " *f" + str(j) + "; "
        sb = sb + "typedef struct { " + flds + "tycho_int len; tycho_int cap; } " + ct + ";\n"
        sb = sb + "static tycho_int " + ct + "_bound(" + ct + " *s, tycho_int i) { " +
            "if (i < 0 || i >= s->len) { fprintf(stderr, \"tycho: index %\" TY_PRId " +
            "\" out of bounds (len %\" TY_PRId \")\\n\", i, s->len); exit(1); } return i; }\n"
        # Prototypes: a struct's own eq/str is emitted BEFORE these bodies and
        # can call them (a struct field may be a soa -- tests/soa.ty's Bag).
        sb = sb + "static void " + ct + "_push(Arena*, " + ct + "*, " + et + ");\n" +
            "static void " + ct + "_set(Arena*, " + ct + "*, tycho_int, " + et + ");\n" +
            "static " + et + " " + ct + "_pop(" + ct + "*);\n" +
            "static " + et + " " + ct + "_get(" + ct + "*, tycho_int);\n" +
            "static " + ct + " " + ct + "_copy(Arena*, " + ct + ");\n" +
            "static int " + ct + "_eq(" + ct + ", " + ct + ");\n"
        grow := ""
        stores := ""
        gath := ""
        cpy := ""
        eqs := ""
        for j := 0; j < len(fns); j += 1:
            c := _cty(&cs, fts[j])
            f := "f" + str(j)
            grow = grow + "        " + c + " *n" + str(j) + " = (" + c +
                " *)arena_alloc(a, (size_t)nc * sizeof(" + c + " )); for (tycho_int i = 0; i < s->len; i++) n" +
                str(j) + "[i] = s->" + f + "[i]; s->" + f + " = n" + str(j) + ";\n"
            stores = stores + "    s->" + f + "[s->len] = v.f_" + fns[j] + ";\n"
            if len(gath) > 0:
                gath = gath + ", "
            gath = gath + "s->" + f + "[_i]"
            cpy = cpy + "    r." + f + " = s.len ? (" + c + " *)arena_alloc(a, (size_t)s.len * sizeof(" +
                c + " )) : 0;\n    for (tycho_int i = 0; i < s.len; i++) r." + f + "[i] = s." + f + "[i];\n"
            if len(eqs) > 0:
                eqs = eqs + " && "
            # a heap field cannot be compared with `==`; _eq picks the right
            # comparison per type (soa_scatter_heap holds an array per element).
            eqs = eqs + "(" + _eq(&cs, "a." + f + "[i]", "b." + f + "[i]", fts[j]) + ")"
        fb = fb + "static void " + ct + "_push(Arena *a, " + ct + " *s, " + et + " v) {\n" +
            "    if (s->len == s->cap) {\n        tycho_int nc = s->cap ? s->cap * 2 : 4;\n" +
            grow + "        s->cap = nc;\n    }\n" + stores + "    s->len++;\n}\n"
        sets := ""
        for j := 0; j < len(fns); j += 1:
            sets = sets + "    s->f" + str(j) + "[_si] = v.f_" + fns[j] + ";\n"
        fb = fb + "static void " + ct + "_set(Arena *a, " + ct + " *s, tycho_int ix, " +
            et + " v) {\n    tycho_int _si = " + ct + "_bound(s, ix);\n" + sets + "}\n"
        fb = fb + "static " + et + " " + ct + "_pop(" + ct + " *s) {\n" +
            "    if (s->len == 0) { fprintf(stderr, \"tycho: pop from an empty array\\n\"); exit(1); }\n" +
            "    s->len--;\n    tycho_int _i = s->len;\n    return (" + et + "){ " + gath + " };\n}\n"
        fb = fb + "static " + et + " " + ct + "_get(" + ct + " *s, tycho_int ix) {\n" +
            "    tycho_int _i = " + ct + "_bound(s, ix);\n    return (" + et + "){ " + gath + " };\n}\n"
        fb = fb + "static " + ct + " " + ct + "_copy(Arena *a, " + ct + " s) {\n" +
            "    " + ct + " r; r.len = s.len; r.cap = s.len;\n" + cpy + "    return r;\n}\n"
        fb = fb + "static int " + ct + "_eq(" + ct + " a, " + ct + " b) {\n" +
            "    if (a.len != b.len) return 0;\n" +
            "    for (tycho_int i = 0; i < a.len; i++) if (!(" + eqs + ")) return 0;\n    return 1;\n}\n"
        i += 1
    return (sb, fb)

fn _arr_defs(cs: inout C) -> (string, string, string):
    # (typedefs, struct bodies, function bodies) for every stamped array kind.
    td := ""
    sb := ""
    fb := ""
    i := 0
    for i < len(cs.akinds):
        e := cs.akinds[i]
        k := "K" + str(i)
        ct := "TychoArr" + k
        et := _cty(&cs, e)
        td = td + "typedef struct " + ct + "_ " + ct + ";\n"
        sb = sb + "struct " + ct + "_ { " + et + " *data; tycho_int len; tycho_int cap; };\n"
        p := "tycho_arr_" + k
        fb = fb +
            "static " + ct + " " + p + "_with_cap(Arena *a, tycho_int cap) {\n" +
            "    " + ct + " r; r.len = 0; r.cap = cap;\n" +
            "    r.data = cap > 0 ? (" + et + " *)arena_alloc(a, (size_t)cap * sizeof(" + et + ")) : 0;\n" +
            "    return r;\n}\n" +
            "static void " + p + "_push(Arena *a, " + ct + " *xs, " + et + " v) {\n" +
            "    if (xs->len == xs->cap) {\n" +
            "        tycho_int nc = xs->cap ? xs->cap * 2 : 4;\n" +
            "        " + et + " *nd = (" + et + " *)arena_alloc(a, (size_t)nc * sizeof(" + et + "));\n" +
            "        for (tycho_int i = 0; i < xs->len; i++) nd[i] = xs->data[i];\n" +
            "        xs->data = nd; xs->cap = nc;\n    }\n" +
            "    xs->data[xs->len++] = v;\n}\n" +
            "static void " + p + "_reserve(Arena *a, " + ct + " *xs, tycho_int n) {\n" +
            "    if (n <= xs->cap) return;\n" +
            "    " + et + " *nd = (" + et + " *)arena_alloc(a, (size_t)n * sizeof(" + et + "));\n" +
            "    for (tycho_int i = 0; i < xs->len; i++) nd[i] = xs->data[i];\n" +
            "    xs->data = nd; xs->cap = n;\n}\n" +
            "static " + et + " " + p + "_pop(Arena *a, " + ct + " *xs) {\n" +
            "    if (xs->len == 0) { fprintf(stderr, \"tycho: pop from an empty array\\n\"); exit(1); }\n" +
            "    xs->len--;\n    return xs->data[xs->len];\n}\n" +
            "static " + et + " " + p + "_get(" + ct + " xs, tycho_int i) {\n" +
            "    if (i < 0 || i >= xs.len) { fprintf(stderr, \"tycho: index %\" TY_PRId \" out of bounds (len %\" TY_PRId \")\\n\", i, xs.len); exit(1); }\n" +
            "    return xs.data[i];\n}\n" +
            "static " + et + " *" + p + "_ptr(" + ct + " *xs, tycho_int i) {\n" +
            "    if (i < 0 || i >= xs->len) { fprintf(stderr, \"tycho: index %\" TY_PRId \" out of bounds (len %\" TY_PRId \")\\n\", i, xs->len); exit(1); }\n" +
            "    return &xs->data[i];\n}\n" +
            "static " + ct + " " + p + "_copy(Arena *a, " + ct + " src) {\n" +
            "    " + ct + " r = " + p + "_with_cap(a, src.len); r.len = src.len;\n" +
            "    for (tycho_int i = 0; i < src.len; i++) r.data[i] = " +
            _copy(&cs, "src.data[i]", e, "a") + ";\n    return r;\n}\n" +
            "static int " + p + "_eq(" + ct + " x, " + ct + " y) {\n" +
            "    if (x.len != y.len) return 0;\n" +
            "    for (tycho_int i = 0; i < x.len; i++) if (!" +
            _eq(&cs, "x.data[i]", "y.data[i]", e) + ") return 0;\n    return 1;\n}\n" +
            "static char *tycho_str_arr_" + k + "(Arena *a, " + ct + " xs) {\n" +
            "    char *r = tycho_str_from_c(a, \"[\");\n" +
            "    for (tycho_int i = 0; i < xs.len; i++) {\n" +
            "        if (i) r = tycho_str_concat(a, r, tycho_str_from_c(a, \", \"));\n" +
            "        r = tycho_str_concat(a, r, " + _tostr_a(&cs, "xs.data[i]", e) + ");\n    }\n" +
            "    return tycho_str_concat(a, r, tycho_str_from_c(a, \"]\"));\n}\n"
        if _hashable(&cs, e):
            fb = fb + "static uint64_t " + p + "_hash(" + ct + " x) {\n" +
                "    uint64_t h = tycho_hash_k0;\n" +
                "    for (tycho_int i = 0; i < x.len; i++) h = h * UINT64_C(1099511628211) ^ " +
                _hash(&cs, e, "x.data[i]") + ";\n    return h;\n}\n"
        i += 1
    return (td, sb, fb)

# _tostr, but writing into an explicit arena rather than the caller's _scope.
# "Plain" means every element's C type is COMPLETE where the tuple typedefs are
# emitted, which is before the array/map/soa bodies and before the struct
# bodies. A map, soa or ARRAY element is NOT complete there -- that is Phase 7f,
# seen as `struct TychoTup0_ { ... TychoMapM0 f1; }` with an incomplete f1 and
# as `struct TychoTup3_ { TychoArrK17 f0; }` with no TychoArrK17 declared. The
# TychoArrK<n> kinds are GENERATED, not runtime types, despite TychoArrInt and
# TychoArrStr looking like they come from the runtime.
fn _tup_plain(cs: inout C, i: int) -> bool:
    for e in split(cs.tks[i], "|"):
        if _is_struct(e) or _is_tup(e) or _is_map(e) or _is_soa(e) or _is_arr(e):
            return false
    return true

fn _tup_defs(cs: inout C) -> (string, string, string, string):
    # (typedefs, struct bodies, prototypes, function bodies) per tuple kind.
    td := ""
    sb := ""
    pr := ""
    fb := ""
    i := 0
    for i < len(cs.tks):
        es := split(cs.tks[i], "|")
        ct := "TychoTup" + str(i)
        fl := ""
        for j := 0; j < len(es); j += 1:
            fl = fl + " " + _cty(&cs, es[j]) + " f" + str(j) + ";"
        td = td + "typedef struct " + ct + "_ " + ct + ";\n"
        if _tup_plain(&cs, i):
            td = td + "struct " + ct + "_ {" + fl + " };\n"
        else:
            sb = sb + "struct " + ct + "_ {" + fl + " };\n"
        pr = pr + "static int tycho_eq_T" + str(i) + "(" + ct + ", " + ct + ");\n" +
            "static char *tycho_str_T" + str(i) + "(Arena *, " + ct + ");\n"
        eq := ""
        st := "    char *r = tycho_str_from_c(a, \"(\");\n"
        for j := 0; j < len(es); j += 1:
            if j > 0:
                eq = eq + " && "
                st = st + "    r = tycho_str_concat(a, r, tycho_str_from_c(a, \", \"));\n"
            eq = eq + _eq(&cs, "x.f" + str(j), "y.f" + str(j), es[j])
            st = st + "    r = tycho_str_concat(a, r, " + _tostr_a(&cs, "v.f" + str(j), es[j]) + ");\n"
        if len(eq) == 0:
            eq = "1"
        fb = fb + "static int tycho_eq_T" + str(i) + "(" + ct + " x, " + ct + " y) {\n" +
            "    return " + eq + ";\n}\n" +
            "static char *tycho_str_T" + str(i) + "(Arena *a, " + ct + " v) {\n" + st +
            "    return tycho_str_concat(a, r, tycho_str_from_c(a, \")\"));\n}\n"
        if _heap(&cs, "T~" + str(i)):
            pr = pr + "static " + ct + " tycho_copy_T" + str(i) + "(Arena *, " + ct + ");\n"
            cp := "static " + ct + " tycho_copy_T" + str(i) + "(Arena *a, " + ct + " v) {\n" +
                "    " + ct + " r = v;\n"
            for j := 0; j < len(es); j += 1:
                if _heap(&cs, es[j]):
                    cp = cp + "    r.f" + str(j) + " = " + _copy(&cs, "v.f" + str(j), es[j], "a") + ";\n"
            fb = fb + cp + "    return r;\n}\n"
        i += 1
    return (td, sb, pr, fb)

# One compact indexed dict per (key, value) kind: an int32 index table over a
# dense insertion-ordered entry list, with tombstones, backward-shift index
# delete and allocation-free compaction. Mirrors src/tychoc.c:13481 line for
# line -- the shape is what makes keys() insertion-ordered.
fn _map_defs(cs: inout C) -> (string, string, string, string):
    td := ""
    sb := ""
    pr := ""
    fb := ""
    i := 0
    for i < len(cs.mks):
        mt := "M~" + str(i)
        kt := _mkey(&cs, mt)
        vt := _mval(&cs, mt)
        ct := "TychoMapM" + str(i)
        p := "tycho_mapM" + str(i)
        ks := _kslot(&cs, kt)
        vc := _cty(&cs, vt) + " "
        kp := ks + "k"
        kcp := _kcopy(&cs, kt)
        vcp := _copy(&cs, "v", vt, "a")
        kat := _cty(&cs, "[" + kt + "]")
        kaf := _apfx(&cs, kt)
        kel := "m.ekeys[e]"
        if _kclass(&cs, kt) == "enum":
            kel = "_sing_tab_" + _tname(kt) + "[m.ekeys[e]]"
        td = td + "typedef struct " + ct + "_ " + ct + ";\n"
        sb = sb + "struct " + ct + "_ { " + ks + "*ekeys; " + vc +
            "*evals; unsigned char *elive; int *idx; tycho_int len; tycho_int ecount; tycho_int ecap; tycho_int icap; };\n"
        pr = pr +
            "static " + ct + " " + p + "_with_cap(Arena *, tycho_int);\n" +
            "static void " + p + "_reserve(Arena *, " + ct + " *, tycho_int);\n" +
            "static tycho_int " + p + "_find(" + ct + ", " + kp + ");\n" +
            "static void " + p + "_idxput(" + ct + " *, tycho_int);\n" +
            "static void " + p + "_idxgrow(Arena *, " + ct + " *);\n" +
            "static void " + p + "_compact(" + ct + " *);\n" +
            "static tycho_int " + p + "_append(Arena *, " + ct + " *, " + kp + ", " + vc + "v);\n" +
            "static void " + p + "_put(Arena *, " + ct + " *, " + kp + ", " + vc + "v);\n" +
            "static " + vc + "*" + p + "_slotptr(Arena *, " + ct + " *, " + kp + ");\n" +
            "static void " + p + "_del(" + ct + " *, " + kp + ");\n" +
            "static " + ct + " " + p + "_copy(Arena *, " + ct + ");\n" +
            "static " + vc + p + "_get(" + ct + ", " + kp + ", " + vc + "dflt);\n" +
            "static int " + p + "_has(" + ct + ", " + kp + ");\n" +
            "static " + kat + " " + p + "_keys(Arena *, " + ct + ");\n" +
            "static int " + p + "_eq(" + ct + ", " + ct + ");\n" +
            "static char *tycho_str_mapM" + str(i) + "(Arena *, " + ct + ");\n"
        fb = fb +
            "static " + ct + " " + p + "_with_cap(Arena *a, tycho_int cap) {\n" +
            "    " + ct + " m; m.len = 0; m.ecount = 0;\n" +
            "    if (cap <= 0) { m.ekeys = 0; m.evals = 0; m.elive = 0; m.idx = 0; m.ecap = 0; m.icap = 0; return m; }\n" +
            "    tycho_int ec = 4; while (ec < cap) ec *= 2; tycho_int ic = 8; while (ic < cap * 2) ic *= 2; m.ecap = ec; m.icap = ic;\n" +
            "    m.ekeys = (" + ks + "*)arena_alloc(a, (size_t)ec * sizeof(" + ks + "));\n" +
            "    m.evals = (" + vc + "*)arena_alloc(a, (size_t)ec * sizeof(" + vc + "));\n" +
            "    m.elive = (unsigned char *)arena_alloc(a, (size_t)ec);\n" +
            "    m.idx = (int *)arena_alloc(a, (size_t)ic * sizeof(int));\n" +
            "    for (tycho_int i = 0; i < ic; i++) m.idx[i] = 0; return m;\n}\n" +
            "static void " + p + "_reserve(Arena *a, " + ct + " *m, tycho_int cap) {\n" +
            "    if (cap <= 0) return;\n" +
            "    tycho_int ec = 4; while (ec < cap) ec *= 2; tycho_int ic = 8; while (ic < cap * 2) ic *= 2;\n" +
            "    if (m->ecap >= ec && m->icap >= ic) return;\n" +
            "    " + ks + "*nk = (" + ks + "*)arena_alloc(a, (size_t)ec * sizeof(" + ks + "));\n" +
            "    " + vc + "*nv = (" + vc + "*)arena_alloc(a, (size_t)ec * sizeof(" + vc + "));\n" +
            "    unsigned char *nl = (unsigned char *)arena_alloc(a, (size_t)ec);\n" +
            "    int *ni = (int *)arena_alloc(a, (size_t)ic * sizeof(int));\n" +
            "    for (tycho_int i = 0; i < ic; i++) ni[i] = 0;\n" +
            "    for (tycho_int e = 0; e < m->ecount; e++) { nk[e] = m->ekeys[e]; nv[e] = m->evals[e]; nl[e] = m->elive[e]; }\n" +
            "    m->ekeys = nk; m->evals = nv; m->elive = nl; m->ecap = ec;\n" +
            "    m->idx = ni; m->icap = ic;\n" +
            "    for (tycho_int e = 0; e < m->ecount; e++) if (m->elive[e]) " + p + "_idxput(m, e);\n}\n" +
            "static tycho_int " + p + "_find(" + ct + " m, " + kp + ") {\n" +
            "    if (m.icap == 0) return -1; uint64_t mask = (uint64_t)m.icap - 1; tycho_int i = (tycho_int)(" +
            _khash(&cs, kt, "k") + " & mask); int e;\n" +
            "    while ((e = m.idx[i]) != 0) { if (" + _kmatch(&cs, kt, "m.ekeys[e - 1]", "k") +
            ") return e - 1; i = (tycho_int)((i + 1) & mask); }\n    return -1;\n}\n" +
            "static void " + p + "_idxput(" + ct + " *m, tycho_int ei) {\n" +
            "    uint64_t mask = (uint64_t)m->icap - 1; tycho_int i = (tycho_int)(" +
            _khash(&cs, kt, "m->ekeys[ei]") + " & mask);\n" +
            "    while (m->idx[i] != 0) i = (tycho_int)((i + 1) & mask); m->idx[i] = (int)(ei + 1);\n}\n" +
            "static void " + p + "_idxgrow(Arena *a, " + ct + " *m) {\n" +
            "    tycho_int ic = m->icap ? m->icap * 2 : 8; int *ni = (int *)arena_alloc(a, (size_t)ic * sizeof(int));\n" +
            "    for (tycho_int i = 0; i < ic; i++) ni[i] = 0; m->idx = ni; m->icap = ic;\n" +
            "    for (tycho_int e = 0; e < m->ecount; e++) if (m->elive[e]) " + p + "_idxput(m, e);\n}\n" +
            "static void " + p + "_compact(" + ct + " *m) {\n" +
            "    tycho_int w = 0; for (tycho_int r = 0; r < m->ecount; r++) if (m->elive[r]) { if (w != r) { m->ekeys[w] = m->ekeys[r]; m->evals[w] = m->evals[r]; m->elive[w] = 1; } w++; }\n" +
            "    m->ecount = w; for (tycho_int i = 0; i < m->icap; i++) m->idx[i] = 0;\n" +
            "    for (tycho_int e = 0; e < m->ecount; e++) " + p + "_idxput(m, e);\n}\n" +
            "static tycho_int " + p + "_append(Arena *a, " + ct + " *m, " + kp + ", " + vc + "v) {\n" +
            "    if (m->ecount == m->ecap) { tycho_int dead = m->ecount - m->len;\n" +
            "        if (dead > m->ecap / 2) " + p + "_compact(m);\n" +
            "        else { tycho_int nc = m->ecap ? m->ecap * 2 : 4;\n" +
            "            " + ks + "*nk = (" + ks + "*)arena_alloc(a, (size_t)nc * sizeof(" + ks + ")); " +
            vc + "*nv = (" + vc + "*)arena_alloc(a, (size_t)nc * sizeof(" + vc + ")); unsigned char *nl = (unsigned char *)arena_alloc(a, (size_t)nc);\n" +
            "            for (tycho_int e = 0; e < m->ecount; e++) { nk[e] = m->ekeys[e]; nv[e] = m->evals[e]; nl[e] = m->elive[e]; }\n" +
            "            m->ekeys = nk; m->evals = nv; m->elive = nl; m->ecap = nc; } }\n" +
            "    tycho_int e = m->ecount++; m->ekeys[e] = k; m->evals[e] = v; m->elive[e] = 1; return e;\n}\n" +
            "static void " + p + "_put(Arena *a, " + ct + " *m, " + kp + ", " + vc + "v) {\n" +
            "    tycho_int e = " + p + "_find(*m, k); if (e >= 0) { m->evals[e] = " + vcp + "; return; }\n" +
            "    if ((m->len + 1) * 2 > m->icap) " + p + "_idxgrow(a, m);\n" +
            "    tycho_int ne = " + p + "_append(a, m, " + kcp + ", " + vcp + "); m->len++; " + p + "_idxput(m, ne);\n}\n" +
            "static " + vc + "*" + p + "_slotptr(Arena *a, " + ct + " *m, " + kp + ") {\n" +
            "    tycho_int e = " + p + "_find(*m, k); if (e >= 0) return &m->evals[e];\n" +
            "    if ((m->len + 1) * 2 > m->icap) " + p + "_idxgrow(a, m);\n" +
            "    tycho_int ne = " + p + "_append(a, m, " + kcp + ", " + _zero(&cs, vt) + "); m->len++; " + p + "_idxput(m, ne);\n" +
            "    return &m->evals[ne];\n}\n" +
            "static void " + p + "_del(" + ct + " *m, " + kp + ") {\n" +
            "    if (m->icap == 0) return; uint64_t mask = (uint64_t)m->icap - 1; tycho_int i = (tycho_int)(" +
            _khash(&cs, kt, "k") + " & mask), found = -1;\n" +
            "    while (m->idx[i] != 0) { if (" + _kmatch(&cs, kt, "m->ekeys[m->idx[i] - 1]", "k") +
            ") { found = i; break; } i = (tycho_int)((i + 1) & mask); }\n" +
            "    if (found < 0) return; tycho_int ei = m->idx[found] - 1; m->elive[ei] = 0; m->len--;\n" +
            "    tycho_int g = found;\n" +
            "    for (;;) { m->idx[g] = 0; tycho_int j = g;\n" +
            "        for (;;) { j = (tycho_int)((j + 1) & mask); if (m->idx[j] == 0) return;\n" +
            "            tycho_int h = (tycho_int)(" + _khash(&cs, kt, "m->ekeys[m->idx[j] - 1]") + " & mask);\n" +
            "            if (g <= j) { if (g < h && h <= j) continue; } else { if (g < h || h <= j) continue; } break; }\n" +
            "        m->idx[g] = m->idx[j]; g = j; }\n}\n" +
            "static " + ct + " " + p + "_copy(Arena *a, " + ct + " src) {\n" +
            "    " + ct + " r = " + p + "_with_cap(a, src.len ? src.len : 0);\n" +
            "    for (tycho_int e = 0; e < src.ecount; e++) if (src.elive[e]) " + p +
            "_put(a, &r, src.ekeys[e], src.evals[e]);\n    return r;\n}\n" +
            "static " + vc + p + "_get(" + ct + " m, " + kp + ", " + vc + "dflt) {\n" +
            "    tycho_int e = " + p + "_find(m, k); return e < 0 ? dflt : m.evals[e];\n}\n" +
            "static int " + p + "_has(" + ct + " m, " + kp + ") { return " + p + "_find(m, k) >= 0; }\n" +
            "static " + kat + " " + p + "_keys(Arena *a, " + ct + " m) {\n" +
            "    " + kat + " r = " + kaf + "_with_cap(a, m.len);\n" +
            "    for (tycho_int e = 0; e < m.ecount; e++) if (m.elive[e]) " + kaf +
            "_push(a, &r, " + kel + ");\n    return r;\n}\n" +
            "static int " + p + "_eq(" + ct + " x, " + ct + " y) {\n" +
            "    if (x.len != y.len) return 0;\n" +
            "    for (tycho_int e = 0; e < x.ecount; e++) if (x.elive[e]) { tycho_int s = " + p +
            "_find(y, x.ekeys[e]); if (s < 0 || !(" + _eq(&cs, "y.evals[s]", "x.evals[e]", vt) +
            ")) return 0; }\n    return 1;\n}\n" +
            "static char *tycho_str_mapM" + str(i) + "(Arena *a, " + ct + " m) {\n" +
            "    char *r = tycho_str_from_c(a, \"[\"); int first = 1;\n" +
            "    for (tycho_int e = 0; e < m.ecount; e++) if (m.elive[e]) {\n" +
            "        if (!first) r = tycho_str_concat(a, r, tycho_str_from_c(a, \", \")); first = 0;\n" +
            "        r = tycho_str_concat(a, r, " + _tostr_a(&cs, kel, kt) + ");\n" +
            "        r = tycho_str_concat(a, r, tycho_str_from_c(a, \": \"));\n" +
            "        r = tycho_str_concat(a, r, " + _tostr_a(&cs, "m.evals[e]", vt) + ");\n" +
            "    }\n    return tycho_str_concat(a, r, tycho_str_from_c(a, \"]\"));\n}\n"
        i += 1
    return (td, sb, pr, fb)

# A deep hash per hashable struct/tuple, folded FNV-style from the per-process
# seed so that ==-equal values always hash equal (src/tychoc.c:13255).
fn _hash_defs(cs: inout C) -> (string, string):
    pr := ""
    fb := ""
    for i := 0; i < len(cs.sds); i += 1:
        n := cs.sds[i].name
        if not _hashable(&cs, "S~" + n):
            continue
        pr = pr + "static uint64_t tycho_hash_S_" + n + "(S_" + n + ");\n"
        b := "static uint64_t tycho_hash_S_" + n + "(S_" + n + " v) {\n" +
            "    uint64_t h = tycho_hash_k0;\n"
        for j := 0; j < len(cs.sds[i].fnames); j += 1:
            b = b + "    h = h * UINT64_C(1099511628211) ^ " +
                _hash(&cs, cs.sds[i].ftypes[j], "v.f_" + cs.sds[i].fnames[j]) + ";\n"
        fb = fb + b + "    return h;\n}\n"
    for i := 0; i < len(cs.tks); i += 1:
        if not _hashable(&cs, "T~" + str(i)):
            continue
        pr = pr + "static uint64_t tycho_hash_T" + str(i) + "(TychoTup" + str(i) + ");\n"
        b2 := "static uint64_t tycho_hash_T" + str(i) + "(TychoTup" + str(i) + " v) {\n" +
            "    uint64_t h = tycho_hash_k0;\n"
        es := split(cs.tks[i], "|")
        for j := 0; j < len(es); j += 1:
            b2 = b2 + "    h = h * UINT64_C(1099511628211) ^ " +
                _hash(&cs, es[j], "v.f" + str(j)) + ";\n"
        fb = fb + b2 + "    return h;\n}\n"
    return (pr, fb)

fn _tostr_a(cs: inout C, code: string, t: string) -> string:
    s := _tostr(&cs, code, t)
    return _replace(s, "&_scope", "a")

fn _replace(s: string, from: string, to: string) -> string:
    out := ""
    i := 0
    for i < len(s):
        if i + len(from) <= len(s) and s[i:i + len(from)] == from:
            out = out + to
            i += len(from)
        else:
            out = out + s[i:i + 1]
            i += 1
    return out

fn _struct_order(cs: inout C) -> [int]:
    order := []int
    done := []bool
    for i := 0; i < len(cs.sds); i += 1:
        push(done, false)
    for len(order) < len(cs.sds):
        moved := false
        for i := 0; i < len(cs.sds); i += 1:
            if done[i]:
                continue
            ok := true
            for ft in cs.sds[i].ftypes:
                if _is_struct(ft):
                    j := _sidx(&cs, _tname(ft))
                    if j >= 0 and not done[j]:
                        ok = false
            if ok:
                done[i] = true
                push(order, i)
                moved = true
        if not moved:
            _bad("a cycle among struct definitions")
    return order

fn _struct_support(cs: inout C) -> (string, string):
    proto := ""
    body := ""
    for i := 0; i < len(cs.sds); i += 1:
        n := cs.sds[i].name
        proto = proto + "static int tycho_eq_S_" + n + "(S_" + n + ", S_" + n + ");\n"
        proto = proto + "static char *tycho_str_S_" + n + "(Arena *, S_" + n + ");\n"
        eq := ""
        st := "    char *r = tycho_str_from_c(a, \"" + n + "(\");\n"
        for j := 0; j < len(cs.sds[i].fnames); j += 1:
            f := cs.sds[i].fnames[j]
            ft := cs.sds[i].ftypes[j]
            if j > 0:
                eq = eq + " && "
                st = st + "    r = tycho_str_concat(a, r, tycho_str_from_c(a, \", \"));\n"
            eq = eq + _eq(&cs, "x.f_" + f, "y.f_" + f, ft)
            st = st + "    r = tycho_str_concat(a, r, " + _tostr_a(&cs, "v.f_" + f, ft) + ");\n"
        if len(eq) == 0:
            eq = "1"
        body = body + "static int tycho_eq_S_" + n + "(S_" + n + " x, S_" + n + " y) {\n" +
            "    return " + eq + ";\n}\n" +
            "static char *tycho_str_S_" + n + "(Arena *a, S_" + n + " v) {\n" + st +
            "    return tycho_str_concat(a, r, tycho_str_from_c(a, \")\"));\n}\n"
        if _heap(&cs, "S~" + n):
            proto = proto + "static S_" + n + " tycho_copy_S_" + n + "(Arena *, S_" + n + ");\n"
            cp := "static S_" + n + " tycho_copy_S_" + n + "(Arena *a, S_" + n + " v) {\n" +
                "    S_" + n + " r = v;\n"
            for j := 0; j < len(cs.sds[i].fnames); j += 1:
                f := cs.sds[i].fnames[j]
                ft := cs.sds[i].ftypes[j]
                if _heap(&cs, ft):
                    cp = cp + "    r.f_" + f + " = " + _copy(&cs, "v.f_" + f, ft, "a") + ";\n"
            body = body + cp + "    return r;\n}\n"
    return (proto, body)

fn _enum_support(cs: inout C) -> (string, string, string):
    defs := ""
    proto := ""
    body := ""
    for i := 0; i < len(cs.eds); i += 1:
        n := cs.eds[i].name
        un := ""
        for t := 0; t < len(cs.eds[i].vnames); t += 1:
            vn := cs.eds[i].vnames[t]
            ps := cs.eds[i].vpay[t].ptypes
            if len(ps) == 0:
                continue
            fl := ""
            for j := 0; j < len(ps); j += 1:
                fl = fl + " " + _cty(&cs, ps[j]) + " f" + str(j) + ";"
            defs = defs + "typedef struct {" + fl + " } E_" + n + "_" + vn + ";\n"
            un = un + " E_" + n + "_" + vn + " " + vn + ";"
        defs = defs + "struct E_" + n + " { int tag; union {" + un + " } u; };\n"
        allbare := true
        for t := 0; t < len(cs.eds[i].vnames); t += 1:
            if len(cs.eds[i].vpay[t].ptypes) == 0:
                defs = defs + "static E_" + n + " _sing_" + n + "_" + str(t) +
                    " = { " + str(t) + " };\n"
            else:
                allbare = false
        # a fieldless enum is stored in a map's key table as its TAG, so keys()
        # rebuilds the value through this table (src/tychoc.c:13100).
        if allbare and len(cs.eds[i].vnames) > 0:
            tab := "static E_" + n + " *const _sing_tab_" + n + "[] = {"
            for t := 0; t < len(cs.eds[i].vnames); t += 1:
                if t > 0:
                    tab = tab + ", "
                tab = tab + "&_sing_" + n + "_" + str(t)
            defs = defs + tab + "};\n"
        proto = proto + "static E_" + n + " *tycho_copy_E_" + n + "(Arena *, E_" + n + " *);\n" +
            "static int tycho_eq_E_" + n + "(E_" + n + " *, E_" + n + " *);\n" +
            "static char *tycho_str_E_" + n + "(Arena *, E_" + n + " *);\n"
        cp := "static E_" + n + " *tycho_copy_E_" + n + "(Arena *a, E_" + n + " *v) {\n"
        eq := "static int tycho_eq_E_" + n + "(E_" + n + " *x, E_" + n + " *y) {\n" +
            "    if (x->tag != y->tag) return 0;\n"
        st := "static char *tycho_str_E_" + n + "(Arena *a, E_" + n + " *v) {\n"
        for t := 0; t < len(cs.eds[i].vnames); t += 1:
            vn := cs.eds[i].vnames[t]
            ps := cs.eds[i].vpay[t].ptypes
            tg := str(t)
            if len(ps) == 0:
                st = st + "    if (v->tag == " + tg + ") return tycho_str_from_c(a, \"" + vn + "\");\n"
                eq = eq + "    if (x->tag == " + tg + ") return 1;\n"
                continue
            cp = cp + "    if (v->tag == " + tg + ") {\n" +
                "        E_" + n + " *d = (E_" + n + " *)arena_alloc(a, offsetof(E_" + n +
                ", u) + sizeof(E_" + n + "_" + vn + ")); d->tag = " + tg + ";\n"
            eqs := ""
            st = st + "    if (v->tag == " + tg + ") {\n" +
                "        char *r = tycho_str_from_c(a, \"" + vn + "(\");\n"
            for j := 0; j < len(ps); j += 1:
                fj := ".u." + vn + ".f" + str(j)
                cp = cp + "        d->u." + vn + ".f" + str(j) + " = " +
                    _copy(&cs, "v->u." + vn + ".f" + str(j), ps[j], "a") + ";\n"
                if j > 0:
                    eqs = eqs + " && "
                    st = st + "        r = tycho_str_concat(a, r, tycho_str_from_c(a, \", \"));\n"
                eqs = eqs + _eq(&cs, "x->" + fj[1:], "y->" + fj[1:], ps[j])
                st = st + "        r = tycho_str_concat(a, r, " +
                    _tostr_a(&cs, "v->" + fj[1:], ps[j]) + ");\n"
            cp = cp + "        return d;\n    }\n"
            eq = eq + "    if (x->tag == " + tg + ") return " + eqs + ";\n"
            st = st + "        return tycho_str_concat(a, r, tycho_str_from_c(a, \")\"));\n    }\n"
        body = body + cp + "    return v;\n}\n" + eq + "    return 1;\n}\n" +
            st + "    return tycho_str_from_c(a, \"<?>\");\n}\n"
    return (defs, proto, body)

fn _fnbody(cs: inout C, fi: int, body: [ast.Stmt]) -> (string, string):
    nm := cs.fds[fi].name
    rt := cs.fds[fi].ret
    cs.cur_ret = rt
    sig := _cty(&cs, rt) + " h_" + nm + "(Arena *_parent"
    m := _mark(&cs)
    for j := 0; j < len(cs.fds[fi].pnames); j += 1:
        pt := cs.fds[fi].ptypes[j]
        cn := _push(&cs, cs.fds[fi].pnames[j], pt)
        if cs.fds[fi].pinout[j]:
            sig = sig + ", " + _cty(&cs, pt) + " *" + cn
            cs.vcn[len(cs.vcn) - 1] = "(*" + cn + ")"
            if _heap(&cs, pt):
                sig = sig + ", Arena *_ina_" + cn
                cs.vown[len(cs.vown) - 1] = "_ina_" + cn
        else:
            sig = sig + ", " + _cty(&cs, pt) + " " + cn
    sig = sig + ")"
    pm := len(cs.pk)
    b := _block(&cs, body, "    ")
    for i := pm; i < len(cs.pk); i += 1:
        if len(cs.ptv[i]) == 0:
            _bad("a bare [] with nothing to type it")
        b = _replace(b, "_PT" + str(cs.pk[i]), _cty(&cs, cs.ptv[i]))
        b = _replace(b, "_PE" + str(cs.pk[i]),
            _apfx(&cs, _elem(cs.ptv[i])) + "_with_cap(&_scope, 0)")
    _restore(&cs, m)
    out := sig + " {\n" +
        "    Arena _scope = arena_child(_parent); _scope.name = \"" + nm + "\";\n" + b
    if rt == "void":
        out = out + "    arena_free(&_scope);\n}\n"
    else:
        out = out + "    arena_free(&_scope);\n" +
            "    { fprintf(stderr, \"tycho: fell off the end of " + nm + "\\n\"); exit(1); }\n}\n"
    return (sig + ";\n", out)

# --- the unit ---------------------------------------------------------------

# `pfx[i]` is file i's package prefix -- "" for the ENTRY package, `<pkg>__`
# for every other, exactly as src/tychoc.c@pkg_prefix_for spells it. The files
# arrive in the loader's post-order, so a package's dependencies are collected
# before it is.
fn program(pfx: [string], us: [ast.Unit]) -> string:
    cs := _new()
    for x in pfx:
        push(cs.fpfx, x)
    for u0 in us:
        if len(u0.handles) > 0:
            _bad("handle declarations -- Phase 8")
        for sd in u0.subscripts:
            push(cs.subn, sd.name)
            push(cs.subp, sd.params)
            push(cs.sube, sd.place)
        for im in u0.imports:
            b := _pkg_base(im.path)
            push(cs.ala, b)
            push(cs.alp, b)
            if len(im.alias) > 0:
                push(cs.ala, im.alias)
                push(cs.alp, b)
    for i := 0; i < len(us); i += 1:
        cs.cf = i
        _collect1(&cs, us[i])
    _collect_nt(&cs)
    for i := 0; i < len(us); i += 1:
        cs.cf = i
        _collect2(&cs, us[i])
    cs.cf = -1
    if _fidx(&cs, "main") < 0:
        _bad("no 'main' procedure")

    fns := ""
    protos := ""
    for i := 0; i < len(us); i += 1:
        cs.cf = i
        for f in us[i].fns:
            if len(f.typarams) > 0:
                continue
            # An extern has NO Tycho body; emitting one gives every extern a
            # second, empty `h_<name>` definition beside the real C symbol.
            if f.is_extern:
                continue
            pc, bc := _fnbody(&cs, _fidx(&cs, f.name), f.body)
            protos = protos + pc
            fns = fns + bc
    # Stage 2: every generic instance discovered while emitting -- and every one
    # discovered while emitting THOSE -- gets its own body. The registry only
    # ever grows at the end, so a forward scan reaches the whole closure.
    for k := 0; k < len(cs.ikey); k += 1:
        if cs.pendk[k] < 0:
            continue
        fj := cs.pendk[k]
        cs.pendk[k] = -1
        parts := split(cs.ikey[k], "|")
        gi := _gfidx(&cs, parts[1])
        tg := []string
        for q := 2; q < len(parts); q += 1:
            push(tg, parts[q])
        mb := _bind(&cs, cs.gf[gi].typarams, tg)
        cs.cf = cs.gff[gi]
        pc2, bc2 := _fnbody(&cs, fj, cs.gf[gi].body)
        _unbind(&cs, mb)
        protos = protos + pc2
        fns = fns + bc2

    # Order matters in C: opaque typedefs, then the array structs (which name
    # element types only through pointers), then struct bodies in dependency
    # order, then the enum bodies (whose payloads may hold a struct by value).
    htd := "\n/* ---- generated from Tycho source ---- */\n\n"
    for sd in cs.sds:
        htd = htd + "typedef struct S_" + sd.name + "_ S_" + sd.name + ";\n"
    for ed in cs.eds:
        htd = htd + "typedef struct E_" + ed.name + " E_" + ed.name + ";\n"
    head := ""
    cs.arena = "&_scope"
    edefs, eproto, ebody := _enum_support(&cs)
    sproto, sbody := _struct_support(&cs)
    mtd, msb, mpr, mfb := _map_defs(&cs)
    nm := 0
    for nm != len(cs.mks):
        nm = len(cs.mks)
        mtd, msb, mpr, mfb = _map_defs(&cs)
    # DISCOVERY PRE-PASS. Each generator below has its own local fixpoint, run
    # in sequence, and `_tup_defs` runs LAST -- so an array/map/soa kind that
    # only a TUPLE introduces was registered after the array fixpoint had
    # finished and never got a body. That is Phase 7f: `struct TychoTup3_ {
    # TychoArrK17 f0; }` with no TychoArrK17 anywhere. Running the tuple
    # generator first for its REGISTRATIONS alone (output discarded, it is
    # regenerated in full below) lets the array fixpoint see those kinds.
    _pt1, _pt2, _pt3, _pt4 := _tup_defs(&cs)
    npre := 0
    for npre != len(cs.tks):
        npre = len(cs.tks)
        _pt1, _pt2, _pt3, _pt4 = _tup_defs(&cs)
    osb, ofb := _soa_defs(&cs)
    no := 0
    for no != len(cs.oks):
        no = len(cs.oks)
        osb, ofb = _soa_defs(&cs)
    atd, asb, afb := _arr_defs(&cs)
    nk := 0
    for nk != len(cs.akinds):
        nk = len(cs.akinds)
        atd, asb, afb = _arr_defs(&cs)
    htd = htd + mtd
    # `extern double strx_parse_double(char *, tycho_int *);` -- the foreign
    # symbol's prototype, matching ./tychoc. An inout parameter is a pointer.
    for xi := 0; xi < len(cs.fds); xi += 1:
        # The name is bound FIRST. Passing `cs.fds[xi].name` straight into a
        # call that also takes `&cs` reads a field of the very value being
        # borrowed, and the argument came out as a garbage pointer.
        xnm := cs.fds[xi].name
        if not _isext(&cs, xnm):
            continue
        xps := ""
        for xj := 0; xj < len(cs.fds[xi].ptypes); xj += 1:
            if xj > 0:
                xps = xps + ", "
            xps = xps + _cty(&cs, cs.fds[xi].ptypes[xj])
            if cs.fds[xi].pinout[xj]:
                xps = xps + " *"
        xrt := _cty(&cs, cs.fds[xi].ret)
        if cs.fds[xi].ret == "bytes":
            # A `bytes` return crosses the ABI as (ptr, len) OUT-PARAMETERS and
            # the C function returns void; the caller wraps them with
            # tycho_bytes_from_c. ./tychoc emits
            #   extern void iox_read_file(char *, tycho_int *,
            #                             unsigned char **, tycho_int *);
            # Returning char * instead passes 2 arguments where the shim reads
            # 4 -- which is why io.read_text answered NotFound for a file that
            # exists, and why dropping the argument copy turned it into a
            # segfault. A `string` return does NOT use this form.
            xrt = "void"
            if len(xps) > 0:
                xps = xps + ", "
            xps = xps + "unsigned char **, tycho_int *"
        if len(xps) == 0:
            xps = "void"
        head = head + "extern " + xrt + " " + cs.fds[xi].name +
            "(" + xps + ");\n"
    head = head + atd + asb + msb + osb
    for i in _struct_order(&cs):
        head = head + "struct S_" + cs.sds[i].name + "_ {\n"
        for j := 0; j < len(cs.sds[i].fnames); j += 1:
            head = head + "    " + _cty(&cs, cs.sds[i].ftypes[j]) + " f_" +
                cs.sds[i].fnames[j] + ";\n"
        if len(cs.sds[i].fnames) == 0:
            head = head + "    char _empty;\n"
        head = head + "};\n"
    ftd := _fn_defs(&cs)
    nfk := 0
    for nfk != len(cs.fks):
        nfk = len(cs.fks)
        ftd = _fn_defs(&cs)
    cpr, cbd := _clo_defs(&cs)
    lpr := ""
    lbd := ""
    for x in cs.lamp:
        lpr = lpr + x
    for x in cs.lamd:
        lbd = lbd + x
    ttd, tsb, tpr, tfb := _tup_defs(&cs)
    ntk := 0
    for ntk != len(cs.tks):
        ntk = len(cs.tks)
        ttd, tsb, tpr, tfb = _tup_defs(&cs)
    hpr, hfb := _hash_defs(&cs)
    head = htd + ttd + ftd + head + tsb + edefs + "\n" + _arr_protos(&cs) + sproto + eproto +
        tpr + mpr + hpr + "\n" + afb + sbody + ebody + tfb + hfb + mfb + ofb + "\n"

    entry := "\nint main(int argc, char **argv) {\n" +
        "    tycho_hash_seed_init();  /* random per-process map-hash seed, before any map use */\n" +
        "    tycho_argc = argc; tycho_argv = argv;  /* exposed to the program via args() */\n" +
        "    Arena _root = arena_new(0);  /* root arena; default block size */\n" +
        "    h_main(&_root);\n" +
        "    arena_free(&_root);\n" +
        "    return 0;\n}\n"
    return head + protos + cpr + lpr + "\n" + cbd + lbd + fns + entry
