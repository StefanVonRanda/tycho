                _restore(&cs, ms)
                return outs
            if not _is_arr(ct):
                _bad("for-in over '" + ct + "' -- only arrays here, maps are Phase 8")
            et := _elem(ct)
            fc := _fresh(&cs, "_fc")
            fi := _fresh(&cs, "_fi")
            m := _mark(&cs)
            fcn := _push(&cs, n, et)
            # The snapshot is what lets the body push to the array it is walking
            # without the walk following. A collection that came from a CALL is
            # already a private temporary in this arena, so there is nothing for
            # anyone else to mutate and nothing to snapshot.
            cc2 := cc
            # The snapshot is what lets the body push to the array it is walking
            # without the walk following. A body that never writes the collection
            # needs none -- and every AST walker in this compiler is that shape,
            # `for e in k:` over a child list, which was deep-copying the list and
            # every node under it at each level. Same test as the match arm's.
            if _place(c[0]) and _mut_b(b, _rootname(c[0])):
                cc2 = _copy(&cs, cc, ct, "&_scope")
            sva := cs.arena
            ida := _fresh(&cs, "_scr")
            push(cs.ascope, "&" + ida)
            cs.loopdepth += 1   # src/tychoc.c@g_loop_depth -- moves are unsafe inside a loop
            push(cs.lpost, -1)
            push(cs.lmark, _mark(&cs))
            cs.arena = "&" + ida
            foa, fna := _fuse_open(&cs, b, ind + "    ", c)
            bda := _block(&cs, b, ind + "        ")
            pop(cs.lpost)
            pop(cs.lmark)
            pop(cs.ascope)
            cs.loopdepth -= 1
            cs.arena = sva
            opena := ""
            resa := ""
            closa := ""
            uida, fida := _uses_scr(bda, ida)
            if uida:
                opena = ind + "    Arena " + ida + " = arena_child(" + sva + ");\n"
                resa = ind + "        arena_reset(&" + ida + ");\n"
                closa = ind + "    arena_free(&" + ida + ");\n"
            elif fida:
                bda = _replace(bda, "arena_free(&" + ida + "); ", "")
            out := ind + "{\n" + ind + "    " + _ctyz(&cs, "[" + et + "]") + "" + fc +
                " = " + cc2 + ";\n" + opena + foa +
                ind + "    for (tycho_int " + fi + " = 0; " + fi + " < " + fc +
                ".len; " + fi + " += 1) {\n" + resa +
                ind + "        " + _ctyz(&cs, et) + "" + fcn + " = " + fc + ".data[" + fi + "];\n" +
                bda + ind + "    }\n" + _fuse_close(&cs, fna, ind + "    ") + closa + ind + "}\n"
            _restore(&cs, m)
            return out
        ast.MatchS(l, subj, arms):
            return _match(&cs, subj[0], arms, ind)
        ast.MDecl(l, d, ns, r):
            rc, rt := _ex(&cs, r[0])
            if not _is_tup(rt):
                _bad("a destructuring list needs a tuple on the right")
            es := _telems(&cs, rt)
            if len(es) != len(ns):
                _bad("destructuring " + str(len(ns)) + " names from a " +
                    str(len(es)) + "-element tuple")
            tv := _fresh(&cs, "_ds")
            out := ind + _ctyz(&cs, rt) + "" + tv + " = " + rc + ";\n"
            # every target is read out of the temporary FIRST, so `a, b = b, a`
            # swaps rather than clobbering.
            cns := []string
            for i := 0; i < len(ns); i += 1:
                if d:
                    push(cns, "")
                else:
                    t2 := _vtype(&cs, ns[i])
                    if len(t2) == 0:
                        _bad("assignment to unknown name '" + ns[i] + "'")
                    push(cns, _vcname(&cs, ns[i]))
            for i := 0; i < len(ns); i += 1:
                v := "(" + tv + ".f" + str(i) + ")"
                # A tuple that came from a CALL was built in this arena already
                # -- the call was handed cs.arena as its _parent -- so reading a
                # field out of it needs no copy. `a, b := f(...)` is the shape
                # every recursive-descent function in this compiler returns, and
                # each one was copying both results back into the arena they were
                # already in. A PLACE on the right still belongs to someone else.
                # A single `x := f()` leaves the result wherever the call
                # built it and lets each USE copy; a destructuring one forced a
                # copy into &_scope too, which inside a loop body meant TWO deep
                # copies of every parser node -- one out of the scratch and one
                # at the push. The scratch is reset at the top of the NEXT
                # iteration, after the last read, so the value is good for the
                # whole iteration exactly as the single-name form assumes.
                # ...and only for a DECLARATION. An ASSIGNMENT writes a name
                # declared further out, which outlives this arena: `h_mtd =
                # (_ds.f0)` read after arena_free(&_scr) hands str_append a
                # garbage length header and it doubles nc until it overflows.
                if _heap(&cs, es[i]) and (_place(r[0]) or not d):
                    v = _copy(&cs, v, es[i], "&_scope")
                if d:
                    cn := _push(&cs, ns[i], es[i])
                    out = out + ind + _ctyz(&cs, es[i]) + "" + cn + " = " + v + ";\n"
                else:
                    out = out + ind + cns[i] + " = " + v + ";\n"
            return out
        ast.ForRange(l, n, c, b): _bad("stmt:ForRange -- Phase 8")
        ast.ParallelS(l, w, b):
            return _parfor(&cs, b, ind, w)
        ast.SelectS(l, a):
            return _select(&cs, a, ind)
        ast.DeleteS(l, k):
            match k[0]:
                ast.Index(l2, ix):
                    mc, mt := _lvalue(&cs, ix[0])
                    kc, kt := _ex(&cs, ix[1])
                    if not _is_map(mt):
                        _bad("`delete` takes a map element")
                    return ind + _mpfx(&cs, mt) + "_del(&(" + mc + "), " +
                        _keyrt(&cs, _mkey(&cs, mt), kc) + ");\n"
                _: _bad("`delete` takes a map element")
            return ""
        _: _bad("unsupported statement -- Phase 8")
    return ""

# The first value tail of a value-if/value-match, which is what types the
# variable being declared when there is no annotation.
fn _tail_expr(s: ast.Stmt) -> [ast.Expr]:
    match s:
        ast.ExprStmt(l, es): return es
        ast.IfS(l, c, b, e):
            if len(b) > 0:
                r := _tail_expr(b[len(b) - 1])
                if len(r) > 0:
                    return r
            if len(e) > 0:
                return _tail_expr(e[len(e) - 1])
            return []ast.Expr
        ast.MatchS(l, sub, arms):
            for a in arms:
                if len(a.body) > 0:
                    r2 := _tail_expr(a.body[len(a.body) - 1])
                    if len(r2) > 0:
                        return r2
            return []ast.Expr
        _: return []ast.Expr
    return []ast.Expr

# A for-3 post clause has to run on `continue`, so the loop is a real C `for`
# and the post statement becomes its third clause -- an expression, not a
# statement. tests/for3.ty documents why: `i` advances only there.
# The finalizer block, folded onto one line for a `{ ... return x; }` statement.
fn _oneline(s: string) -> string:
    out := ""
    for i := 0; i < len(s); i += 1:
        if s[i] == 10:
            out = out + " "
        else:
            out = out + s[i:i + 1]
    return out


fn _trim_nl(s: string) -> string:
    if len(s) > 0 and s[len(s) - 1] == 10:
        return s[0:len(s) - 1] + "\n"
    return s + "\n"

# A scalar pattern is a literal or the NAME of a const, which src/tychoc.c has
# already folded to one literal by the time it reaches here.
# --- match-arm payload borrow (deep-copy elision) ---------------------------
# Binding a heap payload deep-copies its whole subtree into the arm's arena. But
# the scrutinee's payload already outlives the match and an enum value is
# immutable, so the binding can BORROW it -- the same handoff an array parameter
# makes. The exception is an arm that WRITES THROUGH the binding: that write
# would reach into the matched value (tests/match_payload_mut.ty), so a mutated
# binding keeps its owning copy. ./tychoc does this in can_move_from's
# neighbourhood (src/tychoc.c@block_mutates); this is the same rule.
fn _mroot(e: ast.Expr) -> string:
    match e:
        ast.Name(l, n): return n
        ast.Field(l, k, f): return _mroot(k[0])
        ast.TupIdx(l, k, n): return _mroot(k[0])
        ast.Index(l, k): return _mroot(k[0])
        ast.Slice(l, a, b, k): return _mroot(k[0])
        ast.Addr(l, k): return _mroot(k[0])
        _: return ""
    return ""

# The children are walked through a parameter rather than a returned [Expr]:
# returning the child array is a RETENTION and deep-copies the whole subtree,
# which cost more than the copy this pass removes (measured: _mroot alone).
fn _mut_e(e: ast.Expr, nm: string) -> bool:
    match e:
        ast.Addr(l, k):
            if _mroot(k[0]) == nm:
                return true
            return _mut_es(k, nm)
        ast.Call(l, q, n, ts, k):
            # The three builtins that WRITE their receiver, which they take
            # first. Nothing else here can: an `inout` parameter needs `&x` at
            # the call site, and that is an Addr, caught above.
            #
            # This was once conservative at ANY unqualified call, which is the
            # shape of every recursive AST walker -- _mut_es(k, nm),
            # _names_in(kk, &out) -- so every walker deep-copied its payload at
            # every node, and so did every analysis written on top of one. The
            # two fixtures that made the conservative form look necessary were
            # the assignment-arena bug in 8fc08efc, not a mutation missed here.
            if len(q) == 0 and len(k) > 0 and (n == "push" or n == "pop" or n == "reserve"):
                if _mroot(k[0]) == nm:
                    return true
            return _mut_es(k, nm)
        ast.Field(l, k, f): return _mut_es(k, nm)
        ast.TupIdx(l, k, n): return _mut_es(k, nm)
        ast.Index(l, k): return _mut_es(k, nm)
        ast.Slice(l, a2, b2, k): return _mut_es(k, nm)
        ast.CallVal(l, k): return _mut_es(k, nm)
        ast.Named(l, n, k): return _mut_es(k, nm)
        ast.Binop(l, o, k): return _mut_es(k, nm)
        ast.Unop(l, o, k): return _mut_es(k, nm)
        ast.IsVar(l, k, q, n): return _mut_es(k, nm)
        ast.ArrLit(l, k): return _mut_es(k, nm)
        ast.MapLit(l, k): return _mut_es(k, nm)
        ast.Tuple(l, k): return _mut_es(k, nm)
        ast.SomeE(l, k): return _mut_es(k, nm)
        ast.OkE(l, k): return _mut_es(k, nm)
        ast.ErrE(l, k): return _mut_es(k, nm)
        ast.SpawnE(l, k): return _mut_es(k, nm)
        ast.OrRet(l, k): return _mut_es(k, nm)
        ast.Spread(l, k): return _mut_es(k, nm)
        ast.ChanE(l, t, k): return _mut_es(k, nm)
        ast.Lambda(l, pr, r, k): return _mut_es(k, nm)
        _: return false
    return false

fn _mut_es(k: [ast.Expr], nm: string) -> bool:
    for e in k:
        if _mut_e(e, nm):
            return true
    return false

fn _mut_arms(arms: [ast.Arm], nm: string) -> bool:
    for a in arms:
        if _mut_b(a.body, nm):
            return true
    return false

fn _mut_s(s: ast.Stmt, nm: string) -> bool:
    match s:
        ast.ExprStmt(l, k): return _mut_es(k, nm)
        ast.Decl(l, n, t, k, vb): return _mut_es(k, nm) or _mut_b(vb, nm)
        ast.MDecl(l, d, ns, k):
            for n2 in ns:
                if n2 == nm:
                    return true
            return _mut_es(k, nm)
        ast.Assign(l, n, k):
            if n == nm:
                return true
            return _mut_es(k, nm)
        ast.PlaceSet(l, k):
            if len(k) > 0 and _mroot(k[0]) == nm:
                return true
            return _mut_es(k, nm)
        ast.ConstS(l, n, k): return _mut_es(k, nm)
        ast.ReturnS(l, k): return _mut_es(k, nm)
        ast.IfS(l, c, b, e2): return _mut_es(c, nm) or _mut_b(b, nm) or _mut_b(e2, nm)
        ast.WhileS(l, c, b): return _mut_es(c, nm) or _mut_b(b, nm)
        ast.For3(l, i2, c, b): return _mut_b(i2, nm) or _mut_es(c, nm) or _mut_b(b, nm)
        ast.ForIn(l, n, k, b): return _mut_es(k, nm) or _mut_b(b, nm)
        ast.ForRange(l, n, k, b): return _mut_es(k, nm) or _mut_b(b, nm)
        ast.ParallelS(l, k, b): return _mut_es(k, nm) or _mut_b(b, nm)
        ast.MatchS(l, k, arms): return _mut_es(k, nm) or _mut_arms(arms, nm)
        ast.SelectS(l, arms): return _mut_arms(arms, nm)
        ast.DeleteS(l, k):
            if len(k) > 0 and _mroot(k[0]) == nm:
                return true
            return _mut_es(k, nm)
        _: return false
    return false

fn _mut_b(b: [ast.Stmt], nm: string) -> bool:
    for s in b:
        if _mut_s(s, nm):
            return true
    return false

fn _patv(cs: inout C, kind: string, v: int, nm: string) -> string:
    if kind == "name":
        ci := _cidx(&cs, nm)
        if ci >= 0:
            return cs.ccode[ci]
        t := _vtype(&cs, nm)
        if len(t) > 0:
            return _vcname(&cs, nm)
        _bad("unknown name '" + nm + "' in a match pattern")
    return _ilit(v)

# src/tychoc.c:12163 prints the arm's resolved value with %lld -- no suffix.
fn _pats(cs: inout C, kind: string, v: int, nm: string) -> string:
    if kind == "name":
        return _patv(&cs, kind, v, nm)
    return str(v)

fn _match(cs: inout C, subj: ast.Expr, arms: [ast.Arm], ind: string) -> string:
    sc, st := _ex(&cs, subj)
    v := _fresh(&cs, "_m")
    # A payload binding that is NOT deep-copied is a BORROW into the subject's
    # own storage, so it lives in the SUBJECT's arena -- not in whichever loop
    # scratch happens to be open. Recording the scratch made `sp = bk[0]`
    # (walking a spine by rebinding an outer local) deep-copy the subtree once
    # per iteration: 36e6 Ir in _acc_scan alone. A subject with no root name is
    # a temporary built in cs.arena, which is the honest answer for it.
    sown := cs.arena
    if len(_rootname(subj)) > 0:
        sown = _ownerof(&cs, subj)
    if _is_enum(st):
        ei := _eidx(&cs, _tname(st))
        out := ind + "{\n" + ind + "    E_" + _tname(st) + " *" + v + " = " + sc + ";\n"
        first := true
        deflt := ""
        hasdef := false
        for a in arms:
            if a.kind == "default" or a.name == "_":
                deflt = _block(&cs, a.body, ind + "        ")
                hasdef = true
                continue
            if a.kind != "variant":
                _bad("unsupported match arm on an enum")
            tag := _tag(&cs, ei, a.name)
            pay := cs.eds[ei].vpay[tag].ptypes
            head := ind + "    if"
            if not first:
                head = ind + "    else if"
            first = false
            m := _mark(&cs)
            binds := ""
            nulsub := ""
            for i := 0; i < len(a.binds); i += 1:
                if i >= len(pay):
                    _bad("variant " + a.name + " binds more than its payload")
                # `Err(NotFound)` -- a NULLARY nested variant. It has no parens,
                # so the parser cannot tell it from a binding name and files it
                # under binds; only the payload's own variant list can. Without
                # this the arm emits no inner tag test and swallows every Err.
                pei := _eidx(&cs, _tname(pay[i]))
                nt := -1
                if pei >= 0:
                    nt = _tagopt(&cs, pei, a.binds[i])
                if nt >= 0:
                    nulsub = str(nt)
                    continue
                # BY VALUE, deep-copied: ./tychoc binds a payload as a copy, so
                # `xs[0] = 50` inside the arm leaves the matched value alone
                # (tests/match_payload_mut.out). A pointer binding aliased it.
                # src/tychoc.c@bind_is_discard: `_` fills a payload slot and
                # binds nothing -- two of them in one pattern would otherwise
                # emit two C locals named h__.
                if a.binds[i] == "_":
                    continue
                bcn := _push(&cs, a.binds[i], pay[i])
                psrc := v + "->u." + a.name + ".f" + str(i)
                pv := psrc
                cs.vown[len(cs.vown) - 1] = sown
                if _mut_b(a.body, a.binds[i]):
                    pv = _copy(&cs, psrc, pay[i], cs.arena)
                    cs.vown[len(cs.vown) - 1] = cs.arena
                binds = binds + ind + "        " + _ctyz(&cs, pay[i]) + "" + bcn +
                    " = " + pv + ";\n"
            # A NESTED pattern -- `Err(TooBig(n))`. The Arm has carried
            # sub/subbinds since the parser, and nothing read them until now, so
            # the inner binding was simply never in scope. The payload is itself
            # an enum: test its tag too, and bind from ITS payload.
            cond := v + "->tag == " + str(tag)
            if len(nulsub) > 0:
                cond = "(" + cond + ") && ((" + v + "->u." + a.name + ".f0)->tag == " + nulsub + ")"
            if len(a.sub) > 0:
                if len(pay) != 1:
                    _bad("a nested pattern needs a single-payload variant")
                ii := _eidx(&cs, _tname(pay[0]))
                if ii < 0:
                    _bad("nested pattern on a non-enum payload '" + pay[0] + "'")
                itag := _tag(&cs, ii, a.sub)
                iv := v + "->u." + a.name + ".f0"
                cond = "(" + cond + ") && ((" + iv + ")->tag == " + str(itag) + ")"
                ipay := cs.eds[ii].vpay[itag].ptypes
                for j := 0; j < len(a.subbinds); j += 1:
                    if j >= len(ipay):
                        _bad("variant " + a.sub + " binds more than its payload")
                    if a.subbinds[j] == "_":
                        continue
                    scn := _push(&cs, a.subbinds[j], ipay[j])
                    ssrc := "(" + iv + ")->u." + a.sub + ".f" + str(j)
                    sv2 := ssrc
                    cs.vown[len(cs.vown) - 1] = sown
                    if _mut_b(a.body, a.subbinds[j]):
                        sv2 = _copy(&cs, ssrc, ipay[j], cs.arena)
                        cs.vown[len(cs.vown) - 1] = cs.arena
                    binds = binds + ind + "        " + _ctyz(&cs, ipay[j]) + "" + scn +
                        " = " + sv2 + ";\n"
            body := _block(&cs, a.body, ind + "        ")
            _restore(&cs, m)
            out = out + head + " (" + cond + ") {\n" + binds + body +
                ind + "    }\n"
        if first:
            return out + deflt + ind + "}\n"
        if hasdef:
            out = out + ind + "    else {\n" + deflt + ind + "    }\n"
        else:
            out = out + ind + "    else { fprintf(stderr, \"tycho: non-exhaustive match\\n\"); exit(1); }\n"
        return out + ind + "}\n"
    # scalar subject
    out2 := ind + "{\n" + ind + "    " + _ctyz(&cs, st) + "" + v + " = " + sc + ";\n"
    first2 := true
    deflt2 := ""
    hasdef2 := false
    for a in arms:
        if a.kind == "default" or a.name == "_":
            deflt2 = _block(&cs, a.body, ind + "        ")
            hasdef2 = true
            continue
        # A bare NAME arm on a scalar subject parses as a `variant` -- nothing
        # in the syntax separates `OP_LOAD:` (an int const) from an enum
        # variant. On a scalar it is the const's value.
        pats := a.pats
        if a.kind == "variant" and len(pats) == 0 and len(a.name) > 0:
            push(pats, ast.Pat("name", 0, 0, a.name, "", false))
        elif a.kind != "scalar":
            _bad("unsupported match arm on a scalar")
        # src/tychoc.c:12162-12169 -- each piece is bare `_mN == K`, the
        # literal in plain decimal (the subject is already its own C type, so
        # the LL suffix an int expression carries is not written here), and the
        # pieces are joined by `||` with no parentheses at all.
        cond := ""
        for p in pats:
            one := ""
            if p.ranged:
                one = v + " >= " + _pats(&cs, p.kind, p.lo, p.loname) + " && " + v +
                    " <= " + _pats(&cs, p.kind, p.hi, p.hiname)
            else:
                one = v + " == " + _pats(&cs, p.kind, p.lo, p.loname)
            if len(cond) > 0:
                cond = cond + " || "
            cond = cond + one
        head2 := ind + "    if"
        if not first2:
            head2 = ind + "    else if"
        first2 = false
        out2 = out2 + head2 + " (" + cond + ") {\n" + _block(&cs, a.body, ind + "        ") +
            ind + "    }\n"
    if first2:
        return out2 + deflt2 + ind + "}\n"
    if hasdef2:
        out2 = out2 + ind + "    else {\n" + deflt2 + ind + "    }\n"
    else:
        # src/tychoc.c:12187 -- unreachable, and emitted anyway so the generated
        # C provably returns on every path.
        out2 = out2 + ind + "    else { fprintf(stderr, \"tycho: non-exhaustive match\\n\"); exit(1); }\n"
    return out2 + ind + "}\n"

# --- declaration collection -------------------------------------------------

# Two passes, because a package's files are collected in one go and a name may
# be declared in a LATER file of the same package -- src/tychoc.c merges every
# file's declarations before it resolves any of them. Pass 1 registers the
# names (already package-mangled); pass 2 resolves the types those names carry.

fn _collect1(cs: inout C, u: ast.Unit):
    p := _pfx(&cs)
    for sd in u.structs:
        if len(sd.typarams) > 0:
            push(cs.gs, ast.StructD(p + sd.name, sd.typarams, sd.fields, sd.line))
            push(cs.gsf, cs.cf)
        else:
            push(cs.sds, SD(p + sd.name, [], [], []))
    for ed in u.enums:
        if len(ed.typarams) > 0:
            push(cs.ge, ast.EnumD(p + ed.name, ed.typarams, ed.variants, ed.line))
            push(cs.gef, cs.cf)
        else:
            push(cs.eds, ED(p + ed.name, [], []))
            push(cs.edp, p)
    for nt in u.newtypes:
        push(cs.ntn, p + nt.name)
        push(cs.ntu, "")
        push(cs.ntt, nt.under)
        push(cs.ntf, cs.cf)
    for f in u.fns:
        if len(f.typarams) > 0:
            push(cs.gf, ast.Fn(p + f.name, f.params, f.ret, f.typarams, f.wheres,
                f.body, f.is_extern, f.lib, f.dnote, f.line))
            push(cs.gff, cs.cf)

# A newtype over a LATER newtype is legal -- and, across packages, over one
# declared in a file collected earlier -- so resolve only the ones whose every
# named part is already known and repeat until nothing moves. Each is resolved
# with its OWN file current, which is what makes an unqualified name in it
# resolve against its own package.
fn _collect_nt(cs: inout C):
    save := cs.cf
    for pas := 0; pas <= len(cs.ntn); pas += 1:
        for i := 0; i < len(cs.ntn); i += 1:
            cs.cf = cs.ntf[i]
            if len(cs.ntu[i]) == 0 and _ty_ready(&cs, cs.ntt[i]):
                cs.ntu[i] = _ty(&cs, cs.ntt[i])
    for i := 0; i < len(cs.ntn); i += 1:
        cs.cf = cs.ntf[i]
        if len(cs.ntu[i]) == 0:
            cs.ntu[i] = _ty(&cs, cs.ntt[i])
    cs.cf = save

fn _collect2(cs: inout C, u: ast.Unit):
    p := _pfx(&cs)
    for i := 0; i < len(u.structs); i += 1:
        if len(u.structs[i].typarams) > 0:
            continue
        si := _sidx(&cs, u.structs[i].name)
        for f in u.structs[i].fields:
            push(cs.sds[si].fnames, f.name)
            push(cs.sds[si].ftypes, _ty(&cs, f.ty))
            push(cs.sds[si].fcaps, _capof(&cs, f.ty))
    for i := 0; i < len(u.enums); i += 1:
        if len(u.enums[i].typarams) > 0:
            continue
        ei := _eidx(&cs, u.enums[i].name)
        for v in u.enums[i].variants:
            push(cs.eds[ei].vnames, v.name)
            ps := []string
            for pt2 in v.payload:
                push(ps, _ty(&cs, pt2))
            push(cs.eds[ei].vpay, VD(v.name, ps))
    for f in u.fns:
        if len(f.typarams) > 0:
            continue
        if f.is_extern:
            push(cs.exn, f.name)
        pn := []string
        pt := []string
        pio := []bool
        psk := []bool
        psz := []string
        pv := false
        for pp in f.params:
            if len(pp.ty) == 0:
                _bad("untyped parameter on '" + f.name + "'")
            one := _ty(&cs, pp.ty[0])
            if pp.is_variadic:
                pv = true
                one = "[" + one + "]"
            push(pn, pp.name)
            push(pt, one)
            push(pio, pp.is_inout)
            push(psk, pp.is_sink)
            push(psz, _sizep_of(pp.ty))
        nmf := p + f.name
        if f.is_extern:
            nmf = f.name
        push(cs.fds, FD(nmf, pn, pt, pio, psk, pv, _tyo(&cs, f.ret), psz))
    for c in u.consts:
        cc, ct := _ex(&cs, c.value)
        push(cs.cnames, p + c.name)
        push(cs.ctypes, ct)
        push(cs.ccode, cc)

# --- the generated support code ---------------------------------------------

fn _soa_defs(cs: inout C) -> (string, string):
    sb := ""
    fb := ""
    i := 0
    for i < len(cs.oks):
        st := cs.oks[i]
        ct := "Soa" + str(i)
        et := _cty(&cs, st)
        si := _sidx(&cs, _tname(st))
        fns := cs.sds[si].fnames
        fts := cs.sds[si].ftypes
        flds := ""
        for j := 0; j < len(fns); j += 1:
            flds = flds + _ctyz(&cs, fts[j]) + "*f" + str(j) + "; "
        sb = sb + "typedef struct { " + flds + "tycho_int len; tycho_int cap; } " + ct + ";\n"
        sb = sb + "static tycho_int " + ct + "_bound(" + ct + " *s, tycho_int i) { " +
            "if (i < 0 || i >= s->len) { fprintf(stderr, \"tycho: index %\" TY_PRId " +
            "\" out of bounds (len %\" TY_PRId \")\\n\", i, s->len); exit(1); } return i; }\n"
        # Prototypes: a struct's own eq/str is emitted BEFORE these bodies and
        # can call them (a struct field may be a soa -- tests/soa.ty's Bag).
        sb = sb + "static void " + ct + "_push(Arena*, " + ct + "*, " + et + ");\n" +
            "static void " + ct + "_set(Arena*, " + ct + "*, tycho_int, " + et + ");\n" +
            "static " + et + " " + ct + "_pop(" + ct + "*);\n" +
            "static " + et + " " + ct + "_get(" + ct + "*, tycho_int);\n" +
            "static " + ct + " " + ct + "_copy(Arena*, " + ct + ");\n" +
            "static int " + ct + "_eq(" + ct + ", " + ct + ");\n"
        grow := ""
        stores := ""
        gath := ""
        cpy := ""
        eqs := ""
        for j := 0; j < len(fns); j += 1:
            c := _cty(&cs, fts[j])
            f := "f" + str(j)
            grow = grow + "        " + c + " *n" + str(j) + " = (" + c +
                " *)arena_alloc(a, (size_t)nc * sizeof(" + c + " )); for (tycho_int i = 0; i < s->len; i++) n" +
                str(j) + "[i] = s->" + f + "[i]; s->" + f + " = n" + str(j) + ";\n"
            stores = stores + "    s->" + f + "[s->len] = v.f_" + fns[j] + ";\n"
            if len(gath) > 0:
                gath = gath + ", "
            gath = gath + "s->" + f + "[_i]"
            cpy = cpy + "    r." + f + " = s.len ? (" + c + " *)arena_alloc(a, (size_t)s.len * sizeof(" +
                c + " )) : 0;\n    for (tycho_int i = 0; i < s.len; i++) r." + f + "[i] = s." + f + "[i];\n"
            if len(eqs) > 0:
                eqs = eqs + " && "
            # a heap field cannot be compared with `==`; _eq picks the right
            # comparison per type (soa_scatter_heap holds an array per element).
            eqs = eqs + "(" + _eq(&cs, "a." + f + "[i]", "b." + f + "[i]", fts[j]) + ")"
        fb = fb + "static void " + ct + "_push(Arena *a, " + ct + " *s, " + et + " v) {\n" +
            "    if (s->len == s->cap) {\n        tycho_int nc = s->cap ? s->cap * 2 : 4;\n" +
            grow + "        s->cap = nc;\n    }\n" + stores + "    s->len++;\n}\n"
        sets := ""
        for j := 0; j < len(fns); j += 1:
            sets = sets + "    s->f" + str(j) + "[_si] = v.f_" + fns[j] + ";\n"
        fb = fb + "static void " + ct + "_set(Arena *a, " + ct + " *s, tycho_int ix, " +
            et + " v) {\n    tycho_int _si = " + ct + "_bound(s, ix);\n" + sets + "}\n"
        fb = fb + "static " + et + " " + ct + "_pop(" + ct + " *s) {\n" +
            "    if (s->len == 0) { fprintf(stderr, \"tycho: pop from an empty array\\n\"); exit(1); }\n" +
            "    s->len--;\n    tycho_int _i = s->len;\n    return (" + et + "){ " + gath + " };\n}\n"
        fb = fb + "static " + et + " " + ct + "_get(" + ct + " *s, tycho_int ix) {\n" +
            "    tycho_int _i = " + ct + "_bound(s, ix);\n    return (" + et + "){ " + gath + " };\n}\n"
        fb = fb + "static " + ct + " " + ct + "_copy(Arena *a, " + ct + " s) {\n" +
            "    " + ct + " r; r.len = s.len; r.cap = s.len;\n" + cpy + "    return r;\n}\n"
        fb = fb + "static int " + ct + "_eq(" + ct + " a, " + ct + " b) {\n" +
            "    if (a.len != b.len) return 0;\n" +
            "    for (tycho_int i = 0; i < a.len; i++) if (!(" + eqs + ")) return 0;\n    return 1;\n}\n"
        i += 1
    return (sb, fb)


# Only the kinds from `start` on. Emitting one array kind can stamp another, so
# the caller loops until the count stops moving -- regenerating every kind each
# time made this the single most expensive function in a compile (callgrind:
# 5.9% in memcpy under its string building alone).
fn _arr_defs(cs: inout C) -> (string, string, string, string):
    # (typedefs, struct bodies, prototypes, function bodies) per array kind.
    # Every operation is gated on its own: an array that is pushed to and read
    # gets _push and _get, and not the other nine. Re-runnable -- a kind whose
    # _copy only becomes live later picks it up on the next pass.
    td := ""
    sb := ""
    pr := ""
    fb := ""
    i := 0
    for i < len(cs.akinds):
        e := cs.akinds[i]
        k := "K" + str(i)
        ct := "TychoArr" + k
        et := _cty(&cs, e)
        p := "tycho_arr_" + k
        if _once(&cs, "def_" + k):
            td = td + "typedef struct " + ct + "_ " + ct + ";\n"
            sb = sb + "struct " + ct + "_ { " + et + " *data; tycho_int len; tycho_int cap; };\n"
        if _need(&cs, p + "_with_cap"):
            pr = pr + "static " + ct + " " + p + "_with_cap(Arena *, tycho_int);\n"
            fb = fb + "static " + ct + " " + p + "_with_cap(Arena *a, tycho_int cap) {\n" +
                "    " + ct + " r; r.len = 0; r.cap = cap;\n" +
                "    r.data = cap > 0 ? (" + et + " *)arena_alloc(a, (size_t)cap * sizeof(" + et + ")) : 0;\n" +
                "    return r;\n}\n"
        if _need(&cs, p + "_push"):
            pr = pr + "static void " + p + "_push(Arena *, " + ct + " *, " + et + ");\n"
            fb = fb + "static void " + p + "_push(Arena *a, " + ct + " *xs, " + et + " v) {\n" +
                "    if (xs->len == xs->cap) {\n" +
                "        tycho_int nc = xs->cap ? xs->cap * 2 : 4;\n" +
                "        " + et + " *nd = (" + et + " *)arena_alloc(a, (size_t)nc * sizeof(" + et + "));\n" +
                "        for (tycho_int i = 0; i < xs->len; i++) nd[i] = xs->data[i];\n" +
                "        xs->data = nd; xs->cap = nc;\n    }\n" +
                "    xs->data[xs->len++] = v;\n}\n"
        if _need(&cs, p + "_grow"):
            pr = pr + "static void " + p + "_grow(Arena *, " + et + " **, tycho_int *, tycho_int);\n"
            fb = fb + "static void " + p + "_grow(Arena *a, " + et + " **data, tycho_int *cap, tycho_int len) {\n" +
                "    tycho_int nc = *cap ? *cap * 2 : 4;\n" +
                "    " + et + " *nd = (" + et + " *)arena_alloc(a, (size_t)nc * sizeof(" + et + "));\n" +
                "    for (tycho_int i = 0; i < len; i++) nd[i] = (*data)[i];\n" +
                "    *data = nd; *cap = nc;\n}\n"
        if _need(&cs, p + "_reserve"):
            pr = pr + "static void " + p + "_reserve(Arena *, " + ct + " *, tycho_int);\n"
            fb = fb + "static void " + p + "_reserve(Arena *a, " + ct + " *xs, tycho_int n) {\n" +
                "    if (n <= xs->cap) return;\n" +
                "    " + et + " *nd = (" + et + " *)arena_alloc(a, (size_t)n * sizeof(" + et + "));\n" +
                "    for (tycho_int i = 0; i < xs->len; i++) nd[i] = xs->data[i];\n" +
                "    xs->data = nd; xs->cap = n;\n}\n"
        if _need(&cs, p + "_pop"):
            pr = pr + "static " + et + " " + p + "_pop(Arena *, " + ct + " *);\n"
            fb = fb + "static " + et + " " + p + "_pop(Arena *a, " + ct + " *xs) {\n" +
                "    if (xs->len == 0) { fprintf(stderr, \"tycho: pop from an empty array\\n\"); exit(1); }\n" +
                "    xs->len--;\n    return xs->data[xs->len];\n}\n"
        if _need(&cs, p + "_get"):
            pr = pr + "static " + et + " " + p + "_get(" + ct + ", tycho_int);\n"
            fb = fb + "static " + et + " " + p + "_get(" + ct + " xs, tycho_int i) {\n" +
                "    if (i < 0 || i >= xs.len) { fprintf(stderr, \"tycho: index %\" TY_PRId \" out of bounds (len %\" TY_PRId \")\\n\", i, xs.len); exit(1); }\n" +
                "    return xs.data[i];\n}\n"
        if _need(&cs, p + "_ptr"):
            pr = pr + "static " + et + " *" + p + "_ptr(" + ct + " *, tycho_int);\n"
            fb = fb + "static " + et + " *" + p + "_ptr(" + ct + " *xs, tycho_int i) {\n" +
                "    if (i < 0 || i >= xs->len) { fprintf(stderr, \"tycho: index %\" TY_PRId \" out of bounds (len %\" TY_PRId \")\\n\", i, xs->len); exit(1); }\n" +
                "    return &xs->data[i];\n}\n"
        if _need(&cs, p + "_copy"):
            wc := _u(&cs, p + "_with_cap")
            pr = pr + "static " + ct + " " + p + "_copy(Arena *, " + ct + ");\n"
            fb = fb + "static " + ct + " " + p + "_copy(Arena *a, " + ct + " src) {\n" +
                "    " + ct + " r = " + wc + "(a, src.len); r.len = src.len;\n" +
                "    for (tycho_int i = 0; i < src.len; i++) r.data[i] = " +
                _copy(&cs, "src.data[i]", e, "a") + ";\n    return r;\n}\n"
        if _need(&cs, p + "_eq"):
            pr = pr + "static int " + p + "_eq(" + ct + ", " + ct + ");\n"
            fb = fb + "static int " + p + "_eq(" + ct + " x, " + ct + " y) {\n" +
                "    if (x.len != y.len) return 0;\n" +
                "    for (tycho_int i = 0; i < x.len; i++) if (!" +
                _eq(&cs, "x.data[i]", "y.data[i]", e) + ") return 0;\n    return 1;\n}\n"
        if _need(&cs, "tycho_str_arr_" + k):
            pr = pr + "static char *tycho_str_arr_" + k + "(Arena *, " + ct + ");\n"
            fb = fb + "static char *tycho_str_arr_" + k + "(Arena *a, " + ct + " xs) {\n" +
                "    char *r = tycho_str_from_c(a, \"[\");\n" +
                "    for (tycho_int i = 0; i < xs.len; i++) {\n" +
                "        if (i) r = tycho_str_concat(a, r, tycho_str_from_c(a, \", \"));\n" +
                "        r = tycho_str_concat(a, r, " + _tostr_a(&cs, "xs.data[i]", e) + ");\n    }\n" +
                "    return tycho_str_concat(a, r, tycho_str_from_c(a, \"]\"));\n}\n"
        if _hashable(&cs, e):
            if _need(&cs, p + "_hash"):
                pr = pr + "static uint64_t " + p + "_hash(" + ct + ");\n"
                fb = fb + "static uint64_t " + p + "_hash(" + ct + " x) {\n" +
                    "    uint64_t h = tycho_hash_k0;\n" +
                    "    for (tycho_int i = 0; i < x.len; i++) h = h * UINT64_C(1099511628211) ^ " +
                    _hash(&cs, e, "x.data[i]") + ";\n    return h;\n}\n"
            if _need(&cs, p + "_dhash"):
                pr = pr + "static uint64_t " + p + "_dhash(" + ct + ");\n"
                fb = fb + "static uint64_t " + p + "_dhash(" + ct + " x) {\n" +
                    "    uint64_t h = UINT64_C(0x9e3779b97f4a7c15);\n" +
                    "    for (tycho_int i = 0; i < x.len; i++) h = h * UINT64_C(1099511628211) ^ " +
                    _hash_det(&cs, e, "x.data[i]") + ";\n    return h;\n}\n"
        i += 1
    return (td, sb, pr, fb)

fn _tup_plain(cs: inout C, i: int) -> bool:
    for e in split(cs.tks[i], "|"):
        if _is_struct(e) or _is_tup(e) or _is_map(e) or _is_soa(e) or _is_arr(e):
            return false
    return true

fn _tup_defs(cs: inout C) -> (string, string, string, string):
    # (typedefs, struct bodies, prototypes, function bodies) per tuple kind.
    td := ""
    sb := ""
    pr := ""
    fb := ""
    i := 0
    for i < len(cs.tks):
        es := split(cs.tks[i], "|")
        ct := "TychoTup" + str(i)
        if _once(&cs, "def_T" + str(i)):
            fl := ""
            for j := 0; j < len(es); j += 1:
                fl = fl + " " + _ctyz(&cs, es[j]) + "f" + str(j) + ";"
            td = td + "typedef struct " + ct + "_ " + ct + ";\n"
            if _tup_plain(&cs, i):
                td = td + "struct " + ct + "_ {" + fl + " };\n"
            else:
                sb = sb + "struct " + ct + "_ {" + fl + " };\n"
        doeq := _need(&cs, "tycho_eq_T" + str(i))
        dost := _need(&cs, "tycho_str_T" + str(i))
        docp := false
        if _heap(&cs, "T~" + str(i)):
            docp = _need(&cs, "tycho_copy_T" + str(i))
        if doeq:
            pr = pr + "static int tycho_eq_T" + str(i) + "(" + ct + ", " + ct + ");\n"
        if dost:
            pr = pr + "static char *tycho_str_T" + str(i) + "(Arena *, " + ct + ");\n"
        eq := ""
        st := "    char *r = tycho_str_from_c(a, \"(\");\n"
        for j := 0; j < len(es); j += 1:
            if not (doeq or dost):
                continue
            if j > 0:
                if doeq:
                    eq = eq + " && "
                if dost:
                    st = st + "    r = tycho_str_concat(a, r, tycho_str_from_c(a, \", \"));\n"
            if doeq:
                eq = eq + _eq(&cs, "x.f" + str(j), "y.f" + str(j), es[j])
            if dost:
                st = st + "    r = tycho_str_concat(a, r, " + _tostr_a(&cs, "v.f" + str(j), es[j]) + ");\n"
        if len(eq) == 0:
            eq = "1"
        if doeq:
            fb = fb + "static int tycho_eq_T" + str(i) + "(" + ct + " x, " + ct + " y) {\n" +
                "    return " + eq + ";\n}\n"
        if dost:
            fb = fb + "static char *tycho_str_T" + str(i) + "(Arena *a, " + ct + " v) {\n" + st +
                "    return tycho_str_concat(a, r, tycho_str_from_c(a, \")\"));\n}\n"
        if docp:
            pr = pr + "static " + ct + " tycho_copy_T" + str(i) + "(Arena *, " + ct + ");\n"
            cp := "static " + ct + " tycho_copy_T" + str(i) + "(Arena *a, " + ct + " v) {\n" +
                "    " + ct + " r = v;\n"
            for j := 0; j < len(es); j += 1:
                if _heap(&cs, es[j]):
                    cp = cp + "    r.f" + str(j) + " = " + _copy(&cs, "v.f" + str(j), es[j], "a") + ";\n"
            fb = fb + cp + "    return r;\n}\n"
        i += 1
    return (td, sb, pr, fb)

fn _map_defs(cs: inout C) -> (string, string, string, string):
    td := ""
    sb := ""
    pr := ""
    fb := ""
    i := 0
    for i < len(cs.mks):
        mt := "M~" + str(i)
        kt := _mkey(&cs, mt)
        vt := _mval(&cs, mt)
        ct := "TychoMapM" + str(i)
        p := "tycho_mapM" + str(i)
        ks := _kslot(&cs, kt)
        vc := _ctyz(&cs, vt) + ""
        kp := ks + "k"
        kcp := _kcopy(&cs, kt)
        vcp := _copy(&cs, "v", vt, "a")
        kat := _cty(&cs, "[" + kt + "]")
        # keys() builds its answer with the key array's with_cap and push
        kwc := _arrf(&cs, kt, "_with_cap")
        kpu := _arrf(&cs, kt, "_push")
        kel := "m.ekeys[e]"
        if _kclass(&cs, kt) == "enum":
            kel = "_sing_tab_" + _tname(kt) + "[m.ekeys[e]]"
        td = td + "typedef struct " + ct + "_ " + ct + ";\n"
        sb = sb + "struct " + ct + "_ { " + ks + "*ekeys; " + vc +
            "*evals; unsigned char *elive; int *idx; tycho_int len; tycho_int ecount; tycho_int ecap; tycho_int icap; };\n"
        pr = pr +
            "static " + ct + " " + p + "_with_cap(Arena *, tycho_int);\n" +
            "static void " + p + "_reserve(Arena *, " + ct + " *, tycho_int);\n" +
            "static tycho_int " + p + "_find(" + ct + ", " + kp + ");\n" +
            "static void " + p + "_idxput(" + ct + " *, tycho_int);\n" +
            "static void " + p + "_idxgrow(Arena *, " + ct + " *);\n" +
            "static void " + p + "_compact(" + ct + " *);\n" +
            "static tycho_int " + p + "_append(Arena *, " + ct + " *, " + kp + ", " + vc + "v);\n" +
            "static void " + p + "_put(Arena *, " + ct + " *, " + kp + ", " + vc + "v);\n" +
            "static " + vc + "*" + p + "_slotptr(Arena *, " + ct + " *, " + kp + ");\n" +
            "static void " + p + "_del(" + ct + " *, " + kp + ");\n" +
            "static " + ct + " " + p + "_copy(Arena *, " + ct + ");\n" +
            "static " + vc + p + "_get(" + ct + ", " + kp + ", " + vc + "dflt);\n" +
            "static int " + p + "_has(" + ct + ", " + kp + ");\n" +
            "static " + kat + " " + p + "_keys(Arena *, " + ct + ");\n" +
            "static int " + p + "_eq(" + ct + ", " + ct + ");\n" +
            "static char *tycho_str_mapM" + str(i) + "(Arena *, " + ct + ");\n"
        fb = fb +
            "static " + ct + " " + p + "_with_cap(Arena *a, tycho_int cap) {\n" +
            "    " + ct + " m; m.len = 0; m.ecount = 0;\n" +
            "    if (cap <= 0) { m.ekeys = 0; m.evals = 0; m.elive = 0; m.idx = 0; m.ecap = 0; m.icap = 0; return m; }\n" +
            "    tycho_int ec = 4; while (ec < cap) ec *= 2; tycho_int ic = 8; while (ic < cap * 2) ic *= 2; m.ecap = ec; m.icap = ic;\n" +
            "    m.ekeys = (" + ks + "*)arena_alloc(a, (size_t)ec * sizeof(" + ks + "));\n" +
            "    m.evals = (" + vc + "*)arena_alloc(a, (size_t)ec * sizeof(" + vc + "));\n" +
            "    m.elive = (unsigned char *)arena_alloc(a, (size_t)ec);\n" +
            "    m.idx = (int *)arena_alloc(a, (size_t)ic * sizeof(int));\n" +
            "    for (tycho_int i = 0; i < ic; i++) m.idx[i] = 0; return m;\n}\n" +
            "static void " + p + "_reserve(Arena *a, " + ct + " *m, tycho_int cap) {\n" +
            "    if (cap <= 0) return;\n" +
            "    tycho_int ec = 4; while (ec < cap) ec *= 2; tycho_int ic = 8; while (ic < cap * 2) ic *= 2;\n" +
            "    if (m->ecap >= ec && m->icap >= ic) return;\n" +
            "    " + ks + "*nk = (" + ks + "*)arena_alloc(a, (size_t)ec * sizeof(" + ks + "));\n" +
            "    " + vc + "*nv = (" + vc + "*)arena_alloc(a, (size_t)ec * sizeof(" + vc + "));\n" +
            "    unsigned char *nl = (unsigned char *)arena_alloc(a, (size_t)ec);\n" +
            "    int *ni = (int *)arena_alloc(a, (size_t)ic * sizeof(int));\n" +
            "    for (tycho_int i = 0; i < ic; i++) ni[i] = 0;\n" +
            "    for (tycho_int e = 0; e < m->ecount; e++) { nk[e] = m->ekeys[e]; nv[e] = m->evals[e]; nl[e] = m->elive[e]; }\n" +
            "    m->ekeys = nk; m->evals = nv; m->elive = nl; m->ecap = ec;\n" +
            "    m->idx = ni; m->icap = ic;\n" +
            "    for (tycho_int e = 0; e < m->ecount; e++) if (m->elive[e]) " + p + "_idxput(m, e);\n}\n" +
            "static tycho_int " + p + "_find(" + ct + " m, " + kp + ") {\n" +
            "    if (m.icap == 0) return -1; uint64_t mask = (uint64_t)m.icap - 1; tycho_int i = (tycho_int)(" +
            _khash(&cs, kt, "k") + " & mask); int e;\n" +
            "    while ((e = m.idx[i]) != 0) { if (" + _kmatch(&cs, kt, "m.ekeys[e - 1]", "k") +
            ") return e - 1; i = (tycho_int)((i + 1) & mask); }\n    return -1;\n}\n" +
            "static void " + p + "_idxput(" + ct + " *m, tycho_int ei) {\n" +
            "    uint64_t mask = (uint64_t)m->icap - 1; tycho_int i = (tycho_int)(" +
            _khash(&cs, kt, "m->ekeys[ei]") + " & mask);\n" +
            "    while (m->idx[i] != 0) i = (tycho_int)((i + 1) & mask); m->idx[i] = (int)(ei + 1);\n}\n" +
            "static void " + p + "_idxgrow(Arena *a, " + ct + " *m) {\n" +
            "    tycho_int ic = m->icap ? m->icap * 2 : 8; int *ni = (int *)arena_alloc(a, (size_t)ic * sizeof(int));\n" +
            "    for (tycho_int i = 0; i < ic; i++) ni[i] = 0; m->idx = ni; m->icap = ic;\n" +
            "    for (tycho_int e = 0; e < m->ecount; e++) if (m->elive[e]) " + p + "_idxput(m, e);\n}\n" +
            "static void " + p + "_compact(" + ct + " *m) {\n" +
            "    tycho_int w = 0; for (tycho_int r = 0; r < m->ecount; r++) if (m->elive[r]) { if (w != r) { m->ekeys[w] = m->ekeys[r]; m->evals[w] = m->evals[r]; m->elive[w] = 1; } w++; }\n" +
            "    m->ecount = w; for (tycho_int i = 0; i < m->icap; i++) m->idx[i] = 0;\n" +
            "    for (tycho_int e = 0; e < m->ecount; e++) " + p + "_idxput(m, e);\n}\n" +
            "static tycho_int " + p + "_append(Arena *a, " + ct + " *m, " + kp + ", " + vc + "v) {\n" +
            "    if (m->ecount == m->ecap) { tycho_int dead = m->ecount - m->len;\n" +
            "        if (dead > m->ecap / 2) " + p + "_compact(m);\n" +
            "        else { tycho_int nc = m->ecap ? m->ecap * 2 : 4;\n" +
            "            " + ks + "*nk = (" + ks + "*)arena_alloc(a, (size_t)nc * sizeof(" + ks + ")); " +
            vc + "*nv = (" + vc + "*)arena_alloc(a, (size_t)nc * sizeof(" + vc + ")); unsigned char *nl = (unsigned char *)arena_alloc(a, (size_t)nc);\n" +
            "            for (tycho_int e = 0; e < m->ecount; e++) { nk[e] = m->ekeys[e]; nv[e] = m->evals[e]; nl[e] = m->elive[e]; }\n" +
            "            m->ekeys = nk; m->evals = nv; m->elive = nl; m->ecap = nc; } }\n" +
            "    tycho_int e = m->ecount++; m->ekeys[e] = k; m->evals[e] = v; m->elive[e] = 1; return e;\n}\n" +
            "static void " + p + "_put(Arena *a, " + ct + " *m, " + kp + ", " + vc + "v) {\n" +
            "    tycho_int e = " + p + "_find(*m, k); if (e >= 0) { m->evals[e] = " + vcp + "; return; }\n" +
            "    if ((m->len + 1) * 2 > m->icap) " + p + "_idxgrow(a, m);\n" +
            "    tycho_int ne = " + p + "_append(a, m, " + kcp + ", " + vcp + "); m->len++; " + p + "_idxput(m, ne);\n}\n" +
            "static " + vc + "*" + p + "_slotptr(Arena *a, " + ct + " *m, " + kp + ") {\n" +
            "    tycho_int e = " + p + "_find(*m, k); if (e >= 0) return &m->evals[e];\n" +
            "    if ((m->len + 1) * 2 > m->icap) " + p + "_idxgrow(a, m);\n" +
            "    tycho_int ne = " + p + "_append(a, m, " + kcp + ", " + _zero(&cs, vt) + "); m->len++; " + p + "_idxput(m, ne);\n" +
            "    return &m->evals[ne];\n}\n" +
            "static void " + p + "_del(" + ct + " *m, " + kp + ") {\n" +
            "    if (m->icap == 0) return; uint64_t mask = (uint64_t)m->icap - 1; tycho_int i = (tycho_int)(" +
            _khash(&cs, kt, "k") + " & mask), found = -1;\n" +
            "    while (m->idx[i] != 0) { if (" + _kmatch(&cs, kt, "m->ekeys[m->idx[i] - 1]", "k") +
            ") { found = i; break; } i = (tycho_int)((i + 1) & mask); }\n" +
            "    if (found < 0) return; tycho_int ei = m->idx[found] - 1; m->elive[ei] = 0; m->len--;\n" +
            "    tycho_int g = found;\n" +
            "    for (;;) { m->idx[g] = 0; tycho_int j = g;\n" +
            "        for (;;) { j = (tycho_int)((j + 1) & mask); if (m->idx[j] == 0) return;\n" +
            "            tycho_int h = (tycho_int)(" + _khash(&cs, kt, "m->ekeys[m->idx[j] - 1]") + " & mask);\n" +
            "            if (g <= j) { if (g < h && h <= j) continue; } else { if (g < h || h <= j) continue; } break; }\n" +
            "        m->idx[g] = m->idx[j]; g = j; }\n}\n" +
            "static " + ct + " " + p + "_copy(Arena *a, " + ct + " src) {\n" +
            "    " + ct + " r = " + p + "_with_cap(a, src.len ? src.len : 0);\n" +
            "    for (tycho_int e = 0; e < src.ecount; e++) if (src.elive[e]) " + p +
            "_put(a, &r, src.ekeys[e], src.evals[e]);\n    return r;\n}\n" +
            "static " + vc + p + "_get(" + ct + " m, " + kp + ", " + vc + "dflt) {\n" +
            "    tycho_int e = " + p + "_find(m, k); return e < 0 ? dflt : m.evals[e];\n}\n" +
            "static int " + p + "_has(" + ct + " m, " + kp + ") { return " + p + "_find(m, k) >= 0; }\n" +
            "static " + kat + " " + p + "_keys(Arena *a, " + ct + " m) {\n" +
            "    " + kat + " r = " + kwc + "(a, m.len);\n" +
            "    for (tycho_int e = 0; e < m.ecount; e++) if (m.elive[e]) " + kpu +
            "(a, &r, " + kel + ");\n    return r;\n}\n" +
            "static int " + p + "_eq(" + ct + " x, " + ct + " y) {\n" +
            "    if (x.len != y.len) return 0;\n" +
            "    for (tycho_int e = 0; e < x.ecount; e++) if (x.elive[e]) { tycho_int s = " + p +
            "_find(y, x.ekeys[e]); if (s < 0 || !(" + _eq(&cs, "y.evals[s]", "x.evals[e]", vt) +
            ")) return 0; }\n    return 1;\n}\n" +
            "static char *tycho_str_mapM" + str(i) + "(Arena *a, " + ct + " m) {\n" +
            "    char *r = tycho_str_from_c(a, \"[\"); int first = 1;\n" +
            "    for (tycho_int e = 0; e < m.ecount; e++) if (m.elive[e]) {\n" +
            "        if (!first) r = tycho_str_concat(a, r, tycho_str_from_c(a, \", \")); first = 0;\n" +
            "        r = tycho_str_concat(a, r, " + _tostr_a(&cs, kel, kt) + ");\n" +
            "        r = tycho_str_concat(a, r, tycho_str_from_c(a, \": \"));\n" +
            "        r = tycho_str_concat(a, r, " + _tostr_a(&cs, "m.evals[e]", vt) + ");\n" +
            "    }\n    return tycho_str_concat(a, r, tycho_str_from_c(a, \"]\"));\n}\n"
        i += 1
    return (td, sb, pr, fb)

# A deep hash per hashable struct/tuple, folded FNV-style from the per-process
# seed so that ==-equal values always hash equal (src/tychoc.c:13255).
fn _hash_defs(cs: inout C) -> (string, string):
    pr := ""
    fb := ""
    for i := 0; i < len(cs.sds); i += 1:
        n := cs.sds[i].name
        if not _hashable(&cs, "S~" + n):
            continue
        if not (("tycho_hash_S_" + n) in cs.used or ("tycho_dhash_S_" + n) in cs.used):
            continue
        h1 := _once(&cs, "tycho_hash_S_" + n)
        h2 := _once(&cs, "tycho_dhash_S_" + n)
        if not (h1 or h2):
            continue
        pr = pr + "static uint64_t tycho_hash_S_" + n + "(S_" + n + ");\n" +
            "static uint64_t tycho_dhash_S_" + n + "(S_" + n + ");\n"
        b := "static uint64_t tycho_hash_S_" + n + "(S_" + n + " v) {\n" +
            "    uint64_t h = tycho_hash_k0;\n"
        d := "static uint64_t tycho_dhash_S_" + n + "(S_" + n + " v) {\n" +
            "    uint64_t h = UINT64_C(0x9e3779b97f4a7c15);\n"
        for j := 0; j < len(cs.sds[i].fnames); j += 1:
            b = b + "    h = h * UINT64_C(1099511628211) ^ " +
                _hash(&cs, cs.sds[i].ftypes[j], "v.f_" + cs.sds[i].fnames[j]) + ";\n"
            d = d + "    h = h * UINT64_C(1099511628211) ^ " +
                _hash_det(&cs, cs.sds[i].ftypes[j], "v.f_" + cs.sds[i].fnames[j]) + ";\n"
        fb = fb + b + "    return h;\n}\n" + d + "    return h;\n}\n"
    for i := 0; i < len(cs.tks); i += 1:
        if not _hashable(&cs, "T~" + str(i)):
            continue
        if not (("tycho_hash_T" + str(i)) in cs.used or ("tycho_dhash_T" + str(i)) in cs.used):
            continue
        g1 := _once(&cs, "tycho_hash_T" + str(i))
        g2 := _once(&cs, "tycho_dhash_T" + str(i))
        if not (g1 or g2):
            continue
        pr = pr + "static uint64_t tycho_hash_T" + str(i) + "(TychoTup" + str(i) + ");\n" +
            "static uint64_t tycho_dhash_T" + str(i) + "(TychoTup" + str(i) + ");\n"
        b2 := "static uint64_t tycho_hash_T" + str(i) + "(TychoTup" + str(i) + " v) {\n" +
            "    uint64_t h = tycho_hash_k0;\n"
        d2 := "static uint64_t tycho_dhash_T" + str(i) + "(TychoTup" + str(i) + " v) {\n" +
            "    uint64_t h = UINT64_C(0x9e3779b97f4a7c15);\n"
        es := split(cs.tks[i], "|")
        for j := 0; j < len(es); j += 1:
            b2 = b2 + "    h = h * UINT64_C(1099511628211) ^ " +
                _hash(&cs, es[j], "v.f" + str(j)) + ";\n"
            d2 = d2 + "    h = h * UINT64_C(1099511628211) ^ " +
                _hash_det(&cs, es[j], "v.f" + str(j)) + ";\n"
        fb = fb + b2 + "    return h;\n}\n" + d2 + "    return h;\n}\n"
    return (pr, fb)

fn _tostr_a(cs: inout C, code: string, t: string) -> string:
    s := _tostr(&cs, code, t)
    return _replace(s, "&_scope", "a")

# Appends the SPAN between matches, not one character at a time. The old shape
# (`out = out + s[i:i+1]`) allocated a one-byte slice and concatenated it for
# every byte of every function body, and _fnbody calls this on each body it
# patches -- it was 27% of the compile on its own, measured with callgrind.
# The `s[i] == f0` guard is what keeps the scan from slicing at every position.
# Does this statement's code actually allocate in its scratch arena? Most do
# not: the arena was emitted around every expression statement and then freed
# unused, which is an arena_new + arena_free (and a block_get/release) per
# statement. Matching "&_t" alone would also match "&_tp462", so the byte after
# it must not continue an identifier.
# Replace the scratch arena's name, but only where it is the WHOLE identifier.
# A bare _replace(c, "&_t", ...) also rewrites `&_tk37`, the temp a wait() puts
# in the caller's arena, and emits arena_free(_parentk37->root) -- which is why
# tools/prunner and tools/tycho-kv did not build. Same boundary rule as _uses_t.
fn _sub_t(s: string, to: string) -> string:
    out := ""
    i := 0
    n := len(s)
    for i < n:
        if i + 3 <= n and s[i] == 38 and s[i + 1] == 95 and s[i + 2] == 116:
            bnd := true
            if i + 3 < n:
                c := s[i + 3]
                if c == 95 or (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122):
                    bnd = false
            if bnd:
                out = out + to
                i += 3
                continue
        out = out + s[i:i + 1]
        i += 1
    return out

fn _uses_t(s: string) -> bool:
    i := 0
    n := len(s)
    for i + 3 <= n:
        if s[i] == 38 and s[i + 1] == 95 and s[i + 2] == 116:
            if i + 3 >= n:
                return true
            c := s[i + 3]
            if not (c == 95 or (c >= 48 and c <= 57) or (c >= 65 and c <= 90) or (c >= 97 and c <= 122)):
                return true
        i += 1
    return false

# Is this emitted code exactly ONE balanced call -- depth reaching 0 only at the
# final byte? String literals are skipped, since TYCHO_LIT("(") is common in the
# code emit produces. Used to decide whether a concat can absorb its left side.
fn _one_call(s: string) -> bool:
    d := 0
    q := false
    i := 0
    n := len(s)
    for i < n:
        c := s[i]
        if q:
            if c == 92:
                i += 2
                continue
            if c == 34:
                q = false
        elif c == 34:
            q = true
        elif c == 40:
            d += 1
        elif c == 41:
            d -= 1
            if d == 0 and i != n - 1:
                return false
        i += 1
    return d == 0

# Whether `sub` occurs in `s`, answered without building anything. The one
# caller used to ask `len(_replace(s, sub, "")) != len(s)`, which allocated a
# whole second copy of a function body to learn one bit -- 4.4% of the Ir
# compiling bench/raytrace/raytrace.ty.
fn _hassub(s: string, sub: string) -> bool:
    n := len(sub)
    if n == 0:
        return true
    f0 := sub[0]
    ls := len(s)
    i := 0
    for i + n <= ls:
        if s[i] == f0:
            j := 1
            for j < n and s[i + j] == sub[j]:
                j += 1
            if j == n:
                return true
        i += 1
    return false

fn _replace(s: string, from: string, to: string) -> string:
    n := len(from)
    if n == 0:
        return s
    f0 := from[0]
    out := ""
    i := 0
    last := 0
    ls := len(s)
    hit := false
    for i + n <= ls:
        if s[i] == f0 and s[i:i + n] == from:
            out = out + s[last:i] + to
            i += n
            last = i
            hit = true
        else:
            i += 1
    # No match is the common case at every scratch-arena site; returning `s`
    # itself skips a full copy of the body.
    if not hit:
        return s
    return out + s[last:]

fn _struct_order(cs: inout C) -> [int]:
    order := []int
    done := []bool
    for i := 0; i < len(cs.sds); i += 1:
        push(done, false)
    for len(order) < len(cs.sds):
        moved := false
        for i := 0; i < len(cs.sds); i += 1:
            if done[i]:
                continue
            ok := true
            for ft in cs.sds[i].ftypes:
                if _is_struct(ft):
                    j := _sidx(&cs, _tname(ft))
                    if j >= 0 and not done[j]:
                        ok = false
            if ok:
                done[i] = true
                push(order, i)
                moved = true
        if not moved:
            _bad("a cycle among struct definitions")
    return order

fn _struct_support(cs: inout C) -> (string, string):
    proto := ""
    body := ""
    for i := 0; i < len(cs.sds); i += 1:
        n := cs.sds[i].name
        doeq := _need(&cs, "tycho_eq_S_" + n)
        dost := _need(&cs, "tycho_str_S_" + n)
        docp := false
        if _heap(&cs, "S~" + n):
            docp = _need(&cs, "tycho_copy_S_" + n)
        if doeq:
            proto = proto + "static int tycho_eq_S_" + n + "(S_" + n + ", S_" + n + ");\n"
        if dost:
            proto = proto + "static char *tycho_str_S_" + n + "(Arena *, S_" + n + ");\n"
        eq := ""
        st := "    char *r = tycho_str_from_c(a, \"" + n + "(\");\n"
        for j := 0; j < len(cs.sds[i].fnames); j += 1:
            if not (doeq or dost):
                continue
            f := cs.sds[i].fnames[j]
            ft := cs.sds[i].ftypes[j]
            if j > 0:
                if doeq:
                    eq = eq + " && "
                if dost:
                    st = st + "    r = tycho_str_concat(a, r, tycho_str_from_c(a, \", \"));\n"
            if doeq:
                eq = eq + _eq(&cs, "x.f_" + f, "y.f_" + f, ft)
            if dost:
                st = st + "    r = tycho_str_concat(a, r, " + _tostr_a(&cs, "v.f_" + f, ft) + ");\n"
        if len(eq) == 0:
            eq = "1"
        if doeq:
            body = body + "static int tycho_eq_S_" + n + "(S_" + n + " x, S_" + n + " y) {\n" +
                "    return " + eq + ";\n}\n"
        if dost:
            body = body + "static char *tycho_str_S_" + n + "(Arena *a, S_" + n + " v) {\n" + st +
                "    return tycho_str_concat(a, r, tycho_str_from_c(a, \")\"));\n}\n"
        if docp:
            proto = proto + "static S_" + n + " tycho_copy_S_" + n + "(Arena *, S_" + n + ");\n"
            cp := "static S_" + n + " tycho_copy_S_" + n + "(Arena *a, S_" + n + " v) {\n" +
                "    S_" + n + " r = v;\n"
            for j := 0; j < len(cs.sds[i].fnames); j += 1:
                f := cs.sds[i].fnames[j]
                ft := cs.sds[i].ftypes[j]
                if _heap(&cs, ft):
                    cp = cp + "    r.f_" + f + " = " + _copy(&cs, "v.f_" + f, ft, "a") + ";\n"
            body = body + cp + "    return r;\n}\n"
    return (proto, body)

fn _enum_support(cs: inout C) -> (string, string, string):
    defs := ""
    proto := ""
    body := ""
    for i := 0; i < len(cs.eds); i += 1:
        n := cs.eds[i].name
        if _once(&cs, "def_E_" + n):
            un := ""
            for t := 0; t < len(cs.eds[i].vnames); t += 1:
                vn := cs.eds[i].vnames[t]
                ps := cs.eds[i].vpay[t].ptypes
                if len(ps) == 0:
                    continue
                fl := ""
                for j := 0; j < len(ps); j += 1:
                    fl = fl + " " + _ctyz(&cs, ps[j]) + "f" + str(j) + ";"
                defs = defs + "typedef struct {" + fl + " } E_" + n + "_" + vn + ";\n"
                un = un + " E_" + n + "_" + vn + " " + vn + ";"
            defs = defs + "struct E_" + n + " { int tag; union {" + un + " } u; };\n"
            allbare := true
            for t := 0; t < len(cs.eds[i].vnames); t += 1:
                if len(cs.eds[i].vpay[t].ptypes) == 0:
                    defs = defs + "static E_" + n + " _sing_" + n + "_" + str(t) +
                        " = { " + str(t) + " };\n"
                else:
                    allbare = false
            # a fieldless enum is stored in a map's key table as its TAG, so keys()
            # rebuilds the value through this table (src/tychoc.c:13100).
            if allbare and len(cs.eds[i].vnames) > 0:
                tab := "static E_" + n + " *const _sing_tab_" + n + "[] = {"
                for t := 0; t < len(cs.eds[i].vnames); t += 1:
                    if t > 0:
                        tab = tab + ", "
                    tab = tab + "&_sing_" + n + "_" + str(t)
                defs = defs + tab + "};\n"
        docp := _need(&cs, "tycho_copy_E_" + n)
        doeq := _need(&cs, "tycho_eq_E_" + n)
        dost := _need(&cs, "tycho_str_E_" + n)
        if not (docp or doeq or dost):
            continue
        if docp:
            proto = proto + "static E_" + n + " *tycho_copy_E_" + n + "(Arena *, E_" + n + " *);\n"
        if doeq:
            proto = proto + "static int tycho_eq_E_" + n + "(E_" + n + " *, E_" + n + " *);\n"
        if dost:
            proto = proto + "static char *tycho_str_E_" + n + "(Arena *, E_" + n + " *);\n"
        cp := "static E_" + n + " *tycho_copy_E_" + n + "(Arena *a, E_" + n + " *v) {\n"
        eq := "static int tycho_eq_E_" + n + "(E_" + n + " *x, E_" + n + " *y) {\n" +
            "    if (x->tag != y->tag) return 0;\n"
        st := "static char *tycho_str_E_" + n + "(Arena *a, E_" + n + " *v) {\n"
        # str() prints the variant MANGLED, as ./tychoc does -- corelib's own
        # golden reads `Err(strings__EmptyInput)`. The prefix is the enum type's
        # own package; an entry-package enum has none and prints bare.
        epfx := ""
        for q := 0; q + 1 < len(n); q += 1:
            if n[q] == 95 and n[q + 1] == 95:
                epfx = n[0:q + 2]
                break
        for t := 0; t < len(cs.eds[i].vnames); t += 1:
            vn := cs.eds[i].vnames[t]
            shown := epfx + vn
            ps := cs.eds[i].vpay[t].ptypes
            tg := str(t)
            if len(ps) == 0:
                if dost:
                    st = st + "    if (v->tag == " + tg + ") return tycho_str_from_c(a, \"" + shown + "\");\n"
                if doeq:
                    eq = eq + "    if (x->tag == " + tg + ") return 1;\n"
                continue
            if docp:
                cp = cp + "    if (v->tag == " + tg + ") {\n" +
                    "        E_" + n + " *d = (E_" + n + " *)arena_alloc(a, offsetof(E_" + n +
                    ", u) + sizeof(E_" + n + "_" + vn + ")); d->tag = " + tg + ";\n"
            eqs := ""
            if dost:
                st = st + "    if (v->tag == " + tg + ") {\n" +
                    "        char *r = tycho_str_from_c(a, \"" + shown + "(\");\n"
            for j := 0; j < len(ps); j += 1:
                fj := ".u." + vn + ".f" + str(j)
                if docp:
                    cp = cp + "        d->u." + vn + ".f" + str(j) + " = " +
                        _copy(&cs, "v->u." + vn + ".f" + str(j), ps[j], "a") + ";\n"
                if j > 0:
                    if doeq:
                        eqs = eqs + " && "
                    if dost:
                        st = st + "        r = tycho_str_concat(a, r, tycho_str_from_c(a, \", \"));\n"
                if doeq:
                    eqs = eqs + _eq(&cs, "x->" + fj[1:], "y->" + fj[1:], ps[j])
                if dost:
                    st = st + "        r = tycho_str_concat(a, r, " +
                        _tostr_a(&cs, "v->" + fj[1:], ps[j]) + ");\n"
            if docp:
                cp = cp + "        return d;\n    }\n"
            if doeq:
                eq = eq + "    if (x->tag == " + tg + ") return " + eqs + ";\n"
            if dost:
                st = st + "        return tycho_str_concat(a, r, tycho_str_from_c(a, \")\"));\n    }\n"
        if docp:
            body = body + cp + "    return v;\n}\n"
        if doeq:
            body = body + eq + "    return 1;\n}\n"
        if dost:
            body = body + st + "    return tycho_str_from_c(a, \"<?>\");\n}\n"
    return (defs, proto, body)

fn _accof(cs: inout C, n: string) -> string:
    for i := len(cs.vnames) - 1; i >= 0; i -= 1:
        if cs.vnames[i] == n:
            return cs.vacc[i]
    return ""

fn _isacc(cs: inout C, n: string) -> bool:
    for a in cs.accs:
        if a == n:
            return true
    return false

# Does this expression mention `n`? A multi-piece append may only go in place
# when no piece reads the accumulator: `s = s + "." + s` would otherwise see the
# buffer an earlier append already grew (tests/append_alias.ty).
fn _mentions(e: ast.Expr, n: string) -> bool:
    match e:
        ast.Name(l, m):
            if m == n:
                return true
        _: pass
    for c in ast.kids(e):
        if _mentions(c, n):
            return true
    return false

# src/tychoc.c@collect_escapes: the names a bare `return <ident>` hands out.
# A top-level heap local in this set is built in _parent from birth, so the
# return is a move rather than a deep copy. Over-marking is safe -- the parent
# outlives this scope -- so the scan need not be exact. It recurses into
# if/while/for bodies ONLY, exactly as the reference does: a `return` inside a
# match or select arm does NOT mark its name.
# `hv` is one flag per RETURN SLOT: is that slot's type heap? A tuple return
# gets one entry per element, a scalar return exactly one. Only a heap slot is
# worth promoting -- marking an int local "_parent" moves its call transients
# into the caller's arena for nothing.
fn _escs_b(ss: [ast.Stmt], hv: [bool], out: inout [string]):
    for st in ss:
        match st:
            ast.ReturnS(l, k):
                if len(k) == 1:
                    match k[0]:
                        ast.Name(l2, n):
                            if len(hv) == 1 and hv[0]:
                                push(out, n)
                        ast.Tuple(l3, xs):
                            if len(xs) == len(hv):
                                for ix9 := 0; ix9 < len(xs); ix9 += 1:
                                    if hv[ix9]:
                                        match xs[ix9]:
                                            ast.Name(l4, n4): push(out, n4)
                                            _: pass
                        _: pass
            ast.IfS(l, c, b, e):
                _escs_b(b, hv, &out)
                _escs_b(e, hv, &out)
            ast.WhileS(l, c, b): _escs_b(b, hv, &out)
            ast.For3(l, i2, c, b): _escs_b(b, hv, &out)
            ast.ForIn(l, n, k, b): _escs_b(b, hv, &out)
            ast.ForRange(l, n, k, b): _escs_b(b, hv, &out)
            ast.ParallelS(l, k, b): _escs_b(b, hv, &out)
            _: pass

fn _isesc(cs: inout C, n: string) -> bool:
    for a in cs.escs:
        if a == n:
            return true
    return false

fn _acc_scan(ss: [ast.Stmt], selfapp: inout [string], other: inout [string],
        decl: inout [string]):
    for st in ss:
        match st:
            ast.Decl(l, n, ann, rhs, vv):
                if len(vv) == 0:
                    push(decl, n)
            ast.Assign(l, n, k):
                # The accumulator is the LEFT SPINE's leaf, so `doc = doc + a + b`
                # counts as a self-append too -- classifying it as `other` cost
                # bench/json 7.2 GiB of intermediate copies.
                ok := false
                sp := k[0]
                for true:
                    stop := true
                    match sp:
                        ast.Binop(l2, op, bk):
                            if op == "+" and len(bk) == 2:
                                sp = bk[0]
                                stop = false
                        _: pass
                    if stop:
                        break
                match sp:
                    ast.Name(l3, nn):
                        if nn == n and not (k[0] is ast.Name):
                            ok = true
                    _: pass
                if ok:
                    # every piece to the RIGHT of the leaf must be free of `n`
                    sp2 := k[0]
                    for true:
                        stop2 := true
                        match sp2:
                            ast.Binop(l4, op4, bk4):
                                if op4 == "+" and len(bk4) == 2:
                                    if _mentions(bk4[1], n):
                                        ok = false
                                    sp2 = bk4[0]
                                    stop2 = false
                            _: pass
                        if stop2:
                            break
                if ok:
                    push(selfapp, n)
                else:
                    push(other, n)
            ast.PlaceSet(l, k): pass
            ast.IfS(l, c, t, e):
                _acc_scan(t, &selfapp, &other, &decl)
                _acc_scan(e, &selfapp, &other, &decl)
            ast.WhileS(l, c, b): _acc_scan(b, &selfapp, &other, &decl)
            ast.ForIn(l, v, c, b): _acc_scan(b, &selfapp, &other, &decl)
            ast.For3(l, ip, c, b):
                _acc_scan(ip, &selfapp, &other, &decl)
                _acc_scan(b, &selfapp, &other, &decl)
            _: pass

# ---------------------------------------------------------------- dead code
#
# 33% of the functions in a typical emitted unit are never called anywhere in
# it -- a package is imported for two symbols and every one it declares gets a
# body. ./tychoc emits them too, so declining to is a straight win.
#
# The set is of SHORT names, unqualified and unresolved on purpose: a name kept
# live by a same-named function in another package costs one function emitted
# for nothing, where a missed reference is a link error. Every field name and
# every bare identifier goes in as well, which covers a UFCS method and a
# function taken as a value without having to tell them apart from a local.
# Nothing here is CHECKED any differently -- this only declines to write a body.

# An f-string's interpolation is DEFERRED -- ast.FStrLit carries the raw body
# and emit parses it later -- so a `f"{a.dot(b)}"` has no Expr children to walk
# and `dot` would be dropped. Every identifier-shaped run in the body goes in.
fn _ref_idents(s: string, m: inout [string: bool]):
    st := -1
    for i := 0; i <= len(s); i += 1:
        c := 0
        if i < len(s):
            c = s[i]
        idc := (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95 or
            (st >= 0 and c >= 48 and c <= 57)
        if idc:
            if st < 0:
                st = i
        elif st >= 0:
            m[s[st:i]] = true
            st = -1
    return

fn _ref_e(e: ast.Expr, m: inout [string: bool]):
    match e:
        ast.Name(l, n): m[n] = true
        ast.FStrLit(l, v): _ref_idents(v, &m)
        ast.Field(l, k, f):
            m[f] = true
            _ref_es(k, &m)
        ast.Call(l, q, n, ts, k):
            m[n] = true
            _ref_es(k, &m)
        ast.TupIdx(l, k, i): _ref_es(k, &m)
        ast.Index(l, k): _ref_es(k, &m)
        ast.Slice(l, a, b, k): _ref_es(k, &m)
        ast.CallVal(l, k): _ref_es(k, &m)
        ast.Named(l, n, k): _ref_es(k, &m)
        ast.Binop(l, o, k): _ref_es(k, &m)
        ast.Unop(l, o, k): _ref_es(k, &m)
        ast.IsVar(l, k, q, n): _ref_es(k, &m)
        ast.ArrLit(l, k): _ref_es(k, &m)
        ast.MapLit(l, k): _ref_es(k, &m)
        ast.Tuple(l, k): _ref_es(k, &m)
        ast.SomeE(l, k): _ref_es(k, &m)
        ast.OkE(l, k): _ref_es(k, &m)
        ast.ErrE(l, k): _ref_es(k, &m)
        ast.SpawnE(l, k): _ref_es(k, &m)
        ast.OrRet(l, k): _ref_es(k, &m)
        ast.Spread(l, k): _ref_es(k, &m)
        ast.Addr(l, k): _ref_es(k, &m)
        ast.ChanE(l, t, k): _ref_es(k, &m)
        ast.Lambda(l, ps, rt, k): _ref_es(k, &m)
        _: pass

fn _ref_es(es: [ast.Expr], m: inout [string: bool]):
    for e in es:
        _ref_e(e, &m)

fn _ref_s(s: ast.Stmt, m: inout [string: bool]):
    match s:
        ast.ExprStmt(l, k): _ref_es(k, &m)
        ast.Decl(l, n, ty, rhs, vb):
            _ref_es(rhs, &m)
            _ref_b(vb, &m)
        ast.MDecl(l, isd, ns, rhs): _ref_es(rhs, &m)
        ast.Assign(l, n, rhs): _ref_es(rhs, &m)
        ast.PlaceSet(l, k): _ref_es(k, &m)
        ast.ConstS(l, n, v): _ref_es(v, &m)
        ast.ReturnS(l, k): _ref_es(k, &m)
        ast.DeleteS(l, k): _ref_es(k, &m)
        ast.IfS(l, c, b, e):
            _ref_es(c, &m)
            _ref_b(b, &m)
            _ref_b(e, &m)
        ast.WhileS(l, c, b):
            _ref_es(c, &m)
            _ref_b(b, &m)
        ast.For3(l, i, c, b):
            _ref_b(i, &m)
            _ref_es(c, &m)
            _ref_b(b, &m)
        ast.ForIn(l, v, c, b):
            _ref_es(c, &m)
            _ref_b(b, &m)
        ast.ForRange(l, v, bd, b):
            _ref_es(bd, &m)
            _ref_b(b, &m)
        ast.ParallelS(l, w, b):
            _ref_es(w, &m)
            _ref_b(b, &m)
        ast.MatchS(l, subj, arms):
            _ref_es(subj, &m)
            for a in arms:
                _ref_b(a.body, &m)
        ast.SelectS(l, arms):
            for a in arms:
                _ref_es(a.ch, &m)
                _ref_b(a.body, &m)
        _: pass

fn _ref_b(b: [ast.Stmt], m: inout [string: bool]):
    for s in b:
        _ref_s(s, &m)

fn _fnbody(cs: inout C, fi: int, body: [ast.Stmt]) -> (string, string):
    nm := cs.fds[fi].name
    rt := cs.fds[fi].ret
    cs.cur_ret = rt
    sa := []string
    ot := []string
    dc := []string
    _acc_scan(body, &sa, &ot, &dc)
    es9 := []string
    if _heap(&cs, rt):
        hv9 := []bool
        if _is_tup(rt):
            et9 := _telems(&cs, rt)
            for ix8 := 0; ix8 < len(et9); ix8 += 1:
                push(hv9, _heap(&cs, et9[ix8]))
        else:
            push(hv9, true)
        _escs_b(body, hv9, &es9)
    cs.escs = es9
    cs.accs = []string
    for a in sa:
        bad := true
        for d in dc:
            if d == a:
                bad = false
        for o in ot:
            if o == a:
                bad = true
        if not bad:
            push(cs.accs, a)
    sig := _ctyz(&cs, rt) + "h_" + nm + "(Arena *_parent"
    m := _mark(&cs)
    for j := 0; j < len(cs.fds[fi].pnames); j += 1:
        pt := cs.fds[fi].ptypes[j]
        cn := _push(&cs, cs.fds[fi].pnames[j], pt)
        if cs.fds[fi].pinout[j]:
            sig = sig + ", " + _ctyz(&cs, pt) + "*" + cn
            cs.vcn[len(cs.vcn) - 1] = "(*" + cn + ")"
            if _heap(&cs, pt):
                sig = sig + ", Arena *_ina_" + cn
                cs.vown[len(cs.vown) - 1] = "_ina_" + cn
        else:
            sig = sig + ", " + _ctyz(&cs, pt) + "" + cn
    sig = sig + ")"
    # A `[$N]T` parameter makes N an int CONST in the body: for a fixed array
    # the runtime length is N, so it needs no monomorphisation over sizes.
    cm := len(cs.cnames)
    for j := 0; j < len(cs.fds[fi].psize) and j < len(cs.fds[fi].pnames); j += 1:
        sn := cs.fds[fi].psize[j]
        if len(sn) > 0 and _cidx(&cs, sn) < 0:
            push(cs.cnames, sn)
            push(cs.ctypes, "int")
            push(cs.ccode, "((" + _vcname(&cs, cs.fds[fi].pnames[j]) + ").len)")
    sfb := cs.fnbase
    cs.ascope = []string
    cs.loopdepth = 0
    spb := cs.pbody
    cs.pbody = body
    cs.fnbase = len(cs.vnames)
    sel := cs.elv
    sea := cs.ela
    cs.elv = []string
    cs.ela = []string
    pm := len(cs.pk)
    cs.pname = nm
    cs.lbl = 0
    cs.lpost = []int
    b := _block(&cs, body, "    ")
    cs.pbody = spb
    cs.fnbase = sfb
    cs.elv = sel
    cs.ela = sea
    for i := pm; i < len(cs.pk); i += 1:
        if len(cs.ptv[i]) == 0:
            _bad("a bare [] or None with nothing to type it")
        b = _replace(b, "_PT" + str(cs.pk[i]), _cty(&cs, cs.ptv[i]))
        init9 := _zero(&cs, cs.ptv[i])
        if _is_arr(cs.ptv[i]):
            init9 = _arrf(&cs, _elem(cs.ptv[i]), "_with_cap") + "(&_scope, 0)"
        elif _is_enum(cs.ptv[i]):
            ei9 := _eidx(&cs, _tname(cs.ptv[i]))
            init9 = "(&_sing_" + cs.eds[ei9].name + "_" + str(_tag(&cs, ei9, "None")) + ")"
        b = _replace(b, "_PE" + str(cs.pk[i]), init9)
    _restore(&cs, m)
    # the `$N` bindings are this function's, not the module's
    for len(cs.cnames) > cm:
        pop(cs.cnames)
        pop(cs.ctypes)
        pop(cs.ccode)
    # A body that never allocates gets no scope arena. Every call still paid
    # arena_child + arena_free for it: of 6.91M arenas created compiling
    # compiler/main.ty, 5.80M never had a single allocation. The test is that
    # the emitted body mentions _scope nowhere except in the frees themselves,
    # which is exact -- an allocation, a copy or an inout hand-off all name it.
    bare := ""
    keep := true
    bi := 0
    blast := 0
    bn := len(b)
    for bi + 6 <= bn:
        if b[bi] == 95 and b[bi + 1] == 115 and b[bi:bi + 6] == "_scope":
            # the guarded teardown is one unit; its leading `if (_scope.head)`
            # would otherwise read as a real use and defeat the elision
            if bi >= 4 and bi + 33 <= bn and b[bi - 4:bi] == "if (" and
                    b[bi:bi + 33] == "_scope.head) arena_free(&_scope);":
                bare = bare + b[blast:bi - 4]
                bi += 33
                if bi < bn and (b[bi] == 32 or b[bi] == 10):
                    bi += 1
                blast = bi
                continue
            if bi >= 12 and b[bi - 12:bi] == "arena_free(&":
                bare = bare + b[blast:bi - 12]
                bi += 7                              # past "_scope)"
                if bi < bn and b[bi] == 59:
                    bi += 1                          # and the ';'
                if bi < bn and (b[bi] == 32 or b[bi] == 10):
                    bi += 1                          # and the space or newline
                blast = bi
                continue
            keep = false
            bi = bn
            continue
        bi += 1
    bare = bare + b[blast:]
    if not keep:
        out := sig + " {\n" +
            "    Arena _scope = arena_child(_parent); _scope.name = \"" + nm + "\";\n" + b
        if not _ends_ret(body):
            if rt == "void":
                out = out + "    if (_scope.head) arena_free(&_scope);\n"
            else:
                out = out + "    if (_scope.head) arena_free(&_scope); return (" + _ctyz(&cs, rt) + "){0};\n"
        return (sig + ";\n", out + "}\n\n")
    out0 := sig + " {\n" + bare
    if not _ends_ret(body) and rt != "void":
        out0 = out0 + "    return (" + _ctyz(&cs, rt) + "){0};\n"
    return (sig + ";\n", out0 + "}\n\n")

# src/tychoc.c@block_ends_in_return -- whether the last statement of a block
# leaves on every path, which is what decides the proc's trailing free.
fn _ends_ret(b: [ast.Stmt]) -> bool:
    if len(b) == 0:
        return false
    match b[len(b) - 1]:
        ast.ReturnS(l, k): return true
        ast.MatchS(l, c, a):
            for x in a:
                if not _ends_ret(x.body):
                    return false
            return len(a) > 0
        ast.IfS(l, c, t, e):
            if len(e) == 0:
                return false
            if not _ends_ret(t):
                return false
            return _ends_ret(e)
        _: pass
    return false

# --- the unit ---------------------------------------------------------------

# `pfx[i]` is file i's package prefix -- "" for the ENTRY package, `<pkg>__`
# for every other, exactly as src/tychoc.c@pkg_prefix_for spells it. The files
# arrive in the loader's post-order, so a package's dependencies are collected
# before it is.
fn program(pfx: [string], us: [ast.Unit]) -> string:
    cs := _new()
    for x in pfx:
        push(cs.fpfx, x)
    for u0 in us:
        for hd in u0.handles:
            # A handle is an opaque `void *` whose free fn runs at every scope
            # exit; the destructor call is emitted by _finalizers, exactly as a
            # task's join and a channel's free are.
            push(cs.hdn, hd.name)
            push(cs.hdf, hd.free_fn)
        for sd in u0.subscripts:
            push(cs.subn, sd.name)
            push(cs.subp, sd.params)
            push(cs.sube, sd.place)
        for im in u0.imports:
            b := _pkg_base(im.path)
            push(cs.ala, b)
            push(cs.alp, b)
            if len(im.alias) > 0:
                push(cs.ala, im.alias)
                push(cs.alp, b)
    for i := 0; i < len(us); i += 1:
        cs.cf = i
        _collect1(&cs, us[i])
    _collect_nt(&cs)
    for i := 0; i < len(us); i += 1:
        cs.cf = i
        _collect2(&cs, us[i])
    cs.cf = -1
    if _fidx(&cs, "main") < 0:
        _bad("no 'main' procedure")

    # Every name any body, const initialiser or subscript place mentions. A
    # generic's body is walked too: it is emitted only when instantiated, but
    # whatever it calls has to survive whether or not it ever is.
    used := []string: bool
    used["main"] = true
    for i := 0; i < len(us); i += 1:
        for f in us[i].fns:
            _ref_b(f.body, &used)
        for c in us[i].consts:
            _ref_e(c.value, &used)
        for sd in us[i].subscripts:
            _ref_e(sd.place, &used)
        for hd in us[i].handles:
            used[hd.free_fn] = true

    fns := ""
    protos := ""
    for i := 0; i < len(us); i += 1:
        cs.cf = i
        for f in us[i].fns:
            if len(f.typarams) > 0:
                continue
            if not (f.name in used):
                continue
            # An extern has NO Tycho body; emitting one gives every extern a
            # second, empty `h_<name>` definition beside the real C symbol.
            if f.is_extern:
                continue
            pc, bc := _fnbody(&cs, _fidx(&cs, f.name), f.body)
            protos = protos + pc
            fns = fns + bc
    # Stage 2: every generic instance discovered while emitting -- and every one
    # discovered while emitting THOSE -- gets its own body. The registry only
    # ever grows at the end, so a forward scan reaches the whole closure.
    for k := 0; k < len(cs.ikey); k += 1:
        if cs.pendk[k] < 0:
            continue
        fj := cs.pendk[k]
        cs.pendk[k] = -1
        parts := split(cs.ikey[k], "|")
        gi := _gfidx(&cs, parts[1])
        tg := []string
        for q := 2; q < len(parts); q += 1:
            push(tg, parts[q])
        mb := _bind(&cs, cs.gf[gi].typarams, tg)
        cs.cf = cs.gff[gi]
        pc2, bc2 := _fnbody(&cs, fj, cs.gf[gi].body)
        _unbind(&cs, mb)
        protos = protos + pc2
        fns = fns + bc2

    # Order matters in C: opaque typedefs, then the array structs (which name
    # element types only through pointers), then struct bodies in dependency
    # order, then the enum bodies (whose payloads may hold a struct by value).
    head := ""
    cs.arena = "&_scope"
    edefs := ""
    eproto := ""
    ebody := ""
    e0, ep0, eb0 := _enum_support(&cs)
    edefs = edefs + e0
    eproto = eproto + ep0
    ebody = ebody + eb0
    sproto := ""
    sbody := ""
    sp0, sb0 := _struct_support(&cs)
    sproto = sproto + sp0
    sbody = sbody + sb0
    mtd, msb, mpr, mfb := _map_defs(&cs)
    nm := 0
    for nm != len(cs.mks):
        nm = len(cs.mks)
        mtd, msb, mpr, mfb = _map_defs(&cs)
    # The tuple generator runs FIRST, not as a discarded discovery pre-pass:
    # an array/map/soa kind only a TUPLE introduces has to be registered before
    # the array fixpoint or it never gets a body (Phase 7f: `struct TychoTup3_
    # { TychoArrK17 f0; }` with no TychoArrK17 anywhere). It used to be
    # generated twice for that -- once thrown away -- which `_need` makes
    # unnecessary: every later call adds only what is newly live.
    ttd := ""
    tsb := ""
    tpr := ""
    tfb := ""
    p1, p2, p3, p4 := _tup_defs(&cs)
    ttd = ttd + p1
    tsb = tsb + p2
    tpr = tpr + p3
    tfb = tfb + p4
    npre := 0
    for npre != len(cs.tks):
        npre = len(cs.tks)
        p1, p2, p3, p4 = _tup_defs(&cs)
        ttd = ttd + p1
        tsb = tsb + p2
        tpr = tpr + p3
        tfb = tfb + p4
    osb, ofb := _soa_defs(&cs)
    no := 0
    for no != len(cs.oks):
        no = len(cs.oks)
        osb, ofb = _soa_defs(&cs)
    atd := ""
    asb := ""
    apr := ""
    afb := ""
    a1, a2, a3, a4 := _arr_defs(&cs)
    atd = atd + a1
    asb = asb + a2
    apr = apr + a3
    afb = afb + a4
    nk := 0
    for nk != len(cs.akinds):
        nk = len(cs.akinds)
        a1, a2, a3, a4 = _arr_defs(&cs)
        atd = atd + a1
        asb = asb + a2
        apr = apr + a3
        afb = afb + a4
    # `extern double strx_parse_double(char *, tycho_int *);` -- the foreign
    # symbol's prototype, matching ./tychoc. An inout parameter is a pointer.
    # ./tychoc emits these INTERLEAVED with the ordinary prototypes (one loop
    # over the whole proc list, src/tychoc.c:13804), so the block lands directly
    # in front of them -- not up in the type header.
    xpro := ""
    for xi := 0; xi < len(cs.fds); xi += 1:
        # The name is bound FIRST. Passing `cs.fds[xi].name` straight into a
        # call that also takes `&cs` reads a field of the very value being
        # borrowed, and the argument came out as a garbage pointer.
        xnm := cs.fds[xi].name
        if not _isext(&cs, xnm):
            continue
        xps := ""
        for xj := 0; xj < len(cs.fds[xi].ptypes); xj += 1:
            if xj > 0:
                xps = xps + ", "
            # A `bytes` PARAMETER is (data, len), matching the call site.
            if cs.fds[xi].ptypes[xj] == "bytes" and not cs.fds[xi].pinout[xj]:
                xps = xps + "const unsigned char *, tycho_int"
                continue
            # So is an ARRAY: the shim gets the element pointer and the count,
            # never the array struct by value (`osx_exec(argv: [string])`).
            if _is_arr(cs.fds[xi].ptypes[xj]) and not cs.fds[xi].pinout[xj]:
                el := _elem(cs.fds[xi].ptypes[xj])
                if el == "string":
                    xps = xps + "const char *const *, tycho_int"
                else:
                    xps = xps + "const " + _ctyz(&cs, el) + "*, tycho_int"
                continue
            xps = xps + _ctyz(&cs, cs.fds[xi].ptypes[xj])
            if cs.fds[xi].pinout[xj]:
                xps = xps + "*"
        xrt := _ctyz(&cs, cs.fds[xi].ret)
        # An `Option(string)` return crosses as a plain `char *`: NULL is None.
        # Declaring it as the Option ENUM pointer made the caller read a tag out
        # of a C string -- "tycho: non-exhaustive match" in core:io's line
        # reader (iox_read_line).
        if _is_optT(&cs, cs.fds[xi].ret) and _opt_inner(&cs, cs.fds[xi].ret) == "string":
            xrt = "char *"
        # An ARRAY return crosses the same way: void, plus (ptr, len) out-
        # parameters. Declaring it as TychoArrInt made cc read a struct return
        # where the shim writes through two pointers.
        if _is_arr(cs.fds[xi].ret) and (_elem(cs.fds[xi].ret) == "int" or
                _elem(cs.fds[xi].ret) == "float"):
            xrt = "void "
            if len(xps) > 0:
                xps = xps + ", "
            xps = xps + _ctyz(&cs, _elem(cs.fds[xi].ret)) + "**, tycho_int *"
        if cs.fds[xi].ret == "bytes":
            # A `bytes` return crosses the ABI as (ptr, len) OUT-PARAMETERS and
            # the C function returns void; the caller wraps them with
            # tycho_bytes_from_c. ./tychoc emits
            #   extern void iox_read_file(char *, tycho_int *,
            #                             unsigned char **, tycho_int *);
            # Returning char * instead passes 2 arguments where the shim reads
            # 4 -- which is why io.read_text answered NotFound for a file that
            # exists, and why dropping the argument copy turned it into a
            # segfault. A `string` return does NOT use this form.
            xrt = "void "
            if len(xps) > 0:
                xps = xps + ", "
            xps = xps + "unsigned char **, tycho_int *"
        if len(xps) == 0:
            xps = "void"
        xpro = xpro + "extern " + xrt + cs.fds[xi].name +
            "(" + xps + ");\n"
    for i in _struct_order(&cs):
        head = head + "struct S_" + cs.sds[i].name + "_ {\n"
        for j := 0; j < len(cs.sds[i].fnames); j += 1:
            head = head + "    " + _ctyz(&cs, cs.sds[i].ftypes[j]) + "f_" +
                cs.sds[i].fnames[j] + ";\n"
        if len(cs.sds[i].fnames) == 0:
            head = head + "    char _empty;\n"
        head = head + "};\n"
    ftd := _fn_defs(&cs)
    nfk := 0
    for nfk != len(cs.fks):
        nfk = len(cs.fks)
        ftd = _fn_defs(&cs)
    cpr, cbd := _clo_defs(&cs)
    lpr := ""
    lbd := ""
    for x in cs.lamp:
        lpr = lpr + x
    for x in cs.lamd:
        lbd = lbd + x
    hpr := ""
    hfb := ""
    hp0, hf0 := _hash_defs(&cs)
    hpr = hpr + hp0
    hfb = hfb + hf0
    chd := _chan_defs(&cs)
    spd := ""
    for x in cs.spawnd:
        spd = spd + x
    # THE CLOSURE. A helper's own body goes through the same funnels as ordinary
    # emitted code, so writing one marks the ones it calls: a struct's str()
    # marks the str of every field type, an array's copy marks the element's.
    # Re-run every gated generator while the live set grows -- `_need` is what
    # stops a re-run writing anything twice, so this costs one extra sweep over
    # the registries and nothing else. Everything that can mark a name has run
    # by here, channels and closures included.
    nu := -1
    for nu != len(cs.used):
        nu = len(cs.used)
        e2, ep2, eb2 := _enum_support(&cs)
        edefs = edefs + e2
        eproto = eproto + ep2
        ebody = ebody + eb2
        sp2, sb2 := _struct_support(&cs)
        sproto = sproto + sp2
        sbody = sbody + sb2
        q1, q2, q3, q4 := _tup_defs(&cs)
        ttd = ttd + q1
        tsb = tsb + q2
        tpr = tpr + q3
        tfb = tfb + q4
        hp2, hf2 := _hash_defs(&cs)
        hpr = hpr + hp2
        hfb = hfb + hf2
        if nm != len(cs.mks):
            nm = len(cs.mks)
            mtd, msb, mpr, mfb = _map_defs(&cs)
        if no != len(cs.oks):
            no = len(cs.oks)
            osb, ofb = _soa_defs(&cs)
        b1, b2, b3, b4 := _arr_defs(&cs)
        atd = atd + b1
        asb = asb + b2
        apr = apr + b3
        afb = afb + b4
        for nk != len(cs.akinds):
            nk = len(cs.akinds)
            b1, b2, b3, b4 = _arr_defs(&cs)
            atd = atd + b1
            asb = asb + b2
            apr = apr + b3
            afb = afb + b4
    htd := "\n/* ---- generated from Tycho source ---- */\n\n"
    for sd in cs.sds:
        htd = htd + "typedef struct S_" + sd.name + "_ S_" + sd.name + ";\n"
    for ed in cs.eds:
        htd = htd + "typedef struct E_" + ed.name + " E_" + ed.name + ";\n"
    htd = htd + "\n" + mtd
    head = atd + asb + msb + osb + "\n" + head
    head = htd + ttd + ftd + head + tsb + edefs + "\n" + apr + sproto + eproto +
        tpr + mpr + hpr + "\n" + afb + sbody + ebody + tfb + hfb + mfb + ofb + "\n"

    # `fn main() -> Result(void, string)`: an Err reaching the entry point is
    # PRINTED and exits 1 -- the error type is the message (src/tychoc.c:9311).
    mfi := _fidx(&cs, "main")
    mcall := "    h_main(&_root);\n"
    mtail := "    arena_free(&_root);\n    return 0;\n"
    if mfi >= 0 and _is_resT(&cs, cs.fds[mfi].ret):
        mcall = "    " + _ctyz(&cs, cs.fds[mfi].ret) + "_r = h_main(&_root);\n" +
            "    int _st = 0;\n" +
            "    if (_r->tag == 1) { tycho_eprint(_r->u.Err.f0); tycho_eprint(\"\\n\"); _st = 1; }\n"
        mtail = "    arena_free(&_root);\n    return _st;\n"
    entry := "int main(int argc, char **argv) {\n" +
        "    tycho_hash_seed_init();  /* random per-process map-hash seed, before any map use */\n" +
        "    tycho_argc = argc; tycho_argv = argv;  /* exposed to the program via args() */\n" +
        "    Arena _root = arena_new(0);  /* root arena; default block size */\n" +
        mcall + mtail + "}\n"
    return head + xpro + protos + cpr + lpr + "\n" + chd + spd + cbd + lbd + fns + entry
