package emit

import "../ast"
import "../lex"
import "../parse"
import "core:strings"

# ast -> C, against the same runtime ABI src/tychoc.c targets: one
# `RET h_<fn>(Arena *_parent, ...)` per function, an `arena_child` scope inside
# it, and every allocation made in that scope. A returned value is deep-copied
# into the CALLER's arena before the scope is freed, which is the unoptimised
# form of src/tychoc.c's return-only-escape pass -- correct, and slower.
#
# Four of src/tychoc.c's optimisation passes are ported: the match-arm payload
# borrow (`compiler/emit/emit.ty@_mroot`), the string self-append accumulator
# (`compiler/emit/emit.ty@_acc_scan`), a weak return-slot move, and the
# per-iteration loop scratch arena (`compiler/emit/emit.ty@_curown`). The rest
# are not, and the cost is measured, not guessed. plan.md ranks them.
#
# Scope is the core language: scalars, strings, arrays, structs, enums, control
# flow, functions.
# Everything else dies by name so a fixture fails loudly rather than silently.

struct SD:
    name: string
    fnames: [string]
    ftypes: [string]
    fcaps: [int]                       # a `bounded[N]T` field's N, else 0

struct VD:
    name: string
    ptypes: [string]

struct ED:
    name: string
    vnames: [string]
    vpay: [VD]

struct FD:
    name: string
    pnames: [string]
    ptypes: [string]
    pinout: [bool]
    psink: [bool]                      # src/tychoc.c@g_param_sink -- a `sink` (owned) parameter
    pvar: bool
    ret: string
    psize: [string]                    # the `$N` this parameter's `[$N]T` names

struct C:
    sds: [SD]
    eds: [ED]
    fds: [FD]
    akinds: [string]
    cnames: [string]
    ctypes: [string]
    ccode: [string]
    vnames: [string]
    vtypes: [string]
    vcn: [string]
    vown: [string]
    ntn: [string]
    ntu: [string]
    tks: [string]
    mks: [string]
    fks: [string]
    clos: [string]
    lamd: [string]
    lamp: [string]
    gks: [string]
    gs: [ast.StructD]
    ge: [ast.EnumD]
    gf: [ast.Fn]
    tpn: [string]
    tpv: [string]
    pk: [int]
    ptv: [string]
    ikey: [string]
    iname: [string]
    iarg: [string]
    pendk: [int]
    fpfx: [string]
    ala: [string]
    alp: [string]
    cf: int
    gsf: [int]
    gef: [int]
    gff: [int]
    ntt: [ast.Ty]
    ntf: [int]
    edp: [string]
    want: string
    tmp: int
    cur_ret: string
    loopdepth: int
    arena: string
    oks: [string]
    ewlen: bool
    accs: [string]
    vacc: [string]
    exn: [string]
    smap: [string: int]                # same for structs and enums
    emap: [string: int]
    fmap: [string: int]                # fds name -> index, rebuilt when fds grows
    fnbase: int                        # first local slot; params below it are BORROWS
    hdn: [string]                      # handle type names, and the free fn each names
    hdf: [string]
    ckinds: [string]                   # channel ELEMENT types, one helper family each
    spawnd: [string]                   # per-spawn-site thunk + arg struct
    subn: [string]
    subp: [[ast.Param]]
    sube: [ast.Expr]
    ascope: [string]                   # enclosing loop scratch arenas, innermost last
    uid: int                           # src/tychoc.c@g_forin_uid -- a SECOND counter, not g_blk
    pname: string                      # src/tychoc.c@g_cur_proc_name -- the scratch-arena label
    lbl: int                           # src/tychoc.c@g_loop_lbl -- per-proc, counts EVERY loop
    lpost: [int]                       # src/tychoc.c@g_loop_post -- -1, or the `continue` target
    pbody: [ast.Stmt]                  # src/tychoc.c@g_proc_body -- the move-on-last-use read scan
    elv: [string]                      # src/tychoc.c@g_elide -- monotone loop var,
    ela: [string]                      # and the array its index is proven against
    escs: [string]                     # src/tychoc.c@g_esc -- top-level locals returned by name
    retslot: bool                      # emitting the ELEMENTS of a tuple that is being returned
    used: [string: bool]               # generated helper names the emitted text actually calls
    hdone: [string: bool]              # already written, so a re-run adds only what is new
    lmark: [int]                       # var mark at each loop entry, for break/continue frees
    fua: [string]                      # src/tychoc.c@g_fuse -- push-fused array names
    fuid: [string]                     # each one's hoisted cursor suffix
    fuel: [string]                     # each one's element type

fn _new() -> C:
    return C([], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], -1, [], [], [], []ast.Ty, [], [], "", 0, "void", 0, "&_scope", [], false, [], [], [], []string: int, []string: int, []string: int, 0, [], [], [], [], [], [][ast.Param], []ast.Expr, [], 0, "", 0, []int, []ast.Stmt, [], [], [], false, []string: bool, []string: bool, []int, [], [], [])

fn _bad(msg: string):
    die("tychoc1: " + msg)

# --- package mangling -------------------------------------------------------
# src/tychoc.c@pkg_prefix_for: a name declared in package `geom` is emitted as
# `geom__name`; the ENTRY package carries no prefix. A qualifier resolves
# through the alias table to the package's real name (an aliased import binds
# the alias to the path's last component). Diagnostics keep the source spelling
# -- nothing here is ever printed.

fn _pfx(cs: inout C) -> string:
    if cs.cf < 0 or cs.cf >= len(cs.fpfx):
        return ""
    return cs.fpfx[cs.cf]

fn _qpfx(cs: inout C, q: string) -> string:
    for i := 0; i < len(cs.ala); i += 1:
        if cs.ala[i] == q:
            return cs.alp[i] + "__"
    return q + "__"

fn _pkg_base(path: string) -> string:
    s := path
    if len(s) > 5 and s[0:5] == "core:":
        s = s[5:]
    cut := -1
    for i := 0; i < len(s); i += 1:
        if s[i] == 47:
            cut = i
    if cut < 0:
        return s
    return s[cut + 1:]

fn _ispkg(cs: inout C, q: string) -> bool:
    for i := 0; i < len(cs.ala); i += 1:
        if cs.ala[i] == q:
            return true
    return false

# --- type strings -----------------------------------------------------------
# "int" "float" "bool" "string" "char" "void"; "[T]"; "S~Name"; "E~Name".

# The fixed-width family. Their C types wrap natively at their own width, which
# is why every sized result is cast back to it -- integer promotion would take
# `u8 * u8` to `int` and 400 would print as 400 rather than 144.
fn _is_uint(t: string) -> bool:
    return t == "u8" or t == "u16" or t == "u32" or t == "u64"

fn _is_sint(t: string) -> bool:
    return t == "i8" or t == "i16" or t == "i32" or t == "i64"

fn _width(t: string) -> int:
    if t == "u8" or t == "i8":
        return 8
    if t == "u16" or t == "i16":
        return 16
    if t == "u32" or t == "i32":
        return 32
    return 64

fn _is_sized(t: string) -> bool:
    return _is_uint(t) or _is_sint(t) or t == "f32"

fn _is_arr(t: string) -> bool:
    return len(t) > 2 and t[0] == 91

fn _elem(t: string) -> string:
    return t[1:len(t) - 1]

fn _is_struct(t: string) -> bool:
    return strings.starts_with(t, "S~")

fn _is_enum(t: string) -> bool:
    return strings.starts_with(t, "E~")

fn _tname(t: string) -> string:
    return t[2:]

# A newtype is ERASED in lowering (spec 5.4): it is represented exactly as its
# underlying type, so `_ty` resolves the name away and nothing downstream ever
# sees one.
fn _ntidx(cs: inout C, n: string) -> int:
    p := _pfx(&cs)
    if len(p) > 0:
        for i := 0; i < len(cs.ntn); i += 1:
            if cs.ntn[i] == p + n:
                return i
    for i := 0; i < len(cs.ntn); i += 1:
        if cs.ntn[i] == n:
            return i
    return -1

# A tuple type is stamped out like an array kind: the registry key is the
# element type strings joined by "|", and the type string is "T~<index>".
fn _is_tup(t: string) -> bool:
    return strings.starts_with(t, "T~")

fn _tkind(cs: inout C, key: string) -> int:
    for i := 0; i < len(cs.tks); i += 1:
        if cs.tks[i] == key:
            return i
    push(cs.tks, key)
    return len(cs.tks) - 1

fn _tjoin(es: [string]) -> string:
    k := ""
    for i := 0; i < len(es); i += 1:
        if i > 0:
            k = k + "|"
        k = k + es[i]
    return k

fn _telems(cs: inout C, t: string) -> [string]:
    i := strings.parse_int(_tname(t))
    return split(cs.tks[i], "|")

fn _tup_of(cs: inout C, es: [string]) -> string:
    return "T~" + str(_tkind(&cs, _tjoin(es)))

# A map type is stamped out per (key, value) pair exactly as a tuple kind is:
# the registry key is "K|V" and the type string is "M~<index>". The emitted C
# mirrors src/tychoc.c:12894's compact indexed dict -- an int32 index table over
# dense insertion-ordered entries -- so keys() order and str() form agree.
# The `$N` a parameter's written type names, if it is `[$N]T`. Emit lowers every
# array to the dynamic one, so N is not a monomorphisation key here: inside the
# body it is the argument's own length, which for a fixed array IS N.
fn _sizep_of(t: [ast.Ty]) -> string:
    if len(t) == 0:
        return ""
    match t[0]:
        ast.TFix(sz, e):
            if len(sz) > 1 and sz[0] == 36:
                return sz[1:]
            return ""
        _: return ""
    return ""

# A `bounded[N]T` capacity, from the type AS WRITTEN. Emit lowers a bounded
# array to the dynamic one, so N survives nowhere else -- and without it the
# over-capacity push, whose whole point is to trap, silently grew the array.
# The bounded capacity of a push TARGET, when it is a field of a struct whose
# declaration named one. A local's own `bounded[N]` annotation is not tracked
# here.
# gap: `xs: bounded[2]int` as a LOCAL still grows past its capacity.
fn _cap_of_target(cs: inout C, e: ast.Expr) -> int:
    match e:
        ast.Field(l, r, f):
            rt := _argtypes(&cs, r)[0]
            if _is_struct(rt):
                si := _sidx(&cs, _tname(rt))
                if si >= 0:
                    for j := 0; j < len(cs.sds[si].fnames) and j < len(cs.sds[si].fcaps); j += 1:
                        if cs.sds[si].fnames[j] == f:
                            return cs.sds[si].fcaps[j]
            return 0
        _: return 0
    return 0

fn _capof(cs: inout C, t: ast.Ty) -> int:
    match t:
        ast.TBnd(sz, e):
            if len(sz) > 0 and sz[0] >= 48 and sz[0] <= 57:
                return _dec2(sz)
            ci := _cidx(&cs, sz)
            if ci >= 0:
                return _dec2(cs.ccode[ci])
            return 0
        _: return 0
    return 0

fn _dec2(s: string) -> int:
    v := 0
    for i := 0; i < len(s); i += 1:
        if s[i] < 48 or s[i] > 57:
            return v
        v = v * 10 + (s[i] - 48)
    return v

fn _is_handle(t: string) -> bool:
    return len(t) > 2 and t[0:2] == "H~"

fn _hfree(cs: inout C, t: string) -> string:
    n := t[2:]
    for i := 0; i < len(cs.hdn); i += 1:
        if cs.hdn[i] == n:
            return cs.hdf[i]
    return ""

fn _hidx(cs: inout C, n: string) -> int:
    for i := 0; i < len(cs.hdn); i += 1:
        if cs.hdn[i] == n:
            return i
    return -1

fn _is_chan(t: string) -> bool:
    return len(t) > 5 and t[0:5] == "chan("

fn _is_task(t: string) -> bool:
    return len(t) > 5 and t[0:5] == "task("

# The channel's element type, and the family index that names its helpers.
fn _cinner(t: string) -> string:
    if _is_chan(t) or _is_task(t):
        return t[5:len(t) - 1]
    return "?"

fn _ckind(cs: inout C, elem: string) -> int:
    for i := 0; i < len(cs.ckinds); i += 1:
        if cs.ckinds[i] == elem:
            return i
    push(cs.ckinds, elem)
    return len(cs.ckinds) - 1

fn _is_map(t: string) -> bool:
    return strings.starts_with(t, "M~")

fn _mkind(cs: inout C, key: string) -> int:
    for i := 0; i < len(cs.mks); i += 1:
        if cs.mks[i] == key:
            return i
    push(cs.mks, key)
    return len(cs.mks) - 1

fn _map_of(cs: inout C, k: string, v: string) -> string:
    return "M~" + str(_mkind(&cs, k + "|" + v))

fn _mparts(cs: inout C, t: string) -> [string]:
    i := strings.parse_int(_tname(t))
    return split(cs.mks[i], "|")

fn _mkey(cs: inout C, t: string) -> string:
    return _mparts(&cs, t)[0]

fn _mval(cs: inout C, t: string) -> string:
    return _mparts(&cs, t)[1]

fn _mpfx(cs: inout C, t: string) -> string:
    return "tycho_mapM" + _tname(t)

# A soa type is stamped out per ELEMENT STRUCT, keyed by the struct's type
# string, and spelled "O~<index>". src/tychoc.c:13034 emits the same shape: one
# growable arena buffer per field plus a shared len/cap.
fn _is_soa(t: string) -> bool:
    return strings.starts_with(t, "O~")

fn _okind(cs: inout C, key: string) -> int:
    for i := 0; i < len(cs.oks); i += 1:
        if cs.oks[i] == key:
            return i
    push(cs.oks, key)
    return len(cs.oks) - 1

fn _soa_of(cs: inout C, st: string) -> string:
    if not _is_struct(st):
        _bad("a soa element must be a struct, not '" + st + "'")
    return "O~" + str(_okind(&cs, st))

fn _selem(cs: inout C, t: string) -> string:
    return cs.oks[strings.parse_int(_tname(t))]

fn _spfx(cs: inout C, t: string) -> string:
    return "Soa" + _tname(t)

# `ps[i].x` -> `((ps).fN[SoaK_bound(&(ps), i)])`. The bound call is emitted per
# OCCURRENCE, matching ./tychoc: `ps[2].z = ps[2].z + 1` checks twice.
fn _soafld(cs: inout C, bc: string, bt: string, ic: string, f: string) -> (string, string):
    st := _selem(&cs, bt)
    si := _sidx(&cs, _tname(st))
    for i := 0; i < len(cs.sds[si].fnames); i += 1:
        if cs.sds[si].fnames[i] == f:
            return ("((" + bc + ").f" + str(i) + "[" + _spfx(&cs, bt) + "_bound(&(" +
                bc + "), " + ic + ")])", cs.sds[si].ftypes[i])
    _bad("no field '" + f + "' on " + _tname(st))
    return ("", "")

# How a key is REPRESENTED in the entry table: a fieldless enum is stored as its
# tag, so `keys()` has to rebuild the singleton (src/tychoc.c:12926).
fn _kclass(cs: inout C, k: string) -> string:
    if k == "string":
        return "str"
    if k == "int" or k == "char" or k == "bool":
        return "int"
    if _is_enum(k):
        return "enum"
    if _is_struct(k) or _is_tup(k) or _is_arr(k):
        return "comp"
    _bad("a map key of type '" + k + "' is not hashable")
    return ""

fn _kslot(cs: inout C, k: string) -> string:
    c := _kclass(&cs, k)
    if c == "str":
        return "char *"
    if c == "int" or c == "enum":
        return "tycho_int "
    return _ctyz(&cs, k) + ""

# The key as the generated functions take it, from a Tycho-level value.
fn _keyrt(cs: inout C, k: string, code: string) -> string:
    if _kclass(&cs, k) == "enum":
        return "((tycho_int)((" + code + ")->tag))"
    return code

fn _khash(cs: inout C, k: string, e: string) -> string:
    c := _kclass(&cs, k)
    if c == "str":
        return "tycho_si_hash(" + e + ")"
    if c == "int" or c == "enum":
        return "tycho_ik_hash((tycho_int)(" + e + "))"
    return _hash(&cs, k, e)

fn _kmatch(cs: inout C, k: string, ek: string, q: string) -> string:
    c := _kclass(&cs, k)
    if c == "str":
        # strcmp stops at the first NUL, so "a" and "a\0b" compared EQUAL
        # whenever the seed put them in one bucket -- tests/strbytes.ty failed
        # about one run in five. tycho_str_cmp carries the length.
        return "tycho_str_eq(" + ek + ", " + q + ")"
    if c == "int" or c == "enum":
        return "(" + ek + " == " + q + ")"
    return _eq(&cs, ek, q, k)

fn _kcopy(cs: inout C, k: string) -> string:
    c := _kclass(&cs, k)
    if c == "str":
        return "tycho_str_copy(a, k)"
    if c == "int" or c == "enum":
        return "k"
    return _copy(&cs, "k", k, "a")

# A struct/tuple key hashes field-wise, FNV-folded from the per-process seed --
# src/tychoc.c:10170's gen_hash, which is what makes `==`-equal values hash equal.
fn _hashable(cs: inout C, t: string) -> bool:
    return _hashable_d(&cs, t, 0)

# Depth-bounded: a struct whose field is an array OF ITSELF is a legal recursive
# shape and would otherwise recurse forever here.
fn _hashable_d(cs: inout C, t: string, d: int) -> bool:
    if d > 8:
        return false
    if t == "int" or t == "char" or t == "bool" or t == "float" or t == "string":
        return true
    if _is_enum(t):
        i := _eidx(&cs, t[2:])
        if i < 0:
            return false
        for v in cs.eds[i].vpay:
            if len(v.ptypes) > 0:
                return false
        return true
    if _is_arr(t):
        return _hashable_d(&cs, _elem(t), d + 1)
    if _is_struct(t):
        i2 := _sidx(&cs, _tname(t))
        if i2 < 0:
            return false
        for ft in cs.sds[i2].ftypes:
            if not _hashable_d(&cs, ft, d + 1):
                return false
        return true
    if _is_tup(t):
        for et in _telems(&cs, t):
            if not _hashable_d(&cs, et, d + 1):
                return false
        return true
    return false

# The DETERMINISTIC twin of _hash: the `hash()` builtin must not depend on the
# per-process map seed, so it uses the runtime's `_det` family and the generated
# `dhash` bodies (src/tychoc.c emits the same pair).
# ---------------------------------------------------------- dead helpers
#
# A generated helper family is emitted whole -- one [float] anywhere gives the
# unit every operation on it -- and most of a unit's helpers are never called.
# `_u` is threaded through the four funnels that FORM a helper's name (_copy,
# _eq, _tostr, _hash/_hash_det), so a name is live exactly when something the
# unit emits mentions it; `_need` answers "live, and not written yet".
#
# The closure is transitive because a helper's own generator goes through the
# same funnels: writing tycho_str_S_x marks the str of every field type. That
# only terminates if the generators are RE-RUN while the live set grows, which
# is the fixpoint at the end of `program` -- `_need` is what keeps a re-run
# from writing anything twice.
fn _u(cs: inout C, n: string) -> string:
    cs.used[n] = true
    return n

fn _once(cs: inout C, n: string) -> bool:
    if n in cs.hdone:
        return false
    cs.hdone[n] = true
    return true

fn _need(cs: inout C, n: string) -> bool:
    if not (n in cs.used):
        return false
    if n in cs.hdone:
        return false
    cs.hdone[n] = true
    return true

fn _hash_det(cs: inout C, t: string, v: string) -> string:
    if t == "string" or t == "bytes":
        return "tycho_si_hash_det(" + v + ")"
    if t == "float":
        return "tycho_ik_hash_det((tycho_int)((union { double _d; tycho_int _l; }){ ._d = (" +
            v + ") })._l)"
    if _is_enum(t):
        return "tycho_ik_hash_det((tycho_int)((" + v + ")->tag))"
    if _is_struct(t):
        dsn := _u(&cs, "tycho_dhash_S_" + _tname(t))
        return dsn + "(" + v + ")"
    if _is_tup(t):
        dtn := _u(&cs, "tycho_dhash_T" + _tname(t))
        return dtn + "(" + v + ")"
    if _is_arr(t):
        e := _elem(t)
        if e == "int":
            return "tycho_arr_int_hash_det(" + v + ")"
        if e == "float":
            return "tycho_arr_float_hash_det(" + v + ")"
        if e == "string":
            return "tycho_arr_str_hash_det(" + v + ")"
        adn := "tycho_arr_K" + str(_akind(&cs, e)) + "_dhash"
        return _u(&cs, adn) + "(" + v + ")"
    return "tycho_ik_hash_det((tycho_int)(" + v + "))"

fn _hash(cs: inout C, t: string, v: string) -> string:
    if t == "string":
        return "tycho_si_hash(" + v + ")"
    if t == "float":
        return "tycho_ik_hash((tycho_int)((union { double _d; tycho_int _l; }){ ._d = (" +
            v + ") })._l)"
    if _is_enum(t):
        return "tycho_ik_hash((tycho_int)((" + v + ")->tag))"
    if _is_struct(t):
        hsn := _u(&cs, "tycho_hash_S_" + _tname(t))
        return hsn + "(" + v + ")"
    if _is_tup(t):
        htn := _u(&cs, "tycho_hash_T" + _tname(t))
        return htn + "(" + v + ")"
    if _is_arr(t):
        e := _elem(t)
        if e == "int":
            return "tycho_arr_int_hash(" + v + ")"
        if e == "float":
            return "tycho_arr_float_hash(" + v + ")"
        if e == "string":
            return "tycho_arr_str_hash(" + v + ")"
        ahn := "tycho_arr_K" + str(_akind(&cs, e)) + "_hash"
        return _u(&cs, ahn) + "(" + v + ")"
    return "tycho_ik_hash((tycho_int)(" + v + "))"

# Option and Result are monomorphised into ordinary enums, one per
# instantiation, named `_G<n>` so `_bare_variant` can tell them from a user
# enum -- otherwise a bare `Ok` would resolve into a generated one.
fn _gname(cs: inout C, key: string) -> string:
    for i := 0; i < len(cs.gks); i += 1:
        if cs.gks[i] == key:
            return "_G" + str(i)
    push(cs.gks, key)
    return "_G" + str(len(cs.gks) - 1)

fn _is_gen(n: string) -> bool:
    return strings.starts_with(n, "_G")

# The payload type of an Option INSTANCE (the enum's Some arm).
fn _opt_inner(cs: inout C, t: string) -> string:
    if not _is_optT(&cs, t):
        return ""
    ei := _eidx(&cs, _tname(t))
    if ei < 0:
        return ""
    pay := cs.eds[ei].vpay[_tag(&cs, ei, "Some")].ptypes
    if len(pay) == 0:
        return ""
    return pay[0]

fn _opt_of(cs: inout C, t: string) -> string:
    nm := _gname(&cs, "O|" + t)
    if _eidx(&cs, nm) < 0:
        vs := []VD
        push(vs, VD("None", []string))
        ps := []string
        push(ps, t)
        push(vs, VD("Some", ps))
        push(cs.eds, ED(nm, ["None", "Some"], vs))
        push(cs.edp, "")
    return "E~" + nm

fn _res_of(cs: inout C, t: string, e: string) -> string:
    nm := _gname(&cs, "R|" + t + "|" + e)
    if _eidx(&cs, nm) < 0:
        ok := []string
        if t != "void":
            push(ok, t)
        er := []string
        push(er, e)
        vs := []VD
        push(vs, VD("Ok", ok))
        push(vs, VD("Err", er))
        push(cs.eds, ED(nm, ["Ok", "Err"], vs))
        push(cs.edp, "")
    return "E~" + nm

# `want` is the type an expression is being built FOR. `None` and `Err(e)` carry
# no way to name their own instantiation, so without it they cannot be emitted.
fn _is_optT(cs: inout C, t: string) -> bool:
    if not _is_enum(t):
        return false
    i := _eidx(&cs, _tname(t))
    return i >= 0 and _is_gen(_tname(t)) and cs.eds[i].vnames[0] == "None"

fn _is_resT(cs: inout C, t: string) -> bool:
    if not _is_enum(t):
        return false
    i := _eidx(&cs, _tname(t))
    return i >= 0 and _is_gen(_tname(t)) and cs.eds[i].vnames[0] == "Ok"

# A type whose value owns arena memory: copying it means a deep copy.
fn _heap(cs: inout C, t: string) -> bool:
    if t == "string" or t == "bytes":
        return true
    if _is_fn(t):
        return true
    if _is_arr(t) or _is_enum(t) or _is_map(t) or _is_soa(t):
        return true
    if _is_struct(t):
        i := _sidx(&cs, _tname(t))
        if i < 0:
            return false
        for ft in cs.sds[i].ftypes:
            if _heap(&cs, ft):
                return true
    if _is_tup(t):
        for et in _telems(&cs, t):
            if _heap(&cs, et):
                return true
    return false

fn _sidx(cs: inout C, n: string) -> int:
    if len(cs.smap) != len(cs.sds):
        cs.smap = []string: int
        for i := 0; i < len(cs.sds); i += 1:
            if not (cs.sds[i].name in cs.smap):
                cs.smap[cs.sds[i].name] = i
    p := _pfx(&cs)
    if len(p) > 0 and (p + n) in cs.smap:
        return cs.smap[p + n]
    if n in cs.smap:
        return cs.smap[n]
    return -1

fn _eidx(cs: inout C, n: string) -> int:
    if len(cs.emap) != len(cs.eds):
        cs.emap = []string: int
        for i := 0; i < len(cs.eds); i += 1:
            if not (cs.eds[i].name in cs.emap):
                cs.emap[cs.eds[i].name] = i
    p := _pfx(&cs)
    if len(p) > 0 and (p + n) in cs.emap:
        return cs.emap[p + n]
    if n in cs.emap:
        return cs.emap[n]
    return -1

fn _cidx(cs: inout C, n: string) -> int:
    p := _pfx(&cs)
    if len(p) > 0:
        for i := 0; i < len(cs.cnames); i += 1:
            if cs.cnames[i] == p + n:
                return i
    for i := 0; i < len(cs.cnames); i += 1:
        if cs.cnames[i] == n:
            return i
    return -1

# An extern is called by its BARE C name with no arena: it is a foreign symbol,
# not a Tycho proc. `./tychoc` emits `strx_parse_double(h_s, &(h_st))`.
fn _isext(cs: inout C, n: string) -> bool:
    for i := 0; i < len(cs.exn); i += 1:
        if cs.exn[i] == n:
            return true
    return false

# A MAP, not a scan. This is called once per emitted call and the table holds
# every function in the program: callgrind put the linear version at 6.1% of a
# self-compile, with its string compares showing up again under memcmp.
fn _fidx(cs: inout C, n: string) -> int:
    if len(cs.fmap) != len(cs.fds):
        cs.fmap = []string: int
        for i := 0; i < len(cs.fds); i += 1:
            if not (cs.fds[i].name in cs.fmap):
                cs.fmap[cs.fds[i].name] = i
    p := _pfx(&cs)
    if len(p) > 0 and (p + n) in cs.fmap:
        return cs.fmap[p + n]
    if n in cs.fmap:
        return cs.fmap[n]
    return -1

# The generated-array registry. int/float/string reuse the runtime's own three
# array types; everything else gets a stamped-out TychoArrK<n>.
fn _akind(cs: inout C, elem: string) -> int:
    if elem == "void":
        _bad("array of 'void'")
    for i := 0; i < len(cs.akinds); i += 1:
        if cs.akinds[i] == elem:
            return i
    push(cs.akinds, elem)
    return len(cs.akinds) - 1

# `_apfx` names the family; `_arrf` names ONE operation and marks it live. Every
# site that spells an array helper goes through it, which is what lets
# `_arr_defs` write `_reserve` for a kind that reserves and not for one that
# does not. int/float/string arrays are the RUNTIME's types, so marking them is
# a no-op -- nothing gates them.
fn _arrf(cs: inout C, elem: string, op: string) -> string:
    n := _apfx(&cs, elem) + op
    return _u(&cs, n)

fn _apfx(cs: inout C, elem: string) -> string:
    if elem == "int":
        return "tycho_arr_int"
    if elem == "float":
        return "tycho_arr_float"
    if elem == "string":
        return "tycho_arr_str"
    return "tycho_arr_K" + str(_akind(&cs, elem))

# --- generics: monomorphised, one deep instance per distinct binding ---------
# src/tychoc.c:12773 clones the template body per instance and resolves it; the
# same shape here, with a `tpn/tpv` binding stack instead of a substitution pass.
# A binding is pushed while an instance's types (or body) are resolved and popped
# after, so a nested instantiation sees only its own parameters.

fn _gsidx(cs: inout C, n: string) -> int:
    p := _pfx(&cs)
    if len(p) > 0:
        for i := 0; i < len(cs.gs); i += 1:
            if cs.gs[i].name == p + n:
                return i
    for i := 0; i < len(cs.gs); i += 1:
        if cs.gs[i].name == n:
            return i
    return -1

fn _geidx(cs: inout C, n: string) -> int:
    p := _pfx(&cs)
    if len(p) > 0:
        for i := 0; i < len(cs.ge); i += 1:
            if cs.ge[i].name == p + n:
                return i
    for i := 0; i < len(cs.ge); i += 1:
        if cs.ge[i].name == n:
            return i
    return -1

fn _gfidx(cs: inout C, n: string) -> int:
    p := _pfx(&cs)
    if len(p) > 0:
        for i := 0; i < len(cs.gf); i += 1:
            if cs.gf[i].name == p + n:
                return i
    for i := 0; i < len(cs.gf); i += 1:
        if cs.gf[i].name == n:
            return i
    return -1

fn _tpget(cs: inout C, n: string) -> string:
    for i := len(cs.tpn) - 1; i >= 0; i -= 1:
        if cs.tpn[i] == n:
            return cs.tpv[i]
    return ""

fn _bind(cs: inout C, ns: [string], vs: [string]) -> int:
    m := len(cs.tpn)
    for i := 0; i < len(ns); i += 1:
        push(cs.tpn, ns[i])
        if i < len(vs):
            push(cs.tpv, vs[i])
        else:
            push(cs.tpv, "")
    return m

fn _unbind(cs: inout C, m: int):
    for len(cs.tpn) > m:
        pop(cs.tpn)
        pop(cs.tpv)

fn _iidx(cs: inout C, key: string) -> int:
    for i := 0; i < len(cs.ikey); i += 1:
        if cs.ikey[i] == key:
            return i
    return -1

# Without this a recursive generic at a GROWING type (`grow([x])` binding $T to
# int, [int], [[int]] ...) never reaches the fixpoint and allocates until the
# OOM killer fires. src/tychoc.c caps at the same 1024 and refuses.
fn _inst_cap(n: int):
    if n > 1024:
        _bad("too many generic instantiations (> 1024) -- a recursive generic at a growing type?")

# src/tychoc.c@type_mangle_ident: an instance is named by its type ARGUMENTS,
# not by a serial, so the name is stable across unrelated edits. "" means this
# type has no spelling here (a sized int, bytes, a handle) and the caller falls
# back to the serial, which stays unique.
fn _tmang(cs: inout C, t: string) -> string:
    if t == "int" or t == "float" or t == "string" or t == "bool" or t == "char" or t == "void":
        return t
    if _is_arr(t):
        e := _tmang(&cs, _elem(t))
        if len(e) == 0:
            return ""
        return "arr_" + e
    if _is_map(t):
        k := _tmang(&cs, _mkey(&cs, t))
        v := _tmang(&cs, _mval(&cs, t))
        if len(k) == 0 or len(v) == 0:
            return ""
        return "map_" + k + "_" + v
    if _is_chan(t):
        c := _tmang(&cs, _cinner(t))
        if len(c) == 0:
            return ""
        return "chan_" + c
    if _is_soa(t):
        st := _tmang(&cs, cs.oks[strings.parse_int(_tname(t))])
        if len(st) == 0:
            return ""
        return "soa_" + st
    if _is_tup(t):
        es := _telems(&cs, t)
        out := "tup"
        for i := 0; i < len(es); i += 1:
            one := _tmang(&cs, es[i])
            if len(one) == 0:
                return ""
            out = out + "_" + one
        return out
    if _is_optT(&cs, t):
        inr := _tmang(&cs, _opt_inner(&cs, t))
        if len(inr) == 0:
            return ""
        return "opt_" + inr
    if _is_resT(&cs, t):
        ei := _eidx(&cs, _tname(t))
        ok := "void"
        op := cs.eds[ei].vpay[_tag(&cs, ei, "Ok")].ptypes
        if len(op) > 0:
            ok = _tmang(&cs, op[0])
        ep := cs.eds[ei].vpay[_tag(&cs, ei, "Err")].ptypes
        er := ""
        if len(ep) > 0:
            er = _tmang(&cs, ep[0])
        if len(ok) == 0 or len(er) == 0:
            return ""
        return "res_" + ok + "_" + er
    if _is_struct(t) or _is_enum(t):
        return _tname(t)
    return ""

# src/tychoc.c:2235 and :2273 append one `__<type>` per type PARAMETER.
fn _instname(cs: inout C, gn: string, targs: [string]) -> string:
    out := gn
    for i := 0; i < len(targs); i += 1:
        one := _tmang(&cs, targs[i])
        if len(one) == 0:
            return gn + "__" + str(len(cs.ikey))
        out = out + "__" + one
    return out

fn _inst_struct(cs: inout C, n: string, targs: [string]) -> string:
    gi := _gsidx(&cs, n)
    gn := cs.gs[gi].name
    key := "S|" + gn + "|" + _tjoin(targs)
    ex := _iidx(&cs, key)
    if ex >= 0:
        return "S~" + cs.iname[ex]
    _inst_cap(len(cs.ikey))
    mang := _instname(&cs, gn, targs)
    push(cs.ikey, key)
    push(cs.iname, mang)
    push(cs.iarg, _tjoin(targs))
    push(cs.pendk, -1)
    push(cs.sds, SD(mang, [], [], []))
    si := len(cs.sds) - 1
    m := _bind(&cs, cs.gs[gi].typarams, targs)
    save := cs.cf
    cs.cf = cs.gsf[gi]
    for f in cs.gs[gi].fields:
        push(cs.sds[si].fnames, f.name)
        push(cs.sds[si].ftypes, _ty(&cs, f.ty))
        push(cs.sds[si].fcaps, _capof(&cs, f.ty))
    cs.cf = save
    _unbind(&cs, m)
    return "S~" + mang

fn _inst_enum(cs: inout C, n: string, targs: [string]) -> string:
    gi := _geidx(&cs, n)
    gn := cs.ge[gi].name
    key := "E|" + gn + "|" + _tjoin(targs)
    ex := _iidx(&cs, key)
    if ex >= 0:
        return "E~" + cs.iname[ex]
    _inst_cap(len(cs.ikey))
    mang := _instname(&cs, gn, targs)
    push(cs.ikey, key)
    push(cs.iname, mang)
    push(cs.iarg, _tjoin(targs))
    push(cs.pendk, -1)
    push(cs.eds, ED(mang, [], []))
    push(cs.edp, cs.fpfx[cs.gef[gi]])
    ei := len(cs.eds) - 1
    m := _bind(&cs, cs.ge[gi].typarams, targs)
    save := cs.cf
    cs.cf = cs.gef[gi]
    for v in cs.ge[gi].variants:
        push(cs.eds[ei].vnames, v.name)
        ps := []string
        for pt in v.payload:
            push(ps, _ty(&cs, pt))
        push(cs.eds[ei].vpay, VD(v.name, ps))
    cs.cf = save
    _unbind(&cs, m)
    return "E~" + mang

# The instance's own type arguments, read back out of the registry so a call
# site can unify a template type against a concrete instance.
fn _inst_of(cs: inout C, mang: string) -> [string]:
    for i := 0; i < len(cs.iname); i += 1:
        if cs.iname[i] == mang:
            return split(cs.iarg[i], "|")
    return []string

# `intern__Interner` -> `Interner`; a name with no package prefix is unchanged.
fn _shortn(n: string) -> string:
    for i := 0; i + 1 < len(n); i += 1:
        if n[i] == 95 and n[i + 1] == 95:
            return n[i + 2:]
    return n

fn _inst_base(cs: inout C, mang: string) -> string:
    for i := 0; i < len(cs.iname); i += 1:
        if cs.iname[i] == mang:
            return split(cs.ikey[i], "|")[1]
    return ""

# A call site binds the type parameters by matching the DECLARED parameter type
# against the argument's concrete type -- the same shape src/tychoc.c infers,
# structurally and left to right, first binding wins.
# Is a struct/enum declared whose SHORT name is `n`? The tables key on the
# package-mangled name, so the comparison drops the prefix.
fn _declared_short(cs: inout C, n: string) -> bool:
    for i := 0; i < len(cs.sds); i += 1:
        if _shortn(cs.sds[i].name) == n:
            return true
    for i := 0; i < len(cs.eds); i += 1:
        if _shortn(cs.eds[i].name) == n:
            return true
    return false

fn _unify(cs: inout C, t: ast.Ty, a: string, tps: [string], bs: inout [string]):
    if len(a) == 0:
        return
    match t:
        ast.TParam(n):
            for i := 0; i < len(tps); i += 1:
                if tps[i] == n and len(bs[i]) == 0:
                    bs[i] = a
            return
        ast.TArr(es):
            if _is_arr(a):
                _unify(&cs, es[0], _elem(a), tps, &bs)
            return
        ast.TSoa(es):
            if _is_soa(a):
                _unify(&cs, es[0], _selem(&cs, a), tps, &bs)
            return
        # A FUNCTION type. Without this arm `Plan($T)` holding
        # `[fn($T) -> $T]` cannot bind $T from a `[fn(int) -> int]` argument:
        # TArr recurses to the element, finds a fn, and stops. ast.TFn stores
        # the params in order with the return type LAST (compiler/ast/ast.ty:22).
        # `bounded[N]T` lowers to the dynamic array (Phase 7b), so its element
        # unifies exactly as an array's does -- `Box($T)` with `xs: bounded[4]$T`.
        ast.TBnd(nn, es):
            if _is_arr(a):
                _unify(&cs, es[0], _elem(a), tps, &bs)
            return
        ast.TFix(nn2, es):
            # `[$N]$T` -- the SIZE is not a type parameter (emit lowers every
            # array to the dynamic one and reads N as the argument's length),
            # but the ELEMENT still is.
            if _is_arr(a):
                _unify(&cs, es[0], _elem(a), tps, &bs)
            return
        ast.TFn(hr, es):
            if _is_fn(a):
                aps := _fps(&cs, a)
                np := len(es)
                if hr:
                    np = np - 1
                for fi := 0; fi < np and fi < len(aps); fi += 1:
                    _unify(&cs, es[fi], aps[fi], tps, &bs)
                if hr and np < len(es):
                    _unify(&cs, es[np], _fret(&cs, a), tps, &bs)
            return
        ast.TMap(es):
            if _is_map(a):
                _unify(&cs, es[0], _mkey(&cs, a), tps, &bs)
                _unify(&cs, es[1], _mval(&cs, a), tps, &bs)
            return
        ast.TTup(es):
            if _is_tup(a):
                el := _telems(&cs, a)
                for i := 0; i < len(es) and i < len(el); i += 1:
                    _unify(&cs, es[i], el[i], tps, &bs)
            return
        ast.TName(q, n, targs):
            if len(targs) == 0:
                # A bare `T` is the `$T` of the same short name UNLESS a type of
                # that name is DECLARED: corelib/testing has both (`t: inout T`
                # is the struct, `got: $T` the parameter), and binding the
                # struct first gave every instance the wrong element type.
                if _declared_short(&cs, n):
                    return
                for i := 0; i < len(tps); i += 1:
                    if tps[i] == n and len(bs[i]) == 0:
                        bs[i] = a
                return
            if n == "Option" and _is_optT(&cs, a):
                ei := _eidx(&cs, _tname(a))
                _unify(&cs, targs[0], cs.eds[ei].vpay[1].ptypes[0], tps, &bs)
                return
            if n == "Channel" and _is_chan(a):
                _unify(&cs, targs[0], _cinner(a), tps, &bs)
                return
            if n == "Task" and _is_task(a):
                _unify(&cs, targs[0], _cinner(a), tps, &bs)
                return
            if n == "Result" and _is_resT(&cs, a):
                ei2 := _eidx(&cs, _tname(a))
                ok := cs.eds[ei2].vpay[0].ptypes
                if len(targs) > 0 and len(ok) > 0:
                    _unify(&cs, targs[0], ok[0], tps, &bs)
                elif len(targs) > 0:
                    # `Result(void, E)`: the Ok arm carries NO payload, so the
                    # pattern's `$T` has nothing to bind against and the call
                    # was refused as uninferrable. It is void.
                    _unify(&cs, targs[0], "void", tps, &bs)
                er := cs.eds[ei2].vpay[1].ptypes
                if len(targs) > 1 and len(er) > 0:
                    _unify(&cs, targs[1], er[0], tps, &bs)
                return
            if not (_is_struct(a) or _is_enum(a)):
                return
            # The pattern names the template UNQUALIFIED (`Interner($K,$V)` as
            # written inside its own package) while the instance's base carries
            # the package prefix, so compare the short names.
            if _shortn(_inst_base(&cs, _tname(a))) != _shortn(n):
                return
            ia := _inst_of(&cs, _tname(a))
            for i := 0; i < len(targs) and i < len(ia); i += 1:
                _unify(&cs, targs[i], ia[i], tps, &bs)
            return
        _: return
    return

fn _blank(n: int) -> [string]:
    out := []string
    for i := 0; i < n; i += 1:
        push(out, "")
    return out

fn _inst_fn(cs: inout C, n: string, targs: [string]) -> int:
    gi := _gfidx(&cs, n)
    gn := cs.gf[gi].name
    key := "F|" + gn + "|" + _tjoin(targs)
    ex := _iidx(&cs, key)
    if ex >= 0:
        return _fidx(&cs, cs.iname[ex])
    _inst_cap(len(cs.ikey))
    mang := _instname(&cs, gn, targs)
    push(cs.ikey, key)
    push(cs.iname, mang)
    push(cs.iarg, _tjoin(targs))
    push(cs.pendk, -1)
    ii := len(cs.ikey) - 1
    m := _bind(&cs, cs.gf[gi].typarams, targs)
    save := cs.cf
    cs.cf = cs.gff[gi]
    pn := []string
    pt := []string
    pio := []bool
    psk := []bool
    psz := []string
    pv := false
    for prm in cs.gf[gi].params:
        if len(prm.ty) == 0:
            _bad("untyped parameter on '" + n + "'")
        one := _ty(&cs, prm.ty[0])
        if prm.is_variadic:
            pv = true
            one = "[" + one + "]"
        push(pn, prm.name)
        push(pt, one)
        push(pio, prm.is_inout)
        push(psk, prm.is_sink)
        push(psz, _sizep_of(prm.ty))
    rt := _tyo(&cs, cs.gf[gi].ret)
    cs.cf = save
    _unbind(&cs, m)
    push(cs.fds, FD(mang, pn, pt, pio, psk, pv, rt, psz))
    cs.pendk[ii] = len(cs.fds) - 1
    return len(cs.fds) - 1

# src/tychoc.c@c_type returns a value type WITH a trailing space and a pointer
# type ending in `*`, which is visible in every `(T){0}` it prints.
fn _ctyz(cs: inout C, t: string) -> string:
    c := _cty(&cs, t)
    if strings.ends_with(c, "*"):
        return c
    return c + " "

fn _cty(cs: inout C, t: string) -> string:
    if t == "int" or t == "char":
        return "tycho_int"
    if t == "float":
        return "double"
    if t == "bool":
        return "int"
    if t == "string" or t == "bytes":
        return "char *"
    if t == "ptr":
        return "void *"
    if t == "u8":
        return "unsigned char"
    if t == "u16":
        return "unsigned short"
    if t == "u32":
        return "unsigned int"
    if t == "u64":
        return "unsigned long long"
    if t == "i8":
        return "signed char"
    if t == "i16":
        return "short"
    if t == "i32":
        return "int"
    if t == "i64":
        return "long long"
    if t == "f32":
        return "float"
    if t == "void":
        return "void"
    if _is_handle(t):
        return "void *"
    if _is_chan(t):
        return "HChan *"
    if _is_task(t):
        return "HTask *"
    if _is_struct(t):
        return "S_" + _tname(t)
    if _is_enum(t):
        return "E_" + _tname(t) + " *"
    if _is_tup(t):
        return "TychoTup" + _tname(t)
    if _is_fn(t):
        return "FnC" + _tname(t)
    if _is_map(t):
        return "TychoMapM" + _tname(t)
    if _is_soa(t):
        return "Soa" + _tname(t)
    if _is_arr(t):
        e := _elem(t)
        if e == "int":
            return "TychoArrInt"
        if e == "float":
            return "TychoArrFloat"
        if e == "string":
            return "TychoArrStr"
        return "TychoArrK" + str(_akind(&cs, e))
    _bad("no C type for '" + t + "'")
    return ""

# --- syntactic type -> type string ------------------------------------------

fn _ty(cs: inout C, t: ast.Ty) -> string:
    match t:
        ast.TPrim(p):
            if p == "int" or p == "float" or p == "bool" or p == "string" or p == "char" or p == "void":
                return p
            if _is_sized(p) or p == "bytes" or p == "ptr":
                return p
            _bad("unsupported primitive type '" + p + "' -- Phase 8")
        ast.TName(q, n0, targs):
            n := n0
            if len(q) > 0:
                n = _qpfx(&cs, q) + n0
            if len(q) == 0 and len(targs) == 0 and n == "void":
                return "void"
            if len(q) == 0 and n == "Option" and len(targs) == 1:
                return _opt_of(&cs, _ty(&cs, targs[0]))
            if len(q) == 0 and n == "Result" and len(targs) == 2:
                return _res_of(&cs, _ty(&cs, targs[0]), _ty(&cs, targs[1]))
            if len(targs) == 0 and _hidx(&cs, n0) >= 0:
                return "H~" + n0
            if len(q) == 0 and n == "Channel" and len(targs) == 1:
                et := _ty(&cs, targs[0])
                _ckind(&cs, et)
                return "chan(" + et + ")"
            if len(q) == 0 and n == "Task" and len(targs) == 1:
                return "task(" + _ty(&cs, targs[0]) + ")"
            if len(targs) > 0:
                as2 := []string
                for a in targs:
                    push(as2, _ty(&cs, a))
                if _gsidx(&cs, n) >= 0:
                    return _inst_struct(&cs, n, as2)
                if _geidx(&cs, n) >= 0:
                    return _inst_enum(&cs, n, as2)
                _bad("generic type '" + n0 + "' -- Phase 8")
            # A DECLARED type of that name wins over a type parameter spelled
            # the same (corelib/testing's `T`); see _unify's matching guard.
            tv := _tpget(&cs, n)
            if len(tv) > 0 and not _declared_short(&cs, n0):
                return tv
            ni := _ntidx(&cs, n)
            if ni >= 0:
                if len(cs.ntu[ni]) == 0:
                    _bad("newtype '" + n + "' used before its underlying type resolves")
                return cs.ntu[ni]
            si0 := _sidx(&cs, n)
            if si0 >= 0:
                return "S~" + cs.sds[si0].name
            ei0 := _eidx(&cs, n)
            if ei0 >= 0:
                return "E~" + cs.eds[ei0].name
            _bad("unknown type '" + n0 + "'")
        ast.TArr(es):
            return "[" + _ty(&cs, es[0]) + "]"
        ast.TParam(n):
            v := _tpget(&cs, n)
            if len(v) == 0:
                _bad("unbound type parameter '$" + n + "'")
            return v
        ast.TFix(n, e):
            # `[N]T` lowers to the dynamic array. The static rules -- the length
            # being a compile-time constant, no push -- are the checker's, which
            # has already run by here; what is left for emit is the values.
            return "[" + _ty(&cs, e[0]) + "]"
        ast.TMap(e):
            kt := _ty(&cs, e[0])
            return _map_of(&cs, kt, _ty(&cs, e[1]))
        ast.TTup(e):
            es2 := []string
            for x in e:
                push(es2, _ty(&cs, x))
            return _tup_of(&cs, es2)
        ast.TFn(h, e):
            ps2 := []string
            nps := len(e)
            r2 := "void"
            if h:
                nps -= 1
                r2 = _ty(&cs, e[nps])
            for i := 0; i < nps; i += 1:
                push(ps2, _ty(&cs, e[i]))
            return _fn_of(&cs, r2, ps2)
        ast.TSoa(e):
            return _soa_of(&cs, _ty(&cs, e[0]))
        ast.TBnd(n, e):
            # `bounded[N]T` lowers to the dynamic array too. NOT covered by this:
            # the capacity trap on an over-cap push, which needs N carried in the
            # type string -- tests/bounded_const_cap.ty is what would show it.
            return "[" + _ty(&cs, e[0]) + "]"
        _: _bad("unsupported type form -- Phase 8")
    return ""

# True when every name in `t` already resolves -- used to order newtype
# resolution without letting `_ty` die on a forward reference.
fn _ty_ready(cs: inout C, t: ast.Ty) -> bool:
    match t:
        ast.TPrim(p): return true
        ast.TParam(n): return len(_tpget(&cs, n)) > 0
        ast.TName(q, n0, targs):
            n := n0
            if len(q) > 0:
                n = _qpfx(&cs, q) + n0
            if len(targs) > 0:
                for a in targs:
                    if not _ty_ready(&cs, a):
                        return false
                return _gsidx(&cs, n) >= 0 or _geidx(&cs, n) >= 0
            if len(_tpget(&cs, n)) > 0:
                return true
            ni := _ntidx(&cs, n)
            if ni >= 0:
                return len(cs.ntu[ni]) > 0
            return _sidx(&cs, n) >= 0 or _eidx(&cs, n) >= 0
        ast.TArr(es): return _ty_ready(&cs, es[0])
        ast.TMap(es):
            return _ty_ready(&cs, es[0]) and _ty_ready(&cs, es[1])
        ast.TTup(es):
            for x in es:
                if not _ty_ready(&cs, x):
                    return false
            return true
        _: return false
    return false

fn _tyo(cs: inout C, ts: [ast.Ty]) -> string:
    if len(ts) == 0:
        return "void"
    if len(ts) > 1:
        es := []string
        for x in ts:
            push(es, _ty(&cs, x))
        return _tup_of(&cs, es)
    return _ty(&cs, ts[0])

# --- local scope ------------------------------------------------------------

fn _mark(cs: inout C) -> int:
    return len(cs.vnames)

fn _restore(cs: inout C, m: int):
    for len(cs.vnames) > m:
        pop(cs.vnames)
        pop(cs.vtypes)
        pop(cs.vcn)
        pop(cs.vown)
        pop(cs.vacc)

# src/tychoc.c@cv_push: a shadowing binding keeps the C name `h_<n>` and leans
# on C's own block scoping. Only a SELF-referential decl (`x := x + 1`) needs
# help, and it gets the `_sh_` temp at the decl site, not a rename here.
fn _push(cs: inout C, n: string, t: string) -> string:
    cn := "h_" + n
    push(cs.vnames, n)
    push(cs.vtypes, t)
    push(cs.vcn, cn)
    push(cs.vown, _curown(&cs))
    push(cs.vacc, "")
    return cn

fn _vtype(cs: inout C, n: string) -> string:
    for i := len(cs.vnames) - 1; i >= 0; i -= 1:
        if cs.vnames[i] == n:
            return cs.vtypes[i]
    return ""

# Ground a PENDING binding at its first assignment (a value-if/value-match).
fn _vset(cs: inout C, n: string, t: string):
    for i := len(cs.vnames) - 1; i >= 0; i -= 1:
        if cs.vnames[i] == n:
            cs.vtypes[i] = t
            return

fn _vcname(cs: inout C, n: string) -> string:
    for i := len(cs.vnames) - 1; i >= 0; i -= 1:
        if cs.vnames[i] == n:
            return cs.vcn[i]
    return ""

# A heap value reached through an `inout` parameter belongs to the CALLER's
# arena: allocating its growth in this function's `_scope` leaves the buffer
# dangling the moment the callee returns. Each such parameter therefore carries
# its owning arena alongside it, exactly as src/tychoc.c@owner_arena_of does
# with its `_ina_<name>`.
fn _rootname(e: ast.Expr) -> string:
    match e:
        ast.Name(l, n): return n
        ast.Field(l, r, f): return _rootname(r[0])
        ast.Index(l, k): return _rootname(k[0])
        ast.TupIdx(l, k, i): return _rootname(k[0])
        ast.Addr(l, k): return _rootname(k[0])
        _: return ""
    return ""

# Is this place rooted in a live in-place string ACCUMULATOR? Such a buffer is
# written through (tycho_str_append grows it past its own end once it owns it),
# so sharing it would make a snapshot follow the accumulator instead of freezing
# -- tests/value_semantics.ty checks exactly that.
fn _acc_rooted(cs: inout C, e: ast.Expr) -> bool:
    n := _rootname(e)
    if len(n) == 0:
        return false
    for i := len(cs.vnames) - 1; i >= 0; i -= 1:
        if cs.vnames[i] == n:
            return len(cs.vacc[i]) > 0
    return false

# The same rule as the declaration path: a string already in the destination
# arena, not rooted in an accumulator, is shared rather than copied.
fn _shares(cs: inout C, e: ast.Expr, t: string, arena: string) -> bool:
    # Enums join strings here: a variant is immutable once built -- there is no
    # assignment to a payload, and a match arm that WRITES its binding keeps its
    # own copy -- so retaining one into the arena it already lives in has nothing
    # to protect. This is where the AST copies were: tycho_copy_E_ast__Expr and
    # the Expr-array copy under it were 16% of the profile. Arrays and maps are
    # NOT here: push and element assignment write them in place.
    if t != "string" and not _is_enum(t):
        return false
    if _acc_rooted(&cs, e):
        return false
    # A slice is a FRESH buffer, not the root's own, so _ownerof(root) says
    # nothing about it. src/tychoc.c@is_place copies one unconditionally.
    match e:
        ast.Slice(l9, a9, b9, k9): return false
        _: pass
    ow6 := _ownerof(&cs, e)
    if ow6 == arena:
        return true
    # A place rooted in an INOUT parameter lives in the arena the caller handed
    # down with it, which is the caller's own -- the same one _parent names, or
    # an ancestor. So returning one needs no copy. ENUMS only: the same rule for
    # a string is unsound, because a string field of that struct can be an
    # accumulator its owner appends to IN PLACE, and _acc_rooted tests the root
    # LOCAL so it cannot see one living at cs.ccode[i]. An enum has no in-place
    # write at all.
    if arena == "_parent" and _is_enum(t) and strings.starts_with(ow6, "_ina_"):
        return true
    return false

# src/tychoc.c@cv_in_parent: is this bare name's storage the caller's arena?
fn _inparent(cs: inout C, e: ast.Expr) -> bool:
    match e:
        ast.Name(l, n):
            for i := len(cs.vnames) - 1; i >= 0; i -= 1:
                if cs.vnames[i] == n:
                    return cs.vown[i] == "_parent"
            return false
        _: return false
    return false

fn _ownerof(cs: inout C, e: ast.Expr) -> string:
    n := _rootname(e)
    if len(n) == 0:
        return "&_scope"
    for i := len(cs.vnames) - 1; i >= 0; i -= 1:
        if cs.vnames[i] == n:
            return cs.vown[i]
    return "&_scope"

fn _fresh(cs: inout C, p: string) -> string:
    # src/tychoc.c@g_blk is post-incremented: the first block temp is _l0.
    n := cs.tmp
    cs.tmp += 1
    return p + str(n)

# --- the per-iteration loop scratch arena (src/tychoc.c:12269-12289) ---------
#
# A loop opens `Arena _scrN = arena_child(<enclosing>)`, resets it as the FIRST
# statement of every iteration and frees it after. Correctness comes from the
# arena hierarchy, not from escape analysis: anything that must outlive an
# iteration is written through its variable's OWNING arena (_ownerof), which is
# never a scratch, and a value DECLARED inside the loop records the scratch as
# its owner -- which is what makes _shares copy it out instead of aliasing it.
# arena_child is a plain arena_new (runtime/tycho_rt.c@arena_child): freeing the
# parent does not free it, so every exit path frees it by hand.

# The arena a value created at this point lives in.
# src/tychoc.c@fuse_open. A `push(xs, v)` in a loop calls a helper per element,
# which -O3 cannot keep in registers; hoisting xs's data/len/cap into locals lets
# it. bench/prongB iter-transform was 248 ms against ./tychoc's 219 at -O3 for
# exactly this reason -- and 336 vs 433 at -O2, where the call is not the
# bottleneck, which is why it only shows up under the harness's flags.
fn _fuse_idx(cs: inout C, nm: string) -> int:
    for i := len(cs.fua) - 1; i >= 0; i -= 1:
        if cs.fua[i] == nm:
            return i
    return -1

fn _pushn_e(e: ast.Expr, nm: string) -> int:
    k := 0
    match e:
        ast.Call(l, q, n, ts, args):
            if n == "push" and len(q) == 0 and len(args) >= 1:
                match args[0]:
                    ast.Name(l2, n2):
                        if n2 == nm:
                            k = 1
                    _: pass
        _: pass
    for c in ast.kids(e):
        k = k + _pushn_e(c, nm)
    return k

fn _pushn_l(es: [ast.Expr], nm: string) -> int:
    k := 0
    for e in es:
        k = k + _pushn_e(e, nm)
    return k

fn _pushn_a(ar: [ast.Arm], nm: string) -> int:
    k := 0
    for a in ar:
        k = k + _pushn_b(a.body, nm)
    return k

fn _pushn_s(s: ast.Stmt, nm: string) -> int:
    match s:
        ast.ExprStmt(l, k2): return _pushn_l(k2, nm)
        ast.Decl(l, n, t, r, v): return _pushn_l(r, nm) + _pushn_b(v, nm)
        ast.MDecl(l, d, ns, r): return _pushn_l(r, nm)
        ast.Assign(l, n, r): return _pushn_l(r, nm)
        ast.PlaceSet(l, k2): return _pushn_l(k2, nm)
        ast.ConstS(l, n, k2): return _pushn_l(k2, nm)
        ast.ReturnS(l, k2): return _pushn_l(k2, nm)
        ast.IfS(l, c2, b, e): return _pushn_l(c2, nm) + _pushn_b(b, nm) + _pushn_b(e, nm)
        ast.WhileS(l, c2, b): return _pushn_l(c2, nm) + _pushn_b(b, nm)
        ast.For3(l, ip, c2, b): return _pushn_b(ip, nm) + _pushn_l(c2, nm) + _pushn_b(b, nm)
        ast.ForIn(l, n, c2, b): return _pushn_l(c2, nm) + _pushn_b(b, nm)
        ast.ForRange(l, n, c2, b): return _pushn_l(c2, nm) + _pushn_b(b, nm)
        ast.ParallelS(l, w, b): return _pushn_l(w, nm) + _pushn_b(b, nm)
        ast.MatchS(l, c2, a): return _pushn_l(c2, nm) + _pushn_a(a, nm)
        ast.SelectS(l, a): return _pushn_a(a, nm)
        ast.DeleteS(l, k2): return _pushn_l(k2, nm)
        _: return 0
    return 0

fn _pushn_b(b: [ast.Stmt], nm: string) -> int:
    k := 0
    for st in b:
        k = k + _pushn_s(st, nm)
    return k

# reassigned, re-declared or shadowed in the body: the cursor would not track it
fn _defs_s(s: ast.Stmt, nm: string) -> bool:
    match s:
        ast.Assign(l, n, r): return n == nm
        ast.Decl(l, n, t, r, v): return n == nm or _defs_b(v, nm)
        ast.MDecl(l, d, ns, r):
            for x in ns:
                if x == nm:
                    return true
            return false
        ast.IfS(l, c2, b, e): return _defs_b(b, nm) or _defs_b(e, nm)
        ast.WhileS(l, c2, b): return _defs_b(b, nm)
        ast.For3(l, ip, c2, b): return _defs_b(ip, nm) or _defs_b(b, nm)
        ast.ForIn(l, n, c2, b): return n == nm or _defs_b(b, nm)
        ast.ForRange(l, n, c2, b): return n == nm or _defs_b(b, nm)
        ast.ParallelS(l, w, b): return _defs_b(b, nm)
        ast.MatchS(l, c2, a): return _defs_a(a, nm)
        ast.SelectS(l, a): return _defs_a(a, nm)
        _: return false
    return false

fn _defs_a(ar: [ast.Arm], nm: string) -> bool:
    for a in ar:
        if _defs_b(a.body, nm):
            return true
    return false

fn _defs_b(b: [ast.Stmt], nm: string) -> bool:
    for st in b:
        if _defs_s(st, nm):
            return true
    return false

fn _fuse_names_e(e: ast.Expr, out: inout [string]):
    match e:
        ast.Call(l, q, n, ts, args):
            if n == "push" and len(q) == 0 and len(args) >= 1:
                match args[0]:
                    ast.Name(l2, n2):
                        seen := false
                        for x in out:
                            if x == n2:
                                seen = true
                        if not seen:
                            push(out, n2)
                    _: pass
        _: pass
    for c in ast.kids(e):
        _fuse_names_e(c, &out)

fn _fuse_names(b: [ast.Stmt], out: inout [string]):
    for st in b:
        for e in _stmt_es(st):
            _fuse_names_e(e, &out)
        for sb in _stmt_bs(st):
            _fuse_names(sb, &out)

fn _stmt_es(s: ast.Stmt) -> [ast.Expr]:
    match s:
        ast.ExprStmt(l, k2): return k2
        ast.Decl(l, n, t, r, v): return r
        ast.MDecl(l, d, ns, r): return r
        ast.Assign(l, n, r): return r
        ast.PlaceSet(l, k2): return k2
        ast.ConstS(l, n, k2): return k2
        ast.ReturnS(l, k2): return k2
        ast.IfS(l, c2, b, e): return c2
        ast.WhileS(l, c2, b): return c2
        ast.For3(l, ip, c2, b): return c2
        ast.ForIn(l, n, c2, b): return c2
        ast.ForRange(l, n, c2, b): return c2
        ast.ParallelS(l, w, b): return w
        ast.MatchS(l, c2, a): return c2
        ast.DeleteS(l, k2): return k2
        _: return []ast.Expr
    return []ast.Expr

fn _stmt_bs(s: ast.Stmt) -> [[ast.Stmt]]:
    out := [][ast.Stmt]
    match s:
        ast.Decl(l, n, t, r, v): push(out, v)
        ast.IfS(l, c2, b, e):
            push(out, b)
            push(out, e)
        ast.WhileS(l, c2, b): push(out, b)
        ast.For3(l, ip, c2, b):
            push(out, ip)
            push(out, b)
        ast.ForIn(l, n, c2, b): push(out, b)
        ast.ForRange(l, n, c2, b): push(out, b)
        ast.ParallelS(l, w, b): push(out, b)
        ast.MatchS(l, c2, a):
            for x in a:
                push(out, x.body)
        ast.SelectS(l, a):
            for x in a:
                push(out, x.body)
        _: pass
    return out

# Emits the cursor declarations for every fusible array in `b`; returns the code
# and how many were opened, which _fuse_close pops.
fn _fuse_open(cs: inout C, b: [ast.Stmt], ind: string, guard: [ast.Expr]) -> (string, int):
    cand := []string
    _fuse_names(b, &cand)
    out := ""
    opened := 0
    for nm in cand:
        if _fuse_idx(&cs, nm) >= 0:
            continue                       # an enclosing loop already cached it
        t := _vtype(&cs, nm)
        nmx := ast.Name(0, nm)
        if not _is_arr(t) or _cap_of_target(&cs, nmx) > 0:
            continue                       # bounded has no growable spine
        ow := _ownerof(&cs, nmx)
        if strings.starts_with(ow, "_ina_"):
            continue                       # an inout param is a pointer, not a value
        if _defs_b(b, nm):
            continue
        if _creads_b(b, nm) != _pushn_b(b, nm):
            continue                       # read for anything but a push: stale view
        gr := 0
        for ge in guard:
            gr = gr + _creads_e(ge, nm)
        if gr > 0:
            continue                       # the loop condition would read a stale len
        et := _elem(t)
        id := _fresh(&cs, "_fd")
        cn := _vcname(&cs, nm)
        out = out + ind + _cty(&cs, et) + " *" + id + " = " + cn + ".data; tycho_int " +
            id + "l = " + cn + ".len, " + id + "c = " + cn + ".cap;\n"
        push(cs.fua, nm)
        push(cs.fuid, id)
        push(cs.fuel, et)
        opened = opened + 1
    return (out, opened)

fn _fuse_close(cs: inout C, opened: int, ind: string) -> string:
    out := ""
    for i := 0; i < opened; i += 1:
        j := len(cs.fua) - 1
        cn := _vcname(&cs, cs.fua[j])
        id := cs.fuid[j]
        out = out + ind + cn + ".data = " + id + "; " + cn + ".len = " + id + "l; " +
            cn + ".cap = " + id + "c;\n"
        pop(cs.fua)
        pop(cs.fuid)
        pop(cs.fuel)
    return out

fn _curown(cs: inout C) -> string:
    if len(cs.ascope) > 0:
        return cs.ascope[len(cs.ascope) - 1]
    return "&_scope"

# The frees an early `return` (or an `or_return`) must run before it frees
# _scope, innermost first -- src/tychoc.c@return_frees.
fn _scr_frees(cs: inout C) -> string:
    out := ""
    for i := len(cs.ascope) - 1; i >= 0; i -= 1:
        out = out + "arena_free(" + cs.ascope[i] + "); "
    return out

# Does this emitted body name scratch `id` for anything but its own free, and
# does it name it at ALL? A loop whose body allocates nothing gets no scratch,
# which is what keeps the whole-body _scope elision in _fn reachable for an
# allocation-free loop; the second answer says whether the _replace that strips
# the dead frees is worth running, and most bodies have no early return.
#
# The `_scr` prefix is tested byte by byte rather than by slicing: this runs
# over every loop body once per enclosing loop, and `_scope` alone would have
# made a substring at every occurrence -- 17% of the self-compile.
fn _uses_scr(s: string, id: string) -> (bool, bool):
    n := len(s)
    m := len(id)
    i := 0
    used := false
    seen := false
    for i + m <= n:
        if s[i] == 95 and s[i + 1] == 115 and s[i + 2] == 99 and s[i + 3] == 114:
            ok := true
            j := 4
            for j < m:
                if s[i + j] != id[j]:
                    ok = false
                    j = m
                else:
                    j += 1
            if ok and i + m < n and s[i + m] >= 48 and s[i + m] <= 57:
                ok = false                    # _scr1 is not _scr10
            if ok:
                seen = true
                if not (i >= 12 and s[i - 12:i] == "arena_free(&"):
                    return (true, true)
        i += 1
    return (used, seen)

# --- deep copy / str / eq ---------------------------------------------------

# A TYCHO_LIT is a `static const` object with program lifetime, so copying one
# into an arena allocates a second copy of bytes that already outlive every
# arena. The empty string takes this route today by another door -- _copy of a
# zero-length string hands back the runtime's immortal singleton.
fn _islit(s: string) -> bool:
    n := len(s)
    if n < 13 or not strings.starts_with(s, "TYCHO_LIT(\""):
        return false
    i := 11
    for i < n:
        c := s[i]
        if c == 92:
            i += 2
            continue
        if c == 34:
            return i + 2 == n and s[i + 1] == 41
        i += 1
    return false

fn _copy(cs: inout C, code: string, t: string, arena: string) -> string:
    if t == "string" or t == "bytes":
        if _islit(code):
            return code
        return "tycho_str_copy(" + arena + ", " + code + ")"
    if _is_fn(t):
        # re-home a returned closure's captures; a plain fn ref has env == 0
        return "({ " + _ctyz(&cs, t) + "_fcp = (" + code + "); if (_fcp.env) _fcp.env = _fcp.copyenv(" +
            arena + ", _fcp.env); _fcp; })"
    if _is_arr(t):
        return _arrf(&cs, _elem(t), "_copy") + "(" + arena + ", " + code + ")"
    if _is_enum(t):
        cen := _u(&cs, "tycho_copy_E_" + _tname(t))
        return cen + "(" + arena + ", " + code + ")"
    if _is_map(t):
        return _mpfx(&cs, t) + "_copy(" + arena + ", " + code + ")"
    if _is_soa(t):
        return _spfx(&cs, t) + "_copy(" + arena + ", " + code + ")"
    if _is_struct(t) and _heap(&cs, t):
        csn := _u(&cs, "tycho_copy_S_" + _tname(t))
        return csn + "(" + arena + ", " + code + ")"
    if _is_tup(t) and _heap(&cs, t):
        ctn := _u(&cs, "tycho_copy_T" + _tname(t))
        return ctn + "(" + arena + ", " + code + ")"
    return code

fn _tostr(cs: inout C, code: string, t: string) -> string:
    if t == "string" or t == "bytes":
        return code
    if _is_uint(t):
        return "tycho_uint_to_str(" + cs.arena + ", " + code + ")"
    if _is_sint(t):
        return "tycho_int_to_str(" + cs.arena + ", " + code + ")"
    if t == "f32":
        return "tycho_float_to_str(" + cs.arena + ", (double)(" + code + "))"
    if _is_fn(t):
        # a closure has no printable form; the struct str() generator is eager
        # here and would otherwise refuse every struct holding a callback
        return "TYCHO_LIT(\"<fn>\")"
    if t == "int":
        return "tycho_int_to_str(" + cs.arena + ", " + code + ")"
    if t == "char":
        return "tycho_chr(" + cs.arena + ", " + code + ")"
    if t == "float":
        return "tycho_float_to_str(" + cs.arena + ", " + code + ")"
    if t == "bool":
        return "tycho_bool_to_str(" + cs.arena + ", " + code + ")"
    if _is_struct(t):
        ssn := _u(&cs, "tycho_str_S_" + _tname(t))
        return ssn + "(" + cs.arena + ", " + code + ")"
    if _is_tup(t):
        stn := _u(&cs, "tycho_str_T" + _tname(t))
        return stn + "(" + cs.arena + ", " + code + ")"
    if _is_enum(t):
        sen := _u(&cs, "tycho_str_E_" + _tname(t))
        return sen + "(" + cs.arena + ", " + code + ")"
    if _is_map(t):
        return "tycho_str_mapM" + _tname(t) + "(" + cs.arena + ", " + code + ")"
    if _is_soa(t):
        return "tycho_str_from_c(" + cs.arena + ", \"<soa [" + _tname(_selem(&cs, t)) + "]>\")"
    if _is_arr(t):
        e := _elem(t)
        if e == "int":
            return "tycho_arr_int_str(" + cs.arena + ", " + code + ")"
        if e == "float":
            return "tycho_arr_float_str(" + cs.arena + ", " + code + ")"
        if e == "string":
            return "tycho_arr_str_str(" + cs.arena + ", " + code + ")"
        san := "tycho_str_arr_K" + str(_akind(&cs, e))
        return _u(&cs, san) + "(" + cs.arena + ", " + code + ")"
    if t == "ptr":
        # A ptr has no printable value; the generated struct stringifier prints
        # a placeholder for it rather than refusing the whole struct
        # (src/tychoc.c's gen_str does the same).
        return "tycho_str_from_c(" + cs.arena + ", \"<ptr>\")"
    _bad("str() of unsupported type '" + t + "'")
    return ""

# The value a missing map key reads as. A Tycho string carries a length header
# in front of the pointer, so a NULL `char *` is not the empty string -- it
# crashes the first read (tests/map_index_read.ty prints exactly that case).
fn _zero(cs: inout C, t: string) -> string:
    if t == "string" or t == "bytes":
        return "TYCHO_LIT(\"\")"
    if _is_sized(t):
        return "0"
    if _is_fn(t):
        return "(" + _cty(&cs, t) + "){0, 0, 0}"
    if t == "float":
        return "0.0"
    if t == "int" or t == "char" or t == "bool":
        return "0LL"
    return "(" + _ctyz(&cs, t) + "){0}"

fn _eq(cs: inout C, a: string, b: string, t: string) -> string:
    if _is_fn(t):
        # identity: same thunk and same env -- src/tychoc.c:10214
        return "((" + a + ").call == (" + b + ").call && (" + a + ").env == (" + b + ").env)"
    if t == "string" or t == "bytes":
        # EQUALITY, not order: tycho_str_eq settles on the length headers and
        # never touches the bytes when they differ, which is the common case.
        # tycho_str_cmp must memcmp the common prefix even then -- it owes an
        # ORDER. `!=` routes through here too.
        return "tycho_str_eq(" + a + ", " + b + ")"
    if _is_struct(t):
        esn := _u(&cs, "tycho_eq_S_" + _tname(t))
        return esn + "(" + a + ", " + b + ")"
    if _is_tup(t):
        etn := _u(&cs, "tycho_eq_T" + _tname(t))
        return etn + "(" + a + ", " + b + ")"
    if _is_enum(t):
        een := _u(&cs, "tycho_eq_E_" + _tname(t))
        return een + "(" + a + ", " + b + ")"
    if _is_map(t):
        return _mpfx(&cs, t) + "_eq(" + a + ", " + b + ")"
    if _is_soa(t):
        return _spfx(&cs, t) + "_eq(" + a + ", " + b + ")"
    if _is_arr(t):
        return _arrf(&cs, _elem(t), "_eq") + "(" + a + ", " + b + ")"
    return "(" + a + " == " + b + ")"

# --- expressions ------------------------------------------------------------
# Every `_ex` returns the C text; `_ty_of` the type string. They are computed
# together and returned as a tuple so an expression is walked once.

# A key that can be evaluated twice with no observable difference.
# Every side-effecting leg of a place, hoisted into a temp in SOURCE order:
# `grid[f()][g()] = e()` must call f before g, and building the C subscript
# expression leaves that order to the C compiler, which chose g first.
fn _hoist_legs(cs: inout C, e: ast.Expr, ind: string, pre: inout string, tmps: inout [string]) -> ast.Expr:
    match e:
        ast.Index(l, k):
            r := _hoist_legs(&cs, k[0], ind, &pre, &tmps)
            if not _simple(k[1]):
                kc, kt := _ex(&cs, k[1])
                cs.tmp += 1
                kn := "_mk" + str(cs.tmp)
                cn := _push(&cs, kn, kt)
                pre = pre + ind + _ctyz(&cs, kt) + "" + cn + " = " + kc + ";\n"
                push(tmps, kn)
                return ast.Index(l, [r, ast.Name(l, kn)])
            return ast.Index(l, [r, k[1]])
        ast.Field(l, k, f):
            return ast.Field(l, [_hoist_legs(&cs, k[0], ind, &pre, &tmps)], f)
        ast.Call(l, q, n, ts, args):
            # A user subscript is a CALL in the place spine, and `p += e` copies
            # the whole place onto the right: without this its argument runs
            # twice (tests/compound_subscript_eval.ty reads one slot and writes
            # another).
            na := []ast.Expr
            for a2 in args:
                if _simple(a2):
                    push(na, a2)
                    continue
                ac, at := _ex(&cs, a2)
                cs.tmp += 1
                an := "_mk" + str(cs.tmp)
                acn := _push(&cs, an, at)
                pre = pre + ind + _ctyz(&cs, at) + "" + acn + " = " + ac + ";\n"
                push(tmps, an)
                push(na, ast.Name(l, an))
            return ast.Call(l, q, n, ts, na)
        _: pass
    return e

# The compound form `p += e` carries a structural COPY of the place on the
# right; it must read the same temps, or every leg runs twice.
fn _subst_legs(e: ast.Expr, tmps: [string], i: inout int) -> ast.Expr:
    match e:
        ast.Index(l, k):
            r := _subst_legs(k[0], tmps, &i)
            if not _simple(k[1]) and i < len(tmps):
                nm := tmps[i]
                i += 1
                return ast.Index(l, [r, ast.Name(l, nm)])
            return ast.Index(l, [r, k[1]])
        ast.Field(l, k, f):
            return ast.Field(l, [_subst_legs(k[0], tmps, &i)], f)
        ast.Call(l, q, n, ts, args):
            na := []ast.Expr
            for a2 in args:
                if _simple(a2) or i >= len(tmps):
                    push(na, a2)
                    continue
                push(na, ast.Name(l, tmps[i]))
                i += 1
            return ast.Call(l, q, n, ts, na)
        _: pass
    return e

fn _simple(e: ast.Expr) -> bool:
    match e:
        ast.Name(l, n): return true
        ast.IntLit(l, v): return true
        ast.StrLit(l, v): return true
        ast.CharLit(l, v): return true
        ast.BoolLit(l, v): return true
        ast.FloatLit(l, v): return true
        _: return false
    return false

fn _place(e: ast.Expr) -> bool:
    match e:
        ast.Name(l, n): return true
        ast.Field(l, r, f): return true
        ast.Index(l, k): return true
        ast.TupIdx(l, k, n): return true
        # a slice aliases its source, so binding one copies (src/tychoc.c@is_place)
        ast.Slice(l, a, b, k): return true
        ast.Call(l, q, n, ts, k):
            # to_str/to_bool lower to their ARGUMENT unchanged (there is no
            # conversion to make -- the representations are identical), so the
            # result IS that place and retaining it must still copy. Reading them
            # as calls made `Ok(to_str(b))` in core:io hand back a pointer into
            # the frame read_text was about to free: the source of every --parse
            # run came back with one byte overwritten.
            # to_under is deliberately NOT here. It aliases the same way, but
            # ./tychoc aliases too and tests/newtype_agg.out records that answer
            # (`m := to_under(e); m[k] = ...` writes THROUGH to the argument).
            # Copying it there loses the update and reddens that fixture, so the
            # aliasing is the contract until the golden says otherwise.
            if len(q) == 0 and len(k) == 1 and (n == "to_str" or n == "to_bool"):
                return _place(k[0])
            return false
        _: return false
    return false

fn _num2(a: string, b: string) -> string:
    if a == "float" or b == "float":
        return "float"
    if a == "f32" or b == "f32":
        return "f32"
    if _is_sized(a):
        return a
    if _is_sized(b):
        return b
    if a == "char" or b == "char":
        return "char"
    return "int"

# src/tychoc.c@c_dtoa prints a float literal with C-locale `%.17g`, NOT the
# shortest round-trip form `str()` gives. strings.format_g17 is that same one
# snprintf call; a float literal out of range is refused by the lexer, so the
# value here is always finite.

fn _lit_float(v: float) -> string:
    s := strings.format_g17(v)
    has := false
    for i := 0; i < len(s); i += 1:
        if s[i] == 46 or s[i] == 101 or s[i] == 69:
            has = true
    if has:
        return s
    return s + ".0"

# src/tychoc.c@c_int_lit -- INT64_MIN has no C literal: -9223372036854775808LL
# is a unary minus on a value that does not fit, so it is written as a subtraction.
fn _ilit(v: int) -> string:
    if v == -9223372036854775807 - 1:
        return "(-9223372036854775807LL - 1)"
    return str(v) + "LL"

fn _ex(cs: inout C, e: ast.Expr) -> (string, string):
    match e:
        ast.IntLit(l, v):
            return (_ilit(v), "int")
        ast.FloatLit(l, v):
            return (_lit_float(v), "float")
        ast.CharLit(l, v):
            return (str(v) + "LL", "char")
        ast.BoolLit(l, v):
            if v:
                return ("1", "bool")
            return ("0", "bool")
        ast.StrLit(l, s):
            return ("TYCHO_LIT(\"" + s + "\")", "string")
        ast.Name(l, n):
            t := _vtype(&cs, n)
            if strings.starts_with(t, "?A") and len(cs.want) > 0 and cs.want != "?" and not strings.starts_with(cs.want, "?A"):
                # A pending binding is also typed by a USE: passing it to a
                # parameter, or putting it beside a typed sibling in a literal.
                pi8 := strings.parse_int(t[2:])
                cs.ptv[pi8] = cs.want
                _vset(&cs, n, cs.want)
                return (_vcname(&cs, n), cs.want)
            if len(t) > 0:
                return (_vcname(&cs, n), t)
            ci := _cidx(&cs, n)
            if ci >= 0:
                return (cs.ccode[ci], cs.ctypes[ci])
            ei := _bare_variant(&cs, n)
            if ei >= 0:
                return _variant(&cs, ei, n, [])
            fi2 := _fidx(&cs, n)
            if fi2 >= 0:
                _need_clo(&cs, fi2)
                ft2 := _fn_of(&cs, cs.fds[fi2].ret, cs.fds[fi2].ptypes)
                return ("(" + _cty(&cs, ft2) + "){0, " + cs.fds[fi2].name + "__clo, 0}", ft2)
            _bad("unknown name '" + n + "'")
        ast.Field(l, r, f):
            pm, pt2 := _pkgmember(&cs, r[0], f)
            if len(pt2) > 0:
                return (pm, pt2)
            # `ps[i].x` PROJECTS into the soa's own buffer for x -- it is never a
            # gather followed by a field read, which would copy every field.
            match r[0]:
                ast.Index(l2, k2):
                    bc2, bt2 := _ex(&cs, k2[0])
                    if _is_soa(bt2):
                        ic3, it3 := _ex(&cs, k2[1])
                        return _soafld(&cs, bc2, bt2, ic3, f)
                _: pass
            rc, rt := _ex(&cs, r[0])
            if not _is_struct(rt):
                _bad("field '" + f + "' on non-struct")
            si := _sidx(&cs, _tname(rt))
            for i := 0; i < len(cs.sds[si].fnames); i += 1:
                if cs.sds[si].fnames[i] == f:
                    return ("((" + rc + ").f_" + f + ")", cs.sds[si].ftypes[i])
            _bad("no field '" + f + "' on " + _tname(rt))
        ast.Index(l, k):
            rc, rt := _ex(&cs, k[0])
            ic, it := _ex(&cs, k[1])
            if rt == "string" or rt == "bytes":
                return ("tycho_str_get(" + rc + ", " + ic + ")", "int")
            if _is_soa(rt):
                return (_spfx(&cs, rt) + "_get(&(" + rc + "), " + ic + ")", _selem(&cs, rt))
            if _is_map(rt):
                vt := _mval(&cs, rt)
                g := _mpfx(&cs, rt) + "_get(" + rc + ", " +
                    _keyrt(&cs, _mkey(&cs, rt), ic) + ", " + _zero(&cs, vt) + ")"
                return (_copy(&cs, g, vt, cs.arena), vt)
            if not _is_arr(rt):
                _bad("indexing a non-array")
            et := _elem(rt)
            if _in_range(&cs, k[0], k[1]):   # monotone loop index: skip the bounds check
                return ("(" + rc + ").data[" + ic + "]", et)
            return (_arrf(&cs, et, "_get") + "(" + rc + ", " + ic + ")", et)
        ast.Slice(l, hl, hh, k):
            # src/tychoc.c:11002-11050 -- the block id is taken BEFORE the subject
            # is generated, and one id serves whichever of the three branches runs.
            sid9 := _fresh(&cs, "")
            rc, rt := _ex(&cs, k[0])
            lo := "0L"
            hi := ""
            j := 1
            if hl:
                lc, lt := _ex(&cs, k[j])
                lo = lc
                j += 1
            if hh:
                hc, ht := _ex(&cs, k[j])
                hi = hc
            if rt == "string" or rt == "bytes":
                # The subject is bound to a temp so it is evaluated EXACTLY ONCE:
                # with `hi` omitted it is read a second time by tycho_str_len, and
                # a subject with a side effect ran twice (tests/slice_once.ty).
                ssn := "_ss" + sid9
                if len(hi) == 0:
                    hi = "tycho_str_len(" + ssn + ")"
                return ("({ const char *" + ssn + " = " + rc + "; tycho_str_substr(" +
                    cs.arena + ", " + ssn + ", " + lo + ", " + hi + "); })", rt)
            # A soa slice offsets EVERY field pointer by lo and carries cap 0,
            # so it is a view; the copy-on-bind comes from _heap, as for arrays.
            if _is_soa(rt):
                ss := "_sv" + sid9
                sl := "_lo" + sid9
                sh := "_hi" + sid9
                if len(hi) == 0:
                    hi = ss + ".len"
                st2 := _selem(&cs, rt)
                si2 := _sidx(&cs, _tname(st2))
                offs := ""
                for fi := 0; fi < len(cs.sds[si2].fnames); fi += 1:
                    offs = offs + ss + ".f" + str(fi) + " + " + sl + ", "
                # Copied, not returned as a view: the sliced Soa's field
                # pointers alias the SOURCE buffers, so `sl[0].x = -1` would
                # write through to q[1].x. ./tychoc wraps the same way.
                return (_spfx(&cs, rt) + "_copy(" + cs.arena + ", ({ " + _ctyz(&cs, rt) + "" + ss + " = " + rc + "; tycho_int " +
                    sl + " = " + lo + ", " + sh + " = " + hi + "; if (" + sl + " < 0 || " +
                    sh + " > " + ss + ".len || " + sl + " > " + sh + ") { fprintf(stderr, " +
                    "\"tycho: slice [%\" TY_PRId \":%\" TY_PRId \"] out of bounds (len %\" TY_PRId \")\\n\", " +
                    sl + ", " + sh + ", " + ss + ".len); exit(1); } (" + _cty(&cs, rt) + "){ " +
                    offs + sh + " - " + sl + ", 0 }; }))", rt)
            if not _is_arr(rt):
                _bad("slicing '" + rt + "'")
            sv := "_sv" + sid9
            act := _cty(&cs, rt)
            if len(hi) == 0:
                hi = sv + ".len"
            alo := "_lo" + sid9
            ahi := "_hi" + sid9
            sl := "({ " + act + " " + sv + " = " + rc + "; tycho_int " + alo + " = " + lo +
                ", " + ahi + " = " + hi + "; if (" + alo + " < 0 || " + ahi + " > " + sv +
                ".len || " + alo + " > " + ahi + ") { fprintf(stderr, \"tycho: slice [%\" TY_PRId \":%\" TY_PRId \"] out of bounds (len %\" TY_PRId \")\\n\", " +
                alo + ", " + ahi + ", " + sv + ".len); exit(1); } (" + act + "){ " + sv +
                ".data + " + alo + ", " + ahi + " - " + alo + ", 0 }; })"
            return (_copy(&cs, sl, rt, cs.arena), rt)
        ast.Unop(l, op, k):
            c, t := _ex(&cs, k[0])
            if op == "not":
                return ("(!" + c + ")", "bool")
            if op == "-" or op == "~":
                if _is_sized(t):
                    return ("((" + _cty(&cs, t) + ")(" + op + c + "))", t)
                return ("(" + op + c + ")", t)
            _bad("unsupported unary '" + op + "'")
        ast.Binop(l, op, k):
            return _binop(&cs, op, k[0], k[1])
        ast.Call(l, q, n, tas, args):
            return _call(&cs, l, q, n, tas, args)
        ast.ArrLit(l, k):
            return _arrlit(&cs, k)
        ast.EmptyArr(l, ts):
            et := ""
            if len(ts) == 0 and _is_map(cs.want):
                # `m: [K: V] = []` -- a bare [] under a map annotation is the
                # empty map, not an empty array.
                mv2 := _fresh(&cs, "_mp")
                return ("({ " + _ctyz(&cs, cs.want) + "" + mv2 + " = " +
                    _mpfx(&cs, cs.want) + "_with_cap(&_scope, 0); " + mv2 + "; })", cs.want)
            if len(ts) > 0:
                et = _ty(&cs, ts[0])
            else:
                if not _is_arr(cs.want):
                    _bad("a bare [] needs an element type here")
                et = _elem(cs.want)
            v := _fresh(&cs, "_l")
            ct := _cty(&cs, "[" + et + "]")
            # cs.arena, not a hard-coded &_scope: inside a loop body that is the
            # per-iteration scratch, and a loop-local `fs := []T` was otherwise
            # charged to the whole function. An ASSIGNMENT to an outer name is
            # unaffected -- the Assign arm sets cs.arena to the TARGET's owner.
            return ("({ " + ct + " " + v + " = " + _arrf(&cs, et, "_with_cap") +
                "(" + cs.arena + ", 0); " + v + ".len = 0; " + v + "; })", "[" + et + "]")
        ast.IsVar(l, k, q, vn):
            sc, st := _ex(&cs, k[0])
            if not _is_enum(st):
                _bad("`is` on a non-enum")
            ei := _eidx(&cs, _tname(st))
            tag := _tag(&cs, ei, vn)
            return ("((" + sc + ")->tag == " + str(tag) + ")", "bool")
        ast.TupIdx(l, k, n):
            rc, rt := _ex(&cs, k[0])
            if not _is_tup(rt):
                _bad("`.` index on a non-tuple")
            es := _telems(&cs, rt)
            if n < 0 or n >= len(es):
                _bad("tuple has no element " + str(n))
            return ("((" + rc + ").f" + str(n) + ")", es[n])
        ast.Tuple(l, k):
            ecs := []string
            ets := []string
            # Each element is emitted under the CORRESPONDING element of the
            # wanted tuple type, so `return (Ok(3), "full")` tells the bare `Ok`
            # which Result it belongs to. Only the signature writes that down.
            swt := cs.want
            wts := []string
            if _is_tup(swt):
                wts = _telems(&cs, swt)
            ti := 0
            for x in k:
                if ti < len(wts):
                    cs.want = wts[ti]
                else:
                    cs.want = ""
                ti += 1
                sar8 := cs.arena
                rs8 := cs.retslot
                cs.retslot = false
                xc, xt := _ex(&cs, x)
                cs.retslot = rs8
                cs.arena = sar8
                cs.want = swt
                # A tuple ELEMENT of a `return (a, b)` follows the same
                # return-slot rule the bare `return a` already had: a local the
                # escape pass built in _parent from birth is already where the
                # caller wants it. Gated on cs.retslot, which only ReturnS sets
                # and which is cleared for every nested expression -- a tuple
                # built mid-function must still copy, since its source stays
                # live and an array is written in place.
                if _place(x) and _heap(&cs, xt) and not _canmove(&cs, x, cs.arena) and
                        not (rs8 and _inparent(&cs, x)):
                    xc = _copy(&cs, xc, xt, cs.arena)
                push(ecs, xc)
                push(ets, xt)
            tt := _tup_of(&cs, ets)
            v := _fresh(&cs, "_tp")
            out := "({ " + _ctyz(&cs, tt) + "" + v + "; "
            for i := 0; i < len(ecs); i += 1:
                out = out + v + ".f" + str(i) + " = " + ecs[i] + "; "
            return (out + v + "; })", tt)
        ast.SomeE(l, k):
            w := cs.want
            if not _is_optT(&cs, w):
                pc, pt := _ex(&cs, k[0])
                w = _opt_of(&cs, pt)
            return _variant(&cs, _eidx(&cs, _tname(w)), "Some", k)
        ast.NoneE(l):
            if not _is_optT(&cs, cs.want):
                _bad("`None` here has no Option type to belong to")
            return _variant(&cs, _eidx(&cs, _tname(cs.want)), "None", []ast.Expr)
        ast.OkE(l, k):
            if not _is_resT(&cs, cs.want):
                _bad("`Ok` here has no Result type to belong to")
            return _variant(&cs, _eidx(&cs, _tname(cs.want)), "Ok", k)
        ast.ErrE(l, k):
            if not _is_resT(&cs, cs.want):
                _bad("`Err` here has no Result type to belong to")
            return _variant(&cs, _eidx(&cs, _tname(cs.want)), "Err", k)
        ast.OrRet(l, k):
            return _orret(&cs, k[0])
        ast.FStrLit(l, v): return _fstr(&cs, v)
        ast.NullLit(l):
            # `null` is the ptr literal; ptr is void* in the ABI.
            return ("((void *)0)", "ptr")
        ast.CallVal(l, k):
            sc, st3, ok3 := _subcallval(&cs, k, false)
            if ok3:
                return (sc, st3)
            return _callval(&cs, k)
        ast.Named(l, n, k): _bad("expr:Named -- Phase 8")
        ast.MapLit(l, k):
            return _maplit(&cs, k)
        ast.EmptyMap(l, t):
            mt := _map_of(&cs, _ty(&cs, t[0]), _ty(&cs, t[1]))
            mv := _fresh(&cs, "_mp")
            return ("({ " + _ctyz(&cs, mt) + "" + mv + " = " + _mpfx(&cs, mt) +
                "_with_cap(&_scope, 0); " + mv + "; })", mt)
        ast.SoaLit(l, t):
            ot := _soa_of(&cs, _ty(&cs, t[0]))
            return ("(" + _ctyz(&cs, ot) + "){0}", ot)
        ast.SpawnE(l, k): return _spawn(&cs, k[0])
        ast.Spread(l, k):
            # `xs...` IS the array; the packer passes it straight through, and
            # this arm is what lets the generic inference see its type at all.
            return _ex(&cs, k[0])
        ast.Addr(l, k):
            # `&x` reaching the EXPRESSION path. An inout ARGUMENT never gets
            # here -- `_addr_of` handles that -- so this is the residual case,
            # and it delegates rather than growing a second implementation.
            # Measured: the `&` here is not load-bearing for either fixture
            # (removing it moves no count), so what this arm buys is that Addr
            # stops aborting, not the address itself.
            _, at5 := _lvalue(&cs, k[0])
            return (_addr_of(&cs, e), at5)
        ast.ChanE(l, t, k):
            et := "?"
            if len(t) > 0:
                et = _ty(&cs, t[0])
            _ckind(&cs, et)
            cap := "0"
            if len(k) > 0:
                cc, ct := _ex(&cs, k[0])
                cap = cc
            return ("tycho_chan_new(" + cap + ")", "chan(" + et + ")")
        ast.Lambda(l, p, r, b): return _lambda(&cs, p, r, b[0])
        _: _bad("unsupported expression -- Phase 8")
    return ("", "")

# A value that is STORED outlives the statement that built it, so it is built in
# the scope arena even inside an expression statement's temp arena. Without this
# `push(xs, P("p" + str(i)))` leaves the field pointing into freed memory.
# --- f-strings --------------------------------------------------------------
# The parser hands `FStrLit` its body UNPARSED (ast/ast.ty:45), so both the
# split and the hole's re-lex happen here. Mirrors src/tychoc.c@desugar_interp,
# except that the body arrives RAW -- lex.ty:503 keeps the escapes, and a nested
# string inside a hole is copied verbatim with its quotes unescaped
# (lex/lex.ty:158), so a hole's text is lexable as it stands.
# Returns the pieces and, per piece, 0 for literal text and 1 for a hole.
fn _fsplit(body: string) -> ([string], [int]):
    txt := []string
    kind := []int
    lit := ""
    i := 0
    n := len(body)
    for i < n:
        c := body[i]
        if c == 123 and i + 1 < n and body[i + 1] == 123:
            lit = lit + "{"
            i += 2
            continue
        if c == 125 and i + 1 < n and body[i + 1] == 125:
            lit = lit + "}"
            i += 2
            continue
        if c == 125:
            _bad("unmatched '}' in an interpolated string (use '}}' for a literal brace)")
        if c == 123:
            if len(lit) > 0:
                push(txt, lit)
                push(kind, 0)
                lit = ""
            i += 1
            start := i
            depth := 1
            for i < n and depth > 0:
                d := body[i]
                if d == 34:
                    i += 1
                    for i < n and body[i] != 34:
                        if body[i] == 92:
                            i += 1
                        i += 1
                    if i >= n:
                        _bad("unterminated string in an interpolated hole")
                    i += 1
                    continue
                if d == 123:
                    depth += 1
                elif d == 125:
                    depth -= 1
                    if depth == 0:
                        break
                i += 1
            if depth != 0:
                _bad("unterminated '{' in an interpolated string")
            if i == start:
                _bad("empty '{}' in an interpolated string")
            push(txt, body[start:i])
            push(kind, 1)
            i += 1
            continue
        if c == 92:
            lit = lit + body[i:i + 2]
            i += 2
            continue
        lit = lit + body[i:i + 1]
        i += 1
    if len(lit) > 0:
        push(txt, lit)
        push(kind, 0)
    return (txt, kind)

fn _fstr(cs: inout C, body: string) -> (string, string):
    txt, kind := _fsplit(body)
    if len(txt) == 0:
        return ("TYCHO_LIT(\"\")", "string")
    sw := cs.want
    cs.want = ""
    # src/tychoc.c desugars an f-string into a left-nested `+` chain marked
    # `fstr`, then folds 3..6 string pieces into one tycho_str_concatN. Every
    # hole is wrapped in a `str()` call, so `expr_has_call` is always true for a
    # chain with a hole and the `fseq` arm always fires: each piece BUT THE LAST
    # binds to a `_fi<n>` temp, which is what pins the left-to-right evaluation
    # order 13.4 requires (tests/fstring_eval_order.ty).
    ps := []string
    for i := 0; i < len(txt); i += 1:
        piece := "TYCHO_LIT(\"" + txt[i] + "\")"
        if kind[i] == 1:
            toks := lex.tokenize(txt[i])
            he, _hp := parse.expr(toks, 0)
            hc, ht := _ex(&cs, he)
            piece = _tostr(&cs, hc, ht)
        push(ps, piece)
    cs.want = sw
    return (_fchain(&cs, ps, len(ps)), "string")

# The emission for the leftmost `n` of `ps`, mirroring gen_expr's E_BINOP arm:
# 2..6 pieces fold to one concatN inside a braced group, and a longer chain is
# the fold of its first n-1 wrapped in one more pairwise concat.
fn _fchain(cs: inout C, ps: [string], n: int) -> string:
    if n == 1:
        return ps[0]
    if n > 6:
        inner := _fchain(&cs, ps, n - 1)
        v := "_fi" + str(cs.uid)
        cs.uid += 1
        return "({ char *" + v + " = " + inner + "; tycho_str_concat(" + cs.arena +
            ", " + v + ", " + ps[n - 1] + "); })"
    pre := ""
    out := "tycho_str_concat"
    if n > 2:
        out = out + str(n)
    out = out + "(" + cs.arena
    for i := 0; i < n; i += 1:
        a := ps[i]
        if i < n - 1:
            v := "_fi" + str(cs.uid)
            cs.uid += 1
            pre = pre + "char *" + v + " = " + a + "; "
            a = v
        out = out + ", " + a
    return "({ " + pre + out + "); })"

# --- function values --------------------------------------------------------
# A fn value is the same 3-word FAT POINTER src/tychoc.c:13007 emits:
# `{ void *env; RET (*call)(void*, Arena*, P...); void *(*copyenv)(Arena*, void*); }`.
# A reference to a named function has env == 0; a capturing lambda allocates an
# Env in the arena that owns the value and carries a copier so a returned
# closure re-homes its captures. The registry key is "ret|p0|p1|...", the type
# string "F~<index>", stamped exactly as a tuple kind is.
fn _is_fn(t: string) -> bool:
    return strings.starts_with(t, "F~")

fn _fkind(cs: inout C, key: string) -> int:
    for i := 0; i < len(cs.fks); i += 1:
        if cs.fks[i] == key:
            return i
    push(cs.fks, key)
    return len(cs.fks) - 1

fn _fn_of(cs: inout C, ret: string, ps: [string]) -> string:
    k := ret
    for p in ps:
        k = k + "|" + p
    return "F~" + str(_fkind(&cs, k))

fn _fparts(cs: inout C, t: string) -> [string]:
    return split(cs.fks[strings.parse_int(_tname(t))], "|")

fn _fret(cs: inout C, t: string) -> string:
    return _fparts(&cs, t)[0]

fn _fps(cs: inout C, t: string) -> [string]:
    p := _fparts(&cs, t)
    return p[1:len(p)]

# The `<name>__clo` trampoline: one per named function actually taken as a
# value, so an unused function grows no code and an `inout` parameter (which a
# fn value cannot carry) is never wrapped.
fn _need_clo(cs: inout C, fi: int):
    for x in cs.clos:
        if x == cs.fds[fi].name:
            return
    push(cs.clos, cs.fds[fi].name)

fn _clo_defs(cs: inout C) -> (string, string):
    pr := ""
    bd := ""
    for nm in cs.clos:
        fi := _fidx(&cs, nm)
        rt := cs.fds[fi].ret
        sig := _ctyz(&cs, rt) + "" + nm + "__clo(void *_env, Arena *_parent"
        call := "h_" + nm + "(_parent"
        for j := 0; j < len(cs.fds[fi].ptypes); j += 1:
            sig = sig + ", " + _ctyz(&cs, cs.fds[fi].ptypes[j]) + "_a" + str(j)
            call = call + ", _a" + str(j)
        sig = sig + ")"
        call = call + ")"
        r := "    return " + call + ";\n"
        if rt == "void":
            r = "    " + call + ";\n"
        pr = pr + sig + ";\n"
        bd = bd + sig + " {\n    (void)_env;\n" + r + "}\n"
    return (pr, bd)

fn _fn_defs(cs: inout C) -> string:
    out := ""
    for i := 0; i < len(cs.fks); i += 1:
        ps := split(cs.fks[i], "|")
        s := "typedef struct { void *env; " + _ctyz(&cs, ps[0]) + "(*call)(void *, Arena *"
        for j := 1; j < len(ps); j += 1:
            s = s + ", " + _cty(&cs, ps[j])
        out = out + s + "); void *(*copyenv)(Arena *, void *); } FnC" + str(i) + ";\n"
    return out

# A lambda body is one EXPRESSION (parse/parse.ty:310), so the only binder
# inside it is a nested lambda's parameter list -- which is what makes this
# free-variable walk short enough to be trustworthy.
fn _bound(bs: [string], n: string) -> bool:
    for b in bs:
        if b == n:
            return true
    return false

fn _fv(cs: inout C, e: ast.Expr, bs: [string], out: inout [string]):
    match e:
        ast.Name(l, n):
            if _bound(bs, n) or _bound(out, n):
                return
            if len(_vtype(&cs, n)) > 0:
                push(out, n)
        ast.Lambda(l, ps, r, b):
            bs2 := []string
            for x in bs:
                push(bs2, x)
            for p in ps:
                push(bs2, p.name)
            _fv(&cs, b[0], bs2, &out)
        ast.Field(l, k, f): _fv(&cs, k[0], bs, &out)
        ast.TupIdx(l, k, n2): _fv(&cs, k[0], bs, &out)
        ast.Call(l, q, n2, ts, k):
            # `g(f(x))`: f and g are the CALLEE names, and skipping them is the
            # regression tests/closure_fncap.ty pins.
            cn2 := q
            if len(q) == 0:
                cn2 = n2
            if not _bound(bs, cn2) and not _bound(out, cn2) and len(_vtype(&cs, cn2)) > 0:
                push(out, cn2)
            for x in k:
                _fv(&cs, x, bs, &out)
        ast.IsVar(l, k, q, n2): _fv(&cs, k[0], bs, &out)
        ast.EmptyArr(l, t): pass
        ast.EmptyMap(l, t): pass
        ast.SoaLit(l, t): pass
        ast.ChanE(l, t, k):
            for x in k:
                _fv(&cs, x, bs, &out)
        ast.IntLit(l, v): pass
        ast.FloatLit(l, v): pass
        ast.StrLit(l, v): pass
        ast.CharLit(l, v): pass
        ast.BoolLit(l, v): pass
        ast.NullLit(l): pass
        ast.NoneE(l): pass
        ast.FStrLit(l, v):
            txt, kind := _fsplit(v)
            for i := 0; i < len(txt); i += 1:
                if kind[i] == 1:
                    toks := lex.tokenize(txt[i])
                    he, _hp := parse.expr(toks, 0)
                    _fv(&cs, he, bs, &out)
        ast.Index(l, k): _fvs(&cs, k, bs, &out)
        ast.Slice(l, a, b2, k): _fvs(&cs, k, bs, &out)
        ast.CallVal(l, k): _fvs(&cs, k, bs, &out)
        ast.Named(l, n2, k): _fvs(&cs, k, bs, &out)
        ast.Binop(l, o, k): _fvs(&cs, k, bs, &out)
        ast.Unop(l, o, k): _fvs(&cs, k, bs, &out)
        ast.ArrLit(l, k): _fvs(&cs, k, bs, &out)
        ast.MapLit(l, k): _fvs(&cs, k, bs, &out)
        ast.Tuple(l, k): _fvs(&cs, k, bs, &out)
        ast.SomeE(l, k): _fvs(&cs, k, bs, &out)
        ast.OkE(l, k): _fvs(&cs, k, bs, &out)
        ast.ErrE(l, k): _fvs(&cs, k, bs, &out)
        ast.SpawnE(l, k): _fvs(&cs, k, bs, &out)
        ast.OrRet(l, k): _fvs(&cs, k, bs, &out)
        ast.Spread(l, k): _fvs(&cs, k, bs, &out)
        ast.Addr(l, k): _fvs(&cs, k, bs, &out)

fn _fvs(cs: inout C, k: [ast.Expr], bs: [string], out: inout [string]):
    for x in k:
        _fv(&cs, x, bs, &out)

# The free variables of a STATEMENT body, and the ones it ASSIGNS. A parallel
# for outlines its body into a worker taking [lo, hi) plus every capture, and
# returning the reduction (src/tychoc.c@__plo): a captured variable that is
# written is a reduction, one that is only read is passed by value.
fn _fv_body(cs: inout C, body: [ast.Stmt], bs0: [string], out: inout [string], wr: inout [string]):
    bs := bs0
    for st in body:
        match st:
            ast.ExprStmt(l, k): _fvs(&cs, k, bs, &out)
            ast.Decl(l, n, t, r, v):
                _fvs(&cs, r, bs, &out)
                push(bs, n)
                _fv_body(&cs, v, bs, &out, &wr)
            ast.MDecl(l, d, ns, r):
                _fvs(&cs, r, bs, &out)
                for n in ns:
                    push(bs, n)
            ast.Assign(l, n, r):
                _fvs(&cs, r, bs, &out)
                if not _has(bs, n):
                    _add1(&wr, n)
                    _add1(&out, n)
            ast.PlaceSet(l, k): _fvs(&cs, k, bs, &out)
            ast.ConstS(l, n, k):
                _fvs(&cs, k, bs, &out)
                push(bs, n)
            ast.ReturnS(l, k): _fvs(&cs, k, bs, &out)
            ast.IfS(l, c, b2, e2):
                _fvs(&cs, c, bs, &out)
                _fv_body(&cs, b2, bs, &out, &wr)
                _fv_body(&cs, e2, bs, &out, &wr)
            ast.WhileS(l, c, b2):
                _fvs(&cs, c, bs, &out)
                _fv_body(&cs, b2, bs, &out, &wr)
            ast.For3(l, ip, c, b2):
                _fv_body(&cs, ip, bs, &out, &wr)
                _fvs(&cs, c, bs, &out)
                _fv_body(&cs, b2, bs, &out, &wr)
            ast.ForIn(l, n, coll, b2):
                _fvs(&cs, coll, bs, &out)
                push(bs, n)
                _fv_body(&cs, b2, bs, &out, &wr)
            ast.ForRange(l, n, k, b2):
                _fvs(&cs, k, bs, &out)
                push(bs, n)
                _fv_body(&cs, b2, bs, &out, &wr)
            ast.MatchS(l, c, arms):
                _fvs(&cs, c, bs, &out)
                for a in arms:
                    bs2 := bs
                    for b3 in a.binds:
                        push(bs2, b3)
                    _fv_body(&cs, a.body, bs2, &out, &wr)
            ast.SelectS(l, arms):
                # A `select:` inside a parallel body captures the CHANNELS it
                # names; without this arm they were not passed to the worker.
                for a in arms:
                    _fvs(&cs, a.ch, bs, &out)
                    bs3 := bs
                    for b4 in a.binds:
                        push(bs3, b4)
                    _fv_body(&cs, a.body, bs3, &out, &wr)
            ast.ParallelS(l, w, b5):
                _fvs(&cs, w, bs, &out)
                _fv_body(&cs, b5, bs, &out, &wr)
            _: pass

fn _has(xs: [string], n: string) -> bool:
    for x in xs:
        if x == n:
            return true
    return false

fn _add1(xs: inout [string], n: string):
    if not _has(xs, n):
        push(xs, n)

fn _lambda(cs: inout C, ps: [ast.Param], ret: [ast.Ty], body: ast.Expr) -> (string, string):
    # The lambda's own type: an untyped parameter or an omitted return is read
    # off `cs.want`, which is the only place either is written down.
    want := cs.want
    wps := []string
    wr := ""
    if _is_fn(want):
        wps = _fps(&cs, want)
        wr = _fret(&cs, want)
    pts := []string
    for i := 0; i < len(ps); i += 1:
        if len(ps[i].ty) > 0:
            push(pts, _ty(&cs, ps[i].ty[0]))
        elif i < len(wps):
            push(pts, wps[i])
        else:
            _bad("a lambda parameter with no type and nothing to infer it from")
    caps := []string
    pn := []string
    for p in ps:
        push(pn, p.name)
    _fv(&cs, body, pn, &caps)
    cs.tmp += 1
    id := str(cs.tmp)
    capt := []string
    for c in caps:
        push(capt, _vtype(&cs, c))
    # Emit the body against a scope holding ONLY the captures and the params:
    # a lambda cannot see the enclosing function's other locals by construction.
    sv := cs.vnames
    svt := cs.vtypes
    svc := cs.vcn
    svo := cs.vown
    scr := cs.cur_ret
    sar := cs.arena
    cs.vnames = []string
    cs.vtypes = []string
    cs.vcn = []string
    cs.vown = []string
    sas := cs.ascope
    cs.ascope = []string
    cs.arena = "&_scope"
    env := ""
    for i := 0; i < len(caps); i += 1:
        _push(&cs, caps[i], capt[i])
        cs.vcn[len(cs.vcn) - 1] = "(_ec->c" + str(i) + ")"
        env = env + "    " + _ctyz(&cs, capt[i]) + "c" + str(i) + ";\n"
    sig := "(void *_env, Arena *_parent"
    for i := 0; i < len(ps); i += 1:
        cn := _push(&cs, ps[i].name, pts[i])
        sig = sig + ", " + _ctyz(&cs, pts[i]) + "" + cn
    sig = sig + ")"
    rt := wr
    if len(ret) > 0:
        rt = _ty(&cs, ret[0])
    if len(rt) == 0:
        rt = "?"
    cs.cur_ret = rt
    bc, bt := _ex(&cs, body)
    if rt == "?":
        rt = bt
        cs.cur_ret = rt
    cs.vnames = sv
    cs.vtypes = svt
    cs.vcn = svc
    cs.vown = svo
    cs.cur_ret = scr
    cs.arena = sar
    cs.ascope = sas
    ft := _fn_of(&cs, rt, pts)
    fid := _tname(ft)
    pre := ""
    if len(caps) > 0:
        pre = "    Env" + id + " *_ec = (Env" + id + " *)_env;\n"
    # The thunk's own scope must be released, exactly as a named fn's is: the
    # result is copied into _parent first, so the copy outlives the free.
    ret2 := "    " + _ctyz(&cs, rt) + "_lr = " + _copy(&cs, bc, rt, "_parent") +
        ";\n    arena_free(&_scope);\n    return _lr;\n"
    if rt == "void":
        ret2 = "    " + bc + ";\n    arena_free(&_scope);\n"
    d := ""
    if len(caps) > 0:
        d = "typedef struct { \n" + env + "} Env" + id + ";\n" +
            "static void *Env" + id + "_copy(Arena *_a, void *_p) {\n" +
            "    Env" + id + " *_s = (Env" + id + " *)_p;\n" +
            "    Env" + id + " *_d = (Env" + id + " *)arena_alloc(_a, sizeof(Env" + id + "));\n"
        for i := 0; i < len(caps); i += 1:
            d = d + "    _d->c" + str(i) + " = " + _copy(&cs, "(_s->c" + str(i) + ")", capt[i], "_a") + ";\n"
        d = d + "    return _d;\n}\n"
    d = d + _ctyz(&cs, rt) + "__lam" + id + "__clo" + sig + " {\n" + pre +
        "    Arena _scope = arena_child(_parent);\n" + ret2 + "}\n"
    push(cs.lamd, d)
    push(cs.lamp, _ctyz(&cs, rt) + "__lam" + id + "__clo" + sig + ";\n")
    if len(caps) == 0:
        return ("(FnC" + fid + "){0, __lam" + id + "__clo, 0}", ft)
    mk := "({ Env" + id + " *_e = (Env" + id + " *)arena_alloc(" + cs.arena + ", sizeof(Env" + id + "));"
    for i := 0; i < len(caps); i += 1:
        cv := _vcname(&cs, caps[i])
        if _heap(&cs, capt[i]):
            cv = _copy(&cs, cv, capt[i], cs.arena)
        mk = mk + " _e->c" + str(i) + " = " + cv + ";"
    return (mk + " (FnC" + fid + "){_e, __lam" + id + "__clo, Env" + id + "_copy}; })", ft)

# As _ex_scope, but in the INNERMOST live scratch. A transient built for a push
# inside a loop belongs to that iteration: &_scope is the function arena and is
# freed once, so 2e6 iterations of bench/strarr_build.ty retained every piece.
fn _ex_cur(cs: inout C, e: ast.Expr) -> (string, string):
    sav := cs.arena
    cs.arena = _curown(&cs)
    c, t := _ex(&cs, e)
    cs.arena = sav
    return (c, t)

fn _ex_scope(cs: inout C, e: ast.Expr) -> (string, string):
    sav := cs.arena
    cs.arena = "&_scope"
    c, t := _ex(&cs, e)
    cs.arena = sav
    return (c, t)

# _tag DIES on an unknown variant, so it cannot be used to ASK whether a name
# is one. This is the asking form.
fn _tagopt(cs: inout C, ei: int, vn: string) -> int:
    for i := 0; i < len(cs.eds[ei].vnames); i += 1:
        if cs.eds[ei].vnames[i] == vn:
            return i
    return -1

fn _tag(cs: inout C, ei: int, vn: string) -> int:
    for i := 0; i < len(cs.eds[ei].vnames); i += 1:
        if cs.eds[ei].vnames[i] == vn:
            return i
    _bad("enum " + cs.eds[ei].name + " has no variant '" + vn + "'")
    return 0

# `levels.DEBUG` and `geom.Red` parse as a FIELD on a name. When that name is an
# imported package and not a local, the member is that package's const or its
# bare variant. Returns ("", "") when the receiver is an ordinary value.
# UFCS across a package boundary: `c.describe()` on a `geom.Circle` reaches
# `geom__describe`, because a method-style call follows its RECEIVER's package
# when the calling package has no such function.
# A subscript has NO runtime object: the call INLINES to the place its body
# yields (spec ROADMAP 2.4). Rather than substituting the AST, each parameter is
# bound as a variable whose C NAME is the argument's already-emitted text, so the
# yielded expression emits against the caller's own values. `lv` picks the place
# form (`*..._ptr`) over the rvalue form (`..._get`), which is the only thing
# that differs between a write through the projection and a read of it.
# `g.edge(1)` parses as CallVal with a Field callee, not as Call -- the same
# split Phase 4 found at src/tychoc.c:4136, where one E_CALL covers both.
fn _subcallval(cs: inout C, k: [ast.Expr], lv: bool) -> (string, string, bool):
    match k[0]:
        ast.Field(l6, r6, f6):
            si := _subidx(&cs, f6)
            if si >= 0:
                ua := []ast.Expr
                push(ua, r6[0])
                for ai := 1; ai < len(k); ai += 1:
                    push(ua, k[ai])
                c, t := _subinline(&cs, si, ua, lv)
                return (c, t, true)
        _: pass
    return ("", "", false)

fn _subidx(cs: inout C, n: string) -> int:
    for i := 0; i < len(cs.subn); i += 1:
        if cs.subn[i] == n:
            return i
    return -1

fn _subinline(cs: inout C, si: int, args: [ast.Expr], lv: bool) -> (string, string):
    ps := cs.subp[si]
    if len(args) != len(ps):
        _bad("subscript '" + cs.subn[si] + "' takes " + str(len(ps)) + " argument(s)")
    nsave := len(cs.vnames)
    for i := 0; i < len(ps); i += 1:
        ac := ""
        at := ""
        if lv and _place(args[i]):
            ac, at = _lvalue(&cs, args[i])
        else:
            ac, at = _ex(&cs, args[i])
        push(cs.vnames, ps[i].name)
        push(cs.vtypes, at)
        push(cs.vcn, ac)
        push(cs.vown, "&_scope")
    inner := cs.sube[si]
    match cs.sube[si]:
        ast.Addr(l, k): inner = k[0]
        _: pass
    rc := ""
    rt := ""
    if lv:
        rc, rt = _lvalue(&cs, inner)
    else:
        rc, rt = _ex(&cs, inner)
    for len(cs.vnames) > nsave:
        pop(cs.vnames)
        pop(cs.vtypes)
        pop(cs.vcn)
        pop(cs.vown)
    return (rc, rt)

fn _ufcs_name(cs: inout C, n: string, rt: string) -> string:
    if _fidx(&cs, n) >= 0:
        return n
    tn := ""
    if _is_struct(rt) or _is_enum(rt):
        tn = _tname(rt)
    if len(tn) == 0:
        return n
    best := ""
    for i := 0; i < len(cs.fpfx); i += 1:
        pf := cs.fpfx[i]
        if len(pf) == 0 or len(pf) > len(tn):
            continue
        if tn[0:len(pf)] != pf or len(pf) <= len(best):
            continue
        if _fidx(&cs, pf + n) >= 0:
            best = pf
    if len(best) == 0:
        return n
    return best + n

fn _pkgmember(cs: inout C, r: ast.Expr, f: string) -> (string, string):
    q := ""
    match r:
        ast.Name(l, nm): q = nm
        _: q = ""
    if len(q) == 0 or len(_vtype(&cs, q)) > 0 or not _ispkg(&cs, q):
        return ("", "")
    pf := _qpfx(&cs, q)
    for i := 0; i < len(cs.cnames); i += 1:
        if cs.cnames[i] == pf + f:
            return (cs.ccode[i], cs.ctypes[i])
    ei := _qvariant(&cs, pf, f)
    if ei >= 0:
        return _variant(&cs, ei, f, []ast.Expr)
    # `opsx.bump` taken as a VALUE: the same trampoline the unqualified spelling
    # gets, under the package-mangled name.
    fi := -1
    for i := 0; i < len(cs.fds); i += 1:
        if cs.fds[i].name == pf + f:
            fi = i
    if fi >= 0:
        _need_clo(&cs, fi)
        ft := _fn_of(&cs, cs.fds[fi].ret, cs.fds[fi].ptypes)
        return ("(" + _cty(&cs, ft) + "){0, " + cs.fds[fi].name + "__clo, 0}", ft)
    _bad("unknown package member '" + q + "." + f + "'")
    return ("", "")

fn _bare_variant(cs: inout C, n: string) -> int:
    if _is_enum(cs.want):
        w := _eidx(&cs, _tname(cs.want))
        if w >= 0 and not _is_gen(cs.eds[w].name):
            for v in cs.eds[w].vnames:
                if v == n:
                    return w
    return _qvariant(&cs, _pfx(&cs), n)

# A variant name is PACKAGE-scoped: `EmptyInput` in main is a different variant
# from a sibling package's, even spelt the same (tests/pkg/variant_shadow). So
# the search is confined to the enums declared with this prefix.
fn _qvariant(cs: inout C, pfx: string, n: string) -> int:
    for i := 0; i < len(cs.eds); i += 1:
        if cs.edp[i] != pfx:
            continue
        if _is_gen(cs.eds[i].name) or _is_inst(&cs, cs.eds[i].name):
            continue
        for v in cs.eds[i].vnames:
            if v == n:
                return i
    return -1

# An INSTANCE of a generic enum is reachable only through the wanted type or by
# inferring its arguments -- never by a bare variant name, which would otherwise
# resolve `Has("hi")` into whichever instance happened to be stamped first.
fn _is_inst(cs: inout C, n: string) -> bool:
    for i := 0; i < len(cs.iname); i += 1:
        if cs.iname[i] == n:
            return true
    return false

fn _variant(cs: inout C, ei: int, vn: string, args: [ast.Expr]) -> (string, string):
    en := cs.eds[ei].name
    tag := _tag(&cs, ei, vn)
    pay := cs.eds[ei].vpay[tag].ptypes
    if len(pay) != len(args):
        _bad("variant " + vn + " takes " + str(len(pay)) + " payload value(s)")
    if len(pay) == 0:
        return ("(&_sing_" + en + "_" + str(tag) + ")", "E~" + en)
    v := _fresh(&cs, "_v")
    out := "({ E_" + en + " *" + v + " = (E_" + en + " *)arena_alloc(" + cs.arena + ", offsetof(E_" +
        en + ", u) + sizeof(E_" + en + "_" + vn + ")); " + v + "->tag = " + str(tag) + "; "
    for i := 0; i < len(args); i += 1:
        sw := cs.want
        cs.want = pay[i]
        sar9 := cs.arena
        ac, at := _ex(&cs, args[i])
        cs.arena = sar9
        cs.want = sw
        if pay[i] == "float" and at == "int":
            ac = "(double)(" + ac + ")"
        if _place(args[i]) and _heap(&cs, pay[i]) and not _shares(&cs, args[i], pay[i], cs.arena) and
                not _canmove(&cs, args[i], cs.arena):
            ac = _copy(&cs, ac, pay[i], cs.arena)
        out = out + v + "->u." + vn + ".f" + str(i) + " = " + ac + "; "
    return (out + v + "; })", "E~" + en)

# `x or_return` -- on the failing tag it returns the SAME failure from the
# enclosing function, rebuilt in the caller's arena because this scope is freed
# on the way out.
fn _orret(cs: inout C, e: ast.Expr) -> (string, string):
    sw := cs.want
    cs.want = ""
    c, t := _ex_scope(&cs, e)
    cs.want = sw
    if not (_is_optT(&cs, t) or _is_resT(&cs, t)):
        _bad("`or_return` on a value that is not an Option or a Result")
    ei := _eidx(&cs, _tname(t))
    rt := cs.cur_ret
    if not (_is_optT(&cs, rt) or _is_resT(&cs, rt)):
        _bad("`or_return` inside a function that returns neither Option nor Result")
    ri := _eidx(&cs, _tname(rt))
    v := _fresh(&cs, "_or")
    r2 := _fresh(&cs, "_or")
    bad := 0
    if _is_resT(&cs, t):
        bad = 1
    rbad := 0
    if _is_resT(&cs, rt):
        rbad = 1
    rn := _tname(rt)
    rvn := cs.eds[ri].vnames[rbad]
    rpay := cs.eds[ri].vpay[rbad].ptypes
    mk := "(&_sing_" + rn + "_" + str(rbad) + ")"
    if len(rpay) > 0:
        src := "(" + v + "->u." + cs.eds[ei].vnames[bad] + ".f0)"
        if len(cs.eds[ei].vpay[bad].ptypes) == 0:
            _bad("`or_return` cannot carry a payload the source variant does not have")
        mk = "({ E_" + rn + " *" + r2 + " = (E_" + rn + " *)arena_alloc(_parent, offsetof(E_" +
            rn + ", u) + sizeof(E_" + rn + "_" + rvn + ")); " + r2 + "->tag = " + str(rbad) +
            "; " + r2 + "->u." + rvn + ".f0 = " + _copy(&cs, src, rpay[0], "_parent") + "; " +
            r2 + "; })"
    ok := cs.eds[ei].vpay[1 - bad].ptypes
    got := "((void)0)"
    gt := "void"
    if len(ok) > 0:
        got = "(" + v + "->u." + cs.eds[ei].vnames[1 - bad] + ".f0)"
        gt = ok[0]
    return ("({ E_" + _tname(t) + " *" + v + " = " + c + "; if (" + v + "->tag == " +
        str(bad) + ") { E_" + rn + " *_orr = " + mk +
        "; " + _oneline(_finalizers(&cs, cs.fnbase, "")) + _scr_frees(&cs) +
        "if (_scope.head) arena_free(&_scope); return _orr; } " +
        got + "; })", gt)

fn _arrlit(cs: inout C, k: [ast.Expr]) -> (string, string):
    if len(k) == 0:
        _bad("an empty array literal needs a type")
    v := _fresh(&cs, "_l")
    sw := cs.want
    # `a: [u32] = [1, 2]` -- the elements adapt to the ANNOTATED element type,
    # which is the only place it is written down; taking it from element 0 alone
    # would type this [int] and then fail to initialise a TychoArrK.
    # Element 0 is emitted UNDER the narrowed want like every other element: it
    # used to be emitted first, under the outer one, and `[[[1]]]` -- one element
    # at every level -- then built TychoArrK0 at all three (tests/recursion
    # ok_type, which cc refused).
    et := ""
    if _is_arr(cs.want):
        et = _elem(cs.want)
        cs.want = et
    c0, et0 := _ex(&cs, k[0])
    if len(et) == 0:
        et = et0
        cs.want = et
    ct := _cty(&cs, "[" + et + "]")
    out := "({ " + ct + " " + v + " = " + _arrf(&cs, et, "_with_cap") + "(" + cs.arena + ", " +
        str(len(k)) + "L); "
    for i := 0; i < len(k); i += 1:
        ac := c0
        at2 := et0
        if i > 0:
            ac2, at3 := _ex(&cs, k[i])
            ac = ac2
            at2 = at3
        if at2 != et and not _heap(&cs, et):
            ac = "((" + _cty(&cs, et) + ")(" + ac + "))"
        if _place(k[i]) and _heap(&cs, et) and not _shares(&cs, k[i], et, cs.arena) and
                not _canmove(&cs, k[i], cs.arena):
            ac = _copy(&cs, ac, et, cs.arena)
        out = out + v + ".data[" + str(i) + "] = " + ac + "; "
    cs.want = sw
    return (out + v + ".len = " + str(len(k)) + "L; " + v + "; })", "[" + et + "]")

fn _maplit(cs: inout C, k: [ast.Expr]) -> (string, string):
    if len(k) < 2:
        _bad("an empty map literal needs a type")
    kc0, kt := _ex(&cs, k[0])
    vc0, vt := _ex(&cs, k[1])
    mt := _map_of(&cs, kt, vt)
    v := _fresh(&cs, "_mp")
    n := len(k) / 2
    out := "({ " + _ctyz(&cs, mt) + "" + v + " = " + _mpfx(&cs, mt) +
        "_with_cap(" + cs.arena + ", " + str(n) + "LL); "
    for i := 0; i < len(k); i += 2:
        sw := cs.want
        cs.want = kt
        kc, kct := _ex(&cs, k[i])
        cs.want = vt
        vc, vct := _ex(&cs, k[i + 1])
        cs.want = sw
        if vt == "float" and vct == "int":
            vc = "(double)(" + vc + ")"
        out = out + _mpfx(&cs, mt) + "_put(" + cs.arena + ", &" + v + ", " +
            _keyrt(&cs, kt, kc) + ", " + vc + "); "
    return (out + v + "; })", mt)

# `m.get(k)` / `m.get(k, default)` reach emit as a call on a field expression;
# the map read is the only receiver method the language has (fn values are 7b's).
fn _mapget(cs: inout C, mc: string, mt: string, args: [ast.Expr]) -> (string, string):
    if len(args) != 1 and len(args) != 2:
        _bad("m.get(key) or m.get(key, default)")
    kc, kct := _ex(&cs, args[0])
    vt := _mval(&cs, mt)
    d := _zero(&cs, vt)
    if len(args) == 2:
        sw := cs.want
        cs.want = vt
        dc, dt := _ex(&cs, args[1])
        cs.want = sw
        if vt == "float" and dt == "int":
            dc = "(double)(" + dc + ")"
        d = dc
    g := _mpfx(&cs, mt) + "_get(" + mc + ", " + _keyrt(&cs, _mkey(&cs, mt), kc) +
        ", " + d + ")"
    return (_copy(&cs, g, vt, cs.arena), vt)

fn _callval(cs: inout C, k: [ast.Expr]) -> (string, string):
    match k[0]:
        ast.Field(l, r, f):
            # `(pkg.f)(x)` -- the parenthesised immediate call. The receiver is a
            # PACKAGE, not a value, so it must not be evaluated as one.
            match r[0]:
                ast.Name(l9, q9):
                    if len(_vtype(&cs, q9)) == 0 and _ispkg(&cs, q9):
                        ra := []ast.Expr
                        for i := 1; i < len(k); i += 1:
                            push(ra, k[i])
                        return _call(&cs, l, q9, f, []ast.Ty, ra)
                _: pass
            rt0 := _argtypes(&cs, r)[0]
            if _is_struct(rt0):
                si4 := _sidx(&cs, _tname(rt0))
                for j := 0; j < len(cs.sds[si4].fnames); j += 1:
                    if cs.sds[si4].fnames[j] == f and _is_fn(cs.sds[si4].ftypes[j]):
                        # a fn-typed FIELD is a value call, not UFCS
                        return _callfv(&cs, k)
            if f != "get" or not _is_map(rt0):
                # UFCS: `x.f(a)` is `f(x, a)` for any free function f.
                ua := []ast.Expr
                push(ua, r[0])
                for i := 1; i < len(k); i += 1:
                    push(ua, k[i])
                return _call(&cs, l, "", f, []ast.Ty, ua)
            mc, mt := _ex(&cs, r[0])
            if not _is_map(mt):
                _bad(".get() on a non-map")
            rest := []ast.Expr
            for i := 1; i < len(k); i += 1:
                push(rest, k[i])
            return _mapget(&cs, mc, mt, rest)
        _: pass
    return _callfv(&cs, k)

fn _callfv(cs: inout C, k: [ast.Expr]) -> (string, string):
    fc, ft := _ex(&cs, k[0])
    if not _is_fn(ft):
        _bad("call of a value that is not a function")
    fv := _fresh(&cs, "_fv")
    out := "({ " + _ctyz(&cs, ft) + "" + fv + " = " + fc + "; " + fv + ".call(" + fv +
        ".env, " + cs.arena
    fps := _fps(&cs, ft)
    sw := cs.want
    for i := 1; i < len(k); i += 1:
        cs.want = ""
        if i - 1 < len(fps):
            cs.want = fps[i - 1]
        ac, at := _rhs2(&cs, k[i], cs.want, cs.arena)
        out = out + ", " + ac
    cs.want = sw
    return (out + "); })", _fret(&cs, ft))

fn _binop(cs: inout C, op: string, ea: ast.Expr, eb: ast.Expr) -> (string, string):
    a, at := _ex(&cs, ea)
    b, bt := _ex(&cs, eb)
    if op == "in":
        if not _is_map(bt):
            _bad("`in` tests membership in a map")
        return (_mpfx(&cs, bt) + "_has(" + b + ", " + _keyrt(&cs, _mkey(&cs, bt), a) + ")", "bool")
    if op == "and":
        return ("(" + a + " && " + b + ")", "bool")
    if op == "or":
        return ("(" + a + " || " + b + ")", "bool")
    if op == "==":
        return (_eq(&cs, a, b, at), "bool")
    if op == "!=":
        return ("(!" + _eq(&cs, a, b, at) + ")", "bool")
    if op == "<" or op == ">" or op == "<=" or op == ">=":
        if at == "string" or at == "bytes":
            return ("(tycho_str_cmp(" + a + ", " + b + ") " + op + " 0)", "bool")
        a, b = _widen(a, at, b, bt)
        return ("(" + a + " " + op + " " + b + ")", "bool")
    # Element-wise array arithmetic, and the scalar BROADCAST form. Shape read
    # from `./tychoc tests/array_arith.ty --emit-c`: a fresh result array in the
    # current arena, filled by one loop, with a length guard on the two-array
    # form. Placed before the scalar operators so `a * b` on arrays never falls
    # through to a C `*` on two structs.
    if op == "*" or op == "/" or op == "%" or op == "+" or op == "-":
        ewa := _is_arr(at)
        ewb := _is_arr(bt)
        if ewa or ewb:
            et := at
            if ewa:
                et = _elem(at)
            else:
                et = _elem(bt)
            ct := ""
            if ewa:
                ct = _cty(&cs, at)
            else:
                ct = _cty(&cs, bt)
            ce := _cty(&cs, et)
            va := _fresh(&cs, "_ewa")
            vb := _fresh(&cs, "_ewb")
            vr := _fresh(&cs, "_ewr")
            vi := _fresh(&cs, "_ewi")
            hd := ""
            ln := ""
            lhs := ""
            rhs := ""
            if ewa and ewb:
                hd = ct + " " + va + " = (" + a + "); " + ct + " " + vb + " = (" + b + ");\n" +
                    "   if (" + va + ".len != " + vb + ".len) tycho_ew_len(" + va + ".len, " + vb + ".len);\n"
                ln = va + ".len"
                lhs = va + ".data[" + vi + "]"
                rhs = vb + ".data[" + vi + "]"
            elif ewa:
                hd = ct + " " + va + " = (" + a + "); " + ce + " " + vb + " = (" + b + ");\n"
                ln = va + ".len"
                lhs = va + ".data[" + vi + "]"
                rhs = vb
            else:
                hd = ce + " " + va + " = (" + a + "); " + ct + " " + vb + " = (" + b + ");\n"
                ln = vb + ".len"
                lhs = va
                rhs = vb + ".data[" + vi + "]"
            rt2 := "[" + et + "]"
            return ("({ " + hd +
                "   " + ct + " " + vr + "; " + vr + ".len = " + ln + "; " + vr + ".cap = " + ln + ";\n" +
                "   " + vr + ".data = " + vr + ".len ? (" + ce + " *)arena_alloc(" + cs.arena +
                ", (size_t)" + vr + ".len * sizeof(" + ce + " )) : 0;\n" +
                "   for (tycho_int " + vi + " = 0; " + vi + " < " + vr + ".len; " + vi + "++) " +
                vr + ".data[" + vi + "] = (" + lhs + " " + op + " " + rhs + ");\n" +
                "   " + vr + "; })", rt2)
    if op == "+" and (at == "string" or at == "bytes"):
        if bt == "char":
            return ("tycho_str_concat_char(" + cs.arena + ", " + a + ", " + b + ")", "string")
        # FLATTEN a chain: `w + x + y + z` parses left-nested, so each `+` would
        # allocate an intermediate and re-copy the whole growing prefix -- O(n^2)
        # bytes for n pieces. The runtime already carries concat3..concat6 (one
        # allocation, one copy per piece) and ./tychoc emits 654 of them
        # compiling compiler/main.ty where tychoc1 emitted none.
        for k := 5; k >= 2; k -= 1:
            nm := "tycho_str_concat"
            if k > 2:
                nm = nm + str(k)
            pre := nm + "(" + cs.arena + ", "
            if strings.starts_with(a, pre) and _one_call(a):
                return ("tycho_str_concat" + str(k + 1) + "(" + cs.arena + ", " +
                    a[len(pre):len(a) - 1] + ", " + b + ")", "string")
        return ("tycho_str_concat(" + cs.arena + ", " + a + ", " + b + ")", "string")
    if op == "/" and at == "int" and bt == "int":
        return ("tycho_idiv(" + a + ", " + b + ")", "int")
    if op == "%" and at == "int" and bt == "int":
        return ("tycho_imod(" + a + ", " + b + ")", "int")
    if op == "+" or op == "-" or op == "*" or op == "/" or op == "%":
        rt := _num2(at, bt)
        a, b = _widen(a, at, b, bt)
        if rt == "char":
            # char is one byte, so its arithmetic stays 0..255 -- src/tychoc.c:10709
            return ("((tycho_int)(unsigned char)((" + a + " " + op + " " + b + ")))", rt)
        if _is_sized(rt):
            return ("(" + _cty(&cs, rt) + ")((" + a + " " + op + " " + b + "))", rt)
        return ("(" + a + " " + op + " " + b + ")", rt)
    if op == "<<" or op == ">>":
        # A count >= the operand's width is 0 and a negative one aborts, neither
        # of which C gives -- runtime/tycho_rt.c:317 onwards owns both.
        st := "int"
        if _is_sized(at):
            st = at
        f := "tycho_shl_i"
        if op == ">>":
            f = "tycho_shr_i"
        if st == "u32" or st == "u64":
            f = "tycho_shl_" + st
            if op == ">>":
                f = "tycho_shr_" + st
            return (f + "(" + a + ", " + b + ")", st)
        if _is_sized(st):
            sg := "0"
            if _is_sint(st):
                sg = "1"
            if op == "<<":
                return ("(" + _cty(&cs, st) + ")(tycho_shln(" + a + ", " + b + ", " + str(_width(st)) + "))", st)
            return ("(" + _cty(&cs, st) + ")(tycho_shrn(" + a + ", " + b + ", " + str(_width(st)) + ", " + sg + "))", st)
        return (f + "(" + a + ", " + b + ")", "int")
    if op == "&" or op == "|" or op == "^":
        bt2 := "int"
        if _is_sized(at):
            bt2 = at
        elif _is_sized(bt):
            bt2 = bt
        if _is_sized(bt2):
            return ("(" + _cty(&cs, bt2) + ")((" + a + " " + op + " " + b + "))", bt2)
        return ("(" + a + " " + op + " " + b + ")", "int")
    _bad("unsupported operator '" + op + "'")
    return ("", "")

# src/tychoc.c widens an int operand in a float context at TYPECHECK time, so an
# int LITERAL reaches codegen already a float and prints as `0.0`, never as a cast.
fn _tofloat(c: string) -> string:
    n := len(c)
    if n > 2 and c[n - 2] == 76 and c[n - 1] == 76:
        ok := n > 2
        for i := 0; i < n - 2; i += 1:
            d := c[i]
            if d == 45 and i == 0:
                continue
            if d < 48 or d > 57:
                ok = false
        if ok:
            return c[0:n - 2] + ".0"
    return "(double)(" + c + ")"

fn _widen(a: string, at: string, b: string, bt: string) -> (string, string):
    if at == "float" and bt != "float":
        return (a, _tofloat(b))
    if bt == "float" and at != "float":
        return (_tofloat(a), b)
    return (a, b)

# --- calls ------------------------------------------------------------------

fn _call(cs: inout C, l: int, q: string, n: string, tas: [ast.Ty], args: [ast.Expr]) -> (string, string):
    if len(q) > 0:
        # `m.get(k)` lexes as a qualifier-dot-name call; a local of map type
        # named `m` is the map-read, not a package.
        qt := _vtype(&cs, q)
        if n == "get" and _is_map(qt):
            return _mapget(&cs, _vcname(&cs, q), qt, args)
        if _is_struct(qt):
            si3 := _sidx(&cs, _tname(qt))
            for j := 0; j < len(cs.sds[si3].fnames); j += 1:
                if cs.sds[si3].fnames[j] == n and _is_fn(cs.sds[si3].ftypes[j]):
                    kk2 := []ast.Expr
                    push(kk2, ast.Field(l, [ast.Name(l, q)], n))
                    for a in args:
                        push(kk2, a)
                    return _callval(&cs, kk2)
        if len(qt) > 0:
            # UFCS: `x.f(a)` on a local value is `f(x, a)`.
            ua := []ast.Expr
            push(ua, ast.Name(l, q))
            for a in args:
                push(ua, a)
            # `g.edge(1)` where edge is a subscript inlines to its yielded place.
            sxi := _subidx(&cs, n)
            if sxi >= 0:
                return _subinline(&cs, sxi, ua, false)
            return _call(&cs, l, "", _ufcs_name(&cs, n, qt), tas, ua)
        if _ispkg(&cs, q):
            qv := _qvariant(&cs, _qpfx(&cs, q), n)
            if qv >= 0:
                return _variant(&cs, qv, n, args)
            return _call(&cs, l, "", _qpfx(&cs, q) + n, tas, args)
        _bad("package-qualified call '" + q + "." + n + "' -- Phase 8")
    if _is_fn(_vtype(&cs, n)):
        # `f(5)` where f is a LOCAL of fn type: the parser cannot tell this from
        # a named call, so the local wins here exactly as it does for a map.
        kk := []ast.Expr
        push(kk, ast.Name(l, n))
        for a in args:
            push(kk, a)
        return _callval(&cs, kk)
    ta := []string
    for t in tas:
        push(ta, _ty(&cs, t))
    if n == "zero" and len(ta) == 1 and len(args) == 0:
        return (_zero(&cs, ta[0]), ta[0])
    gfi := _gfidx(&cs, n)
    if gfi >= 0:
        tps := cs.gf[gfi].typarams
        bs := ta
        if len(bs) < len(tps):
            bs = _blank(len(tps))
            for j := 0; j < len(ta); j += 1:
                bs[j] = ta[j]
            ats := _argtypes(&cs, args)
            for j := 0; j < len(cs.gf[gfi].params) and j < len(ats); j += 1:
                if len(cs.gf[gfi].params[j].ty) > 0:
                    aj := ats[j]
                    # `f(xs...)` at a `...$T` parameter binds $T to the
                    # ELEMENT, not to the array the spread names.
                    if cs.gf[gfi].params[j].is_variadic and (args[j] is ast.Spread) and _is_arr(aj):
                        aj = _elem(aj)
                    _unify(&cs, cs.gf[gfi].params[j].ty[0], aj, tps, &bs)
        for j := 0; j < len(bs); j += 1:
            if len(bs[j]) == 0:
                _bad("cannot infer '$" + tps[j] + "' at a call to '" + n + "'")
        fj := _inst_fn(&cs, n, bs)
        return _call(&cs, l, "", cs.fds[fj].name, []ast.Ty, args)
    gsi := _gsidx(&cs, n)
    if gsi >= 0:
        tps2 := cs.gs[gsi].typarams
        bs2 := ta
        if len(bs2) < len(tps2):
            bs2 = _blank(len(tps2))
            for j := 0; j < len(ta); j += 1:
                bs2[j] = ta[j]
            if _is_struct(cs.want) and _inst_base(&cs, _tname(cs.want)) == n:
                wa := _inst_of(&cs, _tname(cs.want))
                for j := 0; j < len(bs2) and j < len(wa); j += 1:
                    if len(bs2[j]) == 0:
                        bs2[j] = wa[j]
            ats2 := _argtypes(&cs, _reorder(&cs, _fieldnames(&cs, gsi), args, n))
            for j := 0; j < len(cs.gs[gsi].fields) and j < len(ats2); j += 1:
                _unify(&cs, cs.gs[gsi].fields[j].ty, ats2[j], tps2, &bs2)
        for j := 0; j < len(bs2); j += 1:
            if len(bs2[j]) == 0:
                _bad("cannot infer '$" + tps2[j] + "' constructing '" + n + "'")
        it := _inst_struct(&cs, n, bs2)
        return _call(&cs, l, "", _tname(it), []ast.Ty, args)
    gei := _geidx(&cs, n)
    if gei >= 0:
        _bad("a generic enum is named by a variant, not by the enum")
    ni := _ntidx(&cs, n)
    if ni >= 0:
        if len(args) != 1:
            _bad("newtype " + n + " takes exactly one value")
        ac, at := _ex(&cs, args[0])
        u := cs.ntu[ni]
        if u == "float" and at == "int":
            ac = "(double)(" + ac + ")"
        return (ac, u)
    ei := _bare_variant(&cs, n)
    if ei >= 0:
        return _variant(&cs, ei, n, args)
    gv := _gen_variant(&cs, n, ta, args)
    if len(gv) > 0:
        return _variant(&cs, _eidx(&cs, _tname(gv)), n, args)
    si := _sidx(&cs, n)
    if si >= 0:
        sn := cs.sds[si].name
        args = _reorder(&cs, cs.sds[si].fnames, args, n)
        if len(args) != len(cs.sds[si].ftypes):
            _bad("struct " + n + " takes " + str(len(cs.sds[si].ftypes)) + " field(s)")
        out := "((S_" + sn + "){ "
        for i := 0; i < len(args); i += 1:
            ft := cs.sds[si].ftypes[i]
            sw := cs.want
            cs.want = ft
            # The field is built in cs.arena, not always &_scope: the copy
            # decision below already reads cs.arena, and a struct built in
            # _parent whose array field was built in &_scope holds a pointer
            # into an arena that is freed on the way out.
            # Both arms are cs.arena now: forcing &_scope here overrode the
            # scratch a push had already selected for its value, so every
            # field of a per-iteration struct outlived the iteration
            # (bench/structarr_build.ty).
            ac, at := _ex(&cs, args[i])
            cs.want = sw
            if _place(args[i]) and _heap(&cs, ft) and not _shares(&cs, args[i], ft, cs.arena) and
                    not _canmove(&cs, args[i], cs.arena):
                ac = _copy(&cs, ac, ft, cs.arena)
            if i > 0:
                out = out + ", "
            out = out + ac
        return (out + " })", "S~" + sn)
    if len(tas) > 0:
        _bad("explicit type arguments -- Phase 8")
    fi := _fidx(&cs, n)
    if fi >= 0 and not _shadowable(n):
        np := len(cs.fds[fi].ptypes)
        args = _reorder(&cs, cs.fds[fi].pnames, args, n)
        if cs.fds[fi].pvar:
            if len(args) < np - 1:
                _bad("'" + n + "' takes at least " + str(np - 1) + " argument(s)")
        else:
            if len(args) != np:
                _bad("'" + n + "' takes " + str(np) + " argument(s)")
        # A callee whose RESULT is not heap puts nothing in the arena it is
        # handed, so the caller's own _parent serves and the statement scratch
        # (&_t) stays unmentioned -- which is what lets _uses_t elide it.
        pa := cs.arena
        sarg := cs.arena
        if not _heap(&cs, cs.fds[fi].ret):
            pa = "_parent"
            # ...but inside a loop _parent is the caller's own arena and lives for
            # the whole call, so a transient built for this callee survives every
            # iteration. Hand it the innermost scratch, as src/tychoc.c does
            # (bench/heap_transient.ty retained all 400 trees).
            if len(cs.ascope) > 0:
                pa = _curown(&cs)
                cs.arena = pa
        out2 := "h_" + cs.fds[fi].name + "(" + pa
        xtn := _isext(&cs, cs.fds[fi].name)
        if xtn:
            out2 = cs.fds[fi].name + "(@"
        for i := 0; i < np; i += 1:
            pt := cs.fds[fi].ptypes[i]
            if cs.fds[fi].pvar and i == np - 1:
                out2 = out2 + ", " + _pack(&cs, _elem(pt), args, i)
                continue
            if cs.fds[fi].pinout[i]:
                out2 = out2 + ", " + _addr_of(&cs, args[i])
                if _heap(&cs, pt):
                    out2 = out2 + ", " + _ownerof(&cs, args[i])
                continue
            sw := cs.want
            cs.want = pt
            ac, at := _ex(&cs, args[i])
            cs.want = sw
            if pt == "float" and at == "int":
                ac = "(double)(" + ac + ")"
            # An extern's `bytes` PARAMETER crosses as two C arguments -- the
            # data pointer and its length -- exactly as a `bytes` RETURN crosses
            # as two out-parameters. Passing it as one `char *` put the NEXT
            # argument in the length slot, and iox_write_bytes then wrote
            # through a bogus status pointer: SIGSEGV in core:io and core:os.
            if xtn and _is_arr(pt):
                xa := _fresh(&cs, "_xa")
                cast9 := "(const " + _ctyz(&cs, _elem(pt)) + "*)"
                if _elem(pt) == "string":
                    cast9 = "(const char *const *)"
                out2 = out2 + ", ({ " + _ctyz(&cs, pt) + "" + xa + " = " + ac + "; " +
                    cast9 + xa + ".data; })" + ", ({ " + _ctyz(&cs, pt) + "" + xa +
                    "b = " + ac + "; " + xa + "b.len; })"
                continue
            if xtn and pt == "bytes":
                xb := _fresh(&cs, "_xb")
                out2 = out2 + ", ({ char *" + xb + " = " + ac +
                    "; (const unsigned char *)" + xb + "; })" +
                    ", tycho_str_len(" + ac + ")"
                continue
            # NO COPY passing an ARRAY or MAP down. runtime/tycho_rt.c's header states the
            # model: an argument is a pointer into the caller's arena and the
            # callee's arena is a CHILD, so the value outlives the call. The
            # copy here made every `_k(toks, i)` clone the whole token array --
            # 42,626 elements per call, quadratic, and the reason gen-2 could
            # not compile the compiler. Anything that RETAINS a value past the
            # call copies at that point instead (see `push`).
            # NO COPY for ANY heap value passed down, strings included: the
            # callee's arena is a CHILD, so the argument outlives the call, and
            # whatever RETAINS it copies at the retention point. Copying strings
            # here deep-copied core:json's 3.5 MB document on every one of
            # 50,000 parse_value calls -- 5.7 GiB live, and the benchmark died.
            # ...but a `sink` parameter is the exception: the callee OWNS it and
            # may mutate it in place, so it must NOT alias the caller's value
            # (src/tychoc.c@sink_arg_into). A place that cannot be adopted is
            # copied; a fresh value already owns its bytes.
            if cs.fds[fi].psink[i] and _heap(&cs, pt) and _place(args[i]) and
                    not _canmove_sink(&cs, args[i]):
                ac = _copy(&cs, ac, pt, "&_scope")
            out2 = out2 + ", " + ac
        cs.arena = sarg
        if xtn:
            # drop the separator the arena would have needed
            out2 = strings.replace(out2, "(@, ", "(")
            out2 = strings.replace(out2, "(@", "(")
            if cs.fds[fi].ret == "string":
                # A C `char *` is NOT a tycho string: tycho's carries its length
                # in the 8 bytes BEFORE the buffer, so using the raw pointer read
                # whatever sat there as the length (garbage, then SIGSEGV in
                # core:os). NULL becomes "".
                xs9 := _fresh(&cs, "_x")
                return ("tycho_str_from_c(" + cs.arena + ", ({ const char *" + xs9 +
                    " = " + out2 + "); " + xs9 + " ? " + xs9 + " : \"\"; }))", "string")
            if _is_optT(&cs, cs.fds[fi].ret) and _opt_inner(&cs, cs.fds[fi].ret) == "string":
                # NULL is None; anything else is Some(str). The wrap mirrors
                # ./tychoc's, in this compiler's enum representation.
                ot := cs.fds[fi].ret
                oi := _eidx(&cs, _tname(ot))
                en := cs.eds[oi].name
                xv := _fresh(&cs, "_x")
                ov2 := _fresh(&cs, "_ov")
                return ("({ const char *" + xv + " = " + out2 + "); E_" + en + " *" + ov2 +
                    " = &_sing_" + en + "_" + str(_tag(&cs, oi, "None")) + "; if (" + xv + ") { " +
                    # cs.arena, NOT &_scope: this is a RETURN value in io.read_line,
                    # and _scope is freed on the same line. Three consecutive reads
                    # then aliased one recycled block -- line1 printed "two" and the
                    # third read found a garbage tag ("non-exhaustive match").
                    ov2 + " = (E_" + en + " *)arena_alloc(" + cs.arena + ", offsetof(E_" + en +
                    ", u) + sizeof(E_" + en + "_Some)); " + ov2 + "->tag = " +
                    str(_tag(&cs, oi, "Some")) + "; " + ov2 + "->u.Some.f0 = tycho_str_from_c(" +
                    cs.arena + ", " + xv + "); } " + ov2 + "; })", ot)
            # An ARRAY return crosses as two out-parameters, exactly as `bytes`
            # does below: `[int] f()` is `void f(tycho_int **out, tycho_int *len)`.
            # tychoc1 emitted the call with NEITHER, so the C function wrote
            # *out and *len through whatever the registers held -- ASan reported
            # allocation-size-too-big in ffi_iota (tests/ffi).
            if _is_arr(cs.fds[fi].ret) and (_elem(cs.fds[fi].ret) == "int" or
                    _elem(cs.fds[fi].ret) == "float"):
                aet := _elem(cs.fds[fi].ret)
                aov := _fresh(&cs, "_o")
                aol := _fresh(&cs, "_ol")
                sep3 := ", "
                if strings.ends_with(out2, "("):
                    sep3 = ""
                return ("({ " + _ctyz(&cs, aet) + "*" + aov + " = 0; tycho_int " + aol +
                    " = 0; " + out2 + sep3 + "&" + aov + ", &" + aol + "); " +
                    _arrf(&cs, aet, "_from_c") + "(" + cs.arena + ", " + aov + ", " +
                    aol + "); })", cs.fds[fi].ret)
            if cs.fds[fi].ret == "bytes":
                ov := _fresh(&cs, "_o")
                ol := _fresh(&cs, "_ol")
                sep2 := ", "
                if strings.ends_with(out2, "("):
                    sep2 = ""
                return ("({ unsigned char *" + ov + " = 0; tycho_int " + ol + " = 0; " +
                    out2 + sep2 + "&" + ov + ", &" + ol + "); tycho_bytes_from_c(" +
                    cs.arena + ", " + ov + ", " + ol + "); })", "bytes")
        return (out2 + ")", cs.fds[fi].ret)
    return _builtin(&cs, n, args)

# An `inout` argument is written `&place` at the call and is a pointer in the
# ABI, so the place is taken as an lvalue rather than read.
# A variant name that belongs to a GENERIC enum template: the instance is the
# wanted type when there is one, otherwise it is inferred from the payload.
fn _gen_variant(cs: inout C, n: string, ta: [string], args: [ast.Expr]) -> string:
    for gi := 0; gi < len(cs.ge); gi += 1:
        vi := -1
        for j := 0; j < len(cs.ge[gi].variants); j += 1:
            if cs.ge[gi].variants[j].name == n:
                vi = j
        if vi < 0:
            continue
        tps := cs.ge[gi].typarams
        if _is_enum(cs.want) and _inst_base(&cs, _tname(cs.want)) == cs.ge[gi].name:
            return cs.want
        bs := _blank(len(tps))
        for j := 0; j < len(ta) and j < len(bs); j += 1:
            bs[j] = ta[j]
        ats := _argtypes(&cs, args)
        pl := cs.ge[gi].variants[vi].payload
        for j := 0; j < len(pl) and j < len(ats); j += 1:
            _unify(&cs, pl[j], ats[j], tps, &bs)
        ok := true
        for j := 0; j < len(bs); j += 1:
            if len(bs[j]) == 0:
                ok = false
        if not ok:
            continue
        return _inst_enum(&cs, cs.ge[gi].name, bs)
    return ""

fn _fieldnames(cs: inout C, gi: int) -> [string]:
    out := []string
    for f in cs.gs[gi].fields:
        push(out, f.name)
    return out

# The concrete type of each argument, computed by walking it with no `want`.
# The walk is pure string building, so doing it again for the real emission
# costs only temp numbers.
fn _argtypes(cs: inout C, args: [ast.Expr]) -> [string]:
    out := []string
    sw := cs.want
    cs.want = ""
    for a in args:
        match a:
            ast.NoneE(l): push(out, "")
            ast.OkE(l, k): push(out, "")
            ast.ErrE(l, k): push(out, "")
            ast.EmptyArr(l, ts):
                if len(ts) == 0:
                    push(out, "")
                else:
                    ac, at := _ex(&cs, a)
                    push(out, at)
            ast.Named(l, nm, k):
                ac2, at2 := _ex(&cs, k[0])
                push(out, at2)
            _:
                ac3, at3 := _ex(&cs, a)
                push(out, at3)
    cs.want = sw
    return out

fn _addr_of(cs: inout C, e: ast.Expr) -> string:
    match e:
        ast.Addr(l, k):
            lc, lt := _lvalue(&cs, k[0])
            return "&(" + lc + ")"
        _:
            lc2, lt2 := _lvalue(&cs, e)
            return "&(" + lc2 + ")"
    return ""

# A variadic tail is packed into a fresh array; `xs...` passes one through.
fn _pack(cs: inout C, et: string, args: [ast.Expr], from: int) -> string:
    if len(args) == from + 1:
        match args[from]:
            ast.Spread(l, k):
                sc, st := _ex(&cs, k[0])
                return sc
            _: pass
    v := _fresh(&cs, "_va")
    n := len(args) - from
    out := "({ " + _ctyz(&cs, "[" + et + "]") + "" + v + " = " + _arrf(&cs, et, "_with_cap") +
        "(&_scope, " + str(n) + "LL); "
    for i := from; i < len(args); i += 1:
        sw := cs.want
        cs.want = et
        ac, at := _ex_scope(&cs, args[i])
        cs.want = sw
        if et == "float" and at == "int":
            ac = "(double)(" + ac + ")"
        if _place(args[i]) and _heap(&cs, et) and not _canmove(&cs, args[i], "&_scope"):
            ac = _copy(&cs, ac, et, "&_scope")
        out = out + v + ".data[" + str(i - from) + "] = " + ac + "; "
    return out + v + ".len = " + str(n) + "LL; " + v + "; })"

# A `name: value` argument is positional once the declared names are known.
fn _reorder(cs: inout C, names: [string], args: [ast.Expr], who: string) -> [ast.Expr]:
    any := false
    for a in args:
        match a:
            ast.Named(l, n, k): any = true
            _: pass
    if not any:
        return args
    out := []ast.Expr
    for i := 0; i < len(names); i += 1:
        push(out, ast.NullLit(0))
    seen := []bool
    for i := 0; i < len(names); i += 1:
        push(seen, false)
    for i := 0; i < len(args); i += 1:
        match args[i]:
            ast.Named(l, n, k):
                j := -1
                for q := 0; q < len(names); q += 1:
                    if names[q] == n:
                        j = q
                if j < 0:
                    _bad("'" + who + "' has no parameter named '" + n + "'")
                out[j] = k[0]
                seen[j] = true
            _:
                out[i] = args[i]
                seen[i] = true
    for i := 0; i < len(names); i += 1:
        if not seen[i]:
            _bad("'" + who + "' is missing an argument for '" + names[i] + "'")
    return out

fn _shadowable(n: string) -> bool:
    return n == "str" or n == "len" or n == "print" or n == "println" or n == "eprint" or
        n == "die" or n == "exit" or n == "push" or n == "pop" or n == "reserve" or
        n == "chr" or n == "to_char" or n == "char_at" or n == "to_int" or
        n == "to_float" or n == "sqrt" or n == "find" or n == "split" or
        n == "substr" or n == "input" or n == "read_all" or n == "clock" or n == "hash" or
        n == "fabs" or n == "list_dir" or n == "getenv"

# push/pop/reserve MUTATE their first argument, so it has to be reached as a
# place: `push(m["g"], 3)` on a map element is the map's value slot, not the
# copy a read would hand back.
fn _target(cs: inout C, e: ast.Expr) -> (string, string):
    if _place(e):
        return _lvalue(&cs, e)
    return _ex(&cs, e)

fn _builtin(cs: inout C, n: string, args: [ast.Expr]) -> (string, string):
    if n == "str" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return (_tostr(&cs, c, t), "string")
    if n == "len" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        if t == "string" or t == "bytes":
            return ("tycho_str_len(" + c + ")", "int")
        if _is_arr(t) or _is_map(t) or _is_soa(t):
            return ("((" + c + ").len)", "int")
        _bad("len() of unsupported type '" + t + "'")
    if n == "print" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("tycho_print_s(" + c + ")", "void")
    if n == "println" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("(tycho_print_s(" + c + "), tycho_print(\"\\n\"))", "void")
    if n == "eprint" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("tycho_eprint(" + c + ")", "void")
    if n == "die" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("tycho_die(" + c + ")", "void")
    if n == "exit" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("exit((int)(" + c + "))", "void")
    if n == "push" and len(args) == 2:
        rc, rt := _target(&cs, args[0])
        # The value is emitted under the target's ELEMENT type, so a bare
        # `None`/`Ok` in `push(xs, None)` knows which Option/Result it belongs
        # to. Without it the element type is only discoverable from the value,
        # which a bare None does not carry.
        swp := cs.want
        if _is_arr(rt):
            cs.want = _elem(rt)
        elif _is_soa(rt):
            cs.want = _selem(&cs, rt)
        # Only when the ARRAY itself lives in the innermost scratch: pushing a
        # scratch-built value into a longer-lived array leaves it dangling at
        # the next arena_reset, and _shares cannot see that (examples/json.ty
        # read ["arena","arena"] for ["systems","arena"]).
        # Build the pushed value in the ARRAY'S OWN arena, not in &_scope. The
        # two die together, so it cannot dangle at a reset the way a
        # scratch-built value pushed into a longer-lived array did
        # (examples/json.ty read ["arena","arena"] for ["systems","arena"]),
        # and it is strictly tighter than the function arena: prongB dispatch
        # built 2000x2000 closure envs in &_scope and freed none until main
        # returned.
        va := _ownerof(&cs, args[0])
        vc := ""
        vt := ""
        if va == _curown(&cs):
            vc, vt = _ex_cur(&cs, args[1])
        else:
            sav3 := cs.arena
            cs.arena = va
            vc, vt = _ex(&cs, args[1])
            cs.arena = sav3
        cs.want = swp
        if strings.starts_with(rt, "?A"):
            pi := strings.parse_int(rt[2:])
            rt = "[" + vt + "]"
            cs.ptv[pi] = rt
            _vset(&cs, _rootname(args[0]), rt)
        if _is_soa(rt):
            return (_spfx(&cs, rt) + "_push(" + _ownerof(&cs, args[0]) + ", &(" + rc +
                "), " + vc + ")", "void")
        if not _is_arr(rt):
            _bad("push() on a non-array")
        cap9 := _cap_of_target(&cs, args[0])
        et := _elem(rt)
        if et == "float" and vt == "int":
            vc = "(double)(" + vc + ")"
        ow := _ownerof(&cs, args[0])
        # A CONSTRUCTED value needs the copy as much as a place does: its
        # interior strings/arrays were allocated in the caller's temporary
        # scope, and pushing the struct by value leaves them dangling once that
        # scope is reused. Observed in the self-compile as an FD whose `name`
        # pointed into generated C text.
        # ...but only when the value is NOT already whole in that same arena.
        # _ex_scope built it in &_scope, so a constructed value pushed into an
        # array that also lives there is already where it belongs; a place is
        # still somebody else's and copies. Narrow on purpose: evaluating the
        # value in `ow` instead reddened 190 fixtures.
        # A value the expression built in `va` is already whole there, so a
        # push into an array owned by the SAME arena needs nothing; the q
        # defect this once guarded against was upstream, at the declaration.
        if _heap(&cs, et) and (_place(args[1]) or ow != va) and
                not _shares(&cs, args[1], et, ow):
            vc = _copy(&cs, vc, et, ow)
        fi9 := -1
        match args[0]:
            ast.Name(l9, n9): fi9 = _fuse_idx(&cs, n9)
            _: pass
        if fi9 >= 0 and cap9 == 0:
            fdn := cs.fuid[fi9]
            # tycho_arr_str_push COPIES the bytes into the owner arena on its way
            # in; the other push families store the value as given. Writing
            # `fd[l++] = v` raw drops that copy, so a string built in the loop
            # scratch was stored by pointer and dangled at the next reset --
            # corelib zip, tycho-ledger and tycho-snap, all string pushes.
            if _apfx(&cs, et) == "tycho_arr_str":
                vc = "tycho_str_copy(" + ow + ", " + vc + ")"
            return ("({ if (" + fdn + "l == " + fdn + "c) " + _arrf(&cs, et, "_grow") +
                "(" + ow + ", &" + fdn + ", &" + fdn + "c, " + fdn + "l); " +
                fdn + "[" + fdn + "l++] = " + vc + "; })", "void")
        pc9 := _arrf(&cs, et, "_push") + "(" + ow + ", &(" + rc + "), " + vc + ")"
        if cap9 > 0:
            # the capacity trap: a bounded array refuses the push that would
            # exceed its declared N (src/tychoc.c's per-capacity push helper)
            pc9 = "({ if ((" + rc + ").len >= " + str(cap9) + "LL) { " +
                "fprintf(stderr, \"tycho: push to a full bounded[" + str(cap9) + "]\\n\"); exit(1); } " +
                pc9 + "; })"
        return (pc9, "void")
    if n == "pop" and len(args) == 1:
        rc, rt := _target(&cs, args[0])
        if _is_soa(rt):
            return (_spfx(&cs, rt) + "_pop(&(" + rc + "))", _selem(&cs, rt))
        if not _is_arr(rt):
            _bad("pop() on a non-array")
        et := _elem(rt)
        return (_arrf(&cs, et, "_pop") + "(" + _ownerof(&cs, args[0]) + ", &(" + rc + "))", et)
    if n == "keys" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        if not _is_map(t):
            _bad("keys() takes a map")
        kt := _mkey(&cs, t)
        return (_mpfx(&cs, t) + "_keys(" + cs.arena + ", " + c + ")", "[" + kt + "]")
    if n == "reserve" and len(args) == 2:
        rc, rt := _target(&cs, args[0])
        vc, vt := _ex(&cs, args[1])
        ow2 := _ownerof(&cs, args[0])
        if _is_map(rt):
            return (_mpfx(&cs, rt) + "_reserve(" + ow2 + ", &(" + rc + "), " + vc + ")", "void")
        if not _is_arr(rt):
            _bad("reserve() on a non-array")
        return (_arrf(&cs, _elem(rt), "_reserve") + "(" + ow2 + ", &(" + rc + "), " + vc + ")", "void")
    if n == "chr" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("tycho_chr(" + cs.arena + ", " + c + ")", "string")
    if n == "to_char" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("((tycho_int)(unsigned char)tycho_chr(" + cs.arena + ", " + c + ")[0])", "char")
    if n == "char_at" and len(args) == 2:
        c, t := _ex(&cs, args[0])
        ic, it := _ex(&cs, args[1])
        return ("tycho_str_get(" + c + ", " + ic + ")", "char")
    if (n == "to_under" or n == "to_str" or n == "to_bool") and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return (c, t)
    if n == "to_int" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        if t == "float" or t == "f32":
            return ("tycho_f2i(" + c + ")", "int")
        return ("((tycho_int)" + c + ")", "int")
    if len(n) > 3 and n[0:3] == "to_" and _is_sized(n[3:]) and len(args) == 1:
        c, t := _ex(&cs, args[0])
        w := n[3:]
        if t == "float" or t == "f32":
            if w == "f32":
                return ("((float)(" + c + "))", "f32")
            return ("((" + _cty(&cs, w) + ")tycho_f2i(" + c + "))", w)
        return ("((" + _cty(&cs, w) + ")(" + c + "))", w)
    if n == "to_bytes" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        if _is_arr(t):
            # [int] -> bytes is a real conversion (each element & 0xFF);
            # string -> bytes is the same buffer -- src/tychoc.c:10618
            return ("tycho_bytes_from_intarr(" + cs.arena + ", " + c + ")", "bytes")
        return (c, "bytes")
    if n == "to_float" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("((double)(" + c + "))", "float")
    if n == "sqrt" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("sqrt(" + c + ")", "float")
    if n == "floor" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("floor(" + c + ")", "float")
    # The two FFI escapes: an opaque handle's NULL test, and an int used as a
    # sentinel pointer (SQLITE_TRANSIENT is (void*)-1).
    if n == "is_null" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("((" + c + ") == 0)", "bool")
    if n == "to_ptr" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("((void*)(tycho_int)(" + c + "))", "ptr")
    if n == "fabs" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("fabs(" + c + ")", "float")
    if n == "list_dir" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("tycho_list_dir(" + cs.arena + ", " + c + ")", "[string]")
    if n == "getenv" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("tycho_getenv(" + cs.arena + ", " + c + ")", "string")
    if n == "find" and len(args) == 2:
        c, t := _ex(&cs, args[0])
        sc, st := _ex(&cs, args[1])
        return ("tycho_str_find(" + c + ", " + sc + ")", "int")
    if n == "split" and len(args) == 2:
        c, t := _ex(&cs, args[0])
        sc, st := _ex(&cs, args[1])
        return ("tycho_str_split(" + cs.arena + ", " + c + ", " + sc + ")", "[string]")
    if n == "substr" and len(args) == 3:
        c, t := _ex(&cs, args[0])
        ac, at := _ex(&cs, args[1])
        bc, bt := _ex(&cs, args[2])
        return ("tycho_str_substr(" + cs.arena + ", " + c + ", " + ac + ", " + bc + ")", "string")
    if n == "input" and len(args) == 0:
        return ("tycho_input(" + cs.arena + ")", "string")
    if n == "read_all" and len(args) == 0:
        return ("tycho_read_all(" + cs.arena + ")", "string")
    if n == "args" and len(args) == 0:
        return ("tycho_args(" + cs.arena + ")", "[string]")
    if n == "now" and len(args) == 0:
        return ("tycho_now()", "int")
    if n == "read_file" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("tycho_read_file(" + cs.arena + ", " + c + ")", "string")
    if n == "write_file" and len(args) == 2:
        c, t := _ex(&cs, args[0])
        d, dt := _ex(&cs, args[1])
        return ("tycho_write_file(" + c + ", " + d + ")", "int")
    if n == "send" and len(args) == 2:
        c, t := _ex(&cs, args[0])
        et := _cinner(t)
        sw := cs.want
        cs.want = et
        v, vt := _ex(&cs, args[1])
        cs.want = sw
        if et == "float" and vt == "int":
            v = "(double)(" + v + ")"
        return ("tycho_chan_send_" + str(_ckind(&cs, et)) + "(" + c + ", " + v + ")", "void")
    if n == "recv" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return _recv_expr(&cs, c, _cinner(t), "tycho_chan_recv_")
    if n == "try_recv" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return _recv_expr(&cs, c, _cinner(t), "tycho_chan_tryrecv_")
    if n == "close" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        if _is_chan(t):
            return ("tycho_chan_close(" + c + ")", "void")
        if _is_handle(t):
            # an explicit close runs the destructor NOW and clears the slot, so
            # the scope-exit finalizer does not run it twice
            fr := _hfree(&cs, t)
            return ("({ if (" + c + ") { " + fr + "(" + c + "); " + c + " = 0; } })", "void")
    if n == "wait" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        rt := _cinner(t)
        v := _fresh(&cs, "_tk")
        # A task BOUND to a name is finished at its scope's exit, so wait only
        # releases its arena; an unbound `wait(spawn f(x))` has no scope exit to
        # reach it, so wait frees the handle too (src/tychoc.c does both).
        rel := "tycho_task_free(" + v + ")"
        if args[0] is ast.Name:
            rel = "arena_free(&" + v + "->root)"
        if rt == "void":
            return ("({ HTask *" + v + " = " + c + "; tycho_task_join(" + v + "); " + rel + "; })", "void")
        w := _fresh(&cs, "_w")
        # the value lives in the TASK's arena, which is released here -- copy first
        val := _copy(&cs, "(*(" + _ctyz(&cs, rt) + "*)" + v + "->ret)", rt, cs.arena)
        return ("({ HTask *" + v + " = " + c + "; tycho_task_join(" + v + "); " +
            _ctyz(&cs, rt) + "" + w + " = " + val + "; " + rel + "; " + w + "; })", rt)
    if n == "hash" and len(args) == 1:
        c, t := _ex(&cs, args[0])
        return ("((tycho_int)(" + _hash_det(&cs, t, c) + "))", "int")
    if n == "ncpu" and len(args) == 0:
        return ("tycho_ncpu()", "int")
    if n == "clock" and len(args) == 0:
        return ("tycho_clock()", "int")
    _bad("unsupported call '" + n + "' with " + str(len(args)) + " argument(s)")
    return ("", "")

# --- places (assignment targets) --------------------------------------------

fn _lvalue(cs: inout C, e: ast.Expr) -> (string, string):
    match e:
        ast.Name(l, n):
            t := _vtype(&cs, n)
            if len(t) == 0:
                _bad("assignment to unknown name '" + n + "'")
            return (_vcname(&cs, n), t)
        ast.Field(l, r, f):
            # The scatter write `ps[i].x = v`. The projection is already a C
            # lvalue, so the read and write paths emit the same expression.
            match r[0]:
                ast.Index(l3, k3):
                    bc3, bt3 := _lvalue(&cs, k3[0])
                    if _is_soa(bt3):
                        ic4, it4 := _ex(&cs, k3[1])
                        return _soafld(&cs, bc3, bt3, ic4, f)
                _: pass
            rc, rt := _lvalue(&cs, r[0])
            si := _sidx(&cs, _tname(rt))
            if si < 0:
                _bad("field assignment on a non-struct")
            for i := 0; i < len(cs.sds[si].fnames); i += 1:
                if cs.sds[si].fnames[i] == f:
                    return ("((" + rc + ").f_" + f + ")", cs.sds[si].ftypes[i])
            _bad("no field '" + f + "' on " + _tname(rt))
        ast.TupIdx(l, k, n):
            rc, rt := _lvalue(&cs, k[0])
            if not _is_tup(rt):
                _bad("`.` assignment on a non-tuple")
            es := _telems(&cs, rt)
            return ("((" + rc + ").f" + str(n) + ")", es[n])
        ast.Index(l, k):
            rc, rt := _lvalue(&cs, k[0])
            ic, it := _ex(&cs, k[1])
            if _is_map(rt):
                vt := _mval(&cs, rt)
                return ("(*" + _mpfx(&cs, rt) + "_slotptr(" + _ownerof(&cs, k[0]) + ", &(" + rc + "), " +
                    _keyrt(&cs, _mkey(&cs, rt), ic) + "))", vt)
            if not _is_arr(rt):
                _bad("indexed assignment on a non-array")
            et := _elem(rt)
            if _in_range(&cs, k[0], k[1]):   # monotone loop index: project without the check
                return ("((" + rc + ").data[" + ic + "])", et)
            return ("(*" + _arrf(&cs, et, "_ptr") + "(&(" + rc + "), " + ic + "))", et)
        ast.Call(l, q, n, tas, args):
            # A subscript call IS a place: `g.edge(1).weight = 99` writes
            # through the projection, so the lvalue path inlines it too.
            sxl := _subidx(&cs, n)
            if sxl < 0:
                _bad("unsupported assignment target")
            ua2 := []ast.Expr
            if len(q) > 0:
                push(ua2, ast.Name(l, q))
            for a in args:
                push(ua2, a)
            return _subinline(&cs, sxl, ua2, true)
        ast.CallVal(l, k):
            sc2, st4, ok4 := _subcallval(&cs, k, true)
            if not ok4:
                _bad("unsupported assignment target")
            return (sc2, st4)
        _: _bad("unsupported assignment target")
    return ("", "")

# --- statements -------------------------------------------------------------

# --- move-on-last-use (deep-copy elision) -----------------------------------
#
# src/tychoc.c@can_move_from, and the read-count scan src/tychoc.c@count_reads_b.
# `b := a` / `b = a` normally deep-copies a heap value so the two are
# independent. If `a` is a uniquely-owned local whose ONLY read is this one, the
# copy is waste -- `b` takes over `a`'s buffer. The rule is conservative and
# static: the source is a bare variable of heap type; it is read exactly once in
# the whole function, so this read is its last use on every path INCLUDING loop
# back-edges; the move is not lexically inside a loop, so that one textual read
# is one dynamic read; and the source's arena equals the destination's, so the
# handed-off buffer's lifetime matches. A parameter borrows the caller's buffer
# and is never moved.

# --- bounds-check elision for monotone loop indices -------------------------
# src/tychoc.c:9351-9455. Inside `for i := 0; i < len(A); i += 1:` the access
# `A[i]` is provably in [0, len(A)): `len` is an un-redefinable builtin over the
# true length, Tycho has no in-place array-shrink op, and the body is verified
# below never to reassign or shadow A or i and never to pass A whole to a call
# (a possibly-`inout` callee, or `push`, could move the buffer). Every refusal
# is the reference's -- an index wrongly proved in range is an out-of-bounds
# read, not a slow program. Escape hatch: TYCHOC_NO_BOUNDS_ELISION=1.
# The one reference refusal NOT ported is IS_BOUNDED: src/tychoc.c keeps a
# bounded array in `.v`, where `.data[i]` would be wrong, while tychoc1 lowers
# `bounded[N]T` to the dynamic array (compiler/emit/emit.ty:1176) whose storage
# IS `.data`.
fn _elision_on() -> bool:
    return len(getenv("TYCHOC_NO_BOUNDS_ELISION")) == 0

# does `e` pass the whole array `arr` as a direct call argument?
fn _pass_l(es: [ast.Expr], arr: string) -> bool:
    for i := 0; i < len(es); i += 1:
        if _pass_e(es[i], arr):
            return true
    return false

fn _bare(es: [ast.Expr], arr: string) -> bool:
    for i := 0; i < len(es); i += 1:
        match es[i]:
            ast.Name(l, n):
                if n == arr:
                    return true
            _: pass
    return false

fn _pass_e(e: ast.Expr, arr: string) -> bool:
    match e:
        ast.Call(l, q, n, ts, k): return _bare(k, arr) or _pass_l(k, arr)
        ast.CallVal(l, k): return _bare(k, arr) or _pass_l(k, arr)
        ast.Field(l, k, f): return _pass_l(k, arr)
        ast.TupIdx(l, k, i): return _pass_l(k, arr)
        ast.Index(l, k): return _pass_l(k, arr)
        ast.Slice(l, a, b, k): return _pass_l(k, arr)
        ast.Named(l, n, k): return _pass_l(k, arr)
        ast.Binop(l, o, k): return _pass_l(k, arr)
        ast.Unop(l, o, k): return _pass_l(k, arr)
        ast.IsVar(l, k, q, n): return _pass_l(k, arr)
        ast.ArrLit(l, k): return _pass_l(k, arr)
        ast.MapLit(l, k): return _pass_l(k, arr)
        ast.Tuple(l, k): return _pass_l(k, arr)
        ast.SomeE(l, k): return _pass_l(k, arr)
        ast.OkE(l, k): return _pass_l(k, arr)
        ast.ErrE(l, k): return _pass_l(k, arr)
        ast.SpawnE(l, k): return _pass_l(k, arr)
        ast.OrRet(l, k): return _pass_l(k, arr)
        ast.Spread(l, k): return _pass_l(k, arr)
        ast.Addr(l, k): return _pass_l(k, arr)
        ast.ChanE(l, t, k): return _pass_l(k, arr)
        # a lambda body runs later and can call anything with what it captured;
        # a parameter of its own named iv or arr shadows, which the reference's
        # stmt_unsafe does not see and this refuses
        ast.Lambda(l, ps, r, b): return true
        _: return false
    return false

fn _uns_ns(ns: [string], iv: string, arr: string) -> bool:
    for i := 0; i < len(ns); i += 1:
        if ns[i] == iv or ns[i] == arr:
            return true
    return false

fn _uns_a(ar: [ast.Arm], iv: string, arr: string) -> bool:
    for i := 0; i < len(ar); i += 1:
        if _uns_ns(ar[i].binds, iv, arr) or _uns_ns(ar[i].subbinds, iv, arr):
            return true
        for j := 0; j < len(ar[i].pats); j += 1:
            if _uns_ns([ar[i].pats[j].loname, ar[i].pats[j].hiname], iv, arr):
                return true
        if _pass_l(ar[i].ch, arr) or _uns_b(ar[i].body, iv, arr):
            return true
    return false

# could this statement invalidate `arr[iv] in range`?
fn _uns_s(s: ast.Stmt, iv: string, arr: string) -> bool:
    match s:
        ast.ExprStmt(l, k): return _pass_l(k, arr)
        ast.Decl(l, n, t, r, v):
            return n == iv or n == arr or _pass_l(r, arr) or _uns_b(v, iv, arr)
        ast.MDecl(l, d, ns, r): return _uns_ns(ns, iv, arr) or _pass_l(r, arr)
        ast.Assign(l, n, r): return n == iv or n == arr or _pass_l(r, arr)
        ast.PlaceSet(l, k): return _pass_l(k, arr)
        ast.ConstS(l, n, k): return n == iv or n == arr or _pass_l(k, arr)
        ast.ReturnS(l, k): return _pass_l(k, arr)
        ast.IfS(l, c, b, e):
            return _pass_l(c, arr) or _uns_b(b, iv, arr) or _uns_b(e, iv, arr)
        ast.WhileS(l, c, b): return _pass_l(c, arr) or _uns_b(b, iv, arr)
        ast.For3(l, ip, c, b):
            return _uns_b(ip, iv, arr) or _pass_l(c, arr) or _uns_b(b, iv, arr)
        ast.ForIn(l, n, c, b):
            return n == iv or n == arr or _pass_l(c, arr) or _uns_b(b, iv, arr)
        ast.ForRange(l, n, c, b):
            return n == iv or n == arr or _pass_l(c, arr) or _uns_b(b, iv, arr)
        ast.ParallelS(l, w, b): return _pass_l(w, arr) or _uns_b(b, iv, arr)
        ast.MatchS(l, c, a): return _pass_l(c, arr) or _uns_a(a, iv, arr)
        ast.SelectS(l, a): return _uns_a(a, iv, arr)
        ast.DeleteS(l, k): return _pass_l(k, arr)
        _: return false
    return false

fn _uns_b(b: [ast.Stmt], iv: string, arr: string) -> bool:
    for i := 0; i < len(b); i += 1:
        if _uns_s(b[i], iv, arr):
            return true
    return false

# src/tychoc.c@for3_elidable_arr -- the loop variable and the array it indexes,
# or two empty strings. init `i := 0` with no value-if tail, cond `i < len(A)`,
# post exactly `i += 1`, and a body that survives _uns_b.
fn _for3_elide(ip: [ast.Stmt], c: [ast.Expr], b: [ast.Stmt]) -> (string, string):
    no := ("", "")
    if not _elision_on() or len(b) == 0:
        return no
    iv := ""
    match ip[0]:
        ast.Decl(l, n, t, r, v):
            if len(v) > 0 or len(r) != 1:
                return no
            match r[0]:
                ast.IntLit(l2, x):
                    if x != 0:
                        return no
                _: return no
            iv = n
        _: return no
    arr := ""
    match c[0]:
        ast.Binop(l, op, k):
            if op != "<" or len(k) != 2:
                return no
            match k[0]:
                ast.Name(l2, n2):
                    if n2 != iv:
                        return no
                _: return no
            match k[1]:
                ast.Call(l3, q, fnm, ts, args):
                    if len(q) > 0 or fnm != "len" or len(ts) > 0 or len(args) != 1:
                        return no
                    match args[0]:
                        ast.Name(l4, an): arr = an
                        _: return no
                _: return no
        _: return no
    match ip[1]:
        ast.Assign(l, n, r):
            if n != iv or len(r) != 1:
                return no
            match r[0]:
                ast.Binop(l2, op2, k2):
                    if op2 != "+" or len(k2) != 2:
                        return no
                    match k2[0]:
                        ast.Name(l3, n3):
                            if n3 != iv:
                                return no
                        _: return no
                    match k2[1]:
                        ast.IntLit(l4, one):
                            if one != 1:
                                return no
                        _: return no
                _: return no
        _: return no
    if arr == iv or _uns_b(b, iv, arr):
        return no
    return (iv, arr)

# src/tychoc.c@index_in_range -- is `base[idx]` a loop index proven in range?
fn _in_range(cs: inout C, base: ast.Expr, idx: ast.Expr) -> bool:
    bn := ""
    ix := ""
    match base:
        ast.Name(l, n): bn = n
        _: return false
    match idx:
        ast.Name(l, n): ix = n
        _: return false
    for k := len(cs.elv) - 1; k >= 0; k -= 1:
        if cs.elv[k] == ix and cs.ela[k] == bn:
            return true
    return false

fn _creads_l(es: [ast.Expr], nm: string) -> int:
    c := 0
    for i := 0; i < len(es); i += 1:
        c += _creads_e(es[i], nm)
    return c

fn _creads_e(e: ast.Expr, nm: string) -> int:
    match e:
        ast.Name(l, n):
            if n == nm:
                return 1
            return 0
        ast.Field(l, k, f): return _creads_l(k, nm)
        ast.TupIdx(l, k, i): return _creads_l(k, nm)
        ast.Index(l, k): return _creads_l(k, nm)
        ast.Slice(l, a, b, k): return _creads_l(k, nm)
        ast.Call(l, q, n, ts, k): return _creads_l(k, nm)
        ast.CallVal(l, k): return _creads_l(k, nm)
        ast.Named(l, n, k): return _creads_l(k, nm)
        ast.Binop(l, o, k): return _creads_l(k, nm)
        ast.Unop(l, o, k): return _creads_l(k, nm)
        ast.IsVar(l, k, q, n): return _creads_l(k, nm)
        ast.ArrLit(l, k): return _creads_l(k, nm)
        ast.MapLit(l, k): return _creads_l(k, nm)
        ast.Tuple(l, k): return _creads_l(k, nm)
        ast.SomeE(l, k): return _creads_l(k, nm)
        ast.OkE(l, k): return _creads_l(k, nm)
        ast.ErrE(l, k): return _creads_l(k, nm)
        ast.SpawnE(l, k): return _creads_l(k, nm)
        ast.OrRet(l, k): return _creads_l(k, nm)
        ast.Spread(l, k): return _creads_l(k, nm)
        ast.Addr(l, k): return _creads_l(k, nm)
        ast.ChanE(l, t, k): return _creads_l(k, nm)
        # a lambda's env is built from its captures at creation, so a name its
        # body reads is read HERE (src/tychoc.c counts the capture list; walking
        # the body counts a name read twice in it twice, which only refuses more)
        ast.Lambda(l, ps, r, b): return _creads_l(b, nm)
        _: return 0
    return 0

fn _creads_a(ar: [ast.Arm], nm: string) -> int:
    c := 0
    for i := 0; i < len(ar); i += 1:
        c += _creads_l(ar[i].ch, nm) + _creads_b(ar[i].body, nm)
    return c

fn _creads_s(s: ast.Stmt, nm: string) -> int:
    match s:
        ast.ExprStmt(l, k): return _creads_l(k, nm)
        ast.Decl(l, n, t, r, v): return _creads_l(r, nm) + _creads_b(v, nm)
        ast.MDecl(l, d, ns, r): return _creads_l(r, nm)
        ast.Assign(l, n, r): return _creads_l(r, nm)
        ast.PlaceSet(l, k): return _creads_l(k, nm)
        ast.ConstS(l, n, k): return _creads_l(k, nm)
        ast.ReturnS(l, k): return _creads_l(k, nm)
        ast.IfS(l, c2, b, e): return _creads_l(c2, nm) + _creads_b(b, nm) + _creads_b(e, nm)
        ast.WhileS(l, c2, b): return _creads_l(c2, nm) + _creads_b(b, nm)
        ast.For3(l, ip, c2, b): return _creads_b(ip, nm) + _creads_l(c2, nm) + _creads_b(b, nm)
        ast.ForIn(l, n, c2, b): return _creads_l(c2, nm) + _creads_b(b, nm)
        ast.ForRange(l, n, c2, b): return _creads_l(c2, nm) + _creads_b(b, nm)
        ast.ParallelS(l, w, b): return _creads_l(w, nm) + _creads_b(b, nm)
        ast.MatchS(l, c2, a): return _creads_l(c2, nm) + _creads_a(a, nm)
        ast.SelectS(l, a): return _creads_a(a, nm)
        ast.DeleteS(l, k): return _creads_l(k, nm)
        _: return 0
    return 0

fn _creads_b(b: [ast.Stmt], nm: string) -> int:
    c := 0
    for i := 0; i < len(b); i += 1:
        c += _creads_s(b[i], nm)
    return c

# may `b := rhs` / `b = rhs` take rhs's buffer instead of deep-copying it, given
# the destination lives in arena `owner`?
fn _canmove(cs: inout C, e: ast.Expr, owner: string) -> bool:
    if cs.loopdepth != 0:
        return false
    n := ""
    match e:
        ast.Name(l, nm): n = nm
        _: return false
    for i := len(cs.vnames) - 1; i >= 0; i -= 1:
        if cs.vnames[i] == n:
            if i < cs.fnbase:
                return false          # a parameter borrows the caller's buffer
            if cs.vown[i] != owner:
                return false
            return _creads_b(cs.pbody, n) == 1
    return false

# src/tychoc.c@can_move_into_sink -- move-on-last-use minus the same-arena
# requirement. A `sink` parameter is CONSUMED by the callee, which owns and may
# mutate it, so the argument must be independent of the caller. A tracked local
# read exactly once outside any loop can be handed off instead: its arena
# strictly encloses the per-call argument scratch, so the buffer outlives the
# call, and the one read is its last on every path. Anything else -- a param
# (it borrows the caller's buffer), a field or element (no part moves out of a
# value), a read inside a loop -- copies. src/tychoc.c's four die arms are not
# repeated here: compiler/types/zsema.ty rejects those before emission.
fn _canmove_sink(cs: inout C, e: ast.Expr) -> bool:
    if cs.loopdepth != 0:
        return false
    n := ""
    match e:
        ast.Name(l, nm): n = nm
        _: return false
    for i := len(cs.vnames) - 1; i >= 0; i -= 1:
        if cs.vnames[i] == n:
            if i < cs.fnbase:
                return false          # a parameter borrows the caller's buffer
            return _creads_b(cs.pbody, n) == 1
    return false

fn _rhs2(cs: inout C, e: ast.Expr, want: string, arena: string) -> (string, string):
    return _rhs3(&cs, e, want, arena, false)

# `mv`: this is a `b := rhs` / `b = rhs` site, where a dead same-arena local may
# be MOVED rather than copied (src/tychoc.c@can_move_from).
fn _rhs3(cs: inout C, e: ast.Expr, want: string, arena: string, mv: bool) -> (string, string):
    sw := cs.want
    cs.want = want
    # A string or bytes slice lowers to tycho_str_substr, a FRESH allocation
    # that aliases nothing -- so aimed at the destination arena it needs no
    # copy-on-bind, and the lexer stopped allocating each identifier twice.
    sa9 := cs.arena
    sl9 := false
    match e:
        ast.Slice(l9, a9, b9, k9): sl9 = true
        _: pass
    if sl9:
        cs.arena = arena
    c, t := _ex(&cs, e)
    cs.arena = sa9
    cs.want = sw
    if sl9 and (t == "string" or t == "bytes"):
        return (c, t)
    if _place(e) and _heap(&cs, t):
        # A STRING already in the destination arena is shared, not copied. The
        # copy exists so a later write to the destination cannot be seen through
        # the source, and a string has no in-place write: `s = s + x` concatenates
        # into a fresh buffer, and the accumulator starts at cap 0 ("not yet
        # owned") so its first append reallocates too. Same arena means the two
        # also die together, so there is no lifetime to extend. Arrays and maps
        # ARE mutable and still copy.
        if not _shares(&cs, e, t, arena) and not (mv and _canmove(&cs, e, arena)):
            c = _copy(&cs, c, t, arena)
    if len(want) > 0 and want == "float" and t == "int":
        c = _tofloat(c)
        t = "float"
    return (c, t)

# --- concurrency -------------------------------------------------------------
# Channels and tasks lower onto the runtime's HChan/HTask, exactly as
# src/tychoc.c does. Each channel ELEMENT type gets its own send/recv pair
# (the runtime moves void*, so the copy in and out is typed here), and each
# `spawn` SITE gets an argument struct and a thunk, because pthreads takes one
# void* and the call's arity is known only here.

fn _chan_defs(cs: inout C) -> string:
    out := ""
    for i := 0; i < len(cs.ckinds); i += 1:
        et := cs.ckinds[i]
        ct := _cty(&cs, et)
        n := str(i)
        out = out + "static void tycho_chan_send_" + n + "(HChan *_ch, " + ct + " _v) { " +
            "HCell *_c = tycho_chan_send_cell(_ch); " + ct + " *_p = (" + ct +
            " *)arena_alloc(&_c->arena, sizeof(" + ct + ")); *_p = " + _copy(&cs, "_v", et, "&_c->arena") +
            "; tycho_chan_send_commit(_ch, _c, _p); }\n"
        out = out + "static int tycho_chan_recv_" + n + "(HChan *_ch, Arena *_dst, " + ct + " *_out) { " +
            "HCell *_c = tycho_chan_recv_cell(_ch); if (!_c) return 0; *_out = " +
            _copy(&cs, "(*(" + ct + " *)_c->val)", et, "_dst") + "; tycho_chan_recv_commit(_ch, _c); return 1; }\n"
        out = out + "static int tycho_chan_tryrecv_" + n + "(HChan *_ch, Arena *_dst, " + ct + " *_out) { " +
            "HCell *_c; int _st = tycho_chan_try_recv(_ch, &_c); if (_st != 1) return _st; *_out = " +
            _copy(&cs, "(*(" + ct + " *)_c->val)", et, "_dst") + "; tycho_chan_recv_commit(_ch, _c); return 1; }\n"
    return out

# `recv(ch)` yields an Option, which tychoc1 lowers as an enum instance -- so the
# receive is a statement expression that builds Some(v) or hands back the shared
# None singleton.
fn _recv_expr(cs: inout C, chc: string, et: string, fname: string) -> (string, string):
    ot := _opt_of(&cs, et)
    oi := _eidx(&cs, _tname(ot))
    en := cs.eds[oi].name
    st := _tag(&cs, oi, "Some")
    nt := _tag(&cs, oi, "None")
    k := str(_ckind(&cs, et))
    v := _fresh(&cs, "_rv")
    tv := _fresh(&cs, "_rt")
    code := "({ E_" + en + " *" + v + "; " + _ctyz(&cs, et) + "" + tv + "; " +
        "if (" + fname + k + "(" + chc + ", &_scope, &" + tv + ")) { " +
        v + " = (E_" + en + " *)arena_alloc(&_scope, offsetof(E_" + en + ", u) + sizeof(E_" + en + "_Some)); " +
        v + "->tag = " + str(st) + "; " + v + "->u.Some.f0 = " + tv + "; } else { " +
        v + " = &_sing_" + en + "_" + str(nt) + "; } " + v + "; })"
    return (code, ot)

# One thunk per spawn site. The arguments are copied into the TASK's own arena,
# which outlives the spawning scope; the result is written back there too and
# read out by wait().
fn _spawn(cs: inout C, e: ast.Expr) -> (string, string):
    match e:
        ast.Call(l, q, n, ts, args):
            nm := n
            if len(q) > 0:
                nm = _qpfx(&cs, q) + n
            fi := _fidx(&cs, nm)
            if fi < 0:
                # `spawn get(Box(11))` on a GENERIC: instantiate it first, the
                # same way _call does, and spawn the instance.
                gfi := _gfidx(&cs, nm)
                if gfi >= 0:
                    tps := cs.gf[gfi].typarams
                    bs := []string
                    for i := 0; i < len(ts); i += 1:
                        push(bs, _ty(&cs, ts[i]))
                    if len(bs) < len(tps):
                        bs = _blank(len(tps))
                        ats := _argtypes(&cs, args)
                        for j := 0; j < len(cs.gf[gfi].params) and j < len(ats); j += 1:
                            if len(cs.gf[gfi].params[j].ty) > 0:
                                _unify(&cs, cs.gf[gfi].params[j].ty[0], ats[j], tps, &bs)
                    for j := 0; j < len(bs); j += 1:
                        if len(bs[j]) == 0:
                            _bad("cannot infer '$" + tps[j] + "' at a spawn of '" + nm + "'")
                    fi = _inst_fn(&cs, nm, bs)
            if fi < 0:
                _bad("spawn requires a direct call to a declared procedure")
            fd := cs.fds[fi]
            rt := fd.ret
            id := str(len(cs.spawnd))
            fields := "HTask *t;"
            init := ""
            call := "h_" + fd.name + "(&_a->t->root"
            for i := 0; i < len(args) and i < len(fd.ptypes); i += 1:
                pt := fd.ptypes[i]
                sw := cs.want
                sa := cs.arena
                cs.want = pt
                cs.arena = "&_tk->root"
                ac, at := _ex(&cs, args[i])
                cs.want = sw
                cs.arena = sa
                if pt == "float" and at == "int":
                    ac = "(double)(" + ac + ")"
                # A spawn takes a SNAPSHOT: the task runs concurrently with the
                # parent, so a heap argument must be deep-copied into the task's
                # own arena. Setting cs.arena alone does not do it -- a place
                # emits as the parent's variable -- and tests/conc/basic.ty read
                # 39 for 10 because the parent pushed while sum() walked it.
                if _heap(&cs, pt):
                    ac = _copy(&cs, ac, pt, "&_tk->root")
                fields = fields + " " + _ctyz(&cs, pt) + "a" + str(i) + ";"
                init = init + "_sa->a" + str(i) + " = " + ac + "; "
                call = call + ", _a->a" + str(i)
            call = call + ")"
            body := "static void *tycho_spawn_" + id + "(void *_p) { HSpawnA_" + id +
                " *_a = (HSpawnA_" + id + " *)_p; "
            if rt == "void":
                body = body + call + "; _a->t->ret = 0; "
            else:
                body = body + _ctyz(&cs, rt) + "_r = " + call + "; " + _cty(&cs, rt) +
                    " *_s = (" + _ctyz(&cs, rt) + "*)arena_alloc(&_a->t->root, sizeof(" +
                    _cty(&cs, rt) + ")); *_s = _r; _a->t->ret = _s; "
            body = body + "tycho_pool_flush(); return 0; }\n"
            push(cs.spawnd, "typedef struct { " + fields + " } HSpawnA_" + id + ";\n" + body)
            mk := "({ HTask *_tk = tycho_task_new(); HSpawnA_" + id + " *_sa = (HSpawnA_" + id +
                " *)arena_alloc(&_tk->root, sizeof(HSpawnA_" + id + ")); _sa->t = _tk; " + init +
                "tycho_task_start(_tk, tycho_spawn_" + id + ", _sa); _tk; })"
            return (mk, "task(" + rt + ")")
        _: _bad("spawn requires a direct call: spawn f(args)")
    return ("", "")

# CC-2/CC-4: a task is JOINED and a channel FREED at the end of the scope that
# created it, innermost first. src/tychoc.c keeps the same list in g_taskvars.
fn _finalizers(cs: inout C, m: int, ind: string) -> string:
    out := ""
    i := len(cs.vnames)
    for i > m:
        i -= 1
        t := cs.vtypes[i]
        if _is_handle(t):
            fr := _hfree(&cs, t)
            if len(fr) > 0:
                out = out + ind + "if (" + cs.vcn[i] + ") " + fr + "(" + cs.vcn[i] + ");\n"
        elif _is_task(t):
            out = out + ind + "tycho_task_finish(" + cs.vcn[i] + ");\n"
        elif _is_chan(t):
            out = out + ind + "tycho_chan_free(" + cs.vcn[i] + ");\n"
    return out

# The frees a `break`/`continue` must run: everything declared since the
# innermost loop was entered.
fn _lpfin(cs: inout C) -> string:
    if len(cs.lmark) == 0:
        return ""
    return _finalizers(&cs, cs.lmark[len(cs.lmark) - 1], "")

fn _block(cs: inout C, body: [ast.Stmt], ind: string) -> string:
    m := _mark(&cs)
    out := ""
    for s in body:
        out = out + _stmt(&cs, s, ind)
    out = out + _finalizers(&cs, m, ind)
    _restore(&cs, m)
    return out

# `parallel for i in lo..<hi:` -- the body is OUTLINED into a worker taking the
# half-open slice and every capture, started on min(ncpu, hi-lo) tasks and
# joined in order, the reduction summed on the way out (src/tychoc.c@__plo).
# One reduction variable is supported; the corpus has no program with two.
# gap: two or more reductions want a tuple return, which ./tychoc emits.
# `w` is the DECLARED width -- `parallel(3) for` -- empty for a bare `parallel
# for`, which sizes itself to ncpu(). It used to be dropped at the call site,
# so every explicit width compiled as ncpu() (tests/conc/parfor_width.ty).
# The operator a parallel-for accumulator reduces with: `acc = acc + e` or
# `acc = acc * e`. The chunk seed and the join must BOTH follow it -- a
# product seeded at 0 stays 0, and products joined with + are a sum
# (tests/conc/parfor.ty read p=1 for 120).
fn _red_op(b: [ast.Stmt], n: string) -> string:
    for s in b:
        match s:
            ast.Assign(l, an, r):
                if an == n and len(r) == 1:
                    match r[0]:
                        ast.Binop(l2, o, k): return o
                        _: pass
            ast.IfS(l, c, bb, e):
                o1 := _red_op(bb, n)
                if len(o1) > 0:
                    return o1
                o2 := _red_op(e, n)
                if len(o2) > 0:
                    return o2
            ast.WhileS(l, c, bb): 
                o3 := _red_op(bb, n)
                if len(o3) > 0:
                    return o3
            ast.For3(l, ip, c, bb):
                o4 := _red_op(bb, n)
                if len(o4) > 0:
                    return o4
            _: pass
    return ""

fn _parfor(cs: inout C, b: [ast.Stmt], ind: string, w: [ast.Expr]) -> string:
    pkw := "tycho_ncpu()"
    if len(w) == 1:
        wc, wt := _ex(&cs, w[0])
        pkw = wc
        # a literal width prints as itself: ./tychoc emits `_pk = 3;` and the
        # lane reads the initialiser, so the LL suffix _ex adds would miss it
        match w[0]:
            ast.IntLit(lw, iv): pkw = str(iv)
            _: pass
    # A DECLARED width is the programmer's, so it fails closed rather than
    # clamping silently; the bare form is ncpu() and clamps by design
    # (src/tychoc.c:11469).
    pkg := ""
    if len(w) == 1:
        pkg = "    if (_pk < 1 || _pk > 64) tycho_die(\"parallel width out of range 1..64\");\n"
    match b[0]:
        ast.ForRange(l2, v, k, body):
            free := []string
            wr := []string
            bs := [v]
            _fv_body(&cs, body, bs, &free, &wr)
            caps := []string
            for f in free:
                if not _has(wr, f) and len(_vtype(&cs, f)) > 0:
                    push(caps, f)
            capt := []string
            for c in caps:
                push(capt, _vtype(&cs, c))
            # One reduction returns its own type; several return a TUPLE, which
            # is what src/tychoc.c's worker does.
            rts := []string
            for r9 in wr:
                push(rts, _vtype(&cs, r9))
            rn := ""
            rt := "int"
            if len(wr) == 1:
                rn = wr[0]
                rt = rts[0]
            elif len(wr) > 1:
                rn = wr[0]
                rt = _tup_of(&cs, rts)
            id := str(len(cs.lamd))
            wnm := "h___par" + id
            # the worker's signature
            sig := _ctyz(&cs, rt) + "" + wnm + "(Arena *_parent, tycho_int h___plo, tycho_int h___phi"
            for i := 0; i < len(caps); i += 1:
                sig = sig + ", " + _ctyz(&cs, capt[i]) + "h_" + caps[i]
            sig = sig + ")"
            # the worker's body, in a scope holding only its parameters
            sv := cs.vnames
            svt := cs.vtypes
            svc := cs.vcn
            svo := cs.vown
            sva := cs.vacc
            sar := cs.arena
            scr := cs.cur_ret
            cs.vnames = []string
            cs.vtypes = []string
            cs.vcn = []string
            cs.vown = []string
            cs.vacc = []string
            sas := cs.ascope
            cs.ascope = []string
            sldp := cs.loopdepth
            cs.loopdepth = sldp + 1   # a parallel loop body: one textual read runs N times
            cs.arena = "&_scope"
            cs.cur_ret = rt
            for i := 0; i < len(caps); i += 1:
                _push(&cs, caps[i], capt[i])
            decl := ""
            for j9 := 0; j9 < len(wr); j9 += 1:
                cnr := _push(&cs, wr[j9], rts[j9])
                seed := _zero(&cs, rts[j9])
                if _red_op(body, wr[j9]) == "*":
                    seed = "1"
                decl = decl + "    " + _ctyz(&cs, rts[j9]) + "" + cnr + " = " +
                    seed + ";\n"
            iv := _push(&cs, v, "int")
            loop := "    for (tycho_int " + iv + " = h___plo; " + iv + " < h___phi; " + iv + " += 1) {\n" +
                _block(&cs, body, "        ") + "    }\n"
            ret := "    arena_free(&_scope); return 0;\n"
            if len(wr) == 1:
                ret = "    { " + _ctyz(&cs, rt) + "_r = " + _vcname(&cs, wr[0]) +
                    "; arena_free(&_scope); return _r; }\n"
            elif len(wr) > 1:
                mk9 := "    { " + _ctyz(&cs, rt) + "_r;"
                for j9 := 0; j9 < len(wr); j9 += 1:
                    mk9 = mk9 + " _r.f" + str(j9) + " = " + _vcname(&cs, wr[j9]) + ";"
                ret = mk9 + " arena_free(&_scope); return _r; }\n"
            wbody := sig + " {\n    Arena _scope = arena_child(_parent);\n" + decl + loop + ret + "}\n"
            cs.vnames = sv
            cs.vtypes = svt
            cs.vcn = svc
            cs.vown = svo
            cs.vacc = sva
            cs.arena = sar
            cs.ascope = sas
            cs.loopdepth = sldp
            cs.cur_ret = scr
            push(cs.lamp, sig + ";\n")
            push(cs.lamd, wbody)
            # the spawn thunk for this worker
            sid := str(len(cs.spawnd))
            fields := "HTask *t; tycho_int a0; tycho_int a1;"
            call := wnm + "(&_a->t->root, _a->a0, _a->a1"
            for i := 0; i < len(caps); i += 1:
                fields = fields + " " + _ctyz(&cs, capt[i]) + "c" + str(i) + ";"
                call = call + ", _a->c" + str(i)
            call = call + ")"
            ct := _cty(&cs, rt)
            push(cs.spawnd, "typedef struct { " + fields + " } HSpawnA_" + sid + ";\n" +
                "static void *tycho_spawn_" + sid + "(void *_p) { HSpawnA_" + sid + " *_a = (HSpawnA_" + sid +
                " *)_p; " + ct + " _r = " + call + "; " + ct + " *_s = (" + ct +
                " *)arena_alloc(&_a->t->root, sizeof(" + ct + ")); *_s = _r; _a->t->ret = _s; " +
                "tycho_pool_flush(); return 0; }\n")
            loc, lot := _ex(&cs, k[0])
            hic, hit := _ex(&cs, k[1])
            out := ind + "{\n" +
                ind + "    tycho_int _plo = " + loc + ", _phi = " + hic + ";\n" +
                ind + "    if (_phi < _plo) _phi = _plo;\n" +
                ind + "    tycho_int _pk = " + pkw + ";\n" + ind + pkg +
                ind + "    if (_pk > _phi - _plo) _pk = _phi - _plo;\n" +
                ind + "    if (_pk < 1) _pk = 1; if (_pk > 64) _pk = 64;\n" +
                ind + "    HTask *_pts[64];\n" +
                ind + "    for (tycho_int _pc = 0; _pc < _pk; _pc++) {\n" +
                ind + "        HTask *_tk = tycho_task_new();\n" +
                ind + "        HSpawnA_" + sid + " *_sa = (HSpawnA_" + sid + " *)arena_alloc(&_tk->root, sizeof(HSpawnA_" + sid + "));\n" +
                ind + "        _sa->t = _tk;\n" +
                ind + "        _sa->a0 = _plo + (_phi - _plo) * _pc / _pk;\n" +
                ind + "        _sa->a1 = _plo + (_phi - _plo) * (_pc + 1) / _pk;\n"
            for i := 0; i < len(caps); i += 1:
                out = out + ind + "        _sa->c" + str(i) + " = " + _vcname(&cs, caps[i]) + ";\n"
            out = out + ind + "        tycho_task_start(_tk, tycho_spawn_" + sid + ", _sa);\n" +
                ind + "        _pts[_pc] = _tk;\n" +
                ind + "    }\n" +
                ind + "    for (tycho_int _pc = 0; _pc < _pk; _pc++) {\n" +
                ind + "        tycho_task_join(_pts[_pc]);\n" +
                ind + "        " + ct + " _pp = *(" + ct + " *)_pts[_pc]->ret;\n" +
                ind + "        tycho_task_free(_pts[_pc]);\n"
            if len(wr) == 1:
                jo := _red_op(body, wr[0])
                if jo != "*":
                    jo = "+"
                out = out + ind + "        " + _vcname(&cs, wr[0]) + " = " +
                    _vcname(&cs, wr[0]) + " " + jo + " _pp;\n"
            elif len(wr) > 1:
                for j9 := 0; j9 < len(wr); j9 += 1:
                    jo2 := _red_op(body, wr[j9])
                    if jo2 != "*":
                        jo2 = "+"
                    out = out + ind + "        " + _vcname(&cs, wr[j9]) + " = " +
                        _vcname(&cs, wr[j9]) + " " + jo2 + " _pp.f" + str(j9) + ";\n"
            else:
                out = out + ind + "        (void)_pp;\n"
            return out + ind + "    }\n" + ind + "}\n"
        ast.ForIn(l2, v, coll, body):
            return _parchan(&cs, l2, v, coll, body, ind, pkw, pkg)
        _: _bad("parallel requires `for i in lo..<hi:` or `for x in ch:`")
    return ""

# `parallel for x in ch:` -- every worker DRAINS the channel until it is closed
# and empty, which is the `closed:` arm src/tychoc.c desugars this into. The
# reduction is summed on join, exactly as the range form does.
# `parallel for x in xs:` over an ARRAY -- the third form. Each worker takes a
# half-open slice of the INDEX range and binds the element itself, so the array
# is a capture like any other and the chunking is the range form's.
fn _pararr(cs: inout C, cc: string, ct: string, v: string, body: [ast.Stmt], ind: string, pkw: string, pkg: string) -> string:
    et := _elem(ct)
    free := []string
    wr := []string
    bs := [v]
    _fv_body(&cs, body, bs, &free, &wr)
    caps := []string
    for f in free:
        if not _has(wr, f) and len(_vtype(&cs, f)) > 0:
            push(caps, f)
    capt := []string
    for c in caps:
        push(capt, _vtype(&cs, c))
    rts := []string
    for r9 in wr:
        push(rts, _vtype(&cs, r9))
    rt := "int"
    if len(wr) == 1:
        rt = rts[0]
    elif len(wr) > 1:
        rt = _tup_of(&cs, rts)
    id := str(len(cs.lamd))
    wnm := "h___par" + id
    sig := _ctyz(&cs, rt) + "" + wnm + "(Arena *_parent, " + _cty(&cs, ct) +
        " _parr, tycho_int h___plo, tycho_int h___phi"
    for i := 0; i < len(caps); i += 1:
        sig = sig + ", " + _ctyz(&cs, capt[i]) + "h_" + caps[i]
    sig = sig + ")"
    sv := cs.vnames
    svt := cs.vtypes
    svc := cs.vcn
    svo := cs.vown
    sva := cs.vacc
    sar := cs.arena
    scr := cs.cur_ret
    cs.vnames = []string
    cs.vtypes = []string
    cs.vcn = []string
    cs.vown = []string
    cs.vacc = []string
    sas := cs.ascope
    cs.ascope = []string
    sldp := cs.loopdepth
    cs.loopdepth = sldp + 1   # a parallel loop body: one textual read runs N times
    cs.arena = "&_scope"
    cs.cur_ret = rt
    for i := 0; i < len(caps); i += 1:
        _push(&cs, caps[i], capt[i])
    decl := ""
    for j := 0; j < len(wr); j += 1:
        cnr := _push(&cs, wr[j], rts[j])
        decl = decl + "    " + _ctyz(&cs, rts[j]) + "" + cnr + " = " + _zero(&cs, rts[j]) + ";\n"
    ecn := _push(&cs, v, et)
    loop := "    for (tycho_int _pi = h___plo; _pi < h___phi; _pi += 1) {\n" +
        "        " + _ctyz(&cs, et) + "" + ecn + " = " + _arrf(&cs, et, "_get") + "(_parr, _pi);\n" +
        _block(&cs, body, "        ") + "    }\n"
    ret := "    arena_free(&_scope); return 0;\n"
    if len(wr) == 1:
        ret = "    { " + _ctyz(&cs, rt) + "_r = " + _vcname(&cs, wr[0]) +
            "; arena_free(&_scope); return _r; }\n"
    elif len(wr) > 1:
        mk := "    { " + _ctyz(&cs, rt) + "_r;"
        for j := 0; j < len(wr); j += 1:
            mk = mk + " _r.f" + str(j) + " = " + _vcname(&cs, wr[j]) + ";"
        ret = mk + " arena_free(&_scope); return _r; }\n"
    push(cs.lamp, sig + ";\n")
    push(cs.lamd, sig + " {\n    Arena _scope = arena_child(_parent);\n" + decl + loop + ret + "}\n")
    cs.vnames = sv
    cs.vtypes = svt
    cs.vcn = svc
    cs.vown = svo
    cs.vacc = sva
    cs.arena = sar
    cs.ascope = sas
    cs.loopdepth = sldp
    cs.cur_ret = scr
    sid := str(len(cs.spawnd))
    fields := "HTask *t; " + _ctyz(&cs, ct) + "a0; tycho_int a1; tycho_int a2;"
    call := wnm + "(&_a->t->root, _a->a0, _a->a1, _a->a2"
    for i := 0; i < len(caps); i += 1:
        fields = fields + " " + _ctyz(&cs, capt[i]) + "c" + str(i) + ";"
        call = call + ", _a->c" + str(i)
    call = call + ")"
    ctt := _cty(&cs, rt)
    push(cs.spawnd, "typedef struct { " + fields + " } HSpawnA_" + sid + ";\n" +
        "static void *tycho_spawn_" + sid + "(void *_p) { HSpawnA_" + sid + " *_a = (HSpawnA_" + sid +
        " *)_p; " + ctt + " _r = " + call + "; " + ctt + " *_s = (" + ctt +
        " *)arena_alloc(&_a->t->root, sizeof(" + ctt + ")); *_s = _r; _a->t->ret = _s; " +
        "tycho_pool_flush(); return 0; }\n")
    out := ind + "{\n" +
        ind + "    " + _ctyz(&cs, ct) + "_parr = " + cc + ";\n" +
        ind + "    tycho_int _plo = 0, _phi = (_parr).len;\n" +
        ind + "    tycho_int _pk = " + pkw + ";\n" + ind + pkg +
        ind + "    if (_pk > _phi - _plo) _pk = _phi - _plo;\n" +
        ind + "    if (_pk < 1) _pk = 1; if (_pk > 64) _pk = 64;\n" +
        ind + "    HTask *_pts[64];\n" +
        ind + "    for (tycho_int _pc = 0; _pc < _pk; _pc++) {\n" +
        ind + "        HTask *_tk = tycho_task_new();\n" +
        ind + "        HSpawnA_" + sid + " *_sa = (HSpawnA_" + sid + " *)arena_alloc(&_tk->root, sizeof(HSpawnA_" + sid + "));\n" +
        ind + "        _sa->t = _tk;\n" +
        ind + "        _sa->a0 = _parr;\n" +
        ind + "        _sa->a1 = _plo + (_phi - _plo) * _pc / _pk;\n" +
        ind + "        _sa->a2 = _plo + (_phi - _plo) * (_pc + 1) / _pk;\n"
    for i := 0; i < len(caps); i += 1:
        out = out + ind + "        _sa->c" + str(i) + " = " + _vcname(&cs, caps[i]) + ";\n"
    out = out + ind + "        tycho_task_start(_tk, tycho_spawn_" + sid + ", _sa);\n" +
        ind + "        _pts[_pc] = _tk;\n" +
        ind + "    }\n" +
        ind + "    for (tycho_int _pc = 0; _pc < _pk; _pc++) {\n" +
        ind + "        tycho_task_join(_pts[_pc]);\n" +
        ind + "        " + ctt + " _pp = *(" + ctt + " *)_pts[_pc]->ret;\n" +
        ind + "        tycho_task_free(_pts[_pc]);\n"
    if len(wr) == 1:
        out = out + ind + "        " + _vcname(&cs, wr[0]) + " = " + _vcname(&cs, wr[0]) + " + _pp;\n"
    elif len(wr) > 1:
        for j := 0; j < len(wr); j += 1:
            out = out + ind + "        " + _vcname(&cs, wr[j]) + " = " +
                _vcname(&cs, wr[j]) + " + _pp.f" + str(j) + ";\n"
    else:
        out = out + ind + "        (void)_pp;\n"
    return out + ind + "    }\n" + ind + "}\n"

fn _parchan(cs: inout C, l: int, v: string, coll: [ast.Expr], body: [ast.Stmt], ind: string, pkw: string, pkg: string) -> string:
    cc, ct := _ex(&cs, coll[0])
    if _is_arr(ct):
        return _pararr(&cs, cc, ct, v, body, ind, pkw, pkg)
    if not _is_chan(ct):
        _bad("parallel requires `for i in lo..<hi:`, `for x in xs:` or `for x in ch:`")
    et := _cinner(ct)
    ck := str(_ckind(&cs, et))
    free := []string
    wr := []string
    bs := [v]
    _fv_body(&cs, body, bs, &free, &wr)
    caps := []string
    for f in free:
        if not _has(wr, f) and len(_vtype(&cs, f)) > 0:
            push(caps, f)
    if len(wr) > 1:
        _bad("a parallel for with more than one reduction variable -- Phase 8")
    capt := []string
    for c in caps:
        push(capt, _vtype(&cs, c))
    rn := ""
    rt := "int"
    if len(wr) == 1:
        rn = wr[0]
        rt = _vtype(&cs, rn)
    id := str(len(cs.lamd))
    wnm := "h___par" + id
    sig := _ctyz(&cs, rt) + "" + wnm + "(Arena *_parent, HChan *_pch"
    for i := 0; i < len(caps); i += 1:
        sig = sig + ", " + _ctyz(&cs, capt[i]) + "h_" + caps[i]
    sig = sig + ")"
    sv := cs.vnames
    svt := cs.vtypes
    svc := cs.vcn
    svo := cs.vown
    sva := cs.vacc
    sar := cs.arena
    scr := cs.cur_ret
    cs.vnames = []string
    cs.vtypes = []string
    cs.vcn = []string
    cs.vown = []string
    cs.vacc = []string
    sas := cs.ascope
    cs.ascope = []string
    sldp := cs.loopdepth
    cs.loopdepth = sldp + 1   # a parallel loop body: one textual read runs N times
    cs.arena = "&_scope"
    cs.cur_ret = rt
    for i := 0; i < len(caps); i += 1:
        _push(&cs, caps[i], capt[i])
    decl := ""
    if len(rn) > 0:
        _push(&cs, rn, rt)
        decl = "    " + _ctyz(&cs, rt) + "h_" + rn + " = " + _zero(&cs, rt) + ";\n"
    ecn := _push(&cs, v, et)
    loop := "    for (;;) {\n" +
        "        " + _ctyz(&cs, et) + "" + ecn + "; int _ssp = 0, _got = 0;\n" +
        "        for (;;) {\n" +
        "            int _st = tycho_chan_tryrecv_" + ck + "(_pch, &_scope, &" + ecn + ");\n" +
        "            if (_st == 1) { _got = 1; break; }\n" +
        "            if (_st != 0) break;\n" +
        "            tycho_select_pause(&_ssp);\n" +
        "        }\n" +
        "        if (!_got) break;\n" +
        _block(&cs, body, "        ") +
        "    }\n"
    ret := "    arena_free(&_scope); return 0;\n"
    if len(rn) > 0:
        ret = "    { " + _ctyz(&cs, rt) + "_r = h_" + rn + "; arena_free(&_scope); return _r; }\n"
    push(cs.lamp, sig + ";\n")
    push(cs.lamd, sig + " {\n    Arena _scope = arena_child(_parent);\n" + decl + loop + ret + "}\n")
    cs.vnames = sv
    cs.vtypes = svt
    cs.vcn = svc
    cs.vown = svo
    cs.vacc = sva
    cs.arena = sar
    cs.ascope = sas
    cs.loopdepth = sldp
    cs.cur_ret = scr
    sid := str(len(cs.spawnd))
    fields := "HTask *t; HChan *a0;"
    call := wnm + "(&_a->t->root, _a->a0"
    for i := 0; i < len(caps); i += 1:
        fields = fields + " " + _ctyz(&cs, capt[i]) + "c" + str(i) + ";"
        call = call + ", _a->c" + str(i)
    call = call + ")"
    ctt := _cty(&cs, rt)
    push(cs.spawnd, "typedef struct { " + fields + " } HSpawnA_" + sid + ";\n" +
        "static void *tycho_spawn_" + sid + "(void *_p) { HSpawnA_" + sid + " *_a = (HSpawnA_" + sid +
        " *)_p; " + ctt + " _r = " + call + "; " + ctt + " *_s = (" + ctt +
        " *)arena_alloc(&_a->t->root, sizeof(" + ctt + ")); *_s = _r; _a->t->ret = _s; " +
        "tycho_pool_flush(); return 0; }\n")
    out := ind + "{\n" +
        ind + "    HChan *_pch = " + cc + ";\n" +
        ind + "    tycho_int _pk = " + pkw + ";\n" + ind + pkg +
        ind + "    if (_pk < 1) _pk = 1; if (_pk > 64) _pk = 64;\n" +
        ind + "    HTask *_pts[64];\n" +
        ind + "    for (tycho_int _pc = 0; _pc < _pk; _pc++) {\n" +
        ind + "        HTask *_tk = tycho_task_new();\n" +
        ind + "        HSpawnA_" + sid + " *_sa = (HSpawnA_" + sid + " *)arena_alloc(&_tk->root, sizeof(HSpawnA_" + sid + "));\n" +
        ind + "        _sa->t = _tk;\n" +
        ind + "        _sa->a0 = _pch;\n"
    for i := 0; i < len(caps); i += 1:
        out = out + ind + "        _sa->c" + str(i) + " = " + _vcname(&cs, caps[i]) + ";\n"
    out = out + ind + "        tycho_task_start(_tk, tycho_spawn_" + sid + ", _sa);\n" +
        ind + "        _pts[_pc] = _tk;\n" +
        ind + "    }\n" +
        ind + "    for (tycho_int _pc = 0; _pc < _pk; _pc++) {\n" +
        ind + "        tycho_task_join(_pts[_pc]);\n" +
        ind + "        " + ctt + " _pp = *(" + ctt + " *)_pts[_pc]->ret;\n" +
        ind + "        tycho_task_free(_pts[_pc]);\n"
    if len(rn) > 0:
        out = out + ind + "        " + _vcname(&cs, rn) + " = " + _vcname(&cs, rn) + " + _pp;\n"
    else:
        out = out + ind + "        (void)_pp;\n"
    return out + ind + "    }\n" + ind + "}\n"

# `select:` -- try each recv arm in turn; take the first that has a value. With
# a `default:` arm the whole thing falls through immediately; without one it
# retries until a channel is ready, EXCEPT when every channel is closed and
# drained, which takes the `closed:` arm if there is one and falls through if
# not (src/tychoc.c: the recv-only shape used to hang there).
fn _select(cs: inout C, arms: [ast.Arm], ind: string) -> string:
    cs.tmp += 1
    id := str(cs.tmp)
    out := ind + "{\n"
    chs := []string
    ets := []string
    n := 0
    for a in arms:
        if a.kind != "recv":
            continue
        cc, ct := _ex(&cs, a.ch[0])
        push(chs, "_sc" + id + "_" + str(n))
        push(ets, _cinner(ct))
        out = out + ind + "    HChan *_sc" + id + "_" + str(n) + " = " + cc + ";\n"
        n += 1
    out = out + ind + "    int _ssp" + id + " = 0, _open" + id + " = 0;\n" +
        ind + "    _sel_retry_" + id + ": ;\n" +
        ind + "    _open" + id + " = 0;\n"
    i := 0
    for a in arms:
        if a.kind != "recv":
            continue
        et := ets[i]
        m := _mark(&cs)
        bind := ""
        if len(a.binds) > 0:
            bcn := _push(&cs, a.binds[0], et)
            bind = ind + "        " + _ctyz(&cs, et) + "" + bcn + " = _v" + id + ";\n"
        body := _block(&cs, a.body, ind + "        ")
        _restore(&cs, m)
        out = out + ind + "    { " + _ctyz(&cs, et) + "_v" + id + "; int _st" + id +
            " = tycho_chan_tryrecv_" + str(_ckind(&cs, et)) + "(" + chs[i] + ", " + cs.arena + ", &_v" + id + ");\n" +
            ind + "      if (_st" + id + " == 1) {\n" + bind + body +
            ind + "        goto _sel_done_" + id + ";\n" + ind + "      }\n" +
            ind + "      if (_st" + id + " == 0) _open" + id + " = 1; }\n"
        i += 1
    dflt := ""
    closed := ""
    for a in arms:
        if a.kind == "default":
            dflt = _block(&cs, a.body, ind + "        ")
        elif a.kind == "closed":
            closed = _block(&cs, a.body, ind + "        ")
    if len(dflt) > 0:
        # A `closed:` arm beside a `default:` still wins when every channel is
        # closed and drained -- `stage.cancelled()` is exactly that shape, and
        # taking the default there made a cancelled source keep producing.
        if len(closed) > 0:
            out = out + ind + "    if (!_open" + id + ") {\n" + closed +
                ind + "        goto _sel_done_" + id + ";\n" + ind + "    }\n"
        out = out + dflt + ind + "    goto _sel_done_" + id + ";\n"
    else:
        out = out + ind + "    if (!_open" + id + ") {\n" + closed +
            ind + "        goto _sel_done_" + id + ";\n" + ind + "    }\n" +
            ind + "    tycho_select_pause(&_ssp" + id + ");\n" +
            ind + "    goto _sel_retry_" + id + ";\n"
    return out + ind + "    _sel_done_" + id + ": ;\n" + ind + "}\n"

# src/tychoc.c@cond_unwrap -- an if/while condition drops ONE redundant outer
# paren pair, so `if ((a > b))` reads `if (a > b)`.
# src/tychoc.c@expr_has_orreturn
fn _hasorr(e: ast.Expr) -> bool:
    match e:
        ast.OrRet(l, k): return true
        _: pass
    for c in ast.kids(e):
        if _hasorr(c):
            return true
    return false

# src/tychoc.c@expr_has_call
fn _hascall(e: ast.Expr) -> bool:
    match e:
        ast.Call(l, q, n, t, a): return true
        ast.CallVal(l, k): return true
        _: pass
    for c in ast.kids(e):
        if _hascall(c):
            return true
    return false

# src/tychoc.c@expr_refs_local: does this initialiser read the name it binds?
# A lambda contributes only its CAPTURES, so a parameter of the same name is
# not a reference to the enclosing binding.
fn _refslocal(e: ast.Expr, n: string) -> bool:
    match e:
        ast.Name(l, v): return v == n
        ast.Call(l, q, cn, t, a):
            if len(q) == 0 and cn == n:      # calling the fn value it rebinds
                return true
        ast.Lambda(l, p, r, b):
            for q in p:
                if q.name == n:
                    return false
        _: pass
    for c in ast.kids(e):
        if _refslocal(c, n):
            return true
    return false

fn _cunwrap(s: string) -> string:
    n := len(s)
    if n < 3 or s[0] != 40:
        return s
    if s[1] == 123:
        return s
    d := 0
    i := 0
    for i < n:
        c := s[i]
        if c == 34 or c == 39:
            i += 1
            for i < n and s[i] != c:
                if s[i] == 92 and i + 1 < n:
                    i += 1
                i += 1
            if i >= n:
                return s
            i += 1
            continue
        if c == 40:
            d += 1
        elif c == 41:
            d -= 1
            if d == 0:
                if i + 1 != n:
                    return s
                return s[1:n - 1]
        i += 1
    return s

fn _stmt(cs: inout C, s: ast.Stmt, ind: string) -> string:
    match s:
        ast.PassS(l):
            return ""                  # src/tychoc.c:12248 -- the no-op emits none
        ast.ExprStmt(l, es):
            # src/tychoc.c@S_EXPR: a top-level statement's transients live in a
            # per-statement arena. Only at the proc top level, and never around
            # an or_return (which leaves the block).
            sav := cs.arena
            sw := cs.want
            cs.want = ""
            if sav == "&_scope" and not _hasorr(es[0]):
                cs.arena = "&_t"
                c2, t2 := _ex(&cs, es[0])
                cs.arena = sav
                cs.want = sw
                # no transient landed in it -- do not pay arena_new/arena_free
                if not _uses_t(c2):
                    return ind + c2 + ";\n"
                return ind + "{ Arena _t = arena_new(0); " + c2 + "; arena_free(&_t); }\n"
            c, t := _ex(&cs, es[0])
            cs.want = sw
            return ind + c + ";\n"
        ast.Decl(l, n, ann, rhs, vv):
            if len(vv) > 0:
                # `x := if c: a else: b` -- declare the variable, then run the
                # control statement with every value tail rewritten to assign it.
                t0 := ""
                if len(ann) > 0:
                    t0 = _ty(&cs, ann[0])
                if len(t0) == 0:
                    t0 = "?"
                cn0 := _push(&cs, n, t0)
                slot := len(cs.vnames) - 1
                body := _stmt(&cs, parse.rewrite_tails(vv[0], "assign", n, []ast.Expr), ind)
                if cs.vtypes[slot] == "?":
                    _bad("a value-if/value-match with no value tail to type it")
                return ind + _ctyz(&cs, cs.vtypes[slot]) + "" + cn0 + ";\n" + body
            want := ""
