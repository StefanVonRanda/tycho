package emit

import "../ast"
import "core:strings"

# ast -> C, against the same runtime ABI src/tychoc.c targets: one
# `RET h_<fn>(Arena *_parent, ...)` per function, an `arena_child` scope inside
# it, and every allocation made in that scope. A returned value is deep-copied
# into the CALLER's arena before the scope is freed, which is the unoptimised
# form of src/tychoc.c's return-only-escape pass -- correct, and slower.
#
# Four of src/tychoc.c's optimisation passes are ported: the match-arm payload
# borrow (`compiler/emit/emit_stmt.ty@_mroot`), the string self-append accumulator
# (`compiler/emit/emit_support.ty@_acc_scan`), a weak return-slot move, and the
# per-iteration loop scratch arena (`compiler/emit/emit_scope.ty@_curown`). The rest
# are not, and the cost is measured, not guessed. plan.md ranks them.
#
# Scope is the core language: scalars, strings, arrays, structs, enums, control
# flow, functions.
# Everything else dies by name so a fixture fails loudly rather than silently.
#
# THE PACKAGE IS SPLIT ACROSS FILES: this one holds the state structs, package
# mangling and type strings; emit_generics, emit_scope, emit_copy, emit_expr,
# emit_fnval, emit_call, emit_elide, emit_stmt, emit_loop, emit_conc,
# emit_support and emit_unit hold the rest. tychoc reads a package's files in
# sorted order and a struct declared in a LATER file is not visible to an
# earlier one, so every struct stays HERE and every other file must sort after
# `emit.ty` (hence the `emit_` prefix). Functions resolve in any order.

struct SD:
    name: string
    fnames: [string]
    ftypes: [string]
    fcaps: [int]                       # a `bounded[N]T` field's N, else 0
    packed: bool                       # `packed struct`: emitted with the C attribute
    aln: int                           # `align(N) struct`: 0 = unstated, else the N

struct VD:
    name: string
    ptypes: [string]

struct ED:
    name: string
    vnames: [string]
    vpay: [VD]

struct FD:
    name: string
    pnames: [string]
    ptypes: [string]
    pinout: [bool]
    psink: [bool]                      # src/tychoc.c@g_param_sink -- a `sink` (owned) parameter
    pvar: bool
    ret: string
    psize: [string]                    # the `$N` this parameter's `[$N]T` names

struct C:
    sds: [SD]
    eds: [ED]
    fds: [FD]
    akinds: [string]
    vks: [string]                      # vector[N]T kinds, "<N>|<elem>"
    cnames: [string]
    ctypes: [string]
    ccode: [string]
    vnames: [string]
    vtypes: [string]
    vcn: [string]
    vcaps: [int]                       # bounded capacity per local, 0 = unbounded
    vown: [string]
    ntn: [string]
    ntu: [string]
    tks: [string]
    mks: [string]
    fks: [string]
    clos: [string]
    lamd: [string]
    lamp: [string]
    gks: [string]
    gs: [ast.StructD]
    ge: [ast.EnumD]
    gf: [ast.Fn]
    tpn: [string]
    tpv: [string]
    pk: [int]
    ptv: [string]
    ikey: [string]
    iname: [string]
    iarg: [string]
    pendk: [int]
    fpfx: [string]
    ala: [string]
    alp: [string]
    cf: int
    gsf: [int]
    gef: [int]
    gff: [int]
    ntt: [ast.Ty]
    ntf: [int]
    edp: [string]
    want: string
    tmp: int
    cur_ret: string
    loopdepth: int
    arena: string
    oks: [string]
    ewlen: bool
    accs: [string]
    vacc: [string]
    exn: [string]
    smap: [string: int]                # same for structs and enums
    emap: [string: int]
    fmap: [string: int]                # fds name -> index, rebuilt when fds grows
    fnbase: int                        # first local slot; params below it are BORROWS
    hdn: [string]                      # handle type names, and the free fn each names
    hdf: [string]
    ckinds: [string]                   # channel ELEMENT types, one helper family each
    spawnd: [string]                   # per-spawn-site thunk + arg struct
    subn: [string]
    subp: [[ast.Param]]
    sube: [ast.Expr]
    ascope: [string]                   # enclosing loop scratch arenas, innermost last
    uid: int                           # src/tychoc.c@g_forin_uid -- a SECOND counter, not g_blk
    pname: string                      # src/tychoc.c@g_cur_proc_name -- the scratch-arena label
    lbl: int                           # src/tychoc.c@g_loop_lbl -- per-proc, counts EVERY loop
    lpost: [int]                       # src/tychoc.c@g_loop_post -- -1, or the `continue` target
    pbody: [ast.Stmt]                  # src/tychoc.c@g_proc_body -- the move-on-last-use read scan
    elv: [string]                      # src/tychoc.c@g_elide -- monotone loop var,
    ela: [string]                      # and the array its index is proven against
    escs: [string]                     # src/tychoc.c@g_esc -- top-level locals returned by name
    retslot: bool                      # emitting the ELEMENTS of a tuple that is being returned
    used: [string: bool]               # generated helper names the emitted text actually calls
    hdone: [string: bool]              # already written, so a re-run adds only what is new
    lmark: [int]                       # var mark at each loop entry, for break/continue frees
    fua: [string]                      # src/tychoc.c@g_fuse -- push-fused array names
    fuid: [string]                     # each one's hoisted cursor suffix
    fuel: [string]                     # each one's element type
    dbgfile: string                    # -g: src/tychoc.c@g_line_file, empty when off
    fpath: [string]                    # unit i's path, for an f-string HOLE's lex error
    fsrc: [string]                     # unit i's text, so that error shows the real line
    fcore: [bool]                      # unit i lies under the corelib root (_vmath_of)
    constv: [string: int]              # compile-time integer constants used by vector[N]T emission
    rebuild_name: string
    rebuild_paths: [string]
    vlocal: [bool]                     # value declarations, not borrowed pattern/iteration bindings
    ret_local: string
    ret_fields: [string]
    ret_placed: bool
    projection: [string]               # active constructor field path, never a general owner override
    ret_update: int                    # final replacement or counted-loop index, or -1
    ret_store: bool
    ret_loop_inner: int                # final write or guaranteed-writing if/else in a loop, or -1
    ret_loop_iv: string
    ret_loop_bound: string             # stable integer bound's C expression, or empty
    vloop: [int]                       # lexical loop depth where the binding was declared (O3)
    concat_scratch: string             # O3: operands of a promoted declaration's binops
    slice_view: bool                   # O4: emit a string slice as a TychoStrView
    # O5 destination passing (src/tychoc.c@owned_site_variant). A variant of a
    # proc whose parameter at own_idx-1 is OWNED by the caller: `t = f(t, ...)`
    # where t is read once and immediately rebound. Reset by _fnbody.
    own_idx: int                       # 1 + the owned parameter's index, 0 = ordinary proc
    own_name: string                   # that parameter's name
    own_orig: string                   # original proc name
    own_clone: string                  # variant name
    force_own: string                  # the assignment's call, forced onto a variant
    force_orig: string                 # its original proc name
    own_sel: [string: string]          # "<orig>|<index>" -> variant name
    own_idxv: [string: int]            # variant name -> 1 + index
    own_orgv: [string: string]         # variant name -> original name
    own_fd: [int]                      # variant FD indices, in creation order
    own_fns: [ast.Fn]                  # the bodies those variants share
    vowned: [bool]                     # a match binding borrowed from an owned value
    in_ret: bool                       # generating a return expression
    ret_ast: ast.Expr                  # that expression (dummy otherwise)
    own_cf: [int]                      # each variant's declaring file index
    share_place: bool                  # O6: this _rhs3 is a bind; share instead of copying
    shared_get: bool                   # O6: the last top-level _ex was a shallow map read
    copyless_get: bool                 # a read-only map.get local can borrow the descriptor
    pcap: [string]                     # arrays whose presized push loop has proven capacity
    fheap: [string]                    # lambda wrappers with heap environments
    destn: [string]                    # active declaration: allocate this name in a push destination
    desta: [string]
    destvi: [int]                      # persistent: variable indices whose buffer may move there
    destva: [string]
    thin: bool                         # no lambdas and no externs: function values are bare (Arena*, args...) pointers
    nul: bool                          # nullable recursive enums are safe: no nested pattern anywhere
    brep_on: bool                      # --bounds-report: record every array index site
    brep: [string]                     # "<fn>\t<path>:<line>: kept|elided ...", emission order

fn _new() -> C:
    return C([], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], [], -1, [], [], [], []ast.Ty, [], [], "", 0, "void", 0, "&_scope", [], false, [], [], [], []string: int, []string: int, []string: int, 0, [], [], [], [], [], [][ast.Param], []ast.Expr, [], 0, "", 0, []int, []ast.Stmt, [], [], [], false, []string: bool, []string: bool, []int, [], [], [], "", [], [], [], []string: int, "", [], []bool, "", [], false, [], -1, false, -1, "", "", []int, "", false, 0, "", "", "", "", "", []string: string, []string: int, []string: string, []int, []ast.Fn, []bool, false, ast.NullLit(0), []int, false, false, false, []string, []string, []string, []string, []int, []string, false, true, false, []string)

fn _bad(msg: string):
    die("tychoc: " + msg)

# --- package mangling -------------------------------------------------------
# src/tychoc.c@pkg_prefix_for: a name declared in package `geom` is emitted as
# `geom__name`; the ENTRY package carries no prefix. A qualifier resolves
# through the alias table to the package's real name (an aliased import binds
# the alias to the path's last component). Diagnostics keep the source spelling
# -- nothing here is ever printed.

fn _pfx(cs: inout C) -> string:
    if cs.cf < 0 or cs.cf >= len(cs.fpfx):
        return ""
    return cs.fpfx[cs.cf]

fn _qpfx(cs: inout C, q: string) -> string:
    for i := 0; i < len(cs.ala); i += 1:
        if cs.ala[i] == q:
            return cs.alp[i] + "__"
    return q + "__"

fn _pkg_base(path: string) -> string:
    s := path
    if len(s) > 5 and s[0:5] == "core:":
        s = s[5:]
    cut := -1
    for i := 0; i < len(s); i += 1:
        if s[i] == 47:
            cut = i
    if cut < 0:
        return s
    return s[cut + 1:]

fn _ispkg(cs: inout C, q: string) -> bool:
    for i := 0; i < len(cs.ala); i += 1:
        if cs.ala[i] == q:
            return true
    return false

# --- type strings -----------------------------------------------------------
# "int" "float" "bool" "string" "char" "void"; "[T]"; "S~Name"; "E~Name".

# The fixed-width family. Their C types wrap natively at their own width, which
# is why every sized result is cast back to it -- integer promotion would take
# `u8 * u8` to `int` and 400 would print as 400 rather than 144.
fn _is_uint(t: string) -> bool:
    return t == "u8" or t == "u16" or t == "u32" or t == "u64"

fn _is_sint(t: string) -> bool:
    return t == "i8" or t == "i16" or t == "i32" or t == "i64"

fn _width(t: string) -> int:
    if t == "u8" or t == "i8":
        return 8
    if t == "u16" or t == "i16":
        return 16
    if t == "u32" or t == "i32":
        return 32
    return 64

fn _is_sized(t: string) -> bool:
    return _is_uint(t) or _is_sint(t) or t == "f32"

fn _is_arr(t: string) -> bool:
    return len(t) > 2 and t[0] == 91

fn _elem(t: string) -> string:
    return t[1:len(t) - 1]

fn _is_struct(t: string) -> bool:
    return strings.starts_with(t, "S~")

fn _is_enum(t: string) -> bool:
    return strings.starts_with(t, "E~")

# A fixed-size user enum can be stored inline when every payload is a scalar.
# Fieldless enums stay in the old cell representation because maps use their
# singleton tag table; generated Option/Result enums stay pointers because
# their lowering is shared with the rest of the compiler.
fn _inline_enum(cs: inout C, n: string) -> bool:
    if len(getenv("TYCHOC_NO_INLINE_ENUM")) > 0:
        return false
    if _is_gen(n) or strings.contains(n, "__"):
        return false
    ei := _eidx(&cs, n)
    if ei < 0:
        return false
    any := false
    for v in cs.eds[ei].vpay:
        for p in v.ptypes:
            if not (_is_sized(p) or p == "int" or p == "float" or p == "bool" or p == "char"):
                return false
            any = true
    return any

fn _tname(t: string) -> string:
    return t[2:]

# A two-variant recursive enum with one empty variant and one payload variant
# uses the pointer's NULL as the empty variant. `enum Tree: Leaf | Node(Tree,
# Tree)` becomes a 16-byte payload (`two E_Tree *`) instead of a 24-byte tagged
# cell: binary_trees' node drops 24 -> 16 bytes and its large row matches the C
# arena's node size. Restricted to recursive enums so Option/Result and scalar
# enums keep their dedicated lowering.
fn _nul_enum(cs: inout C, en: string) -> bool:
    if not cs.nul:
        return false
    ei := _eidx(&cs, en)
    if ei < 0 or _inline_enum(&cs, en):
        return false
    if len(cs.eds[ei].vnames) != 2:
        return false
    empty := 0
    pay := 0
    rec := false
    for t := 0; t < len(cs.eds[ei].vnames); t += 1:
        ps := cs.eds[ei].vpay[t].ptypes
        if len(ps) == 0:
            empty = empty + 1
            continue
        pay = pay + 1
        for p in ps:
            if p == "E~" + en:
                rec = true
    return empty == 1 and pay == 1 and rec

# A newtype is ERASED in lowering (spec 5.4): it is represented exactly as its
# underlying type, so `_ty` resolves the name away and nothing downstream ever
# sees one.
fn _ntidx(cs: inout C, n: string) -> int:
    p := _pfx(&cs)
    if len(p) > 0:
        for i := 0; i < len(cs.ntn); i += 1:
            if cs.ntn[i] == p + n:
                return i
    for i := 0; i < len(cs.ntn); i += 1:
        if cs.ntn[i] == n:
            return i
    return -1

# A tuple type is stamped out like an array kind: the registry key is the
# element type strings joined by "|", and the type string is "T~<index>".
fn _is_tup(t: string) -> bool:
    return strings.starts_with(t, "T~")

fn _tkind(cs: inout C, key: string) -> int:
    for i := 0; i < len(cs.tks); i += 1:
        if cs.tks[i] == key:
            return i
    push(cs.tks, key)
    return len(cs.tks) - 1

fn _tjoin(es: [string]) -> string:
    k := ""
    for i := 0; i < len(es); i += 1:
        if i > 0:
            k = k + "|"
        k = k + es[i]
    return k

# Concatenate generated C pieces in one pass. Repeated string `+` reallocates
# and copies the accumulated prefix each time, making a flat elif chain's output
# quadratic even after its AST and C control flow are flattened.
fn _join_code(pieces: [string]) -> string:
    bs := []int
    for part in pieces:
        for i := 0; i < len(part); i += 1:
            push(bs, part[i])
    return to_str(to_bytes(bs))

fn _telems(cs: inout C, t: string) -> [string]:
    i := strings.parse_int_prefix(_tname(t))
    return split(cs.tks[i], "|")

fn _tup_of(cs: inout C, es: [string]) -> string:
    return "T~" + str(_tkind(&cs, _tjoin(es)))

# A map type is stamped out per (key, value) pair exactly as a tuple kind is:
# the registry key is "K|V" and the type string is "M~<index>". The emitted C
# mirrors src/tychoc.c:17101's compact indexed dict -- an int32 index table over
# dense insertion-ordered entries -- so keys() order and str() form agree.
# The `$N` a parameter's written type names, if it is `[$N]T`. Emit lowers every
# array to the dynamic one, so N is not a monomorphisation key here: inside the
# body it is the argument's own length, which for a fixed array IS N.
fn _sizep_of(t: [ast.Ty]) -> string:
    if len(t) == 0:
        return ""
    match t[0]:
        ast.TFix(sz, e):
            if len(sz) > 1 and sz[0] == 36:
                return sz[1:]
            return ""
        _: return ""
    return ""

# A `bounded[N]T` capacity, from the type AS WRITTEN. Emit lowers a bounded
# array to the dynamic one, so N survives nowhere else -- and without it the
# over-capacity push, whose whole point is to trap, silently grew the array.
# The bounded capacity of a push TARGET, when it is a field of a struct whose
# declaration named one. A local's own `bounded[N]` annotation is not tracked
# here.
fn _cap_of_target(cs: inout C, e: ast.Expr) -> int:
    match e:
        ast.Field(l, r, f):
            rt := _argtypes(&cs, r)[0]
            if _is_struct(rt):
                si := _sidx(&cs, _tname(rt))
                if si >= 0:
                    for j := 0; j < len(cs.sds[si].fnames) and j < len(cs.sds[si].fcaps); j += 1:
                        if cs.sds[si].fnames[j] == f:
                            return cs.sds[si].fcaps[j]
            return 0
        ast.Name(l, n):
            return _vcap(&cs, n)
        _: return 0
    return 0

fn _capof(cs: inout C, t: ast.Ty) -> int:
    match t:
        ast.TBnd(sz, e):
            if len(sz) > 0 and sz[0] >= 48 and sz[0] <= 57:
                return _dec2(sz)
            ci := _cidx(&cs, sz)
            if ci >= 0:
                return _dec2(cs.ccode[ci])
            return 0
        _: return 0
    return 0

fn _dec2(s: string) -> int:
    v := 0
    for i := 0; i < len(s); i += 1:
        if s[i] < 48 or s[i] > 57:
            return v
        v = v * 10 + (s[i] - 48)
    return v

fn _is_handle(t: string) -> bool:
    return len(t) > 2 and t[0:2] == "H~"

fn _hfree(cs: inout C, t: string) -> string:
    n := t[2:]
    for i := 0; i < len(cs.hdn); i += 1:
        if cs.hdn[i] == n:
            return cs.hdf[i]
    return ""

fn _hidx(cs: inout C, n: string) -> int:
    for i := 0; i < len(cs.hdn); i += 1:
        if cs.hdn[i] == n:
            return i
    return -1

fn _is_chan(t: string) -> bool:
    return len(t) > 5 and t[0:5] == "chan("

fn _is_task(t: string) -> bool:
    return len(t) > 5 and t[0:5] == "task("

# The channel's element type, and the family index that names its helpers.
fn _cinner(t: string) -> string:
    if _is_chan(t) or _is_task(t):
        return t[5:len(t) - 1]
    return "?"

fn _ckind(cs: inout C, elem: string) -> int:
    for i := 0; i < len(cs.ckinds); i += 1:
        if cs.ckinds[i] == elem:
            return i
    push(cs.ckinds, elem)
    return len(cs.ckinds) - 1

fn _is_map(t: string) -> bool:
    return strings.starts_with(t, "M~")

fn _mkind(cs: inout C, key: string) -> int:
    for i := 0; i < len(cs.mks); i += 1:
        if cs.mks[i] == key:
            return i
    push(cs.mks, key)
    return len(cs.mks) - 1

fn _map_of(cs: inout C, k: string, v: string) -> string:
    return "M~" + str(_mkind(&cs, k + "|" + v))

fn _mparts(cs: inout C, t: string) -> [string]:
    i := strings.parse_int_prefix(_tname(t))
    return split(cs.mks[i], "|")

fn _mkey(cs: inout C, t: string) -> string:
    return _mparts(&cs, t)[0]

fn _mval(cs: inout C, t: string) -> string:
    return _mparts(&cs, t)[1]

fn _mpfx(cs: inout C, t: string) -> string:
    return "tycho_mapM" + _tname(t)

# A soa type is stamped out per ELEMENT STRUCT, keyed by the struct's type
# string, and spelled "O~<index>". src/tychoc.c:17257 emits the same shape: one
# growable arena buffer per field plus a shared len/cap.
fn _is_soa(t: string) -> bool:
    return strings.starts_with(t, "O~")

fn _okind(cs: inout C, key: string) -> int:
    for i := 0; i < len(cs.oks); i += 1:
        if cs.oks[i] == key:
            return i
    push(cs.oks, key)
    return len(cs.oks) - 1

fn _soa_of(cs: inout C, st: string) -> string:
    if not _is_struct(st):
        _bad("a soa element must be a struct, not '" + st + "'")
    return "O~" + str(_okind(&cs, st))

fn _selem(cs: inout C, t: string) -> string:
    return cs.oks[strings.parse_int_prefix(_tname(t))]

fn _spfx(cs: inout C, t: string) -> string:
    return "Soa" + _tname(t)

# `ps[i].x` -> `((ps).fN[SoaK_bound(&(ps), i)])`. The bound call is emitted per
# OCCURRENCE, matching ./tychoc: `ps[2].z = ps[2].z + 1` checks twice.
fn _soafld(cs: inout C, bc: string, bt: string, ic: string, f: string) -> (string, string):
    st := _selem(&cs, bt)
    si := _sidx(&cs, _tname(st))
    for i := 0; i < len(cs.sds[si].fnames); i += 1:
        if cs.sds[si].fnames[i] == f:
            return ("((" + bc + ").f" + str(i) + "[" + _spfx(&cs, bt) + "_bound(&(" +
                bc + "), " + ic + ")])", cs.sds[si].ftypes[i])
    _bad("no field '" + f + "' on " + _tname(st))
    return ("", "")

# `vector[N]T` is spelled "V~<index>" into cs.vks, "<N>|<elem>". Unlike every
# other fixed form here it does NOT lower to the dynamic array: the C body is a
# GCC vector member, matching src/tychoc.c@emit_aggregate, so the arithmetic is
# one machine instruction and the value never touches the arena.
fn _is_vec(t: string) -> bool:
    return strings.starts_with(t, "V~")

fn _vkind(cs: inout C, key: string) -> int:
    for i := 0; i < len(cs.vks); i += 1:
        if cs.vks[i] == key:
            return i
    push(cs.vks, key)
    return len(cs.vks) - 1

fn _vec_of(cs: inout C, n: int, el: string) -> string:
    return "V~" + str(_vkind(&cs, str(n) + "|" + el))

fn _vparts(cs: inout C, t: string) -> [string]:
    return split(cs.vks[strings.parse_int_prefix(_tname(t))], "|")

fn _vn(cs: inout C, t: string) -> int:
    return strings.parse_int_prefix(_vparts(&cs, t)[0])

fn _velem(cs: inout C, t: string) -> string:
    return _vparts(&cs, t)[1]

# A lane named by an integer LITERAL inside 0..N-1 cannot be out of range, so
# the bounds check is provably dead and the read lowers to `.v[k]` directly.
# Returns -1 for anything else -- a runtime index, a computed one, or a literal
# outside the count -- which keeps the check: an out-of-range vector access is a
# wrong answer or a misaligned load, not a crash, so over-eager elision is worse
# than the check. src/tychoc.c@vec_lane_const is the bootstrap twin.
fn _vlane(cs: inout C, t: string, idx: ast.Expr) -> int:
    match idx:
        ast.IntLit(l, v):
            if v >= 0 and v < _vn(&cs, t):
                return v
        _: pass
    return -1

# src/tychoc.c@lane_index. tychoc rewrites `v.x` to `v[0]` in its resolver;
# this AST is a value type, so the lowering happens at the two emit sites
# instead. Both answer `false` for anything but a lane name on a vector or an
# array, which is what leaves every struct field on the struct path.
fn _lane_index(f: string) -> int:
    if f == "x" or f == "r":
        return 0
    if f == "y" or f == "g":
        return 1
    if f == "z" or f == "b":
        return 2
    if f == "w" or f == "a":
        return 3
    return -1

fn _lane_read(cs: inout C, rc: string, rt: string, f: string) -> (string, string, bool):
    k := _lane_index(f)
    if k < 0:
        return ("", "", false)
    if _is_vec(rt):
        return ("(" + rc + ").v[" + str(k) + "]", _velem(&cs, rt), true)
    if _is_arr(rt):
        et := _elem(rt)
        return (_arrf(&cs, et, "_get") + "(" + rc + ", " + _ilit(k) + ")", et, true)
    return ("", "", false)

fn _lane_place(cs: inout C, rc: string, rt: string, f: string) -> (string, string, bool):
    k := _lane_index(f)
    if k < 0:
        return ("", "", false)
    if _is_vec(rt):
        return ("((" + rc + ").v[" + str(k) + "])", _velem(&cs, rt), true)
    if _is_arr(rt):
        et := _elem(rt)
        return ("(*" + _arrf(&cs, et, "_ptr") + "(&(" + rc + "), " + _ilit(k) + "))", et, true)
    return ("", "", false)

fn _vecf(cs: inout C, t: string, op: string) -> string:
    return "tycho_vec_V" + _tname(t) + op

# How a key is REPRESENTED in the entry table: a fieldless enum is stored as its
# tag, so `keys()` has to rebuild the singleton (src/tychoc.c:17135).
fn _kclass(cs: inout C, k: string) -> string:
    if k == "string":
        return "str"
    if k == "int" or k == "char" or k == "bool":
        return "int"
    if _is_enum(k):
        return "enum"
    if _is_struct(k) or _is_tup(k) or _is_arr(k) or _is_vec(k):
        return "comp"
    _bad("a map key of type '" + k + "' is not hashable")
    return ""

fn _kslot(cs: inout C, k: string) -> string:
    c := _kclass(&cs, k)
    if c == "str":
        return "char *"
    if c == "int" or c == "enum":
        return "tycho_int "
    return _ctyz(&cs, k) + ""

# The key as the generated functions take it, from a Tycho-level value.
fn _keyrt(cs: inout C, k: string, code: string) -> string:
    if _kclass(&cs, k) == "enum":
        return "((tycho_int)((" + code + ")->tag))"
    return code

fn _khash(cs: inout C, k: string, e: string) -> string:
    c := _kclass(&cs, k)
    if c == "str":
        return "tycho_si_hash(" + e + ")"
    if c == "int" or c == "enum":
        return "tycho_ik_hash_map((tycho_int)(" + e + "))"
    return _hash(&cs, k, e)

fn _kmatch(cs: inout C, k: string, ek: string, q: string) -> string:
    c := _kclass(&cs, k)
    if c == "str":
        # strcmp stops at the first NUL, so "a" and "a\0b" compared EQUAL
        # whenever the seed put them in one bucket -- tests/strbytes.ty failed
        # about one run in five. tycho_str_cmp carries the length.
        return "tycho_str_eq(" + ek + ", " + q + ")"
    if c == "int" or c == "enum":
        # Bare, as src/tychoc.c's mapc_kmatch spells it: both call sites wrap it in
        # `if (...)`, and the extra pair made clang warn -Wparentheses-equality in
        # every build of a program with an int- or enum-keyed map.
        return ek + " == " + q
    return _eq(&cs, ek, q, k)

fn _kcopy(cs: inout C, k: string) -> string:
    c := _kclass(&cs, k)
    if c == "str":
        return "tycho_str_intern_copy(a, k)"
    if c == "int" or c == "enum":
        return "k"
    return _copy(&cs, "k", k, "a")

# A struct/tuple key hashes field-wise, FNV-folded from the per-process seed --
# src/tychoc.c:13253's gen_hash, which is what makes `==`-equal values hash equal.
fn _hashable(cs: inout C, t: string) -> bool:
    return _hashable_d(&cs, t, []string: bool)

# `seen` is the aggregates on the CURRENT path, taken by value so it unwinds on
# return. A struct whose field is an array OF ITSELF is a legal recursive shape;
# re-entering one answers false (a cycle has no bottom to hash from) instead of
# recursing forever. This replaced a `d > 8` cap, which also cut a legal
# acyclic nesting deeper than 8 -- with no diagnostic naming the cap.
fn _hashable_d(cs: inout C, t: string, seen: [string: bool]) -> bool:
    if t == "int" or t == "char" or t == "bool" or t == "float" or t == "string":
        return true
    if _is_enum(t):
        i := _eidx(&cs, t[2:])
        if i < 0:
            return false
        for v in cs.eds[i].vpay:
            if len(v.ptypes) > 0:
                return false
        return true
    if _is_arr(t):
        return _hashable_d(&cs, _elem(t), seen)
    if _is_vec(t):
        return _hashable_d(&cs, _velem(&cs, t), seen)
    if _is_struct(t):
        i2 := _sidx(&cs, _tname(t))
        if i2 < 0:
            return false
        k := "s:" + _tname(t)
        if k in seen:
            return false
        down := seen
        down[k] = true
        for ft in cs.sds[i2].ftypes:
            if not _hashable_d(&cs, ft, down):
                return false
        return true
    if _is_tup(t):
        if t in seen:
            return false
        down2 := seen
        down2[t] = true
        for et in _telems(&cs, t):
            if not _hashable_d(&cs, et, down2):
                return false
        return true
    return false

# The DETERMINISTIC twin of _hash: the `hash()` builtin must not depend on the
# per-process map seed, so it uses the runtime's `_det` family and the generated
# `dhash` bodies (src/tychoc.c emits the same pair).
# ---------------------------------------------------------- dead helpers
#
# A generated helper family is emitted whole -- one [float] anywhere gives the
# unit every operation on it -- and most of a unit's helpers are never called.
# `_u` is threaded through the four funnels that FORM a helper's name (_copy,
# _eq, _tostr, _hash/_hash_det), so a name is live exactly when something the
# unit emits mentions it; `_need` answers "live, and not written yet".
#
# The closure is transitive because a helper's own generator goes through the
# same funnels: writing tycho_str_S_x marks the str of every field type. That
# only terminates if the generators are RE-RUN while the live set grows, which
# is the fixpoint at the end of `program` -- `_need` is what keeps a re-run
# from writing anything twice.
fn _u(cs: inout C, n: string) -> string:
    cs.used[n] = true
    return n

fn _once(cs: inout C, n: string) -> bool:
    if n in cs.hdone:
        return false
    cs.hdone[n] = true
    return true

fn _need(cs: inout C, n: string) -> bool:
    if not (n in cs.used):
        return false
    if n in cs.hdone:
        return false
    cs.hdone[n] = true
    return true

fn _hash_det(cs: inout C, t: string, v: string) -> string:
    if t == "string" or t == "bytes":
        return "tycho_si_hash_det(" + v + ")"
    if t == "float":
        return "tycho_ik_hash_det(tycho_float_hashbits(" + v + "))"
    if _is_enum(t):
        if _inline_enum(&cs, _tname(t)):
            return "tycho_ik_hash_det((tycho_int)((" + v + ").tag))"
        return "tycho_ik_hash_det((tycho_int)((" + v + ")->tag))"
    if _is_vec(t):
        return _u(&cs, _vecf(&cs, t, "_dhash")) + "(" + v + ")"
    if _is_struct(t):
        dsn := _u(&cs, "tycho_dhash_S_" + _tname(t))
        return dsn + "(" + v + ")"
    if _is_tup(t):
        dtn := _u(&cs, "tycho_dhash_T" + _tname(t))
        return dtn + "(" + v + ")"
    if _is_arr(t):
        e := _elem(t)
        if e == "int":
            return "tycho_arr_int_hash_det(" + v + ")"
        if e == "float":
            return "tycho_arr_float_hash_det(" + v + ")"
        if e == "string":
            return "tycho_arr_str_hash_det(" + v + ")"
        adn := "tycho_arr_K" + str(_akind(&cs, e)) + "_dhash"
        return _u(&cs, adn) + "(" + v + ")"
    return "tycho_ik_hash_det((tycho_int)(" + v + "))"

fn _hash(cs: inout C, t: string, v: string) -> string:
    if t == "string":
        return "tycho_si_hash(" + v + ")"
    if t == "float":
        return "tycho_ik_hash(tycho_float_hashbits(" + v + "))"
    if _is_enum(t):
        if _inline_enum(&cs, _tname(t)):
            return "tycho_ik_hash((tycho_int)((" + v + ").tag))"
        return "tycho_ik_hash((tycho_int)((" + v + ")->tag))"
    if _is_vec(t):
        return _u(&cs, _vecf(&cs, t, "_hash")) + "(" + v + ")"
    if _is_struct(t):
        hsn := _u(&cs, "tycho_hash_S_" + _tname(t))
        return hsn + "(" + v + ")"
    if _is_tup(t):
        htn := _u(&cs, "tycho_hash_T" + _tname(t))
        return htn + "(" + v + ")"
    if _is_arr(t):
        e := _elem(t)
        if e == "int":
            return "tycho_arr_int_hash(" + v + ")"
        if e == "float":
            return "tycho_arr_float_hash(" + v + ")"
        if e == "string":
            return "tycho_arr_str_hash(" + v + ")"
        ahn := "tycho_arr_K" + str(_akind(&cs, e)) + "_hash"
        return _u(&cs, ahn) + "(" + v + ")"
    return "tycho_ik_hash((tycho_int)(" + v + "))"

# Option and Result are monomorphised into ordinary enums, one per
# instantiation, named `_G<n>` so `_bare_variant` can tell them from a user
# enum -- otherwise a bare `Ok` would resolve into a generated one.
fn _gname(cs: inout C, key: string) -> string:
    for i := 0; i < len(cs.gks); i += 1:
        if cs.gks[i] == key:
            return "_G" + str(i)
    push(cs.gks, key)
    return "_G" + str(len(cs.gks) - 1)

fn _is_gen(n: string) -> bool:
    return strings.starts_with(n, "_G")

# The payload type of an Option INSTANCE (the enum's Some arm).
fn _opt_inner(cs: inout C, t: string) -> string:
    if not _is_optT(&cs, t):
        return ""
    ei := _eidx(&cs, _tname(t))
    if ei < 0:
        return ""
    pay := cs.eds[ei].vpay[_tag(&cs, ei, "Some")].ptypes
    if len(pay) == 0:
        return ""
    return pay[0]

fn _opt_of(cs: inout C, t: string) -> string:
    nm := _gname(&cs, "O|" + t)
    if _eidx(&cs, nm) < 0:
        vs := []VD
        push(vs, VD("None", []string))
        ps := []string
        push(ps, t)
        push(vs, VD("Some", ps))
        push(cs.eds, ED(nm, ["None", "Some"], vs))
        push(cs.edp, "")
    return "E~" + nm

fn _res_of(cs: inout C, t: string, e: string) -> string:
    nm := _gname(&cs, "R|" + t + "|" + e)
    if _eidx(&cs, nm) < 0:
        ok := []string
        if t != "void":
            push(ok, t)
        er := []string
        push(er, e)
        vs := []VD
        push(vs, VD("Ok", ok))
        push(vs, VD("Err", er))
        push(cs.eds, ED(nm, ["Ok", "Err"], vs))
        push(cs.edp, "")
    return "E~" + nm

# `want` is the type an expression is being built FOR. `None` and `Err(e)` carry
# no way to name their own instantiation, so without it they cannot be emitted.
fn _is_optT(cs: inout C, t: string) -> bool:
    if not _is_enum(t):
        return false
    i := _eidx(&cs, _tname(t))
    return i >= 0 and _is_gen(_tname(t)) and cs.eds[i].vnames[0] == "None"

fn _is_resT(cs: inout C, t: string) -> bool:
    if not _is_enum(t):
        return false
    i := _eidx(&cs, _tname(t))
    return i >= 0 and _is_gen(_tname(t)) and cs.eds[i].vnames[0] == "Ok"

# A type whose value owns arena memory: copying it means a deep copy.
fn _heap(cs: inout C, t: string) -> bool:
    if t == "string" or t == "bytes":
        return true
    if _is_fn(t):
        return not cs.thin
    if _is_enum(t):
        return not _inline_enum(&cs, _tname(t))
    if _is_arr(t) or _is_map(t) or _is_soa(t):
        return true
    if _is_struct(t):
        i := _sidx(&cs, _tname(t))
        if i < 0:
            return false
        for ft in cs.sds[i].ftypes:
            if _heap(&cs, ft):
                return true
    if _is_tup(t):
        for et in _telems(&cs, t):
            if _heap(&cs, et):
                return true
    return false

# --- syntactic type -> type string ------------------------------------------

fn _ty(cs: inout C, t: ast.Ty) -> string:
    match t:
        ast.TPrim(p):
            if p == "int" or p == "float" or p == "bool" or p == "string" or p == "char" or p == "void":
                return p
            if _is_sized(p) or p == "bytes" or p == "ptr":
                return p
            _bad("unsupported primitive type '" + p + "' -- Phase 8")
        ast.TName(q, n0, targs):
            n := n0
            if len(q) > 0:
                n = _qpfx(&cs, q) + n0
            if len(q) == 0 and len(targs) == 0 and n == "void":
                return "void"
            if len(q) == 0 and n == "Option" and len(targs) == 1:
                return _opt_of(&cs, _ty(&cs, targs[0]))
            if len(q) == 0 and n == "Result" and len(targs) == 2:
                return _res_of(&cs, _ty(&cs, targs[0]), _ty(&cs, targs[1]))
            if len(targs) == 0 and _hidx(&cs, n0) >= 0:
                return "H~" + n0
            if len(q) == 0 and n == "Channel" and len(targs) == 1:
                et := _ty(&cs, targs[0])
                _ckind(&cs, et)
                return "chan(" + et + ")"
            if len(q) == 0 and n == "Task" and len(targs) == 1:
                return "task(" + _ty(&cs, targs[0]) + ")"
            if len(targs) > 0:
                as2 := []string
                for a in targs:
                    push(as2, _ty(&cs, a))
                if _gsidx(&cs, n) >= 0:
                    return _inst_struct(&cs, n, as2)
                if _geidx(&cs, n) >= 0:
                    return _inst_enum(&cs, n, as2)
                _bad("generic type '" + n0 + "' -- Phase 8")
            # A DECLARED type of that name wins over a type parameter spelled
            # the same (corelib/testing's `T`); see _unify's matching guard.
            tv := _tpget(&cs, n)
            if len(tv) > 0 and not _declared_short(&cs, n0):
                return tv
            ni := _ntidx(&cs, n)
            if ni >= 0:
                if len(cs.ntu[ni]) == 0:
                    _bad("newtype '" + n + "' used before its underlying type resolves")
                return cs.ntu[ni]
            si0 := _sidx(&cs, n)
            if si0 >= 0:
                return "S~" + cs.sds[si0].name
            ei0 := _eidx(&cs, n)
            if ei0 >= 0:
                return "E~" + cs.eds[ei0].name
            _bad("unknown type '" + n0 + "'")
        ast.TArr(es):
            return "[" + _ty(&cs, es[0]) + "]"
        ast.TParam(n):
            v := _tpget(&cs, n)
            if len(v) == 0:
                _bad("unbound type parameter '$" + n + "'")
            return v
        ast.TFix(n, e):
            # `[N]T` lowers to the dynamic array. The static rules -- the length
            # being a compile-time constant, no push -- are the checker's, which
            # has already run by here; what is left for emit is the values.
            return "[" + _ty(&cs, e[0]) + "]"
        ast.TMap(e):
            kt := _ty(&cs, e[0])
            return _map_of(&cs, kt, _ty(&cs, e[1]))
        ast.TTup(e):
            es2 := []string
            for x in e:
                push(es2, _ty(&cs, x))
            return _tup_of(&cs, es2)
        ast.TFn(h, e):
            ps2 := []string
            nps := len(e)
            r2 := "void"
            if h:
                nps -= 1
                r2 = _ty(&cs, e[nps])
            for i := 0; i < nps; i += 1:
                push(ps2, _ty(&cs, e[i]))
            return _fn_of(&cs, r2, ps2)
        ast.TSoa(e):
            return _soa_of(&cs, _ty(&cs, e[0]))
        ast.TVec(n, e):
            # The checker allows an int `const` as well as a literal. Resolve
            # that spelling in the current package, matching its `_vec_count`
            # rule; otherwise the emitter silently made vector[N] into V0.
            count := strings.parse_int_prefix(n)
            key := _pfx(&cs) + n
            if key in cs.constv:
                count = cs.constv[key]
            elif n in cs.constv:
                count = cs.constv[n]
            return _vec_of(&cs, count, _ty(&cs, e[0]))
        ast.TBnd(n, e):
            # `bounded[N]T` lowers to the dynamic array too. NOT covered by this:
            # the capacity trap on an over-cap push, which needs N carried in the
            # type string -- tests/bounded_const_cap.ty is what would show it.
            return "[" + _ty(&cs, e[0]) + "]"
        _: _bad("unsupported type form -- Phase 8")
    return ""

# True when every name in `t` already resolves -- used to order newtype
# resolution without letting `_ty` die on a forward reference.
fn _ty_ready(cs: inout C, t: ast.Ty) -> bool:
    match t:
        ast.TPrim(p): return true
        ast.TParam(n): return len(_tpget(&cs, n)) > 0
        ast.TName(q, n0, targs):
            n := n0
            if len(q) > 0:
                n = _qpfx(&cs, q) + n0
            if len(targs) > 0:
                for a in targs:
                    if not _ty_ready(&cs, a):
                        return false
                return _gsidx(&cs, n) >= 0 or _geidx(&cs, n) >= 0
            if len(_tpget(&cs, n)) > 0:
                return true
            ni := _ntidx(&cs, n)
            if ni >= 0:
                return len(cs.ntu[ni]) > 0
            return _sidx(&cs, n) >= 0 or _eidx(&cs, n) >= 0
        ast.TArr(es): return _ty_ready(&cs, es[0])
        ast.TMap(es):
            return _ty_ready(&cs, es[0]) and _ty_ready(&cs, es[1])
        ast.TTup(es):
            for x in es:
                if not _ty_ready(&cs, x):
                    return false
            return true
        _: return false
    return false

fn _tyo(cs: inout C, ts: [ast.Ty]) -> string:
    if len(ts) == 0:
        return "void"
    if len(ts) > 1:
        es := []string
        for x in ts:
            push(es, _ty(&cs, x))
        return _tup_of(&cs, es)
    return _ty(&cs, ts[0])
