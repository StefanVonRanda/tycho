package emit

import "../ast"
import "../parse"
import "core:strings"

# Places (assignment targets), the statement emitter (_stmt), and match with
# its arm payload borrow. Moved verbatim out of emit.ty.

# --- places (assignment targets) --------------------------------------------

fn _lvalue(cs: inout C, e: ast.Expr) -> (string, string):
    match e:
        ast.Name(l, n):
            t := _vtype(&cs, n)
            if len(t) == 0:
                _bad("assignment to unknown name '" + n + "'")
            return (_vcname(&cs, n), t)
        ast.Field(l, r, f):
            # The scatter write `ps[i].x = v`. The projection is already a C
            # lvalue, so the read and write paths emit the same expression.
            match r[0]:
                ast.Index(l3, k3):
                    bc3, bt3 := _lvalue(&cs, k3[0])
                    if _is_soa(bt3):
                        ic4, it4 := _ex(&cs, k3[1])
                        return _soafld(&cs, bc3, bt3, ic4, f)
                _: pass
            rc, rt := _lvalue(&cs, r[0])
            lc8, lt8, lok8 := _lane_place(&cs, rc, rt, f)
            if lok8:
                return (lc8, lt8)
            si := _sidx(&cs, _tname(rt))
            if si < 0:
                _bad("field assignment on a non-struct")
            for i := 0; i < len(cs.sds[si].fnames); i += 1:
                if cs.sds[si].fnames[i] == f:
                    return ("((" + rc + ").f_" + f + ")", cs.sds[si].ftypes[i])
            _bad("no field '" + f + "' on " + _tname(rt))
        ast.TupIdx(l, k, n):
            rc, rt := _lvalue(&cs, k[0])
            if not _is_tup(rt):
                _bad("`.` assignment on a non-tuple")
            es := _telems(&cs, rt)
            return ("((" + rc + ").f" + str(n) + ")", es[n])
        ast.Index(l, k):
            rc, rt := _lvalue(&cs, k[0])
            ic, it := _ex(&cs, k[1])
            if _is_map(rt):
                vt := _mval(&cs, rt)
                return ("(*" + _mpfx(&cs, rt) + "_slotptr(" + _ownerof(&cs, k[0]) + ", &(" + rc + "), " +
                    _keyrt(&cs, _mkey(&cs, rt), ic) + "))", vt)
            if _is_vec(rt):
                lk2 := _vlane(&cs, rt, k[1])
                if lk2 >= 0:
                    return ("((" + rc + ").v[" + str(lk2) + "])", _velem(&cs, rt))
                return ("(*" + _u(&cs, _vecf(&cs, rt, "_ptr")) + "(&(" + rc + "), " + ic + "))",
                    _velem(&cs, rt))
            if not _is_arr(rt):
                _bad("indexed assignment on a non-array")
            et := _elem(rt)
            if _in_range(&cs, k[0], k[1]):   # monotone loop index: project without the check
                _bnote(&cs, l, "elided monotone")
                return ("((" + rc + ").data[" + ic + "])", et)
            _bnote(&cs, l, "kept set")
            return ("(*" + _arrf(&cs, et, "_ptr") + "(&(" + rc + "), " + ic + "))", et)
        ast.Call(l, q, n, tas, args):
            # A subscript call IS a place: `g.edge(1).weight = 99` writes
            # through the projection, so the lvalue path inlines it too.
            sxl := _subidx(&cs, n)
            if sxl < 0:
                _bad("unsupported assignment target")
            ua2 := []ast.Expr
            if len(q) > 0:
                push(ua2, ast.Name(l, q))
            for a in args:
                push(ua2, a)
            return _subinline(&cs, sxl, ua2, true)
        ast.CallVal(l, k):
            sc2, st4, ok4 := _subcallval(&cs, k, true)
            if not ok4:
                _bad("unsupported assignment target")
            return (sc2, st4)
        _: _bad("unsupported assignment target")
    return ("", "")

# --- statements -------------------------------------------------------------

# src/tychoc.c@cond_unwrap -- an if/while condition drops ONE redundant outer
# paren pair, so `if ((a > b))` reads `if (a > b)`.
# src/tychoc.c@expr_has_orreturn
fn _hasorr(e: ast.Expr) -> bool:
    match e:
        ast.OrRet(l, b9, k): return true
        _: pass
    for c in ast.kids(e):
        if _hasorr(c):
            return true
    return false

# src/tychoc.c@expr_has_call
fn _hascall(e: ast.Expr) -> bool:
    match e:
        ast.Call(l, q, n, t, a): return true
        ast.CallVal(l, k): return true
        _: pass
    for c in ast.kids(e):
        if _hascall(c):
            return true
    return false

# src/tychoc.c@expr_refs_local: does this initialiser read the name it binds?
# A lambda contributes only its CAPTURES, so a parameter of the same name is
# not a reference to the enclosing binding.
fn _refslocal(e: ast.Expr, n: string) -> bool:
    match e:
        ast.Name(l, v): return v == n
        ast.Call(l, q, cn, t, a):
            if len(q) == 0 and cn == n:      # calling the fn value it rebinds
                return true
        ast.Lambda(l, p, r, b):
            for q in p:
                if q.name == n:
                    return false
        _: pass
    for c in ast.kids(e):
        if _refslocal(c, n):
            return true
    return false

fn _cunwrap(s: string) -> string:
    n := len(s)
    if n < 3 or s[0] != 40:
        return s
    if s[1] == 123:
        return s
    d := 0
    i := 0
    for i < n:
        c := s[i]
        if c == 34 or c == 39:
            i += 1
            for i < n and s[i] != c:
                if s[i] == 92 and i + 1 < n:
                    i += 1
                i += 1
            if i >= n:
                return s
            i += 1
            continue
        if c == 40:
            d += 1
        elif c == 41:
            d -= 1
            if d == 0:
                if i + 1 != n:
                    return s
                return s[1:n - 1]
        i += 1
    return s

# A statement's value thrown away: a statement expression -- `wait(t)` is
# `({ ...join...; _w; })` -- ends on a value C warns is unused
# (-Wunused-value; scripts/emit_warn.sh), so it is cast to void.
fn _discard(c: string, t: string) -> string:
    if t != "void" and len(c) > 2 and c[0:2] == "({":
        return "(void)" + c
    return c

fn _stmt(cs: inout C, s: ast.Stmt, ind: string) -> string:
    match s:
        ast.PassS(l):
            return ""                  # src/tychoc.c:16991 -- the no-op emits none
        ast.ExprStmt(l, es):
            # src/tychoc.c@S_EXPR: a top-level statement's transients live in a
            # per-statement arena. Only at the proc top level, and never around
            # an or_return (which leaves the block).
            sav := cs.arena
            sw := cs.want
            cs.want = ""
            if sav == "&_scope" and not _hasorr(es[0]):
                cs.arena = "&_t"
                c2, t2 := _ex(&cs, es[0])
                cs.arena = sav
                cs.want = sw
                c2 = _discard(c2, t2)
                # no transient landed in it -- do not pay arena_new/arena_free
                if not _uses_t(c2):
                    return ind + c2 + ";\n"
                return ind + "{ Arena _t = arena_new(0); " + c2 + "; arena_free(&_t); }\n"
            c, t := _ex(&cs, es[0])
            cs.want = sw
            return ind + _discard(c, t) + ";\n"
        ast.Decl(l, n, ann, rhs, vv):
            if len(vv) > 0:
                # `x := if c: a else: b` -- declare the variable, then run the
                # control statement with every value tail rewritten to assign it.
                t0 := ""
                if len(ann) > 0:
                    t0 = _ty(&cs, ann[0])
                if len(t0) == 0:
                    t0 = "?"
                cn0 := _push(&cs, n, t0)
                if len(ann) > 0:
                    cs.vcaps[len(cs.vcaps) - 1] = _capof(&cs, ann[0])
                slot := len(cs.vnames) - 1
                body := _stmt(&cs, parse.rewrite_tails(vv[0], "assign", n, []ast.Expr), ind)
                cs.vlocal[slot] = true
                if cs.vtypes[slot] == "?":
                    _bad("a value-if/value-match with no value tail to type it")
                state := _append_binding(&cs, n, cs.vtypes[slot], cn0, ind)
                return ind + _ctyz(&cs, cs.vtypes[slot]) + "" + cn0 + ";\n" + state + body
            want := ""
            if len(ann) > 0:
                want = _ty(&cs, ann[0])
            if len(rhs) == 0:
                _bad("a declaration with no initialiser")
            if len(ann) == 0 and not _is_arr(cs.want):
                # `out := []` -- the element type comes from the first push into
                # it, which is only known once the rest of the body is walked.
                # The declaration is emitted with a placeholder and patched in
                # _fnbody, the same shape the value-if declaration uses.
                match rhs[0]:
                    ast.EmptyArr(l2, ts):
                        if len(ts) == 0:
                            cs.tmp += 1
                            kk := cs.tmp
                            push(cs.pk, kk)
                            push(cs.ptv, "")
                            cnp := _push(&cs, n, "?A" + str(len(cs.pk) - 1))
                            return ind + "_PT" + str(kk) + " " + cnp + " = _PE" + str(kk) + ";\n"
                    ast.NoneE(l2):
                        # `o := None` -- the Option is fixed by the first
                        # assignment, exactly as a bare `[]`'s element is fixed
                        # by the first push.
                        cs.tmp += 1
                        kn := cs.tmp
                        push(cs.pk, kn)
                        push(cs.ptv, "")
                        cnn := _push(&cs, n, "?A" + str(len(cs.pk) - 1))
                        return ind + "_PT" + str(kn) + " " + cnn + " = _PE" + str(kn) + ";\n"
                    _: pass
            # src/tychoc.c@S_DECL: a NON-heap top-level local whose RHS calls
            # something builds that call's transients in a per-statement arena.
            sav5 := cs.arena
            uset := sav5 == "&_scope" and _hascall(rhs[0]) and not _hasorr(rhs[0])
            # src/tychoc.c:16085 -- the return-slot move. A local this function
            # hands back by name is built in the caller's arena from birth, so
            # the return copies nothing. Top level only (_curown is still the
            # proc's own &_scope), never a loop or if-body scratch. The arena
            # has to move with it: a literal is built through cs.arena, and
            # recording _parent while building in &_scope returns freed memory.
            # A decl inside a loop body belongs to that body's scratch, not the
            # whole function: prongB dispatch kept every pass's closures alive,
            # 62 MB against ./tychoc's 1 MB. _push already records _curown.
            own5 := _curown(&cs)
            if _curown(&cs) == "&_scope" and _heap(&cs, cs.cur_ret) and _isesc(&cs, n) and cs.ret_local != n:
                own5 = "_parent"
            promoted := ""
            if cs.loopdepth > 0 and len(want) > 0 and _heap(&cs, want):
                promoted = _push_decl_arena(&cs, n)
                if len(promoted) > 0:
                    own5 = promoted
            if uset:
                cs.arena = "&_t"
            elif len(promoted) > 0:
                cs.arena = promoted
            elif own5 == "_parent":
                cs.arena = "_parent"
            path5 := cs.projection
            cs.projection = []string
            if cs.ret_local == n and cs.ret_update < 0:
                cs.projection = cs.ret_fields
            oldconcat := cs.concat_scratch
            if len(promoted) > 0:
                cs.concat_scratch = sav5
            cs.share_place = true
            cs.ro_borrow = _place(rhs[0]) and _ro_borrow(&cs, n, rhs[0], l)
            c, t := _rhs3(&cs, rhs[0], want, own5, true)
            cs.ro_borrow = false
            cs.share_place = false
            cs.concat_scratch = oldconcat
            cs.projection = path5
            cs.arena = sav5
            if len(want) > 0 and _is_vec(want) and not _is_vec(t):
                # `z: vector[4]f32 = 0.0` -- a scalar fills every lane: a zero
                # vector plus the scalar, which GCC/Clang broadcast (FRICTION 224).
                sv := _fresh(&cs, "_fill")
                c = "({ " + _ctyz(&cs, want) + sv + "; " + sv + ".v = (__typeof__(" + sv + ".v)){0} + (" +
                    _cty(&cs, _velem(&cs, want)) + ")(" + c + "); " + sv + "; })"
            if len(want) > 0:
                t = want
            if uset and _heap(&cs, t):
                uset = false
                c = _sub_t(c, own5)
            if uset and not _uses_t(c):
                uset = false
            # src/tychoc.c:16129 -- `y := f(y)` must land in a temp declared
            # BEFORE the new C local, or the initialiser reads the inner
            # uninitialised one.
            # A place rooted in a CALL result -- `op := cur(ts, p).text` -- is the
            # one shape _rhs3 neither copies nor moves: it aliases a field of a
            # temporary built in the statement scratch. Recording own5 for it
            # below would then be a lie, and every later _shares believes it.
            if _place(rhs[0]) and _heap(&cs, t) and len(_rootname(rhs[0])) == 0:
                c = _copy(&cs, c, t, own5)
            # The RHS is resolved before this new binding enters Tycho scope.
            # If it calls a same-named function, however, declaring h_n before
            # the initializer would make C resolve that call to the local.
            sh := _refslocal(rhs[0], n)
            cn := _push(&cs, n, t)
            cs.vlocal[len(cs.vlocal) - 1] = true
            if len(ann) > 0:
                cs.vcaps[len(cs.vcaps) - 1] = _capof(&cs, ann[0])
            if own5 == "_parent" and _heap(&cs, t):
                cs.vown[len(cs.vown) - 1] = "_parent"
            elif len(promoted) > 0:
                cs.vown[len(cs.vown) - 1] = promoted
            elif _place(rhs[0]) and _heap(&cs, t):
                # A PLACE right-hand side lands in own5 whichever way _rhs3
                # took it -- copied, shared, or moved, all three leave the value
                # there. _push recorded _curown instead, which inside a loop is
                # the body scratch, so `h_text = tycho_str_copy(&_scope, ...)`
                # was then copied AGAIN into every Tok built from it.
                cs.vown[len(cs.vown) - 1] = own5
            out9 := ind + _ctyz(&cs, t) + "" + cn + " = " + c + ";\n"
            if t == "void":
                # a void $T (FRICTION 253): evaluate, keep an empty placeholder
                out9 = ind + "(void)(" + c + "); char " + cn + " = 0; (void)" + cn + ";\n"
            if _share_bind_ok(&cs, rhs[0], t, own5):
                sh1 := _share_call(&cs, t, cn)
                src9, _st9 := _lvalue(&cs, rhs[0])
                sh2 := _share_call(&cs, t, src9)
                if len(sh1) > 0:
                    out9 = out9 + ind + sh1 + ";\n"
                if len(sh2) > 0:
                    out9 = out9 + ind + sh2 + ";\n"
            if sh:
                out9 = ind + _ctyz(&cs, t) + "_sh_" + n + " = " + c + "; " +
                    _ctyz(&cs, t) + cn + " = _sh_" + n + ";\n"
            if uset:
                out9 = ind + _ctyz(&cs, t) + "" + cn + "; { Arena _t = arena_new(0); " +
                    cn + " = " + c + "; arena_free(&_t); }\n"
                if sh:
                    out9 = ind + _ctyz(&cs, t) + "_sh_" + n +
                        "; { Arena _t = arena_new(0); _sh_" + n + " = " + c +
                        "; arena_free(&_t); } " + _ctyz(&cs, t) + cn + " = _sh_" + n + ";\n"
            return out9 + _append_binding(&cs, n, t, cn, ind)
        ast.ConstS(l, n, k):
            # src/tychoc.c:16990 -- a local const emits NO runtime storage; each
            # use folds to the literal. Binding the C "name" to the literal code
            # itself makes _vcname do the folding at every read.
            c, t := _ex(&cs, k[0])
            _push(&cs, n, t)
            cs.vcn[len(cs.vcn) - 1] = c
            return ""
        ast.Assign(l, n, k):
            t := _vtype(&cs, n)
            if len(t) == 0:
                _bad("assignment to unknown name '" + n + "'")
            if strings.starts_with(t, "?A"):
                # the first assignment is what types a pending binding
                pi9 := strings.parse_int_prefix(t[2:])
                gc, gt := _ex(&cs, k[0])
                cs.ptv[pi9] = gt
                _vset(&cs, n, gt)
                return ind + _vcname(&cs, n) + " = " + gc + ";\n"
            if t == "?":
                t = ""
            # `xs = xs[0:n]` shrinks xs where it stands (FRICTION 251)
            if _is_arr(t):
                trunc := _self_truncate(&cs, n, k[0], ind)
                if len(trunc) > 0:
                    return trunc
            # `out = out + X` on an accumulator becomes an in-place append,
            # which is what makes a concat loop linear instead of quadratic.
            if (t == "string" or t == "bytes") and len(_accof(&cs, n)) > 0:
                match k[0]:
                    ast.Binop(l9, op9, bk9):
                        if op9 == "+" and len(bk9) == 2:
                            # The accumulator sits at the LEFT SPINE's leaf:
                            # `doc = doc + a + b + c` parses as (((doc+a)+b)+c),
                            # so only walking one level missed every multi-term
                            # append and materialised a whole copy per term --
                            # bench/json needed 7.2 GiB and died.
                            terms := []ast.Expr
                            push(terms, bk9[1])
                            spine := bk9[0]
                            for true:
                                done9 := true
                                match spine:
                                    ast.Binop(l7, op7, bk7):
                                        if op7 == "+" and len(bk7) == 2:
                                            push(terms, bk7[1])
                                            spine = bk7[0]
                                            done9 = false
                                    _: pass
                                if done9:
                                    break
                            isself := false
                            match spine:
                                ast.Name(l8, n8):
                                    if n8 == n:
                                        isself = true
                                _: pass
                            # Inout state also survives ordinary rebinds. Check
                            # each statement: later pieces must not observe an
                            # already-grown prefix, nor may a piece mutate it.
                            for term in terms:
                                if _mut_e(term, n) or (len(terms) >= 2 and _mentions(term, n)):
                                    isself = false
                            if isself:
                                state9 := _append_ptr(&cs, n)
                                ptr9 := "&" + _vcname(&cs, n)
                                append_code := ""   # distinct from the declaration formatter's out9: keep accumulator recognition
                                # The appended TERMS are copied into the
                                # accumulator's own buffer, so their
                                # intermediates die with the statement -- in the
                                # function's arena they lived to the end of the
                                # run (bench/json: 5.7 GiB).
                                # src/tychoc.c:16370-16390 -- the appended terms
                                # are built in the ACCUMULATOR'S arena, one plain
                                # statement each. The `_t` scratch this used was
                                # an optimisation the reference does not have.
                                ow9 := _ownerof(&cs, ast.Name(l, n))
                                sav9 := cs.arena
                                cs.arena = ow9
                                # src/tychoc.c:16308-16364 -- two or more pieces
                                # are pre-evaluated into `_ap<n>` temps against
                                # the accumulator's ORIGINAL value, THEN appended
                                # in source order. The first append grows the
                                # buffer, so an operand read afterwards would see
                                # the grown value. The ids are reserved before any
                                # operand is generated, because generating one can
                                # itself take numbers off the same counter.
                                if len(terms) >= 2:
                                    id0 := cs.tmp
                                    cs.tmp += len(terms)
                                    aps := []string
                                    for q8 := len(terms) - 1; q8 >= 0; q8 -= 1:
                                        tc8, tt8 := _ex(&cs, terms[q8])
                                        cty8 := "char*"
                                        fn8 := "tycho_str_append"
                                        if tt8 != "string" and tt8 != "bytes":
                                            cty8 = "char"
                                            fn8 = "tycho_str_append_char"
                                        nm8 := "_ap" + str(id0 + len(aps))
                                        push(aps, fn8 + "(" + ow9 + ", " + ptr9 +
                                            ", " + state9 + ", " + nm8 + ");\n")
                                        append_code = append_code + ind + cty8 + " " + nm8 + " = " + tc8 + ";\n"
                                    for a8 in aps:
                                        append_code = append_code + ind + a8
                                    cs.arena = sav9
                                    return append_code
                                for q9 := len(terms) - 1; q9 >= 0; q9 -= 1:
                                    tc9, tt9 := _ex(&cs, terms[q9])
                                    fnq := "tycho_str_append"
                                    if tt9 != "string" and tt9 != "bytes":
                                        fnq = "tycho_str_append_char"
                                    append_code = append_code + ind + fnq + "(" + ow9 +
                                        ", " + ptr9 + ", " + state9 + ", " + tc9 + ");\n"
                                cs.arena = sav9
                                return append_code
                    _: pass
            # The value is built in the TARGET's arena. For an `inout` string
            # or array parameter that is the caller's arena, not this scope --
            # `pre = pre + "..."` inside emit@_hoist_legs was allocating the new
            # string in the callee's _scope and writing the pointer through, so
            # the caller was left holding freed memory the moment the callee
            # returned. It reads correctly whenever the freed block still holds
            # the bytes, which is why it survived: the tree was green by luck,
            # and any perturbation of emit.ty could expose it.
            ow4 := _ownerof(&cs, ast.Name(l, n))
            sa4 := cs.arena
            # ...but only a HEAP target owns anything. `sum = sum + f(x)` at an
            # int target has nothing to place in sum's arena, and hoisting the
            # whole right-hand side out of the loop scratch is what kept every
            # transient f() built alive for the rest of the function.
            if len(t) == 0 or _heap(&cs, t):
                cs.arena = ow4
            cs.rebuild_name = ""
            cs.rebuild_paths = []string
            if strings.starts_with(t, "S~") and _rebuild_owned(&cs, n, ow4):
                match k[0]:
                    ast.Call(l4, q4, ctor4, tas4, args4):
                        paths4 := []string
                        if _rebuild_reads(&cs, k[0], n, &paths4):
                            cs.rebuild_name = n
                            cs.rebuild_paths = paths4
                    _: pass
            fo4 := _own_site(&cs, n, k)
            if len(fo4) > 0:
                cs.force_own = fo4
            rc, rt := _rhs3(&cs, k[0], t, ow4, true)
            cs.force_own = ""
            cs.force_orig = ""
            cs.rebuild_name = ""
            cs.rebuild_paths = []string
            cs.arena = sa4
            if len(t) == 0:
                _vset(&cs, n, rt)
            # src/tychoc.c@do_recycle. `a = step(a)` in a loop leaves the OLD
            # spine unreachable but still charged to the arena, so it grows once per
            # iteration: bench/prongB iter-transform ran 1534 MB against ./tychoc's
            # 4 MB. Soundness comes from the read count -- move-on-last-use only
            # moves a var read EXACTLY once, so >= 2 reads means this var never
            # sourced a move and cannot be sharing its buffer with a live name.
            # An inout target owns nothing here (its arena is the caller's `_ina_`),
            # and an accumulator is appended to rather than replaced.
            if len(cs.lmark) > 0 and _is_arr(t) and len(_accof(&cs, n)) == 0 and
                    not strings.starts_with(ow4, "_ina_") and _creads_b(cs.pbody, n) >= 2:
                rid := _fresh(&cs, "_rec")
                cn4 := _vcname(&cs, n)
                return ind + _cty(&cs, t) + " " + rid + " = " + rc + ";\n" +
                    ind + "if (" + cn4 + ".data && " + cn4 + ".data != " + rid +
                    ".data) arena_recycle(" + ow4 + ", " + cn4 + ".data, (size_t)" +
                    cn4 + ".cap * sizeof(*" + cn4 + ".data));\n" +
                    ind + cn4 + " = " + rid + ";\n"
            return ind + _vcname(&cs, n) + " = " + rc + ";\n"
        ast.PlaceSet(l, k):
            # `m[f()] += 1` desugars to `m[f()] = m[f()] + 1` with the SAME key
            # node on both sides; hoist every side-effecting leg into a temp so
            # each is evaluated exactly once, in source order, as src/tychoc.c does.
            rhs := k[1]
            pre := ""
            tmps := []string
            lhs := _hoist_legs(&cs, k[0], ind, &pre, &tmps)
            if len(tmps) > 0:
                match rhs:
