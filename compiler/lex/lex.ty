package lex

import "core:strings"

# Bytes -> tokens. The token set is src/tychoc.c's own, read out of its
# `keyword()` table and its operator chain rather than inferred from fixtures:
# `soa` is deliberately absent below because it is absent there too -- it lexes
# as an identifier and the parser treats it contextually.

struct Tok:
    k: int            # one of the K_* tags below
    text: string      # name, operator spelling, or the ESCAPED string body
    line: int
    col: int          # 1-based, for the error caret
    ival: int         # int literal value, char byte, 1 on an f-string -- and on a
                      # K_OP/K_KW token the OP_*/KW_* tag, which nothing else reads
    fval: float       # float literal value
    raw: string       # the exact source slice, for the round-trip control
    file: string      # the path, set on the K_EOF token ONLY -- one token array
                      # is one file, so lex.file_of() reads it from there. It was
                      # on every token until 2026-08-26 and cost a string copy per
                      # token for a field read on one cold diagnostic path.

# `raw` is read by ONE caller, the round-trip control, which lexes with
# keep_trivia set. On the normal path storing it allocated a second string per
# token for nothing.

# The token tag. It was a string until 2026-08-26: `_isop`/`_iskw` alone were
# 5.6% of a compile comparing it, and every Tok deep-copied it at each arena
# crossing. These twelve are the single source of truth -- parse.ty spells them
# `lex.K_OP`, never a literal.
const K_KW      = 1
const K_IDENT   = 2
const K_INT     = 3
const K_FLOAT   = 4
const K_STR     = 5
const K_CHAR    = 6
const K_OP      = 7
const K_NEWLINE = 8
const K_INDENT  = 9
const K_DEDENT  = 10
const K_EOF     = 11
const K_COMMENT = 12

# The spelling a diagnostic prints. Only error paths and `--dump-tokens` reach
# here, so the chain costs nothing on the accepting path.
# The path this token array was lexed from. It rides on the K_EOF token, which
# every array ends with; an array from tokenize()/tokenize_ex() names no file and
# gets "" here, which is the bare `tychoc1: line N:` form parse.ty falls back to.
fn file_of(toks: [Tok]) -> string:
    if len(toks) == 0:
        return ""
    return toks[len(toks) - 1].file

fn kname(k: int) -> string:
    if k == K_KW:
        return "kw"
    if k == K_IDENT:
        return "ident"
    if k == K_INT:
        return "int"
    if k == K_FLOAT:
        return "float"
    if k == K_STR:
        return "str"
    if k == K_CHAR:
        return "char"
    if k == K_OP:
        return "op"
    if k == K_NEWLINE:
        return "newline"
    if k == K_INDENT:
        return "indent"
    if k == K_DEDENT:
        return "dedent"
    if k == K_EOF:
        return "eof"
    if k == K_COMMENT:
        return "comment"
    return "?"


# The three hottest token sites build their Tok INLINE rather than through this,
# because a literal kind is not a place (no copy at all) and a local text is in
# the same arena as the array it is pushed into (shared, not copied) -- both of
# which are lost once the fields become parameters of a function that returns
# its Tok into the caller's arena.
fn _tk(keep: bool, kind: int, text: string, line: int, col: int, raw: string) -> Tok:
    if keep:
        return Tok(kind, text, line, col, 0, 0.0, raw, "")
    return Tok(kind, text, line, col, 0, 0.0, "", "")

fn is_digit(c: int) -> bool:
    return c >= 48 and c <= 57

fn is_hex(c: int) -> bool:
    return is_digit(c) or (c >= 97 and c <= 102) or (c >= 65 and c <= 70)

fn hex_val(c: int) -> int:
    if is_digit(c):
        return c - 48
    if c >= 97:
        return c - 97 + 10
    return c - 65 + 10

fn is_alpha(c: int) -> bool:
    return (c >= 97 and c <= 122) or (c >= 65 and c <= 90)

fn is_ident_start(c: int) -> bool:
    return is_alpha(c) or c == 95

fn is_ident(c: int) -> bool:
    return is_ident_start(c) or is_digit(c)


# The operator's spelling as an int: the bytes of the token packed low-first,
# which the lexer computes with two shifts and no comparison at all. `_isop` was
# 3.7% of a compile and `_iskw` 1.6%, both comparing `text` as a string. Every
# operator is at most three bytes (`op_len` above returns 1, 2 or 3), so the
# packing is exact, and these are the single source of truth for parse.ty.
const OP_AMP       = 38       # `&`
const OP_LPAREN    = 40       # `(`
const OP_RPAREN    = 41       # `)`
const OP_COMMA     = 44       # `,`
const OP_MINUS     = 45       # `-`
const OP_DOT       = 46       # `.`
const OP_COLON     = 58       # `:`
const OP_EQ        = 61       # `=`
const OP_LBRACK    = 91       # `[`
const OP_RBRACK    = 93       # `]`
const OP_PIPE      = 124      # `|`
const OP_TILDE     = 126      # `~`
const OP_DOLLAR    = 36       # `$`
const OP_ARROW     = 15917    # `->`
const OP_DOTDOT    = 11822    # `..`
const OP_ELLIPSIS  = 3026478  # `...`
const OP_DOTDOTLT  = 3943982  # `..<`
const OP_DECL      = 15674    # `:=`
const OP_PCT       = 37       # `%`
const OP_STAR      = 42       # `*`
const OP_PLUS      = 43       # `+`
const OP_SLASH     = 47       # `/`
const OP_SEMI      = 59       # `;`
const OP_LT        = 60       # `<`
const OP_GT        = 62       # `>`
const OP_CARET     = 94       # `^`
const OP_COLONCOLON = 14906   # `::`
const OP_SHL       = 15420    # `<<`
const OP_NE        = 15649    # `!=`
const OP_LE        = 15676    # `<=`
const OP_EQEQ      = 15677    # `==`
const OP_GE        = 15678    # `>=`
const OP_SHR       = 15934    # `>>`

# An operator token carries no `text`: its spelling IS its tag, so a diagnostic
# decodes it here instead of the lexer allocating a one-byte string 43% of the
# time (measured over compiler/emit/emit.ty: 28,527 op tokens of 66,174). Every
# arm returns a literal, which is immortal -- storing one in a node costs no
# allocation at all, where the old `text` cost two.
fn opspell(oid: int) -> string:
    if oid == OP_LPAREN:
        return "("
    if oid == OP_RPAREN:
        return ")"
    if oid == OP_COLON:
        return ":"
    if oid == OP_COMMA:
        return ","
    if oid == OP_DOT:
        return "."
    if oid == OP_EQ:
        return "="
    if oid == OP_LBRACK:
        return "["
    if oid == OP_RBRACK:
        return "]"
    if oid == OP_DECL:
        return ":="
    if oid == OP_ARROW:
        return "->"
    if oid == OP_PLUS:
        return "+"
    if oid == OP_MINUS:
        return "-"
    if oid == OP_STAR:
        return "*"
    if oid == OP_SLASH:
        return "/"
    if oid == OP_PCT:
        return "%"
    if oid == OP_EQEQ:
        return "=="
    if oid == OP_NE:
        return "!="
    if oid == OP_LT:
        return "<"
    if oid == OP_GT:
        return ">"
    if oid == OP_LE:
        return "<="
    if oid == OP_GE:
        return ">="
    if oid == OP_AMP:
        return "&"
    if oid == OP_PIPE:
        return "|"
    if oid == OP_CARET:
        return "^"
    if oid == OP_TILDE:
        return "~"
    if oid == OP_SHL:
        return "<<"
    if oid == OP_SHR:
        return ">>"
    if oid == OP_DOLLAR:
        return "$"
    if oid == OP_SEMI:
        return ";"
    if oid == OP_DOTDOT:
        return ".."
    if oid == OP_DOTDOTLT:
        return "..<"
    if oid == OP_ELLIPSIS:
        return "..."
    if oid == OP_COLONCOLON:
        return "::"
    return "?"

# What a diagnostic prints for a token. Only an operator needs decoding; every
# other kind either carries its own text or has none.
fn spell(t: Tok) -> string:
    if t.k == K_OP:
        return opspell(t.ival)
    return t.text

# The keyword's identity as an int, in the order `kwid` tests them.
const KW_FN         = 1
const KW_IF         = 2
const KW_OR         = 3
const KW_IN         = 4
const KW_IS         = 5
const KW_U8         = 6
const KW_I8         = 7
const KW_AND        = 8
const KW_NOT        = 9
const KW_FOR        = 10
const KW_INT        = 11
const KW_PTR        = 12
const KW_U16        = 13
const KW_U32        = 14
const KW_U64        = 15
const KW_I16        = 16
const KW_I32        = 17
const KW_I64        = 18
const KW_F32        = 19
const KW_ELIF       = 20
const KW_ELSE       = 21
const KW_TRUE       = 22
const KW_NULL       = 23
const KW_BOOL       = 24
const KW_ENUM       = 25
const KW_TYPE       = 26
const KW_MATCH      = 27
const KW_BREAK      = 28
const KW_SPAWN      = 29
const KW_FALSE      = 30
const KW_FLOAT      = 31
const KW_BYTES      = 32
const KW_INOUT      = 33
const KW_RETURN     = 34
const KW_STRUCT     = 35
const KW_HANDLE     = 36
const KW_STRING     = 37
const KW_SELECT     = 38
const KW_CONTINUE   = 39
const KW_PARALLEL   = 40
const KW_OR_RETURN  = 41

# src/tychoc.c@keyword, verbatim. Every name here becomes kind "kw"; everything
# else -- `soa`, `count`, `print`, `where`, `const`, `import`, `package`,
# `extern`, `sink`, `subscript`, `yield`, `zero` -- stays an identifier.
# Length first, then one comparison per candidate of that length: every
# identifier in the source reaches here, and the 38-way `or` chain compared the
# text against each in turn -- callgrind put str_cmp from here at 3% of a
# compile.
fn kwid(s: string) -> int:
    n := len(s)
    if n < 2 or n > 9:
        return 0
    if n == 2:
        if s == "fn":
            return KW_FN
        if s == "if":
            return KW_IF
        if s == "or":
            return KW_OR
        if s == "in":
            return KW_IN
        if s == "is":
            return KW_IS
        if s == "u8":
            return KW_U8
        if s == "i8":
            return KW_I8
        return 0
    if n == 3:
        if s == "and":
            return KW_AND
        if s == "not":
            return KW_NOT
        if s == "for":
            return KW_FOR
        if s == "int":
            return KW_INT
        if s == "ptr":
            return KW_PTR
        if s == "u16":
            return KW_U16
        if s == "u32":
            return KW_U32
        if s == "u64":
            return KW_U64
        if s == "i16":
            return KW_I16
        if s == "i32":
            return KW_I32
        if s == "i64":
            return KW_I64
        if s == "f32":
            return KW_F32
        return 0
    if n == 4:
        if s == "elif":
            return KW_ELIF
        if s == "else":
            return KW_ELSE
        if s == "true":
            return KW_TRUE
        if s == "null":
            return KW_NULL
        if s == "bool":
            return KW_BOOL
        if s == "enum":
            return KW_ENUM
        if s == "type":
            return KW_TYPE
        return 0
    if n == 5:
        if s == "match":
            return KW_MATCH
        if s == "break":
            return KW_BREAK
        if s == "spawn":
            return KW_SPAWN
        if s == "false":
            return KW_FALSE
        if s == "float":
            return KW_FLOAT
        if s == "bytes":
            return KW_BYTES
        if s == "inout":
            return KW_INOUT
        return 0
    if n == 6:
        if s == "return":
            return KW_RETURN
        if s == "struct":
            return KW_STRUCT
        if s == "handle":
            return KW_HANDLE
        if s == "string":
            return KW_STRING
        if s == "select":
            return KW_SELECT
        return 0
    if n == 8:
        if s == "continue":
            return KW_CONTINUE
        if s == "parallel":
            return KW_PARALLEL
        return 0
    if n == 9:
        if s == "or_return":
            return KW_OR_RETURN
        return 0
    return 0

# src/tychoc.c@tok_continues_line. A line ending on one of these cannot be a
# complete statement, so the next physical line joins it.
fn continues_line(kind: int, tag: int) -> bool:
    if kind == K_KW:
        return tag == KW_AND or tag == KW_OR or tag == KW_IS
    if kind != K_OP:
        return false
    if tag == OP_PLUS or tag == OP_MINUS or tag == OP_STAR or tag == OP_SLASH or tag == OP_PCT:
        return true
    if tag == OP_PIPE or tag == OP_CARET or tag == OP_SHL or tag == OP_SHR:
        return true
    if tag == OP_EQ or tag == OP_EQEQ or tag == OP_NE:
        return true
    if tag == OP_LT or tag == OP_GT or tag == OP_LE or tag == OP_GE:
        return true
    return tag == OP_COMMA or tag == OP_DECL

# src/tychoc.c@tok_postfixable. After a value-producing token a '.' is field or
# tuple access, so `t.0` is DOT + INT and never a leading-dot float.
fn postfixable(kind: int, tag: int) -> bool:
    if kind == K_IDENT or kind == K_INT or kind == K_FLOAT or kind == K_STR or kind == K_CHAR:
        return true
    return kind == K_OP and (tag == OP_RPAREN or tag == OP_RBRACK)

# A lexer error names its FILE when one is known, in the same shape the parser
# uses: without it, a broken sibling in a package was reported as `tychoc1: line
# 1`, which names no file at all and sent the reader to the entry file.
# `file:line: error: msg`, with the source line under it -- the shape parse.ty's
# `_where` produces, so a lexer error reads like every other diagnostic.
fn _at_line(file: string, src: string, line: int, msg: string) -> string:
    if len(file) == 0:
        return "tychoc1: line " + str(line) + ": " + msg
    out := file + ":" + str(line) + ": error: " + msg
    ls := split(src, "\n")
    if line >= 1 and line <= len(ls):
        num := str(line)
        pad := ""
        for k := len(num); k < 6; k += 1:
            pad = pad + " "
        out = out + "\n" + pad + num + " | " + ls[line - 1]
    return out

fn _die(file: string, src: string, line: int, msg: string):
    die(_at_line(file, src, line, msg))

# --- `# deprecated:` doc notes ----------------------------------------------
# src/tychoc.c@dnote_scan runs during lexing and only on a comment-ONLY line, so
# a trailing comment can never carry a note. The note is what follows
# `deprecated:` with both ends trimmed; an empty tail is no note at all.

struct DNote:
    line: int         # the comment's own line
    msg: string       # the text after `deprecated:`

fn dnote_of(src: string, cs: int, ce: int) -> string:
    m := cs
    for m < ce and src[m] == 35:
        m += 1
    for m < ce and (src[m] == 32 or src[m] == 9):
        m += 1
    tag := "deprecated:"
    if ce - m < len(tag) or src[m:m + len(tag)] != tag:
        return ""
    m += len(tag)
    for m < ce and (src[m] == 32 or src[m] == 9):
        m += 1
    e := ce
    for e > m and (src[e - 1] == 32 or src[e - 1] == 13):
        e -= 1
    return src[m:e]

# src/tychoc.c@dnote_above: the note is attached to the line immediately below it.
fn dnote_above(notes: [DNote], line: int) -> string:
    for i := 0; i < len(notes); i += 1:
        if notes[i].line == line - 1:
            return notes[i].msg
    return ""

# --- literal scanners -------------------------------------------------------
# Each takes the index of the opening delimiter and returns the index just past
# the closing one.

fn scan_str(src: string, i0: int, line: int, interp: bool, file: string) -> int:
    n := len(src)
    i := i0 + 1
    depth := 0
    for i < n:
        c := src[i]
        if c == 34 and depth == 0:
            return i + 1
        if c == 10:
            _die(file, src, line, "unterminated string literal")
        if interp and depth == 0 and c == 123 and i + 1 < n and src[i + 1] == 123:
            i += 2
            continue
        if interp and depth == 0 and c == 125 and i + 1 < n and src[i + 1] == 125:
            i += 2
            continue
        if interp and c == 123:
            depth += 1
            i += 1
            continue
        if interp and depth > 0 and c == 125:
            depth -= 1
            i += 1
            continue
        if interp and depth > 0 and c == 34:
            # a nested literal inside a hole: copied verbatim, escapes unchecked
            # here because the hole's code is re-lexed later.
            i += 1
            for i < n and src[i] != 34:
                if src[i] == 10:
                    _die(file, src, line, "unterminated string literal")
                if src[i] == 92:
                    i += 1
                    if i >= n:
                        _die(file, src, line, "unterminated string literal")
                i += 1
            if i >= n:
                _die(file, src, line, "unterminated string literal")
            i += 1
            continue
        if c == 92:
            i += 1
            if i >= n:
                _die(file, src, line, "unterminated string literal")
            e := src[i]
            if e != 110 and e != 116 and e != 114 and e != 92 and e != 34:
                _die(file, src, line, "unsupported escape (use \\n \\t \\r \\\\ \\\")")
            i += 1
            continue
        if depth == 0 and c < 32 and c != 9:
            _die(file, src, line, "raw control byte in string literal (use an escape such as \\n or \\t)")
        i += 1
    _die(file, src, line, "unterminated string literal")
    return i

# `...` interprets no escape at all, so its body is re-escaped here into the
# four two-character escapes the language has -- exactly what src/tychoc.c does,
# and for the same reason: the text is pasted into a C string literal later.
# Returns (end index, escaped body, lines consumed).
fn scan_raw(src: string, i0: int, line: int, file: string) -> (int, string, int):
    n := len(src)
    i := i0 + 1
    out := ""
    seg := i
    nl := 0
    for i < n and src[i] != 96:
        c := src[i]
        esc := ""
        if c == 10:
            esc = "\\n"
            nl += 1
        elif c == 9:
            esc = "\\t"
        elif c == 92:
            esc = "\\\\"
        elif c == 34:
            esc = "\\\""
        elif c < 32:
            _die(file, src, line + nl, "raw control byte in string literal (use an escape such as \\n or \\t)")
        if len(esc) > 0:
            out = out + src[seg:i] + esc
            i += 1
            seg = i
        else:
            i += 1
    if i >= n:
        _die(file, src, line, "unterminated raw string literal")
    out = out + src[seg:i]
    return (i + 1, out, nl)

# 'x' or one escape -> one byte. Returns (end index, byte value).
fn scan_char(src: string, i0: int, line: int, file: string) -> (int, int):
    n := len(src)
    i := i0 + 1
    cv := 0
    if i < n and src[i] == 92:
        i += 1
        if i >= n:
            _die(file, src, line, "empty or unterminated char literal")
        e := src[i]
        if e == 110:
            cv = 10
        elif e == 116:
            cv = 9
        elif e == 114:
            cv = 13
        elif e == 48:
            cv = 0
        elif e == 92:
            cv = 92
        elif e == 39:
            cv = 39
        elif e == 120:
            # \xNN takes EXACTLY two hex digits -- fixed width, never C's greedy form.
            if i + 2 >= n or not is_hex(src[i + 1]) or not is_hex(src[i + 2]):
                _die(file, src, line, "\\x takes exactly two hex digits (e.g. '\\x41')")
            cv = 16 * hex_val(src[i + 1]) + hex_val(src[i + 2])
            i += 2
        else:
            _die(file, src, line, "unsupported char escape (use \\n \\t \\r \\0 \\xNN \\\\ \\')")
        i += 1
    elif i < n and src[i] != 39 and src[i] != 10:
        cv = src[i]
        i += 1
    else:
        _die(file, src, line, "empty or unterminated char literal")
    if i >= n or src[i] != 39:
        _die(file, src, line, "char literal must be exactly one character")
    return (i + 1, cv)

# --- operators --------------------------------------------------------------

fn op_len(src: string, i: int) -> int:
    n := len(src)
    c := src[i]
    c2 := 0
    c3 := 0
    if i + 1 < n:
        c2 = src[i + 1]
    if i + 2 < n:
        c3 = src[i + 2]
    if c == 46 and c2 == 46 and c3 == 46:
        return 3
    if c == 46 and c2 == 46 and c3 == 60:
        return 3
    if c == 46 and c2 == 46:
        return 2
    if c == 58 and (c2 == 58 or c2 == 61):
        return 2
    if c == 61 and c2 == 61:
        return 2
    if c == 33 and c2 == 61:
        return 2
    if c == 60 and (c2 == 61 or c2 == 60):
        return 2
    if c == 62 and (c2 == 61 or c2 == 62):
        return 2
    if c == 45 and c2 == 62:
        return 2
    return 1

fn is_op_start(c: int) -> bool:
    if c == 58 or c == 61 or c == 60 or c == 62 or c == 43 or c == 45:
        return true
    if c == 42 or c == 47 or c == 40 or c == 41 or c == 91 or c == 93:
        return true
    if c == 46 or c == 44 or c == 59 or c == 38 or c == 37 or c == 124:
        return true
    return c == 94 or c == 126 or c == 36

# --- the lexer --------------------------------------------------------------

fn tokenize(src: string) -> [Tok]:
    return tokenize_ex(src, false)

fn tokenize_ex(src: string, keep_trivia: bool) -> [Tok]:
    return tokenize_all(src, keep_trivia).0

# The path-carrying entry. `tokenize_all` keeps its old shape so the token dump,
# round-trip and census modes are untouched.
fn tokenize_file(src: string, keep_trivia: bool, file: string) -> ([Tok], [DNote]):
    return tokenize_named(src, keep_trivia, file)

# The `# deprecated:` notes this file's comments carry, in source order. They are
# a SIDE TABLE rather than tokens for the same reason src/tychoc.c keeps them in
# one: a note is not a syntactic element, and putting it in the stream would make
# every consumer skip it.
fn dnotes(src: string) -> [DNote]:
    return tokenize_all(src, false).1

# `keep_trivia` adds a "comment" token carrying its own source slice. Nothing in
# the pipeline reads them; they exist so the round-trip control can assert that
# every non-whitespace byte of the source is covered by exactly one token.
fn tokenize_all(src: string, keep_trivia: bool) -> ([Tok], [DNote]):
    return tokenize_named(src, keep_trivia, "")

fn tokenize_named(src: string, keep_trivia: bool, file: string) -> ([Tok], [DNote]):
    toks := []Tok
    notes := []DNote
    errs := []string
    errl := []int                      # the line each recorded error names
    stack := []int
    push(stack, 0)
    n := len(src)
    p := 0
    line := 0
    bracket_depth := 0
    bracket_line := 0
    pend := false
    pend_col := 0
    cont := false
    # The last REAL token's index, not copies of its tag and text: assigning
    # those two strings allocated twice per token for a question asked twice
    # per line. -1 until the first real token, which is what "" stood for.
    last_ix := -1

    for p < n:
        line += 1
        ls := p
        col := 0
        ws_sp := false
        ws_tab := false
        for p < n and (src[p] == 32 or src[p] == 9):
            if src[p] == 32:
                ws_sp = true
            else:
                ws_tab = true
            col += 1
            p += 1

        cont = false
        if pend:
            blank := p >= n or src[p] == 10 or src[p] == 35
            if col > pend_col and not blank:
                if len(toks) > 0 and toks[len(toks) - 1].k == K_NEWLINE:
                    pop(toks)
                cont = true
            pend = false
        if ws_sp and ws_tab and bracket_depth == 0 and not cont:
            _die(file, src, line, "mixed tabs and spaces in indentation; use one consistently")

        # A blank or comment-only line carries no indentation information;
        # measuring it would emit a DEDENT the source never asked for.
        if p >= n or src[p] == 10 or src[p] == 35:
            cs := p
            for p < n and src[p] != 10:
                p += 1
            if p > cs:
                dn := dnote_of(src, cs, p)
                if len(dn) > 0:
                    push(notes, DNote(line, dn))
            if keep_trivia and p > cs:
                push(toks, _tk(keep_trivia, K_COMMENT, src[cs:p], line, cs - ls + 1, src[cs:p]))
            if p < n:
                p += 1
            continue

        # An unclosed bracket otherwise swallows the rest of the file as one
        # continuation line. A reserved declaration keyword in column 1 cannot
        # be a continuation in any valid program, so it proves the bracket open.
        if bracket_depth > 0 and col == 0:
            k := p
            for k < n and is_ident(src[k]):
                k += 1
            w := src[p:k]
            if w == "fn" or w == "struct" or w == "enum" or w == "handle" or w == "type":
                # Recorded, not fatal: src/tychoc.c pushes the diagnostic and puts
                # bracket_depth back to 0 so real layout resumes and the rest of
                # the file still lexes, which is what makes error batching work.
                push(errl, bracket_line)
                push(errs, "unclosed '(' or '[' opened on line " +
                    str(bracket_line) + " -- `" + w +
                    "` here can only start a declaration, so the bracket was never closed")
                bracket_depth = 0
                cont = false

        if bracket_depth == 0 and not cont:
            if col > stack[len(stack) - 1]:
                push(stack, col)
                push(toks, _tk(keep_trivia, K_INDENT, "", line, col + 1, ""))
            else:
                for col < stack[len(stack) - 1]:
                    pop(stack)
                    push(toks, _tk(keep_trivia, K_DEDENT, "", line, col + 1, ""))
                if col != stack[len(stack) - 1]:
                    _die(file, src, line, "inconsistent indentation")

        for p < n and src[p] != 10 and src[p] != 35:
            c := src[p]
            if c == 32 or c == 9 or c == 13:
                p += 1
                continue
            s := p
            tcol := p - ls + 1

            lead_dot := c == 46 and p + 1 < n and is_digit(src[p + 1]) and
                (last_ix < 0 or not postfixable(toks[last_ix].k, toks[last_ix].ival))
            if is_digit(c) or lead_dot:
                for p < n and is_digit(src[p]):
                    p += 1
                litbase := 10
                digits := s
                prefixed := false
                if p - s == 1 and src[s] == 48 and p < n and
                        (src[p] == 120 or src[p] == 88 or src[p] == 98 or src[p] == 66):
                    hexed := src[p] == 120 or src[p] == 88
                    prefixed = true
                    if hexed:
                        litbase = 16
                    else:
                        litbase = 2
                    p += 1
                    digits = p
                    for p < n and ((hexed and is_hex(src[p])) or
                            (not hexed and (src[p] == 48 or src[p] == 49))):
                        p += 1
                    if p == digits:
                        if hexed:
                            _die(file, src, line, "a hex literal needs at least one digit after `0x`")
                        _die(file, src, line, "a binary literal needs digits 0 or 1 after `0b`")
                is_float := false
                if not prefixed and p + 1 < n and src[p] == 46 and is_digit(src[p + 1]):
                    is_float = true
                    p += 1
                    for p < n and is_digit(src[p]):
                        p += 1
                if not prefixed and p < n and (src[p] == 101 or src[p] == 69):
                    eq := p + 1
                    if eq < n and (src[eq] == 43 or src[eq] == 45):
                        eq += 1
                    if eq < n and is_digit(src[eq]):
                        is_float = true
                        p = eq
                        for p < n and is_digit(src[p]):
                            p += 1
                raw := src[s:p]
                if is_float:
                    fv := 0.0
                    # Overflow is the only Err src/tychoc.c dies on: its c_strtod
                    # returns 0 for a total underflow and does not check, so
                    # dying here would be a divergence rather than a fix.
                    match strings.parse_float(raw):
                        Ok(v): fv = v
                        Err(strings.Overflow): _die(file, src, line, "float literal out of range: `" + raw +
                            "` exceeds the largest float (IEEE-754 binary64); write 1.0/0.0 for an infinity")
                        Err(strings.Underflow): fv = 0.0
                        Err(strings.Empty): fv = 0.0
                        Err(strings.Syntax): fv = 0.0
                    push(toks, Tok(K_FLOAT, raw, line, tcol, 0, fv, raw, ""))
                    last_ix = len(toks) - 1
                else:
                    v := 0
                    imax := 9223372036854775807     # INT64_MAX; tycho `int` is i64
                    for q := digits; q < p; q += 1:
                        d := hex_val(src[q])
                        if v > (imax - d) / litbase:
                            _die(file, src, line, "integer literal out of range")
                        v = v * litbase + d
                    push(toks, Tok(K_INT, raw, line, tcol, v, 0.0, raw, ""))
                    last_ix = len(toks) - 1
                continue

            # f"..." is an interpolated string, not an identifier named f.
            fstr := c == 102 and p + 1 < n and src[p + 1] == 34
            if is_ident_start(c) and not fstr:
                for p < n and is_ident(src[p]):
                    p += 1
                name := src[s:p]
                kind := K_IDENT
                kid := kwid(name)
                if kid != 0:
                    kind = K_KW
                raw9 := ""
                if keep_trivia:
                    raw9 = name
                push(toks, Tok(kind, name, line, tcol, kid, 0.0, raw9, ""))
                last_ix = len(toks) - 1
                continue

            if c == 34 or fstr:
                q0 := p
                if fstr:
                    q0 += 1
                e := scan_str(src, q0, line, fstr, file)
                body := src[q0 + 1:e - 1]
                flag := 0
                if fstr:
                    flag = 1
                push(toks, Tok(K_STR, body, line, tcol, flag, 0.0, src[s:e], ""))
                p = e
                last_ix = len(toks) - 1
                continue

            if c == 96:
                e, body, nl := scan_raw(src, p, line, file)
                push(toks, Tok(K_STR, body, line, tcol, 0, 0.0, src[s:e], ""))
                p = e
                line += nl
                last_ix = len(toks) - 1
                continue

            if c == 39:
                e, cv := scan_char(src, p, line, file)
                push(toks, Tok(K_CHAR, src[s:e], line, tcol, cv, 0.0, src[s:e], ""))
                p = e
                last_ix = len(toks) - 1
                continue

            if c == 47 and p + 1 < n and src[p + 1] == 47:
                _die(file, src, line, "'//' is not valid in Tycho -- use '#' for comments, or '/' for division")
            l := op_len(src, p)
            # `!` exists only as `!=`; a lone one is an unexpected character,
            # exactly as in src/tychoc.c's operator chain.
            if not is_op_start(c) and not (c == 33 and l == 2):
                _die(file, src, line, "unexpected character '" + src[p:p + 1] + "'")
            # The tag is the bytes packed low-first -- no comparison at all, and
            # it is what `_isop` reads instead of comparing `text`.
            oid := src[p]
            if l > 1:
                oid = oid + src[p + 1] * 256
            if l > 2:
                oid = oid + src[p + 2] * 65536
            if oid == OP_LPAREN or oid == OP_LBRACK:
                if bracket_depth == 0:
                    bracket_line = line
                bracket_depth += 1
            elif (oid == OP_RPAREN or oid == OP_RBRACK) and bracket_depth > 0:
                bracket_depth -= 1
            raw8 := ""
            if keep_trivia:
                raw8 = src[p:p + l]
            # No `text`: the tag above IS the spelling, and lex.opspell decodes
            # it on the diagnostic path. This is the substring the lexer used to
            # allocate for every operator, and the copy `push` then made of it.
            push(toks, Tok(K_OP, "", line, tcol, oid, 0.0, raw8, ""))
            p += l
            last_ix = len(toks) - 1

        nlcol := p - ls + 1
        if p < n and src[p] == 35:
            cs := p
            for p < n and src[p] != 10:
                p += 1
            if keep_trivia:
                push(toks, _tk(keep_trivia, K_COMMENT, src[cs:p], line, cs - ls + 1, src[cs:p]))
        # A comment tail is not a token, so it must not defeat the trailing-
        # operator join: the candidate is recorded from the last REAL token.
        if bracket_depth == 0:
            push(toks, Tok(K_NEWLINE, "", line, nlcol, 0, 0.0, "", ""))
            pend = last_ix >= 0 and continues_line(toks[last_ix].k, toks[last_ix].ival)
        else:
            pend = false
        # The anchor is the indent of the LOGICAL line and stays put while the
        # statement continues, so a chain does not have to descend a staircase.
        if not cont:
            pend_col = col
        if p < n and src[p] == 10:
            p += 1

    if bracket_depth > 0:
        push(errl, bracket_line)
        push(errs, "unclosed '(' or '[' opened on line " + str(bracket_line))
    if len(errs) > 0:
        # Every recorded error, in source order, in the shape the rest of the
        # compiler uses -- `file:line: error: ...` and the source line. They were
        # BATCHED already; only the format was the lexer's own.
        msg := ""
        for i := 0; i < len(errs); i += 1:
            if i > 0:
                msg = msg + "\n"
            msg = msg + _at_line(file, src, errl[i], errs[i])
        die(msg)
    for len(stack) > 1:
        pop(stack)
        push(toks, _tk(keep_trivia, K_DEDENT, "", line, 1, ""))
    push(toks, Tok(K_EOF, "", line, 1, 0, 0.0, "", file))
    return (toks, notes)
