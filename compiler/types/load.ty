package types

import "core:sort"
import "../ast"
import "../lex"
import "../parse"

# The package graph, as src/tychoc.c builds it. The authority is merge_pkg
# (src/tychoc.c@merge_pkg) and its two helpers: `core:` paths resolve against a
# corelib root found next to the binary, everything else against the IMPORTER's
# directory, and the walk is post-order with the DFS path kept so a cycle is
# named rather than hung on.
#
# One deliberate difference from src/tychoc.c: it lexes a package's files, reads
# the import headers, loads the children, and only then parses. tychoc1's parser
# needs no symbol table (Phase 4), so a file is parsed once, up front, and its
# imports are read off the tree.

struct File:
    path: string
    dir: string
    pkg: string
    prefix: string
    unit: ast.Unit
    src: string                        # kept for the diagnostic source excerpt

struct Program:
    files: [File]
    entry_dir: string
    entry_pkg: string
    entry_path: string
    root: string

struct Loader:
    files: [File]
    order: [int]                       # ld.files is filled in PARSE order; this
                                       # is the post-order the Program wants
    seen: [string: bool]
    active: [string]
    root: string
    entry_in_corelib: bool

fn dir_of(p: string) -> string:
    cut := -1
    for i := 0; i < len(p); i += 1:
        if p[i] == 47:
            cut = i
    if cut < 0:
        return "."
    if cut == 0:
        return "/"
    return p[0:cut]

# Lexical canonicalisation. src/tychoc.c@canon_dir goes through the filesystem;
# every path in this tree is relative to one cwd, so collapsing `.` and `..`
# textually gives the same key for the same directory. It is the KEY for the
# cycle and already-merged checks, never a path anything is opened by.
fn norm(path: string) -> string:
    out := []string
    n := 0
    for s in split(path, "/"):
        if len(s) == 0 or s == ".":
            continue
        if s == ".." and n > 0 and out[n - 1] != "..":
            n -= 1
            continue
        if n < len(out):
            out[n] = s
        else:
            push(out, s)
        n += 1
    r := ""
    for i := 0; i < n; i += 1:
        if i > 0:
            r = r + "/"
        r = r + out[i]
    if len(path) > 0 and path[0] == 47:
        return "/" + r
    if len(r) == 0:
        return "."
    return r

fn _dir_has_files(p: string) -> bool:
    return len(list_dir(p)) > 0

# TYCHO_CORELIB wins; otherwise next to the binary, then the installed layout --
# src/tychoc.c@corelib_root. exe_dir there reads /proc/self/exe first and falls
# back to argv[0]; args()[0] is that same fallback and the only one available
# here. "" when nothing is found, which is only fatal if a `core:` import is
# actually written.
fn corelib_root(argv0: string) -> string:
    e := getenv("TYCHO_CORELIB")
    if len(e) > 0:
        return e
    d := dir_of(argv0)
    if _dir_has_files(d + "/corelib"):
        return d + "/corelib"
    if _dir_has_files(d + "/../share/tycho/corelib"):
        return d + "/../share/tycho/corelib"
    return ""

fn pkg_basename(p: string) -> string:
    s := p
    if len(s) > 5 and s[0:5] == "core:":
        s = s[5:]
    cut := -1
    for i := 0; i < len(s); i += 1:
        if s[i] == 47:
            cut = i
    if cut < 0:
        return s
    return s[cut + 1:]

fn _resolve_pkg_dir(ld: inout Loader, importer_dir: string, path: string) -> string:
    if len(path) > 5 and path[0:5] == "core:":
        if len(ld.root) == 0:
            die("tychoc1: cannot find the corelib for import \"" + path + "\"")
        return ld.root + "/" + path[5:]
    return importer_dir + "/" + path

fn under_corelib(root: string, dir: string) -> bool:
    if len(root) == 0:
        return false
    cd := norm(dir)
    cr := norm(root)
    if len(cd) < len(cr):
        return false
    if cd[0:len(cr)] != cr:
        return false
    return len(cd) == len(cr) or cd[len(cr)] == 47

fn _pkg_files(dir: string) -> [string]:
    out := []string
    for nm in list_dir(dir):
        if len(nm) > 3 and nm[len(nm) - 3:] == ".ty":
            push(out, dir + "/" + nm)
    sort.asc(out)
    return out

fn _empty_unit() -> ast.Unit:
    return ast.Unit("", []ast.ImportD, []ast.Fn, []ast.StructD, []ast.EnumD,
        []ast.NewtypeD, []ast.HandleD, []ast.ConstD, []ast.SubscriptD)

fn _merge(ld: inout Loader, dir: string, pkgname: string, prefix: string):
    key := norm(dir)
    for a in ld.active:
        if a == key:
            die("tychoc1: import cycle through package `" + pkgname + "` (" + dir + ")")
    if key in ld.seen:
        return
    if len(ld.active) >= 64:
        die("tychoc1: package nesting too deep")
    push(ld.active, key)

    files := _pkg_files(dir)
    if len(files) == 0:
        die("tychoc1: package directory " + dir + " has no .ty files")

    # The File goes into ld.files' arena FIRST and the tree is parsed straight
    # into it. Parsing into a local array and assigning the unit across cost a
    # whole-AST deep copy per package -- three of them, 15% of a compile.
    lo := len(ld.files)
    for f in files:
        one := read_file(f)
        toks, notes := lex.tokenize_file(one, false, f)
        push(ld.files, File(f, dir, pkgname, prefix, _empty_unit(), one))
        parse.unit_into(toks, notes, &ld.files[len(ld.files) - 1].unit)
    hi := len(ld.files)

    # Post-order: every imported package is merged before this one, so a symbol
    # this package names is already in the table by the time the resolver runs.
    # ld.files itself cannot be reordered -- the recursion appends to it -- so
    # the order is recorded separately and applied once, in load_into.
    for i := lo; i < hi; i += 1:
        if ld.files[i].unit.pkg != pkgname:
            if len(ld.files[i].unit.pkg) == 0:
                die("tychoc1: " + ld.files[i].path + " is in package `" + pkgname + "` but has no `package` declaration")
            die("tychoc1: " + ld.files[i].path + " declares `package " + ld.files[i].unit.pkg + "` but is in package `" + pkgname + "`")
        for im in ld.files[i].unit.imports:
            child := pkg_basename(im.path)
            _merge(&ld, _resolve_pkg_dir(&ld, dir, im.path), child, child + "__")

    for i := lo; i < hi; i += 1:
        push(ld.order, i)

    # Pop the DFS path, then mark merged.
    na := []string
    for j := 0; j < len(ld.active) - 1; j += 1:
        push(na, ld.active[j])
    ld.active = na
    ld.seen[key] = true

# The Program is written into the caller's own: returning it copies the whole
# [File] array -- every unit, every function body -- once here and once more
# at check_or_die's return.
fn load_into(entry: string, argv0: string, outp: inout Program):
    src := read_file(entry)
    toks, notes := lex.tokenize_file(src, false, entry)
    root := corelib_root(argv0)
    dir := dir_of(entry)
    # Parse straight into the destination File. Taking the unit by value here
    # copied every declaration twice -- once out of parse, once into the File.
    outp = Program([]File, dir, "", entry, root)
    push(outp.files, File(entry, dir, "", "", _empty_unit(), src))
    parse.unit_into(toks, notes, &outp.files[0].unit)
    if len(outp.files[0].unit.pkg) == 0:
        # src/tychoc.c: a package-less file is a single-file build, and an
        # `import` in one is a hard error rather than a silently unloaded package.
        if len(outp.files[0].unit.imports) > 0:
            die(entry + ":" + str(outp.files[0].unit.imports[0].line) + ": error: to `import` a package, this file must declare its own package first -- add `package main` (or another name) as the first line")
        return
    upkg := outp.files[0].unit.pkg
    ld := Loader([]File, []int, []string: bool, []string, root, under_corelib(root, dir))
    _merge(&ld, dir, upkg, "")
    outp = Program([]File, dir, upkg, entry, root)
    for ix in ld.order:
        push(outp.files, ld.files[ix])
