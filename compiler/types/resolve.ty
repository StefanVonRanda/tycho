package types
import "core:strings"

import "core:sort"
import "../ast"

# Names, packages and scopes -- the pass src/tychoc.c spreads across
# parse_package_decl/parse_import_decl (headers), parse_const (top-level
# constants), the Sig table, and the g_vars stack inside resolve_expr.
#
# What this pass decides, and what it deliberately does not:
#
#   DECIDED   which declaration every identifier USE names -- a local, a
#             parameter, a pattern binding, a top-level const (folded), an enum
#             variant, a function, a generic template, a builtin, or an exported
#             symbol of an imported package. Plus the rules that are pure name
#             rules: a duplicate top-level name, a binding that starts
#             uppercase, a local declared and not used, an import not used in
#             its file, and a leading-underscore name reached from another
#             package.
#
#   DEFERRED  everything that needs a TYPE. A method call `x.f()` on a value
#             resolves its receiver and stops -- which function `f` names
#             depends on the receiver's type (UFCS), and that is Phase 6. Type
#             NAMES are deferred with it: `unknown type` is a Phase 6 message,
#             and the reject corpus still classes it SEMANTIC.
#
# The deferral is the reason this pass can only ever ACCEPT more than
# src/tychoc.c does, never less -- which is the property the accept corpora in
# compiler/run.sh measure.

# One declaration's position in its file, so build_table can walk the six
# parse-time categories in SOURCE order rather than in array order.
struct DeclRef:
    line: int
    cat: int                           # 1 struct 2 enum 3 newtype 4 handle 5 const 6 subscript
    idx: int

struct Sym:
    name: string                       # mangled: `<pkg>__<name>`, bare in the entry package
    kind: string                       # fn generic extern struct enum variant newtype handle const subscript
    file: string
    pkg: string
    dnote: string                      # the `# deprecated:` note, "" if none
    line: int                          # declaration line, for the never-called warning

struct Binding:
    name: string
    kind: string                       # local param bind loopvar typaram lconst
    used: bool
    report: bool                       # a plain `x := ...`, the only form Go's rule reports
    line: int

struct R:
    syms: [Sym]
    index: [string: int]
    vars: [Binding]
    nvars: int
    counts: [string: int]
    all_imports: [ast.ImportD]
    all_imp_file: [string]
    file_imports: [ast.ImportD]
    pkg_used: [string: bool]
    file: string
    line: int                          # the line of the node being walked
    shadow: [string: bool]             # names the builtin wins an unqualified call for
    warns: [string]                    # deferred, printed to stderr, never fatal
    srcp: [string]                     # file paths, parallel to srct
    srct: [string]                     # their source, for the diagnostic excerpt
    prefix: string
    root: string
    entry_in_corelib: bool
    file_in_corelib: bool
    in_generic: bool
    dup_base: int                      # src/tychoc.c@g_dup_base: -1 outside a fn top body
    bsigs: [string: bool]
    perrs: [string]                    # parse-phase diagnostics; see _perr
    errs: [string]
    late: [string]

# src/tychoc.c@register_builtins plus the shape-directed builtins resolve_expr
# handles by name (len/push/keys/get/pop/reserve/hash/zero/to_*). Written out
# rather than derived: a name added to that table is a language change, and a
# list that quietly grew would hide it.
fn _builtins() -> [string: bool]:
    m := []string: bool
    reserve(m, 64)   # a fixed table: pre-size it, or the growth path re-hashes every name
    for n in ["args", "channel", "char_at", "chr", "clock", "close", "die", "eprint",
              "exit", "fabs", "find", "floor", "get", "getenv", "hash", "input",
              "is_null", "keys", "len", "list_dir", "ncpu", "now", "pop", "pow",
              "print", "println", "push", "read_all", "read_file", "recv", "reserve",
              "send", "split", "sqrt", "str", "substr", "to_bool", "to_bytes",
              "to_char", "to_float", "to_int", "to_ptr", "to_str", "to_under",
              "to_i8", "to_i16", "to_i32", "to_i64", "to_u8", "to_u16", "to_u32",
              "to_u64", "to_f32",
              "wait", "write_file", "zero", "from_bytes", "size_of"]:
        m[n] = true
    return m

# The Sig table src/tychoc.c@register_builtins fills -- and ONLY that table. A
# top-level name that lands on one of these is `'%s' is already defined`, which
# is why `corelib/bignum/bignum.ty` compiled as an ENTRY file is refused (its
# `fn pow` is unprefixed there) and the same file compiled as a dependency is
# not (`bignum__pow` collides with nothing). The shape-directed builtins above
# are not in that table and do not collide.
# src/tychoc.c:4312@shadows_builtin, copied name for name. A user fn by one of
# these names does NOT win an unqualified call -- the builtin does -- so the
# declaration warns and the procedure is unreachable by that name. The two
# exclusions are deliberate there and kept here: no `eprintln` (not a builtin,
# FRICTION #6) and no `zero` (core:bignum's, not a builtin).
fn _shadowable() -> [string: bool]:
    m := []string: bool
    reserve(m, 64)
    for n in ["str", "substr", "chr", "split", "keys", "find", "char_at", "len",
              "push", "pop", "reserve", "map_get", "map_has", "map_set", "map_del",
              "sqrt", "pow", "floor", "fabs", "to_float", "to_int", "to_str", "to_bool",
              "to_bytes", "to_ptr", "to_u8", "to_u16", "to_u32", "to_u64",
              "to_i8", "to_i16", "to_i32", "to_i64", "to_f32", "is_null",
              "to_char", "hash",
              "print", "println", "eprint", "input", "read_all",
              "write_file", "list_dir", "getenv", "args", "die", "now", "clock",
              "ncpu", "channel", "send", "recv", "close"]:
        m[n] = true
    return m

fn _builtin_sigs() -> [string: bool]:
    m := []string: bool
    reserve(m, 32)
    for n in ["args", "char_at", "chr", "clock", "die", "eprint", "exit", "fabs",
              "find", "floor", "getenv", "input", "is_null", "list_dir", "ncpu",
              "now", "pow", "print", "println", "read_all", "read_file", "split",
              "sqrt", "str", "substr", "to_char", "to_ptr", "write_file"]:
        m[n] = true
    return m

fn _builtin_ctors() -> [string: bool]:
    m := []string: bool
    reserve(m, 8)
    for n in ["Some", "None", "Ok", "Err"]:
        m[n] = true
    return m

# src/tychoc.c prints `file:line: error: msg` for every one of these. The line
# is the walk's current node, set by _expr/_stmt and by the declaration loops --
# a stale one is the failure this cannot see for itself, which is why
# compiler/run.sh leg 9 compares every NAME rejection against ./tychoc's line.
# Every diagnostic carries the offending SOURCE LINE beneath it, right-aligned
# to width 6 then " | ", which is the shape every tests/diag/*.err golden pins:
#
#     tests/diag/dym_var.ty:3: error: unknown variable 'coutn'
#          3 |     print(str(coutn))
fn _excerpt(rs: inout R, file: string, line: int) -> string:
    if line <= 0:
        return ""
    for i := 0; i < len(rs.srcp); i += 1:
        if rs.srcp[i] != file:
            continue
        # Scan to the line rather than splitting the whole file: a warning is
        # one line of output and split() allocated an array of every line in a
        # 130 KB source for each one.
        src := rs.srct[i]
        st := 0
        ln := 1
        for st < len(src) and ln < line:
            if src[st] == 10:
                ln += 1
            st += 1
        if ln != line or st >= len(src):
            return ""
        en := st
        for en < len(src) and src[en] != 10:
            en += 1
        num := str(line)
        pad := ""
        for k := len(num); k < 6; k += 1:
            pad = pad + " "
        return "\n" + pad + num + " | " + src[st:en]
    return ""

# Typo suggestions. src/tychoc.c:1480@edit_dist is a bounded Levenshtein and
# its caller accepts the best candidate when
#     bestd <= (strlen(name) <= 4 ? 1 : 2)
# -- that threshold is copied, not invented, because it decides which
# tests/diag/dym_*.err goldens can match at all.
fn _edit(a: string, b: string) -> int:
    la := len(a)
    lb := len(b)
    prev := []int
    for j := 0; j <= lb; j += 1:
        push(prev, j)
    for i := 1; i <= la; i += 1:
        cur := []int
        push(cur, i)
        for j := 1; j <= lb; j += 1:
            c := 1
            if a[i - 1] == b[j - 1]:
                c = 0
            v := prev[j - 1] + c
            if prev[j] + 1 < v:
                v = prev[j] + 1
            if cur[j - 1] + 1 < v:
                v = cur[j - 1] + 1
            push(cur, v)
        prev = cur
    return prev[lb]

fn _dym_best(name: string, cands: [string]) -> string:
    best := ""
    bestd := 99
    for c in cands:
        if c == name:
            continue
        d := _edit(name, c)
        if d < bestd:
            bestd = d
            best = c
    lim := 2
    if len(name) <= 4:
        lim = 1
    if bestd <= lim and len(best) > 0:
        return best
    return ""

fn _dym(name: string, cands: [string]) -> string:
    b := _dym_best(name, cands)
    if len(b) > 0:
        return "; did you mean '" + b + "'?"
    return ""

# The candidate sets each site draws from: locals in scope, and table symbols
# of a given kind. Kept beside _dym so the two stay in step.
fn _vcands(rs: inout R) -> [string]:
    out := []string
    for i := 0; i < rs.nvars; i += 1:
        push(out, rs.vars[i].name)
    return out

fn _scands(rs: inout R, kind: string) -> [string]:
    out := []string
    for sy in rs.syms:
        if sy.kind == kind:
            push(out, _short(sy.name))
    return out

# The package did-you-mean is NOT the plain edit-distance one. `suggest_pkg_symbol`
# has a SECOND arm: when no candidate is close enough, the first symbol where one
# of the two names is a prefix of the other and both are at least 4 bytes long is
# offered instead (`to_uppe` ~ `to_upper`). Porting only the first arm would agree
# on the two fixtures here and disagree elsewhere, so both are carried over.
# Candidates are the package's entries in the SIG table, which is fns and externs:
# an UNINSTANTIATED generic is absent there too, and the bootstrap checks
# `generic_find` on its own before ever reaching this.
fn _pkg_cands(rs: inout R, prefix: string) -> [string]:
    out := []string
    for sy in rs.syms:
        if sy.kind != "fn" and sy.kind != "extern":
            continue
        if len(sy.name) <= len(prefix):
            continue
        if not strings.starts_with(sy.name, prefix):
            continue
        push(out, sy.name[len(prefix):])
    return out

fn _pkg_dym(rs: inout R, q: string, name: string) -> string:
    cands := _pkg_cands(&rs, _prefix_for(&rs, q))
    b := _dym_best(name, cands)
    if len(b) == 0 and len(name) >= 4:
        for c in cands:
            if len(c) < 4:
                continue
            if strings.starts_with(name, c) or strings.starts_with(c, name):
                b = c
                break
    if len(b) == 0:
        return ""
    return "; did you mean '" + b + "'?"

# A warning is never fatal: it is collected and printed to stderr after the
# build succeeds, which is what the tests/warn goldens capture.
# Fall-off-the-end lint (src/tychoc.c@block_ends_in_return). Deliberately shallow:
# only the LAST statement is examined, `die()` does not count, and a body ending
# in an infinite loop warns -- matching the C compiler exactly.
fn _ends_ret(body: [ast.Stmt]) -> bool:
    if len(body) == 0:
        return false
    match body[len(body) - 1]:
        ast.ReturnS(l, k): return true
        ast.MatchS(l, c, arms):
            for a in arms:
                if not _ends_ret(a.body):
                    return false
            return len(arms) > 0
        ast.IfS(l, c, b, e):
            return len(e) > 0 and _ends_ret(b) and _ends_ret(e)
        _: return false
    return false

fn _warn(rs: inout R, msg: string):
    # A dependency under corelib is not the caller's to fix (src/tychoc.c:14401).
    if not rs.entry_in_corelib and strings.contains(rs.file, "corelib/"):
        return
    push(rs.warns, rs.file + ":" + str(rs.line) + ": warning: " + msg +
        _excerpt(&rs, rs.file, rs.line))

# A function nothing ever resolved BY NAME. src/tychoc.c@report_dead_procs is
# the authority and its exemptions are copied, not guessed: `main`, anything
# under corelib/ (a dependency exports what it likes), extern and builtin. It
# is a WARNING because this is name-based reachability rather than a call
# graph -- an indirect call the resolver never saw by name would otherwise be
# a false ERROR.
fn report_dead(rs: inout R):
    for i := 0; i < len(rs.syms); i += 1:
        sy := rs.syms[i]
        if sy.kind != "fn":
            continue
        short := _short(sy.name)
        if short == "main":
            continue
        if strings.contains(sy.file, "corelib/"):
            continue
        # every spelling that RESOLVES the name counts as a use: a bare call,
        # a package-qualified one, and taking it as a value.
        if ("call:" + sy.name) in rs.counts or ("fnval:" + sy.name) in rs.counts or
                ("pkgcall:" + sy.name) in rs.counts:
            continue
        sf := rs.file
        sl := rs.line
        rs.file = sy.file
        rs.line = sy.line
        _warn(&rs, "'" + short + "' is never called")
        rs.file = sf
        rs.line = sl

fn warn_lines(rs: R) -> [string]:
    return rs.warns

fn _err(rs: inout R, msg: string):
    push(rs.errs, rs.file + ":" + str(rs.line) + ": error: " + msg +
        _excerpt(&rs, rs.file, rs.line))

# src/tychoc.c drains `declared and not used` and `imported and not used` only
# AFTER resolve has finished without dying (report_unused_locals /
# report_unused_imports, and the collected-not-printed comment above g_ul says
# why). tychoc1 does no type checking, so it reaches that end on programs
# src/tychoc.c never does: making these part of the VERDICT rejected 20
# tests/reject fixtures whose real refusal is a type error, which is a rejection
# for the wrong reason. They are kept, printed and gated -- over the ACCEPT
# corpus, where src/tychoc.c does reach the end and the count must be zero.
# src/tychoc.c:2623 -- the leak on a DECLARED TYPE is emitted by parse_type,
# so it precedes every resolve-time diagnostic including the whole-program
# `no 'main'` check. tychoc1 finds it during the walk instead, so it is banked
# here and spliced in front at the end of resolve(). The same message from an
# expression qualifier (src/tychoc.c:6710) IS resolve-time and stays in errs.
fn _perr(rs: inout R, msg: string):
    push(rs.perrs, rs.file + ":" + str(rs.line) + ": error: " + msg)

fn _late(rs: inout R, msg: string):
    push(rs.late, rs.file + ":" + str(rs.line) + ": error: " + msg)

fn _note(rs: inout R, key: string):
    rs.counts[key] = rs.counts.get(key, 0) + 1

# --- the global table -------------------------------------------------------

fn _add(rs: inout R, name: string, kind: string, file: string, pkg: string):
    _addn(&rs, name, kind, file, pkg, "")

fn _addn(rs: inout R, name: string, kind: string, file: string, pkg: string, dn: string):
    _addl(&rs, name, kind, file, pkg, dn, 0)

fn _shadow_warn(rs: inout R, name: string, kind: string, file: string, ln: int):
    if not (_short(name) in rs.shadow) or kind != "fn":
        return
    short := _short(name)
    sf := rs.file
    sl := rs.line
    rs.file = file
    rs.line = ln
    if len(rs.prefix) > 0:
        _warn(&rs, "`" + short + "` collides with the builtin of the same name -- every unqualified `" +
            short + "(...)` calls the BUILTIN, so this procedure is unreachable by that name (§3.7)." +
            " Rename it, or call it qualified as `pkg." + short + "(...)`.")
    else:
        _warn(&rs, "`" + short + "` collides with the builtin of the same name -- every unqualified `" +
            short + "(...)` calls the BUILTIN, so this procedure is unreachable by that name (§3.7)." +
            " `package main` has no package prefix to qualify with, so rename it.")
    rs.file = sf
    rs.line = sl

fn _addl(rs: inout R, name: string, kind: string, file: string, pkg: string, dn: string, ln: int):
    # src/tychoc.c:4342 makes a builtin collision a WARNING, not an error: the
    # builtin wins every unqualified call, so the procedure is merely
    # unreachable by that name. A CONSTRUCTOR collision stays fatal there
    # (is_builtin_ctor, :4275), which is the branch below.
    # ORDER MATTERS. A name with a builtin SIGNATURE (rs.bsigs -- die, pow,
    # find, ...) stays a hard error, which is what ./tychoc does: measured as
    # leg8 disagreements on corelib/bignum.ty@pow, corelib/regex.ty@find and
    # tests/diag/shadow_builtin_main.ty@die when this branch ran first. Only a
    # name that is shadowable WITHOUT being one of those (len, hash, push, ...)
    # downgrades to the warning.
    if name in rs.bsigs:
        # ./tychoc prints BOTH for a name that is shadowable AND has a builtin
        # signature (`die`): the warning, then the hard error.
        _shadow_warn(&rs, name, kind, file, ln)
        _err(&rs, "'" + name + "' is already defined")
        return
    _shadow_warn(&rs, name, kind, file, ln)

    if name in rs.index:
        prev := rs.syms[rs.index[name]]
        if kind == "variant" and prev.kind == "variant":
            _err(&rs, "variant name '" + _short(name) + "' is already used in this package")
        elif prev.file != file and (kind == "fn" or kind == "generic" or kind == "extern"):
            _err(&rs, "'" + name + "' is already defined -- also at " + prev.file + ":" + str(prev.line) +
                 ", a DIFFERENT file in the same package: tychoc compiles every .ty beside the entry " +
                 "file, so two unrelated programs cannot share one directory")
        else:
            _err(&rs, "'" + name + "' is already defined")
        return
    rs.index[name] = len(rs.syms)
    push(rs.syms, Sym(name, kind, file, pkg, dn, ln))

fn build_table(p: Program) -> R:
    rs := R([]Sym, []string: int, []Binding, 0, []string: int, []ast.ImportD, []string,
            []ast.ImportD, []string: bool, "", 0, []string: bool, []string, []string, []string, "", p.root, false, false, false, -1, []string: bool, []string, []string, []string)
    for f in p.files:
        push(rs.srcp, f.path)
        push(rs.srct, f.src)
    rs.bsigs = _builtin_sigs()
    rs.shadow = _shadowable()
    rs.entry_in_corelib = under_corelib(p.root, p.entry_dir)
    ctors := _builtin_ctors()
    for f in p.files:
        rs.file = f.path
        for im in f.unit.imports:
            push(rs.all_imports, im)
            push(rs.all_imp_file, f.path)
        # REGISTRATION ORDER IS PART OF THE DIAGNOSTIC. src/tychoc.c registers a
        # struct/enum/newtype/handle/const/subscript AS IT PARSES, so of two
        # colliding declarations the one written LATER is the one named; a `fn`
        # is checked afterwards, in resolve_program (src/tychoc.c@die_dup_proc),
        # which names the PROC whichever side came first. Walking the categories
        # in array order registered every fn before every struct and got 7 of
        # the 27 NAME fixtures' lines wrong while every verdict leg stayed green.
        ds := []DeclRef
        for k := 0; k < len(f.unit.structs); k += 1:
            push(ds, DeclRef(f.unit.structs[k].line, 1, k))
        for k := 0; k < len(f.unit.enums); k += 1:
            push(ds, DeclRef(f.unit.enums[k].line, 2, k))
        for k := 0; k < len(f.unit.newtypes); k += 1:
            push(ds, DeclRef(f.unit.newtypes[k].line, 3, k))
        for k := 0; k < len(f.unit.handles); k += 1:
            push(ds, DeclRef(f.unit.handles[k].line, 4, k))
        for k := 0; k < len(f.unit.consts); k += 1:
            push(ds, DeclRef(f.unit.consts[k].line, 5, k))
        for k := 0; k < len(f.unit.subscripts); k += 1:
            push(ds, DeclRef(f.unit.subscripts[k].line, 6, k))
        for a := 0; a < len(ds); a += 1:
            b := a
            for c := a + 1; c < len(ds); c += 1:
                if ds[c].line < ds[b].line:
                    b = c
            tmp := ds[a]
            ds[a] = ds[b]
            ds[b] = tmp
        for d in ds:
            if d.cat == 1:
                sd := f.unit.structs[d.idx]
                rs.line = sd.line
                if sd.name in ctors:
                    _err(&rs, "'" + sd.name + "' is already defined")
                _add(&rs, f.prefix + sd.name, "struct", f.path, f.pkg)
            elif d.cat == 2:
                ed := f.unit.enums[d.idx]
                rs.line = ed.line
                if ed.name in ctors:
                    _err(&rs, "'" + ed.name + "' is already defined")
                _add(&rs, f.prefix + ed.name, "enum", f.path, f.pkg)
                for v in ed.variants:
                    rs.line = v.line
                    if v.name in ctors:
                        _err(&rs, "'" + v.name + "' is already defined")
                    _add(&rs, f.prefix + v.name, "variant", f.path, f.pkg)
            elif d.cat == 3:
                nd := f.unit.newtypes[d.idx]
                rs.line = nd.line
                if nd.name in ctors:
                    _err(&rs, "'" + nd.name + "' is already defined")
                _add(&rs, f.prefix + nd.name, "newtype", f.path, f.pkg)
            elif d.cat == 4:
                hd := f.unit.handles[d.idx]
                rs.line = hd.line
                if hd.name in ctors:
                    _err(&rs, "'" + hd.name + "' is already defined")
                _add(&rs, f.prefix + hd.name, "handle", f.path, f.pkg)
            elif d.cat == 5:
                cd := f.unit.consts[d.idx]
                rs.line = cd.line
                if cd.name in ctors:
                    _err(&rs, "'" + cd.name + "' is already defined")
                _add(&rs, f.prefix + cd.name, "const", f.path, f.pkg)
            else:
                sb := f.unit.subscripts[d.idx]
                rs.line = sb.line
                _add(&rs, f.prefix + "subscript$" + sb.name, "subscript", f.path, f.pkg)
        for fd in f.unit.fns:
            rs.line = fd.line
            if fd.name in ctors:
                _err(&rs, "'" + fd.name + "' is already defined")
            if fd.is_extern:
                # A C symbol is global: src/tychoc.c does not mangle it.
                _add(&rs, fd.name, "extern", f.path, f.pkg)
            elif len(fd.typarams) > 0 or len(_sig_sizeparams(fd.params, fd.ret)) > 0:
                # A `[$N]T` size parameter makes the fn a TEMPLATE as surely as a
                # `$T` does: it has no Sig in src/tychoc.c either, which is what
                # keeps report_dead_procs off it.
                _add(&rs, f.prefix + fd.name, "generic", f.path, f.pkg)
            else:
                _addl(&rs, f.prefix + fd.name, "fn", f.path, f.pkg, fd.dnote, fd.line)
    return rs

# --- scopes -----------------------------------------------------------------

fn _mark(rs: inout R) -> int:
    return rs.nvars

fn _restore(rs: inout R, m: int):
    for i := m; i < rs.nvars; i += 1:
        if rs.vars[i].report and not rs.vars[i].used:
            keep := rs.line
            rs.line = rs.vars[i].line
            _late(&rs, "'" + rs.vars[i].name + "' declared and not used")
            rs.line = keep
    rs.nvars = m

fn _push(rs: inout R, name: string, kind: string, report: bool):
    # A type/size parameter is not a runtime binding: `$T`/`$N` are uppercase by
    # convention and src/tychoc.c keeps them in their own table. Everything else
    # goes through vars_push and its uppercase-namespace rule (src/tychoc.c:5662).
    if kind != "typaram" and kind != "lconst" and len(name) > 0 and name[0] >= 65 and name[0] <= 90:
        _err(&rs, "'" + name + "' cannot name a binding -- a local, parameter or pattern binding must start with a lowercase letter or '_'")
    r := report
    if len(name) > 0 and name[0] == 95:
        r = false
    if rs.file_in_corelib:
        r = false
    # Measured 2026-08-23, two probes: an unused local in a plain fn is refused
    # by ./tychoc, the same local in a `$T` fn is accepted -- a generic TEMPLATE
    # body is never resolved as written, only its instances are. Without this
    # tests/generic_sig_realloc.ty (28 unused locals, deliberately) was the one
    # accept-corpus file this pass refused.
    if rs.in_generic:
        r = false
    b := Binding(name, kind, false, r, rs.line)
    if rs.nvars < len(rs.vars):
        rs.vars[rs.nvars] = b
    else:
        push(rs.vars, b)
    rs.nvars += 1

fn _lookup(rs: inout R, name: string) -> int:
    for i := rs.nvars - 1; i >= 0; i -= 1:
        if rs.vars[i].name == name:
            rs.vars[i].used = true
            return i
    return -1

fn _sym(rs: inout R, name: string) -> int:
    if name in rs.index:
        return rs.index[name]
    return -1

# --- imports ----------------------------------------------------------------

fn _imported_here(rs: inout R, q: string) -> bool:
    for im in rs.file_imports:
        if (len(im.alias) > 0 and im.alias == q) or pkg_basename(im.path) == q:
            return true
    return false

fn _imported_anywhere(rs: inout R, q: string) -> bool:
    for im in rs.all_imports:
        if (len(im.alias) > 0 and im.alias == q) or pkg_basename(im.path) == q:
            return true
    return false

# src/tychoc.c@pkg_prefix_for: an alias binds to the path's last component, and
# marking runs over EVERY import naming the qualifier (its own comment records
# that the marking is not file-scoped, deliberately).
fn _prefix_for(rs: inout R, q: string) -> string:
    rs.pkg_used[q] = true
    for im in rs.all_imports:
        if len(im.alias) > 0 and im.alias == q:
            return pkg_basename(im.path) + "__"
    return q + "__"

fn _pkg_sym(rs: inout R, q: string, n: string) -> string:
    if len(n) > 0 and n[0] == 95:
        _err(&rs, "'" + q + "." + n + "' is package-private: a leading-underscore name is not accessible from another package")
    return _prefix_for(&rs, q) + n

# A type is not RESOLVED here -- `unknown type` is Phase 6 (the reject corpus
# still classes it SEMANTIC). Two things a type does decide at this layer: a
# qualified type is what makes its import used (corelib/test/fmath was reported
# as importing core:fmath unused until this walked), and a `[$N]T` size
# parameter is a value inside the body, which parse.ty computes and discards.
fn _ty(rs: inout R, t: ast.Ty):
    match t:
        ast.TName(q, n, targs):
            if len(q) > 0:
                if _imported_here(&rs, q):
                    rs.pkg_used[q] = true
                elif _imported_anywhere(&rs, q):
                    _perr(&rs, "package '" + q + "' is used here but this file does not `import` it (another file in the build does; imports are per-file)")
            for a in targs:
                _ty(&rs, a)
        ast.TArr(k): _tys(&rs, k)
        ast.TFix(sz, k): _tys(&rs, k)
        ast.TMap(k): _tys(&rs, k)
        ast.TTup(k): _tys(&rs, k)
        ast.TFn(hr, k): _tys(&rs, k)
        ast.TSoa(k): _tys(&rs, k)
        ast.TBnd(sz, k): _tys(&rs, k)
        ast.TVec(sz, k): _tys(&rs, k)
        _: pass

fn _tys(rs: inout R, ts: [ast.Ty]):
    for t in ts:
        _ty(&rs, t)

fn _sizeparams_ty(t: ast.Ty, acc: [string]) -> [string]:
    out := acc
    match t:
        ast.TFix(sz, k):
            if len(sz) > 1 and sz[0] == 36:
                push(out, sz[1:])
            return _sizeparams_ty(k[0], out)
        ast.TBnd(sz, k):
            if len(sz) > 1 and sz[0] == 36:
                push(out, sz[1:])
            return _sizeparams_ty(k[0], out)
        ast.TVec(sz, k): return _sizeparams_ty(k[0], out)
        ast.TArr(k): return _sizeparams_ty(k[0], out)
        ast.TSoa(k): return _sizeparams_ty(k[0], out)
        ast.TName(q, n, ta):
            for a in ta:
                out = _sizeparams_ty(a, out)
            return out
        ast.TMap(k):
            for a in k:
                out = _sizeparams_ty(a, out)
            return out
        ast.TTup(k):
            for a in k:
                out = _sizeparams_ty(a, out)
            return out
        ast.TFn(hr, k):
            for a in k:
                out = _sizeparams_ty(a, out)
            return out
        _: return out
    return out

# --- expressions ------------------------------------------------------------

fn _kindof(rs: inout R, name: string) -> string:
    i := _sym(&rs, name)
    if i < 0:
        return ""
    return rs.syms[i].kind

fn _callable(k: string) -> bool:
    return k == "fn" or k == "extern" or k == "generic" or k == "struct" or k == "newtype" or k == "variant"

fn _exprs(rs: inout R, bi: [string: bool], ctors: [string: bool], es: [ast.Expr]):
    for e in es:
        _expr(&rs, bi, ctors, e)

# The receiver of `q.name(...)` / `q.field` when `q` is a bare identifier. Returns
# true when `q` named a package (src/tychoc.c resolves the member); false when it
# named a value, in which case the member is a field or a UFCS method and its
# resolution needs the receiver's TYPE -- Phase 6.
# `Shape.Circle(1.0)`: the qualifier is an ENUM in scope, not a package. Variant
# names are global in Tycho, so this is its own diagnostic in src/tychoc.c and
# not a "package has no symbol" -- and it is decided by the symbol table alone.
fn _enum_qual(rs: inout R, q: string, n: string) -> bool:
    if _lookup(&rs, q) >= 0:
        return false
    if _kindof(&rs, rs.prefix + q) != "enum" and _kindof(&rs, q) != "enum":
        return false
    if _kindof(&rs, rs.prefix + n) != "variant" and _kindof(&rs, n) != "variant":
        return false
    _err(&rs, "'" + n + "' is a variant of enum " + q + ", not a package member -- variant names are global, write " + n + "(...)")
    return true

# `report` is false at a qualified CALL: there the "no symbol" message below
# carries the whole story, and ./tychoc prints only that one. Everywhere else an
# unknown qualifier is still an unknown variable.
fn _qual_is_pkg(rs: inout R, q: string, report: bool) -> bool:
    if _lookup(&rs, q) >= 0:
        return false
    if _imported_here(&rs, q):
        return true
    if _imported_anywhere(&rs, q):
        _err(&rs, "package '" + q + "' is used here but this file does not `import` it (another file in the build does; imports are per-file)")
        return true
    if report:
        _err(&rs, "unknown variable '" + q + "'" + _dym(q, _vcands(&rs)))
    return true

fn _expr(rs: inout R, bi: [string: bool], ctors: [string: bool], e: ast.Expr):
    rs.line = ast.line_of(e)
    match e:
        ast.Name(l, n):
            if _lookup(&rs, n) >= 0:
                _note(&rs, "local")
                return
            # src/tychoc.c:6193-6234: const (package-qualified) -> variant (own
            # package, then bare) -> fn (bare, then own package) -> generic.
            if _kindof(&rs, rs.prefix + n) == "const":
                _note(&rs, "const:" + rs.prefix + n)
                return
            if len(rs.prefix) > 0 and _kindof(&rs, rs.prefix + n) == "variant":
                _note(&rs, "variant:" + rs.prefix + n)
                return
            if _kindof(&rs, n) == "variant":
                _note(&rs, "variant:" + n)
                return
            k := _kindof(&rs, n)
            if k == "fn" or k == "extern":
                _note(&rs, "fnval:" + n)
                _dwarn(&rs, n)
                return
            if len(rs.prefix) > 0:
                k2 := _kindof(&rs, rs.prefix + n)
                if k2 == "fn" or k2 == "generic":
                    _note(&rs, "fnval:" + rs.prefix + n)
                    _dwarnq(&rs, rs.prefix + n, n)
                    return
            if k == "generic":
                _note(&rs, "fnval:" + n)
                _dwarn(&rs, n)
                return
            # src/tychoc.c:6239 -- `pass` is a statement, so here it can only be
            # a value branch's tail, and that rule outranks did-you-mean.
            if n == "pass":
                _err(&rs, "`pass` is a statement and produces no value -- a value if/match needs one in every branch, so write this as a plain statement")
                return
            _err(&rs, "unknown variable '" + n + "'" + _dym(n, _vcands(&rs)))
        ast.Call(l, q, n, ts, args):
            _tys(&rs, ts)
            if len(q) == 0:
                _call_bare(&rs, bi, ctors, n)
            elif _enum_qual(&rs, q, n):
                _note(&rs, "enumqual")
            elif _qual_is_pkg(&rs, q, false):
                m := _pkg_sym(&rs, q, n)
                if _callable(_kindof(&rs, m)) or _kindof(&rs, m) == "const":
                    # `old.stale(3)` warns as `old.stale`, the QUALIFIED
                    # spelling, which is how the golden names it.
                    _dwarnq(&rs, m, q + "." + n)
                    _note(&rs, "pkgcall:" + m)
                elif n in bi:
                    _err(&rs, "'" + n + "' is a builtin, not a member of package '" + q + "' -- call it directly: " + n + "(...)")
                else:
                    imp := ""
                    if not _imported_here(&rs, q):
                        imp = " -- and this file does not `import` it; add the import first"
                    sg := _pkg_dym(&rs, q, n)
                    _err(&rs, "package '" + q + "' has no symbol '" + n + "'" + sg + imp)
            else:
                # UFCS: `b.twice()` calls `twice`, and report_dead counts calls.
                _note(&rs, "method:" + n)
                if _callable(_kindof(&rs, rs.prefix + n)):
                    _note(&rs, "call:" + rs.prefix + n)
                elif _callable(_kindof(&rs, n)):
                    _note(&rs, "call:" + n)
            _exprs(&rs, bi, ctors, args)
        ast.Field(l, k, f):
            match k[0]:
                ast.Name(l2, q):
                    if _qual_is_pkg(&rs, q, true):
                        m := _pkg_sym(&rs, q, f)
                        kk := _kindof(&rs, m)
                        if len(kk) > 0:
                            _note(&rs, "pkgmember:" + m)
                            # `opsx.bump` as a VALUE is a use, exactly as the
                            # unqualified `f := bump` is -- report_dead counts
                            # `fnval:` and saw neither.
                            if _callable(kk):
                                _note(&rs, "fnval:" + m)
                                _dwarnq(&rs, m, q + "." + f)
                        else:
                            sg := _pkg_dym(&rs, q, f)
                            _err(&rs, "package '" + q + "' has no variant, const or function '" + f + "'" + sg)
                        return
                    _note(&rs, "field")
                    return
                _:
                    _note(&rs, "field")
            _exprs(&rs, bi, ctors, k)
        ast.IsVar(l, k, q, v):
            _exprs(&rs, bi, ctors, k)
            if len(q) > 0 and _qual_is_pkg(&rs, q, true):
                _note(&rs, "isvar:" + _pkg_sym(&rs, q, v))
            else:
                _note(&rs, "isvar:" + v)
        ast.Lambda(l, ps, rt, body):
            _tys(&rs, rt)
            m := _mark(&rs)
            for p in ps:
                _tys(&rs, p.ty)
                _push(&rs, p.name, "param", false)
            _exprs(&rs, bi, ctors, body)
            _restore(&rs, m)
        ast.TupIdx(l, k, i): _exprs(&rs, bi, ctors, k)
        ast.Index(l, k): _exprs(&rs, bi, ctors, k)
        ast.Slice(l, a, b, k): _exprs(&rs, bi, ctors, k)
        ast.CallVal(l, k):
            # A CHAINED UFCS call -- `b.twice().shown()` -- has a Field callee
            # whose receiver is not a name, so it never reaches the arm above.
            match k[0]:
                ast.Field(l2, r2, fn2):
                    if _callable(_kindof(&rs, rs.prefix + fn2)):
                        _note(&rs, "call:" + rs.prefix + fn2)
                    elif _callable(_kindof(&rs, fn2)):
                        _note(&rs, "call:" + fn2)
                _: pass
            _exprs(&rs, bi, ctors, k)
        ast.Named(l, nm, k): _exprs(&rs, bi, ctors, k)
        ast.Binop(l, o, k): _exprs(&rs, bi, ctors, k)
        ast.Unop(l, o, k): _exprs(&rs, bi, ctors, k)
        ast.ArrLit(l, k): _exprs(&rs, bi, ctors, k)
        ast.MapLit(l, k): _exprs(&rs, bi, ctors, k)
        ast.Tuple(l, k): _exprs(&rs, bi, ctors, k)
        ast.SomeE(l, k): _exprs(&rs, bi, ctors, k)
        ast.OkE(l, k): _exprs(&rs, bi, ctors, k)
        ast.ErrE(l, k): _exprs(&rs, bi, ctors, k)
        ast.SpawnE(l, k): _exprs(&rs, bi, ctors, k)
        ast.OrRet(l, k): _exprs(&rs, bi, ctors, k)
        ast.Spread(l, k): _exprs(&rs, bi, ctors, k)
        ast.Addr(l, k): _exprs(&rs, bi, ctors, k)
        ast.ChanE(l, t, k):
            _tys(&rs, t)
            _exprs(&rs, bi, ctors, k)
        ast.FStrLit(l, body, hs): _exprs(&rs, bi, ctors, hs)
        ast.EmptyArr(l, t): _tys(&rs, t)
        ast.EmptyMap(l, t): _tys(&rs, t)
        ast.SoaLit(l, t): _tys(&rs, t)
        _: pass

# An unqualified call. src/tychoc.c:6743-6750 tries the OWN package first and
# falls through to the unprefixed name, then to the builtin table. The local
# fallback is last and is a deferral: a local by this name is only callable when
# it is fn-typed, which is a Phase 6 question -- resolving it here would refuse
# a legal call, and this pass may only ever accept more.
# `double(2)` where `double` carries a `# deprecated:` note warns AT THE CALL,
# naming the note verbatim. src/tychoc.c@dnote_scan attaches the note; Phase 2b
# carried it to ast.Fn.dnote and it reaches the Sym here.
fn _dwarnq(rs: inout R, mangled: string, spelt: string):
    if mangled in rs.index:
        sy := rs.syms[rs.index[mangled]]
        if len(sy.dnote) > 0:
            _warn(&rs, "`" + spelt + "` is deprecated: " + sy.dnote)

fn _dwarn(rs: inout R, mangled: string):
    _dwarnq(&rs, mangled, _short(mangled))

fn _call_bare(rs: inout R, bi: [string: bool], ctors: [string: bool], n: string):
    # A shadowable name resolves to the BUILTIN, never to the user's fn of that
    # name (src/tychoc.c:4342's whole premise). Checked before either package
    # lookup, so the user's `len` stays unreachable and report_dead sees it.
    if n in rs.shadow and (n in bi or n in ctors):
        _note(&rs, "builtin:" + n)
        return
    if len(rs.prefix) > 0 and _callable(_kindof(&rs, rs.prefix + n)):
        _dwarn(&rs, rs.prefix + n)
        _note(&rs, "call:" + rs.prefix + n)
        return
    if _callable(_kindof(&rs, n)):
        _dwarn(&rs, n)
        _note(&rs, "call:" + n)
        return
    if n in bi or n in ctors:
        _note(&rs, "builtin:" + n)
        return
    if _lookup(&rs, n) >= 0:
        _note(&rs, "callval")
        return
    # src/tychoc.c:7247 special-cases this one by name; it is not a corelib
    # lookup, so it is a literal here too.
    # gap: src/tychoc.c:5823's corelib hint ("core:arrays provides `sort` --
    # add `import \"core:arrays\"` ...") needs a scan of the corelib's exported
    # symbols, which tychoc1 does not build. diag_corelib_call_hint stays red.
    if n == "eprintln":
        _err(&rs, "unknown procedure 'eprintln' -- stderr has no println; use `eprint(s + \"\\n\")`")
        return
    # A high-confidence corelib match beats a weak local typo (src/tychoc.c:7244).
    cl, strong := corelib_hint(rs.root, n)
    if len(cl) > 0 and strong:
        _err(&rs, "unknown procedure '" + n + "' -- " + cl)
        return
    dy := _dym(n, _scands(&rs, "fn"))
    if len(dy) > 0:
        _err(&rs, "unknown procedure '" + n + "'" + dy)
        return
    if len(cl) > 0:
        _err(&rs, "unknown procedure '" + n + "' -- " + cl)
        return
    _err(&rs, "unknown procedure '" + n + "'")

# --- statements -------------------------------------------------------------

# The three ways `x = ...` can fail on the NAME alone: no such binding, a
# binding that is an immutable local const, and a top-level const of this
# package (src/tychoc.c:8578 -- a const is folded at each use, so there is
# nothing to assign to).
fn _assign_to(rs: inout R, name: string, multi: bool):
    i := _lookup(&rs, name)
    if i >= 0:
        if rs.vars[i].kind == "lconst":
            _err(&rs, "cannot assign to constant '" + name + "'")
        return
    if _kindof(&rs, rs.prefix + name) == "const":
        _err(&rs, "cannot assign to constant '" + name + "'")
        return
    if name == "_":
        if multi:
            _err(&rs, "`_` is not a discard -- it is an ordinary variable, and this one was never declared. " +
                 "Name every element, or declare `_` once with `:=` and reuse it")
        else:
            _err(&rs, "`_` is not a discard -- it is an ordinary variable, and this one was never declared. " +
                 "To drop a result, call it as a statement (`f(x)`); to keep it, name it (`x := f(x)`)")
        return
    hint := ""
    if multi:
        hint = " (use ':=' to declare)"
    _err(&rs, "assignment to unknown variable '" + name + "'" + hint + _dym(name, _vcands(&rs)))

# src/tychoc.c@resolve_block: a `:=` may not re-declare a name already live in
# THIS block's duplicate scope. That scope is the block's own start, except in a
# function's top body, where g_dup_base reaches back over the parameters (the
# body shares their C scope) -- so a nested block shadowing an outer local is
# legal and `x := 5` beside a parameter `x` is not. Both measured 2026-08-23.
fn _block(rs: inout R, bi: [string: bool], ctors: [string: bool], body: [ast.Stmt]):
    m := _mark(&rs)
    dbase := m
    if rs.dup_base >= 0:
        dbase = rs.dup_base
    rs.dup_base = -1
    for s in body:
        match s:
            ast.Decl(dl, dn, dt, dr, dvb):
                for i := dbase; i < rs.nvars; i += 1:
                    if rs.vars[i].name == dn:
                        keep := rs.line
                        rs.line = dl
                        _err(&rs, "'" + dn + "' is already declared in this scope")
                        rs.line = keep
            _: pass
        _stmt(&rs, bi, ctors, s)
    _restore(&rs, m)

fn _stmt(rs: inout R, bi: [string: bool], ctors: [string: bool], s: ast.Stmt):
    rs.line = ast.sline_of(s)
    match s:
        ast.ExprStmt(l, k): _exprs(&rs, bi, ctors, k)
        ast.Decl(l, name, ty, rhs, vb):
            _tys(&rs, ty)
            _exprs(&rs, bi, ctors, rhs)
            _block(&rs, bi, ctors, vb)
            rs.line = l
            _push(&rs, name, "local", true)
        ast.MDecl(l, isdecl, names, rhs):
            _exprs(&rs, bi, ctors, rhs)
            rs.line = l
            if isdecl:
                seen := []string: bool
                for nm in names:
                    if nm in seen:
                        _err(&rs, "duplicate name '" + nm + "' in the destructuring list")
                    seen[nm] = true
                    _push(&rs, nm, "local", false)
            else:
                for nm in names:
                    _assign_to(&rs, nm, true)
        ast.Assign(l, name, rhs):
            _exprs(&rs, bi, ctors, rhs)
            rs.line = l
            _assign_to(&rs, name, false)
        ast.PlaceSet(l, k): _exprs(&rs, bi, ctors, k)
        ast.ConstS(l, name, v):
            _exprs(&rs, bi, ctors, v)
            rs.line = l
            _push(&rs, name, "lconst", false)
        ast.ReturnS(l, k): _exprs(&rs, bi, ctors, k)
        ast.DeleteS(l, k): _exprs(&rs, bi, ctors, k)
        ast.IfS(l, c, b, e):
            _exprs(&rs, bi, ctors, c)
            _block(&rs, bi, ctors, b)
            _block(&rs, bi, ctors, e)
        ast.WhileS(l, c, b):
            _exprs(&rs, bi, ctors, c)
            _block(&rs, bi, ctors, b)
            _wl_check(&rs, l, c, b)
        ast.For3(l, init, c, b):
            m := _mark(&rs)
            for st in init:
                _stmt(&rs, bi, ctors, st)
            _exprs(&rs, bi, ctors, c)
            _block(&rs, bi, ctors, b)
            _restore(&rs, m)
        ast.ForIn(l, v, coll, b, zpf):
            _exprs(&rs, bi, ctors, coll)
            m := _mark(&rs)
            rs.line = l
            _push(&rs, v, "loopvar", false)
            rs.dup_base = m        # src/tychoc.c:4103: `x := COLL[i]` IS the body's first stmt
            _block(&rs, bi, ctors, b)
            _restore(&rs, m)
        ast.ForRange(l, v, bounds, b):
            _exprs(&rs, bi, ctors, bounds)
            m := _mark(&rs)
            rs.line = l
            _push(&rs, v, "loopvar", false)
            _block(&rs, bi, ctors, b)
            _restore(&rs, m)
        ast.ParallelS(l, w, b):
            _exprs(&rs, bi, ctors, w)
            for st in b:
                _stmt(&rs, bi, ctors, st)
        ast.MatchS(l, subj, arms):
            _exprs(&rs, bi, ctors, subj)
            _arms(&rs, bi, ctors, arms)
        ast.SelectS(l, arms):
            _arms(&rs, bi, ctors, arms)
        _: pass

# A payload slot naming a NULLARY VARIANT is a nested pattern, not a binding --
# src/tychoc.c@vars_push says so at the site: match_arm_payload promotes it
# before the uppercase-namespace rule is reached, which is why `Err(Timeout)`
# does not trip that rule.
fn _bind(rs: inout R, ctors: [string: bool], name: string):
    # `_` in a PATTERN is a discard and binds nothing -- tests/reject/
    # match_underscore_use.ty is the fixture, and its header says so. The `_` of
    # a DESTRUCTURING list is the opposite: an ordinary variable that must be
    # declared, which is why only this path drops it.
    if name == "_":
        _note(&rs, "armdiscard")
        return
    if name in ctors:
        _note(&rs, "armpattern:" + name)
        return
    if len(rs.prefix) > 0 and _kindof(&rs, rs.prefix + name) == "variant":
        _note(&rs, "armpattern:" + rs.prefix + name)
        return
    if _kindof(&rs, name) == "variant":
        _note(&rs, "armpattern:" + name)
        return
    # Uppercase in a payload slot: src/tychoc.c promotes it against the arm's
    # EXPECTED enum, so the variant it names may live in another package under a
    # mangled key this pass cannot pick without the type. Deferred to Phase 6 --
    # never a binding, because a binding may not start uppercase at all.
    if len(name) > 0 and name[0] >= 65 and name[0] <= 90:
        _note(&rs, "armpattern.deferred")
        return
    _push(&rs, name, "bind", false)

fn _arms(rs: inout R, bi: [string: bool], ctors: [string: bool], arms: [ast.Arm]):
    for a in arms:
        _exprs(&rs, bi, ctors, a.ch)
        m := _mark(&rs)
        rs.line = a.line
        if a.kind == "variant":
            if len(a.qual) > 0 and _qual_is_pkg(&rs, a.qual, true):
                _note(&rs, "armvariant:" + _pkg_sym(&rs, a.qual, a.name))
            elif not (a.name in ctors):
                if len(rs.prefix) > 0 and _kindof(&rs, rs.prefix + a.name) == "variant":
                    _note(&rs, "armvariant:" + rs.prefix + a.name)
                elif _kindof(&rs, a.name) == "variant":
                    _note(&rs, "armvariant:" + a.name)
                else:
                    _note(&rs, "armvariant.deferred")
            else:
                _note(&rs, "armvariant:" + a.name)
        rs.line = a.line
        for b in a.binds:
            _bind(&rs, ctors, b)
        for b in a.subbinds:
            _bind(&rs, ctors, b)
        _block(&rs, bi, ctors, a.body)
        _restore(&rs, m)

# --- the pass ---------------------------------------------------------------

fn _params(rs: inout R, ps: [ast.Param]):
    seen := []string: bool
    for p in ps:
        rs.line = p.line
        _tys(&rs, p.ty)
        if p.name in seen:
            _err(&rs, "duplicate parameter '" + p.name + "'")
        seen[p.name] = true
        _push(&rs, p.name, "param", false)

fn _sig_sizeparams(ps: [ast.Param], ret: [ast.Ty]) -> [string]:
    out := []string
    for p in ps:
        for a in p.ty:
            out = _sizeparams_ty(a, out)
    for r in ret:
        out = _sizeparams_ty(r, out)
    return out

fn resolve(p: Program) -> R:
    rs := build_table(p)
    # src/tychoc.c:9476 -- a whole-PROGRAM rule, checked once the Sig table is
    # full and BEFORE any body is resolved, which is the order measured on
    # 2026-08-23: a table collision outranks it, a body error does not. It
    # carries the entry FILE and no line, exactly as `no 'main'` has none.
    mk := _kindof(&rs, "main")
    if mk != "fn" and mk != "extern":
        push(rs.errs, p.entry_path + ": error: no 'main' procedure")
    bi := _builtins()
    ctors := _builtin_ctors()
    for f in p.files:
        rs.file = f.path
        rs.prefix = f.prefix
        rs.file_imports = f.unit.imports
        rs.file_in_corelib = under_corelib(p.root, f.dir)
        for fd in f.unit.fns:
            if fd.is_extern:
                continue
            rs.line = fd.line
            m := _mark(&rs)
            rs.in_generic = len(fd.typarams) > 0
            for t in fd.typarams:
                _push(&rs, t, "typaram", false)
            for t in _sig_sizeparams(fd.params, fd.ret):
                _push(&rs, t, "typaram", false)
            _tys(&rs, fd.ret)
            pbase := _mark(&rs)
            _params(&rs, fd.params)
            rs.dup_base = pbase
            _block(&rs, bi, ctors, fd.body)
            if len(fd.ret) > 0 and not _ends_ret(fd.body):
                rs.line = fd.line
                _warn(&rs, "not all paths of '" + fd.name +
                    "' return a value (a fall-off-the-end yields a zero value)")
            _restore(&rs, m)
            rs.in_generic = false
        for sd in f.unit.structs:
            for fld in sd.fields:
                rs.line = fld.line
                _ty(&rs, fld.ty)
        for ed in f.unit.enums:
            for v in ed.variants:
                rs.line = v.line
                _tys(&rs, v.payload)
        for nd in f.unit.newtypes:
            rs.line = nd.line
            _ty(&rs, nd.under)
        for fd in f.unit.fns:
            if fd.is_extern:
                rs.line = fd.line
                _tys(&rs, fd.ret)
                for p in fd.params:
                    _tys(&rs, p.ty)
        for sb in f.unit.subscripts:
            rs.line = sb.line
            m := _mark(&rs)
            _ty(&rs, sb.ret)
            _params(&rs, sb.params)
            _expr(&rs, bi, ctors, sb.place)
            _restore(&rs, m)
    # Go's rule: an import no file of the build named is an error. Muted for a
    # dependency's own files -- src/tychoc.c@report_unused_imports.
    for i := 0; i < len(rs.all_imports); i += 1:
        im := rs.all_imports[i]
        base := pkg_basename(im.path)
        if base in rs.pkg_used:
            continue
        if len(im.alias) > 0 and im.alias in rs.pkg_used:
            continue
        if not rs.entry_in_corelib and under_corelib(p.root, dir_of(rs.all_imp_file[i])):
            continue
        push(rs.late, rs.all_imp_file[i] + ":" + str(im.line) +
             ": error: `" + im.path + "` imported and not used in this file")
    # CC-6, at the end of resolution, exactly where src/tychoc.c calls it.
    check_channels(&rs, p)
    # src/tychoc.c runs report_dead_procs AFTER codegen, so a build that dies
    # never reaches it: a never-called warning is suppressed by a failed build,
    # while a collision warning (raised during resolution) is not.
    if len(rs.errs) == 0 and len(rs.perrs) == 0:
        report_dead(&rs)
    # Parse-phase diagnostics come first, whenever the walk happened to find them.
    for e in rs.errs:
        push(rs.perrs, e)
    rs.errs = rs.perrs
    return rs

fn late_lines(rs: R) -> [string]:
    return rs.late

fn census_lines(rs: R) -> [string]:
    names := keys(rs.counts)
    names = sort.asc(names)
    out := []string
    for n in names:
        push(out, n + " " + str(rs.counts[n]))
    return out

fn symbol_lines(rs: R) -> [string]:
    out := []string
    for s in rs.syms:
        push(out, s.kind + " " + s.name + " " + s.file)
    out = sort.asc(out)
    return out
