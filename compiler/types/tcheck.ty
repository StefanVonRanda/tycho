package types

import "core:sort"
import "../ast"

# The monomorphic type checker -- src/tychoc.c's type-resolve section
# (src/tychoc.c:5797-9472) for the non-generic language, plus the type rules
# parse_type enforces while a declaration is read (src/tychoc.c:2423-2677).
#
# THE ONE INVARIANT THAT MATTERS. A type is a STRING and `?` is UNKNOWN.
# Every rule below fires only when the types it compares are KNOWN; anything
# this pass cannot work out -- a generic instantiation, a UFCS method, a
# newtype's underlying operations, a value crossing a `$T` -- is `?`, and `?` is
# compatible with everything. So this pass can only ever accept MORE than
# src/tychoc.c, never less, which is exactly what compiler/run.sh's leg2c and
# leg6 measure: `wrongly-rejected=0` over 1,078 real files is the expensive
# property, not the new refusals.
#
# Encoding: `int` `float` `bool` `string` `bytes` `ptr` `char` `void` `u8`..`f32`
#   arr(T) fix(N,T) bnd(N,T) map(K,V) tup(A,B) fun(R,P...) soa(S)
#   opt(T) res(T,E) chan(T) task @Name(mangled struct/enum/newtype/handle) ?
# `@` prefixes a declared name so a struct called `arr` cannot collide with the
# array constructor.

fn _head(q: string) -> string:
    for i := 0; i < len(q); i += 1:
        if q[i] == 40:
            return q[0:i]
    return q

fn _targs(q: string) -> [string]:
    out := []string
    depth := 0
    start := 0
    for j := 0; j < len(q); j += 1:
        c := q[j]
        if c == 40:
            depth += 1
            if depth == 1:
                start = j + 1
        elif c == 41:
            depth -= 1
            if depth == 0:
                push(out, q[start:j])
                return out
        elif c == 44 and depth == 1:
            push(out, q[start:j])
            start = j + 1
    return out



fn known(t: string) -> bool:
    return find(t, "?") < 0

fn compat(a: string, b: string) -> bool:
    if a == "?" or b == "?" or a == b:
        return true
    ha := _head(a)
    hb := _head(b)
    if ha != hb:
        return false
    aa := _targs(a)
    bb := _targs(b)
    if len(aa) != len(bb) or len(aa) == 0:
        return false
    for i := 0; i < len(aa); i += 1:
        if not compat(aa[i], bb[i]):
            return false
    return true

fn _is_arr(t: string) -> bool:
    h := _head(t)
    return h == "arr" or h == "fix" or h == "bnd"

# The shapes `x[i]` and `x[a:b]` can never name: a scalar, or a wrapper with no
# element. A named struct is DELIBERATELY absent -- `g[r, c]` on one is a
# declared `subscript` (tools/tycho-grid), not this rule.
fn _unindexable(t: string) -> bool:
    h := _head(t)
    if h == "opt" or h == "res" or h == "chan" or h == "task" or h == "fun" or h == "tup":
        return true
    return t == "bool" or t == "float" or t == "f32" or t == "char" or
        t == "ptr" or t == "void" or _is_int(t)

fn _is_int(t: string) -> bool:
    return t == "int" or t == "u8" or t == "u16" or t == "u32" or t == "u64" or
        t == "i8" or t == "i16" or t == "i32" or t == "i64"

fn _is_num(t: string) -> bool:
    return _is_int(t) or t == "float" or t == "f32"


# ---------------------------------------------------------------- the tables

struct TDecl:
    name: string                       # mangled, without the `@`
    kind: string                       # struct enum newtype handle
    generic: bool
    packed: bool                       # a `packed struct`
    fnames: [string]                   # struct fields / enum variants
    ftypes: [string]                   # field type, or a variant's payload joined by "|"
    file: string
    line: int
    pats: [ast.Ty]                     # the field / payload types AS WRITTEN,
    pcnt: [int]                        # flattened, with a payload count per
    tps: [string]                      # variant -- what an INSTANCE substitutes
    pfx: string                        # into (Phase 6b)

struct FSig:
    name: string                       # mangled
    file: string
    line: int
    pnames: [string]
    ptypes: [string]
    pflags: [string]                   # "inout" "sink" "var" ""
    ret: string
    generic: bool
    builtin: bool
    pty: [ast.Ty]                      # the parameter types AS WRITTEN -- a `$T`
    rty: [ast.Ty]                      # pattern is what a call unifies against,
    tps: [string]                      # and the encoded ptypes above have already
    whs: [string]                      # collapsed every one of them to `?`
    pfx: string                        # the package prefix its type NAMES resolve in
    szs: [string]                      # the `$N` size parameters, kept apart
    body: [ast.Stmt]                   # the TEMPLATE's body, checked per instance

struct VBind:
    name: string
    ty: string
    mutable: bool

# src/tychoc.c@g_pend -- one entry per bare `xs := []` / `x := None` decl, kept
# in DECLARATION order with a per-block mark so the audit at the end of a block
# sees exactly the entries that block opened.
struct Pend:
    name: string
    line: int
    done: bool

# One branch result of a value if/match -- src/tychoc.c@ctrl_collect_tails.
# `_value_type` returns ONE type, so a void tail, an all-diverging if/match and
# a bare `None` tail are the same observation to it; the LIST is what tells them
# apart (src/tychoc.c:8368, :8341, :8343).
struct Tail:
    line: int
    ty: string

struct C:
    cwarns: [string]                   # non-fatal, drained by the driver
    errbase: int                       # errs at the current proc's entry; -1 outside one
    paramset: [string: bool]           # the current proc's parameters, a borrow
    instd: [string: bool]              # (template, bindings) already body-checked
    instdepth: int                     # nesting guard for a recursive template
    srcp: [string]                     # file paths, parallel to srct
    srct: [string]                     # their source, for the diagnostic excerpt
    tds: [TDecl]
    tindex: [string: int]
    sg: [FSig]
    sindex: [string: int]
    vowner: [string: string]           # mangled variant -> "@Enum"
    vpay: [string: string]             # mangled variant -> payload joined by "|"
    consts: [string: string]           # mangled const -> type
    constv: [string: int]              # ... and its folded int value, for a match arm
    typarams: [string: bool]           # the type parameters in scope right now
    tbind: [string: string]            # $T -> the type it is BOUND to at this
                                       # instantiation; empty outside one
    subs: [string: bool]               # declared `subscript` names -- the only callable place
    vars: [VBind]
    nvars: int
    errs: [string]
    perrs: [string]
    counts: [string: int]
    file: string
    line: int
    prefix: string
    ret: string
    void_ok: bool
    skip: bool                         # inside a generic template: resolve nothing
    imports: [ast.ImportD]
    all_imports: [ast.ImportD]
    in_arg: bool
    lam_mark: int                      # the variable-stack mark at the innermost
                                       # closure's entry
    nlambda: int                       # depth inside a closure body: a channel
                                       # read from an enclosing scope here is a
                                       # CAPTURE (src/tychoc.c:6041)
    chan_decl: bool                    # this expression is the DIRECT rhs of a `:=`
    nmatch: int
    ment: [string: int]                # mentions of each name in the function
    sinkp: [string: bool]              # ... and which of its params are `sink`
    parms: [string: bool]              # ... and which names ARE parameters
    loopd: int                         # loop nesting depth
    ntd0: int                          # how many declared types there were before
                                       # the first generic INSTANCE was stamped
    uses6b: bool                       # a 6b construct this pass could NOT ground:
                                       # a generic call or aggregate left `?`, or
                                       # a bounded whose capacity is unknown.
                                       # Phase 6a counted every program that
                                       # DECLARED one, which no amount of work
                                       # could drive down -- 6b made the flag
                                       # mean what leg12's label always claimed

# The offending source line beneath the message, the shape every
# tests/diag/*.err golden pins. Same rule as resolve.ty@_excerpt.
    pfacc: [string]                    # reduction accumulators of the enclosing parallel for
    symrows: [string]                  # --symbols: one `local` row per declaration
    symon: bool                        # ...recorded only when --symbols asked for it
    symfn: int                         # the enclosing fn's line, the row's 4th field
    callee: bool                       # this expression is the CALLEE of a CallVal:
                                       # `a.b.get(v, 0)` is a method call, not a
                                       # field read, so :6346 must not fire on it
    symfnm: string                     # ...and its MANGLED name: two files can put
                                       # two functions on the same line (cli__is_short
                                       # and main are both line 44 in tycho-stat), and
                                       # a line-keyed bucket merges them
    extfn: [string: bool]              # the `extern fn` names -- FSig has no
                                       # is_extern and spawn needs one
    mbind: [string: bool]              # match/if-let arm bindings. They BORROW the
                                       # scrutinee's payload, so they own no arena
                                       # (src/tychoc.c:12353 pushes NULL) and can
                                       # never be adopted by a `sink`
    pend: [Pend]                       # locals declared as a bare `[]`: PENDING,
                                       # grounded by their first typed use
                                       # (src/tychoc.c:5918). Kept beside the
                                       # binding rather than in its type, which
                                       # stays "?" so nothing else changes
    npend: int                         # live length of `pend`; blocks mark/restore it
    pendok: string                     # the one pending name a read may see ungrounded:
                                       # `push`/`map_set`'s receiver, which GROUNDS it
    tail: [Tail]                       # the non-diverging branch tails of the value
                                       # if/match being typed right now
    ntail: int                         # live length of `tail`; each value decl
                                       # marks and restores it, so a nested one nests
    tcol: int                          # >0 while a value decl is collecting tails

fn _cexcerpt(cs: inout C, file: string, line: int) -> string:
    if line <= 0:
        return ""
    for i := 0; i < len(cs.srcp); i += 1:
        if cs.srcp[i] != file:
            continue
        ls := split(cs.srct[i], "\n")
        if line > len(ls):
            return ""
        num := str(line)
        pad := ""
        for k := len(num); k < 6; k += 1:
            pad = pad + " "
        return "\n" + pad + num + " | " + ls[line - 1]
    return ""

# Typo suggestions, same threshold as resolve.ty@_dym and the same source:
# src/tychoc.c:1488@edit_dist accepts the best candidate when
# bestd <= (strlen(name) <= 4 ? 1 : 2).
fn _tedit(a: string, b: string) -> int:
    la := len(a)
    lb := len(b)
    prev := []int
    for j := 0; j <= lb; j += 1:
        push(prev, j)
    for i := 1; i <= la; i += 1:
        cur := []int
        push(cur, i)
        for j := 1; j <= lb; j += 1:
            c := 1
            if a[i - 1] == b[j - 1]:
                c = 0
            v := prev[j - 1] + c
            if prev[j] + 1 < v:
                v = prev[j] + 1
            if cur[j - 1] + 1 < v:
                v = cur[j - 1] + 1
            push(cur, v)
        prev = cur
    return prev[lb]

# An imported enum's variant is named `pkg.Variant` by src/tychoc.c:8291
# (nominal_name); a local one stays bare.
fn _vq(tdname: string, v: string) -> string:
    i := 1
    for i < len(tdname):
        if tdname[i] == 95 and tdname[i - 1] == 95:
            return tdname[0:i - 1] + "." + v
        i += 1
    return v

fn _tdym(name: string, cands: [string]) -> string:
    best := ""
    bestd := 99
    for c in cands:
        if c == name:
            continue
        d := _tedit(name, c)
        if d < bestd:
            bestd = d
            best = c
    lim := 2
    if len(name) <= 4:
        lim = 1
    if bestd <= lim and len(best) > 0:
        return "; did you mean '" + best + "'?"
    return ""

# a type carrying a `$N` size parameter or a `$T` type parameter
fn _has_tp(t: string) -> bool:
    for i := 0; i < len(t); i += 1:
        if t[i] == 36:
            return true
    return false

fn _tycands(cs: inout C) -> [string]:
    out := []string
    for td in cs.tds:
        push(out, _short(td.name))
    push(out, "int")
    push(out, "float")
    push(out, "bool")
    push(out, "string")
    return out

fn _cwarn(cs: inout C, msg: string):
    push(cs.cwarns, cs.file + ":" + str(cs.line) + ": warning: " + msg +
        _cexcerpt(&cs, cs.file, cs.line))

# A newtype is erased in lowering, so "is int, expected Cents" reads as a
# compiler quirk until you see that Cents IS an int, declared here
# (src/tychoc.c:7226). Emitted AFTER its error, which is the order ./tychoc
# flushes them in.
fn _cnote(cs: inout C, file: string, line: int, msg: string):
    push(cs.errs, file + ":" + str(line) + ": note: " + msg + _cexcerpt(&cs, file, line))

fn _nt_note(cs: inout C, a: string, b: string):
    for t in [b, a]:
        if len(t) > 1 and t[0] == 64 and (t[1:] in cs.tindex):
            d := cs.tds[cs.tindex[t[1:]]]
            if d.kind == "newtype" and d.line > 0 and len(d.ftypes) > 0:
                _cnote(&cs, d.file, d.line, "`" + _show(&cs, t) + "` is a distinct type over " +
                    _show(&cs, d.ftypes[0]) + ", declared here -- it does not accept its underlying type implicitly")
                return

# ONE error per STATEMENT. src/tychoc.c's die_at longjmps to a recovery point
# and the walk resumes at the next statement; collecting every error within one
# reports consequences of the first (`return "x" + 1` is both a bad
# concatenation and a bad return type).
fn _cerr(cs: inout C, msg: string):
    if cs.errbase >= 0 and len(cs.errs) > cs.errbase:
        return
    push(cs.errs, cs.file + ":" + str(cs.line) + ": error: " + msg +
        _cexcerpt(&cs, cs.file, cs.line))

# The type rules parse_type enforces run while the DECLARATION is read, so they
# precede every body diagnostic in the whole build -- the same split
# resolve.ty@_perr makes for the import leak, and for the same reason.
fn _cperr(cs: inout C, msg: string):
    push(cs.perrs, cs.file + ":" + str(cs.line) + ": error: " + msg +
        _cexcerpt(&cs, cs.file, cs.line))

fn _tnote(cs: inout C, key: string):
    cs.counts[key] = cs.counts.get(key, 0) + 1

fn _prefix_of(cs: inout C, q: string) -> string:
    for im in cs.all_imports:
        if len(im.alias) > 0 and im.alias == q:
            return pkg_basename(im.path) + "__"
    return q + "__"

# The declared type named `n` (already mangled), as an encoded type.
fn _named(cs: inout C, m: string) -> string:
    if m in cs.tindex:
        if cs.tds[cs.tindex[m]].generic:
            return "?"
        return "@" + m
    return ""

fn _lookup_type(cs: inout C, q: string, n: string) -> string:
    if len(q) > 0:
        return _named(&cs, _prefix_of(&cs, q) + n)
    if len(cs.prefix) > 0:
        r := _named(&cs, cs.prefix + n)
        if len(r) > 0:
            return r
    return _named(&cs, n)

# --- ast.Ty -> encoded type -------------------------------------------------
#
# Where src/tychoc.c dies, this dies too -- these are the parse_type rules, and
# they are TYPE-class in compiler/reject_class.tsv. Everything it cannot resolve
# (a type parameter, a generic instance) becomes `?`.
fn _enc(cs: inout C, t: ast.Ty) -> string:
    match t:
        ast.TPrim(p): return p
        ast.TParam(n):
            if n in cs.tbind:
                return cs.tbind[n]
            return "?"
        ast.TName(q, n, targs):
            if len(q) == 0 and n == "void":
                if not cs.void_ok:
                    _cperr(&cs, "'void' is a type only as a Result's ok payload, as in Result(void, string)")
                return "void"
            if len(q) == 0 and n == "Option":
                inner := _enc_noval(&cs, targs[0])
                if inner == "void":
                    _cperr(&cs, "Option(void) is not a type")
                _nest_aff(&cs, inner, "cont")
                return "opt(" + inner + ")"
            if len(q) == 0 and n == "Channel":
                inner := _enc_noval(&cs, targs[0])
                if inner == "void":
                    _cperr(&cs, "Channel(void) is not a type")
                _nest_aff(&cs, inner, "cont")
                return "chan(" + inner + ")"
            if len(q) == 0 and n == "Result":
                keep := cs.void_ok
                cs.void_ok = true
                ok := _enc(&cs, targs[0])
                cs.void_ok = keep
                er := _enc_noval(&cs, targs[1])
                _nest_aff(&cs, ok, "cont")
                _nest_aff(&cs, er, "cont")
                return "res(" + ok + "," + er + ")"
            if len(q) == 0 and (n in cs.tbind):
                return cs.tbind[n]
            if len(q) == 0 and (n in cs.typarams):
                return "?"
            r := _lookup_type(&cs, q, n)
            if len(targs) > 0:
                enc := []string
                for a in targs:
                    ea := _enc_noval(&cs, a)
                    _tnote(&cs, "targ:" + ea)
                    push(enc, ea)
                if len(r) == 0 and not cs.skip and not _known_generic(&cs, q, n):
                    _cperr(&cs, "unknown type '" + n + "'" + _tdym(n, _tycands(&cs)))
                return _inst_named(&cs, q, n, targs, enc)
            if len(r) == 0:
                if cs.skip:
                    return "?"
                _cperr(&cs, "unknown type '" + n + "'" + _tdym(n, _tycands(&cs)))
                return "?"
            return r
        ast.TArr(k):
            el := _enc_noval(&cs, k[0])
            if el == "void":
                _cperr(&cs, "an array element type cannot be void")
            _nest_aff(&cs, el, "cont")
            return "arr(" + el + ")"
        ast.TFix(sz, k):
            el := _enc_noval(&cs, k[0])
            if len(sz) > 0 and sz[0] == 36:
                return "?"             # `[$N]T` is a TEMPLATE pattern, not a type
            n := _fixsize(&cs, sz)
            if el == "bool" or el == "void":
                _cperr(&cs, "a fixed-size array element cannot be bool or void -- a dynamic [bool] is legal")
            _nest_aff(&cs, el, "cont")
            return "fix(" + n + "," + el + ")"
        ast.TBnd(sz, k):
            el := _enc_noval(&cs, k[0])
            n := _bnd_size(&cs, sz)
            if n == "?":
                cs.uses6b = true
            _bnd_elem(&cs, el)
            _nest_aff(&cs, el, "cont")
            return "bnd(" + n + "," + el + ")"
        ast.TMap(k):
            kt := _enc_noval(&cs, k[0])
            vt := _enc_noval(&cs, k[1])
            if not _mapkey_ok(&cs, kt):
                _cperr(&cs, "map keys must be string, int (directly or through a newtype), a fieldless enum, or a hashable struct/tuple/array")
            _nest_aff(&cs, vt, "cont")
            return "map(" + kt + "," + vt + ")"
        ast.TTup(k):
            out := "tup("
            for i := 0; i < len(k); i += 1:
                e := _enc_noval(&cs, k[i])
                if e == "void":
                    _cperr(&cs, "a tuple element cannot be void")
                _nest_aff(&cs, e, "cont")
                if i > 0:
                    out = out + ","
                out = out + e
            return out + ")"
        ast.TFn(hr, k):
            r := "void"
            np := len(k)
            if hr:
                np = len(k) - 1
                r = _enc_noval(&cs, k[len(k) - 1])
                _nest_aff(&cs, r, "fnret")
            out := "fun(" + r
            for i := 0; i < np; i += 1:
                e := _enc_noval(&cs, k[i])
                if e == "void":
                    _cperr(&cs, "a function-type parameter cannot be void")
                _nest_aff(&cs, e, "fn")
                out = out + "," + e
            return out + ")"
        ast.TSoa(k):
            el := _enc_noval(&cs, k[0])
            if not _soa_elem_ok(&cs, el):                   # src/tychoc.c:2412
                _cperr(&cs, "soa requires a struct element type, e.g. soa [Point]")
            return "soa(" + el + ")"
    return "?"

# Every nested position but Result's ok payload forbids `void`.
fn _enc_noval(cs: inout C, t: ast.Ty) -> string:
    keep := cs.void_ok
    cs.void_ok = false
    r := _enc(&cs, t)
    cs.void_ok = keep
    return r

# `[N]T` / `bounded[N]T`: a literal, or an int `const`. src/tychoc.c:2532.
# A fixed size is compared as TEXT, so `[0xA]int` and `[10]int` must normalise
# to the same thing or a legal program is refused (tests/int_hex.ty:17).
fn _dec(sz: string) -> string:
    base := 10
    i := 0
    if len(sz) > 2 and sz[0] == 48 and (sz[1] == 120 or sz[1] == 88):
        base = 16
        i = 2
    elif len(sz) > 2 and sz[0] == 48 and (sz[1] == 98 or sz[1] == 66):
        base = 2
        i = 2
    v := 0
    for i < len(sz):
        c := sz[i]
        d := -1
        if c >= 48 and c <= 57:
            d = c - 48
        elif c >= 97 and c <= 102:
            d = c - 87
        elif c >= 65 and c <= 70:
            d = c - 55
        elif c == 95:
            i += 1
            continue
        if d < 0 or d >= base:
            return "?"
        v = v * base + d
        i += 1
    return str(v)

# A canonical decimal capacity as an int, or -1 when it is not one ("?", "$N").
fn _capn(s: string) -> int:
    if len(s) == 0:
        return -1
    v := 0
    for i := 0; i < len(s); i += 1:
        if s[i] < 48 or s[i] > 57:
            return -1
        v = v * 10 + (s[i] - 48)
    return v

fn _fixsize(cs: inout C, sz: string) -> string:
    if len(sz) == 0:
        return "?"
    if sz[0] == 36:
        return "?"
    if sz[0] >= 48 and sz[0] <= 57:
        return _dec(sz)
    if cs.skip:
        return "?"
    if len(cs.prefix) > 0 and (cs.prefix + sz) in cs.consts:
        return "?"
    if sz in cs.consts:
        return "?"
    _cperr(&cs, "a fixed-size array length must be an integer literal or an int `const` -- '" + sz + "' is not")
    return "?"

fn _mapkey_ok(cs: inout C, k: string) -> bool:
    if k == "?":
        return true
    if k == "string" or _is_int(k):
        return true
    h := _head(k)
    if h == "tup" or h == "arr" or h == "fix":
        for a in _targs(k):
            if not _mapkey_ok(&cs, a):
                return false
        return true
    if len(k) > 1 and k[0] == 64:
        m := k[1:]
        if m in cs.tindex:
            d := cs.tds[cs.tindex[m]]
            if d.kind == "newtype":
                return _mapkey_ok(&cs, d.ftypes[0])
            if d.kind == "enum":
                for p in d.ftypes:
                    if len(p) > 0:
                        return false
                return true
            if d.kind == "struct":
                for ft in d.ftypes:
                    if not _mapkey_ok(&cs, ft):
                        return false
                return true
        return false
    return false

# ---------------------------------------------------------------- the context
#
# Two passes over the declarations, for the reason src/tychoc.c pre-scans: a
# struct field may name a type declared LATER in the same file (`[B]` above
# `struct B`), which ./tychoc accepts -- measured 2026-08-23. So every NAME is
# registered first and only then is any type encoded.

struct DRef:
    line: int
    cat: int                           # 1 struct 2 enum 3 newtype 4 handle 5 const 6 subscript 7 fn
    idx: int

fn _sorted_decls(u: ast.Unit) -> [DRef]:
    ds := []DRef
    for k := 0; k < len(u.structs); k += 1:
        push(ds, DRef(u.structs[k].line, 1, k))
    for k := 0; k < len(u.enums); k += 1:
        push(ds, DRef(u.enums[k].line, 2, k))
    for k := 0; k < len(u.newtypes); k += 1:
        push(ds, DRef(u.newtypes[k].line, 3, k))
    for k := 0; k < len(u.handles); k += 1:
        push(ds, DRef(u.handles[k].line, 4, k))
    for k := 0; k < len(u.consts); k += 1:
        push(ds, DRef(u.consts[k].line, 5, k))
    for k := 0; k < len(u.subscripts); k += 1:
        push(ds, DRef(u.subscripts[k].line, 6, k))
    for k := 0; k < len(u.fns); k += 1:
        push(ds, DRef(u.fns[k].line, 7, k))
    for a := 0; a < len(ds); a += 1:
        b := a
        for c := a + 1; c < len(ds); c += 1:
            if ds[c].line < ds[b].line:
                b = c
        tmp := ds[a]
        ds[a] = ds[b]
        ds[b] = tmp
    return ds

fn _addt(cs: inout C, name: string, kind: string, generic: bool, file: string, line: int):
    # `pats`/`tps`/`pfx` are filled by _fill_decls; an INSTANCE is stamped by
    # zsema.ty@_inst_agg and carries none of them.
    if name in cs.tindex:
        return
    cs.tindex[name] = len(cs.tds)
    push(cs.tds, TDecl(name, kind, generic, false, []string, []string, file, line, []ast.Ty, []int, []string, ""))

fn _typarams_of(cs: inout C, names: [string]):
    cs.typarams = []string: bool
    for n in names:
        cs.typarams[n] = true

# src/tychoc.c@die_not_variant: a variant of ANOTHER package's enum written
# bare. Returns "" when the spelling is fine, else the whole message.
fn _foreign_variant(cs: inout C, tdname: string, qual: string, v: string) -> string:
    if len(qual) > 0:
        return ""
    # Only a PACKAGE prefix counts. A generic instance is `Cell$@lib__Cause`,
    # whose `__` is inside the type ARGUMENT and names no package of the enum.
    head := tdname
    for i := 0; i < len(tdname); i += 1:
        if tdname[i] == 36 or tdname[i] == 64:
            head = tdname[0:i]
            break
    us := -1
    for i := 0; i + 1 < len(head); i += 1:
        if head[i] == 95 and head[i + 1] == 95:
            us = i
            break
    if us < 0:
        return ""
    pkg := head[0:us]
    if cs.prefix == pkg + "__":
        return ""                      # the enum's own package writes it bare
    return "'" + v + "' is a variant of " + _show(&cs, "@" + tdname) +
        ", but a variant of another package's enum must be written qualified -- write '" +
        pkg + "." + v + "'"

fn _register(cs: inout C, p: Program):
    for f in p.files:
        for sd in f.unit.structs:
            _addt(&cs, f.prefix + sd.name, "struct", len(sd.typarams) > 0, f.path, sd.line)
            si2 := cs.tindex[f.prefix + sd.name]
            cs.tds[si2].packed = sd.packed
            for fl in sd.fields:
                push(cs.tds[si2].fnames, fl.name)
            cs.tds[si2].tps = sd.typarams
            cs.tds[si2].pfx = f.prefix
            for fl in sd.fields:
                push(cs.tds[si2].pats, fl.ty)
                push(cs.tds[si2].pcnt, 1)
        for ed in f.unit.enums:
            _addt(&cs, f.prefix + ed.name, "enum", len(ed.typarams) > 0, f.path, ed.line)
            ei2 := cs.tindex[f.prefix + ed.name]
            cs.tds[ei2].tps = ed.typarams
            cs.tds[ei2].pfx = f.prefix
            for v2 in ed.variants:
                push(cs.tds[ei2].pcnt, len(v2.payload))
                for py2 in v2.payload:
                    push(cs.tds[ei2].pats, py2)
            for v in ed.variants:
                cs.vowner[f.prefix + v.name] = "@" + f.prefix + ed.name
        for nd in f.unit.newtypes:
            _addt(&cs, f.prefix + nd.name, "newtype", false, f.path, nd.line)
        for hd in f.unit.handles:
            _addt(&cs, f.prefix + hd.name, "handle", false, f.path, hd.line)

# The signature of one fn, as src/tychoc.c's Sig. A generic fn's signature is
# recorded but never CHECKED against a call: monomorphisation is Phase 6b, so
# every call to one yields `?`.
fn _sig_of(cs: inout C, prefix: string, fd: ast.Fn) -> FSig:
    _typarams_of(&cs, fd.typarams)
    for pm in fd.params:
        for tt in pm.ty:
            for sp in _sizeparams_ty(tt, []string):
                cs.typarams[sp] = true
    pn := []string
    pt := []string
    pf := []string
    for pm in fd.params:
        cs.line = pm.line
        t := "?"
        if len(pm.ty) == 1:
            t = _enc(&cs, pm.ty[0])
        push(pn, pm.name)
        push(pt, t)
        fl := ""
        if pm.is_inout:
            fl = "inout"
            if _head(t) == "fun":
                _cerr(&cs, "inout parameter '" + pm.name + "': a function value can't be inout (a callee could write a closure back into the caller and it would dangle)")
        elif pm.is_sink:
            fl = "sink"
        if pm.is_variadic:
            fl = "var"
        _aff_param_check(&cs, pm.name, t, fl)
        if fd.is_extern and pm.is_inout and not _ffi_inout_ok(t):
            _cperr(&cs, "extern fn '" + fd.name + "': an `inout` (out) parameter '" + pm.name + "' must be int/char/float/bool/ptr — string/bytes/handle/composite have no trivial out-param ABI")
        if fd.is_extern and not pm.is_inout and not _ffi_param_ok(&cs, t):
            _cperr(&cs, "extern fn '" + fd.name + "': parameter '" + pm.name + "' must be int/char/float/bool/string/ptr/bytes, [int]/[float]/[string], or a handle (no other composites across the C boundary)")
        push(pf, fl)
    cs.line = fd.line
    rt := "void"
    if len(fd.ret) == 1:
        keep := cs.void_ok
        cs.void_ok = false
        rt = _enc(&cs, fd.ret[0])
        cs.void_ok = keep
    if fd.is_extern and not _ffi_ret_ok(&cs, rt):
        _cperr(&cs, "extern fn '" + fd.name + "': return type must be int/char/float/bool/string/ptr/bytes, [int]/[float], Option(string), a handle, or omitted")
    if _head(rt) == "chan":
        _cperr(&cs, "a function cannot return a channel -- create it in the owning scope and pass it down")
    # An `extern fn` opener is the only producer: its return is where a handle
    # enters the program. A Tycho fn returning one hands out a second owner of
    # a pointer its own scope exit already freed.
    if not fd.is_extern and _aff_kind(&cs, rt) == "handle":
        _cperr(&cs, "a Tycho fn cannot return a handle -- only an `extern fn` opener may; a handle is freed at the end of its scope and cannot escape it")
    nm := prefix + fd.name
    if fd.is_extern:
        nm = fd.name
        cs.extfn[nm] = true            # src/tychoc.c:6009 reads it back at spawn
    cs.typarams = []string: bool
    szs := _sig_sizeparams(fd.params, fd.ret)
    tps := []string                    # the parser lists a `$T` once per mention
    for tn in fd.typarams:             # (`fn singleton(x: $V) -> [$V]` twice);
        if not _has_name6(tps, tn):    # an explicit type-arg COUNT needs the
            push(tps, tn)              # DISTINCT parameters
    pats := []ast.Ty
    for pm in fd.params:
        if len(pm.ty) == 1:
            push(pats, pm.ty[0])
        else:
            push(pats, ast.TPrim("?"))
    gen := len(tps) > 0 or len(szs) > 0
    # Only a TEMPLATE's body is ever read (_inst_body, reached solely from
    # _generic_call2 behind an `sg[si].generic` guard), so a non-generic sig
    # carried a whole function body through two deep copies for nothing.
    bd := []ast.Stmt
    if gen:
        bd = fd.body
    return FSig(nm, cs.file, fd.line, pn, pt, pf, rt,
                gen, false,
                pats, fd.ret, tps, fd.wheres, prefix, szs, bd)

fn _addsig(cs: inout C, s: FSig):
    if s.name in cs.sindex:
        return
    cs.sindex[s.name] = len(cs.sg)
    push(cs.sg, s)

fn _bsig(cs: inout C, name: string, ret: string, ps: [string]):
    pn := []string
    pf := []string
    for i := 0; i < len(ps); i += 1:
        push(pn, "x")
        push(pf, "")
    _addsig(&cs, FSig(name, "", 0, pn, ps, pf, ret, false, true, []ast.Ty, []ast.Ty, []string, []string, "", []string, []ast.Stmt))

# src/tychoc.c@register_builtins, verbatim: the fixed-signature table, and ONLY
# that table. The shape-directed builtins (len/push/keys/str/to_*/...) bypass it
# and are checked one by one in _call_builtin.
fn _builtin_sigs_t(cs: inout C):
    _bsig(&cs, "print", "void", ["string"])
    _bsig(&cs, "println", "void", ["string"])
    _bsig(&cs, "eprint", "void", ["string"])
    _bsig(&cs, "input", "string", []string)
    _bsig(&cs, "read_all", "string", []string)
    _bsig(&cs, "clock", "int", []string)
    _bsig(&cs, "now", "int", []string)
    _bsig(&cs, "ncpu", "int", []string)
    _bsig(&cs, "chr", "string", ["int"])
    _bsig(&cs, "to_char", "char", ["int"])
    _bsig(&cs, "die", "void", ["string"])
    _bsig(&cs, "exit", "void", ["int"])
    _bsig(&cs, "substr", "string", ["string", "int", "int"])
    _bsig(&cs, "find", "int", ["string", "string"])
    _bsig(&cs, "char_at", "char", ["string", "int"])
    _bsig(&cs, "split", "arr(string)", ["string", "string"])
    _bsig(&cs, "read_file", "string", ["string"])
    _bsig(&cs, "write_file", "bool", ["string", "string"])
    _bsig(&cs, "list_dir", "arr(string)", ["string"])
    _bsig(&cs, "args", "arr(string)", []string)
    _bsig(&cs, "getenv", "string", ["string"])
    _bsig(&cs, "is_null", "bool", ["ptr"])
    _bsig(&cs, "to_ptr", "ptr", ["int"])
    _bsig(&cs, "sqrt", "float", ["float"])
    _bsig(&cs, "pow", "float", ["float", "float"])
    _bsig(&cs, "floor", "float", ["float"])
    _bsig(&cs, "fabs", "float", ["float"])

# ---------------------------------------------------------------- scopes

fn _vmark(cs: inout C) -> int:
    return cs.nvars

fn _vrestore(cs: inout C, m: int):
    cs.nvars = m

fn _vpush(cs: inout C, name: string, ty: string, mutable: bool):
    b := VBind(name, ty, mutable)
    if cs.nvars < len(cs.vars):
        cs.vars[cs.nvars] = b
    else:
        push(cs.vars, b)
    cs.nvars += 1

fn _vfind(cs: inout C, name: string) -> int:
    for i := cs.nvars - 1; i >= 0; i -= 1:
        if cs.vars[i].name == name:
            return i
    return -1

fn _vtype(cs: inout C, name: string) -> string:
    i := _vfind(&cs, name)
    if i < 0:
        return ""
    return cs.vars[i].ty

fn _is_pkg(cs: inout C, q: string) -> bool:
    if _vfind(&cs, q) >= 0:
        return false
    for im in cs.all_imports:
        if (len(im.alias) > 0 and im.alias == q) or pkg_basename(im.path) == q:
            return true
    return false

fn _sigidx(cs: inout C, m: string) -> int:
    if m in cs.sindex:
        return cs.sindex[m]
    return -1

fn _sigtype(s: FSig) -> string:
    out := "fun(" + s.ret
    for t in s.ptypes:
        out = out + "," + t
    return out + ")"

# The struct a value of encoded type `t` is, or "" -- seeing through a newtype,
# which src/tychoc.c@base_of does for every field and index operation.
fn _base(cs: inout C, t: string) -> string:
    if len(t) > 1 and t[0] == 64:
        m := t[1:]
        if m in cs.tindex and cs.tds[cs.tindex[m]].kind == "newtype":
            return _base(&cs, cs.tds[cs.tindex[m]].ftypes[0])
    return t

# src/tychoc.c@packed_field_ok. A packed struct states a byte-exact layout, so
# every field must be a fixed-width value -- a heap field would sit at a
# misaligned offset. `?` (an unbound `$T`) is not fixed-width and is refused
# by the same rule, which is what keeps the attribute off a generic instance.
fn _packed_ok(cs: inout C, t: string) -> bool:
    if len(t) > 1 and t[0] == 64:
        m := t[1:]
        if m in cs.tindex:
            d := cs.tds[cs.tindex[m]]
            if d.kind == "newtype":
                return _packed_ok(&cs, d.ftypes[0])
            return d.kind == "struct" and d.packed
        return false
    return t == "int" or t == "bool" or t == "float" or t == "char" or
        t == "u8" or t == "u16" or t == "u32" or t == "u64" or
        t == "i8" or t == "i16" or t == "i32" or t == "i64" or t == "f32"

fn _tdecl(cs: inout C, t: string) -> int:
    if len(t) > 1 and t[0] == 64:
        m := t[1:]
        if m in cs.tindex:
            return cs.tindex[m]
    return -1

# src/tychoc.c:2412 and :2967, IS_STRUCT(el). An SOA splits its element into one
# array per FIELD, so an enum, a newtype, a handle or a scalar has nothing to
# split. `?` is an unground generic and says nothing either way.
fn _soa_elem_ok(cs: inout C, el: string) -> bool:
    if not known(el):
        return true
    i := _tdecl(&cs, el)
    return i >= 0 and cs.tds[i].kind == "struct"

fn _field_ty(cs: inout C, t: string, f: string) -> string:
    i := _tdecl(&cs, _base(&cs, t))
    if i < 0:
        return "?"
    # read in place: a TDecl copy is a whole declaration, and this wants one field
    if cs.tds[i].kind != "struct":
        return "?"
    for k := 0; k < len(cs.tds[i].fnames); k += 1:
        if cs.tds[i].fnames[k] == f:
            return cs.tds[i].ftypes[k]
    return "?"

fn _elem_of(cs: inout C, t: string) -> string:
    b := _base(&cs, t)
    h := _head(b)
    if h == "arr" or h == "soa":
        return _targs(b)[0]
    if h == "fix" or h == "bnd":
        return _targs(b)[1]
    return "?"

# ---------------------------------------------------------------- expressions

fn _exs(cs: inout C, es: [ast.Expr]):
    for e in es:
        _ex(&cs, e)

# "" is NO EXPECTED TYPE, "?" is AN EXPECTED TYPE THIS PASS COULD NOT COMPUTE.
# src/tychoc.c separates the two by which entry point runs -- resolve_expr
# (synthesis) vs resolve_exp (checking) -- and src/tychoc.c:6225 is the one rule
# that can only be worded with the distinction: a bare `[]` is an error when
# NOTHING can type it, and silent when this pass merely does not know yet.
# Every _ex2 site that meant the second already passes "?" and is unaffected.
fn _ex(cs: inout C, e: ast.Expr) -> string:
    return _ex2(&cs, e, "")

# src/tychoc.c@sized_lit -- an int LITERAL adapting to a fixed-width
# destination. Only the eight exact spellings: a newtype over one is not
# `_is_int`, and widening the test would refuse a negative at a signed newtype.
fn _sized_fits(cs: inout C, e: ast.Expr, want: string):
    lo := 0
    hi := 9223372036854775807
    if want == "u8":
        hi = 255
    elif want == "u16":
        hi = 65535
    elif want == "u32":
        hi = 4294967295
    elif want == "i8":
        lo = -128
        hi = 127
    elif want == "i16":
        lo = -32768
        hi = 32767
    elif want == "i32":
        lo = -2147483648
        hi = 2147483647
    elif want == "i64":
        lo = -9223372036854775807 - 1
    match e:
        ast.IntLit(l, v):
            if v < lo or v > hi:
                cs.line = l
                _cerr(&cs, str(v) + " does not fit " + want + " (its range is " + str(lo) +
                    ".." + str(hi) + ") -- write to_" + want + "(x) to convert with wraparound")
        _: pass

# src/tychoc.c:6085's four rejected inner types, in this pass's spelling:
# T_VOID, T_NONE (a `None` no context typed), and the two half-built Results a
# nested Ok()/Err() yields -- E_OK and E_ERR always resolve to a PARTIAL there,
# so a "?" on either side is the same test.
fn _no_concrete(t: string) -> bool:
    if t == "void" or t == "opt(?)":
        return true
    if _head(t) != "res":
        return false
    ts := _targs(t)
    return len(ts) == 2 and (ts[0] == "?" or ts[1] == "?")

# --------------------------------------------- pending decls (src/tychoc.c B-3)
# The three rules a `pendarr` SET could not carry: a pending decl has a LINE (the
# :8909 audit reports at the declaration, not at the block end), a DONE flag (the
# audit is per block, so an entry cannot just be deleted when it grounds), and an
# ORDER (`pend_find` takes the newest, so an inner shadow grounds before an outer).

fn _pend_find(cs: inout C, name: string) -> int:
    for i := cs.npend - 1; i >= 0; i -= 1:
        if not cs.pend[i].done and cs.pend[i].name == name:
            return i
    return -1

fn _pend_add(cs: inout C, name: string, line: int):
    e := Pend(name, line, false)
    if cs.npend < len(cs.pend):
        cs.pend[cs.npend] = e
    else:
        push(cs.pend, e)
    cs.npend += 1

# src/tychoc.c@pend_ground. `_no_concrete` is this pass's `uninferrable` minus
# T_PENDING, which has no type head here -- a pending local reads back "?", and
# "?" also means "this pass could not compute one", so it grounds SILENTLY
# (done, type left "?") rather than refusing a program the bootstrap accepts.
fn _pend_ground(cs: inout C, name: string, t: string, line: int):
    pi := _pend_find(&cs, name)
    if pi < 0:
        return
    keep := cs.line
    cs.line = line
    # The COMPOSITION, not only the head: `push(xs, nop())` composes arr(void).
    bad := _no_concrete(t)
    if _is_arr(t) and _no_concrete(_elem_of(&cs, t)):
        bad = true
    if _head(t) == "map":
        ka := _targs(t)
        if len(ka) == 2 and (_no_concrete(ka[0]) or _no_concrete(ka[1])):
            bad = true
    if bad:
        _cerr(&cs, "cannot infer the type of '" + name + "' from this use")   # src/tychoc.c:5911
        cs.pend[pi].done = true
        cs.line = keep
        return
    cs.pend[pi].done = true
    if not known(t):
        cs.line = keep
        return
    if not (_is_arr(t) or _head(t) == "map" or _head(t) == "soa"):
        _cerr(&cs, "'" + name + "' was declared with [] but its first use makes it " + _show(&cs, t))
        cs.line = keep
        return
    vi := _vfind(&cs, name)
    if vi >= 0:
        cs.vars[vi].ty = t
    cs.line = keep

fn _bare_empty_arr(e: ast.Expr) -> bool:
    match e:
        ast.EmptyArr(l, t): return len(t) == 0
        _: return false

# `want` is the EXPECTED type, which src/tychoc.c@resolve_exp threads for the
# same three reasons: `None` and `Ok()`/`Err()` have no type of their own, an
# empty `[]` takes the annotation's, and an untyped lambda parameter takes the
# expected fn type's.
fn _ex2(cs: inout C, e: ast.Expr, want0: string) -> string:
    nowant := len(want0) == 0
    want := want0
    if nowant:
        want = "?"
    chan_ok := cs.chan_decl
    cs.chan_decl = false
    callee_ok := cs.callee
    cs.callee = false
    cs.line = ast.line_of(e)
    # src/tychoc.c@resolve_exp's literal adaptation, and the reason it has to be
    # here rather than only in _binop: a LITERAL takes the expected type's width
    # (`x: u32 = 1`, `scale(v, 2)` at a float parameter), a variable never does.
    if want != "?":
        if (e is ast.IntLit) and (_is_int(want) or want == "float" or want == "f32"):
            if _is_int(want) and want != "int":
                _sized_fits(&cs, e, want)
            return want
        if (e is ast.FloatLit) and want == "f32":
            return want
    # src/tychoc.c:7587 -- checking mode grounds a pending decl from the
    # destination type, and must run BEFORE the ast.Name arm below refuses the
    # read: `f(xs)` at a typed parameter is a grounding use, not an ungrounded one.
    if known(want) and want != "void":
        match e:
            ast.Name(lp, np):
                if _pend_find(&cs, np) >= 0:
                    _pend_ground(&cs, np, want, lp)
            _: pass
    match e:
        ast.IntLit(l, v): return "int"
        ast.FloatLit(l, v): return "float"
        ast.StrLit(l, v): return "string"
        ast.FStrLit(l, v, hs):
            # src/tychoc.c@desugar_interp wraps every hole in `str(...)`, so a
            # hole is checked exactly as that call's argument is (the `str`
            # arm below), and the whole literal is a string either way.
            for hi := 0; hi < len(hs); hi += 1:
                ht := _ex2(&cs, hs[hi], "?")
                cs.line = ast.line_of(hs[hi])
                if not _str_ok(&cs, ht):
                    _cerr(&cs, "str(x) can't stringify a " + _show(&cs, ht))
            cs.line = l
            return "string"
        ast.CharLit(l, v): return "char"
        ast.BoolLit(l, v): return "bool"
        ast.NullLit(l): return "ptr"
        ast.Name(l, n):
            t := _vtype(&cs, n)
            if len(t) > 0 and n != cs.pendok and _pend_find(&cs, n) >= 0:
                cs.line = l
                _cerr(&cs, "'" + n + "' is used before its type can be inferred -- assign/push/pass it first, or annotate the declaration")   # src/tychoc.c:6140
                return "?"
            if len(t) > 0:
                if cs.nlambda > 0 and _vfind(&cs, n) < cs.lam_mark and _head(t) == "chan":
                    cs.line = l
                    _cerr(&cs, "a closure cannot capture a channel handle -- take it as a parameter instead")
                return t
            if len(cs.prefix) > 0 and (cs.prefix + n) in cs.consts:
                return cs.consts[cs.prefix + n]
            if n in cs.consts:
                return cs.consts[n]
            if len(cs.prefix) > 0 and (cs.prefix + n) in cs.vowner:
                return _bare_variant(&cs, l, n, cs.prefix + n, cs.vowner[cs.prefix + n])
            if n in cs.vowner:
                return _bare_variant(&cs, l, n, n, cs.vowner[n])
            si := _sigidx(&cs, n)
            if si < 0 and len(cs.prefix) > 0:
                si = _sigidx(&cs, cs.prefix + n)
            if si >= 0 and cs.sg[si].generic:
                cs.line = l
                _cerr(&cs, "'" + n + "' is generic, so it has no single function value -- there is no instantiation to take. Wrap it in a lambda that fixes the types, e.g. fn(a: int, b: int) -> int: " + n + "(a, b)")
                return "?"
            if si >= 0:
                # src/tychoc.c:6172-6175 -- the shape rules for a fn VALUE. A
                # builtin has no Tycho signature to take, so it is left alone.
                if not cs.sg[si].builtin:
                    if len(cs.sg[si].ptypes) > 8:
                        cs.line = l
