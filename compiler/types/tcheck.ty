                            _cerr(&cs, "a closure cannot capture a channel handle -- take it as a parameter instead")
                        else:
                            _cerr(&cs, "a closure cannot capture a handle -- it is freed at the end of its scope")
                        break
            # src/tychoc.c:6042. The lifted proc takes [captures][params], and
            # src/tychoc.c@collect_idents dedups by NAME, so count distinct names.
            capn := []string: bool
            for ci := 0; ci < m; ci += 1:
                for be in body:
                    if _pf_reads(be, cs.vars[ci].name):
                        capn[cs.vars[ci].name] = true
                        break
            if len(capn) > 16:
                cs.line = l
                _cerr(&cs, "a lambda captures at most 16 variables")
            cs.nlambda = keepc
            cs.lam_mark = keepm
            cs.ret = keepr
            _vrestore(&cs, m)
            return out + ")"
    return "?"

# ---------------------------------------------------------------- operators
#
# src/tychoc.c:7304-7565, arm for arm. The LITERAL ADAPTATION rules matter as
# much as the refusals: an int literal takes a sized/f32/float operand's type,
# and a variable never widens -- so `f < 0` is legal and `f < n` is not, and a
# checker that widened both would accept a program src/tychoc.c refuses (which
# is safe) while one that widened neither would REFUSE `f < 0` (which is not).

fn _is_intlit(e: ast.Expr) -> bool:
    return e is ast.IntLit

fn _is_numlit(e: ast.Expr) -> bool:
    return (e is ast.IntLit) or (e is ast.FloatLit)

fn _elem_arith_ok(op: string, et: string) -> bool:
    if et == "?":
        return true
    if op == "%":
        return _is_int(et)
    if op != "+" and op != "-" and op != "*" and op != "/":
        return false
    if _is_num(et):
        return true
    if len(et) > 1 and et[0] == 64:
        return true                        # a newtype over int/float; _binop has the base
    if et == "char":
        return op == "+" or op == "-"
    return false

fn _arith_op(op: string) -> bool:
    return op == "+" or op == "-" or op == "*" or op == "/" or op == "%"

fn _binop(cs: inout C, op: string, k: [ast.Expr]) -> string:
    lt := _ex(&cs, k[0])
    rt := _ex(&cs, k[1])
    cs.line = ast.line_of(k[0])
    if op == "and" or op == "or":
        # src/tychoc.c:7328-7332 -- EXACTLY bool on both sides, no adaptation
        # and no newtype: the C compares against T_BOOL, not base_of().
        if (known(lt) and lt != "bool") or (known(rt) and rt != "bool"):
            _cerr(&cs, "`" + op + "` needs bool operands")
        return "bool"
    if op == "in":
        rb := _base(&cs, rt)
        if _head(rb) != "map":
            if known(rb):
                _cerr(&cs, "`in` tests membership in a map; the right operand must be a map")
            return "bool"
        kt := _targs(rb)[0]
        if not compat(kt, lt):
            _cerr(&cs, "`in` key must be " + kt)
        return "bool"
    # literal adaptation, value-directional: a LITERAL takes the other side's
    # width, a variable never widens.
    if _is_intlit(k[0]) and _is_int(rt):
        lt = rt
    if _is_intlit(k[1]) and _is_int(lt):
        rt = lt
    if rt == "f32" and _is_numlit(k[0]):
        lt = "f32"
    if lt == "f32" and _is_numlit(k[1]):
        rt = "f32"
    if not known(lt) or not known(rt):
        if op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=":
            return "bool"
        return "?"                     # an unknown operand poisons the RESULT too:
                                       # `f * 2` at an unknown `f` is not an int
    if op == "==" or op == "!=":
        if lt != rt:
            _cerr(&cs, "cannot compare " + _show(&cs, lt) + " with " + _show(&cs, rt))
        elif lt == "void":             # src/tychoc.c:7362 -- void has no values to compare
            _cerr(&cs, "cannot compare void")
        elif _head(lt) == "fun":
            _cerr(&cs, "functions are not comparable -- closures have no structural equality; compare the values they produce instead")
        return "bool"
    if op == "<" or op == ">" or op == "<=" or op == ">=":
        if lt == "float" and rt == "int" and _is_intlit(k[1]):
            rt = "float"
        elif rt == "float" and lt == "int" and _is_intlit(k[0]):
            lt = "float"
        b := _base(&cs, lt)
        if lt != rt or not (_is_num(b) or b == "char" or b == "string"):
            _cerr(&cs, "ordering compares two ints, two floats, two strings, or two values of the same numeric newtype")
        return "bool"
    if op == "+" and lt == "string":
        if rt != "string" and rt != "char":
            _cerr(&cs, "cannot concatenate string with " + rt)
        return "string"
    if op == "+" and lt == "bytes":
        if rt != "bytes" and rt != "char":
            _cerr(&cs, "cannot concatenate bytes with " + _show(&cs, rt) + " -- to_bytes(x) to widen, or to_str(b) to work in strings")
        return "bytes"
    if op == "<<" or op == ">>":
        if not _is_int(lt) or not _is_int(rt):
            _cerr(&cs, "shift operators require integer operands (got " + lt + ", " + rt + ")")
        return lt
    la := _is_arr(lt)
    ra := _is_arr(rt)
    if la and ra and _arith_op(op):
        if _head(lt) == "bnd" or _head(rt) == "bnd":
            _cerr(&cs, "element-wise `" + op + "` is defined for [T] and [N]T only (got " + _show(&cs, lt) + ", " + _show(&cs, rt) + ")")
            return lt
        el := _elem_of(&cs, lt)
        er := _elem_of(&cs, rt)
        if el != er:
            _cerr(&cs, "element-wise `" + op + "` requires two arrays with the same element type (got " + _show(&cs, lt) + ", " + _show(&cs, rt) + ")")
        elif (_head(lt) == "fix") != (_head(rt) == "fix"):
            _cerr(&cs, "cannot mix a fixed array and a growable array in element-wise `" + op + "` (got " + _show(&cs, lt) + ", " + _show(&cs, rt) + ") -- copy one side into the other's kind first")
        elif lt != rt:
            _cerr(&cs, "element-wise `" + op + "` on a fixed array requires the same static length (got " + _show(&cs, lt) + " and " + _show(&cs, rt) + ")")
        elif not _elem_arith_ok(op, el):
            _cerr(&cs, "`" + op + "` is not defined element-wise on " + _show(&cs, lt) + " -- there is no element-wise `" + op + "` for " + _show(&cs, el))
        return lt
    if (la or ra) and _arith_op(op):
        at := lt
        st := rt
        sc := k[1]
        if ra:
            at = rt
            st = lt
            sc = k[0]
        if _head(at) == "bnd":
            _cerr(&cs, "element-wise `" + op + "` is defined for [T] and [N]T only (got " + _show(&cs, lt) + ", " + _show(&cs, rt) + ")")
            return at
        et := _elem_of(&cs, at)
        if _is_intlit(sc) and _is_int(et):
            st = et
        elif et == "f32" and _is_numlit(sc):
            st = "f32"
        elif et == "float" and st == "int" and _is_intlit(sc):
            st = "float"
        if st != et:
            _cerr(&cs, "element-wise `" + op + "` requires the scalar to have the array's element type (got " + _show(&cs, lt) + " and " + _show(&cs, rt) + ") -- a literal adapts, but a variable never widens")
        elif not _elem_arith_ok(op, et):
            _cerr(&cs, "`" + op + "` is not defined element-wise on " + _show(&cs, at) + " -- there is no element-wise `" + op + "` for " + _show(&cs, et))
        return at
    if (op == "/" or op == "%") and _is_zerolit(k[1]):
        _cerr(&cs, "division by zero")
    if op == "%" or op == "&" or op == "|" or op == "^":
        if not _is_int(lt) or lt != rt:
            _cerr(&cs, "modulo / bitwise operators require two matching integers (got " + lt + ", " + rt + ")")
        return lt
    if lt == "int" and rt == "int":
        return "int"
    if lt == rt and _is_int(lt):
        return lt
    if lt == "f32" and rt == "f32":
        return "f32"
    if (op == "+" or op == "-") and (lt == "char" or rt == "char") and
            (lt == "char" or lt == "int") and (rt == "char" or rt == "int"):
        return "char"
    if lt == "float" and rt == "float":
        return "float"
    ln := _base(&cs, lt)
    if lt == rt and _tdecl(&cs, lt) >= 0 and cs.tds[_tdecl(&cs, lt)].kind == "newtype" and
            (ln == "int" or ln == "float"):
        return lt
    if lt == "float" and rt == "int" and _is_intlit(k[1]):
        return "float"
    if rt == "float" and lt == "int" and _is_intlit(k[0]):
        return "float"
    if lt == "bytes" or rt == "bytes":
        _cerr(&cs, "bytes has no arithmetic (got " + _show(&cs, lt) + ", " + _show(&cs, rt) + ") -- bytes supports `a + b` and `b + 'c'` (concat), `b[i]` (the byte value, an int) and `b[i:j]` (a sub-buffer); for anything else use to_str(b)")
        return lt
    li := _tdecl(&cs, lt)
    ri := _tdecl(&cs, rt)
    if li >= 0 and ri >= 0 and cs.tds[li].kind == "newtype" and cs.tds[ri].kind == "newtype":
        # _short drops the package outright; a diagnostic has to print what the
        # source can type, and money.Cents is not spellable as Cents.
        _cerr(&cs, "arithmetic on two different newtypes: '" + _show(&cs, "@" + cs.tds[li].name) + "' and '" + _show(&cs, "@" + cs.tds[ri].name) + "' are distinct types even though both are over " + _show(&cs, _base(&cs, lt)) + " -- unwrap one with to_under(x), or make both sides the same newtype")
        return "?"
    # A single newtype operand used to return "?" here, which accepted
    # `Cents(1) + 1` -- src/tychoc.c:7568 falls straight through to the generic
    # arithmetic error, and the same-newtype numeric pair already returned above.
    _cerr(&cs, "arithmetic requires two ints or two floats (got " + _show(&cs, lt) + ", " + _show(&cs, rt) + ") -- convert one side, e.g. to_float(x) to compute in floats, or to_int(x) in ints")
    return lt

# ---------------------------------------------------------------- calls

fn _any_named(args: [ast.Expr]) -> bool:
    for a in args:
        if a is ast.Named:
            return true
    return false

fn _all_named(args: [ast.Expr]) -> bool:
    for a in args:
        if not (a is ast.Named):
            return false
    return true

fn _walk_args(cs: inout C, args: [ast.Expr]):
    keep := cs.in_arg
    cs.in_arg = true
    for a in args:
        _ex(&cs, a)
    cs.in_arg = keep

# One call against one known, non-generic signature: arity, each argument's
# type, and the two `&` rules. Skipped whole when a variadic or a named argument
# is in play -- `?` is the answer to anything this pass cannot ground.
fn _strable(cs: inout C, t: string) -> bool:
    b := _base(&cs, t)
    if _is_num(b) or b == "bool" or b == "char":
        return true
    h := _head(b)
    return _is_arr(b) or h == "map" or h == "tup" or h == "opt" or h == "res" or _tdecl(&cs, b) >= 0

fn _check_args(cs: inout C, name: string, si: int, args: [ast.Expr], line: int):
    # NOT `s := cs.sg[si]`: an FSig carries the generic TEMPLATE's body, so that
    # local copied a whole function body 4,217 times in a self-compile. The two
    # checks below take it as an argument, which is a borrow, and the rest of
    # this function reads two of its fields.
    _alias_check(&cs, name, cs.sg[si], args, line)
    _sink_check(&cs, name, cs.sg[si], args, line)
    variadic := false
    for f in cs.sg[si].pflags:
        if f == "var":
            variadic = true
    if _any_named(args):
        keep := cs.in_arg
        cs.in_arg = true
        for a in args:
            _ex(&cs, a)
        cs.in_arg = keep
        return
    if variadic and len(args) < len(cs.sg[si].ptypes) - 1:
        keep4 := cs.in_arg
        cs.in_arg = true
        for a in args:
            _ex(&cs, a)
        cs.in_arg = keep4
        cs.line = line
        _cerr(&cs, "'" + name + "' takes at least " + str(len(cs.sg[si].ptypes) - 1) + " argument(s), got " + str(len(args)))
        return
    if not variadic and len(args) != len(cs.sg[si].ptypes):
        keep2 := cs.in_arg
        cs.in_arg = true
        for a in args:
            _ex(&cs, a)
        cs.in_arg = keep2
        cs.line = line
        _cerr(&cs, "'" + name + "' takes " + str(len(cs.sg[si].ptypes)) + " argument(s), got " + str(len(args)))
        return
    n := len(args)
    if variadic and len(cs.sg[si].ptypes) - 1 < n:
        n = len(cs.sg[si].ptypes) - 1
        for i := n; i < len(args); i += 1:
            if (args[i] is ast.Spread) and len(args) - n > 1:
                cs.line = line
                _cerr(&cs, "a spread argument `x...` must be the only variadic argument to '" + name + "'")
                return
    keep3 := cs.in_arg
    cs.in_arg = true
    for i := 0; i < len(args); i += 1:
        want := "?"
        if i < n:
            want = cs.sg[si].ptypes[i]
        # src/tychoc.c:5995 -- a variadic call unwraps its spread args before
        # resolving them, so a spread in a FIXED parameter slot is a misuse.
        if i < n and (args[i] is ast.Spread):
            cs.line = line
            _cerr(&cs, "spread `...` is only valid as the argument to a variadic parameter")
            return
        at := _ex2(&cs, args[i], want)
        cs.line = line
        if i < n:
            if cs.sg[si].pflags[i] == "inout":
                if not (args[i] is ast.Addr):
                    _cerr(&cs, "argument " + str(i + 1) + " of '" + name + "' is inout; pass it as '&variable'")
                elif not _is_place(&cs, ast.kids(args[i])[0]):
                    _cerr(&cs, "inout argument " + str(i + 1) + " of '" + name + "' must name a variable")
                else:
                    ri := _root_name(ast.kids(args[i])[0])
                    if _ro_param(&cs, ri):
                        _cerr(&cs, "cannot pass borrowed parameter '" + ri + "' as inout (it is read-only; copy it first)")
            elif args[i] is ast.Addr:
                _cerr(&cs, "argument " + str(i + 1) + " of '" + name + "' is not inout; remove the '&'")
            # is_null asks whether an opener FAILED, so it takes a handle as well
            # as a ptr -- and nothing else, or the exception would swallow int.
            ok9 := compat(at, want)
            if not ok9 and name == "is_null" and want == "ptr" and _aff_kind(&cs, at) == "handle":
                ok9 = true
            if not ok9:
                if cs.sg[si].builtin and want == "string" and _strable(&cs, at):
                    _cerr(&cs, "argument " + str(i + 1) + " of '" + name + "' is " + _show(&cs, at) +
                        ", expected string -- wrap it with str(...), e.g. " + name + "(str(x))")
                else:
                    _cerr(&cs, "argument " + str(i + 1) + " of '" + name + "' is " + _show(&cs, at) + ", expected " + _show(&cs, want))
                _nt_note(&cs, at, want)
        cs.line = ast.line_of(args[i])
    cs.in_arg = keep3
    cs.line = line

fn _arg_name(a: ast.Expr) -> string:
    match a:
        ast.Named(l, n, k): return n
        _: return ""

# src/tychoc.c:6708-6722 -- the three rules an all-named struct construction
# must satisfy, in the bootstrap's own order.
fn _check_named(cs: inout C, ti: int, args: [ast.Expr], line: int):
    nm := cs.tds[ti].name
    fns := cs.tds[ti].fnames
    cs.line = line
    for a in args:
        an := _arg_name(a)
        if len(an) == 0:
            return                     # mixed: the mix rule already fired
        if not _has_name6(fns, an):
            _cerr(&cs, nm + " has no field '" + an + "'")
    if len(args) != len(fns):
        _cerr(&cs, nm + ": named construction must give all " + str(len(fns)) +
            " field(s), got " + str(len(args)))
    for f in fns:
        c9 := 0
        for a in args:
            if _arg_name(a) == f:
                c9 += 1
        if c9 > 1:
            _cerr(&cs, nm + ": field '" + f + "' given more than once")

fn _check_fields(cs: inout C, ti: int, args: [ast.Expr], line: int) -> string:
    # read in place: this is a whole declaration, and only fields are wanted
    if _any_named(args) or cs.tds[ti].generic:
        keep := cs.in_arg
        cs.in_arg = true
        for a in args:
            _ex(&cs, a)
        cs.in_arg = keep
        # src/tychoc.c:6703-6705: once one field is named, every field is.
        if _any_named(args) and not _all_named(args):
            cs.line = line
            _cerr(&cs, cs.tds[ti].name + ": cannot mix named and positional fields")
        if _any_named(args):
            _check_named(&cs, ti, args, line)
        if cs.tds[ti].generic:
            return "?"
        return "@" + cs.tds[ti].name
    keep2 := cs.in_arg
    cs.in_arg = true
    if len(args) != len(cs.tds[ti].fnames):
        for a in args:
            _ex(&cs, a)
        cs.in_arg = keep2
        cs.line = line
        _cerr(&cs, cs.tds[ti].name + " takes " + str(len(cs.tds[ti].fnames)) + " field value(s), got " + str(len(args)))
        return "@" + cs.tds[ti].name
    for i := 0; i < len(args); i += 1:
        at := _ex2(&cs, args[i], cs.tds[ti].ftypes[i])
        cs.line = line
        if not compat(at, cs.tds[ti].ftypes[i]):
            _cerr(&cs, "field '" + cs.tds[ti].fnames[i] + "' of " + cs.tds[ti].name + " is " + _show(&cs, cs.tds[ti].ftypes[i]) + ", got " + _show(&cs, at))
        cs.line = ast.line_of(args[i])
    cs.in_arg = keep2
    cs.line = line
    return "@" + cs.tds[ti].name

fn _check_variant(cs: inout C, m: string, args: [ast.Expr], line: int) -> string:
    owner := cs.vowner[m]
    pay := []string
    if m in cs.vpay and len(cs.vpay[m]) > 0:
        pay = split(cs.vpay[m], "|")
    ti := _tdecl(&cs, owner)
    generic := ti >= 0 and cs.tds[ti].generic
    keep := cs.in_arg
    cs.in_arg = true
    if generic and not _any_named(args):
        cs.in_arg = keep
        at0 := 0
        for v := 0; v < len(cs.tds[ti].fnames); v += 1:
            if cs.tds[ti].fnames[v] == _short(m):
                return _inst_ctor(&cs, line, ti, args, at0, cs.tds[ti].pcnt[v], _short(m))
            at0 += cs.tds[ti].pcnt[v]
        return "?"
    if generic or _any_named(args) or len(args) != len(pay):
        for a in args:
            _ex(&cs, a)
        cs.in_arg = keep
        cs.line = line
        if generic:
            return "?"
        if len(args) != len(pay):
            _cerr(&cs, m + " takes " + str(len(pay)) + " payload value(s), got " + str(len(args)))
        return owner
    for i := 0; i < len(args); i += 1:
        at := _ex2(&cs, args[i], pay[i])
        cs.line = line
        if not compat(at, pay[i]):
            _cerr(&cs, _short(m) + " payload " + str(i + 1) + " is " + _show(&cs, pay[i]) + ", got " + _show(&cs, at))
        cs.line = ast.line_of(args[i])
    cs.in_arg = keep
    cs.line = line
    return owner

fn _call(cs: inout C, l: int, q: string, n: string, ts: [ast.Ty], args: [ast.Expr], want: string) -> string:
    for t in ts:
        _enc(&cs, t)
    if len(ts) > 0:
        if len(q) > 0 and not _is_pkg(&cs, q):
            _walk_args(&cs, args)
            return "?"
        return _explicit_call(&cs, l, q, n, ts, args, want)
    if len(q) > 0:
        if not _is_pkg(&cs, q):
            # src/tychoc.c:6441-6442. Receiver-directed exactly as there: a `get`
            # on anything but a map local falls through to UFCS untouched.
            if n == "get" and _head(_base(&cs, _vtype(&cs, q))) == "map" and len(args) != 1 and len(args) != 2:
                _walk_args(&cs, args)
                cs.line = l
                _cerr(&cs, "m.get(key) or m.get(key, default) takes one or two arguments (got " + str(len(args)) + ")")
                return "?"
            if _shape_builtin(n):
                args2 := []ast.Expr
                push(args2, ast.Name(l, q))
                for a in args:
                    push(args2, a)
                return _call_builtin(&cs, l, n, args2, want)
            # `x.f(...)`: a UFCS method on a value. Which function it names needs
            # the receiver's type and the whole method set, which is Phase 6b's
            # monomorphisation surface -- `?`, and no argument is checked.
            _walk_args(&cs, args)
            return "?"
        m := _prefix_of(&cs, q) + n
        return _call_named(&cs, l, m, n, args, want)
    # The shape-directed builtins are resolved BEFORE the Sig table, exactly as
    # src/tychoc.c:6844-7094 sits before its sig_find at :7049 -- a user `fn len`
    # in the entry package is registered UNMANGLED, so without this ordering the
    # bare `len(b)` inside core:strings found it and refused a program ./tychoc
    # accepts (tests/warn/pkg/corelib_mute/main.ty).
    if _shape_builtin(n) or n == "to_ptr":
        return _call_builtin(&cs, l, n, args, want)
    vt := _vtype(&cs, n)
    if len(vt) > 0 and known(vt) and _head(_base(&cs, vt)) != "fun":
        _walk_args(&cs, args)
        cs.line = l
        _cerr(&cs, "'" + n + "' has type " + vt + ", not a procedure -- it cannot be called")
        return "?"
    if len(vt) > 0 and _head(_base(&cs, vt)) == "fun":
        # src/tychoc.c:6613-6623. A local of fn type shadows every top-level
        # name, exactly as vars_find runs before sig_find there.
        fps := _targs(_base(&cs, vt))
        if len(args) != len(fps) - 1:                              # src/tychoc.c:6616
            _walk_args(&cs, args)
            cs.line = l
            _cerr(&cs, "'" + n + "' expects " + str(len(fps) - 1) +
                " argument(s), got " + str(len(args)))
            return fps[0]
        fkeep := cs.in_arg
        cs.in_arg = true
        for i := 0; i < len(args); i += 1:
            fat := _ex2(&cs, args[i], fps[i + 1])                  # src/tychoc.c:6619 CHECKS the arg
            if known(fat) and known(fps[i + 1]) and not compat(fat, fps[i + 1]):
                cs.line = l                                        # src/tychoc.c:6621
                _cerr(&cs, "argument " + str(i + 1) + " to '" + n + "' must be " +
                    _show(&cs, fps[i + 1]))
        cs.in_arg = fkeep
        return fps[0]
    if len(cs.prefix) > 0:
        m := cs.prefix + n
        if _sigidx(&cs, m) >= 0 or m in cs.tindex or m in cs.vowner:
            return _call_named(&cs, l, m, n, args, want)
    if _sigidx(&cs, n) >= 0 or n in cs.tindex or n in cs.vowner:
        return _call_named(&cs, l, n, n, args, want)
    return _call_builtin(&cs, l, n, args, want)

fn _call_named(cs: inout C, l: int, m: string, spelt: string, args: [ast.Expr], want: string) -> string:
    # src/tychoc.c:6699-6701: `f(a: 1)` at anything but a struct is refused
    # outright; the mix rule for a struct lives in _check_fields.
    if _any_named(args):
        ti0 := -1
        if m in cs.tindex:
            ti0 = cs.tindex[m]
        if ti0 < 0 or cs.tds[ti0].kind != "struct":
            _walk_args(&cs, args)
            cs.line = l
            _cerr(&cs, "named arguments are only valid for struct construction")
            return "?"
    si := _sigidx(&cs, m)
    if si >= 0:
        if cs.sg[si].generic:
            return _generic_call(&cs, l, si, spelt, []ast.Ty, args)
        _check_args(&cs, spelt, si, args, l)
        return cs.sg[si].ret
    if m in cs.tindex:
        d := cs.tds[cs.tindex[m]]
        if d.kind == "struct" and d.generic:
            return _inst_ctor(&cs, l, cs.tindex[m], args, 0, len(cs.tds[cs.tindex[m]].fnames), "")
        if d.kind == "struct":
            return _check_fields(&cs, cs.tindex[m], args, l)
        if d.kind == "newtype":
            # src/tychoc.c:6680-6686: one argument, and it must already BE the
            # underlying type -- Cents(1.5) does not truncate on the way in.
            un := "?"
            if len(d.ftypes) > 0:
                un = d.ftypes[0]
            if len(args) != 1:
                _walk_args(&cs, args)
                cs.line = l
                _cerr(&cs, _show(&cs, "@" + m) + "(x) takes one " + _show(&cs, un))
                return "@" + m
            keepn := cs.in_arg
            cs.in_arg = true
            at := _ex2(&cs, args[0], un)
            cs.in_arg = keepn
            cs.line = l
            if not compat(at, un):
                _cerr(&cs, _show(&cs, "@" + m) + "(x) needs a " + _show(&cs, un) + ", got " + _show(&cs, at))
            return "@" + m
        _walk_args(&cs, args)
        return "?"
    if m in cs.vowner:
        return _check_variant(&cs, m, args, l)
    _walk_args(&cs, args)
    return "?"

# ---------------------------------------------------------------- builtins
#
# The shape-directed half of src/tychoc.c:6844-7094: str/hash/to_*/len/keys/
# push/pop/reserve and the map_* family bypass the fixed Sig table because their
# answer follows the ARGUMENT's type. Everything else falls through to the Sig
# table, which is where `'print' takes 1 argument(s), got 0` comes from.

fn _sized_conv(n: string) -> string:
    if n == "to_u8":
        return "u8"
    if n == "to_u16":
        return "u16"
    if n == "to_u32":
        return "u32"
    if n == "to_u64":
        return "u64"
    if n == "to_i8":
        return "i8"
    if n == "to_i16":
        return "i16"
    if n == "to_i32":
        return "i32"
    if n == "to_i64":
        return "i64"
    if n == "to_f32":
        return "f32"
    return ""

fn _str_ok(cs: inout C, t: string) -> bool:
    b := _base(&cs, t)
    if b == "?":
        return true
    if _is_num(b) or b == "bool" or b == "string" or b == "char" or b == "bytes":
        return true
    h := _head(b)
    if h == "arr" or h == "fix" or h == "bnd" or h == "map" or h == "tup" or h == "opt" or h == "res":
        return true
    i := _tdecl(&cs, b)
    return i >= 0 and (cs.tds[i].kind == "struct" or cs.tds[i].kind == "enum")

fn _arity(cs: inout C, n: string, args: [ast.Expr], want: int, msg: string) -> bool:
    if len(args) == want:
        return true
    _cerr(&cs, msg)
    return false

fn _call_builtin(cs: inout C, l: int, n: string, args: [ast.Expr], want: string) -> string:
    ats := []string
    keep := cs.in_arg
    cs.in_arg = true
    # src/tychoc.c:7020 and :6928 -- `push(xs, v)` and `map_set(m, k, v)` GROUND a
    # pending receiver, so its read here is not the ungrounded one :6108 refuses.
    # Both C sites ground before resolving args[0]; the composed type is only
    # available after the arg walk here, so the read is EXEMPTED instead and the
    # grounding runs below, off `ats` -- walking args[1] twice would double every
    # `_tnote` it makes and move the type census.
    pendn := ""
    if (n == "push" and len(args) == 2) or (n == "map_set" and len(args) == 3):
        match args[0]:
            ast.Name(l0, n0):
                if _pend_find(&cs, n0) >= 0:
                    pendn = n0
            _: pass
    a0 := "?"
    if len(args) > 0:
        keepp := cs.pendok
        cs.pendok = pendn
        a0 = _ex(&cs, args[0])
        cs.pendok = keepp
        push(ats, a0)
    b0 := _base(&cs, a0)
    # push's VALUE is checked against the array's element type, so it is the one
    # builtin whose second argument needs the expected type threaded into it --
    # `push(rows, [10, 20, 30])` at a bounded[3]int element is the case.
    w1 := "?"
    if n == "push":
        w1 = _elem_of(&cs, b0)
    for i := 1; i < len(args); i += 1:
        push(ats, _ex2(&cs, args[i], w1))
    cs.in_arg = keep
    cs.line = l
    if len(pendn) > 0:
        gt := "arr(" + ats[1] + ")"
        if n == "map_set":
            gt = "map(" + ats[1] + "," + ats[2] + ")"
        _pend_ground(&cs, pendn, gt, l)
        a0 = _vtype(&cs, pendn)
        ats[0] = a0
        b0 = _base(&cs, a0)
    if n == "str":
        if not _arity(&cs, n, args, 1, "str(x) takes one argument"):
            return "string"
        if not _str_ok(&cs, a0):
            _cerr(&cs, "str(x) can't stringify a " + _show(&cs, a0))
        return "string"
    if n == "to_ptr":
        if not _arity(&cs, n, args, 1, "to_ptr(n) takes one argument"):
            return "ptr"
        if known(a0) and a0 != "int":
            _cerr(&cs, "to_ptr(n) takes an int")
        return "ptr"
    if n == "hash":
        if not _arity(&cs, n, args, 1, "hash(x) takes one argument"):
            return "int"
        if known(a0) and not _mapkey_ok(&cs, a0):
            _cerr(&cs, "hash(x) can't hash a " + a0 + " (hashable = the map-key types: int, string, their newtypes, fieldless enums, and composites of those)")
        return "int"
    if n == "to_float":
        if not _arity(&cs, n, args, 1, "to_float(n) takes one argument"):
            return "float"
        if known(a0) and not (_is_int(a0) or a0 == "f32" or (_tdecl(&cs, a0) >= 0 and b0 == "float")):
            _cerr(&cs, "to_float(n) takes an int, a sized int, f32, or a float newtype")
        return "float"
    if n == "to_int":
        if not _arity(&cs, n, args, 1, "to_int(x) takes one argument"):
            return "int"
        if a0 == "int":
            _cerr(&cs, "to_int(x): x is already an int -- indexing a string (s[i]) yields the byte value as an int; use chr(x) for its one-character string")
        elif known(a0) and not (a0 == "float" or _is_int(a0) or a0 == "f32" or a0 == "char" or
                (_tdecl(&cs, a0) >= 0 and _is_int(b0))):
            _cerr(&cs, "to_int(x) takes a float (truncates toward zero), a sized int, f32, a char, or an int newtype")
        return "int"
    if len(_sized_conv(n)) > 0:
        if not _arity(&cs, n, args, 1, n + "(x) takes one argument"):
            return _sized_conv(n)
        if known(b0) and not (_is_num(b0) or b0 == "char"):
            _cerr(&cs, n + "(x) takes a numeric value")
        return _sized_conv(n)
    if n == "to_str":
        if not _arity(&cs, n, args, 1, "to_str(x) takes one argument"):
            return "string"
        if known(a0) and not (a0 == "bytes" or (_tdecl(&cs, a0) >= 0 and b0 == "string")):
            _cerr(&cs, "to_str(x) takes bytes or a string newtype")
        return "string"
    if n == "to_bytes":
        if not _arity(&cs, n, args, 1, "to_bytes(s) takes one argument"):
            return "bytes"
        if known(b0) and not (b0 == "string" or b0 == "bytes" or b0 == "arr(int)"):
            _cerr(&cs, "to_bytes(x) takes a string or [int]")
        return "bytes"
    if n == "to_bool":
        if not _arity(&cs, n, args, 1, "to_bool(x) takes one argument"):
            return "bool"
        if known(a0) and not (_tdecl(&cs, a0) >= 0 and b0 == "bool"):
            _cerr(&cs, "to_bool(x) takes a bool newtype")
        return "bool"
    if n == "to_under":
        if not _arity(&cs, n, args, 1, "to_under(x) takes one argument"):
            return "?"
        i := _tdecl(&cs, a0)
        if i < 0 or cs.tds[i].kind != "newtype":
            if known(a0):
                _cerr(&cs, "to_under(x) takes a newtype value, got " + a0)
            return "?"
        return cs.tds[i].ftypes[0]
    if n == "len":
        if not _arity(&cs, n, args, 1, "len(...) takes one argument"):
            return "int"
        h := _head(b0)
        if known(b0) and not (_is_arr(b0) or b0 == "string" or b0 == "bytes" or h == "map" or h == "soa"):
            _cerr(&cs, "len(...) takes an array, a string, bytes, a map, or a soa")
        return "int"
    if n == "keys":
        if not _arity(&cs, n, args, 1, "keys(m) takes one argument"):
            return "?"
        if _head(b0) != "map":
            if known(b0):
                _cerr(&cs, "keys's argument must be a map")
            return "?"
        return "arr(" + _targs(b0)[0] + ")"
    if n == "push":
        if not _arity(&cs, n, args, 2, "push(arr, value) takes two arguments"):
            return "void"
        if not _is_place(&cs, args[0]):
            _cerr(&cs, "push's first argument must be an array variable or field")
            return "void"
        if known(b0) and not (_is_arr(b0) or _head(b0) == "soa"):
            _cerr(&cs, "push's first argument must be an array or soa")
            return "void"
        rn := _root_name(args[0])
        if _ro_param(&cs, rn):
            _cerr(&cs, "cannot mutate parameter '" + rn + "' (it is borrowed read-only; copy it with `y := " + rn + "` first)")
            return "void"
        el := _elem_of(&cs, b0)
        _nest_aff_e(&cs, ats[1])
        if not compat(el, ats[1]):
            _cerr(&cs, "push's value must be " + el)
        return "void"
    if n == "pop":
        if not _arity(&cs, n, args, 1, "pop(arr) takes one argument"):
            return "?"
        if not _is_place(&cs, args[0]):
            _cerr(&cs, "pop's first argument must be an array variable or field")
            return "?"
        if known(b0) and not (_is_arr(b0) or _head(b0) == "soa"):
            _cerr(&cs, "pop's first argument must be an array or soa")
            return "?"
        if _head(b0) == "bnd":
            _cerr(&cs, "pop is not supported on a bounded[...] yet; read the last element via len()-1 and rebuild")
            return "?"
        rp := _root_name(args[0])
        if _ro_param(&cs, rp):
            _cerr(&cs, "cannot mutate parameter '" + rp + "' (it is borrowed read-only; copy it with `y := " + rp + "` first)")
            return "?"
        return _elem_of(&cs, b0)
    if n == "reserve":
        if not _arity(&cs, n, args, 2, "reserve(arr, n) takes two arguments"):
            return "void"
        if not _is_place(&cs, args[0]):
            _cerr(&cs, "reserve's first argument must be an array variable or field")
            return "void"
        if known(b0) and not (_is_arr(b0) or _head(b0) == "map"):
            _cerr(&cs, "reserve's first argument must be an array or a map")
            return "void"
        if _head(b0) == "bnd":
            _cerr(&cs, "reserve does not apply to a bounded[...] — its capacity is fixed")
            return "void"
        rr := _root_name(args[0])
        if _ro_param(&cs, rr):
            _cerr(&cs, "cannot mutate parameter '" + rr + "' (it is borrowed read-only)")
            return "void"
        if known(ats[1]) and not compat("int", ats[1]):
            _cerr(&cs, "reserve's capacity must be int")
        return "void"
    # The four concurrency builtins used to fall through silently on a wrong
    # arity or a non-channel argument, leaving codegen to die with `unsupported
    # call` -- src/tychoc.c:6806-6847 refuses each here, so this does too.
    if n == "close":
        if not _arity(&cs, n, args, 1, "close takes one channel or handle"):
            return "void"
        if _aff_kind(&cs, a0) == "handle":
            if not (args[0] is ast.Name):
                _cerr(&cs, "close(h) takes a handle variable")
            return "void"
        if known(b0) and _head(b0) != "chan":
            _cerr(&cs, "close takes a channel or a handle, got " + a0)
        return "void"
    if n == "send":
        if not _arity(&cs, n, args, 2, "send(ch, v) takes a channel and a value"):
            return "void"
        if _head(b0) != "chan":
            if known(b0):
                _cerr(&cs, "send(ch, v) takes a channel, got " + a0)
            return "void"
        w := _targs(b0)[0]
        if not compat(w, ats[1]):
            _cerr(&cs, "send on " + _show(&cs, b0) + " needs a " + w + " value")
        return "void"
    if n == "wait":
        if not _arity(&cs, n, args, 1, "wait(t) takes one task"):
            return "?"
        if _head(b0) == "task":
            return _targs(b0)[0]
        if known(b0):                                   # src/tychoc.c:6808
            _cerr(&cs, "wait(t) takes a task from spawn, got " + _show(&cs, a0))
        return "?"
    if n == "recv":
        if not _arity(&cs, n, args, 1, "recv(ch) takes one channel"):
            return "?"
        if _head(b0) != "chan":
            if known(b0):
                _cerr(&cs, "recv(ch) takes a channel, got " + a0)
            return "?"
        return "opt(" + _targs(b0)[0] + ")"
    if n == "zero":
        return "?"
    si := _sigidx(&cs, n)
    if si >= 0:
        _check_args(&cs, n, si, args, l)
        return cs.sg[si].ret
    return "?"

# ---------------------------------------------------------------- match
#
# src/tychoc.c:8546-8746. Exhaustiveness is the half a verdict differential
# cannot get for free: a match that covers three of four variants COMPILES under
# a checker that forgot to count, and the program then falls off the end.

fn _variant_names(cs: inout C, et: string) -> [string]:
    i := _tdecl(&cs, et)
    if i < 0:
        return []string
    return cs.tds[i].fnames

fn _variant_payload(cs: inout C, et: string, name: string) -> [string]:
    i := _tdecl(&cs, et)
    if i < 0:
        return []string
    # read in place: a TDecl copy is a whole declaration (see _field_ty)
    for k := 0; k < len(cs.tds[i].fnames); k += 1:
        if cs.tds[i].fnames[k] == name:
            if len(cs.tds[i].ftypes[k]) == 0:
                return []string
            return split(cs.tds[i].ftypes[k], "|")
    return []string

# Is `name` a variant of the enum type `t`? src/tychoc.c@enum_variant_index.
fn _is_variant_of(cs: inout C, t: string, name: string) -> bool:
    ti := _tdecl(&cs, _base(&cs, t))
    if ti < 0 or cs.tds[ti].kind != "enum":
        return false
    for v in cs.tds[ti].fnames:
        if v == name:
            return true
    return false

# The payload-shape rules for one Option/Result side -- src/tychoc.c@match_arm_payload.
# It only ADDS diagnostics: _nested_of still decides what the arm covers, so a
# payload this cannot resolve (a `?` from a generic) is left alone rather than
# refused, which keeps the port no stricter than the bootstrap.
fn _pay_shape(cs: inout C, a: ast.Arm, pay: string, tag: string):
    if not known(pay):
        return
    cs.line = a.line
    ti := _tdecl(&cs, _base(&cs, pay))
    isenum := ti >= 0 and cs.tds[ti].kind == "enum"
    if len(a.sub) == 0:
        if len(a.binds) != 1:
            _cerr(&cs, tag + "(x) binds exactly one value")
            return
        if isenum and _is_variant_of(&cs, pay, a.binds[0]):
            if len(_variant_payload(&cs, _base(&cs, pay), a.binds[0])) != 0:
                _cerr(&cs, "'" + a.binds[0] + "' is a variant of " + _show(&cs, pay) +
                    " that carries a payload -- write " + tag + "(" + a.binds[0] +
                    "(x)) to match it, or rename the binding")
        return
    if not isenum:
        _cerr(&cs, "a nested pattern needs an enum payload, but " + tag +
            " here carries " + _show(&cs, pay))
        return
    if not _is_variant_of(&cs, pay, a.sub):
        return
    np := len(_variant_payload(&cs, _base(&cs, pay), a.sub))
    if len(a.subbinds) != np:
        _cerr(&cs, a.sub + " binds " + str(np) + " value(s), got " + str(len(a.subbinds)))

fn _arm_binds(cs: inout C, a: ast.Arm, tys: [string]):
    for i := 0; i < len(a.binds); i += 1:
        t := "?"
        if i < len(tys):
            t = tys[i]
        if t == "void":
            cs.line = a.line
            _cerr(&cs, "cannot bind a void value")
            t = "?"
        _vpush(&cs, a.binds[i], t, true)
        cs.mbind[a.binds[i]] = true
    for b in a.subbinds:
        _vpush(&cs, b, "?", true)
        cs.mbind[b] = true

fn _match(cs: inout C, l: int, subj: [ast.Expr], arms: [ast.Arm]):
    st := _base(&cs, _ex(&cs, subj[0]))
    wild := false
    for i := 0; i < len(arms); i += 1:
        if arms[i].kind == "variant" and arms[i].name == "_":
            if i != len(arms) - 1:
                cs.line = arms[i].line
                _cerr(&cs, "a `_` wildcard must be the last match arm")
            if len(arms[i].binds) != 0:
                cs.line = arms[i].line
                _cerr(&cs, "a `_` wildcard binds nothing")
            wild = true
        if arms[i].kind == "scalar":
            for p in arms[i].pats:
                if p.kind == "name" and p.loname == "_":
                    if i != len(arms) - 1:
                        cs.line = arms[i].line
                        _cerr(&cs, "a `_` wildcard must be the last match arm")
                    wild = true
    h := _head(st)
    if h == "opt" or h == "res":
        # A REFINED side: `Err(A(n))` covers one variant of the payload enum, so
        # `Err` alone is not covered until every variant is. src/tychoc.c@SideCov;
        # tests/reject/match_result_partial_err.ty's own header says why the
        # "must cover both Ok and Err" wording would be false here.
        cov0 := []string: bool
        cov1 := []string: bool
        ref0 := false
        ref1 := false
        full0 := false
        full1 := false
        seen0 := false
        seen1 := false
        yes := "Some"
        no := "None"
        if h == "res":
            yes = "Ok"
            no = "Err"
        for a in arms:
            m := _vmark(&cs)
            cs.line = a.line
            if a.name == "_":
                pass
            elif a.name == yes and len(a.qual) == 0:
                if full0:                          # an unrefined arm already took this side
                    _cerr(&cs, "duplicate " + yes + " arm")
                seen0 = true
                nested := _nested_of(&cs, a, _targs(st)[0])
                if len(nested) > 0:
                    ref0 = true
                    if nested in cov0:
                        _cerr(&cs, "duplicate " + yes + "(" + nested + ") arm")
                    cov0[nested] = true
                else:
                    full0 = true       # a plain binding covers the whole side
                pay := []string
                push(pay, _targs(st)[0])
                if h == "res" and _targs(st)[0] == "void" and len(a.binds) > 0:
                    _cerr(&cs, "Ok carries no value here -- write a bare `Ok:` arm")
                else:
                    if _targs(st)[0] != "void":
                        _pay_shape(&cs, a, _targs(st)[0], yes)
                    _arm_binds(&cs, a, pay)
            elif a.name == no and len(a.qual) == 0:
                nested := ""
                if h == "res":
                    if full1:
                        _cerr(&cs, "duplicate " + no + " arm")
                    nested = _nested_of(&cs, a, _targs(st)[1])
                else:
                    # None is nullary: src/tychoc.c:8567 and :8536 word it apart
                    # from the Err side, which does carry a payload.
                    if seen1:
                        _cerr(&cs, "duplicate None arm")
                    if len(a.binds) != 0 or len(a.sub) > 0:
                        _cerr(&cs, "None binds nothing")
                seen1 = true
                if len(nested) > 0:
                    ref1 = true
                    if nested in cov1:
                        _cerr(&cs, "duplicate " + no + "(" + nested + ") arm")
                    cov1[nested] = true
                else:
                    full1 = true
                pay := []string
                if h == "res":
                    push(pay, _targs(st)[1])
                    if _targs(st)[1] != "void":
                        _pay_shape(&cs, a, _targs(st)[1], no)
                _arm_binds(&cs, a, pay)
            elif known(st):
                spelt2 := a.name
                if len(a.qual) > 0:
                    spelt2 = a.qual + "." + a.name
                if h == "opt":
                    _cerr(&cs, "an Option's arms are Some(x), None, and _, not '" + spelt2 + "'")
                else:
                    _cerr(&cs, "a Result's arms are Ok(x), Err(e), and _, not '" + spelt2 + "'")
            _tblock(&cs, a.body)
            _vrestore(&cs, m)
        if not wild and known(st):
            cs.line = l
            if not (seen0 and seen1):
                if h == "opt":
                    _cerr(&cs, "match on an Option must cover both Some and None")
                else:
                    _cerr(&cs, "match on a Result must cover both Ok and Err")
            else:
                _side_cov(&cs, l, _targs(st)[0], cov0, ref0 and not full0)
                if h == "res":
                    _side_cov(&cs, l, _targs(st)[1], cov1, ref1 and not full1)
        return
    ti := _tdecl(&cs, st)
    if ti >= 0 and cs.tds[ti].kind == "enum":
        names := _variant_names(&cs, st)
        covered := []string: bool
        for a in arms:
            m := _vmark(&cs)
            cs.line = a.line
            if a.name != "_":
                found := false
                for v in names:
                    if v == a.name:
                        found = true
                fv := ""
                if found:
                    fv = _foreign_variant(&cs, cs.tds[ti].name, a.qual, a.name)
                if not found:
                    _cerr(&cs, "'" + a.name + "' is not a variant of " + _show(&cs, "@" + cs.tds[ti].name))
                elif len(fv) > 0:
                    _cerr(&cs, fv)
                elif a.name in covered:
                    _cerr(&cs, "duplicate arm for " + a.name)
                covered[a.name] = true
                pay := _variant_payload(&cs, st, a.name)
                if found and len(a.binds) != len(pay) and len(a.subbinds) == 0:
                    _cerr(&cs, a.name + " binds " + str(len(pay)) + " value(s), got " + str(len(a.binds)))
                # src/tychoc.c:8632 -- the sibling of `_pay_shape`'s nested-pattern
                # arm. A nested pattern is an Option/Result payload spelling only;
                # this arm bound one silently.
                if found and len(a.sub) > 0:
                    _cerr(&cs, "a nested pattern is only supported inside Ok(...), Err(...) or Some(...) -- match " +
                        a.name + "'s payload in its own match")
                for b := 0; b < len(a.binds); b += 1:
                    if b < len(pay) and _is_variant_of(&cs, pay[b], a.binds[b]):
                        cs.line = a.line
                        _cerr(&cs, "'" + a.binds[b] + "' is a variant of " + _show(&cs, pay[b]) +
                            ", not a binding name -- match it in its own match, or rename the binding")
                _arm_binds(&cs, a, pay)
            _tblock(&cs, a.body)
            _vrestore(&cs, m)
        if not wild:
            for v in names:
                if not (v in covered):
                    cs.line = l
                    _cerr(&cs, "non-exhaustive match: missing variant " + _vq(cs.tds[ti].name, v) + " of " + _show(&cs, "@" + cs.tds[ti].name))
        return
    if st == "int" or st == "char" or st == "bool" or not known(st):
        los := []int
        his := []int
        lns := []int
        for a in arms:
            m := _vmark(&cs)
            cs.line = a.line
            if a.kind == "scalar":
                for p in a.pats:
                    if p.kind == "name":
                        if p.loname != "_":
                            cv := _const_int(&cs, p.loname)
                            if cv[0] == 0:
                                _cerr(&cs, "'" + p.loname + "' is not an int constant")
                            else:
                                push(los, cv[1])
                                push(his, cv[1])
                                push(lns, a.line)
                        continue
                    if st == "int" and p.kind != "int":
                        _cerr(&cs, "a match on an int takes int literal arms, not a " + p.kind)
                    if st == "char" and p.kind != "char":
                        _cerr(&cs, "a match on a char takes char literal arms")
                    if st == "bool" and p.kind != "bool":
                        _cerr(&cs, "a match on a bool takes true/false arms")
                    if p.lo > p.hi:
                        _cerr(&cs, "a range starts at " + str(p.lo) + " and ends at " + str(p.hi) + " (the start must not exceed the end)")
                    push(los, p.lo)
                    push(his, p.hi)
                    push(lns, a.line)
            elif a.name != "_" and known(st):
                cv := _const_int(&cs, a.name)
                if cv[0] == 0:
                    _cerr(&cs, "'" + a.name + "' is not an int constant (match arms for " + st + " are literals)")
                else:
                    push(los, cv[1])
                    push(his, cv[1])
                    push(lns, a.line)
            _tblock(&cs, a.body)
            _vrestore(&cs, m)
        for i := 0; i < len(los); i += 1:
            for j := i + 1; j < len(los); j += 1:
                if los[j] <= his[i] and los[i] <= his[j]:
                    cs.line = lns[j]
                    if lns[j] < lns[i]:
                        cs.line = lns[i]
                    _cerr(&cs, "duplicate or overlapping match arm: [" + str(los[i]) + ".." + str(his[i]) +
                          "] overlaps [" + str(los[j]) + ".." + str(his[j]) + "] from line " + str(lns[i]))
                    return
        if not wild and known(st):
            cs.line = l
            if st == "int" or st == "char":
                _cerr(&cs, "a match on " + st + " must carry a `_` arm (the domain is unbounded)")
            else:
                has0 := false
                has1 := false
                for i := 0; i < len(los); i += 1:
                    if los[i] <= 0 and 0 <= his[i]:
                        has0 = true
                    if los[i] <= 1 and 1 <= his[i]:
                        has1 = true
                if not has0 or not has1:
                    _cerr(&cs, "a match on a bool must cover both true and false, or carry a `_` arm")
        return
    cs.line = l
    if st == "string" or st == "bytes" or st == "float":
        _cerr(&cs, "match on " + st + " is refused: nothing in the tree dispatches on it -- use if/elif (see docs/internals/design-scalar-match.md D1)")
    else:
        _cerr(&cs, "match expects an Option, Result, or enum value, or an int/char/bool, got " + _show(&cs, st))
    for a in arms:
        m := _vmark(&cs)
        _tblock(&cs, a.body)
        _vrestore(&cs, m)

# (found, value) for an int `const` by the name written at a match arm.
fn _const_int(cs: inout C, name: string) -> [int]:
    out := []int
    push(out, 0)
    push(out, 0)
    k := ""
    if len(cs.prefix) > 0 and (cs.prefix + name) in cs.constv:
        k = cs.prefix + name
    elif name in cs.constv:
        k = name
    if len(k) == 0:
        return out
    out[0] = 1
    out[1] = cs.constv[k]
    return out

# ---------------------------------------------------------------- statements

fn _tblock(cs: inout C, body: [ast.Stmt]):
    m := _vmark(&cs)
    pm := cs.npend
    _ix9 := 0
    for s in body:
        # The recovery boundary is the STATEMENT (tests/diag/multi_error_one_fn):
        # the first error in one ends it, and the next statement starts clean.
        if cs.errbase >= 0:
            cs.errbase = len(cs.errs)
        _tstmt(&cs, s)
        _copylive_stmt(&cs, body, _ix9)
        _ix9 += 1
    # src/tychoc.c:8939 -- a pending decl must ground in its OWN block.
    for pi := pm; pi < cs.npend; pi += 1:
        if not cs.pend[pi].done:
            cs.line = cs.pend[pi].line
            _cerr(&cs, "could not infer the type of '" + cs.pend[pi].name +
                "' -- no grounding use in its block (annotate: " + cs.pend[pi].name +
                " : [T] = [] / Option(T) = None)")
    cs.npend = pm
    _vrestore(&cs, m)

fn _tail_add(cs: inout C, line: int, t: string):
    if cs.tcol <= 0:
        return
    e := Tail(line, t)
    if cs.ntail < len(cs.tail):
        cs.tail[cs.ntail] = e
    else:
        push(cs.tail, e)
    cs.ntail += 1

# src/tychoc.c@expr_diverges -- an unqualified call to `die` or `exit` and
# nothing else. A diverging tail is NOT a branch result.
fn _tail_diverges(e: ast.Expr) -> bool:
    match e:
        ast.Call(l, q, n, ts, a): return len(q) == 0 and (n == "die" or n == "exit")
        _: return false
    return false

# A bare Ok/Err/None: src/tychoc.c's T_NONE / T_OK_PARTIAL / T_ERR_PARTIAL, which
# this pass encodes as an unfilled side rather than as its own head.
fn _tail_partial(t: string) -> bool:
    if t == "opt(?)":
        return true
    if _head(t) != "res":
        return false
    a := _targs(t)
    return len(a) == 2 and (a[0] == "?" or a[1] == "?")

# The three rules the tail LIST makes reachable. Returns true when one fired, so
# the caller drops the type and the generic `cannot bind a void value` stays quiet.
fn _tail_rules(cs: inout C, m: int, l: int, name: string) -> bool:
    if cs.ntail == m:
        cs.line = l
        _cerr(&cs, "every branch of this value if/match diverges, so there is no value to bind to '" +
            name + "' -- write the if/match as a plain statement")
        return true
    for i := m; i < cs.ntail; i += 1:
        if _tail_partial(cs.tail[i].ty):
            cs.line = cs.tail[i].line
            _cerr(&cs, "cannot infer the type of this branch — a bare Ok/Err/None is fixed only by a destination type, and neither := nor x : T = flows one in; write the branch with a concrete type, or bind it via an assignment/return")
            return true
        if cs.tail[i].ty == "void":
            cs.line = cs.tail[i].line
            _cerr(&cs, "a value if/match branch must produce a value, not void")
            return true
    return false

# The type an if/match VALUE block produces, and the rule that its branches must
# agree (src/tychoc.c:8378). The parser rewrote each tail into a Decl/Assign of
# the same target, so the branch types are read back off those tails.
fn _value_type(cs: inout C, body: [ast.Stmt], want: string) -> string:
    if len(body) == 0:
        return "?"
    # ONLY the last statement is the tail. A value arm may be a whole block
    # (tests/if_expr_block.ty), whose leading `:=` statements bind branch-locals
    # -- reading their types as branch results reported `int and string` for a
    # program src/tychoc.c accepts.
    m := _vmark(&cs)
    for i := 0; i < len(body) - 1; i += 1:
        _tstmt(&cs, body[i])
    t := _tail_type(&cs, body[len(body) - 1], want)
    _vrestore(&cs, m)
    return t

fn _tail_type(cs: inout C, s: ast.Stmt, want: string) -> string:
    match s:
        ast.Decl(l, n, ty, rhs, vb):
            if len(rhs) == 1:
                t0 := _ex2(&cs, rhs[0], want)
                _tail_add(&cs, l, t0)
                return t0
            _tail_add(&cs, l, "?")
            return "?"
        ast.Assign(l, n, rhs):
            t1 := _ex2(&cs, rhs[0], want)
            _tail_add(&cs, l, t1)
            return t1
        ast.ExprStmt(l, k):
            t2 := _ex2(&cs, k[0], want)
            if not _tail_diverges(k[0]):     # die()/exit(): no branch result at all
                _tail_add(&cs, l, t2)
            return t2
        ast.IfS(l, c, b, e):
            t := _ex(&cs, c[0])
            cs.line = l
            if known(t) and t != "bool":
                _cerr(&cs, "if condition must be bool")
            m := _vmark(&cs)
            ta := _value_type(&cs, b, want)
            _vrestore(&cs, m)
            m2 := _vmark(&cs)
            tb := _value_type(&cs, e, want)
            bl := cs.line                  # the disagreeing branch's own line
            _vrestore(&cs, m2)
            if ta == "?":
                return tb
            if tb != "?" and not compat(ta, tb):
                cs.line = bl
                _cerr(&cs, "if/match branches produce different types (" + ta + " and " + tb + ")")
            return ta
        ast.MatchS(l, subj, arms):
            _match(&cs, l, subj, arms)
            _tail_add(&cs, l, "?")     # arms are typed by _match, which returns no list
            return "?"
        _:
            _tstmt(&cs, s)
            _tail_add(&cs, ast.sline_of(s), "?")
            return "?"
    return "?"

# The roots src/tychoc.c@is_lvalue accepts. A CALL is one only when it names a
# declared `subscript` -- `b.get().v[0] = 9` is a call on a TEMPORARY and is
# refused (tests/reject/place_call_receiver.ty), and a tuple element is not an
# index-assign root at all.
fn _is_place(cs: inout C, e: ast.Expr) -> bool:
    match e:
        ast.Name(l, n): return true
        ast.Field(l, k, f): return _is_place(&cs, k[0])
        ast.Index(l, k): return _is_place(&cs, k[0])
        ast.Call(l, q, n, ts, a): return n in cs.subs
        _: return false
    return false

# src/tychoc.c@is_lvalue's E_INDEX arm, which `_is_place` above deliberately is
# NOT: that one mirrors the STRUCTURAL root walk C spells inline (a root that is
# not an identifier), and the inout rule at src/tychoc.c:7191 wants exactly that.
# This one is TYPE-AWARE -- an index step is a mutable interior only over a
# composite array, an soa or a map, because src/tychoc.c@arr_of sends
# [int]/[string]/[float] to the scalar array types, which are not ARRC. The raw
# type is read, not `_base`'d, because is_lvalue reads `e->lhs->type` raw.
fn _mutable_interior(t: string) -> bool:
    h := _head(t)
    if h == "map" or h == "soa" or h == "fix" or h == "bnd":
        return true
    if h != "arr":
        return not known(t)      # unground says nothing either way: fail open
    el := _targs(t)[0]
    return el != "int" and el != "string" and el != "float"

fn _is_lvalue(cs: inout C, e: ast.Expr) -> bool:
    match e:
        ast.Name(l, n): return true
        ast.Field(l, k, f): return _is_lvalue(&cs, k[0])
        ast.Index(l, k): return _mutable_interior(_ex(&cs, k[0])) and _is_lvalue(&cs, k[0])
        ast.Call(l, q, n, ts, a): return n in cs.subs
        _: return false
    return false

# The identifier a place expression is rooted at, after stripping field and
# index steps -- every place rule in `src/tychoc.c` walks E_FIELD/E_INDEX the
# same way before testing the root. "" when
# the root is not a name (a call, a tuple index), which no rule below fires on.
fn _root_name(e: ast.Expr) -> string:
    match e:
        ast.Name(l, n): return n
        ast.Field(l, k, f): return _root_name(k[0])
        ast.Index(l, k): return _root_name(k[0])
        _: return ""
    return ""

# src/tychoc.c:8839 tests `s->expr->lhs == s->target` by POINTER, which the
# desugar at compiler/parse/parse.ty:1307 guarantees for `place op= v`. There is
# no pointer identity here, so the two places are compared structurally instead
# -- a literal or a name key, which is every key the desugar can reproduce.
fn _same_place(a: ast.Expr, b: ast.Expr) -> bool:
    match a:
        ast.Name(la, na):
            match b:
                ast.Name(lb, nb): return na == nb
                _: return false
        ast.Field(la, ka, fa):
            match b:
                ast.Field(lb, kb, fb): return fa == fb and _same_place(ka[0], kb[0])
                _: return false
        ast.Index(la, ka):
            match b:
                ast.Index(lb, kb): return _same_place(ka[0], kb[0]) and _same_key(ka[1], kb[1])
                _: return false
        _: return false
    return false

# src/tychoc.c:8838 -- `m[k] op= v` reads and writes the value slot in place, so
# it lowers to a plain C operator and is restricted to the scalar value types.
fn _map_place(cs: inout C, place: ast.Expr) -> bool:
    match place:
        ast.Index(lp, kp): return _head(_base(&cs, _ex(&cs, kp[0]))) == "map"
        _: return false

fn _map_compound(cs: inout C, l: int, place: ast.Expr, val: ast.Expr, pt: string):
    if not known(pt) or not (place is ast.Index):
        return
    match place:
        ast.Index(lp, kp):
            if _head(_base(&cs, _ex(&cs, kp[0]))) != "map":
                return
        _: return
    scalar := pt == "int" or pt == "float" or pt == "char"
    match val:
        ast.Binop(lv, o, kv):
            if not _same_place(place, kv[0]):
                return
            cs.line = l
            if not scalar:
                _cerr(&cs, "compound assignment `m[k] op= ...` is only supported for int/float/char " +
                    "map values; for a composite value use push(m[k], ...) or `m[k] = <expr>`")
                return
            # src/tychoc.c:8842 -- the read-modify-write is on the value slot, so
            # the right side must already BE the value type; this runs ahead of
            # the binop's own arithmetic rule, as it does in the bootstrap.
            rt := _ex(&cs, kv[1])
            cs.line = l
            if known(rt) and rt != pt:
                _cerr(&cs, "cannot compound-assign " + _show(&cs, rt) + " to a " + _show(&cs, pt) + " map value")
        _: pass

fn _same_key(a: ast.Expr, b: ast.Expr) -> bool:
    match a:
        ast.IntLit(la, va):
            match b:
                ast.IntLit(lb, vb): return va == vb
                _: return false
        ast.StrLit(la, va):
            match b:
                ast.StrLit(lb, vb): return va == vb
                _: return false
        _: return _same_place(a, b)
    return false

# An array, map or soa PARAMETER is borrowed read-only unless it is `sink`:
# `src/tychoc.c@vars_can_mutate` answers exactly that, and the three mutating
# builtins plus every `&` argument consult it.
fn _ro_param(cs: inout C, n: string) -> bool:
    if len(n) == 0 or not (n in cs.parms) or (n in cs.sinkp):
        return false
    si := _sigidx(&cs, cs.symfnm)
    if si < 0:
        return false
    for i := 0; i < len(cs.sg[si].pnames); i += 1:
        if cs.sg[si].pnames[i] == n and cs.sg[si].pflags[i] == "inout":
            return false        # an inout container IS the caller's, by pointer
    t := _vtype(&cs, n)
    return _is_arr(t) or _head(t) == "map" or _head(t) == "soa"

fn _is_zerolit(e: ast.Expr) -> bool:
    match e:
        ast.IntLit(l, v): return v == 0
        _: return false
    return false

fn _place_ty(cs: inout C, e: ast.Expr) -> string:
    match e:
        ast.Index(l, k):
            rt := _base(&cs, _ex(&cs, k[0]))
            h := _head(rt)
            cs.line = l
            # src/tychoc.c:8820 (the root walk), :8797 (is_lvalue), then :8820
            # (the container type) -- three rules in that order, where this arm
            # used to test the container first and fold the other two together.
            if not _is_place(&cs, k[0]):
                _cerr(&cs, "can only index-assign an array or map variable or field")
                return "?"
            if not _is_lvalue(&cs, k[0]):
                _cerr(&cs, "cannot index-assign through this expression (only a variable, field, composite-array element, or map value is a place)")
                return "?"
            cs.line = l
            if rt == "string":
                _cerr(&cs, "cannot index-assign an element of string (it is immutable)")
                return "?"
            if _head(rt) == "tup" or (known(rt) and not (_is_arr(rt) or h == "map" or h == "soa")):
                _cerr(&cs, "can only index-assign an array or map variable or field")
                return "?"
            it := _ex(&cs, k[1])
            cs.line = l
            if h == "map":
                kt := _targs(rt)[0]
                if not compat(kt, it):
                    _cerr(&cs, "map key must be " + _show(&cs, kt) + ", got " + _show(&cs, it))
                return _targs(rt)[1]
            return _elem_of(&cs, rt)
        ast.Field(l, k, f):
            if not _is_place(&cs, k[0]):
                cs.line = l
                _cerr(&cs, "cannot assign to a field of a temporary (only variables, fields, and composite-array elements are places)")
                return "?"
            return _ex(&cs, e)
        _: return _ex(&cs, e)
    return "?"

# src/tychoc.c@is_pure_builtin, copied name for name.
fn _pure_builtin(n: string) -> bool:
    return n == "str" or n == "substr" or n == "chr" or n == "split" or n == "keys" or
        n == "find" or n == "char_at" or n == "map_get" or n == "map_has" or
        n == "map_set" or n == "map_del" or n == "sqrt" or n == "pow" or n == "floor" or
        n == "fabs" or n == "to_float" or n == "to_int" or n == "to_char" or
        n == "to_str" or n == "to_bool" or n == "is_null" or n == "len" or n == "hash"

fn _tstmt(cs: inout C, s: ast.Stmt):
    cs.line = ast.sline_of(s)
    match s:
        ast.ExprStmt(l, k):
            # src/tychoc.c@is_pure_builtin -- a pure builtin has no side effect, so
            # discarding its result in statement position does nothing at all.
            # `map_set(m, k, v)` as a bare statement is the footgun this names: it
            # returns a NEW map and changes nothing.
            match k[0]:
                ast.Call(l2, q2, n2, ts2, ar2):
                    # `m.get(k, d)` parses as a QUALIFIED call, q = the receiver.
                    # src/tychoc.c@discarded_map_get gates it on a map receiver, which
                    # keeps a user `get` on some other type quiet.
                    if n2 == "get" and len(q2) > 0 and _head(_ex(&cs, ast.Name(l2, q2))) == "map":
                        cs.line = l
                        _cwarn(&cs, "result of `get` is discarded; it has no side effects," +
                            " so this statement does nothing (to change a map, use" +
                            " `m[k] = v` or `delete m[k]`)")
                    if len(q2) == 0 and _pure_builtin(n2):
                        cs.line = l
                        _cwarn(&cs, "result of `" + n2 + "` is discarded; it has no side" +
                            " effects, so this statement does nothing (to change a map," +
                            " use `m[k] = v` or `delete m[k]`)")
                _: pass
            t := _ex(&cs, k[0])
            # A Result used as a statement throws the error path away.
            if len(t) > 4 and t[0:4] == "res(":
                cs.line = l
                _cwarn(&cs, "this Result is discarded, so its error is silently ignored;" +
                    " handle it with `match`, propagate with `or_return`, or bind it (x := ...)")
            if (k[0] is ast.OrRet) and t != "void" and known(t):
                cs.line = l
                _cerr(&cs, "`or_return` here produces " + t + ", which this statement discards -- bind it (x := ... or_return)")
        ast.Decl(l, name, ty, rhs, vb):
            want := "?"
            if len(ty) == 1:
                want = _enc(&cs, ty[0])
            t := "?"
            if len(rhs) == 1:
                cs.chan_decl = true
                t = _ex2(&cs, rhs[0], want)
                cs.chan_decl = false
            elif len(vb) > 0:
                tm := cs.ntail
                cs.tcol += 1
                t = _value_type(&cs, vb, want)
                cs.tcol -= 1
                if _tail_rules(&cs, tm, l, name):
                    t = "?"
                cs.ntail = tm
            cs.line = l
            if len(rhs) == 1:
                _aff_bind_check(&cs, t, rhs[0])
            if not compat(want, t):
                _cerr(&cs, "declared type " + _show(&cs, want) + " but value is " + _show(&cs, t))
            if len(ty) == 0 and len(rhs) == 1:
                _bare_result(&cs, t, rhs[0])
            if want == "f32" and len(rhs) == 1:
                _f32_fits(&cs, rhs[0])
            if t == "void":
                _cerr(&cs, "cannot bind a void value")
                t = "?"
            if len(vb) > 0 and _head(t) == "task":
                _cerr(&cs, "a value if/match cannot produce a task handle")   # src/tychoc.c:8387
            if len(ty) == 1:
                t = want
            _tnote(&cs, "d:" + t)
            if cs.symon:
                push(cs.symrows, cs.symfnm + "\nlocal\t" + name + "\t" + _show(&cs, t) + "\t" +
                    str(cs.symfn) + "\t" + str(l))
            _vpush(&cs, name, t, true)
            pold := _pend_find(&cs, name)
            if pold >= 0:                              # a redeclaration retires the old entry
                cs.pend[pold].done = true
            if len(ty) == 0 and len(rhs) == 1 and _bare_empty_arr(rhs[0]):
                _pend_add(&cs, name, l)
        ast.MDecl(l, isdecl, names, rhs):
            t := "?"
            if len(rhs) == 1:
                t = _base(&cs, _ex(&cs, rhs[0]))
            els := _targs(t)
            cs.line = l
            if known(t) and len(rhs) == 1:
                if _head(t) != "tup":
                    if isdecl:
                        _cerr(&cs, "the right side of a destructuring `:=` must be a tuple, got " + _show(&cs, t))
                    else:
                        _cerr(&cs, "the right side of a multi-assign must be a tuple, got " + _show(&cs, t))
                elif len(els) != len(names):
                    if isdecl:
                        _cerr(&cs, "destructuring " + str(len(names)) + " name(s) from a " +
                            str(len(els)) + "-element tuple")
                    else:
                        _cerr(&cs, "assigning " + str(len(names)) + " name(s) from a " +
                            str(len(els)) + "-element tuple")
            for i := 0; i < len(names); i += 1:
                et := "?"
                if _head(t) == "tup" and i < len(els):
                    et = els[i]
                if isdecl:
                    _tnote(&cs, "m:" + et)
                    if cs.symon:
                        push(cs.symrows, cs.symfnm + "\nlocal\t" + names[i] + "\t" + _show(&cs, et) +
                            "\t" + str(cs.symfn) + "\t" + str(l))
                    _vpush(&cs, names[i], et, true)
                else:
                    _assign_check(&cs, names[i], et)
        ast.Assign(l, name, rhs):
            vt := _vtype(&cs, name)
            want := "?"
            if len(vt) > 0:
                want = vt
            cs.line = l
            _aff_reassign_check(&cs, name, want)
            t := _ex2(&cs, rhs[0], want)
            cs.line = l
            _assign_check(&cs, name, t)
        ast.PlaceSet(l, k):
            pt := _place_ty(&cs, k[0])
            _map_compound(&cs, l, k[0], k[1], pt)   # src/tychoc.c:8838
            vt := _ex2(&cs, k[1], pt)
            cs.line = l
            if not compat(pt, vt):
                if k[0] is ast.Field:
                    _cerr(&cs, "cannot assign " + _show(&cs, vt) + " to a " + _show(&cs, pt) + " field")
                elif _map_place(&cs, k[0]):
                    _cerr(&cs, "cannot assign " + _show(&cs, vt) + " to a " + _show(&cs, pt) + " map value")
                else:
                    _cerr(&cs, "cannot assign " + _show(&cs, vt) + " to a " + _show(&cs, pt) + " element")
        ast.ConstS(l, name, v):
            t := _ex(&cs, v[0])
            cs.line = l
            _vpush(&cs, name, t, false)
        ast.ReturnS(l, k):
            if len(k) == 1:
                t := _ex2(&cs, k[0], cs.ret)
                cs.line = l
                # src/tychoc.c:8521 runs AHEAD of the type comparison, so a proc
                # with no return type is told it returns nothing rather than
                # being handed a `returning int but proc returns void`.
                if cs.ret == "void":
                    _cerr(&cs, "this proc returns nothing")
                elif not compat(t, cs.ret):
                    _cerr(&cs, "returning " + _show(&cs, t) + " but proc returns " + _show(&cs, cs.ret))
            elif known(cs.ret) and cs.ret != "void":
                cs.line = l
                _cerr(&cs, "missing return value (proc returns " + cs.ret + ")")
        # src/tychoc.c:12381-12384. cs.loopd was already maintained by every loop
        # arm below and read by nothing.
        ast.BreakS(l):
            if cs.loopd == 0:
                cs.line = l
                _cerr(&cs, "'break' outside a loop")
        ast.ContinueS(l):
            if cs.loopd == 0:
                cs.line = l
                _cerr(&cs, "'continue' outside a loop")
        ast.DeleteS(l, k): _exs(&cs, k)
        ast.IfS(l, c, b, e):
            t := _ex(&cs, c[0])
            cs.line = l
            if known(t) and t != "bool":
                _cerr(&cs, "if condition must be bool")
            _tblock(&cs, b)
            _tblock(&cs, e)
        ast.WhileS(l, c, b):
            cs.loopd = cs.loopd + 1
            if len(c) == 1:
                t := _ex(&cs, c[0])
                cs.line = l
                if known(t) and t != "bool":
                    _cerr(&cs, "for condition must be bool")
            _tblock(&cs, b)
            cs.loopd = cs.loopd - 1
        ast.For3(l, init, c, b):
            cs.loopd = cs.loopd + 1
            m := _vmark(&cs)
            for st in init:
                _tstmt(&cs, st)
            if len(c) == 1:
                t := _ex(&cs, c[0])
                cs.line = l
                if known(t) and t != "bool":
                    _cerr(&cs, "for condition must be bool")
            _tblock(&cs, b)
            _vrestore(&cs, m)
            cs.loopd = cs.loopd - 1
        ast.ForIn(l, v, coll, b, par):
            cs.loopd = cs.loopd + 1
            ct := _base(&cs, _ex(&cs, coll[0]))
            cs.line = l
            et := "?"
            h := _head(ct)
            if par:
                # src/tychoc.c:8040 -- the parallel form lifts the body over the
                # source, so its set is narrower than the sequential one: an
                # array, a string or a channel, and NOT bytes, a map or a soa.
                if h == "chan":
                    et = _targs(ct)[0]
                elif _is_arr(ct):
                    et = _elem_of(&cs, ct)
                elif ct == "string":
                    et = "int"
                elif known(ct):
                    _cerr(&cs, "parallel for expects an array, string, or channel")
            elif h == "map":
                _cerr(&cs, "a map is not directly iterable -- `for k in m` indexes it by position. Loop over `keys(m)` instead: `for k in keys(m):` (the keys come back as " + _show(&cs, _targs(ct)[0]) + ", wrapped)")
            elif _is_arr(ct) or h == "soa":
                et = _elem_of(&cs, ct)
            elif ct == "string" or ct == "bytes":
                et = "int"
            elif h == "chan":
                et = _targs(ct)[0]
            elif known(ct):
                # The sequential form desugars to `len(...)`, so that is the
                # rule that owns the refusal (src/tychoc.c:6949).
                _cerr(&cs, "len(...) takes an array, a string, bytes, a map, or a soa")
            m := _vmark(&cs)
            _tnote(&cs, "i:" + et)
            _vpush(&cs, v, et, true)
            _tblock(&cs, b)
            _vrestore(&cs, m)
            cs.loopd = cs.loopd - 1
        ast.ForRange(l, v, bounds, b):
            # src/tychoc.c:8043 checks the range BEFORE scanning the body, and
            # takes the type as written: a sized int and a newtype over int are
            # both refused, so this compares the raw type, not `_base`.
            for x in bounds:
                bt := _ex(&cs, x)
                cs.line = l
                if known(bt) and bt != "int":
                    _cerr(&cs, "parallel for needs an int range")
            _parfor_check(&cs, l, v, b)
            cs.loopd = cs.loopd + 1
            m := _vmark(&cs)
            cs.line = l
            _vpush(&cs, v, "int", false)
            _tblock(&cs, b)
            _vrestore(&cs, m)
            cs.loopd = cs.loopd - 1
        ast.ParallelS(l, w, b):
            _exs(&cs, w)
            for st in b:
                _tstmt(&cs, st)
        ast.MatchS(l, subj, arms): _match(&cs, l, subj, arms)
        ast.SelectS(l, arms):
            nrecv := 0
            ndef := 0
            nclosed := 0
            for a in arms:
                m := _vmark(&cs)
                if a.kind == "recv":
                    nrecv += 1
                    ct := "?"
                    if len(a.ch) > 0:
                        ct = _base(&cs, _ex(&cs, a.ch[0]))
                    if known(ct) and _head(ct) != "chan":
                        cs.line = a.line
                        _cerr(&cs, "select recv needs a channel, got " + _show(&cs, ct))
                elif a.kind == "default":
                    ndef += 1
                    _exs(&cs, a.ch)
                else:
                    nclosed += 1
                    _exs(&cs, a.ch)
                for bnd in a.binds:
                    _vpush(&cs, bnd, "?", true)
                _tblock(&cs, a.body)
                _vrestore(&cs, m)
            cs.line = l
            if nrecv == 0:
                _cerr(&cs, "select needs at least one recv arm")
            if ndef > 1 or nclosed > 1:
                _cerr(&cs, "select takes at most one default and one closed arm")
        _: pass

fn _assign_check(cs: inout C, name: string, t: string):
    vt := _vtype(&cs, name)
    if len(vt) == 0:
        return
    # src/tychoc.c:5918 and :5890 -- a bare `[]` or `None` decl is PENDING and
    # its first typed use grounds it; only an array/map/soa grounds the first,
    # only an Option the second. tcheck types the bare `[]` "?" and the bare
    # `None` "opt(?)", so without these two the family is accepted (`[]`) or
    # refused by the generic assign rule under other wording (`None`).
    if _pend_find(&cs, name) >= 0:                 # src/tychoc.c:8509
        _pend_ground(&cs, name, t, cs.line)
        return
    if vt == "opt(?)" and known(t) and _head(t) != "opt":
        _cerr(&cs, "'" + name + "' was declared with None but its first use makes it " + _show(&cs, t))
        return
    if not compat(vt, t):
        _cerr(&cs, "cannot assign " + t + " to '" + name + "' of type " + vt)

# ---------------------------------------------------------------- the pass

fn _fill_decls(cs: inout C, p: Program):
    for f in p.files:
        cs.file = f.path
        cs.prefix = f.prefix
        cs.imports = f.unit.imports
        for d in _sorted_decls(f.unit):
            if d.cat == 1:
                sd := f.unit.structs[d.idx]
                _typarams_of(&cs, sd.typarams)
                cs.skip = len(sd.typarams) > 0
                fn_ := []string
                ft := []string
                for fl in sd.fields:
                    cs.line = fl.line
                    push(fn_, fl.name)
                    fty := _enc(&cs, fl.ty)
                    push(ft, fty)
                    _field_aff(&cs, sd.line, fty)
                    if sd.packed and not _packed_ok(&cs, fty):
                        cs.line = fl.line
                        _cperr(&cs, "field '" + fl.name + "' of a packed struct must be a fixed-width value type")
                    if _has_sizeparam(fl.ty):
                        cs.line = sd.line
                        _cperr(&cs, "a struct field cannot be a `[$N]T` size-parameterized array -- use a fixed `[N]T` or a dynamic `[T]`")
                i := cs.tindex[f.prefix + sd.name]
                cs.tds[i].fnames = fn_
                cs.tds[i].ftypes = ft
            elif d.cat == 2:
                ed := f.unit.enums[d.idx]
                _typarams_of(&cs, ed.typarams)
                cs.skip = len(ed.typarams) > 0
                vn := []string
                vt := []string
                for v in ed.variants:
                    cs.line = v.line
                    pay := ""
                    for k := 0; k < len(v.payload); k += 1:
                        if k > 0:
                            pay = pay + "|"
                        pt_ := _enc(&cs, v.payload[k])
                        pay = pay + pt_
                        if _head(pt_) == "chan":
                            cs.line = ed.line
                            _cperr(&cs, "an enum payload cannot be a channel")
                        if _has_sizeparam(v.payload[k]):
                            cs.line = ed.line
                            _cperr(&cs, "an enum payload cannot be a `[$N]T` size-parameterized array -- use a fixed `[N]T` or a dynamic `[T]`")
                        cs.line = v.line
                    push(vn, v.name)
                    push(vt, pay)
                    cs.vpay[f.prefix + v.name] = pay
                i := cs.tindex[f.prefix + ed.name]
                cs.tds[i].fnames = vn
                cs.tds[i].ftypes = vt
            elif d.cat == 3:
                nd := f.unit.newtypes[d.idx]
                cs.line = nd.line
                cs.skip = false
                u := []string
                ut := _enc(&cs, nd.under)
                push(u, ut)
                if _has_sizeparam(nd.under):
                    _cperr(&cs, "a newtype cannot wrap a `[$N]T` size-parameterized array")
                else:
                    _newtype_check(&cs, ut)
                i := cs.tindex[f.prefix + nd.name]
                cs.tds[i].ftypes = u
            elif d.cat == 5:
                cd := f.unit.consts[d.idx]
                cs.line = cd.line
                cs.skip = false
                cs.consts[f.prefix + cd.name] = _ex(&cs, cd.value)
                match cd.value:
                    ast.IntLit(cl, cv): cs.constv[f.prefix + cd.name] = cv
                    ast.CharLit(cl, cv): cs.constv[f.prefix + cd.name] = cv
                    _: pass
            elif d.cat == 6:
                sb := f.unit.subscripts[d.idx]
                cs.subs[sb.name] = true
                cs.line = sb.line
                if len(sb.params) > 0 and len(sb.params[0].ty) == 1 and _ty_generic_inst(&cs, sb.params[0].ty[0]):
                    _cperr(&cs, "a subscript receiver may not be generic ('" + _ty_inst_spell(sb.params[0].ty[0]) + "'): declare the subscript on a concrete instance")
                _typarams_of(&cs, []string)
                cs.skip = false
                rt2 := _enc(&cs, sb.ret)
                mk2 := _vmark(&cs)
                for pm in sb.params:
                    for tt in pm.ty:
                        _vpush(&cs, pm.name, _enc(&cs, tt), true)
                kia := cs.in_arg
                cs.in_arg = true       # the yielded place is written `&expr`
                pt2 := _place_ty(&cs, sb.place)
                cs.in_arg = kia
                _vrestore(&cs, mk2)
                cs.line = sb.line
                if known(rt2) and known(pt2) and not compat(rt2, pt2):
                    _cperr(&cs, "subscript '" + sb.name + "' is declared `-> inout " + rt2 + "` but yields a place of type " + pt2)
                cs.skip = true
            else:
                # NOT `fd := f.unit.fns[d.idx]` -- binding the element deep-copies
                # the whole Fn, body and all, once per declaration in the program.
                cs.skip = len(f.unit.fns[d.idx].typarams) > 0
                _addsig(&cs, _sig_of(&cs, f.prefix, f.unit.fns[d.idx]))
                cs.line = f.unit.fns[d.idx].line
                if len(f.unit.fns[d.idx].params) > 16 and len(f.unit.fns[d.idx].typarams) == 0 and
                        len(_sig_sizeparams(f.unit.fns[d.idx].params, f.unit.fns[d.idx].ret)) == 0:
                    _cerr(&cs, "too many parameters (max 16)")
                if len(_dedup6(f.unit.fns[d.idx].typarams)) > 16:
                    _cperr(&cs, "too many type parameters (max 16)")
                if len(_sig_sizeparams(f.unit.fns[d.idx].params, f.unit.fns[d.idx].ret)) > 16:
                    _cperr(&cs, "too many size parameters (max 16)")
            cs.skip = false
            _typarams_of(&cs, []string)

# src/tychoc.c@check_finite_types -- a THREE-COLOUR DFS over the emit type
# graph, rooted at every struct in declaration order. A type that contains
# itself by value has no size; an array or a map breaks the cycle, a tuple, an
# inline array, an Option and a Result do not (src/tychoc.c:12843 emits
# `struct TychoOpt%d_ { char has; T val; }` and :12826 the Result twin).
# Which arm fires is decided by which GREY node the walk re-enters, so the
# Option, Result or tuple that closes a cycle names ITSELF
# (src/tychoc.c:12837, src/tychoc.c:12848, src/tychoc.c:12864). Walking struct
# DECLARATIONS alone, as this did until 2026-09-04, could only ever reach the
# struct arm (src/tychoc.c:12815).
# The line reported is the declaration whose fields were being walked when the
# cycle closed -- g_emit_line, saved and restored per struct at :12789/:12794.
fn _fin_dfs(cs: inout C, t0: string, ln: int, fl: string, col: inout [string: int]) -> bool:
    t := _base(&cs, t0)
    h := _head(t)
    a := _targs(t)
    if h == "fix" or h == "bnd":
        if len(a) != 2:
            return false
        if col.get(t, 0) == 2:
            return false
        if col.get(t, 0) == 1:
            cs.file = fl
            cs.line = ln
            _cerr(&cs, "infinite type: " + _show(&cs, t) + " contains itself by value — use a dynamic array ([" + _show(&cs, a[1]) + "]) for indirection")
            return true
        col[t] = 1
        if _fin_dfs(&cs, a[1], ln, fl, &col):
            return true
        col[t] = 2
        return false
    if h == "opt" or h == "res" or h == "tup":
        if len(a) == 0:
            return false
        if col.get(t, 0) == 2:
            return false
        if col.get(t, 0) == 1:
            cs.file = fl
            cs.line = ln
            if h == "opt":
                _cerr(&cs, "infinite type: an Option contains itself by value — use Option([T]) for indirection")
            elif h == "res":
                _cerr(&cs, "infinite type: a Result contains itself by value — use indirection (e.g. Result([T], E))")
            else:
                _cerr(&cs, "infinite type: a tuple contains itself by value")
            return true
        col[t] = 1
        for arg in a:
            if _fin_dfs(&cs, arg, ln, fl, &col):
                return true
        col[t] = 2
        return false
    i := _tdecl(&cs, t)
    if i < 0:
        return false
    # read in place: this is a whole declaration, and only three fields are wanted
    if cs.tds[i].kind != "struct" or cs.tds[i].generic:
        return false
    if col.get(t, 0) == 2:
        return false
    if col.get(t, 0) == 1:
        cs.file = fl
        cs.line = ln
        _cerr(&cs, "infinite type: " + cs.tds[i].name + " contains itself by value — use an array ([" + cs.tds[i].name + "]) or Option([" + cs.tds[i].name + "]) for indirection")
        return true
    fts := cs.tds[i].ftypes
    dl := cs.tds[i].line
    df := cs.tds[i].file
    col[t] = 1
    for ft in fts:
        if _fin_dfs(&cs, ft, dl, df, &col):
            return true
    col[t] = 2
    return false

fn _infinite_check(cs: inout C):
    col := []string: int
    for i := 0; i < len(cs.tds); i += 1:
        # read in place: this is a whole declaration, and only the name is wanted
        if cs.tds[i].kind != "struct" or cs.tds[i].generic:
            continue
        if _fin_dfs(&cs, "@" + cs.tds[i].name, cs.tds[i].line, cs.tds[i].file, &col):
            return

# --symbols wants the INFERRED type of every local, which only the checker
# knows. Same walk as check(), with the recording switched on.
fn check_syms(p: Program) -> [string]:
    cs := check_on(p, true)
    return cs.symrows

fn check(p: Program) -> C:
    return check_on(p, false)

fn check_on(p: Program, syms: bool) -> C:
    cs := C([]string, -1, []string: bool, []string: bool, 0, []string, []string, []TDecl, []string: int, []FSig, []string: int, []string: string, []string: string, []string: string, []string: int, []string: bool, []string: string, []string: bool, []VBind, 0, []string, []string, []string: int, "", 0, "", "?", false, false, []ast.ImportD, []ast.ImportD, false, 0, 0, false, 0, []string: int, []string: bool, []string: bool, 0, 0, false, []string, []string, false, 0, false, "", []string: bool, []string: bool, []Pend, 0, "", []Tail, 0, 0)
    cs.symon = syms
    for f in p.files:
        push(cs.srcp, f.path)
        push(cs.srct, f.src)
        for im in f.unit.imports:
            push(cs.all_imports, im)
    _builtin_sigs_t(&cs)
    _register(&cs, p)
    cs.ntd0 = len(cs.tds)
    _fill_decls(&cs, p)
    _infinite_check(&cs)
    for f in p.files:
        cs.file = f.path
        cs.prefix = f.prefix
        cs.imports = f.unit.imports
        for fd in f.unit.fns:
            if fd.is_extern or len(fd.typarams) > 0:
                continue
            si := _sigidx(&cs, f.prefix + fd.name)
            if si < 0:
                continue
            cs.line = fd.line
            cs.symfn = fd.line
            cs.symfnm = f.prefix + fd.name
            cs.ment = _mentions(fd.body)
            cs.sinkp = []string: bool
            cs.parms = []string: bool
            cs.loopd = 0
            for pm in fd.params:
                cs.parms[pm.name] = true
                if pm.is_sink:
                    cs.sinkp[pm.name] = true
            m := _vmark(&cs)
            for i := 0; i < len(fd.params); i += 1:
                t := cs.sg[si].ptypes[i]
                if cs.sg[si].pflags[i] == "var":
                    t = "arr(" + t + ")"
                _tnote(&cs, "p:" + t)
                _vpush(&cs, fd.params[i].name, t, false)
            cs.ret = cs.sg[si].ret
            _tnote(&cs, "r:" + cs.ret)
            cs.paramset = []string: bool
            for pnm in cs.sg[si].pnames:
                cs.paramset[pnm] = true
            cs.npend = 0
            cs.pendok = ""
            cs.mbind = []string: bool
            cs.errbase = len(cs.errs)
            _tblock(&cs, fd.body)
            cs.errbase = -1
            _vrestore(&cs, m)
            cs.ret = "?"
    # `main`: src/tychoc.c:9432 and :9313, a whole-program rule like `no 'main'`.
    mi := _sigidx(&cs, "main")
    if mi >= 0:
        cs.file = cs.sg[mi].file
        cs.line = cs.sg[mi].line
        if len(cs.sg[mi].ptypes) > 0:
            _cerr(&cs, "'main' takes no parameters -- the command line arrives through the `args()` builtin")
        r := cs.sg[mi].ret
        if r != "void" and r != "res(void,string)" and known(r):
            _cerr(&cs, "'main' returns nothing or Result(void, string), not " + _show(&cs, r) +
                " -- an Err reaching the entry point is printed, so the error type is the message." +
                " For a status other than 0 or 1 (diff(1)'s 0/1/2, say), call the `exit(code)` builtin")
    for e in cs.errs:
        push(cs.perrs, e)
    cs.errs = cs.perrs
    return cs

fn check_errs(cs: C) -> [string]:
    return cs.errs

fn check_warns(cs: C) -> [string]:
    return cs.cwarns

fn check_census(cs: C) -> [string]:
    names := keys(cs.counts)
    names = sort.asc(names)
    out := []string
    for n in names:
        push(out, n + " " + str(cs.counts[n]))
    return out

# A type NAME carrying arguments is a generic instance -- of a declared generic,
# or of nothing at all, which is `unknown type` exactly as the bare form is.
fn _known_generic(cs: inout C, q: string, n: string) -> bool:
    if len(q) > 0:
        return (_prefix_of(&cs, q) + n) in cs.tindex
    if len(cs.prefix) > 0 and (cs.prefix + n) in cs.tindex:
        return true
    return (n in cs.tindex) or (n in cs.typarams)

fn _spawn_callee(e: ast.Expr) -> string:
    match e:
        ast.Call(l, q, n, ts, a): return n
        _: return "?"
    return "?"

fn _spawn_extern(cs: inout C, e: ast.Expr) -> bool:
    match e:
        ast.Call(l, q, n, ts, a): return len(q) == 0 and (n in cs.extfn)
        _: return false
    return false

fn _has_inout(s: FSig) -> bool:
    for f in s.pflags:
        if f == "inout":
            return true
    return false

fn _shape_builtin(n: string) -> bool:
    if n == "len" or n == "push" or n == "pop" or n == "keys" or n == "reserve":
        return true
    return n == "str" or n == "hash" or n == "to_under" or len(_sized_conv(n)) > 0

# One side of an Option/Result match, when its arms REFINED the payload: every
# variant of the payload enum must appear, and the diagnostic names the missing
# one rather than the side.
fn _side_cov(cs: inout C, l: int, pay: string, cov: [string: bool], refined: bool):
    if not refined:
        return
    ti := _tdecl(&cs, _base(&cs, pay))
    if ti < 0 or cs.tds[ti].kind != "enum":
        return
    for v in cs.tds[ti].fnames:
        if not (v in cov):
            cs.line = l
            _cerr(&cs, "non-exhaustive match: missing variant " + _vq(cs.tds[ti].name, v) + " of " + _show(&cs, "@" + cs.tds[ti].name))
            return

# The nested variant an Option/Result arm refines, or "". `Err(Sized(n, why))`
# parses as a `sub`; `Err(Nope)` -- a NULLARY variant -- parses as a single
# BINDING, and src/tychoc.c@match_arm_payload promotes it the same way. Reading
# only the first form reported six accepted files as non-exhaustive.
fn _nested_of(cs: inout C, a: ast.Arm, pay: string) -> string:
    if len(a.sub) > 0:
        return a.sub
    if len(a.binds) != 1:
        return ""
    ti := _tdecl(&cs, _base(&cs, pay))
    if ti < 0 or cs.tds[ti].kind != "enum":
        return ""
    for v in cs.tds[ti].fnames:
        if v == a.binds[0]:
            return v
    return ""

# Does this PROGRAM use anything Phase 6b owns -- a generic, a newtype, a handle
# or a `bounded`? Every such construct is answered `?` here, so the number of
# files this is true of is the size of what 6a defers, and it is printed by
# `--typecheck` rather than left implicit. Phase 6b watches it fall.
fn check_uses6b(cs: C) -> bool:
    return cs.uses6b
