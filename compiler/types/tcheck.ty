package types

import "core:sort"
import "../ast"

# The monomorphic type checker -- src/tychoc.c's type-resolve section
# (src/tychoc.c:5716-9350) for the non-generic language, plus the type rules
# parse_type enforces while a declaration is read (src/tychoc.c:2378-2632).
#
# THE ONE INVARIANT THAT MATTERS. A type is a STRING and `?` is UNKNOWN.
# Every rule below fires only when the types it compares are KNOWN; anything
# this pass cannot work out -- a generic instantiation, a UFCS method, a
# newtype's underlying operations, a value crossing a `$T` -- is `?`, and `?` is
# compatible with everything. So this pass can only ever accept MORE than
# src/tychoc.c, never less, which is exactly what compiler/run.sh's leg2c and
# leg6 measure: `wrongly-rejected=0` over 1,078 real files is the expensive
# property, not the new refusals.
#
# Encoding: `int` `float` `bool` `string` `bytes` `ptr` `char` `void` `u8`..`f32`
#   arr(T) fix(N,T) bnd(N,T) map(K,V) tup(A,B) fun(R,P...) soa(S)
#   opt(T) res(T,E) chan(T) task @Name(mangled struct/enum/newtype/handle) ?
# `@` prefixes a declared name so a struct called `arr` cannot collide with the
# array constructor.

fn _head(q: string) -> string:
    for i := 0; i < len(q); i += 1:
        if q[i] == 40:
            return q[0:i]
    return q

fn _targs(q: string) -> [string]:
    out := []string
    depth := 0
    start := 0
    for j := 0; j < len(q); j += 1:
        c := q[j]
        if c == 40:
            depth += 1
            if depth == 1:
                start = j + 1
        elif c == 41:
            depth -= 1
            if depth == 0:
                push(out, q[start:j])
                return out
        elif c == 44 and depth == 1:
            push(out, q[start:j])
            start = j + 1
    return out



fn known(t: string) -> bool:
    return find(t, "?") < 0

fn compat(a: string, b: string) -> bool:
    if a == "?" or b == "?" or a == b:
        return true
    ha := _head(a)
    hb := _head(b)
    if ha != hb:
        return false
    aa := _targs(a)
    bb := _targs(b)
    if len(aa) != len(bb) or len(aa) == 0:
        return false
    for i := 0; i < len(aa); i += 1:
        if not compat(aa[i], bb[i]):
            return false
    return true

fn _is_arr(t: string) -> bool:
    h := _head(t)
    return h == "arr" or h == "fix" or h == "bnd"

fn _is_int(t: string) -> bool:
    return t == "int" or t == "u8" or t == "u16" or t == "u32" or t == "u64" or
        t == "i8" or t == "i16" or t == "i32" or t == "i64"

fn _is_num(t: string) -> bool:
    return _is_int(t) or t == "float" or t == "f32"


# ---------------------------------------------------------------- the tables

struct TDecl:
    name: string                       # mangled, without the `@`
    kind: string                       # struct enum newtype handle
    generic: bool
    fnames: [string]                   # struct fields / enum variants
    ftypes: [string]                   # field type, or a variant's payload joined by "|"
    file: string
    line: int
    pats: [ast.Ty]                     # the field / payload types AS WRITTEN,
    pcnt: [int]                        # flattened, with a payload count per
    tps: [string]                      # variant -- what an INSTANCE substitutes
    pfx: string                        # into (Phase 6b)

struct FSig:
    name: string                       # mangled
    file: string
    line: int
    pnames: [string]
    ptypes: [string]
    pflags: [string]                   # "inout" "sink" "var" ""
    ret: string
    generic: bool
    builtin: bool
    pty: [ast.Ty]                      # the parameter types AS WRITTEN -- a `$T`
    rty: [ast.Ty]                      # pattern is what a call unifies against,
    tps: [string]                      # and the encoded ptypes above have already
    whs: [string]                      # collapsed every one of them to `?`
    pfx: string                        # the package prefix its type NAMES resolve in
    szs: [string]                      # the `$N` size parameters, kept apart
    body: [ast.Stmt]                   # the TEMPLATE's body, checked per instance

struct VBind:
    name: string
    ty: string
    mutable: bool

struct C:
    cwarns: [string]                   # non-fatal, drained by the driver
    errbase: int                       # errs at the current proc's entry; -1 outside one
    paramset: [string: bool]           # the current proc's parameters, a borrow
    instd: [string: bool]              # (template, bindings) already body-checked
    instdepth: int                     # nesting guard for a recursive template
    srcp: [string]                     # file paths, parallel to srct
    srct: [string]                     # their source, for the diagnostic excerpt
    tds: [TDecl]
    tindex: [string: int]
    sg: [FSig]
    sindex: [string: int]
    vowner: [string: string]           # mangled variant -> "@Enum"
    vpay: [string: string]             # mangled variant -> payload joined by "|"
    consts: [string: string]           # mangled const -> type
    constv: [string: int]              # ... and its folded int value, for a match arm
    typarams: [string: bool]           # the type parameters in scope right now
    tbind: [string: string]            # $T -> the type it is BOUND to at this
                                       # instantiation; empty outside one
    subs: [string: bool]               # declared `subscript` names -- the only callable place
    vars: [VBind]
    nvars: int
    errs: [string]
    perrs: [string]
    counts: [string: int]
    file: string
    line: int
    prefix: string
    ret: string
    void_ok: bool
    skip: bool                         # inside a generic template: resolve nothing
    imports: [ast.ImportD]
    all_imports: [ast.ImportD]
    in_arg: bool
    lam_mark: int                      # the variable-stack mark at the innermost
                                       # closure's entry
    nlambda: int                       # depth inside a closure body: a channel
                                       # read from an enclosing scope here is a
                                       # CAPTURE (src/tychoc.c:5937)
    chan_decl: bool                    # this expression is the DIRECT rhs of a `:=`
    nmatch: int
    ment: [string: int]                # mentions of each name in the function
    sinkp: [string: bool]              # ... and which of its params are `sink`
    parms: [string: bool]              # ... and which names ARE parameters
    loopd: int                         # loop nesting depth
    ntd0: int                          # how many declared types there were before
                                       # the first generic INSTANCE was stamped
    uses6b: bool                       # a 6b construct this pass could NOT ground:
                                       # a generic call or aggregate left `?`, or
                                       # a bounded whose capacity is unknown.
                                       # Phase 6a counted every program that
                                       # DECLARED one, which no amount of work
                                       # could drive down -- 6b made the flag
                                       # mean what leg12's label always claimed

# The offending source line beneath the message, the shape every
# tests/diag/*.err golden pins. Same rule as resolve.ty@_excerpt.
    pfacc: [string]                    # reduction accumulators of the enclosing parallel for
    symrows: [string]                  # --symbols: one `local` row per declaration
    symon: bool                        # ...recorded only when --symbols asked for it
    symfn: int                         # the enclosing fn's line, the row's 4th field
    symfnm: string                     # ...and its MANGLED name: two files can put
                                       # two functions on the same line (cli__is_short
                                       # and main are both line 44 in tycho-stat), and
                                       # a line-keyed bucket merges them

fn _cexcerpt(cs: inout C, file: string, line: int) -> string:
    if line <= 0:
        return ""
    for i := 0; i < len(cs.srcp); i += 1:
        if cs.srcp[i] != file:
            continue
        ls := split(cs.srct[i], "\n")
        if line > len(ls):
            return ""
        num := str(line)
        pad := ""
        for k := len(num); k < 6; k += 1:
            pad = pad + " "
        return "\n" + pad + num + " | " + ls[line - 1]
    return ""

# Typo suggestions, same threshold as resolve.ty@_dym and the same source:
# src/tychoc.c:1469@edit_dist accepts the best candidate when
# bestd <= (strlen(name) <= 4 ? 1 : 2).
fn _tedit(a: string, b: string) -> int:
    la := len(a)
    lb := len(b)
    prev := []int
    for j := 0; j <= lb; j += 1:
        push(prev, j)
    for i := 1; i <= la; i += 1:
        cur := []int
        push(cur, i)
        for j := 1; j <= lb; j += 1:
            c := 1
            if a[i - 1] == b[j - 1]:
                c = 0
            v := prev[j - 1] + c
            if prev[j] + 1 < v:
                v = prev[j] + 1
            if cur[j - 1] + 1 < v:
                v = cur[j - 1] + 1
            push(cur, v)
        prev = cur
    return prev[lb]

fn _tdym(name: string, cands: [string]) -> string:
    best := ""
    bestd := 99
    for c in cands:
        if c == name:
            continue
        d := _tedit(name, c)
        if d < bestd:
            bestd = d
            best = c
    lim := 2
    if len(name) <= 4:
        lim = 1
    if bestd <= lim and len(best) > 0:
        return "; did you mean '" + best + "'?"
    return ""

fn _tycands(cs: inout C) -> [string]:
    out := []string
    for td in cs.tds:
        push(out, _short(td.name))
    return out

fn _cwarn(cs: inout C, msg: string):
    push(cs.cwarns, cs.file + ":" + str(cs.line) + ": warning: " + msg +
        _cexcerpt(&cs, cs.file, cs.line))

# A newtype is erased in lowering, so "is int, expected Cents" reads as a
# compiler quirk until you see that Cents IS an int, declared here
# (src/tychoc.c:7122). Emitted AFTER its error, which is the order ./tychoc
# flushes them in.
fn _cnote(cs: inout C, file: string, line: int, msg: string):
    push(cs.errs, file + ":" + str(line) + ": note: " + msg + _cexcerpt(&cs, file, line))

fn _nt_note(cs: inout C, a: string, b: string):
    for t in [b, a]:
        if len(t) > 1 and t[0] == 64 and (t[1:] in cs.tindex):
            d := cs.tds[cs.tindex[t[1:]]]
            if d.kind == "newtype" and d.line > 0 and len(d.ftypes) > 0:
                _cnote(&cs, d.file, d.line, "`" + _show(&cs, t) + "` is a distinct type over " +
                    _show(&cs, d.ftypes[0]) + ", declared here -- it does not accept its underlying type implicitly")
                return

# ONE error per STATEMENT. src/tychoc.c's die_at longjmps to a recovery point
# and the walk resumes at the next statement; collecting every error within one
# reports consequences of the first (`return "x" + 1` is both a bad
# concatenation and a bad return type).
fn _cerr(cs: inout C, msg: string):
    if cs.errbase >= 0 and len(cs.errs) > cs.errbase:
        return
    push(cs.errs, cs.file + ":" + str(cs.line) + ": error: " + msg +
        _cexcerpt(&cs, cs.file, cs.line))

# The type rules parse_type enforces run while the DECLARATION is read, so they
# precede every body diagnostic in the whole build -- the same split
# resolve.ty@_perr makes for the import leak, and for the same reason.
fn _cperr(cs: inout C, msg: string):
    push(cs.perrs, cs.file + ":" + str(cs.line) + ": error: " + msg +
        _cexcerpt(&cs, cs.file, cs.line))

fn _tnote(cs: inout C, key: string):
    cs.counts[key] = cs.counts.get(key, 0) + 1

fn _prefix_of(cs: inout C, q: string) -> string:
    for im in cs.all_imports:
        if len(im.alias) > 0 and im.alias == q:
            return pkg_basename(im.path) + "__"
    return q + "__"

# The declared type named `n` (already mangled), as an encoded type.
fn _named(cs: inout C, m: string) -> string:
    if m in cs.tindex:
        if cs.tds[cs.tindex[m]].generic:
            return "?"
        return "@" + m
    return ""

fn _lookup_type(cs: inout C, q: string, n: string) -> string:
    if len(q) > 0:
        return _named(&cs, _prefix_of(&cs, q) + n)
    if len(cs.prefix) > 0:
        r := _named(&cs, cs.prefix + n)
        if len(r) > 0:
            return r
    return _named(&cs, n)

# --- ast.Ty -> encoded type -------------------------------------------------
#
# Where src/tychoc.c dies, this dies too -- these are the parse_type rules, and
# they are TYPE-class in compiler/reject_class.tsv. Everything it cannot resolve
# (a type parameter, a generic instance) becomes `?`.
fn _enc(cs: inout C, t: ast.Ty) -> string:
    match t:
        ast.TPrim(p): return p
        ast.TParam(n):
            if n in cs.tbind:
                return cs.tbind[n]
            return "?"
        ast.TName(q, n, targs):
            if len(q) == 0 and n == "void":
                if not cs.void_ok:
                    _cperr(&cs, "'void' is a type only as a Result's ok payload, as in Result(void, string)")
                return "void"
            if len(q) == 0 and n == "Option":
                inner := _enc_noval(&cs, targs[0])
                if inner == "void":
                    _cperr(&cs, "Option(void) is not a type")
                _nest_aff(&cs, inner, "cont")
                return "opt(" + inner + ")"
            if len(q) == 0 and n == "Channel":
                inner := _enc_noval(&cs, targs[0])
                if inner == "void":
                    _cperr(&cs, "Channel(void) is not a type")
                _nest_aff(&cs, inner, "cont")
                return "chan(" + inner + ")"
            if len(q) == 0 and n == "Result":
                keep := cs.void_ok
                cs.void_ok = true
                ok := _enc(&cs, targs[0])
                cs.void_ok = keep
                er := _enc_noval(&cs, targs[1])
                _nest_aff(&cs, ok, "cont")
                _nest_aff(&cs, er, "cont")
                return "res(" + ok + "," + er + ")"
            if len(q) == 0 and (n in cs.tbind):
                return cs.tbind[n]
            if len(q) == 0 and (n in cs.typarams):
                return "?"
            r := _lookup_type(&cs, q, n)
            if len(targs) > 0:
                enc := []string
                for a in targs:
                    ea := _enc_noval(&cs, a)
                    _tnote(&cs, "targ:" + ea)
                    push(enc, ea)
                if len(r) == 0 and not cs.skip and not _known_generic(&cs, q, n):
                    _cperr(&cs, "unknown type '" + n + "'" + _tdym(n, _tycands(&cs)))
                return _inst_named(&cs, q, n, targs, enc)
            if len(r) == 0:
                if cs.skip:
                    return "?"
                _cperr(&cs, "unknown type '" + n + "'" + _tdym(n, _tycands(&cs)))
                return "?"
            return r
        ast.TArr(k):
            el := _enc_noval(&cs, k[0])
            if el == "void":
                _cperr(&cs, "an array element type cannot be void")
            _nest_aff(&cs, el, "cont")
            return "arr(" + el + ")"
        ast.TFix(sz, k):
            el := _enc_noval(&cs, k[0])
            if len(sz) > 0 and sz[0] == 36:
                return "?"             # `[$N]T` is a TEMPLATE pattern, not a type
            n := _fixsize(&cs, sz)
            if el == "bool" or el == "void":
                _cperr(&cs, "a fixed-size array element cannot be bool or void")
            _nest_aff(&cs, el, "cont")
            return "fix(" + n + "," + el + ")"
        ast.TBnd(sz, k):
            el := _enc_noval(&cs, k[0])
            n := _bnd_size(&cs, sz)
            if n == "?":
                cs.uses6b = true
            _bnd_elem(&cs, el)
            _nest_aff(&cs, el, "cont")
            return "bnd(" + n + "," + el + ")"
        ast.TMap(k):
            kt := _enc_noval(&cs, k[0])
            vt := _enc_noval(&cs, k[1])
            if not _mapkey_ok(&cs, kt):
                _cperr(&cs, "map keys must be string, int (directly or through a newtype), a fieldless enum, or a hashable struct/tuple/array")
            _nest_aff(&cs, vt, "cont")
            return "map(" + kt + "," + vt + ")"
        ast.TTup(k):
            out := "tup("
            for i := 0; i < len(k); i += 1:
                e := _enc_noval(&cs, k[i])
                if e == "void":
                    _cperr(&cs, "a tuple element cannot be void")
                _nest_aff(&cs, e, "cont")
                if i > 0:
                    out = out + ","
                out = out + e
            return out + ")"
        ast.TFn(hr, k):
            r := "void"
            np := len(k)
            if hr:
                np = len(k) - 1
                r = _enc_noval(&cs, k[len(k) - 1])
                _nest_aff(&cs, r, "fn")
            out := "fun(" + r
            for i := 0; i < np; i += 1:
                e := _enc_noval(&cs, k[i])
                if e == "void":
                    _cperr(&cs, "a function-type parameter cannot be void")
                _nest_aff(&cs, e, "fn")
                out = out + "," + e
            return out + ")"
        ast.TSoa(k):
            el := _enc_noval(&cs, k[0])
            return "soa(" + el + ")"
    return "?"

# Every nested position but Result's ok payload forbids `void`.
fn _enc_noval(cs: inout C, t: ast.Ty) -> string:
    keep := cs.void_ok
    cs.void_ok = false
    r := _enc(&cs, t)
    cs.void_ok = keep
    return r

# `[N]T` / `bounded[N]T`: a literal, or an int `const`. src/tychoc.c:2487.
# A fixed size is compared as TEXT, so `[0xA]int` and `[10]int` must normalise
# to the same thing or a legal program is refused (tests/int_hex.ty:17).
fn _dec(sz: string) -> string:
    base := 10
    i := 0
    if len(sz) > 2 and sz[0] == 48 and (sz[1] == 120 or sz[1] == 88):
        base = 16
        i = 2
    elif len(sz) > 2 and sz[0] == 48 and (sz[1] == 98 or sz[1] == 66):
        base = 2
        i = 2
    v := 0
    for i < len(sz):
        c := sz[i]
        d := -1
        if c >= 48 and c <= 57:
            d = c - 48
        elif c >= 97 and c <= 102:
            d = c - 87
        elif c >= 65 and c <= 70:
            d = c - 55
        elif c == 95:
            i += 1
            continue
        if d < 0 or d >= base:
            return "?"
        v = v * base + d
        i += 1
    return str(v)

fn _fixsize(cs: inout C, sz: string) -> string:
    if len(sz) == 0:
        return "?"
    if sz[0] == 36:
        return "?"
    if sz[0] >= 48 and sz[0] <= 57:
        return _dec(sz)
    if cs.skip:
        return "?"
    if len(cs.prefix) > 0 and (cs.prefix + sz) in cs.consts:
        return "?"
    if sz in cs.consts:
        return "?"
    _cperr(&cs, "a fixed-size array length must be an integer literal or an int `const` -- '" + sz + "' is not")
    return "?"

fn _mapkey_ok(cs: inout C, k: string) -> bool:
    if k == "?":
        return true
    if k == "string" or _is_int(k):
        return true
    h := _head(k)
    if h == "tup" or h == "arr" or h == "fix":
        for a in _targs(k):
            if not _mapkey_ok(&cs, a):
                return false
        return true
    if len(k) > 1 and k[0] == 64:
        m := k[1:]
        if m in cs.tindex:
            d := cs.tds[cs.tindex[m]]
            if d.kind == "newtype":
                return _mapkey_ok(&cs, d.ftypes[0])
            if d.kind == "enum":
                for p in d.ftypes:
                    if len(p) > 0:
                        return false
                return true
            if d.kind == "struct":
                for ft in d.ftypes:
                    if not _mapkey_ok(&cs, ft):
                        return false
                return true
        return false
    return false

# ---------------------------------------------------------------- the context
#
# Two passes over the declarations, for the reason src/tychoc.c pre-scans: a
# struct field may name a type declared LATER in the same file (`[B]` above
# `struct B`), which ./tychoc accepts -- measured 2026-08-23. So every NAME is
# registered first and only then is any type encoded.

struct DRef:
    line: int
    cat: int                           # 1 struct 2 enum 3 newtype 4 handle 5 const 6 subscript 7 fn
    idx: int

fn _sorted_decls(u: ast.Unit) -> [DRef]:
    ds := []DRef
    for k := 0; k < len(u.structs); k += 1:
        push(ds, DRef(u.structs[k].line, 1, k))
    for k := 0; k < len(u.enums); k += 1:
        push(ds, DRef(u.enums[k].line, 2, k))
    for k := 0; k < len(u.newtypes); k += 1:
        push(ds, DRef(u.newtypes[k].line, 3, k))
    for k := 0; k < len(u.handles); k += 1:
        push(ds, DRef(u.handles[k].line, 4, k))
    for k := 0; k < len(u.consts); k += 1:
        push(ds, DRef(u.consts[k].line, 5, k))
    for k := 0; k < len(u.subscripts); k += 1:
        push(ds, DRef(u.subscripts[k].line, 6, k))
    for k := 0; k < len(u.fns); k += 1:
        push(ds, DRef(u.fns[k].line, 7, k))
    for a := 0; a < len(ds); a += 1:
        b := a
        for c := a + 1; c < len(ds); c += 1:
            if ds[c].line < ds[b].line:
                b = c
        tmp := ds[a]
        ds[a] = ds[b]
        ds[b] = tmp
    return ds

fn _addt(cs: inout C, name: string, kind: string, generic: bool, file: string, line: int):
    # `pats`/`tps`/`pfx` are filled by _fill_decls; an INSTANCE is stamped by
    # zsema.ty@_inst_agg and carries none of them.
    if name in cs.tindex:
        return
    cs.tindex[name] = len(cs.tds)
    push(cs.tds, TDecl(name, kind, generic, []string, []string, file, line, []ast.Ty, []int, []string, ""))

fn _typarams_of(cs: inout C, names: [string]):
    cs.typarams = []string: bool
    for n in names:
        cs.typarams[n] = true

# src/tychoc.c@die_not_variant: a variant of ANOTHER package's enum written
# bare. Returns "" when the spelling is fine, else the whole message.
fn _foreign_variant(cs: inout C, tdname: string, qual: string, v: string) -> string:
    if len(qual) > 0:
        return ""
    # Only a PACKAGE prefix counts. A generic instance is `Cell$@lib__Cause`,
    # whose `__` is inside the type ARGUMENT and names no package of the enum.
    head := tdname
    for i := 0; i < len(tdname); i += 1:
        if tdname[i] == 36 or tdname[i] == 64:
            head = tdname[0:i]
            break
    us := -1
    for i := 0; i + 1 < len(head); i += 1:
        if head[i] == 95 and head[i + 1] == 95:
            us = i
            break
    if us < 0:
        return ""
    pkg := head[0:us]
    if cs.prefix == pkg + "__":
        return ""                      # the enum's own package writes it bare
    return "'" + v + "' is a variant of " + _show(&cs, "@" + tdname) +
        ", but a variant of another package's enum must be written qualified -- write '" +
        pkg + "." + v + "'"

fn _register(cs: inout C, p: Program):
    for f in p.files:
        for sd in f.unit.structs:
            _addt(&cs, f.prefix + sd.name, "struct", len(sd.typarams) > 0, f.path, sd.line)
            si2 := cs.tindex[f.prefix + sd.name]
            for fl in sd.fields:
                push(cs.tds[si2].fnames, fl.name)
            cs.tds[si2].tps = sd.typarams
            cs.tds[si2].pfx = f.prefix
            for fl in sd.fields:
                push(cs.tds[si2].pats, fl.ty)
                push(cs.tds[si2].pcnt, 1)
        for ed in f.unit.enums:
            _addt(&cs, f.prefix + ed.name, "enum", len(ed.typarams) > 0, f.path, ed.line)
            ei2 := cs.tindex[f.prefix + ed.name]
            cs.tds[ei2].tps = ed.typarams
            cs.tds[ei2].pfx = f.prefix
            for v2 in ed.variants:
                push(cs.tds[ei2].pcnt, len(v2.payload))
                for py2 in v2.payload:
                    push(cs.tds[ei2].pats, py2)
            for v in ed.variants:
                cs.vowner[f.prefix + v.name] = "@" + f.prefix + ed.name
        for nd in f.unit.newtypes:
            _addt(&cs, f.prefix + nd.name, "newtype", false, f.path, nd.line)
        for hd in f.unit.handles:
            _addt(&cs, f.prefix + hd.name, "handle", false, f.path, hd.line)

# The signature of one fn, as src/tychoc.c's Sig. A generic fn's signature is
# recorded but never CHECKED against a call: monomorphisation is Phase 6b, so
# every call to one yields `?`.
fn _sig_of(cs: inout C, prefix: string, fd: ast.Fn) -> FSig:
    _typarams_of(&cs, fd.typarams)
    for pm in fd.params:
        for tt in pm.ty:
            for sp in _sizeparams_ty(tt, []string):
                cs.typarams[sp] = true
    pn := []string
    pt := []string
    pf := []string
    for pm in fd.params:
        cs.line = pm.line
        t := "?"
        if len(pm.ty) == 1:
            t = _enc(&cs, pm.ty[0])
        push(pn, pm.name)
        push(pt, t)
        fl := ""
        if pm.is_inout:
            fl = "inout"
            if _head(t) == "fun":
                _cerr(&cs, "inout parameter '" + pm.name + "': a function value can't be inout (a callee could write a closure back into the caller and it would dangle)")
        elif pm.is_sink:
            fl = "sink"
        if pm.is_variadic:
            fl = "var"
        _aff_param_check(&cs, pm.name, t, fl)
        if fd.is_extern and not pm.is_inout and not _ffi_param_ok(&cs, t):
            _cperr(&cs, "extern fn '" + fd.name + "': parameter '" + pm.name + "' must be int/char/float/bool/string/ptr/bytes, [int]/[float]/[string], or a handle (no other composites across the C boundary)")
        push(pf, fl)
    cs.line = fd.line
    rt := "void"
    if len(fd.ret) == 1:
        keep := cs.void_ok
        cs.void_ok = false
        rt = _enc(&cs, fd.ret[0])
        cs.void_ok = keep
    if fd.is_extern and not _ffi_ret_ok(&cs, rt):
        _cperr(&cs, "extern fn '" + fd.name + "': return type must be int/char/float/bool/string/ptr/bytes, [int]/[float], Option(string), a handle, or omitted")
    if _head(rt) == "chan":
        _cperr(&cs, "a function cannot return a channel -- create it in the owning scope and pass it down")
    # An `extern fn` opener is the only producer: its return is where a handle
    # enters the program. A Tycho fn returning one hands out a second owner of
    # a pointer its own scope exit already freed.
    if not fd.is_extern and _aff_kind(&cs, rt) == "handle":
        _cperr(&cs, "a Tycho fn cannot return a handle -- only an `extern fn` opener may, because a handle is freed at the end of its scope")
    nm := prefix + fd.name
    if fd.is_extern:
        nm = fd.name
    cs.typarams = []string: bool
    szs := _sig_sizeparams(fd.params, fd.ret)
    tps := []string                    # the parser lists a `$T` once per mention
    for tn in fd.typarams:             # (`fn singleton(x: $V) -> [$V]` twice);
        if not _has_name6(tps, tn):    # an explicit type-arg COUNT needs the
            push(tps, tn)              # DISTINCT parameters
    pats := []ast.Ty
    for pm in fd.params:
        if len(pm.ty) == 1:
            push(pats, pm.ty[0])
        else:
            push(pats, ast.TPrim("?"))
    gen := len(tps) > 0 or len(szs) > 0
    # Only a TEMPLATE's body is ever read (_inst_body, reached solely from
    # _generic_call2 behind an `sg[si].generic` guard), so a non-generic sig
    # carried a whole function body through two deep copies for nothing.
    bd := []ast.Stmt
    if gen:
        bd = fd.body
    return FSig(nm, cs.file, fd.line, pn, pt, pf, rt,
                gen, false,
                pats, fd.ret, tps, fd.wheres, prefix, szs, bd)

fn _addsig(cs: inout C, s: FSig):
    if s.name in cs.sindex:
        return
    cs.sindex[s.name] = len(cs.sg)
    push(cs.sg, s)

fn _bsig(cs: inout C, name: string, ret: string, ps: [string]):
    pn := []string
    pf := []string
    for i := 0; i < len(ps); i += 1:
        push(pn, "x")
        push(pf, "")
    _addsig(&cs, FSig(name, "", 0, pn, ps, pf, ret, false, true, []ast.Ty, []ast.Ty, []string, []string, "", []string, []ast.Stmt))

# src/tychoc.c@register_builtins, verbatim: the fixed-signature table, and ONLY
# that table. The shape-directed builtins (len/push/keys/str/to_*/...) bypass it
# and are checked one by one in _call_builtin.
fn _builtin_sigs_t(cs: inout C):
    _bsig(&cs, "print", "void", ["string"])
    _bsig(&cs, "println", "void", ["string"])
    _bsig(&cs, "eprint", "void", ["string"])
    _bsig(&cs, "input", "string", []string)
    _bsig(&cs, "read_all", "string", []string)
    _bsig(&cs, "clock", "int", []string)
    _bsig(&cs, "now", "int", []string)
    _bsig(&cs, "ncpu", "int", []string)
    _bsig(&cs, "chr", "string", ["int"])
    _bsig(&cs, "to_char", "char", ["int"])
    _bsig(&cs, "die", "void", ["string"])
    _bsig(&cs, "exit", "void", ["int"])
    _bsig(&cs, "substr", "string", ["string", "int", "int"])
    _bsig(&cs, "find", "int", ["string", "string"])
    _bsig(&cs, "char_at", "char", ["string", "int"])
    _bsig(&cs, "split", "arr(string)", ["string", "string"])
    _bsig(&cs, "read_file", "string", ["string"])
    _bsig(&cs, "write_file", "bool", ["string", "string"])
    _bsig(&cs, "list_dir", "arr(string)", ["string"])
    _bsig(&cs, "args", "arr(string)", []string)
    _bsig(&cs, "getenv", "string", ["string"])
    _bsig(&cs, "is_null", "bool", ["ptr"])
    _bsig(&cs, "to_ptr", "ptr", ["int"])
    _bsig(&cs, "sqrt", "float", ["float"])
    _bsig(&cs, "pow", "float", ["float", "float"])
    _bsig(&cs, "floor", "float", ["float"])
    _bsig(&cs, "fabs", "float", ["float"])

# ---------------------------------------------------------------- scopes

fn _vmark(cs: inout C) -> int:
    return cs.nvars

fn _vrestore(cs: inout C, m: int):
    cs.nvars = m

fn _vpush(cs: inout C, name: string, ty: string, mutable: bool):
    b := VBind(name, ty, mutable)
    if cs.nvars < len(cs.vars):
        cs.vars[cs.nvars] = b
    else:
        push(cs.vars, b)
    cs.nvars += 1

fn _vfind(cs: inout C, name: string) -> int:
    for i := cs.nvars - 1; i >= 0; i -= 1:
        if cs.vars[i].name == name:
            return i
    return -1

fn _vtype(cs: inout C, name: string) -> string:
    i := _vfind(&cs, name)
    if i < 0:
        return ""
    return cs.vars[i].ty

fn _is_pkg(cs: inout C, q: string) -> bool:
    if _vfind(&cs, q) >= 0:
        return false
    for im in cs.all_imports:
        if (len(im.alias) > 0 and im.alias == q) or pkg_basename(im.path) == q:
            return true
    return false

fn _sigidx(cs: inout C, m: string) -> int:
    if m in cs.sindex:
        return cs.sindex[m]
    return -1

fn _sigtype(s: FSig) -> string:
    out := "fun(" + s.ret
    for t in s.ptypes:
        out = out + "," + t
    return out + ")"

# The struct a value of encoded type `t` is, or "" -- seeing through a newtype,
# which src/tychoc.c@base_of does for every field and index operation.
fn _base(cs: inout C, t: string) -> string:
    if len(t) > 1 and t[0] == 64:
        m := t[1:]
        if m in cs.tindex and cs.tds[cs.tindex[m]].kind == "newtype":
            return _base(&cs, cs.tds[cs.tindex[m]].ftypes[0])
    return t

fn _tdecl(cs: inout C, t: string) -> int:
    if len(t) > 1 and t[0] == 64:
        m := t[1:]
        if m in cs.tindex:
            return cs.tindex[m]
    return -1

fn _field_ty(cs: inout C, t: string, f: string) -> string:
    i := _tdecl(&cs, _base(&cs, t))
    if i < 0:
        return "?"
    # read in place: a TDecl copy is a whole declaration, and this wants one field
    if cs.tds[i].kind != "struct":
        return "?"
    for k := 0; k < len(cs.tds[i].fnames); k += 1:
        if cs.tds[i].fnames[k] == f:
            return cs.tds[i].ftypes[k]
    return "?"

fn _elem_of(cs: inout C, t: string) -> string:
    b := _base(&cs, t)
    h := _head(b)
    if h == "arr" or h == "soa":
        return _targs(b)[0]
    if h == "fix" or h == "bnd":
        return _targs(b)[1]
    return "?"

# ---------------------------------------------------------------- expressions

fn _exs(cs: inout C, es: [ast.Expr]):
    for e in es:
        _ex(&cs, e)

fn _ex(cs: inout C, e: ast.Expr) -> string:
    return _ex2(&cs, e, "?")

# `want` is the EXPECTED type, which src/tychoc.c@resolve_exp threads for the
# same three reasons: `None` and `Ok()`/`Err()` have no type of their own, an
# empty `[]` takes the annotation's, and an untyped lambda parameter takes the
# expected fn type's.
fn _ex2(cs: inout C, e: ast.Expr, want: string) -> string:
    chan_ok := cs.chan_decl
    cs.chan_decl = false
    cs.line = ast.line_of(e)
    # src/tychoc.c@resolve_exp's literal adaptation, and the reason it has to be
    # here rather than only in _binop: a LITERAL takes the expected type's width
    # (`x: u32 = 1`, `scale(v, 2)` at a float parameter), a variable never does.
    if want != "?":
        if (e is ast.IntLit) and (_is_int(want) or want == "float" or want == "f32"):
            return want
        if (e is ast.FloatLit) and want == "f32":
            return want
    match e:
        ast.IntLit(l, v): return "int"
        ast.FloatLit(l, v): return "float"
        ast.StrLit(l, v): return "string"
        ast.FStrLit(l, v): return "string"
        ast.CharLit(l, v): return "char"
        ast.BoolLit(l, v): return "bool"
        ast.NullLit(l): return "ptr"
        ast.Name(l, n):
            t := _vtype(&cs, n)
            if len(t) > 0:
                if cs.nlambda > 0 and _vfind(&cs, n) < cs.lam_mark and _head(t) == "chan":
                    cs.line = l
                    _cerr(&cs, "a closure cannot capture a channel handle -- take it as a parameter instead")
                return t
            if len(cs.prefix) > 0 and (cs.prefix + n) in cs.consts:
                return cs.consts[cs.prefix + n]
            if n in cs.consts:
                return cs.consts[n]
            if len(cs.prefix) > 0 and (cs.prefix + n) in cs.vowner:
                return _bare_variant(&cs, l, n, cs.vowner[cs.prefix + n])
            if n in cs.vowner:
                return _bare_variant(&cs, l, n, cs.vowner[n])
            si := _sigidx(&cs, n)
            if si < 0 and len(cs.prefix) > 0:
                si = _sigidx(&cs, cs.prefix + n)
            if si >= 0 and cs.sg[si].generic:
                cs.line = l
                _cerr(&cs, "'" + n + "' is generic, so it has no single function value -- there is no instantiation to take. Wrap it in a lambda that fixes the types")
                return "?"
            if si >= 0:
                return _sigtype(cs.sg[si])
            return "?"
        ast.Field(l, k, f):
            match k[0]:
                ast.Name(l2, q):
                    if _is_pkg(&cs, q):
                        m := _prefix_of(&cs, q) + f
                        if m in cs.consts:
                            return cs.consts[m]
                        if m in cs.vowner:
                            return cs.vowner[m]
                        si := _sigidx(&cs, m)
                        if si >= 0 and cs.sg[si].generic:
                            cs.line = l
                            _cerr(&cs, "'" + q + "." + f + "' is generic, so it has no single function value -- there is no instantiation to take. Wrap it in a lambda that fixes the types")
                            return "?"
                        if si >= 0:
                            return _sigtype(cs.sg[si])
                        return "?"
                _: pass
            rt := _ex(&cs, k[0])
            ft := _field_ty(&cs, rt, f)
            cs.line = l
            _no_field(&cs, rt, f)
            _tnote(&cs, "f:" + ft)
            return ft
        ast.TupIdx(l, k, i):
            rt := _base(&cs, _ex(&cs, k[0]))
            if _head(rt) != "tup":
                return "?"
            els := _targs(rt)
            if i >= len(els):
                _cerr(&cs, "tuple index " + str(i) + " out of range (the tuple has " + str(len(els)) + " elements)")
                return "?"
            return els[i]
        ast.Index(l, k):
            rt := _base(&cs, _ex(&cs, k[0]))
            it := _ex(&cs, k[1])
            h := _head(rt)
            if h == "map":
                kt := _targs(rt)[0]
                if not compat(kt, it):
                    _cerr(&cs, "map key must be " + _show(&cs, kt) + ", got " + _show(&cs, it))
                return _targs(rt)[1]
            if h == "tup":
                _cerr(&cs, "a tuple element is named `.0`, `.1`, ... not `[i]` -- the index must be a constant position, so it is not a subscript")
                return "?"
            if rt == "string" or rt == "bytes":
                return "int"
            if _is_arr(rt) or h == "soa":
                _tnote(&cs, "x:" + _elem_of(&cs, rt))
                return _elem_of(&cs, rt)
            return "?"
        ast.Slice(l, a, b, k):
            rt := _ex(&cs, k[0])
            for i := 1; i < len(k); i += 1:
                _ex(&cs, k[i])
            return _base(&cs, rt)
        ast.Call(l, q, n, ts, args):
            ct := _call(&cs, l, q, n, ts, args, want)
            _tnote(&cs, "c:" + ct)
            return ct
        ast.CallVal(l, k):
            cvt := _base(&cs, _ex(&cs, k[0]))
            if known(cvt) and _head(cvt) != "fun":
                cs.line = l
                _cerr(&cs, "this value has type " + cvt + ", not a procedure -- it cannot be called")
            ct := _base(&cs, _ex(&cs, k[0]))
            keep := cs.in_arg
            cs.in_arg = true
            for i := 1; i < len(k); i += 1:
                _ex(&cs, k[i])
            cs.in_arg = keep
            if _head(ct) == "fun":
                return _targs(ct)[0]
            return "?"
        ast.Named(l, nm, k): return _ex(&cs, k[0])
        ast.Binop(l, o, k):
            bt := _binop(&cs, o, k)
            _tnote(&cs, "o:" + bt)
            return bt
        ast.Unop(l, o, k):
            t := _ex(&cs, k[0])
            if o == "not":
                return "bool"
            return t
        ast.IsVar(l, k, q, v):
            st := _base(&cs, _ex(&cs, k[0]))
            if known(st):
                h := _head(st)
                if h == "opt" or h == "res":
                    yes := "Some"
                    no := "None"
                    if h == "res":
                        yes = "Ok"
                        no = "Err"
                    if v != yes and v != no:
                        _cerr(&cs, "'" + v + "' is not a variant of " + _show(&cs, st) + "; write `" + yes + "` or `" + no + "`")
                    return "bool"
                ti := _tdecl(&cs, st)
                if ti >= 0 and cs.tds[ti].kind == "enum":
                    found := false
                    for vn in cs.tds[ti].fnames:
                        if vn == v:
                            found = true
                    if not found:
                        _cerr(&cs, "'" + v + "' is not a variant of " + _show(&cs, "@" + cs.tds[ti].name))
                    else:
                        fv := _foreign_variant(&cs, cs.tds[ti].name, q, v)
                        if len(fv) > 0:
                            _cerr(&cs, fv)
                    return "bool"
                if h != "opt" and h != "res" and _tdecl(&cs, st) < 0:
                    _cerr(&cs, "`is` asks an enum, Option or Result value which variant it holds; " + st + " is none of those")
                elif _tdecl(&cs, st) >= 0 and cs.tds[_tdecl(&cs, st)].kind != "enum":
                    _cerr(&cs, "`is` asks an enum, Option or Result value which variant it holds; " + st + " is none of those")
            return "bool"
        ast.ArrLit(l, k):
            wb := _base(&cs, want)
            ew := "?"
            if _is_arr(wb):
                ew = _elem_of(&cs, wb)
            if _head(wb) == "fix" and len(_targs(wb)[0]) > 0 and _targs(wb)[0][0] >= 48 and
                    _targs(wb)[0][0] <= 57 and str(len(k)) != _targs(wb)[0]:
                for x in k:
                    _ex2(&cs, x, ew)
                cs.line = l
                _cerr(&cs, "a fixed-size array of length " + _targs(wb)[0] + " needs " + _targs(wb)[0] + " elements, got " + str(len(k)))
                return wb
            et := "?"
            for i := 0; i < len(k); i += 1:
                t := _ex2(&cs, k[i], ew)
                if t == "void":
                    _cerr(&cs, "an array element cannot be void -- this element produces no value (a call to a procedure that returns nothing?)")
                elif et == "?":
                    et = t
                elif not compat(t, et):
                    _cerr(&cs, "array elements must all have the same type")
                    return "?"
            if et == "?" and ew != "?":
                et = ew
            _nest_aff_e(&cs, et)
            if _is_arr(wb) and compat(_elem_of(&cs, wb), et):
                return wb                  # a fixed or bounded destination keeps its own kind
            return "arr(" + et + ")"
        ast.MapLit(l, k):
            kt := "?"
            vt := "?"
            for i := 0; i + 1 < len(k); i += 2:
                a := _ex(&cs, k[i])
                b := _ex(&cs, k[i + 1])
                if kt == "?":
                    kt = a
                if vt == "?":
                    vt = b
            _nest_aff_e(&cs, vt)
            return "map(" + kt + "," + vt + ")"
        ast.EmptyArr(l, t):
            if len(t) == 0:
                if _is_arr(_base(&cs, want)):
                    return want
                return "?"
            at := "arr(" + _enc(&cs, t[0]) + ")"
            if _is_arr(_base(&cs, want)) and compat(_elem_of(&cs, want), _elem_of(&cs, at)):
                return want
            return at
        ast.EmptyMap(l, t):
            if len(t) < 2:
                return "?"
            kt := _enc(&cs, t[0])
            vt := _enc(&cs, t[1])
            if not _mapkey_ok(&cs, kt):
                _cerr(&cs, "map keys must be string, int (directly or through a newtype), a fieldless enum, or a hashable struct/tuple/array")
            return "map(" + kt + "," + vt + ")"
        ast.SoaLit(l, t):
            if len(t) == 0:
                return "?"
            return "soa(" + _enc(&cs, t[0]) + ")"
        ast.Tuple(l, k):
            out := "tup("
            ws := _targs(_base(&cs, want))
            for i := 0; i < len(k); i += 1:
                w := "?"
                if _head(_base(&cs, want)) == "tup" and i < len(ws):
                    w = ws[i]
                et_ := _ex2(&cs, k[i], w)
                _nest_aff_e(&cs, et_)
                if i > 0:
                    out = out + ","
                out = out + et_
            return out + ")"
        ast.SomeE(l, k):
            w := "?"
            if _head(_base(&cs, want)) == "opt":
                w = _targs(_base(&cs, want))[0]
            it_ := _ex2(&cs, k[0], w)
            _nest_aff_e(&cs, it_)
            return "opt(" + it_ + ")"
        ast.NoneE(l):
            if _head(_base(&cs, want)) == "opt":
                return want
            return "opt(?)"
        ast.OkE(l, k):
            wb := _base(&cs, want)
            if len(k) == 0:
                if _head(wb) == "res":
                    if _targs(wb)[0] != "void" and known(_targs(wb)[0]):
                        _cerr(&cs, "declared type " + want + " but value is Ok(); Ok() is only a Result(void, E)")
                    return want
                return "res(void,?)"
            w := "?"
            if _head(wb) == "res":
                w = _targs(wb)[0]
                if w == "void":
                    _cerr(&cs, "Result(void, " + _targs(wb)[1] + ") carries no ok value -- write Ok(), not Ok(x)")
                    return want
            return "res(" + _ex2(&cs, k[0], w) + ",?)"
        ast.ErrE(l, k):
            wb := _base(&cs, want)
            w := "?"
            if _head(wb) == "res":
                w = _targs(wb)[1]
            return "res(?," + _ex2(&cs, k[0], w) + ")"
        ast.SpawnE(l, k):
            # `task(T)`, not a bare `task`: wait(t) has to know what it yields.
            rt := "void"
            if len(k) > 0:
                rt = _ex(&cs, k[0])
            return "task(" + rt + ")"
        ast.OrRet(l, k):
            t := _base(&cs, _ex(&cs, k[0]))
            if _head(t) == "res":
                return _targs(t)[0]
            if _head(t) == "opt":
                return _targs(t)[0]
            return "?"
        ast.Spread(l, k): return _ex(&cs, k[0])
        ast.Addr(l, k):
            if not cs.in_arg:
                _cerr(&cs, "'&' is only valid as the argument to an inout parameter, e.g. f(&x)")
            return _ex(&cs, k[0])
        ast.ChanE(l, t, k):
            _exs(&cs, k)
            cs.line = l
            if not chan_ok:
                _cerr(&cs, "a channel must be created directly in a declaration: ch := channel(T, cap)")
            if len(t) == 0:
                return "chan(?)"
            return "chan(" + _enc(&cs, t[0]) + ")"
        ast.Lambda(l, ps, rt, body):
            m := _vmark(&cs)
            wb := _base(&cs, want)
            wps := _targs(wb)
            out := "fun("
            r := "?"
            if len(rt) == 1:
                r = _enc(&cs, rt[0])
            elif _head(wb) == "fun" and len(wps) > 0:
                r = wps[0]
            out = out + r
            for i := 0; i < len(ps); i += 1:
                pt := "?"
                if len(ps[i].ty) == 1:
                    pt = _enc(&cs, ps[i].ty[0])
                elif _head(wb) == "fun" and i + 1 < len(wps):
                    pt = wps[i + 1]
                if len(ps[i].ty) == 0 and not known(pt):
                    _cerr(&cs, "lambda parameter '" + ps[i].name + "' needs a type here -- no expected fn type supplies it (annotate: fn(x: T))")
                _vpush(&cs, ps[i].name, pt, false)
                out = out + "," + pt
            keepr := cs.ret
            keepc := cs.nlambda
            keepm := cs.lam_mark
            cs.ret = "?"
            cs.nlambda = cs.nlambda + 1
            cs.lam_mark = m
            _exs(&cs, body)
            # Captures are the bindings BELOW this lambda's mark. An affine one
            # has a single owner and a scope-bound destructor, so a closure that
            # outlives the scope would hold a freed handle.
            for ci := 0; ci < m; ci += 1:
                k9 := _aff_kind(&cs, cs.vars[ci].ty)
                if len(k9) == 0:
                    continue
                for be in body:
                    if _pf_reads(be, cs.vars[ci].name):
                        cs.line = l
                        if k9 == "task":
                            _cerr(&cs, "a closure cannot capture a task handle -- wait it first")
                        elif k9 == "chan":
                            _cerr(&cs, "a closure cannot capture a channel handle -- take it as a parameter instead")
                        else:
                            _cerr(&cs, "a closure cannot capture a handle -- it is freed at the end of its scope")
                        break
            cs.nlambda = keepc
            cs.lam_mark = keepm
            cs.ret = keepr
            _vrestore(&cs, m)
            return out + ")"
    return "?"

# ---------------------------------------------------------------- operators
#
# src/tychoc.c:7200-7460, arm for arm. The LITERAL ADAPTATION rules matter as
# much as the refusals: an int literal takes a sized/f32/float operand's type,
# and a variable never widens -- so `f < 0` is legal and `f < n` is not, and a
# checker that widened both would accept a program src/tychoc.c refuses (which
# is safe) while one that widened neither would REFUSE `f < 0` (which is not).

fn _is_intlit(e: ast.Expr) -> bool:
    return e is ast.IntLit

fn _is_numlit(e: ast.Expr) -> bool:
    return (e is ast.IntLit) or (e is ast.FloatLit)

fn _elem_arith_ok(op: string, et: string) -> bool:
    if et == "?":
        return true
    if op == "%":
        return _is_int(et)
    if op != "+" and op != "-" and op != "*" and op != "/":
        return false
    if _is_num(et):
        return true
    if len(et) > 1 and et[0] == 64:
        return true                        # a newtype over int/float; _binop has the base
    if et == "char":
        return op == "+" or op == "-"
    return false

fn _arith_op(op: string) -> bool:
    return op == "+" or op == "-" or op == "*" or op == "/" or op == "%"

fn _binop(cs: inout C, op: string, k: [ast.Expr]) -> string:
    lt := _ex(&cs, k[0])
    rt := _ex(&cs, k[1])
    cs.line = ast.line_of(k[0])
    if op == "and" or op == "or":
        return "bool"
    if op == "in":
        rb := _base(&cs, rt)
        if _head(rb) != "map":
            if known(rb):
                _cerr(&cs, "`in` tests membership in a map; the right operand must be a map")
            return "bool"
        kt := _targs(rb)[0]
        if not compat(kt, lt):
            _cerr(&cs, "`in` key must be " + kt)
        return "bool"
    # literal adaptation, value-directional: a LITERAL takes the other side's
    # width, a variable never widens.
    if _is_intlit(k[0]) and _is_int(rt):
        lt = rt
    if _is_intlit(k[1]) and _is_int(lt):
        rt = lt
    if rt == "f32" and _is_numlit(k[0]):
        lt = "f32"
    if lt == "f32" and _is_numlit(k[1]):
        rt = "f32"
    if not known(lt) or not known(rt):
        if op == "==" or op == "!=" or op == "<" or op == ">" or op == "<=" or op == ">=":
            return "bool"
        return "?"                     # an unknown operand poisons the RESULT too:
                                       # `f * 2` at an unknown `f` is not an int
    if op == "==" or op == "!=":
        if lt != rt:
            _cerr(&cs, "cannot compare " + lt + " with " + rt)
        elif _head(lt) == "fun":
            _cerr(&cs, "functions are not comparable -- closures have no structural equality; compare the values they produce instead")
        return "bool"
    if op == "<" or op == ">" or op == "<=" or op == ">=":
        if lt == "float" and rt == "int" and _is_intlit(k[1]):
            rt = "float"
        elif rt == "float" and lt == "int" and _is_intlit(k[0]):
            lt = "float"
        b := _base(&cs, lt)
        if lt != rt or not (_is_num(b) or b == "char" or b == "string"):
            _cerr(&cs, "ordering compares two ints, two floats, two strings, or two values of the same numeric newtype")
        return "bool"
    if op == "+" and lt == "string":
        if rt != "string" and rt != "char":
            _cerr(&cs, "cannot concatenate string with " + rt)
        return "string"
    if op == "+" and lt == "bytes":
        if rt != "bytes" and rt != "char":
            _cerr(&cs, "cannot concatenate bytes with " + rt)
        return "bytes"
    if op == "<<" or op == ">>":
        if not _is_int(lt) or not _is_int(rt):
            _cerr(&cs, "shift operators require integer operands (got " + lt + ", " + rt + ")")
        return lt
    la := _is_arr(lt)
    ra := _is_arr(rt)
    if la and ra and _arith_op(op):
        if _head(lt) == "bnd" or _head(rt) == "bnd":
            _cerr(&cs, "element-wise `" + op + "` is defined for [T] and [N]T only (got " + lt + ", " + rt + ")")
            return lt
        el := _elem_of(&cs, lt)
        er := _elem_of(&cs, rt)
        if el != er:
            _cerr(&cs, "element-wise `" + op + "` requires two arrays with the same element type (got " + _show(&cs, lt) + ", " + _show(&cs, rt) + ")")
        elif (_head(lt) == "fix") != (_head(rt) == "fix"):
            _cerr(&cs, "cannot mix a fixed array and a growable array in element-wise `" + op + "`")
        elif lt != rt:
            _cerr(&cs, "element-wise `" + op + "` on a fixed array requires the same static length (got " + _show(&cs, lt) + " and " + _show(&cs, rt) + ")")
        elif not _elem_arith_ok(op, el):
            _cerr(&cs, "`" + op + "` is not defined element-wise on " + lt + " -- there is no element-wise `" + op + "` for " + el)
        return lt
    if (la or ra) and _arith_op(op):
        at := lt
        st := rt
        sc := k[1]
        if ra:
            at = rt
            st = lt
            sc = k[0]
        if _head(at) == "bnd":
            _cerr(&cs, "element-wise `" + op + "` is defined for [T] and [N]T only (got " + lt + ", " + rt + ")")
            return at
        et := _elem_of(&cs, at)
        if _is_intlit(sc) and _is_int(et):
            st = et
        elif et == "f32" and _is_numlit(sc):
            st = "f32"
        elif et == "float" and st == "int" and _is_intlit(sc):
            st = "float"
        if st != et:
            _cerr(&cs, "element-wise `" + op + "` requires the scalar to have the array's element type (got " + _show(&cs, lt) + " and " + _show(&cs, rt) + ") -- a literal adapts, but a variable never widens")
        elif not _elem_arith_ok(op, et):
            _cerr(&cs, "`" + op + "` is not defined element-wise on " + at + " -- there is no element-wise `" + op + "` for " + et)
        return at
    if op == "%" or op == "&" or op == "|" or op == "^":
        if not _is_int(lt) or lt != rt:
            _cerr(&cs, "modulo / bitwise operators require two matching integers (got " + lt + ", " + rt + ")")
        return lt
    if lt == "int" and rt == "int":
        return "int"
    if lt == rt and _is_int(lt):
        return lt
    if lt == "f32" and rt == "f32":
        return "f32"
    if (op == "+" or op == "-") and (lt == "char" or rt == "char") and
            (lt == "char" or lt == "int") and (rt == "char" or rt == "int"):
        return "char"
    if lt == "float" and rt == "float":
        return "float"
    ln := _base(&cs, lt)
    if lt == rt and _tdecl(&cs, lt) >= 0 and cs.tds[_tdecl(&cs, lt)].kind == "newtype" and
            (ln == "int" or ln == "float"):
        return lt
    if lt == "float" and rt == "int" and _is_intlit(k[1]):
        return "float"
    if rt == "float" and lt == "int" and _is_intlit(k[0]):
        return "float"
    if lt == "bytes" or rt == "bytes":
        _cerr(&cs, "bytes has no arithmetic (got " + lt + ", " + rt + ")")
        return lt
    li := _tdecl(&cs, lt)
    ri := _tdecl(&cs, rt)
    if li >= 0 and ri >= 0 and cs.tds[li].kind == "newtype" and cs.tds[ri].kind == "newtype" and lt != rt:
        # _short drops the package outright; a diagnostic has to print what the
        # source can type, and money.Cents is not spellable as Cents.
        _cerr(&cs, "arithmetic on two different newtypes: '" + _show(&cs, "@" + cs.tds[li].name) + "' and '" + _show(&cs, "@" + cs.tds[ri].name) + "' are distinct types even though both are represented as their base")
        return "?"
    if li >= 0 or ri >= 0:
        return "?"                     # a same-newtype operand keeps its type
    _cerr(&cs, "arithmetic requires two ints or two floats (got " + lt + ", " + rt + ") -- convert one side, e.g. to_float(x) to compute in floats, or to_int(x) in ints")
    return lt

# ---------------------------------------------------------------- calls

fn _any_named(args: [ast.Expr]) -> bool:
    for a in args:
        if a is ast.Named:
            return true
    return false

fn _walk_args(cs: inout C, args: [ast.Expr]):
    keep := cs.in_arg
    cs.in_arg = true
    for a in args:
        _ex(&cs, a)
    cs.in_arg = keep

# One call against one known, non-generic signature: arity, each argument's
# type, and the two `&` rules. Skipped whole when a variadic or a named argument
# is in play -- `?` is the answer to anything this pass cannot ground.
fn _check_args(cs: inout C, name: string, si: int, args: [ast.Expr], line: int):
    # NOT `s := cs.sg[si]`: an FSig carries the generic TEMPLATE's body, so that
    # local copied a whole function body 4,217 times in a self-compile. The two
    # checks below take it as an argument, which is a borrow, and the rest of
    # this function reads two of its fields.
    _alias_check(&cs, name, cs.sg[si], args, line)
    _sink_check(&cs, name, cs.sg[si], args, line)
    variadic := false
    for f in cs.sg[si].pflags:
        if f == "var":
            variadic = true
    if _any_named(args):
        keep := cs.in_arg
        cs.in_arg = true
        for a in args:
            _ex(&cs, a)
        cs.in_arg = keep
        return
    if not variadic and len(args) != len(cs.sg[si].ptypes):
        keep2 := cs.in_arg
        cs.in_arg = true
        for a in args:
            _ex(&cs, a)
        cs.in_arg = keep2
        cs.line = line
        _cerr(&cs, "'" + name + "' takes " + str(len(cs.sg[si].ptypes)) + " argument(s), got " + str(len(args)))
        return
    n := len(args)
    if variadic and len(cs.sg[si].ptypes) - 1 < n:
        n = len(cs.sg[si].ptypes) - 1
        for i := n; i < len(args); i += 1:
            if (args[i] is ast.Spread) and len(args) - n > 1:
                cs.line = line
                _cerr(&cs, "a spread argument `x...` must be the only variadic argument to '" + name + "'")
                return
    keep3 := cs.in_arg
    cs.in_arg = true
    for i := 0; i < len(args); i += 1:
        want := "?"
        if i < n:
            want = cs.sg[si].ptypes[i]
        at := _ex2(&cs, args[i], want)
        cs.line = line
        if i < n:
            if cs.sg[si].pflags[i] == "inout":
                if not (args[i] is ast.Addr):
                    _cerr(&cs, "argument " + str(i + 1) + " of '" + name + "' is inout; pass it as '&variable'")
            elif args[i] is ast.Addr:
                _cerr(&cs, "argument " + str(i + 1) + " of '" + name + "' is not inout; remove the '&'")
            # is_null asks whether an opener FAILED, so it takes a handle as well
            # as a ptr -- and nothing else, or the exception would swallow int.
            ok9 := compat(at, want)
            if not ok9 and name == "is_null" and want == "ptr" and _aff_kind(&cs, at) == "handle":
                ok9 = true
            if not ok9:
                _cerr(&cs, "argument " + str(i + 1) + " of '" + name + "' is " + _show(&cs, at) + ", expected " + _show(&cs, want))
                _nt_note(&cs, at, want)
        cs.line = ast.line_of(args[i])
    cs.in_arg = keep3
    cs.line = line

fn _check_fields(cs: inout C, ti: int, args: [ast.Expr], line: int) -> string:
    # read in place: this is a whole declaration, and only fields are wanted
    if _any_named(args) or cs.tds[ti].generic:
        keep := cs.in_arg
        cs.in_arg = true
        for a in args:
            _ex(&cs, a)
        cs.in_arg = keep
        if cs.tds[ti].generic:
            return "?"
        return "@" + cs.tds[ti].name
    keep2 := cs.in_arg
    cs.in_arg = true
    if len(args) != len(cs.tds[ti].fnames):
        for a in args:
            _ex(&cs, a)
        cs.in_arg = keep2
        cs.line = line
        _cerr(&cs, cs.tds[ti].name + " takes " + str(len(cs.tds[ti].fnames)) + " field value(s), got " + str(len(args)))
        return "@" + cs.tds[ti].name
    for i := 0; i < len(args); i += 1:
        at := _ex2(&cs, args[i], cs.tds[ti].ftypes[i])
        cs.line = line
        if not compat(at, cs.tds[ti].ftypes[i]):
            _cerr(&cs, "field '" + cs.tds[ti].fnames[i] + "' of " + cs.tds[ti].name + " is " + cs.tds[ti].ftypes[i] + ", got " + at)
        cs.line = ast.line_of(args[i])
    cs.in_arg = keep2
    cs.line = line
    return "@" + cs.tds[ti].name

fn _check_variant(cs: inout C, m: string, args: [ast.Expr], line: int) -> string:
    owner := cs.vowner[m]
    pay := []string
    if m in cs.vpay and len(cs.vpay[m]) > 0:
        pay = split(cs.vpay[m], "|")
    ti := _tdecl(&cs, owner)
    generic := ti >= 0 and cs.tds[ti].generic
    keep := cs.in_arg
    cs.in_arg = true
    if generic and not _any_named(args):
        cs.in_arg = keep
        at0 := 0
        for v := 0; v < len(cs.tds[ti].fnames); v += 1:
            if cs.tds[ti].fnames[v] == _short(m):
                return _inst_ctor(&cs, line, ti, args, at0, cs.tds[ti].pcnt[v])
            at0 += cs.tds[ti].pcnt[v]
        return "?"
    if generic or _any_named(args) or len(args) != len(pay):
        for a in args:
            _ex(&cs, a)
        cs.in_arg = keep
        cs.line = line
        if generic:
            return "?"
        if len(args) != len(pay):
            _cerr(&cs, m + " takes " + str(len(pay)) + " payload value(s), got " + str(len(args)))
        return owner
    for i := 0; i < len(args); i += 1:
        at := _ex2(&cs, args[i], pay[i])
        cs.line = line
        if not compat(at, pay[i]):
            _cerr(&cs, "payload " + str(i + 1) + " of " + m + " is " + _show(&cs, at) + ", expected " + _show(&cs, pay[i]))
        cs.line = ast.line_of(args[i])
    cs.in_arg = keep
    cs.line = line
    return owner

fn _call(cs: inout C, l: int, q: string, n: string, ts: [ast.Ty], args: [ast.Expr], want: string) -> string:
    for t in ts:
        _enc(&cs, t)
    if len(ts) > 0:
        if len(q) > 0 and not _is_pkg(&cs, q):
            _walk_args(&cs, args)
            return "?"
        return _explicit_call(&cs, l, q, n, ts, args, want)
    if len(q) > 0:
        if not _is_pkg(&cs, q):
            if _shape_builtin(n):
                args2 := []ast.Expr
                push(args2, ast.Name(l, q))
                for a in args:
                    push(args2, a)
                return _call_builtin(&cs, l, n, args2, want)
            # `x.f(...)`: a UFCS method on a value. Which function it names needs
            # the receiver's type and the whole method set, which is Phase 6b's
            # monomorphisation surface -- `?`, and no argument is checked.
            _walk_args(&cs, args)
            return "?"
        m := _prefix_of(&cs, q) + n
        return _call_named(&cs, l, m, n, args, want)
    # The shape-directed builtins are resolved BEFORE the Sig table, exactly as
    # src/tychoc.c:6740-6990 sits before its sig_find at :7049 -- a user `fn len`
    # in the entry package is registered UNMANGLED, so without this ordering the
    # bare `len(b)` inside core:strings found it and refused a program ./tychoc
    # accepts (tests/warn/pkg/corelib_mute/main.ty).
    if _shape_builtin(n):
        return _call_builtin(&cs, l, n, args, want)
    vt := _vtype(&cs, n)
    if len(vt) > 0 and known(vt) and _head(_base(&cs, vt)) != "fun":
        _walk_args(&cs, args)
        cs.line = l
        _cerr(&cs, "'" + n + "' has type " + vt + ", not a procedure -- it cannot be called")
        return "?"
    if len(cs.prefix) > 0:
        m := cs.prefix + n
        if _sigidx(&cs, m) >= 0 or m in cs.tindex or m in cs.vowner:
            return _call_named(&cs, l, m, n, args, want)
    if _sigidx(&cs, n) >= 0 or n in cs.tindex or n in cs.vowner:
        return _call_named(&cs, l, n, n, args, want)
    return _call_builtin(&cs, l, n, args, want)

fn _call_named(cs: inout C, l: int, m: string, spelt: string, args: [ast.Expr], want: string) -> string:
    si := _sigidx(&cs, m)
    if si >= 0:
        if cs.sg[si].generic:
            return _generic_call(&cs, l, si, spelt, []ast.Ty, args)
        _check_args(&cs, spelt, si, args, l)
        return cs.sg[si].ret
    if m in cs.tindex:
        d := cs.tds[cs.tindex[m]]
        if d.kind == "struct" and d.generic:
            return _inst_ctor(&cs, l, cs.tindex[m], args, 0, len(args))
        if d.kind == "struct":
            return _check_fields(&cs, cs.tindex[m], args, l)
        if d.kind == "newtype":
            _walk_args(&cs, args)
            return "@" + m
        _walk_args(&cs, args)
        return "?"
    if m in cs.vowner:
        return _check_variant(&cs, m, args, l)
    _walk_args(&cs, args)
    return "?"

# ---------------------------------------------------------------- builtins
#
# The shape-directed half of src/tychoc.c:6740-6990: str/hash/to_*/len/keys/
# push/pop/reserve and the map_* family bypass the fixed Sig table because their
# answer follows the ARGUMENT's type. Everything else falls through to the Sig
# table, which is where `'print' takes 1 argument(s), got 0` comes from.

fn _sized_conv(n: string) -> string:
    if n == "to_u8":
        return "u8"
    if n == "to_u16":
        return "u16"
    if n == "to_u32":
        return "u32"
    if n == "to_u64":
        return "u64"
    if n == "to_i8":
        return "i8"
    if n == "to_i16":
        return "i16"
    if n == "to_i32":
        return "i32"
    if n == "to_i64":
        return "i64"
    if n == "to_f32":
        return "f32"
    return ""

fn _str_ok(cs: inout C, t: string) -> bool:
    b := _base(&cs, t)
    if b == "?":
        return true
    if _is_num(b) or b == "bool" or b == "string" or b == "char" or b == "bytes":
        return true
    h := _head(b)
    if h == "arr" or h == "fix" or h == "bnd" or h == "map" or h == "tup" or h == "opt" or h == "res":
        return true
    i := _tdecl(&cs, b)
    return i >= 0 and (cs.tds[i].kind == "struct" or cs.tds[i].kind == "enum")

fn _arity(cs: inout C, n: string, args: [ast.Expr], want: int, msg: string) -> bool:
    if len(args) == want:
        return true
    _cerr(&cs, msg)
    return false

fn _call_builtin(cs: inout C, l: int, n: string, args: [ast.Expr], want: string) -> string:
    ats := []string
    keep := cs.in_arg
    cs.in_arg = true
    a0 := "?"
    if len(args) > 0:
        a0 = _ex(&cs, args[0])
        push(ats, a0)
    b0 := _base(&cs, a0)
    # push's VALUE is checked against the array's element type, so it is the one
    # builtin whose second argument needs the expected type threaded into it --
    # `push(rows, [10, 20, 30])` at a bounded[3]int element is the case.
    w1 := "?"
    if n == "push":
        w1 = _elem_of(&cs, b0)
    for i := 1; i < len(args); i += 1:
        push(ats, _ex2(&cs, args[i], w1))
    cs.in_arg = keep
    cs.line = l
    if n == "str":
        if not _arity(&cs, n, args, 1, "str(x) takes one argument"):
            return "string"
        if not _str_ok(&cs, a0):
            _cerr(&cs, "str(x) can't stringify a " + a0)
        return "string"
    if n == "hash":
        if not _arity(&cs, n, args, 1, "hash(x) takes one argument"):
            return "int"
        if known(a0) and not _mapkey_ok(&cs, a0):
            _cerr(&cs, "hash(x) can't hash a " + a0 + " (hashable = the map-key types: int, string, their newtypes, fieldless enums, and composites of those)")
        return "int"
    if n == "to_float":
        if not _arity(&cs, n, args, 1, "to_float(n) takes one argument"):
            return "float"
        if known(a0) and not (_is_int(a0) or a0 == "f32" or (_tdecl(&cs, a0) >= 0 and b0 == "float")):
            _cerr(&cs, "to_float(n) takes an int, a sized int, f32, or a float newtype")
        return "float"
    if n == "to_int":
        if not _arity(&cs, n, args, 1, "to_int(x) takes one argument"):
            return "int"
        if a0 == "int":
            _cerr(&cs, "to_int(x): x is already an int -- indexing a string (s[i]) yields the byte value as an int; use chr(x) for its one-character string")
        elif known(a0) and not (a0 == "float" or _is_int(a0) or a0 == "f32" or a0 == "char" or
                (_tdecl(&cs, a0) >= 0 and _is_int(b0))):
            _cerr(&cs, "to_int(x) takes a float (truncates toward zero), a sized int, f32, a char, or an int newtype")
        return "int"
    if len(_sized_conv(n)) > 0:
        if not _arity(&cs, n, args, 1, n + "(x) takes one argument"):
            return _sized_conv(n)
        if known(b0) and not (_is_num(b0) or b0 == "char"):
            _cerr(&cs, n + "(x) takes a numeric value")
        return _sized_conv(n)
    if n == "to_str":
        if not _arity(&cs, n, args, 1, "to_str(x) takes one argument"):
            return "string"
        if known(a0) and not (a0 == "bytes" or (_tdecl(&cs, a0) >= 0 and b0 == "string")):
            _cerr(&cs, "to_str(x) takes bytes or a string newtype")
        return "string"
    if n == "to_bytes":
        if not _arity(&cs, n, args, 1, "to_bytes(s) takes one argument"):
            return "bytes"
        if known(b0) and not (b0 == "string" or b0 == "bytes" or b0 == "arr(int)"):
            _cerr(&cs, "to_bytes(x) takes a string or [int]")
        return "bytes"
    if n == "to_bool":
        if not _arity(&cs, n, args, 1, "to_bool(x) takes one argument"):
            return "bool"
        if known(a0) and not (_tdecl(&cs, a0) >= 0 and b0 == "bool"):
            _cerr(&cs, "to_bool(x) takes a bool newtype")
        return "bool"
    if n == "to_under":
        if not _arity(&cs, n, args, 1, "to_under(x) takes one argument"):
            return "?"
        i := _tdecl(&cs, a0)
        if i < 0 or cs.tds[i].kind != "newtype":
            if known(a0):
                _cerr(&cs, "to_under(x) takes a newtype value, got " + a0)
            return "?"
        return cs.tds[i].ftypes[0]
    if n == "len":
        if not _arity(&cs, n, args, 1, "len(...) takes one argument"):
            return "int"
        h := _head(b0)
        if known(b0) and not (_is_arr(b0) or b0 == "string" or b0 == "bytes" or h == "map" or h == "soa"):
            _cerr(&cs, "len(...) takes an array, a string, bytes, a map, or a soa")
        return "int"
    if n == "keys":
        if not _arity(&cs, n, args, 1, "keys(m) takes one argument"):
            return "?"
        if _head(b0) != "map":
            if known(b0):
                _cerr(&cs, "keys's argument must be a map")
            return "?"
        return "arr(" + _targs(b0)[0] + ")"
    if n == "push":
        if not _arity(&cs, n, args, 2, "push(arr, value) takes two arguments"):
            return "void"
        if known(b0) and not (_is_arr(b0) or _head(b0) == "soa"):
            _cerr(&cs, "push's first argument must be an array or soa")
            return "void"
        el := _elem_of(&cs, b0)
        _nest_aff_e(&cs, ats[1])
        if not compat(el, ats[1]):
            _cerr(&cs, "push's value must be " + el)
        return "void"
    if n == "pop":
        if not _arity(&cs, n, args, 1, "pop(arr) takes one argument"):
            return "?"
        if known(b0) and not (_is_arr(b0) or _head(b0) == "soa"):
            _cerr(&cs, "pop's first argument must be an array or soa")
            return "?"
        return _elem_of(&cs, b0)
    if n == "reserve":
        if not _arity(&cs, n, args, 2, "reserve(arr, n) takes two arguments"):
            return "void"
        if known(b0) and not (_is_arr(b0) or _head(b0) == "map"):
            _cerr(&cs, "reserve's first argument must be an array or a map")
        return "void"
    if n == "close":
        if len(args) == 1 and _aff_kind(&cs, a0) == "handle" and not (args[0] is ast.Name):
            _cerr(&cs, "close(h) takes a handle variable")
        return "void"
    if n == "send":
        if len(args) == 2 and _head(b0) == "chan":
            w := _targs(b0)[0]
            if not compat(w, ats[1]):
                _cerr(&cs, "send on " + b0 + " needs a " + w + " value")
        return "void"
    if n == "wait":
        if len(args) == 1 and _head(b0) == "task":
            return _targs(b0)[0]
        return "?"
    if n == "recv":
        if len(args) == 1 and _head(b0) == "chan":
            return "opt(" + _targs(b0)[0] + ")"
        return "?"
    if n == "zero":
        return "?"
    si := _sigidx(&cs, n)
    if si >= 0:
        _check_args(&cs, n, si, args, l)
        return cs.sg[si].ret
    return "?"

# ---------------------------------------------------------------- match
#
# src/tychoc.c:8440-8640. Exhaustiveness is the half a verdict differential
# cannot get for free: a match that covers three of four variants COMPILES under
# a checker that forgot to count, and the program then falls off the end.

fn _variant_names(cs: inout C, et: string) -> [string]:
    i := _tdecl(&cs, et)
    if i < 0:
        return []string
    return cs.tds[i].fnames

fn _variant_payload(cs: inout C, et: string, name: string) -> [string]:
    i := _tdecl(&cs, et)
    if i < 0:
        return []string
    # read in place: a TDecl copy is a whole declaration (see _field_ty)
    for k := 0; k < len(cs.tds[i].fnames); k += 1:
        if cs.tds[i].fnames[k] == name:
            if len(cs.tds[i].ftypes[k]) == 0:
                return []string
            return split(cs.tds[i].ftypes[k], "|")
    return []string

fn _arm_binds(cs: inout C, a: ast.Arm, tys: [string]):
    for i := 0; i < len(a.binds); i += 1:
        t := "?"
        if i < len(tys):
            t = tys[i]
        if t == "void":
            cs.line = a.line
            _cerr(&cs, "cannot bind a void value")
            t = "?"
        _vpush(&cs, a.binds[i], t, true)
    for b in a.subbinds:
        _vpush(&cs, b, "?", true)

fn _match(cs: inout C, l: int, subj: [ast.Expr], arms: [ast.Arm]):
    st := _base(&cs, _ex(&cs, subj[0]))
    wild := false
    for i := 0; i < len(arms); i += 1:
        if arms[i].kind == "variant" and arms[i].name == "_":
            if i != len(arms) - 1:
                cs.line = arms[i].line
                _cerr(&cs, "a `_` wildcard must be the last match arm")
            wild = true
        if arms[i].kind == "scalar":
            for p in arms[i].pats:
                if p.kind == "name" and p.loname == "_":
                    if i != len(arms) - 1:
                        cs.line = arms[i].line
                        _cerr(&cs, "a `_` wildcard must be the last match arm")
                    wild = true
    h := _head(st)
    if h == "opt" or h == "res":
        # A REFINED side: `Err(A(n))` covers one variant of the payload enum, so
        # `Err` alone is not covered until every variant is. src/tychoc.c@SideCov;
        # tests/reject/match_result_partial_err.ty's own header says why the
        # "must cover both Ok and Err" wording would be false here.
        cov0 := []string: bool
        cov1 := []string: bool
        ref0 := false
        ref1 := false
        full0 := false
        full1 := false
        seen0 := false
        seen1 := false
        yes := "Some"
        no := "None"
        if h == "res":
            yes = "Ok"
            no = "Err"
        for a in arms:
            m := _vmark(&cs)
            cs.line = a.line
            if a.name == "_":
                pass
            elif a.name == yes and len(a.qual) == 0:
                seen0 = true
                nested := _nested_of(&cs, a, _targs(st)[0])
                if len(nested) > 0:
                    ref0 = true
                    cov0[nested] = true
                else:
                    full0 = true       # a plain binding covers the whole side
                pay := []string
                push(pay, _targs(st)[0])
                if h == "res" and _targs(st)[0] == "void" and len(a.binds) > 0:
                    _cerr(&cs, "Ok carries no value here -- write a bare `Ok:` arm")
                else:
                    _arm_binds(&cs, a, pay)
            elif a.name == no and len(a.qual) == 0:
                seen1 = true
                nested := ""
                if h == "res":
                    nested = _nested_of(&cs, a, _targs(st)[1])
                if len(nested) > 0:
                    ref1 = true
                    cov1[nested] = true
                else:
                    full1 = true
                pay := []string
                if h == "res":
                    push(pay, _targs(st)[1])
                _arm_binds(&cs, a, pay)
            elif known(st):
                spelt2 := a.name
                if len(a.qual) > 0:
                    spelt2 = a.qual + "." + a.name
                if h == "opt":
                    _cerr(&cs, "an Option's arms are Some(x), None, and _, not '" + spelt2 + "'")
                else:
                    _cerr(&cs, "a Result's arms are Ok(x), Err(e), and _, not '" + spelt2 + "'")
            _tblock(&cs, a.body)
            _vrestore(&cs, m)
        if not wild and known(st):
            cs.line = l
            if not (seen0 and seen1):
                if h == "opt":
                    _cerr(&cs, "match on an Option must cover both Some and None")
                else:
                    _cerr(&cs, "match on a Result must cover both Ok and Err")
            else:
                _side_cov(&cs, l, _targs(st)[0], cov0, ref0 and not full0)
                if h == "res":
                    _side_cov(&cs, l, _targs(st)[1], cov1, ref1 and not full1)
        return
    ti := _tdecl(&cs, st)
    if ti >= 0 and cs.tds[ti].kind == "enum":
        names := _variant_names(&cs, st)
        covered := []string: bool
        for a in arms:
            m := _vmark(&cs)
            cs.line = a.line
            if a.name != "_":
                found := false
                for v in names:
                    if v == a.name:
                        found = true
                fv := ""
                if found:
                    fv = _foreign_variant(&cs, cs.tds[ti].name, a.qual, a.name)
                if not found:
                    _cerr(&cs, "'" + a.name + "' is not a variant of " + _show(&cs, "@" + cs.tds[ti].name))
                elif len(fv) > 0:
                    _cerr(&cs, fv)
                elif a.name in covered:
                    _cerr(&cs, "duplicate arm for " + a.name)
                covered[a.name] = true
                pay := _variant_payload(&cs, st, a.name)
                if found and len(a.binds) != len(pay) and len(a.subbinds) == 0:
                    _cerr(&cs, a.name + " binds " + str(len(pay)) + " value(s), got " + str(len(a.binds)))
                _arm_binds(&cs, a, pay)
            _tblock(&cs, a.body)
            _vrestore(&cs, m)
        if not wild:
            for v in names:
                if not (v in covered):
                    cs.line = l
                    _cerr(&cs, "non-exhaustive match: missing variant " + v + " of " + cs.tds[ti].name)
        return
    if st == "int" or st == "char" or st == "bool" or not known(st):
        los := []int
        his := []int
        lns := []int
        for a in arms:
            m := _vmark(&cs)
            cs.line = a.line
            if a.kind == "scalar":
                for p in a.pats:
                    if p.kind == "name":
                        if p.loname != "_":
                            cv := _const_int(&cs, p.loname)
                            if cv[0] == 0:
                                _cerr(&cs, "'" + p.loname + "' is not an int constant (match arms for " + st + " are literals)")
                            else:
                                push(los, cv[1])
                                push(his, cv[1])
                                push(lns, a.line)
                        continue
                    if st == "int" and p.kind != "int":
                        _cerr(&cs, "a match on an int takes int literal arms, not a " + p.kind)
                    if st == "char" and p.kind != "char":
                        _cerr(&cs, "a match on a char takes char literal arms")
                    if st == "bool" and p.kind != "bool":
                        _cerr(&cs, "a match on a bool takes true/false arms")
                    if p.lo > p.hi:
                        _cerr(&cs, "a range starts at " + str(p.lo) + " and ends at " + str(p.hi) + " (the start must not exceed the end)")
                    push(los, p.lo)
                    push(his, p.hi)
                    push(lns, a.line)
            elif a.name != "_" and known(st):
                cv := _const_int(&cs, a.name)
                if cv[0] == 0:
                    _cerr(&cs, "'" + a.name + "' is not an int constant (match arms for " + st + " are literals)")
                else:
                    push(los, cv[1])
                    push(his, cv[1])
                    push(lns, a.line)
            _tblock(&cs, a.body)
            _vrestore(&cs, m)
        for i := 0; i < len(los); i += 1:
            for j := i + 1; j < len(los); j += 1:
                if los[j] <= his[i] and los[i] <= his[j]:
                    cs.line = lns[j]
                    if lns[j] < lns[i]:
                        cs.line = lns[i]
                    _cerr(&cs, "duplicate or overlapping match arm: [" + str(los[i]) + ".." + str(his[i]) +
                          "] overlaps [" + str(los[j]) + ".." + str(his[j]) + "]")
                    return
        if not wild and known(st):
            cs.line = l
            if st == "int" or st == "char":
                _cerr(&cs, "a match on " + st + " must carry a `_` arm (the domain is unbounded)")
            else:
                has0 := false
                has1 := false
                for i := 0; i < len(los); i += 1:
                    if los[i] <= 0 and 0 <= his[i]:
                        has0 = true
                    if los[i] <= 1 and 1 <= his[i]:
                        has1 = true
                if not has0 or not has1:
                    _cerr(&cs, "a match on a bool must cover both true and false, or carry a `_` arm")
        return
    cs.line = l
    if st == "string" or st == "bytes" or st == "float":
        _cerr(&cs, "match on " + st + " is refused: nothing in the tree dispatches on it -- use if/elif (see docs/internals/design-scalar-match.md D1)")
    else:
        _cerr(&cs, "match expects an Option, Result, or enum value, or an int/char/bool, got " + st)
    for a in arms:
        m := _vmark(&cs)
        _tblock(&cs, a.body)
        _vrestore(&cs, m)

# (found, value) for an int `const` by the name written at a match arm.
fn _const_int(cs: inout C, name: string) -> [int]:
    out := []int
    push(out, 0)
    push(out, 0)
    k := ""
    if len(cs.prefix) > 0 and (cs.prefix + name) in cs.constv:
        k = cs.prefix + name
    elif name in cs.constv:
        k = name
    if len(k) == 0:
        return out
    out[0] = 1
    out[1] = cs.constv[k]
    return out

# ---------------------------------------------------------------- statements

fn _tblock(cs: inout C, body: [ast.Stmt]):
    m := _vmark(&cs)
    _ix9 := 0
    for s in body:
        # The recovery boundary is the STATEMENT (tests/diag/multi_error_one_fn):
        # the first error in one ends it, and the next statement starts clean.
        if cs.errbase >= 0:
            cs.errbase = len(cs.errs)
        _tstmt(&cs, s)
        _copylive_stmt(&cs, body, _ix9)
        _ix9 += 1
    _vrestore(&cs, m)

# The type an if/match VALUE block produces, and the rule that its branches must
# agree (src/tychoc.c:8272). The parser rewrote each tail into a Decl/Assign of
# the same target, so the branch types are read back off those tails.
fn _value_type(cs: inout C, body: [ast.Stmt], want: string) -> string:
    if len(body) == 0:
        return "?"
    # ONLY the last statement is the tail. A value arm may be a whole block
    # (tests/if_expr_block.ty), whose leading `:=` statements bind branch-locals
    # -- reading their types as branch results reported `int and string` for a
    # program src/tychoc.c accepts.
    m := _vmark(&cs)
    for i := 0; i < len(body) - 1; i += 1:
        _tstmt(&cs, body[i])
    t := _tail_type(&cs, body[len(body) - 1], want)
    _vrestore(&cs, m)
    return t

fn _tail_type(cs: inout C, s: ast.Stmt, want: string) -> string:
    match s:
        ast.Decl(l, n, ty, rhs, vb):
            if len(rhs) == 1:
                return _ex2(&cs, rhs[0], want)
            return "?"
        ast.Assign(l, n, rhs): return _ex2(&cs, rhs[0], want)
        ast.ExprStmt(l, k): return _ex2(&cs, k[0], want)
        ast.IfS(l, c, b, e):
            t := _ex(&cs, c[0])
            cs.line = l
            if known(t) and t != "bool":
                _cerr(&cs, "if condition must be bool")
            m := _vmark(&cs)
            ta := _value_type(&cs, b, want)
            _vrestore(&cs, m)
            m2 := _vmark(&cs)
            tb := _value_type(&cs, e, want)
            bl := cs.line                  # the disagreeing branch's own line
            _vrestore(&cs, m2)
            if ta == "?":
                return tb
            if tb != "?" and not compat(ta, tb):
                cs.line = bl
                _cerr(&cs, "if/match branches produce different types (" + ta + " and " + tb + ")")
            return ta
        ast.MatchS(l, subj, arms):
            _match(&cs, l, subj, arms)
            return "?"
        _:
            _tstmt(&cs, s)
            return "?"
    return "?"

# The roots src/tychoc.c@is_lvalue accepts. A CALL is one only when it names a
# declared `subscript` -- `b.get().v[0] = 9` is a call on a TEMPORARY and is
# refused (tests/reject/place_call_receiver.ty), and a tuple element is not an
# index-assign root at all.
fn _is_place(cs: inout C, e: ast.Expr) -> bool:
    match e:
        ast.Name(l, n): return true
        ast.Field(l, k, f): return _is_place(&cs, k[0])
        ast.Index(l, k): return _is_place(&cs, k[0])
        ast.Call(l, q, n, ts, a): return n in cs.subs
        _: return false
    return false

fn _place_ty(cs: inout C, e: ast.Expr) -> string:
    match e:
        ast.Index(l, k):
            rt := _base(&cs, _ex(&cs, k[0]))
            h := _head(rt)
            cs.line = l
            if rt == "string":
                _cerr(&cs, "cannot index-assign an element of string (it is immutable)")
                return "?"
            if _head(rt) == "tup" or (known(rt) and not (_is_arr(rt) or h == "map" or h == "soa")) or
                    not _is_place(&cs, k[0]):
                _cerr(&cs, "can only index-assign an array or map variable or field")
                return "?"
            it := _ex(&cs, k[1])
            cs.line = l
            if h == "map":
                kt := _targs(rt)[0]
                if not compat(kt, it):
                    _cerr(&cs, "map key must be " + _show(&cs, kt) + ", got " + _show(&cs, it))
                return _targs(rt)[1]
            return _elem_of(&cs, rt)
        ast.Field(l, k, f):
            if not _is_place(&cs, k[0]):
                cs.line = l
                _cerr(&cs, "cannot assign to a field of a temporary (only variables, fields, and composite-array elements are places)")
                return "?"
            return _ex(&cs, e)
        _: return _ex(&cs, e)
    return "?"

# src/tychoc.c@is_pure_builtin, copied name for name.
fn _pure_builtin(n: string) -> bool:
    return n == "str" or n == "substr" or n == "chr" or n == "split" or n == "keys" or
        n == "find" or n == "char_at" or n == "map_get" or n == "map_has" or
        n == "map_set" or n == "map_del" or n == "sqrt" or n == "pow" or n == "floor" or
        n == "fabs" or n == "to_float" or n == "to_int" or n == "to_char" or
        n == "to_str" or n == "to_bool" or n == "is_null" or n == "len" or n == "hash"

fn _tstmt(cs: inout C, s: ast.Stmt):
    cs.line = ast.sline_of(s)
    match s:
        ast.ExprStmt(l, k):
            # src/tychoc.c@is_pure_builtin -- a pure builtin has no side effect, so
            # discarding its result in statement position does nothing at all.
            # `map_set(m, k, v)` as a bare statement is the footgun this names: it
            # returns a NEW map and changes nothing.
            match k[0]:
                ast.Call(l2, q2, n2, ts2, ar2):
                    # `m.get(k, d)` parses as a QUALIFIED call, q = the receiver.
                    # src/tychoc.c@discarded_map_get gates it on a map receiver, which
                    # keeps a user `get` on some other type quiet.
                    if n2 == "get" and len(q2) > 0 and _head(_ex(&cs, ast.Name(l2, q2))) == "map":
                        cs.line = l
                        _cwarn(&cs, "result of `get` is discarded; it has no side effects," +
                            " so this statement does nothing (to change a map, use" +
                            " `m[k] = v` or `delete m[k]`)")
                    if len(q2) == 0 and _pure_builtin(n2):
                        cs.line = l
                        _cwarn(&cs, "result of `" + n2 + "` is discarded; it has no side" +
                            " effects, so this statement does nothing (to change a map," +
                            " use `m[k] = v` or `delete m[k]`)")
                _: pass
            t := _ex(&cs, k[0])
            # A Result used as a statement throws the error path away.
            if len(t) > 4 and t[0:4] == "res(":
                cs.line = l
                _cwarn(&cs, "this Result is discarded, so its error is silently ignored;" +
                    " handle it with `match`, propagate with `or_return`, or bind it (x := ...)")
            if (k[0] is ast.OrRet) and t != "void" and known(t):
                cs.line = l
                _cerr(&cs, "`or_return` here produces " + t + ", which this statement discards -- bind it (x := ... or_return)")
        ast.Decl(l, name, ty, rhs, vb):
            want := "?"
            if len(ty) == 1:
                want = _enc(&cs, ty[0])
            t := "?"
            if len(rhs) == 1:
                cs.chan_decl = true
                t = _ex2(&cs, rhs[0], want)
                cs.chan_decl = false
            elif len(vb) > 0:
                t = _value_type(&cs, vb, want)
            cs.line = l
            if len(rhs) == 1:
                _aff_bind_check(&cs, t, rhs[0])
            if not compat(want, t):
                _cerr(&cs, "declared type " + _show(&cs, want) + " but value is " + _show(&cs, t))
            if len(ty) == 0 and len(rhs) == 1:
                _bare_result(&cs, t, rhs[0])
            if want == "f32" and len(rhs) == 1:
                _f32_fits(&cs, rhs[0])
            if t == "void":
                _cerr(&cs, "cannot bind a void value")
                t = "?"
            if len(ty) == 1:
                t = want
            _tnote(&cs, "d:" + t)
            if cs.symon:
                push(cs.symrows, cs.symfnm + "\nlocal\t" + name + "\t" + _show(&cs, t) + "\t" +
                    str(cs.symfn) + "\t" + str(l))
            _vpush(&cs, name, t, true)
        ast.MDecl(l, isdecl, names, rhs):
            t := "?"
            if len(rhs) == 1:
                t = _base(&cs, _ex(&cs, rhs[0]))
            els := _targs(t)
            cs.line = l
            for i := 0; i < len(names); i += 1:
                et := "?"
                if _head(t) == "tup" and i < len(els):
                    et = els[i]
                if isdecl:
                    _tnote(&cs, "m:" + et)
                    if cs.symon:
                        push(cs.symrows, cs.symfnm + "\nlocal\t" + names[i] + "\t" + _show(&cs, et) +
                            "\t" + str(cs.symfn) + "\t" + str(l))
                    _vpush(&cs, names[i], et, true)
                else:
                    _assign_check(&cs, names[i], et)
        ast.Assign(l, name, rhs):
            vt := _vtype(&cs, name)
            want := "?"
            if len(vt) > 0:
                want = vt
            t := _ex2(&cs, rhs[0], want)
            cs.line = l
            _aff_reassign_check(&cs, name, want)
            _assign_check(&cs, name, t)
        ast.PlaceSet(l, k):
            pt := _place_ty(&cs, k[0])
            vt := _ex2(&cs, k[1], pt)
            cs.line = l
            if not compat(pt, vt):
                if k[0] is ast.Field:
                    _cerr(&cs, "cannot assign " + vt + " to a " + pt + " field")
                else:
                    _cerr(&cs, "cannot assign " + vt + " to a " + pt + " element")
        ast.ConstS(l, name, v):
            t := _ex(&cs, v[0])
            cs.line = l
            _vpush(&cs, name, t, false)
        ast.ReturnS(l, k):
            if len(k) == 1:
                t := _ex2(&cs, k[0], cs.ret)
                cs.line = l
                if not compat(t, cs.ret):
                    _cerr(&cs, "returning " + t + " but proc returns " + cs.ret)
        ast.DeleteS(l, k): _exs(&cs, k)
        ast.IfS(l, c, b, e):
            t := _ex(&cs, c[0])
            cs.line = l
            if known(t) and t != "bool":
                _cerr(&cs, "if condition must be bool")
            _tblock(&cs, b)
            _tblock(&cs, e)
        ast.WhileS(l, c, b):
            cs.loopd = cs.loopd + 1
            if len(c) == 1:
                t := _ex(&cs, c[0])
                cs.line = l
                if known(t) and t != "bool":
                    _cerr(&cs, "for condition must be bool")
            _tblock(&cs, b)
            cs.loopd = cs.loopd - 1
        ast.For3(l, init, c, b):
            cs.loopd = cs.loopd + 1
            m := _vmark(&cs)
            for st in init:
                _tstmt(&cs, st)
            if len(c) == 1:
                t := _ex(&cs, c[0])
                cs.line = l
                if known(t) and t != "bool":
                    _cerr(&cs, "for condition must be bool")
            _tblock(&cs, b)
            _vrestore(&cs, m)
            cs.loopd = cs.loopd - 1
        ast.ForIn(l, v, coll, b):
            cs.loopd = cs.loopd + 1
            ct := _base(&cs, _ex(&cs, coll[0]))
            cs.line = l
            et := "?"
            h := _head(ct)
            if h == "map":
                _cerr(&cs, "a map is not directly iterable -- `for k in m` indexes it by position. Loop over `keys(m)` instead: `for k in keys(m):`")
            elif _is_arr(ct) or h == "soa":
                et = _elem_of(&cs, ct)
            elif ct == "string" or ct == "bytes":
                et = "int"
            elif h == "chan":
                et = _targs(ct)[0]
            m := _vmark(&cs)
            _tnote(&cs, "i:" + et)
            _vpush(&cs, v, et, true)
            _tblock(&cs, b)
            _vrestore(&cs, m)
            cs.loopd = cs.loopd - 1
        ast.ForRange(l, v, bounds, b):
            _parfor_check(&cs, l, v, b)
            cs.loopd = cs.loopd + 1
            for x in bounds:
                _ex(&cs, x)
            m := _vmark(&cs)
            cs.line = l
            _vpush(&cs, v, "int", false)
            _tblock(&cs, b)
            _vrestore(&cs, m)
            cs.loopd = cs.loopd - 1
        ast.ParallelS(l, w, b):
            _exs(&cs, w)
            for st in b:
                _tstmt(&cs, st)
        ast.MatchS(l, subj, arms): _match(&cs, l, subj, arms)
        ast.SelectS(l, arms):
            for a in arms:
                m := _vmark(&cs)
                _exs(&cs, a.ch)
                for bnd in a.binds:
                    _vpush(&cs, bnd, "?", true)
                _tblock(&cs, a.body)
                _vrestore(&cs, m)
        _: pass

fn _assign_check(cs: inout C, name: string, t: string):
    vt := _vtype(&cs, name)
    if len(vt) == 0:
        return
    if not compat(vt, t):
        _cerr(&cs, "cannot assign " + t + " to '" + name + "' of type " + vt)

# ---------------------------------------------------------------- the pass

fn _fill_decls(cs: inout C, p: Program):
    for f in p.files:
        cs.file = f.path
        cs.prefix = f.prefix
        cs.imports = f.unit.imports
        for d in _sorted_decls(f.unit):
            if d.cat == 1:
                sd := f.unit.structs[d.idx]
                _typarams_of(&cs, sd.typarams)
                cs.skip = len(sd.typarams) > 0
                fn_ := []string
                ft := []string
                for fl in sd.fields:
                    cs.line = fl.line
                    push(fn_, fl.name)
                    fty := _enc(&cs, fl.ty)
                    push(ft, fty)
                    _field_aff(&cs, sd.line, fty)
                    if _has_sizeparam(fl.ty):
                        cs.line = sd.line
                        _cperr(&cs, "a struct field cannot be a `[$N]T` size-parameterized array -- use a fixed `[N]T` or a dynamic `[T]`")
                i := cs.tindex[f.prefix + sd.name]
                cs.tds[i].fnames = fn_
                cs.tds[i].ftypes = ft
            elif d.cat == 2:
                ed := f.unit.enums[d.idx]
                _typarams_of(&cs, ed.typarams)
                cs.skip = len(ed.typarams) > 0
                vn := []string
                vt := []string
                for v in ed.variants:
                    cs.line = v.line
                    pay := ""
                    for k := 0; k < len(v.payload); k += 1:
                        if k > 0:
                            pay = pay + "|"
                        pt_ := _enc(&cs, v.payload[k])
                        pay = pay + pt_
                        if _head(pt_) == "chan":
                            cs.line = ed.line
                            _cperr(&cs, "an enum payload cannot be a channel")
                        if _has_sizeparam(v.payload[k]):
                            cs.line = ed.line
                            _cperr(&cs, "an enum payload cannot be a `[$N]T` size-parameterized array -- use a fixed `[N]T` or a dynamic `[T]`")
                        cs.line = v.line
                    push(vn, v.name)
                    push(vt, pay)
                    cs.vpay[f.prefix + v.name] = pay
                i := cs.tindex[f.prefix + ed.name]
                cs.tds[i].fnames = vn
                cs.tds[i].ftypes = vt
            elif d.cat == 3:
                nd := f.unit.newtypes[d.idx]
                cs.line = nd.line
                cs.skip = false
                u := []string
                ut := _enc(&cs, nd.under)
                push(u, ut)
                if _head(ut) == "chan":
                    _cperr(&cs, "a newtype cannot wrap a channel")
                elif _has_sizeparam(nd.under):
                    _cperr(&cs, "a newtype cannot wrap a `[$N]T` size-parameterized array")
                else:
                    _newtype_check(&cs, ut)
                i := cs.tindex[f.prefix + nd.name]
                cs.tds[i].ftypes = u
            elif d.cat == 5:
                cd := f.unit.consts[d.idx]
                cs.line = cd.line
                cs.skip = false
                cs.consts[f.prefix + cd.name] = _ex(&cs, cd.value)
                match cd.value:
                    ast.IntLit(cl, cv): cs.constv[f.prefix + cd.name] = cv
                    ast.CharLit(cl, cv): cs.constv[f.prefix + cd.name] = cv
                    _: pass
            elif d.cat == 6:
                sb := f.unit.subscripts[d.idx]
                cs.subs[sb.name] = true
                cs.line = sb.line
                if len(sb.params) > 0 and len(sb.params[0].ty) == 1 and _ty_generic_inst(&cs, sb.params[0].ty[0]):
                    _cperr(&cs, "a subscript receiver may not be generic: declare the subscript on a concrete instance")
                _typarams_of(&cs, []string)
                cs.skip = false
                rt2 := _enc(&cs, sb.ret)
                mk2 := _vmark(&cs)
                for pm in sb.params:
                    for tt in pm.ty:
                        _vpush(&cs, pm.name, _enc(&cs, tt), true)
                kia := cs.in_arg
                cs.in_arg = true       # the yielded place is written `&expr`
                pt2 := _place_ty(&cs, sb.place)
                cs.in_arg = kia
                _vrestore(&cs, mk2)
                cs.line = sb.line
                if known(rt2) and known(pt2) and not compat(rt2, pt2):
                    _cperr(&cs, "subscript '" + sb.name + "' is declared `-> inout " + rt2 + "` but yields a place of type " + pt2)
                cs.skip = true
            else:
                # NOT `fd := f.unit.fns[d.idx]` -- binding the element deep-copies
                # the whole Fn, body and all, once per declaration in the program.
                cs.skip = len(f.unit.fns[d.idx].typarams) > 0
                _addsig(&cs, _sig_of(&cs, f.prefix, f.unit.fns[d.idx]))
                cs.line = f.unit.fns[d.idx].line
                if len(f.unit.fns[d.idx].params) > 16 and len(f.unit.fns[d.idx].typarams) == 0 and
                        len(_sig_sizeparams(f.unit.fns[d.idx].params, f.unit.fns[d.idx].ret)) == 0:
                    _cerr(&cs, "too many parameters (max 16)")
                if len(_dedup6(f.unit.fns[d.idx].typarams)) > 16:
                    _cperr(&cs, "too many type parameters (max 16)")
                if len(_sig_sizeparams(f.unit.fns[d.idx].params, f.unit.fns[d.idx].ret)) > 16:
                    _cperr(&cs, "too many size parameters (max 16)")
            cs.skip = false
            _typarams_of(&cs, []string)

# src/tychoc.c:12683 -- a struct that contains itself BY VALUE has no size. An
# array, map or Option breaks the cycle; a tuple, a fixed array and a plain
# field do not.
fn _contains(cs: inout C, t: string, target: string, seen: [string: bool]) -> bool:
    h := _head(t)
    if h == "tup" or h == "fix":
        for a in _targs(t):
            if _contains(&cs, a, target, seen) and _head(a) != "?":
                return true
        return false
    i := _tdecl(&cs, t)
    if i < 0:
        return false
    if t == target:
        return true
    if t in seen:
        return false
    s2 := seen
    s2[t] = true
    # read in place: this is a whole declaration, and only fields are wanted
    if cs.tds[i].kind != "struct" and cs.tds[i].kind != "newtype":
        return false
    for ft in cs.tds[i].ftypes:
        if _contains(&cs, ft, target, s2):
            return true
    return false

fn _infinite_check(cs: inout C):
    best := -1
    for i := 0; i < len(cs.tds); i += 1:
        # read in place: this is a whole declaration, and only fields are wanted
        if cs.tds[i].kind != "struct" or cs.tds[i].generic:
            continue
        for ft in cs.tds[i].ftypes:
            if _contains(&cs, ft, "@" + cs.tds[i].name, []string: bool):
                # A MUTUAL cycle makes every struct in it infinite; src/tychoc.c
                # dies on the declaration that CLOSES the cycle, which is the
                # last one read (tests/reject/struct_mutual_by_value.ty:6).
                if best < 0 or cs.tds[i].line > cs.tds[best].line:
                    best = i
                break
    if best >= 0:
        cs.file = cs.tds[best].file
        cs.line = cs.tds[best].line
        _cerr(&cs, "infinite type: " + cs.tds[best].name + " contains itself by value -- use an array ([" + cs.tds[best].name + "]) or Option([" + cs.tds[best].name + "]) for indirection")

# --symbols wants the INFERRED type of every local, which only the checker
# knows. Same walk as check(), with the recording switched on.
fn check_syms(p: Program) -> [string]:
    cs := check_on(p, true)
    return cs.symrows

fn check(p: Program) -> C:
    return check_on(p, false)

fn check_on(p: Program, syms: bool) -> C:
    cs := C([]string, -1, []string: bool, []string: bool, 0, []string, []string, []TDecl, []string: int, []FSig, []string: int, []string: string, []string: string,
            []string: string, []string: int, []string: bool, []string: string, []string: bool, []VBind, 0, []string, []string,
            []string: int, "", 0, "", "?", false, false, []ast.ImportD, []ast.ImportD, false, 0, 0, false, 0, []string: int, []string: bool, []string: bool, 0, 0, false, []string, []string, false, 0, "")
    cs.symon = syms
    for f in p.files:
        push(cs.srcp, f.path)
        push(cs.srct, f.src)
        for im in f.unit.imports:
            push(cs.all_imports, im)
    _builtin_sigs_t(&cs)
    _register(&cs, p)
    cs.ntd0 = len(cs.tds)
    _fill_decls(&cs, p)
    _infinite_check(&cs)
    for f in p.files:
        cs.file = f.path
        cs.prefix = f.prefix
        cs.imports = f.unit.imports
        for fd in f.unit.fns:
            if fd.is_extern or len(fd.typarams) > 0:
                continue
            si := _sigidx(&cs, f.prefix + fd.name)
            if si < 0:
                continue
            cs.line = fd.line
            cs.symfn = fd.line
            cs.symfnm = f.prefix + fd.name
            cs.ment = _mentions(fd.body)
            cs.sinkp = []string: bool
            cs.parms = []string: bool
            cs.loopd = 0
            for pm in fd.params:
                cs.parms[pm.name] = true
                if pm.is_sink:
                    cs.sinkp[pm.name] = true
            m := _vmark(&cs)
            for i := 0; i < len(fd.params); i += 1:
                t := cs.sg[si].ptypes[i]
                if cs.sg[si].pflags[i] == "var":
                    t = "arr(" + t + ")"
                _tnote(&cs, "p:" + t)
                _vpush(&cs, fd.params[i].name, t, false)
            cs.ret = cs.sg[si].ret
            _tnote(&cs, "r:" + cs.ret)
            cs.paramset = []string: bool
            for pnm in cs.sg[si].pnames:
                cs.paramset[pnm] = true
            cs.errbase = len(cs.errs)
            _tblock(&cs, fd.body)
            cs.errbase = -1
            _vrestore(&cs, m)
            cs.ret = "?"
    # `main`: src/tychoc.c:9310 and :9313, a whole-program rule like `no 'main'`.
    mi := _sigidx(&cs, "main")
    if mi >= 0:
        cs.file = cs.sg[mi].file
        cs.line = cs.sg[mi].line
        if len(cs.sg[mi].ptypes) > 0:
            _cerr(&cs, "'main' takes no parameters -- the command line arrives through the `args()` builtin")
        r := cs.sg[mi].ret
        if r != "void" and r != "res(void,string)" and known(r):
            _cerr(&cs, "'main' returns nothing or Result(void, string), not " + r +
                " -- an Err reaching the entry point is printed, so the error type is the message." +
                " For a status other than 0 or 1 (diff(1)'s 0/1/2, say), call the `exit(code)` builtin")
    for e in cs.errs:
        push(cs.perrs, e)
    cs.errs = cs.perrs
    return cs

fn check_errs(cs: C) -> [string]:
    return cs.errs

fn check_warns(cs: C) -> [string]:
    return cs.cwarns

fn check_census(cs: C) -> [string]:
    names := keys(cs.counts)
    sort.asc(names)
    out := []string
    for n in names:
        push(out, n + " " + str(cs.counts[n]))
    return out

# A type NAME carrying arguments is a generic instance -- of a declared generic,
# or of nothing at all, which is `unknown type` exactly as the bare form is.
fn _known_generic(cs: inout C, q: string, n: string) -> bool:
    if len(q) > 0:
        return (_prefix_of(&cs, q) + n) in cs.tindex
    if len(cs.prefix) > 0 and (cs.prefix + n) in cs.tindex:
        return true
    return (n in cs.tindex) or (n in cs.typarams)

fn _shape_builtin(n: string) -> bool:
    if n == "len" or n == "push" or n == "pop" or n == "keys" or n == "reserve":
        return true
    return n == "str" or n == "hash" or n == "to_under" or len(_sized_conv(n)) > 0

# One side of an Option/Result match, when its arms REFINED the payload: every
# variant of the payload enum must appear, and the diagnostic names the missing
# one rather than the side.
fn _side_cov(cs: inout C, l: int, pay: string, cov: [string: bool], refined: bool):
    if not refined:
        return
    ti := _tdecl(&cs, _base(&cs, pay))
    if ti < 0 or cs.tds[ti].kind != "enum":
        return
    for v in cs.tds[ti].fnames:
        if not (v in cov):
            cs.line = l
            _cerr(&cs, "non-exhaustive match: missing variant " + v + " of " + cs.tds[ti].name)
            return

# The nested variant an Option/Result arm refines, or "". `Err(Sized(n, why))`
# parses as a `sub`; `Err(Nope)` -- a NULLARY variant -- parses as a single
# BINDING, and src/tychoc.c@match_arm_payload promotes it the same way. Reading
# only the first form reported six accepted files as non-exhaustive.
fn _nested_of(cs: inout C, a: ast.Arm, pay: string) -> string:
    if len(a.sub) > 0:
        return a.sub
    if len(a.binds) != 1:
        return ""
    ti := _tdecl(&cs, _base(&cs, pay))
    if ti < 0 or cs.tds[ti].kind != "enum":
        return ""
    for v in cs.tds[ti].fnames:
        if v == a.binds[0]:
            return v
    return ""

# Does this PROGRAM use anything Phase 6b owns -- a generic, a newtype, a handle
# or a `bounded`? Every such construct is answered `?` here, so the number of
# files this is true of is the size of what 6a defers, and it is printed by
# `--typecheck` rather than left implicit. Phase 6b watches it fall.
fn check_uses6b(cs: C) -> bool:
    return cs.uses6b
