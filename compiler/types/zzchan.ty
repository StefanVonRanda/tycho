package types

import "core:io"
import "core:strings"
import "../ast"

# CC-6, the channel-liveness lint (src/tychoc.c@check_channel_liveness). For
# every `ch := channel(T, n)` the whole program is scanned for what is done to
# that handle -- following it into callees under the parameter name it arrives
# as -- and three shapes are reported: a receive with no sender anywhere, a send
# with no receiver, and a `closed:` arm (which is what `parallel for x in ch`
# desugars to) on a channel nothing closes.
#
# Anything the scan cannot follow (a builtin, an extern, a generic template, a
# variadic) makes the channel OPAQUE and silences it: a warning that fires on a
# handle whose uses were not all seen would be a guess.
#
# This file sorts after resolve.ty on purpose -- it uses that file's `R`.

struct CU:
    send: bool
    recv: bool
    recv_block: bool
    close: bool
    closed_line: int
    opaque: bool

fn _cis(e: ast.Expr, nm: string) -> bool:
    match e:
        ast.Name(l, n): return n == nm
        _: return false
    return false

fn _cfn(fns: [ast.Fn], n: string) -> int:
    for i := 0; i < len(fns); i += 1:
        if fns[i].name == n and not fns[i].is_extern and len(fns[i].typarams) == 0:
            return i
    return -1

fn _cwalk(fns: [ast.Fn], fi: int, nm: string, u: inout CU, seen: inout [string: bool]):
    k := fns[fi].name + "|" + nm
    if k in seen:
        return
    seen[k] = true
    _cbody(fns, fns[fi].body, nm, &u, &seen)

fn _ccall(fns: [ast.Fn], l: int, q: string, n: string, args: [ast.Expr], nm: string,
        u: inout CU, seen: inout [string: bool]):
    # `ch.send(v)` parses with the channel as the QUALIFIER; `send(ch, v)` has it
    # as the first argument. Both are the same operation.
    if q == nm or (len(args) >= 1 and _cis(args[0], nm) and len(q) == 0):
        if n == "send":
            u.send = true
            return
        if n == "recv":
            u.recv = true
            u.recv_block = true
            return
        if n == "close":
            u.close = true
            return
    passes := false
    for a in args:
        if _cis(a, nm):
            passes = true
    if not passes:
        return
    fi := _cfn(fns, n)
    if fi < 0 or len(args) > len(fns[fi].params):
        u.opaque = true
        return
    for i := 0; i < len(args); i += 1:
        if _cis(args[i], nm):
            if fns[fi].params[i].is_variadic:
                u.opaque = true
                return
            _cwalk(fns, fi, fns[fi].params[i].name, &u, &seen)

fn _cexpr(fns: [ast.Fn], e: ast.Expr, nm: string, u: inout CU, seen: inout [string: bool]):
    match e:
        ast.Call(l, q, n, ts, args): _ccall(fns, l, q, n, args, nm, &u, &seen)
        _: pass
    for c in ast.kids(e):
        _cexpr(fns, c, nm, &u, &seen)

fn _cexprs(fns: [ast.Fn], es: [ast.Expr], nm: string, u: inout CU, seen: inout [string: bool]):
    for e in es:
        _cexpr(fns, e, nm, &u, &seen)

fn _csel(fns: [ast.Fn], l: int, arms: [ast.Arm], nm: string, u: inout CU, seen: inout [string: bool]):
    mine := false
    closed_arm := false
    dflt := false
    for a in arms:
        if len(a.ch) > 0:
            _cexprs(fns, a.ch, nm, &u, &seen)
            if _cis(a.ch[0], nm):
                u.recv = true
                mine = true
        if a.kind == "closed":
            closed_arm = true
        if a.kind == "default":
            dflt = true
    if mine and not dflt:
        u.recv_block = true
    if mine and closed_arm and u.closed_line == 0:
        u.closed_line = l

fn _cbody(fns: [ast.Fn], body: [ast.Stmt], nm: string, u: inout CU, seen: inout [string: bool]):
    for s in body:
        match s:
            ast.ExprStmt(l, k): _cexprs(fns, k, nm, &u, &seen)
            ast.Decl(l, n, t, r, v):
                _cexprs(fns, r, nm, &u, &seen)
                _cbody(fns, v, nm, &u, &seen)
            ast.MDecl(l, d, ns, r): _cexprs(fns, r, nm, &u, &seen)
            ast.Assign(l, n, r): _cexprs(fns, r, nm, &u, &seen)
            ast.PlaceSet(l, k): _cexprs(fns, k, nm, &u, &seen)
            ast.ConstS(l, n, k): _cexprs(fns, k, nm, &u, &seen)
            ast.ReturnS(l, k): _cexprs(fns, k, nm, &u, &seen)
            ast.IfS(l, c, b, e):
                _cexprs(fns, c, nm, &u, &seen)
                _cbody(fns, b, nm, &u, &seen)
                _cbody(fns, e, nm, &u, &seen)
            ast.WhileS(l, c, b):
                _cexprs(fns, c, nm, &u, &seen)
                _cbody(fns, b, nm, &u, &seen)
            ast.For3(l, ip, c, b):
                _cbody(fns, ip, nm, &u, &seen)
                _cexprs(fns, c, nm, &u, &seen)
                _cbody(fns, b, nm, &u, &seen)
            ast.ForIn(l, n, coll, b):
                # `for x in ch:` is a blocking drain, and the parallel form ends
                # only on close -- which is the `closed:` arm src/tychoc.c
                # desugars it into.
                if len(coll) > 0 and _cis(coll[0], nm):
                    u.recv = true
                    u.recv_block = true
                _cexprs(fns, coll, nm, &u, &seen)
                _cbody(fns, b, nm, &u, &seen)
            ast.ForRange(l, n, k, b):
                _cexprs(fns, k, nm, &u, &seen)
                _cbody(fns, b, nm, &u, &seen)
            ast.ParallelS(l, w, b):
                _cexprs(fns, w, nm, &u, &seen)
                for st in b:
                    match st:
                        ast.ForIn(l2, n2, coll, b2):
                            if len(coll) > 0 and _cis(coll[0], nm) and u.closed_line == 0:
                                u.closed_line = l
                        _: pass
                _cbody(fns, b, nm, &u, &seen)
            ast.MatchS(l, c, arms):
                _cexprs(fns, c, nm, &u, &seen)
                for a in arms:
                    _cbody(fns, a.body, nm, &u, &seen)
            ast.SelectS(l, arms):
                _csel(fns, l, arms, nm, &u, &seen)
                for a in arms:
                    _cbody(fns, a.body, nm, &u, &seen)
            ast.DeleteS(l, k): _cexprs(fns, k, nm, &u, &seen)
            _: pass

fn _cdecls(rs: inout R, fns: [ast.Fn], owner: int, body: [ast.Stmt], file: string):
    for s in body:
        match s:
            ast.Decl(l, n, t, r, v):
                if len(r) > 0 and (r[0] is ast.ChanE):
                    u := CU(false, false, false, false, 0, false)
                    seen := []string: bool
                    _cbody(fns, fns[owner].body, n, &u, &seen)
                    if not u.opaque:
                        sf := rs.file
                        sl := rs.line
                        rs.file = file
                        rs.line = l
                        if u.recv_block and not u.send:
                            _warn(&rs, "nothing ever sends on channel '" + n +
                                "', so a receive on it parks forever")
                        elif u.send and not u.recv:
                            _warn(&rs, "nothing ever receives from channel '" + n +
                                "', so a send parks once its buffer fills")
                        if u.closed_line > 0 and not u.close:
                            rs.line = u.closed_line
                            _warn(&rs, "close(" + n + ") is never called, so this `closed:` arm can never run " +
                                "(a `parallel for` over a channel ends only when it is closed)")
                        rs.file = sf
                        rs.line = sl
                _cdecls(&rs, fns, owner, v, file)
            ast.IfS(l, c, b, e):
                _cdecls(&rs, fns, owner, b, file)
                _cdecls(&rs, fns, owner, e, file)
            ast.WhileS(l, c, b): _cdecls(&rs, fns, owner, b, file)
            ast.For3(l, ip, c, b): _cdecls(&rs, fns, owner, b, file)
            ast.ForIn(l, n, coll, b): _cdecls(&rs, fns, owner, b, file)
            ast.ForRange(l, n, k, b): _cdecls(&rs, fns, owner, b, file)
            ast.ParallelS(l, w, b): _cdecls(&rs, fns, owner, b, file)
            ast.MatchS(l, c, arms):
                for a in arms:
                    _cdecls(&rs, fns, owner, a.body, file)
            ast.SelectS(l, arms):
                for a in arms:
                    _cdecls(&rs, fns, owner, a.body, file)
            _: pass

fn check_channels(rs: inout R, p: Program):
    fns := []ast.Fn
    files := []string
    for f in p.files:
        for fd in f.unit.fns:
            push(fns, fd)
            push(files, f.path)
    for i := 0; i < len(fns); i += 1:
        if fns[i].is_extern or len(fns[i].typarams) > 0:
            continue
        _cdecls(&rs, fns, i, fns[i].body, files[i])

# --- the corelib hint (src/tychoc.c@corelib_hint) ----------------------------
# An unknown procedure that a corelib package DOES provide is the commonest
# newcomer error, and "unknown procedure 'sort'" says nothing about
# `import "core:arrays"`. The packages are scanned on disk, by line, exactly as
# the C compiler scans them -- no index is kept, because this runs only on the
# path that is already dying.

fn _cl_fn(ln: string) -> string:
    if not strings.starts_with(ln, "fn "):
        return ""
    p := 3
    for p < len(ln) and ln[p] == 32:
        p += 1
    s := p
    for p < len(ln):
        c := ln[p]
        if (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57) or c == 95:
            p += 1
        else:
            break
    if p == s or p >= len(ln) or ln[p] != 40:
        return ""
    return ln[s:p]

fn _cl_fns(dir: string) -> [string]:
    out := []string
    for f in list_dir(dir):
        if not strings.ends_with(f, ".ty"):
            continue
        match io.read_text(dir + "/" + f):
            Ok(txt):
                for ln in split(txt, "\n"):
                    nm := _cl_fn(ln)
                    if len(nm) > 0 and nm[0] != 95:
                        push(out, nm)
            Err(e): pass
    return out

fn corelib_hint(root: string, name: string) -> (string, bool):
    if len(root) == 0:
        return ("", false)
    pkg_match := ""
    fn_best := ""
    fn_pkg := ""
    fn_rank := 99
    lv_best := ""
    lv_pkg := ""
    lv_d := 99
    for pk in list_dir(root):
        if len(pk) == 0 or pk[0] == 46:
            continue
        pdir := root + "/" + pk
        fns := _cl_fns(pdir)
        if len(fns) == 0:
            continue
        if pk == name:
            pkg_match = pk
        for fnm in fns:
            rank := 99
            if fnm == name:
                rank = 0
            elif len(fnm) > len(name) + 1 and fnm[len(fnm) - len(name):] == name and
                    fnm[len(fnm) - len(name) - 1] == 95:
                rank = 1
            if rank < fn_rank:
                fn_rank = rank
                fn_best = fnm
                fn_pkg = pk
            ed := _edit(name, fnm)
            if ed < lv_d:
                lv_d = ed
                lv_best = fnm
                lv_pkg = pk
    if len(fn_best) > 0 and fn_rank <= 1:
        return ("core:" + fn_pkg + " provides `" + fn_best + "` -- add `import \"core:" + fn_pkg +
            "\"` and call `" + fn_pkg + "." + fn_best + "(...)`", true)
    if len(pkg_match) > 0:
        ex := _cl_fns(root + "/" + pkg_match)
        if len(ex) > 0:
            return ("`" + pkg_match + "` is a corelib package -- add `import \"core:" + pkg_match +
                "\"` and call e.g. `" + pkg_match + "." + ex[0] + "(...)`", true)
        return ("`" + pkg_match + "` is a corelib package -- add `import \"core:" + pkg_match +
            "\"` and qualify its functions as `" + pkg_match + ".NAME(...)`", true)
    lim := 2
    if len(name) <= 4:
        lim = 1
    if len(lv_best) > 0 and lv_d <= lim:
        return ("core:" + lv_pkg + " has `" + lv_best + "` -- add `import \"core:" + lv_pkg +
            "\"` and call `" + lv_pkg + "." + lv_best + "(...)`", false)
    return ("", false)

# --- copy_live (src/tychoc.c@arg_into) ---------------------------------------
# A heap local put INTO an aggregate that is itself a call argument must be
# deep-copied when the local is still live afterwards -- move-on-last-use cannot
# hand off a buffer someone still reads. The copy is correct, just invisible, so
# it is a warning and not an error.
#
# Deliberately narrow, matching the C compiler's own gates: only a BARE local
# (not a parameter, which borrows the caller's buffer), only outside a loop
# (where even a last use must copy every iteration), and only when the aggregate
# is a call ARGUMENT (at a plain declaration the copy is the assignment the user
# wrote).

fn _heapish(t: string) -> bool:
    if t == "string" or t == "bytes":
        return true
    h := _head(t)
    return h == "arr" or h == "map" or h == "soa" or h == "tup" or h == "fix" or h == "bnd"

fn _agg_names(e: ast.Expr, out: inout [string]):
    match e:
        ast.Tuple(l, k): _agg_elems(k, &out)
        ast.ArrLit(l, k): _agg_elems(k, &out)
        ast.MapLit(l, k): _agg_elems(k, &out)
        ast.SomeE(l, k): _agg_elems(k, &out)
        ast.OkE(l, k): _agg_elems(k, &out)
        ast.ErrE(l, k): _agg_elems(k, &out)
        _: pass

fn _agg_elems(k: [ast.Expr], out: inout [string]):
    for e in k:
        match e:
            ast.Name(l, n): push(out, n)
            _: pass

# Every name READ anywhere in a statement -- the liveness question is only ever
# "does any LATER statement mention it".
fn _reads(e: ast.Expr, out: inout [string]):
    match e:
        ast.Name(l, n): push(out, n)
        _: pass
    for c in ast.kids(e):
        _reads(c, &out)

fn _reads_stmt(s: ast.Stmt, out: inout [string]):
    match s:
        ast.ExprStmt(l, k): _reads_all(k, &out)
        ast.Decl(l, n, t, r, v):
            _reads_all(r, &out)
            _reads_body(v, &out)
        ast.MDecl(l, d, ns, r): _reads_all(r, &out)
        ast.Assign(l, n, r):
            push(out, n)
            _reads_all(r, &out)
        ast.PlaceSet(l, k): _reads_all(k, &out)
        ast.ConstS(l, n, k): _reads_all(k, &out)
        ast.ReturnS(l, k): _reads_all(k, &out)
        ast.IfS(l, c, b, e):
            _reads_all(c, &out)
            _reads_body(b, &out)
            _reads_body(e, &out)
        ast.WhileS(l, c, b):
            _reads_all(c, &out)
            _reads_body(b, &out)
        ast.For3(l, ip, c, b):
            _reads_body(ip, &out)
            _reads_all(c, &out)
            _reads_body(b, &out)
        ast.ForIn(l, n, coll, b):
            _reads_all(coll, &out)
            _reads_body(b, &out)
        ast.ForRange(l, n, k, b):
            _reads_all(k, &out)
            _reads_body(b, &out)
        ast.ParallelS(l, w, b):
            _reads_all(w, &out)
            _reads_body(b, &out)
        ast.MatchS(l, c, arms):
            _reads_all(c, &out)
            for a in arms:
                _reads_body(a.body, &out)
        ast.SelectS(l, arms):
            for a in arms:
                _reads_all(a.ch, &out)
                _reads_body(a.body, &out)
        ast.DeleteS(l, k): _reads_all(k, &out)
        _: pass

fn _reads_all(k: [ast.Expr], out: inout [string]):
    for e in k:
        _reads(e, &out)

fn _reads_body(b: [ast.Stmt], out: inout [string]):
    for s in b:
        _reads_stmt(s, &out)

# The aggregates that are ARGUMENTS of a call inside this expression.
fn _call_aggs(e: ast.Expr, out: inout [string]):
    match e:
        ast.Call(l, q, n, ts, args):
            for a in args:
                _agg_names(a, &out)
        ast.CallVal(l, k):
            for i := 1; i < len(k); i += 1:
                _agg_names(k[i], &out)
        _: pass
    for c in ast.kids(e):
        _call_aggs(c, &out)

fn _copylive_stmt(cs: inout C, body: [ast.Stmt], i: int):
    if cs.loopd > 0:
        return
    cand := []string
    match body[i]:
        ast.ExprStmt(l, k):
            for e in k:
                _call_aggs(e, &cand)
        ast.Decl(l, n, t, r, v):
            for e in r:
                _call_aggs(e, &cand)
        ast.Assign(l, n, r):
            for e in r:
                _call_aggs(e, &cand)
        ast.ReturnS(l, k): return       # a return has no `afterwards`
        _: pass
    if len(cand) == 0:
        return
    later := []string
    for j := i + 1; j < len(body); j += 1:
        _reads_stmt(body[j], &later)
    for nm in cand:
        if nm in cs.paramset:
            continue                    # a parameter borrows the caller's buffer
        if not _heapish(_vtype(&cs, nm)):
            continue
        live := false
        for r in later:
            if r == nm:
                live = true
        if live:
            cs.line = ast.sline_of(body[i])
            _cwarn(&cs, "'" + nm + "' is copied into this aggregate because it is still live " +
                "afterwards; if you do not need it after this, make this its last use and the " +
                "copy goes away")
            return
