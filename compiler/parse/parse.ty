package parse

import "../ast"
import "core:io"
import "../lex"

# Tokens -> ast. The cursor is carried as an int and handed back with every
# node rather than living in a mutable parser struct, because a Tycho struct is
# a value and a `p.i += 1` inside a callee would not be seen by its caller.
#
# The grammar is src/tychoc.c's parser (src/tychoc.c:2040-4871), read rather
# than inferred from fixtures. Precedence, tightest first:
#   postfix > unary(- & ~) > * / % << >> & > + - | ^ > is > == != < > <= >= in
#          > not > and > or
# Everything src resolves as it parses -- a type name, a const's value, whether
# a struct is generic -- is left syntactic here; Phase 5 owns resolution.

# --- token helpers ----------------------------------------------------------

# Declaration-level error recovery. src/tychoc.c longjmps out of a failed
# declaration and resumes at the next one; Tycho has no unwind, so the failure
# is carried instead: the shapes that can be recognised WITHOUT parsing further
# record their message here, `func` returns immediately, and `unit` resyncs to
# the next declaration.
# gap: only a malformed RETURN TYPE recovers. Any other parse error is still
# fatal at the first one, so a second error later in the file is not reported.
struct PS:
    errs: [string]
    failed: bool

fn _at(toks: [lex.Tok], i: int) -> lex.Tok:
    if i >= len(toks):
        return toks[len(toks) - 1]
    if i < 0:
        return toks[0]
    return toks[i]

# These index DIRECTLY rather than through `_at`. `_at` returns a whole Tok by
# value, and a Tok carries four strings (text, raw, file, and its source line),
# every one of which is copied on the way out -- callgrind put that copy at 3.3%
# of a compile, and these three are the parser's hottest calls.
fn _cl(toks: [lex.Tok], i: int) -> int:
    if i >= len(toks):
        return len(toks) - 1
    if i < 0:
        return 0
    return i

# Comparing a token's kind or text WITHOUT materialising it: returning the field
# copies the string, and the parser asks these questions once per token per rule.
fn _kis(toks: [lex.Tok], i: int, s: int) -> bool:
    return toks[_cl(toks, i)].k == s

fn _xis(toks: [lex.Tok], i: int, s: string) -> bool:
    return toks[_cl(toks, i)].text == s

fn _k(toks: [lex.Tok], i: int) -> int:
    return toks[_cl(toks, i)].k

fn _x(toks: [lex.Tok], i: int) -> string:
    return toks[_cl(toks, i)].text

# The source line every node is stamped with: the line of the token the node
# starts at, which is the line src/tychoc.c names in `file:line: error: ...`.
fn _ln(toks: [lex.Tok], i: int) -> int:
    return toks[_cl(toks, i)].line

fn _isop(toks: [lex.Tok], i: int, s: int) -> bool:
    j := _cl(toks, i)
    return toks[j].k == lex.K_OP and toks[j].ival == s

fn _iskw(toks: [lex.Tok], i: int, s: int) -> bool:
    j := _cl(toks, i)
    return toks[j].k == lex.K_KW and toks[j].ival == s

fn _isid(toks: [lex.Tok], i: int, s: string) -> bool:
    return _kis(toks, i, lex.K_IDENT) and _xis(toks, i, s)

# A parse error reads like every other diagnostic: `file:line: error: msg` with
# the offending source line beneath it. The path rides on the token ARRAY -- one
# array is one file, so lex.file_of() reads it off the K_EOF token; it was on
# every token until 2026-08-26 and cost a string copy per token for this one cold
# read. `toks` was already in scope at all 73 _die sites.
# gap: a token lexed through tokenize()/tokenize_ex() carries no file, so those
# paths still print the bare `tychoc1: line N:` form. Only the compile path,
# which goes through lex.tokenize_file, is covered.
fn _where(toks: [lex.Tok], t: lex.Tok, msg: string, caret: bool) -> string:
    fl := lex.file_of(toks)
    if len(fl) == 0:
        return "tychoc1: line " + str(t.line) + ": " + msg
    out := fl + ":" + str(t.line) + ": error: " + msg
    if t.line <= 0:
        return out
    num := str(t.line)
    pad := ""
    for k := len(num); k < 6; k += 1:
        pad = pad + " "
    # No token carries its source text: a per-token source string cost 3.3% of
    # every compile. An error is rare, so the line is read from disk here.
    src := ""
    match io.read_text(fl):
        Ok(txt):
            ls := split(txt, "\n")
            if t.line >= 1 and t.line <= len(ls):
                src = ls[t.line - 1]
        Err(e): pass
    if len(src) == 0:
        return out
    out = out + "\n" + pad + num + " | " + src
    # The caret sits under the offending token (src/tychoc.c@src_snippet), and
    # ONLY where ./tychoc sets g_err_col: a token-shape mismatch in eat(), a
    # non-expression where one belongs, and a keyword used as a name. Putting it
    # on every parse error added it to 34 fixtures ./tychoc leaves bare.
    if caret and t.col > 0 and t.col <= len(src) + 1:
        sp := ""
        for k := 1; k < t.col; k += 1:
            sp = sp + " "
        out = out + "\n       | " + sp + "^"
    return out

fn _fail(toks: [lex.Tok], t: lex.Tok, want: string):
    die(_where(toks, t, "expected " + want + ", found " + lex.kname(t.k) + " '" + t.text + "'", true))

fn _die(toks: [lex.Tok], t: lex.Tok, msg: string):
    die(_where(toks, t, msg, false))

# The two `_die` sites ./tychoc carets (src/tychoc.c:3035 and :3740).
fn _diec(toks: [lex.Tok], t: lex.Tok, msg: string):
    die(_where(toks, t, msg, true))

fn _expect(toks: [lex.Tok], i: int, kind: int, text: string) -> int:
    # The whole token is only needed to REPORT. Reading the two fields directly
    # keeps the accepting path -- which is every token the parser consumes --
    # from copying a Tok and all four of its strings.
    if not _kis(toks, i, kind) or (len(text) > 0 and not _xis(toks, i, text)):
        t := _at(toks, i)
        if len(text) > 0:
            _fail(toks, t, "'" + text + "'")
        _fail(toks, t, lex.kname(kind))
    return i + 1

fn _op(toks: [lex.Tok], i: int, s: string) -> int:
    return _expect(toks, i, lex.K_OP, s)

fn _ident(toks: [lex.Tok], i: int, what: string) -> (string, int):
    # The accepting path -- every name the parser reads -- takes the text and
    # nothing else. The whole token is only built to report.
    if _kis(toks, i, lex.K_IDENT):
        return (_x(toks, i), i + 1)
    t := _at(toks, i)
    # One arm names them all, as in src/tychoc.c@eat: a keyword written where a
    # name belongs is reported as the keyword, not as a parse shape.
    kw := _kwname(t)
    if len(kw) > 0:
        _diec(toks, t, "'" + kw + "' is a reserved keyword and cannot be used as " + what)
    _fail(toks, t, what)
    return ("", i + 1)

# src/tychoc.c@reserved_kw: a keyword where a name was written.
fn _kwname(t: lex.Tok) -> string:
    if t.k == lex.K_KW:
        return t.text
    return ""

# --- types ------------------------------------------------------------------

fn _is_prim(s: string) -> bool:
    if s == "int" or s == "float" or s == "bool" or s == "string":
        return true
    if s == "ptr" or s == "bytes" or s == "u32" or s == "u64" or s == "f32":
        return true
    return s == "u8" or s == "u16" or s == "i8" or s == "i16" or s == "i32" or s == "i64"

# src/tychoc.c@tok_starts_type. Deliberately excludes `fn`, as it does there.
# The empty-ARRAY-literal path in parse_primary has its own list that DOES
# include `fn` (`[]fn(int) -> int`), which is what _starts_type_lit is.
fn _starts_type(toks: [lex.Tok], i: int) -> bool:
    if _kis(toks, i, lex.K_IDENT):
        return true
    if _kis(toks, i, lex.K_OP):
        return _xis(toks, i, "[") or _xis(toks, i, "$") or _xis(toks, i, "(")
    if _kis(toks, i, lex.K_KW):
        return _is_prim(_x(toks, i))
    return false

fn _starts_type_lit(toks: [lex.Tok], i: int) -> bool:
    if _iskw(toks, i, lex.KW_FN):
        return true
    return _starts_type(toks, i)

fn ty(toks: [lex.Tok], i0: int) -> (ast.Ty, int):
    ti := _cl(toks, i0)
    i := i0

    if toks[ti].k == lex.K_OP and toks[ti].text == "$":
        nm, j := _ident(toks, i + 1, "a type-parameter name after '$'")
        return (ast.TParam(nm), j)

    if toks[ti].k == lex.K_IDENT and toks[ti].text == "soa":
        i = _op(toks, i + 1, "[")
        el, j := ty(toks, i)
        i = _op(toks, j, "]")
        return (ast.TSoa([el]), i)

    if toks[ti].k == lex.K_IDENT and toks[ti].text == "bounded":
        i = _op(toks, i + 1, "[")
        cap := _at(toks, i)
        if cap.k != lex.K_INT and cap.k != lex.K_IDENT:
            _die(toks, cap, "bounded needs a capacity: bounded[N]T")
        i = _op(toks, i + 1, "]")
        el, j := ty(toks, i)
        return (ast.TBnd(cap.text, [el]), j)

    if toks[ti].k == lex.K_KW and toks[ti].text == "fn":
        i = _op(toks, i + 1, "(")
        ps := []ast.Ty
        for not _isop(toks, i, lex.OP_RPAREN):
            a, j := ty(toks, i)
            push(ps, a)
            i = j
            if not _isop(toks, i, lex.OP_COMMA):
                break
            i += 1
        i = _op(toks, i, ")")
        if len(ps) > 8:
            _die(toks, _at(toks, i0), "a function type has at most 8 parameters")
        if _isop(toks, i, lex.OP_ARROW):
            r, j := ty(toks, i + 1)
            push(ps, r)
            return (ast.TFn(true, ps), j)
        return (ast.TFn(false, ps), i)

    if toks[ti].k == lex.K_OP and toks[ti].text == "(":
        i += 1
        es := []ast.Ty
        a, j := ty(toks, i)
        push(es, a)
        i = j
        for _isop(toks, i, lex.OP_COMMA):
            b, k := ty(toks, i + 1)
            push(es, b)
            i = k
        i = _op(toks, i, ")")
        if len(es) < 2:
            _die(toks, _at(toks, i0), "a tuple type needs at least two elements; parentheses do not group a type, so write it bare")
        if len(es) > 8:
            _die(toks, _at(toks, i0), "a tuple has at most 8 elements")
        return (ast.TTup(es), i)

    if toks[ti].k == lex.K_OP and toks[ti].text == "[":
        i += 1
        # [$N]T -- a size parameter. `where` is excluded so a `[$T]` return type
        # followed by a where-clause is not read as a fixed-size array.
        if _isop(toks, i, lex.OP_DOLLAR) and _kis(toks, i + 1, lex.K_IDENT) and _isop(toks, i + 2, lex.OP_RBRACK) and
                _starts_type(toks, i + 3) and not _isid(toks, i + 3, "where"):
            nm := _x(toks, i + 1)
            el, j := ty(toks, i + 3)
            return (ast.TFix("$" + nm, [el]), j)
        # [N]T with a literal size, or [W]T naming an int const. The const form
        # is told from a dynamic [Foo] only by a type FOLLOWING the ']'.
        fixed := false
        sz := ""
        if _kis(toks, i, lex.K_INT) and _isop(toks, i + 1, lex.OP_RBRACK):
            fixed = true
            sz = _x(toks, i)
        elif _kis(toks, i, lex.K_IDENT) and _isop(toks, i + 1, lex.OP_RBRACK) and
                _starts_type(toks, i + 2) and not _isid(toks, i + 2, "where"):
            fixed = true
            sz = _x(toks, i)
        if fixed:
            if _kis(toks, i, lex.K_INT) and _at(toks, i).ival <= 0:
                _die(toks, _at(toks, i0), "a fixed-size array length must be positive")
            el, j := ty(toks, i + 2)
            return (ast.TFix(sz, [el]), j)
        el, j := ty(toks, i)
        i = j
        if _isop(toks, i, lex.OP_COLON):
            v, k := ty(toks, i + 1)
            i = _op(toks, k, "]")
            return (ast.TMap([el, v]), i)
        i = _op(toks, i, "]")
        return (ast.TArr([el]), i)

    if toks[ti].k == lex.K_IDENT:
        nm := toks[ti].text
        qual := ""
        i += 1
        if _isop(toks, i, lex.OP_DOT) and _kis(toks, i + 1, lex.K_IDENT):
            qual = nm
            nm = _x(toks, i + 1)
            i += 2
        args := []ast.Ty
        if len(qual) == 0 and (nm == "Option" or nm == "Channel"):
            i = _op(toks, i, "(")
            a, j := ty(toks, i)
            push(args, a)
            i = _op(toks, j, ")")
            return (ast.TName("", nm, args), i)
        if len(qual) == 0 and nm == "Result":
            i = _op(toks, i, "(")
            a, j := ty(toks, i)
            push(args, a)
            i = _op(toks, j, ",")
            b, k := ty(toks, i)
            push(args, b)
            i = _op(toks, k, ")")
            return (ast.TName("", nm, args), i)
        # a generic instance `Box(int)`. Nothing else can follow a complete type
        # name with a '(' in a type position.
        if _isop(toks, i, lex.OP_LPAREN):
            i += 1
            for not _isop(toks, i, lex.OP_RPAREN):
                a, j := ty(toks, i)
                push(args, a)
                i = j
                if not _isop(toks, i, lex.OP_COMMA):
                    break
                i += 1
            i = _op(toks, i, ")")
        return (ast.TName(qual, nm, args), i)

    if toks[ti].k == lex.K_KW and _is_prim(toks[ti].text):
        return (ast.TPrim(toks[ti].text), i + 1)

    _fail(toks, _at(toks, i0), "a type")
    return (ast.TPrim("int"), i0)

# --- expressions ------------------------------------------------------------

fn _args(toks: [lex.Tok], i0: int) -> ([ast.Expr], int):
    # a call's value-argument list, the '(' already consumed
    i := i0
    out := []ast.Expr
    for not _isop(toks, i, lex.OP_RPAREN):
        if _kis(toks, i, lex.K_IDENT) and _isop(toks, i + 1, lex.OP_COLON):
            nm := _x(toks, i)
            a := ast.NullLit(0)
            j := _expr_into(toks, i + 2, &a)
            push(out, ast.Named(_ln(toks, i), nm, [a]))
            i = j
        else:
            a := ast.NullLit(0)
            j := _expr_into(toks, i, &a)
            push(out, a)
            i = j
        if not _isop(toks, i, lex.OP_COMMA):
            break
        i += 1
    i = _op(toks, i, ")")
    return (out, i)

fn _typeargs(toks: [lex.Tok], i0: int, who: string) -> ([ast.Ty], int):
    # `$(T1, ...)`, the '$' already consumed
    i := _op(toks, i0, "(")
    out := []ast.Ty
    for not _isop(toks, i, lex.OP_RPAREN):
        a, j := ty(toks, i)
        push(out, a)
        i = j
        if not _isop(toks, i, lex.OP_COMMA):
            break
        i += 1
    i = _op(toks, i, ")")
    if len(out) == 0:
        _die(toks, _at(toks, i0), "'" + who + "$()' needs at least one explicit type argument")
    return (out, i)

fn _lambda(toks: [lex.Tok], i0: int) -> (ast.Expr, int):
    # `fn` already consumed; the node's line is the `fn` keyword, one back
    ln := _ln(toks, i0 - 1)
    ti := _cl(toks, i0)
    if toks[ti].k == lex.K_IDENT:
        _die(toks, _at(toks, i0), "a named function cannot be declared inside another -- declare '" +
            toks[ti].text + "' at the top level, or use a lambda 'fn(x): expr'")
    i := _op(toks, i0, "(")
    ps := []ast.Param
    for not _isop(toks, i, lex.OP_RPAREN):
        pln := _ln(toks, i)
        nm, j := _ident(toks, i, "a lambda parameter name")
        i = j
        pt := []ast.Ty
        if _isop(toks, i, lex.OP_COLON):
            a, k := ty(toks, i + 1)
            push(pt, a)
            i = k
        push(ps, ast.Param(nm, pt, false, false, false, pln))
        if not _isop(toks, i, lex.OP_COMMA):
            break
        i += 1
    i = _op(toks, i, ")")
    ret := []ast.Ty
    if _isop(toks, i, lex.OP_ARROW):
        r, j := ty(toks, i + 1)
        push(ret, r)
        i = j
    i = _op(toks, i, ":")
    b := ast.NullLit(0)
    j := _expr_into(toks, i, &b)
    return (ast.Lambda(ln, ps, ret, [b]), j)

fn _primary_into(toks: [lex.Tok], i0: int, out: inout ast.Expr) -> int:
    # The clamped INDEX, not the token: `_at` returns a Tok by value and a Tok
    # carries four strings, every one deep-copied on the way out -- paid once
    # per primary expression parsed. The `_die` paths still take the token.
    ti := _cl(toks, i0)
    i := i0

    if toks[ti].k == lex.K_KW and toks[ti].text == "fn":
        el2, jl2 := _lambda(toks, i + 1)
        out = el2
        return jl2
    if toks[ti].k == lex.K_INT:
        out = ast.IntLit(toks[ti].line, toks[ti].ival)
        return i + 1
    if toks[ti].k == lex.K_CHAR:
        out = ast.CharLit(toks[ti].line, toks[ti].ival)
        return i + 1
    if toks[ti].k == lex.K_FLOAT:
        out = ast.FloatLit(toks[ti].line, toks[ti].fval)
        return i + 1
    if toks[ti].k == lex.K_STR:
        if toks[ti].ival == 1:
            out = ast.FStrLit(toks[ti].line, toks[ti].text)
            return i + 1
        s := toks[ti].text
        i += 1
        for _kis(toks, i, lex.K_STR) and _at(toks, i).ival != 1:
            s = s + _x(toks, i)
            i += 1
        out = ast.StrLit(toks[ti].line, s)
        return i
    if toks[ti].k == lex.K_KW and toks[ti].text == "true":
        out = ast.BoolLit(toks[ti].line, true)
        return i + 1
    if toks[ti].k == lex.K_KW and toks[ti].text == "false":
        out = ast.BoolLit(toks[ti].line, false)
        return i + 1
    if toks[ti].k == lex.K_KW and toks[ti].text == "null":
        out = ast.NullLit(toks[ti].line)
        return i + 1

    if toks[ti].k == lex.K_OP and toks[ti].text == "(":
        first := ast.NullLit(0)
        j := _expr_into(toks, i + 1, &first)
        i = j
        if not _isop(toks, i, lex.OP_COMMA):
            i = _op(toks, i, ")")
            out = first
            return i
        xs := []ast.Expr
        push(xs, first)
        for _isop(toks, i, lex.OP_COMMA):
            i += 1
            if _isop(toks, i, lex.OP_RPAREN):
                break
            a := ast.NullLit(0)
            k := _expr_into(toks, i, &a)
            push(xs, a)
            i = k
        i = _op(toks, i, ")")
        if len(xs) > 8:
            _die(toks, _at(toks, i0), "a tuple has at most 8 elements")
        out = ast.Tuple(toks[ti].line, xs)
        return i

    if toks[ti].k == lex.K_OP and toks[ti].text == "[":
        i += 1
        # `xs := [string]` -- the TYPE spelling where a value goes. "expected an
        # expression" is true and useless. Only for a primitive type KEYWORD,
        # which can never be an expression: `[Foo]` stays a one-element literal
        # of a variable named Foo (src/tychoc.c:2820).
        k0 := _at(toks, i)
        if k0.k == lex.K_KW and _is_prim(k0.text):
            if _isop(toks, i + 1, lex.OP_RBRACK):
                _die(toks, _at(toks, i0), "`[" + k0.text + "]` is the TYPE, not a value -- for an empty array write " +
                    "`[]" + k0.text + "`, or annotate the declaration: `xs : [" + k0.text + "] = []`")
            k2 := _at(toks, i + 2)
            if _isop(toks, i + 1, lex.OP_COLON) and k2.k == lex.K_KW and _is_prim(k2.text) and _isop(toks, i + 3, lex.OP_RBRACK):
                _die(toks, _at(toks, i0), "`[" + k0.text + ": " + k2.text + "]` is the TYPE, not a value -- for an empty map write " +
                    "`[]" + k0.text + ": " + k2.text + "`, or annotate the declaration: `m : [" +
                    k0.text + ": " + k2.text + "] = []`")
        if _isop(toks, i, lex.OP_RBRACK):
            i += 1
            if not _starts_type_lit(toks, i):
                out = ast.EmptyArr(toks[ti].line, []ast.Ty)
                return i
            el, j := ty(toks, i)
            i = j
            if _isop(toks, i, lex.OP_COLON):
                v, k := ty(toks, i + 1)
                out = ast.EmptyMap(toks[ti].line, [el, v])
                return k
            out = ast.EmptyArr(toks[ti].line, [el])
            return i
        first := ast.NullLit(0)
        j := _expr_into(toks, i, &first)
        i = j
        if _isop(toks, i, lex.OP_COLON):
            kv := []ast.Expr
            push(kv, first)
            v := ast.NullLit(0)
            k := _expr_into(toks, i + 1, &v)
            push(kv, v)
            i = k
            for _isop(toks, i, lex.OP_COMMA):
                i += 1
                if _isop(toks, i, lex.OP_RBRACK):
                    break
                a := ast.NullLit(0)
                k2 := _expr_into(toks, i, &a)
                push(kv, a)
                i = _op(toks, k2, ":")
                b := ast.NullLit(0)
                k3 := _expr_into(toks, i, &b)
                push(kv, b)
                i = k3
            i = _op(toks, i, "]")
            out = ast.MapLit(toks[ti].line, kv)
            return i
        xs := []ast.Expr
        push(xs, first)
        for _isop(toks, i, lex.OP_COMMA):
            i += 1
            if _isop(toks, i, lex.OP_RBRACK):
                break
            a := ast.NullLit(0)
            k := _expr_into(toks, i, &a)
            push(xs, a)
            i = k
        i = _op(toks, i, "]")
        out = ast.ArrLit(toks[ti].line, xs)
        return i

    if toks[ti].k == lex.K_KW and toks[ti].text == "spawn":
        c := ast.NullLit(0)
        j := _postfix_into(toks, i + 1, &c)
        if not (c is ast.Call) and not (c is ast.CallVal):
            _die(toks, _at(toks, i0), "spawn requires a direct call: spawn f(args)")
        out = ast.SpawnE(toks[ti].line, [c])
        return j

    if toks[ti].k == lex.K_IDENT:
        nm := toks[ti].text
        i += 1
        if nm == "soa":
            i = _op(toks, i, "[")
            i = _op(toks, i, "]")
            el, j := ty(toks, i)
            out = ast.SoaLit(toks[ti].line, [el])
            return j
        if nm == "channel" and _isop(toks, i, lex.OP_LPAREN):
            el, j := ty(toks, i + 1)
            i = _op(toks, j, ",")
            c := ast.NullLit(0)
            k := _expr_into(toks, i, &c)
            i = _op(toks, k, ")")
            out = ast.ChanE(toks[ti].line, [el], [c])
            return i
        if nm == "None":
            out = ast.NoneE(toks[ti].line)
            return i
        if not _isop(toks, i, lex.OP_LPAREN) and (nm == "Some" or nm == "Ok" or nm == "Err"):
            _die(toks, _at(toks, i0), "'" + nm + "' cannot name a binding -- as a value it is a constructor: " + nm + "(x)")
        if nm == "Some":
            i = _op(toks, i, "(")
            a := ast.NullLit(0)
            j := _expr_into(toks, i, &a)
            i = _op(toks, j, ")")
            out = ast.SomeE(toks[ti].line, [a])
            return i
        if nm == "Ok" or nm == "Err":
            i = _op(toks, i, "(")
            if _isop(toks, i, lex.OP_RPAREN):
                if nm == "Err":
                    _die(toks, _at(toks, i0), "Err() carries no value -- a Result's error type cannot be void")
                out = ast.OkE(toks[ti].line, []ast.Expr)
                return i + 1
            a := ast.NullLit(0)
            j := _expr_into(toks, i, &a)
            i = _op(toks, j, ")")
            if nm == "Ok":
                out = ast.OkE(toks[ti].line, [a])
                return i
            out = ast.ErrE(toks[ti].line, [a])
            return i
        if _isop(toks, i, lex.OP_DOLLAR):
            tas, j := _typeargs(toks, i + 1, nm)
            i = j
            vargs := []ast.Expr
            if _isop(toks, i, lex.OP_LPAREN):
                a, k := _args(toks, i + 1)
                vargs = a
                i = k
            out = ast.Call(toks[ti].line, "", nm, tas, vargs)
            return i
        if _isop(toks, i, lex.OP_LPAREN):
            if nm == "map_set":
                _die(toks, _at(toks, i0), "map_set was removed; use `m[k] = v`")
            if nm == "map_has":
                _die(toks, _at(toks, i0), "map_has was removed; use `k in m`")
            if nm == "map_del":
                _die(toks, _at(toks, i0), "map_del was removed; use `delete m[k]`")
            if nm == "map_get":
                _die(toks, _at(toks, i0), "map_get was removed; use `m.get(k, default)`")
            a, j := _args(toks, i + 1)
            out = ast.Call(toks[ti].line, "", nm, []ast.Ty, a)
            return j
        out = ast.Name(toks[ti].line, nm)
        return i

    if toks[ti].k == lex.K_INDENT:
        _die(toks, _at(toks, i0), "unexpected indentation: this line is indented further than the block it belongs to")
    _diec(toks, _at(toks, i0), "expected an expression")
    out = ast.IntLit(toks[ti].line, 0)
    return i0

fn _postfix_into(toks: [lex.Tok], i0: int, out: inout ast.Expr) -> int:
    i := _primary_into(toks, i0, &out)
    for true:
        if _isop(toks, i, lex.OP_LBRACK):
            i += 1
            lo := []ast.Expr
            hi := []ast.Expr
            slice := false
            if _isop(toks, i, lex.OP_COLON):
                slice = true
                i += 1
                if not _isop(toks, i, lex.OP_RBRACK):
                    a := ast.NullLit(0)
                    j := _expr_into(toks, i, &a)
                    push(hi, a)
                    i = j
            else:
                a := ast.NullLit(0)
                j := _expr_into(toks, i, &a)
                push(lo, a)
                i = j
                if _isop(toks, i, lex.OP_COLON):
                    slice = true
                    i += 1
                    if not _isop(toks, i, lex.OP_RBRACK):
                        b := ast.NullLit(0)
                        k := _expr_into(toks, i, &b)
                        push(hi, b)
                        i = k
            i = _op(toks, i, "]")
            if slice:
                kids := []ast.Expr
                push(kids, out)
                for x in lo:
                    push(kids, x)
                for x in hi:
                    push(kids, x)
                out = ast.Slice(ast.line_of(out), len(lo) == 1, len(hi) == 1, kids)
            else:
                out = ast.Index(ast.line_of(out), [out, lo[0]])
            continue
        if _isop(toks, i, lex.OP_DOT):
            i += 1
            if _kis(toks, i, lex.K_INT):
                out = ast.TupIdx(ast.line_of(out), [out], _at(toks, i).ival)
                i += 1
                continue
            fname, j := _ident(toks, i, "a field name or tuple index after '.'")
            i = j
            if (_isop(toks, i, lex.OP_LPAREN) or _isop(toks, i, lex.OP_DOLLAR)) and (out is ast.Name):
                q := ""
                match out:
                    ast.Name(l, n): q = n
                    _: q = ""
                tas := []ast.Ty
                if _isop(toks, i, lex.OP_DOLLAR):
                    a, k := _typeargs(toks, i + 1, q + "." + fname)
                    tas = a
                    i = k
                vargs := []ast.Expr
                if _isop(toks, i, lex.OP_LPAREN):
                    a, k := _args(toks, i + 1)
                    vargs = a
                    i = k
                out = ast.Call(ast.line_of(out), q, fname, tas, vargs)
                continue
            out = ast.Field(ast.line_of(out), [out], fname)
            continue
        if _isop(toks, i, lex.OP_LPAREN):
            a, j := _args(toks, i + 1)
            kids := []ast.Expr
            push(kids, out)
            for x in a:
                push(kids, x)
            out = ast.CallVal(ast.line_of(out), kids)
            i = j
            continue
        break
    if _iskw(toks, i, lex.KW_OR_RETURN):
        out = ast.OrRet(ast.line_of(out), [out])
        i += 1
    if _isop(toks, i, lex.OP_ELLIPSIS):
        out = ast.Spread(ast.line_of(out), [out])
        i += 1
    return i

fn _unary_into(toks: [lex.Tok], i0: int, out: inout ast.Expr) -> int:
    if _isop(toks, i0, lex.OP_MINUS):
        a := ast.NullLit(0)
        j := _unary_into(toks, i0 + 1, &a)
        out = ast.Unop(_ln(toks, i0), "-", [a])
        return j
    if _isop(toks, i0, lex.OP_AMP):
        a := ast.NullLit(0)
        j := _unary_into(toks, i0 + 1, &a)
        out = ast.Addr(_ln(toks, i0), [a])
        return j
    if _isop(toks, i0, lex.OP_TILDE):
        a := ast.NullLit(0)
        j := _unary_into(toks, i0 + 1, &a)
        out = ast.Unop(_ln(toks, i0), "~", [a])
        return j
    return _postfix_into(toks, i0, &out)

fn _mul_op(toks: [lex.Tok], i: int) -> bool:
    j := _cl(toks, i)
    if toks[j].k != lex.K_OP:
        return false
    return toks[j].text == "*" or toks[j].text == "/" or toks[j].text == "%" or toks[j].text == "<<" or toks[j].text == ">>" or toks[j].text == "&"

# The binary levels write THROUGH an out parameter. Returning the node instead
# copies it into the caller's arena at every level of the grammar, so a deep
# expression was re-homed once per precedence step -- O(depth x size). Writing
# into the caller's variable means the accumulating tree is built where it will
# live, and only the small right-hand operand of each operator is copied.
fn _mul_into(toks: [lex.Tok], i0: int, out: inout ast.Expr) -> int:
    # Parse straight into `out`, as every other precedence level does. Going via
    # a temp cost one full deep copy of the unary subtree per expression parsed.
    i := _unary_into(toks, i0, &out)
    for _mul_op(toks, i):
        o := _x(toks, i)
        r := ast.NullLit(0)
        j := _unary_into(toks, i + 1, &r)
        out = ast.Binop(ast.line_of(out), o, [out, r])
        i = j
    return i

fn _add_op(toks: [lex.Tok], i: int) -> bool:
    j := _cl(toks, i)
    if toks[j].k != lex.K_OP:
        return false
    return toks[j].text == "+" or toks[j].text == "-" or toks[j].text == "|" or toks[j].text == "^"

fn _add_into(toks: [lex.Tok], i0: int, out: inout ast.Expr) -> int:
    i := _mul_into(toks, i0, &out)
    for _add_op(toks, i):
        o := _x(toks, i)
        r := ast.NullLit(0)
        j := _mul_into(toks, i + 1, &r)
        out = ast.Binop(ast.line_of(out), o, [out, r])
        i = j
    return i

fn _isexp_into(toks: [lex.Tok], i0: int, out: inout ast.Expr) -> int:
    i := _add_into(toks, i0, &out)
    if _iskw(toks, i, lex.KW_IS):
        nm, j := _ident(toks, i + 1, "a variant name after `is`")
        i = j
        q := ""
        if _isop(toks, i, lex.OP_DOT):
            q = nm
            n2, k := _ident(toks, i + 1, "a variant name after the package qualifier")
            nm = n2
            i = k
        if _iskw(toks, i, lex.KW_IS):
            _die(toks, _at(toks, i), "`is` does not chain -- write `a is X and a is Y`")
        out = ast.IsVar(ast.line_of(out), [out], q, nm)
    return i

fn _cmp_op(toks: [lex.Tok], i: int) -> bool:
    if _iskw(toks, i, lex.KW_IN):
        return true
    j := _cl(toks, i)
    if toks[j].k != lex.K_OP:
        return false
    return toks[j].text == "==" or toks[j].text == "!=" or toks[j].text == "<" or toks[j].text == ">" or toks[j].text == "<=" or toks[j].text == ">="

fn _cmp_into(toks: [lex.Tok], i0: int, out: inout ast.Expr) -> int:
    i := _isexp_into(toks, i0, &out)
    for _cmp_op(toks, i):
        o := _x(toks, i)
        r := ast.NullLit(0)
        j := _isexp_into(toks, i + 1, &r)
        out = ast.Binop(ast.line_of(out), o, [out, r])
        i = j
    return i

fn _notexp_into(toks: [lex.Tok], i0: int, out: inout ast.Expr) -> int:
    if _iskw(toks, i0, lex.KW_NOT):
        a := ast.NullLit(0)
        j := _notexp_into(toks, i0 + 1, &a)
        out = ast.Unop(_ln(toks, i0), "not", [a])
        return j
    return _cmp_into(toks, i0, &out)

fn _andexp_into(toks: [lex.Tok], i0: int, out: inout ast.Expr) -> int:
    i := _notexp_into(toks, i0, &out)
    for _iskw(toks, i, lex.KW_AND):
        r := ast.NullLit(0)
        j := _notexp_into(toks, i + 1, &r)
        out = ast.Binop(ast.line_of(out), "and", [out, r])
        i = j
    return i

fn _expr_into(toks: [lex.Tok], i0: int, out: inout ast.Expr) -> int:
    i := _andexp_into(toks, i0, &out)
    for _iskw(toks, i, lex.KW_OR):
        r := ast.NullLit(0)
        j := _andexp_into(toks, i + 1, &r)
        out = ast.Binop(ast.line_of(out), "or", [out, r])
        i = j
    return i

fn expr(toks: [lex.Tok], i0: int) -> (ast.Expr, int):
    e := ast.NullLit(0)
    i := _expr_into(toks, i0, &e)
    return (e, i)

# --- value blocks (expression-valued if / match) ----------------------------

# src/tychoc.c@value_block_at_tail: the branch's value is a bare expression on
# the LAST logical line; a line that opens its own block is never the tail.
fn _at_tail(toks: [lex.Tok], i0: int) -> bool:
    i := i0
    for not _kis(toks, i, lex.K_NEWLINE) and not _kis(toks, i, lex.K_EOF) and not _kis(toks, i, lex.K_DEDENT):
        i += 1
    if not _kis(toks, i, lex.K_NEWLINE):
        return true
    j := i + 1
    for _kis(toks, j, lex.K_NEWLINE):
        j += 1
    if _kis(toks, j, lex.K_INDENT):
        return false
    return _kis(toks, j, lex.K_DEDENT)

fn value_block(toks: [lex.Tok], i0: int) -> ([ast.Stmt], int):
    i := _expect(toks, i0, lex.K_INDENT, "")
    out := []ast.Stmt
    for not _kis(toks, i, lex.K_DEDENT) and not _kis(toks, i, lex.K_EOF):
        if _kis(toks, i, lex.K_NEWLINE):
            i += 1
            continue
        if _at_tail(toks, i):
            e := ast.NullLit(0)
            j := _expr_into(toks, i, &e)
            i = _expect(toks, j, lex.K_NEWLINE, "")
            push(out, ast.ExprStmt(ast.line_of(e), [e]))
            continue
        s, j := stmt(toks, i)
        push(out, s)
        i = j
    i = _expect(toks, i, lex.K_DEDENT, "")
    if len(out) == 0:
        _die(toks, _at(toks, i0), "a value branch must end in a value expression")
    if not (out[len(out) - 1] is ast.ExprStmt):
        _die(toks, _at(toks, i0), "a value branch must end in a value expression")
    return (out, i)

fn value_if(toks: [lex.Tok], i0: int) -> (ast.Stmt, int):
    c := ast.NullLit(0)
    i := _expr_into(toks, i0, &c)
    i = _op(toks, i, ":")
    i = _expect(toks, i, lex.K_NEWLINE, "")
    body, j := value_block(toks, i)
    i = j
    els := []ast.Stmt
    if _iskw(toks, i, lex.KW_ELIF):
        e, k := value_if(toks, i + 1)
        push(els, e)
        i = k
    elif _iskw(toks, i, lex.KW_ELSE):
        i = _op(toks, i + 1, ":")
        i = _expect(toks, i, lex.K_NEWLINE, "")
        e, k := value_block(toks, i)
        els = e
        i = k
    else:
        _die(toks, _at(toks, i0), "an `if` used as a value must have an `else`")
    return (ast.IfS(_ln(toks, i0), [c], body, els), i)

fn value_ctrl(toks: [lex.Tok], i0: int) -> (ast.Stmt, int):
    if _iskw(toks, i0, lex.KW_IF):
        return value_if(toks, i0 + 1)
    if _iskw(toks, i0, lex.KW_MATCH):
        return matchs(toks, i0 + 1, true)
    _die(toks, _at(toks, i0), "expected `if` or `match`")
    return (ast.PassS(_ln(toks, i0)), i0)

# src/tychoc.c@expr_diverges: `die(...)`/`exit(...)` produce no value by
# definition, so a branch ending in one is left as the statement it already is.
fn _diverges(e: ast.Expr) -> bool:
    match e:
        ast.Call(l, q, n, tas, args): return len(q) == 0 and (n == "die" or n == "exit")
        _: return false
    return false

fn _rewrite_tail(s: ast.Stmt, kind: string, name: string, target: [ast.Expr]) -> ast.Stmt:
    match s:
        ast.ExprStmt(l, es):
            if len(es) != 1 or _diverges(es[0]):
                return s
            if kind == "return":
                return ast.ReturnS(l, [es[0]])
            if kind == "assign":
                return ast.Assign(l, name, [es[0]])
            return ast.PlaceSet(l, [target[0], es[0]])
        _: return s
    return s

fn _rewrite_block(b: [ast.Stmt], kind: string, name: string, target: [ast.Expr]) -> [ast.Stmt]:
    if len(b) == 0:
        return b
    out := []ast.Stmt
    for k := 0; k < len(b) - 1; k += 1:
        push(out, b[k])
    push(out, rewrite_tails(b[len(b) - 1], kind, name, target))
    return out

fn rewrite_tails(s: ast.Stmt, kind: string, name: string, target: [ast.Expr]) -> ast.Stmt:
    match s:
        ast.IfS(l, c, body, els):
            return ast.IfS(l, c, _rewrite_block(body, kind, name, target),
                           _rewrite_block(els, kind, name, target))
        ast.MatchS(l, subj, arms):
            out := []ast.Arm
            for a in arms:
                push(out, ast.Arm(a.kind, a.qual, a.name, a.binds, a.subqual, a.sub,
                                  a.subbinds, a.pats, a.ch,
                                  _rewrite_block(a.body, kind, name, target), a.line))
            return ast.MatchS(l, subj, out)
        ast.ExprStmt(l, es): return _rewrite_tail(s, kind, name, target)
        _: return s
    return s

# --- match / select ---------------------------------------------------------

fn _scalar_arm_ahead(toks: [lex.Tok], i: int) -> bool:
    k := _k(toks, i)
    if k == lex.K_INT or k == lex.K_CHAR:
        return true
    if _iskw(toks, i, lex.KW_TRUE) or _iskw(toks, i, lex.KW_FALSE):
        return true
    if _isop(toks, i, lex.OP_MINUS) and _kis(toks, i + 1, lex.K_INT):
        return true
    return k == lex.K_IDENT and (_isop(toks, i + 1, lex.OP_DOTDOT) or _isop(toks, i + 1, lex.OP_PIPE))

fn _pat_end(toks: [lex.Tok], i0: int) -> (ast.Pat, int, bool):
    # one end of a scalar pattern: an int/char/bool literal or a const NAME
    i := i0
    neg := false
    if _isop(toks, i, lex.OP_MINUS):
        neg = true
        i += 1
    ti := _cl(toks, i)
    if toks[ti].k == lex.K_INT:
        v := toks[ti].ival
        if neg:
            v = -v
        return (ast.Pat("int", v, v, "", "", false), i + 1, true)
    if toks[ti].k == lex.K_CHAR:
        if neg:
            _die(toks, _at(toks, i), "'-' is only valid before an int literal in a match arm")
        return (ast.Pat("char", toks[ti].ival, toks[ti].ival, "", "", false), i + 1, true)
    if toks[ti].k == lex.K_KW and (toks[ti].text == "true" or toks[ti].text == "false"):
        if neg:
            _die(toks, _at(toks, i), "'-' is only valid before an int literal in a match arm")
        v := 0
        if toks[ti].text == "true":
            v = 1
        return (ast.Pat("bool", v, v, "", "", false), i + 1, true)
    if toks[ti].k == lex.K_IDENT:
        if neg:
            _die(toks, _at(toks, i), "'-' is only valid before an int literal in a match arm")
        return (ast.Pat("name", 0, 0, toks[ti].text, "", false), i + 1, true)
    _die(toks, _at(toks, i), "a match arm must be a variant name, a scalar literal, a range, or `_`")
    return (ast.Pat("int", 0, 0, "", "", false), i0, false)

fn _scalar_arm(toks: [lex.Tok], i0: int) -> ([ast.Pat], int):
    i := i0
    pats := []ast.Pat
    for true:
        p, j, ok := _pat_end(toks, i)
        i = j
        if _isop(toks, i, lex.OP_DOTDOT):
            h, k, ok2 := _pat_end(toks, i + 1)
            i = k
            if h.kind != p.kind:
                _die(toks, _at(toks, i0), "a range's two ends must be the same kind of value")
            p = ast.Pat(p.kind, p.lo, h.hi, p.loname, h.loname, true)
        push(pats, p)
        if not _isop(toks, i, lex.OP_PIPE):
            break
        i += 1
    return (pats, i)

fn _arm_body(toks: [lex.Tok], i0: int, value: bool) -> ([ast.Stmt], int):
    if _kis(toks, i0, lex.K_NEWLINE):
        i := i0 + 1
        if value:
            return value_block(toks, i)
        return block(toks, i)
    # F7: a one-line arm body
    if value:
        e := ast.NullLit(0)
        j := _expr_into(toks, i0, &e)
        return ([ast.ExprStmt(ast.line_of(e), [e])], j)
    s, j := stmt(toks, i0)
    return ([s], j)

fn matchs(toks: [lex.Tok], i0: int, value: bool) -> (ast.Stmt, int):
    subj := ast.NullLit(0)
    i := _expr_into(toks, i0, &subj)
    i = _op(toks, i, ":")
    i = _expect(toks, i, lex.K_NEWLINE, "")
    i = _expect(toks, i, lex.K_INDENT, "")
    arms := []ast.Arm
    for not _kis(toks, i, lex.K_DEDENT) and not _kis(toks, i, lex.K_EOF):
        if _kis(toks, i, lex.K_NEWLINE):
            i += 1
            continue
        aln := _ln(toks, i)
        pats := []ast.Pat
        binds := []string
        subbinds := []string
        chs := []ast.Expr
        kind := "variant"
        qual := ""
        nm := ""
        subq := ""
        sub := ""
        if _scalar_arm_ahead(toks, i):
            kind = "scalar"
            p, j := _scalar_arm(toks, i)
            pats = p
            i = j
        else:
            if _kis(toks, i, lex.K_STR):
                _die(toks, _at(toks, i), "`match` does not take a string arm -- int, char, bool, a range and a const name do; for strings use an if/elif chain on `==`")
            v, j := _ident(toks, i, "a match arm `Variant(bindings):` or `Variant:`")
            nm = v
            i = j
            if _isop(toks, i, lex.OP_DOT):
                qual = nm
                v2, k := _ident(toks, i + 1, "a variant name after the package qualifier")
                nm = v2
                i = k
            if _isop(toks, i, lex.OP_LPAREN):
                i += 1
                if _kis(toks, i, lex.K_IDENT) and (_isop(toks, i + 1, lex.OP_DOT) or _isop(toks, i + 1, lex.OP_LPAREN)):
                    s1, j2 := _ident(toks, i, "a nested variant name")
                    sub = s1
                    i = j2
                    if _isop(toks, i, lex.OP_DOT):
                        subq = sub
                        s2, k2 := _ident(toks, i + 1, "a variant name after the package qualifier")
                        sub = s2
                        i = k2
                    if _isop(toks, i, lex.OP_LPAREN):
                        i += 1
                        for not _isop(toks, i, lex.OP_RPAREN):
                            b, k3 := _ident(toks, i, "a binding name")
                            push(subbinds, b)
                            i = k3
                            if not _isop(toks, i, lex.OP_COMMA):
                                break
                            i += 1
                        i = _op(toks, i, ")")
                else:
                    for not _isop(toks, i, lex.OP_RPAREN):
                        b, k3 := _ident(toks, i, "a binding name")
                        push(binds, b)
                        i = k3
                        if not _isop(toks, i, lex.OP_COMMA):
                            break
                        i += 1
                i = _op(toks, i, ")")
        i = _op(toks, i, ":")
        body, j := _arm_body(toks, i, value)
        i = j
        push(arms, ast.Arm(kind, qual, nm, binds, subq, sub, subbinds, pats, chs, body, aln))
    i = _expect(toks, i, lex.K_DEDENT, "")
    if len(arms) == 0:
        _die(toks, _at(toks, i0), "match needs at least one arm")
    return (ast.MatchS(_ln(toks, i0), [subj], arms), i)

fn selects(toks: [lex.Tok], i0: int) -> (ast.Stmt, int):
    i := _op(toks, i0, ":")
    i = _expect(toks, i, lex.K_NEWLINE, "")
    i = _expect(toks, i, lex.K_INDENT, "")
    arms := []ast.Arm
    for not _kis(toks, i, lex.K_DEDENT) and not _kis(toks, i, lex.K_EOF):
        if _kis(toks, i, lex.K_NEWLINE):
            i += 1
            continue
        aln := _ln(toks, i)
        an, j := _ident(toks, i, "a select arm: `recv(ch, x):`, `default:`, or `closed:`")
        i = j
        binds := []string
        chs := []ast.Expr
        if an == "recv":
            i = _op(toks, i, "(")
            c := ast.NullLit(0)
            k := _expr_into(toks, i, &c)
            push(chs, c)
            i = _op(toks, k, ",")
            b, k2 := _ident(toks, i, "a binding name")
            push(binds, b)
            i = _op(toks, k2, ")")
        elif an != "default" and an != "closed":
            _die(toks, _at(toks, i0), "a select arm is `recv(ch, x):`, `default:`, or `closed:`")
        i = _op(toks, i, ":")
        i = _expect(toks, i, lex.K_NEWLINE, "")
        body, k3 := block(toks, i)
        i = k3
        push(arms, ast.Arm(an, "", an, binds, "", "", []string, []ast.Pat, chs, body, aln))
    i = _expect(toks, i, lex.K_DEDENT, "")
    if len(arms) == 0:
        _die(toks, _at(toks, i0), "select needs at least one arm")
    return (ast.SelectS(_ln(toks, i0), arms), i)

# --- statements -------------------------------------------------------------

fn _is_compound(toks: [lex.Tok], i: int) -> bool:
    if not _kis(toks, i, lex.K_OP):
        return false
    s := _x(toks, i)
    if s == "+" or s == "-" or s == "*" or s == "/" or s == "%":
        return true
    return s == "&" or s == "|" or s == "^" or s == "<<" or s == ">>"

# A declaration, assignment, place-set or bare-call statement, WITHOUT its
# terminating newline -- the three-clause `for` reuses it for its init and post
# clauses, which is what keeps one copy of the assignment grammar.
fn simple(toks: [lex.Tok], i0: int) -> (ast.Stmt, int, bool):
    ti := _cl(toks, i0)
    i := i0

    if toks[ti].k == lex.K_IDENT and _isop(toks, i + 1, lex.OP_COMMA):
        names := []string
        n0, j := _ident(toks, i, "a name")
        push(names, n0)
        i = j
        for _isop(toks, i, lex.OP_COMMA):
            n, k := _ident(toks, i + 1, "a name in the destructuring list")
            push(names, n)
            i = k
        if len(names) > 8:
            _die(toks, _at(toks, i0), "at most 8 destructuring targets")
        isdecl := true
        if _isop(toks, i, lex.OP_DECL):
            i += 1
        else:
            i = _op(toks, i, "=")
            isdecl = false
        e := ast.NullLit(0)
        k2 := _expr_into(toks, i, &e)
        return (ast.MDecl(toks[ti].line, isdecl, names, [e]), k2, true)

    if toks[ti].k == lex.K_IDENT and (_isop(toks, i + 1, lex.OP_DECL) or _isop(toks, i + 1, lex.OP_COLON) or
                              _isop(toks, i + 1, lex.OP_EQ)):
        name := toks[ti].text
        i += 1
        if _isop(toks, i, lex.OP_DECL):
            i += 1
            if _iskw(toks, i, lex.KW_IF) or _iskw(toks, i, lex.KW_MATCH):
                c, j := value_ctrl(toks, i)
                return (ast.Decl(toks[ti].line, name, []ast.Ty, []ast.Expr, [c]), j, false)
            e := ast.NullLit(0)
            j := _expr_into(toks, i, &e)
            return (ast.Decl(toks[ti].line, name, []ast.Ty, [e], []ast.Stmt), j, true)
        if _isop(toks, i, lex.OP_COLON):
            a, j := ty(toks, i + 1)
            i = _op(toks, j, "=")
            if _iskw(toks, i, lex.KW_IF) or _iskw(toks, i, lex.KW_MATCH):
                c, k := value_ctrl(toks, i)
                return (ast.Decl(toks[ti].line, name, [a], []ast.Expr, [c]), k, false)
            e := ast.NullLit(0)
            k := _expr_into(toks, i, &e)
            return (ast.Decl(toks[ti].line, name, [a], [e], []ast.Stmt), k, true)
        i = _op(toks, i, "=")
        if _iskw(toks, i, lex.KW_IF) or _iskw(toks, i, lex.KW_MATCH):
            c, j := value_ctrl(toks, i)
            return (rewrite_tails(c, "assign", name, []ast.Expr), j, false)
        e := ast.NullLit(0)
        j := _expr_into(toks, i, &e)
        return (ast.Assign(toks[ti].line, name, [e]), j, true)

    e := ast.NullLit(0)
    i2 := _postfix_into(toks, i0, &e)
    i = i2
    if _isop(toks, i, lex.OP_EQ):
        i += 1
        # src/tychoc.c:4136 allows E_CALL as a target; its E_CALL covers BOTH the
        # named form and the indirect one, which split here into Call/CallVal.
        if not (e is ast.Index) and not (e is ast.Field) and not (e is ast.TupIdx) and
           not (e is ast.Call) and not (e is ast.CallVal):
            _die(toks, _at(toks, i0), "cannot assign to this expression")
        if _iskw(toks, i, lex.KW_IF) or _iskw(toks, i, lex.KW_MATCH):
            c, j := value_ctrl(toks, i)
            return (rewrite_tails(c, "place", "", [e]), j, false)
        v := ast.NullLit(0)
        j := _expr_into(toks, i, &v)
        return (ast.PlaceSet(toks[ti].line, [e, v]), j, true)
    if _is_compound(toks, i) and _isop(toks, i + 1, lex.OP_EQ):
        o := _x(toks, i)
        v := ast.NullLit(0)
        j := _expr_into(toks, i + 2, &v)
        b := ast.Binop(toks[ti].line, o, [e, v])
        match e:
            ast.Name(l, n): return (ast.Assign(toks[ti].line, n, [b]), j, true)
            _: return (ast.PlaceSet(toks[ti].line, [e, b]), j, true)
    match e:
        ast.Name(l, n):
            if n == "while":
                _die(toks, _at(toks, i0), "Tycho has no `while` -- use `for cond:` for a conditional loop (e.g. `for i < 3:`)")
        _: pass
    if e is ast.SpawnE:
        _die(toks, _at(toks, i0), "a `spawn` must be bound to a task handle -- write `t := spawn f(args)`")
    ok := e is ast.Call
    if e is ast.CallVal:
        ok = true
    match e:
        ast.OrRet(l, k):
            if len(k) == 1 and ((k[0] is ast.Call) or (k[0] is ast.CallVal)):
                ok = true
        _: pass
    if not ok:
        _die(toks, _at(toks, i0), "a statement must be a declaration, assignment, or call -- a bare expression has no effect")
    return (ast.ExprStmt(toks[ti].line, [e]), i, true)

fn _for3_semi(toks: [lex.Tok], i0: int) -> int:
    depth := 0
    for k := i0; true; k += 1:
        kk := _k(toks, k)
        if kk == lex.K_NEWLINE or kk == lex.K_EOF:
            return -1
        if kk == lex.K_OP:
            s := _x(toks, k)
            if s == "(" or s == "[":
                depth += 1
            elif s == ")" or s == "]":
                depth -= 1
            elif depth == 0 and s == ";":
                return k
    return -1

fn _dotlt_ahead(toks: [lex.Tok], i0: int) -> bool:
    depth := 0
    for k := i0; true; k += 1:
        kk := _k(toks, k)
        if kk == lex.K_NEWLINE or kk == lex.K_EOF:
            return false
        if kk == lex.K_OP:
            s := _x(toks, k)
            if s == "(" or s == "[":
                depth += 1
            elif s == ")" or s == "]":
                depth -= 1
            elif depth == 0 and s == "..<":
                return true
    return false

fn forstmt(toks: [lex.Tok], i0: int, par: bool) -> (ast.Stmt, int):
    ti := _cl(toks, i0 - 1)
    i := i0
    # bare `for:` -- an infinite loop, the condition form with a literal true
    if _isop(toks, i, lex.OP_COLON):
        i = _expect(toks, i + 1, lex.K_NEWLINE, "")
        b, j := block(toks, i)
        return (ast.WhileS(toks[ti].line, [ast.BoolLit(toks[ti].line, true)], b), j)
    if _for3_semi(toks, i) >= 0:
        init, j, nl1 := simple(toks, i)
        i = _op(toks, j, ";")
        cond := ast.NullLit(0)
        k := _expr_into(toks, i, &cond)
        i = _op(toks, k, ";")
        post, m, nl2 := simple(toks, i)
        i = _op(toks, m, ":")
        i = _expect(toks, i, lex.K_NEWLINE, "")
        if not (init is ast.Decl) and not (init is ast.Assign) and not (init is ast.MDecl):
            _die(toks, _at(toks, i0 - 1), "the init clause of a three-clause `for` is a declaration or an assignment")
        if not (post is ast.Assign) and not (post is ast.PlaceSet):
            _die(toks, _at(toks, i0 - 1), "the post clause of a three-clause `for` is an assignment")
        b, n := block(toks, i)
        return (ast.For3(toks[ti].line, [init, post], [cond], b), n)
    if _kis(toks, i, lex.K_IDENT) and _iskw(toks, i + 1, lex.KW_IN):
        v := _x(toks, i)
        i += 2
        if _dotlt_ahead(toks, i):
            if not par:
                _die(toks, _at(toks, i0 - 1), "`0..<N` counts only in a `parallel for` -- write `for idx := 0; idx < N; idx += 1:` for a sequential count")
            if not (_kis(toks, i, lex.K_INT) and _at(toks, i).ival == 0 and _isop(toks, i + 1, lex.OP_DOTDOTLT)):
                _die(toks, _at(toks, i0 - 1), "`parallel for` counts from zero: write `0..<N`")
            hi := ast.NullLit(0)
            j := _expr_into(toks, i + 2, &hi)
            i = _op(toks, j, ":")
            i = _expect(toks, i, lex.K_NEWLINE, "")
            b, k := block(toks, i)
            return (ast.ForRange(toks[ti].line, v, [ast.IntLit(toks[ti].line, 0), hi], b), k)
        if _isid(toks, i, "range") and _isop(toks, i + 1, lex.OP_LPAREN):
            _die(toks, _at(toks, i0 - 1), "`range()` was removed: write `for idx := 0; idx < N; idx += 1:` to count, or `parallel for idx in 0..<N:` to count in parallel")
        coll := ast.NullLit(0)
        j := _expr_into(toks, i, &coll)
        # src/tychoc.c:4024 -- an array and a channel source are both scalar
        # handles, so the source must NAME one; a temp could alias a channel.
        if par and not (coll is ast.Name):
            _die(toks, _at(toks, i0 - 1), "parallel for over a collection or channel must name a variable (bind it first)")
        i = _op(toks, j, ":")
        i = _expect(toks, i, lex.K_NEWLINE, "")
        b, k := block(toks, i)
        return (ast.ForIn(toks[ti].line, v, [coll], b), k)
    # condition form `for cond:`
    c := ast.NullLit(0)
    j := _expr_into(toks, i, &c)
    i = _op(toks, j, ":")
    i = _expect(toks, i, lex.K_NEWLINE, "")
    b, k := block(toks, i)
    return (ast.WhileS(toks[ti].line, [c], b), k)

fn ifstmt(toks: [lex.Tok], i0: int) -> (ast.Stmt, int):
    c := ast.NullLit(0)
    i := _expr_into(toks, i0, &c)
    i = _op(toks, i, ":")
    i = _expect(toks, i, lex.K_NEWLINE, "")
    body, j := block(toks, i)
    i = j
    els := []ast.Stmt
    if _iskw(toks, i, lex.KW_ELIF):
        e, k := ifstmt(toks, i + 1)
        push(els, e)
        i = k
    elif _iskw(toks, i, lex.KW_ELSE):
        i = _op(toks, i + 1, ":")
        i = _expect(toks, i, lex.K_NEWLINE, "")
        e, k := block(toks, i)
        els = e
        i = k
    return (ast.IfS(_ln(toks, i0 - 1), [c], body, els), i)

fn stmt(toks: [lex.Tok], i0: int) -> (ast.Stmt, int):
    ti := _cl(toks, i0)
    i := i0

    # src/tychoc.c: a reserved word where a binding name was written
    # `_kwname` wanted the whole token, and stmt runs once per statement.
    # Only a `kw` token can carry a reserved name, so ask before taking it.
    kw := ""
    if _kis(toks, i0, lex.K_KW):
        kw = _x(toks, i0)
    if len(kw) > 0:
        n := _at(toks, i + 1)
        bad := false
        if n.k == lex.K_OP and (n.text == ":=" or n.text == "=" or n.text == ","):
            bad = true
        if n.k == lex.K_OP and n.text == ":" and not _kis(toks, i + 2, lex.K_NEWLINE):
            bad = true
        if bad:
            _diec(toks, _at(toks, i0), "'" + kw + "' is a reserved keyword and cannot be used as a variable name")

    if toks[ti].k == lex.K_IDENT and toks[ti].text == "const" and _kis(toks, i + 1, lex.K_IDENT):
        nm, j := _ident(toks, i + 1, "a constant name after 'const'")
        i = _op(toks, j, "=")
        e := ast.NullLit(0)
        k := _expr_into(toks, i, &e)
        i = _expect(toks, k, lex.K_NEWLINE, "")
        # src/tychoc.c:3752 folds a LOCAL const with refs off -- no sibling-const
        # refs -- so `const D = K * 2` is refused here and accepted at top level.
        v := _const_fold(toks, e, []ast.ConstD, _at(toks, i0))
        if not _is_lit(v):
            _die(toks, _at(toks, i0), "a `const` must be a single scalar literal -- an int, float, string, bool or char. Arrays, maps and struct literals are not allowed, and neither is an expression")
        return (ast.ConstS(toks[ti].line, nm, [v]), i)

    if toks[ti].k == lex.K_IDENT and toks[ti].text == "pass" and
            (_kis(toks, i + 1, lex.K_NEWLINE) or _kis(toks, i + 1, lex.K_DEDENT) or _kis(toks, i + 1, lex.K_EOF)):
        i += 1
        if _kis(toks, i, lex.K_NEWLINE):
            i += 1
        return (ast.PassS(toks[ti].line), i)

    if toks[ti].k == lex.K_IDENT and toks[ti].text == "delete" and _kis(toks, i + 1, lex.K_IDENT):
        e := ast.NullLit(0)
        j := _postfix_into(toks, i + 1, &e)
        if not (e is ast.Index):
            _die(toks, _at(toks, i0), "`delete` removes a map element: `delete m[k]`")
        i = _expect(toks, j, lex.K_NEWLINE, "")
        return (ast.DeleteS(toks[ti].line, [e]), i)

    if toks[ti].k == lex.K_KW and toks[ti].text == "return":
        i += 1
        if _iskw(toks, i, lex.KW_IF) or _iskw(toks, i, lex.KW_MATCH):
            c, j := value_ctrl(toks, i)
            return (rewrite_tails(c, "return", "", []ast.Expr), j)
        if _kis(toks, i, lex.K_NEWLINE):
            return (ast.ReturnS(toks[ti].line, []ast.Expr), i + 1)
        first := ast.NullLit(0)
        j := _expr_into(toks, i, &first)
        i = j
        if _isop(toks, i, lex.OP_COMMA):
            xs := []ast.Expr
            push(xs, first)
            for _isop(toks, i, lex.OP_COMMA):
                a := ast.NullLit(0)
                k := _expr_into(toks, i + 1, &a)
                push(xs, a)
                i = k
            i = _expect(toks, i, lex.K_NEWLINE, "")
            if len(xs) > 8:
                _die(toks, _at(toks, i0), "a tuple has at most 8 elements")
            return (ast.ReturnS(toks[ti].line, [ast.Tuple(toks[ti].line, xs)]), i)
        i = _expect(toks, i, lex.K_NEWLINE, "")
        return (ast.ReturnS(toks[ti].line, [first]), i)

    if toks[ti].k == lex.K_KW and toks[ti].text == "break":
        i = _expect(toks, i + 1, lex.K_NEWLINE, "")
        return (ast.BreakS(toks[ti].line), i)
    if toks[ti].k == lex.K_KW and toks[ti].text == "continue":
        i = _expect(toks, i + 1, lex.K_NEWLINE, "")
        return (ast.ContinueS(toks[ti].line), i)

    if toks[ti].k == lex.K_KW and toks[ti].text == "select":
        return selects(toks, i + 1)
    if toks[ti].k == lex.K_KW and toks[ti].text == "match":
        return matchs(toks, i + 1, false)
    if toks[ti].k == lex.K_KW and toks[ti].text == "if":
        return ifstmt(toks, i + 1)

    if toks[ti].k == lex.K_KW and toks[ti].text == "parallel":
        i += 1
        w := []ast.Expr
        if _isop(toks, i, lex.OP_LPAREN):
            a := ast.NullLit(0)
            j := _expr_into(toks, i + 1, &a)
            push(w, a)
            i = _op(toks, j, ")")
            # src/tychoc.c:3883 -- range-checked only when the width is a literal.
            match a:
                ast.IntLit(l, v):
                    if v < 1 or v > 64:
                        _die(toks, _at(toks, i0), "a `parallel` width is 1..64, got " + str(v) +
                            " -- 64 is the fan-out cap, and a width below 1 has no meaning")
                _: pass
        if not _iskw(toks, i, lex.KW_FOR):
            _die(toks, _at(toks, i0), "expected 'for' after 'parallel'")
        s, j := forstmt(toks, i + 1, true)
        if not (s is ast.ForRange) and not (s is ast.ForIn):
            _die(toks, _at(toks, i0), "parallel supports `for i in 0..<N` and `for x in collection` loops only")
        return (ast.ParallelS(toks[ti].line, w, [s]), j)

    if toks[ti].k == lex.K_KW and toks[ti].text == "for":
        return forstmt(toks, i + 1, false)

    s, j, need_nl := simple(toks, i)
    if need_nl:
        j = _expect(toks, j, lex.K_NEWLINE, "")
    return (s, j)

fn block(toks: [lex.Tok], i0: int) -> ([ast.Stmt], int):
    i := _expect(toks, i0, lex.K_INDENT, "")
    out := []ast.Stmt
    for not _kis(toks, i, lex.K_DEDENT) and not _kis(toks, i, lex.K_EOF):
        if _kis(toks, i, lex.K_NEWLINE):
            i += 1
            continue
        s, j := stmt(toks, i)
        push(out, s)
        i = j
    i = _expect(toks, i, lex.K_DEDENT, "")
    return (out, i)

# --- declarations -----------------------------------------------------------

# `mode` is which of the three parameter lists this is. src/tychoc.c does not
# share one parser between them: `fn` takes inout/sink/..., src/tychoc.c@parse_extern_fn
# takes inout alone, and src/tychoc.c@parse_subscript goes straight to parse_type.
# A marker this list does not take is left for `ty` to read as a type name, which
# is exactly how tychoc reports it ("unknown type 'sink'").
fn _params(toks: [lex.Tok], i0: int, mode: string) -> ([ast.Param], int):
    i := i0
    out := []ast.Param
    for not _isop(toks, i, lex.OP_RPAREN):
        pln := _ln(toks, i)
        nm, j := _ident(toks, i, "a parameter name")
        i = _op(toks, j, ":")
        is_inout := false
        is_sink := false
        is_variadic := false
        if _iskw(toks, i, lex.KW_INOUT) and mode != "subscript":
            is_inout = true
            i += 1
        elif _isid(toks, i, "sink") and mode == "fn":
            is_sink = true
            i += 1
        if _isop(toks, i, lex.OP_ELLIPSIS) and mode == "fn":
            is_variadic = true
            i += 1
        if is_variadic and (is_inout or is_sink):
            _die(toks, _at(toks, i), "a variadic parameter cannot also be inout or sink")
        a, k := ty(toks, i)
        i = k
        push(out, ast.Param(nm, [a], is_inout, is_sink, is_variadic, pln))
        if not _isop(toks, i, lex.OP_COMMA):
            break
        i += 1
    i = _op(toks, i, ")")
    for k := 0; k + 1 < len(out); k += 1:
        if out[k].is_variadic:
            _die(toks, _at(toks, i0), "a variadic parameter must be the last parameter")
    return (out, i)

fn _is_where_pred(s: string) -> bool:
    return s == "numeric" or s == "comparable" or s == "has_str" or
           s == "hashable" or s == "defaultable"

fn _has_name(xs: [string], s: string) -> bool:
    for x in xs:
        if x == s:
            return true
    return false

# `tps` is the function's own `$T` parameters. src/tychoc.c@parse_fn closes both
# halves at parse time: the predicate against a fixed five-name set, and every
# type-parameter mention against the signature that was just read.
# The source text of the token span [a, b), joined tight -- a `where` type set
# is compared against a rendered type, and every set element in the corpus is a
# plain name.
# gap: a spaced spelling like `[string: int]` renders with the space and would
# not match this.
fn _spanttxt(toks: [lex.Tok], a: int, b: int) -> string:
    out := ""
    for k := a; k < b; k += 1:
        out = out + _at(toks, k).text
    return out

fn _wheres(toks: [lex.Tok], i0: int, tps: [string]) -> ([string], int):
    i := i0 + 1
    out := []string
    for true:
        p, j := _ident(toks, i, "a `where` predicate (numeric/comparable/has_str/hashable/defaultable) or a type parameter")
        i = j
        if _isop(toks, i, lex.OP_COLON):
            # type-set form `T: int | float`
            if not _has_name(tps, p):
                _die(toks, _at(toks, i), "`where " + p + ": ...`: '" + p + "' is not a type parameter of this function")
            a, k := ty(toks, i + 1)
            set := _spanttxt(toks, i + 1, k)
            i = k
            nset := 1
            for _isop(toks, i, lex.OP_PIPE):
                b, m := ty(toks, i + 1)
                set = set + "|" + _spanttxt(toks, i + 1, m)
                i = m
                nset += 1
            if nset > 16:
                _die(toks, _at(toks, i0), "at most 16 types in a `where` type set")
            # The SET is kept, not just the parameter name: the checker needs it
            # to refuse an instantiation outside it (src/tychoc.c:8982).
            push(out, p + ":" + set)
        else:
            if not _is_where_pred(p):
                _die(toks, _at(toks, i), "unknown `where` predicate '" + p +
                    "' (known: numeric, comparable, has_str, hashable, defaultable -- or use a type set, `T: int | float`)")
            i = _op(toks, i, "(")
            tn, k := _ident(toks, i, "a type-parameter name")
            if not _has_name(tps, tn):
                _die(toks, _at(toks, i), "`where` refers to '" + tn + "', which is not a type parameter of this function")
            i = _op(toks, k, ")")
            push(out, p + "(" + tn + ")")
        if not _isop(toks, i, lex.OP_COMMA):
            break
        i += 1
    if len(out) > 8:
        _die(toks, _at(toks, i0), "at most 8 `where` constraints per function")
    return (out, i)

fn _collect_typarams_ty(t: ast.Ty, acc: [string]) -> [string]:
    out := acc
    match t:
        ast.TParam(n):
            push(out, n)
            return out
        ast.TName(q, n, args):
            for a in args:
                out = _collect_typarams_ty(a, out)
            return out
        ast.TArr(k): return _collect_typarams_ty(k[0], out)
        ast.TSoa(k): return _collect_typarams_ty(k[0], out)
        ast.TFix(s, k): return _collect_typarams_ty(k[0], out)
        ast.TBnd(s, k): return _collect_typarams_ty(k[0], out)
        ast.TMap(ks):
            for a in ks:
                out = _collect_typarams_ty(a, out)
            return out
        ast.TTup(ks):
            for a in ks:
                out = _collect_typarams_ty(a, out)
            return out
        ast.TFn(hr, ks):
            for a in ks:
                out = _collect_typarams_ty(a, out)
            return out
        _: return out
    return out

# The `$N` size parameters of a signature, kept apart from the `$T` type
# parameters: src/tychoc.c@parse_fn counts either kind towards `generic`, but a
# `where` clause may only name a `$T`.
fn _collect_sizeparams_ty(t: ast.Ty, acc: [string]) -> [string]:
    out := acc
    match t:
        ast.TName(q, n, args):
            for a in args:
                out = _collect_sizeparams_ty(a, out)
            return out
        ast.TArr(k): return _collect_sizeparams_ty(k[0], out)
        ast.TSoa(k): return _collect_sizeparams_ty(k[0], out)
        ast.TFix(s, k):
            if len(s) > 0 and s[0] == 36:            # '$'
                push(out, s[1:])
            return _collect_sizeparams_ty(k[0], out)
        ast.TBnd(s, k): return _collect_sizeparams_ty(k[0], out)
        ast.TMap(ks):
            for a in ks:
                out = _collect_sizeparams_ty(a, out)
            return out
        ast.TTup(ks):
            for a in ks:
                out = _collect_sizeparams_ty(a, out)
            return out
        ast.TFn(hr, ks):
            for a in ks:
                out = _collect_sizeparams_ty(a, out)
            return out
        _: return out
    return out

# The function is parsed straight into the array slot that will hold it:
# returning it and pushing copies the whole body once per function.
fn _func_into(ps0: inout PS, toks: [lex.Tok], i0: int, notes: [lex.DNote], out: inout ast.Fn) -> int:
    i := _expect(toks, i0, lex.K_KW, "fn")
    nm, j := _ident(toks, i, "a procedure name")
    dn := lex.dnote_above(notes, _at(toks, i).line)
    i = _op(toks, j, "(")
    ps, k := _params(toks, i, "fn")
    i = k
    ret := []ast.Ty
    if _isop(toks, i, lex.OP_ARROW):
        # `_starts_type_lit`, not `_starts_type`: a RETURN type may be a
        # function type, which starts with the `fn` keyword.
        if not _starts_type_lit(toks, i + 1):
            # RECORDED, not fatal: the declaration is abandoned and `unit`
            # resyncs, so a second malformed declaration is reported too.
            push(ps0.errs, _where(toks, _at(toks, i + 1),
                "expected a type (int, float, bool, string, [int], or a struct)", false))
            ps0.failed = true
            out = ast.Fn(nm, ps, ret, []string, []string, []ast.Stmt, false, "", dn,
                _at(toks, i0).line)
            return i
        r, m := ty(toks, i + 1)
        push(ret, r)
        i = m
    tps := []string
    szs := []string
    for p in ps:
        for a in p.ty:
            tps = _collect_typarams_ty(a, tps)
            szs = _collect_sizeparams_ty(a, szs)
    for r in ret:
        tps = _collect_typarams_ty(r, tps)
        szs = _collect_sizeparams_ty(r, szs)
    wh := []string
    if _isid(toks, i, "where"):
        if len(tps) == 0 and len(szs) == 0:
            _die(toks, _at(toks, i), "`where` constraints require a generic function (one with a `$T` parameter)")
        w, m := _wheres(toks, i, tps)
        wh = w
        i = m
    i = _op(toks, i, ":")
    i = _expect(toks, i, lex.K_NEWLINE, "")
    body, m2 := block(toks, i)
    out = ast.Fn(nm, ps, ret, tps, wh, body, false, "", dn, _ln(toks, i0))
    return m2

fn externfn(toks: [lex.Tok], i0: int) -> (ast.Fn, int):
    i := i0 + 1
    lib := ""
    if _kis(toks, i, lex.K_STR):
        lib = _x(toks, i)
        i += 1
    i = _expect(toks, i, lex.K_KW, "fn")
    nm, j := _ident(toks, i, "a C function name")
    i = _op(toks, j, "(")
    ps, k := _params(toks, i, "extern")
    i = k
    ret := []ast.Ty
    if _isop(toks, i, lex.OP_ARROW):
        r, m := ty(toks, i + 1)
        push(ret, r)
        i = m
    i = _expect(toks, i, lex.K_NEWLINE, "")
    return (ast.Fn(nm, ps, ret, []string, []string, []ast.Stmt, true, lib, "", _ln(toks, i0)), i)

fn structd(toks: [lex.Tok], i0: int) -> (ast.StructD, int):
    i := _expect(toks, i0, lex.K_KW, "struct")
    nm, j := _ident(toks, i, "a struct name")
    i = j
    tps := []string
    if _isop(toks, i, lex.OP_LPAREN):
        i += 1
        for not _isop(toks, i, lex.OP_RPAREN):
            a, k := ty(toks, i)
            i = k
            tps = _collect_typarams_ty(a, tps)
            if not _isop(toks, i, lex.OP_COMMA):
                break
            i += 1
        i = _op(toks, i, ")")
        if len(tps) > 16:
            _die(toks, _at(toks, i0), "too many struct type parameters (max 16)")
    i = _op(toks, i, ":")
    i = _expect(toks, i, lex.K_NEWLINE, "")
    i = _expect(toks, i, lex.K_INDENT, "")
    fs := []ast.FieldD
    for not _kis(toks, i, lex.K_DEDENT) and not _kis(toks, i, lex.K_EOF):
        if _kis(toks, i, lex.K_NEWLINE):
            i += 1
            continue
        fln := _ln(toks, i)
        fn0, k := _ident(toks, i, "a field name")
        for g in fs:
            if g.name == fn0:
                _die(toks, _at(toks, i), "duplicate field '" + fn0 + "'")
        i = _op(toks, k, ":")
        ft, m := ty(toks, i)
        i = _expect(toks, m, lex.K_NEWLINE, "")
        push(fs, ast.FieldD(fn0, ft, fln))
    i = _expect(toks, i, lex.K_DEDENT, "")
    if len(fs) == 0:
        _die(toks, _at(toks, i0), "a struct needs at least one field")
    return (ast.StructD(nm, tps, fs, _ln(toks, i0)), i)

fn enumd(toks: [lex.Tok], i0: int) -> (ast.EnumD, int):
    i := _expect(toks, i0, lex.K_KW, "enum")
    nm, j := _ident(toks, i, "an enum name")
    i = j
    tps := []string
    if _isop(toks, i, lex.OP_LPAREN):
        i += 1
        for not _isop(toks, i, lex.OP_RPAREN):
            a, k := ty(toks, i)
            i = k
            tps = _collect_typarams_ty(a, tps)
            if not _isop(toks, i, lex.OP_COMMA):
                break
            i += 1
        i = _op(toks, i, ")")
        if len(tps) > 16:
            _die(toks, _at(toks, i0), "too many enum type parameters (max 16)")
    i = _op(toks, i, ":")
    i = _expect(toks, i, lex.K_NEWLINE, "")
    i = _expect(toks, i, lex.K_INDENT, "")
    vs := []ast.Variant
    for not _kis(toks, i, lex.K_DEDENT) and not _kis(toks, i, lex.K_EOF):
        if _kis(toks, i, lex.K_NEWLINE):
            i += 1
            continue
        vln := _ln(toks, i)
        vn, k := _ident(toks, i, "a variant name")
        i = k
        pl := []ast.Ty
        if _isop(toks, i, lex.OP_LPAREN):
            i += 1
            for not _isop(toks, i, lex.OP_RPAREN):
                a, m := ty(toks, i)
                push(pl, a)
                i = m
                if not _isop(toks, i, lex.OP_COMMA):
                    break
                i += 1
            i = _op(toks, i, ")")
            if len(pl) > 8:
                _die(toks, _at(toks, i), "too many payload fields (max 8)")
        i = _expect(toks, i, lex.K_NEWLINE, "")
        push(vs, ast.Variant(vn, pl, vln))
    i = _expect(toks, i, lex.K_DEDENT, "")
    if len(vs) == 0:
        _die(toks, _at(toks, i0), "an enum needs at least one variant")
    return (ast.EnumD(nm, tps, vs, _ln(toks, i0)), i)

fn handled(toks: [lex.Tok], i0: int) -> (ast.HandleD, int):
    i := _expect(toks, i0, lex.K_KW, "handle")
    nm, j := _ident(toks, i, "a handle name")
    i = _op(toks, j, ":")
    i = _expect(toks, i, lex.K_NEWLINE, "")
    i = _expect(toks, i, lex.K_INDENT, "")
    kwf, k := _ident(toks, i, "'free'")
    if kwf != "free":
        _die(toks, _at(toks, i), "a handle body is exactly 'free: <c_free_fn>'")
    i = _op(toks, k, ":")
    fnm, m := _ident(toks, i, "the C destructor function name")
    i = _expect(toks, m, lex.K_NEWLINE, "")
    i = _expect(toks, i, lex.K_DEDENT, "")
    return (ast.HandleD(nm, fnm, _ln(toks, i0)), i)

fn newtyped(toks: [lex.Tok], i0: int) -> (ast.NewtypeD, int):
    i := _expect(toks, i0, lex.K_KW, "type")
    nm, j := _ident(toks, i, "a type name")
    i = _op(toks, j, "=")
    u, k := ty(toks, i)
    i = _expect(toks, k, lex.K_NEWLINE, "")
    return (ast.NewtypeD(nm, u, _ln(toks, i0)), i)

# The child expressions of a node, so a place can be walked without a second
# copy of every variant. src/tychoc.c walks lhs/rhs/args for the same reason.
fn _kids(e: ast.Expr) -> [ast.Expr]:
    match e:
        ast.Field(l, k, f): return k
        ast.TupIdx(l, k, n): return k
        ast.Index(l, k): return k
        ast.Slice(l, a, b, k): return k
        ast.Call(l, q, n, ts, k): return k
        ast.CallVal(l, k): return k
        ast.Named(l, n, k): return k
        ast.Binop(l, o, k): return k
        ast.Unop(l, o, k): return k
        ast.IsVar(l, k, q, n): return k
        ast.ArrLit(l, k): return k
        ast.MapLit(l, k): return k
        ast.Tuple(l, k): return k
        ast.SomeE(l, k): return k
        ast.OkE(l, k): return k
        ast.ErrE(l, k): return k
        ast.SpawnE(l, k): return k
        ast.OrRet(l, k): return k
        ast.Spread(l, k): return k
        ast.Addr(l, k): return k
        ast.ChanE(l, t, k): return k
        ast.Lambda(l, p, r, k): return k
        _: return []ast.Expr
    return []ast.Expr

# src/tychoc.c@place_root_name: the base identifier of a place spine, or "" when
# the root is not a plain variable.
fn _place_root(e: ast.Expr) -> string:
    match e:
        ast.Name(l, n): return n
        ast.Field(l, k, f): return _place_root(k[0])
        ast.Index(l, k): return _place_root(k[0])
        _: return ""
    return ""

fn _uses(e: ast.Expr, name: string) -> int:
    cnt := 0
    match e:
        ast.Name(l, v):
            if v == name:
                cnt = 1
        _: pass
    for c in _kids(e):
        cnt += _uses(c, name)
    return cnt

fn subscriptd(toks: [lex.Tok], i0: int) -> (ast.SubscriptD, int):
    i := i0 + 1
    nm, j := _ident(toks, i, "a subscript name")
    i = _op(toks, j, "(")
    ps, k := _params(toks, i, "subscript")
    i = _op(toks, k, "->")
    if not _iskw(toks, i, lex.KW_INOUT):
        _die(toks, _at(toks, i), "a subscript must yield an inout projection: `-> inout <type>`")
    r, m := ty(toks, i + 1)
    i = _op(toks, m, ":")
    i = _expect(toks, i, lex.K_NEWLINE, "")
    i = _expect(toks, i, lex.K_INDENT, "")
    for _kis(toks, i, lex.K_NEWLINE):
        i += 1
    if not _isid(toks, i, "yield"):
        _die(toks, _at(toks, i), "a subscript body must be a single `yield &<place>`")
    y := ast.NullLit(0)
    n := _expr_into(toks, i + 1, &y)
    i = n
    if not (y is ast.Addr):
        _die(toks, _at(toks, i0), "a subscript must yield a place: `yield &<place>`")
    for _kis(toks, i, lex.K_NEWLINE):
        i += 1
    i = _expect(toks, i, lex.K_DEDENT, "")
    # The two rules src/tychoc.c@parse_subscript checks structurally, right here:
    # a place rooted anywhere but a parameter would dangle, and a parameter used
    # twice in the place would be evaluated twice at the call site.
    inner := _kids(y)[0]
    rooted := false
    for p in ps:
        if p.name == _place_root(inner):
            rooted = true
    if not rooted:
        _die(toks, _at(toks, i0), "a subscript must yield a place rooted in one of its parameters (else the projection would dangle)")
    for p in ps:
        if _uses(inner, p.name) > 1:
            _die(toks, _at(toks, i0), "subscript parameter '" + p.name +
                "' is used more than once in the yielded place (v1: at most once)")
    return (ast.SubscriptD(nm, ps, r, y, _ln(toks, i0)), i)

# src/tychoc.c@is_literal_expr. An f-string is deliberately not one: its body is
# not known until the interpolations are resolved.
fn _is_lit(e: ast.Expr) -> bool:
    if e is ast.IntLit:
        return true
    if e is ast.FloatLit:
        return true
    if e is ast.BoolLit:
        return true
    if e is ast.StrLit:
        return true
    if e is ast.CharLit:
        return true
    return false

fn _const_ref(cs: [ast.ConstD], name: string) -> [ast.Expr]:
    out := []ast.Expr
    for c in cs:
        if c.name == name:
            push(out, c.value)
    return out

fn _int_of(e: ast.Expr) -> ([int], bool):
    match e:
        ast.IntLit(l, v): return ([v], true)
        _: return ([]int, false)
    return ([]int, false)

# src/tychoc.c@const_fold, the top-level `refs` form: a `const` is folded to one
# literal AT PARSE TIME, so `const MB = 1024 * 1024` is a literal and anything
# that does not collapse -- an array, a forward reference, a call -- is refused
# by the caller. Divide-by-zero and a negative shift die here, as they do there.
fn _const_fold(toks: [lex.Tok], e: ast.Expr, cs: [ast.ConstD], t: lex.Tok) -> ast.Expr:
    match e:
        ast.Name(l, n):
            r := _const_ref(cs, n)
            if len(r) == 1:
                return r[0]
            return e
        ast.Unop(l, o, k):
            a := _const_fold(toks, k[0], cs, t)
            if o == "-":
                match a:
                    ast.IntLit(l2, v): return ast.IntLit(l2, -v)
                    ast.FloatLit(l2, v): return ast.FloatLit(l2, -v)
                    _: return e
            if o == "~":
                match a:
                    ast.IntLit(l2, v): return ast.IntLit(l2, ~v)
                    _: return e
            return e
        ast.Binop(l, o, k):
            if len(k) != 2:
                return e
            a := _const_fold(toks, k[0], cs, t)
            b := _const_fold(toks, k[1], cs, t)
            if o == "+":
                match a:
                    ast.StrLit(l2, x):
                        match b:
                            ast.StrLit(l3, y): return ast.StrLit(l2, x + y)
                            _: pass
                    _: pass
            xs, aok := _int_of(a)
            ys, bok := _int_of(b)
            if not aok or not bok:
                return e
            x := xs[0]
            y := ys[0]
            if o == "+":
                return ast.IntLit(l, x + y)
            if o == "-":
                return ast.IntLit(l, x - y)
            if o == "*":
                return ast.IntLit(l, x * y)
            if o == "/" or o == "%":
                if y == 0:
                    _die(toks, t, "const expression divides by zero")
                if o == "/":
                    return ast.IntLit(l, x / y)
                return ast.IntLit(l, x % y)
            if o == "&":
                return ast.IntLit(l, x & y)
            if o == "|":
                return ast.IntLit(l, x | y)
            if o == "^":
                return ast.IntLit(l, x ^ y)
            if o == "<<" or o == ">>":
                if y < 0:
                    _die(toks, t, "const expression shifts by a negative count")
                if y >= 64:
                    return ast.IntLit(l, 0)
                if o == "<<":
                    return ast.IntLit(l, x << y)
                return ast.IntLit(l, x >> y)
            return e
        _: return e
    return e

# The resync point: the next token in COLUMN 1 at bracket depth 0, which is
# where a new declaration can start. Tracking INDENT/DEDENT matters -- those
# carry column 0 and would otherwise stop the scan on the first body line.
fn _resync(toks: [lex.Tok], i0: int) -> int:
    i := i0
    depth := 0
    for i < len(toks) and not _kis(toks, i, lex.K_EOF):
        k := _k(toks, i)
        if k == lex.K_INDENT:
            depth += 1
        elif k == lex.K_DEDENT:
            if depth > 0:
                depth -= 1
        elif depth == 0 and _at(toks, i).col == 1 and i > i0:
            if k == lex.K_KW or k == lex.K_IDENT:
                return i
        i += 1
    return i

fn _empty_fn() -> ast.Fn:
    return ast.Fn("", []ast.Param, []ast.Ty, []string, []string, []ast.Stmt, false, "", "", 0)

# The Unit is written into the CALLER's own. Returning it copied every
# declaration -- every function body -- out of this scope, and _merge then
# copied the whole tree again on the way into ld.files.
fn unit_into(toks: [lex.Tok], notes: [lex.DNote], out: inout ast.Unit):
    ps0 := PS([]string, false)
    i := 0
    for not _kis(toks, i, lex.K_EOF):
        if _kis(toks, i, lex.K_NEWLINE):
            i += 1
            continue
        if _isid(toks, i, "package"):
            p, j := _ident(toks, i + 1, "a package name after `package`")
            out.pkg = p
            i = j
            if _kis(toks, i, lex.K_NEWLINE):
                i += 1
            continue
        if _isid(toks, i, "import"):
            iln := _ln(toks, i)
            i += 1
            alias := ""
            if _kis(toks, i, lex.K_IDENT):
                alias = _x(toks, i)
                i += 1
            if not _kis(toks, i, lex.K_STR):
                _fail(toks, _at(toks, i), "an import path string")
            push(out.imports, ast.ImportD(alias, _x(toks, i), iln))
            i += 1
            if _kis(toks, i, lex.K_NEWLINE):
                i += 1
            continue
        if _isid(toks, i, "extern") and not _isop(toks, i + 1, lex.OP_LPAREN):
            f, j := externfn(toks, i)
            push(out.fns, f)
            i = j
            continue
        if _isid(toks, i, "const"):
            ct := _at(toks, i)
            nm, j := _ident(toks, i + 1, "a constant name after 'const'")
            i = _op(toks, j, "=")
            e := ast.NullLit(0)
            k := _expr_into(toks, i, &e)
            i = _expect(toks, k, lex.K_NEWLINE, "")
            v := _const_fold(toks, e, out.consts, ct)
            if not _is_lit(v):
                _die(toks, ct, "a `const` must be a single scalar literal -- an int, float, string, bool or char. Arrays, maps and struct literals are not allowed, and neither is an expression")
            push(out.consts, ast.ConstD(nm, v, ct.line))
            continue
        if _isid(toks, i, "subscript"):
            s, j := subscriptd(toks, i)
            push(out.subscripts, s)
            i = j
            continue
        if _iskw(toks, i, lex.KW_STRUCT):
            s, j := structd(toks, i)
            push(out.structs, s)
            i = j
            continue
        if _iskw(toks, i, lex.KW_ENUM):
            e, j := enumd(toks, i)
            push(out.enums, e)
            i = j
            continue
        if _iskw(toks, i, lex.KW_HANDLE):
            h, j := handled(toks, i)
            push(out.handles, h)
            i = j
            continue
        if _iskw(toks, i, lex.KW_TYPE):
            n, j := newtyped(toks, i)
            push(out.newtypes, n)
            i = j
            continue
        push(out.fns, _empty_fn())
        j := _func_into(&ps0, toks, i, notes, &out.fns[len(out.fns) - 1])
        if ps0.failed:
            ps0.failed = false
            pop(out.fns)
            i = _resync(toks, j)
            continue
        i = j
    if len(ps0.errs) > 0:
        msg := ""
        for e in ps0.errs:
            if len(msg) > 0:
                msg = msg + "\n"
            msg = msg + e
        die(msg)

# The by-value form, for the two callers that want a fresh tree.
fn unit(toks: [lex.Tok], notes: [lex.DNote]) -> ast.Unit:
    u := ast.Unit("", []ast.ImportD, []ast.Fn, []ast.StructD, []ast.EnumD,
        []ast.NewtypeD, []ast.HandleD, []ast.ConstD, []ast.SubscriptD)
    unit_into(toks, notes, &u)
    return u
