package driver

import "core:io"
import "core:os"
import "core:sort"
import "core:strings"
import "../ast"
import "../emit"
import "../lex"
import "../parse"
import "../types"

# The compile pipeline, and the one place that knows where the runtime source
# lives. src/tychoc.c embeds runtime/tycho_rt.c at BUILD time via an awk-made
# header; tychoc1 reads the same file at EMIT time instead, which keeps the two
# compilers on one copy of the runtime at the cost of tychoc1 needing that path
# to exist. `--runtime` is the escape hatch when it does not.

# The runtime is COPIED FILE-TO-FILE, never read into a string. It is 140 KB and
# the string form cost six copies of it on every compile -- the read's own
# doubling realloc, the FFI hop, the bytes->string cast, two returns and the
# concatenation with the emitted C -- which was 65.9% of the instructions tychoc1
# spent compiling a two-line program. io.copy leaves `dst` untouched when a
# candidate is not there, so the fallback list below cannot truncate the output.
fn write_runtime(path: string, argv0: string, dst: string):
    match io.copy(path, dst):
        Ok: return
        Err(e): pass
    # The default path is relative to the CWD, which is only right when tychoc1
    # is run from the repo root -- `cd tmp && tychoc1 x.ty` could not build at
    # all. Fall back beside the binary, as corelib_root does.
    d := types.dir_of(argv0)
    for c in [d + "/runtime/tycho_rt.c", d + "/../runtime/tycho_rt.c",
              d + "/../share/tycho/runtime/tycho_rt.c"]:
        match io.copy(c, dst):
            Ok: return
            Err(e): pass
    die("tychoc1: cannot read runtime '" + path + "'")
    return

# The whole loaded program, not just the entry file. `types.load` already walks
# the package graph -- corelib root, per-file imports, post-order, cycle
# detection -- so emit is handed every file with the package prefix the loader
# gave it, and mangles against that (src/tychoc.c@pkg_prefix_for).
fn emit_to(p: types.Program, runtime_path: string, argv0: string, out_c: string):
    write_runtime(runtime_path, argv0, out_c)
    pfx := []string
    us := []ast.Unit
    for f in p.files:
        push(pfx, f.prefix)
        push(us, f.unit)
    match io.append_text(out_c, emit.program(pfx, us)):
        Ok: return
        Err(e): die("tychoc1: cannot write '" + out_c + "'")
    return

# Refuse what the front end refuses, before emitting anything. Until Phase 7d
# this ran lex -> parse -> emit and never called resolve or check, so 120 of the
# 337 reject fixtures compiled to C in silence while `--typecheck` refused them.
fn check_into(src_path: string, argv0: string, p: inout types.Program):
    types.load_into(src_path, argv0, &p)
    rs := types.resolve(p)
    # Warnings come FIRST, even on a build that dies: ./tychoc writes each one
    # to stderr as it is raised, so `fn die(...)` in tests/diag prints the
    # collision warning and then the hard error.
    wl := ""
    for w in types.warn_lines(rs):
        wl = wl + w + "\n"
    eprint(wl)
    if len(rs.errs) > 0:
        out := ""
        for e in rs.errs:
            out = out + e + "\n"
        eprint(out)
        exit(1)
    cs := types.check(p)
    cwl := ""
    for w in types.check_warns(cs):
        cwl = cwl + w + "\n"
    eprint(cwl)
    errs := types.check_errs(cs)
    if len(errs) > 0:
        out2 := ""
        for e in errs:
            out2 = out2 + e + "\n"
        eprint(out2)
        exit(1)
    return


# --- the build path ------------------------------------------------------------
# Until now tychoc1 only ever emitted C. `tychoc <file> -o <name>` has to reach a
# BINARY, which means the same cc line src/tychoc.c builds: the shims each loaded
# corelib package ships, the -l for each `extern "Lib"`, and -I the corelib root.

fn _shims(p: types.Program) -> [string]:
    out := []string
    seen := []string: bool
    for f in p.files:
        if len(f.pkg) == 0 or f.dir in seen:
            continue
        seen[f.dir] = true
        c := f.dir + "/" + f.pkg + "_shim.c"
        match io.read_text(c):
            Ok(s): push(out, c)
            Err(e): pass
    return out

fn _links(p: types.Program) -> [string]:
    out := []string
    seen := []string: bool
    for f in p.files:
        for fd in f.unit.fns:
            if fd.is_extern and len(fd.lib) > 0 and not (fd.lib in seen):
                seen[fd.lib] = true
                push(out, fd.lib)
    return out

# NEVER eat a .c this compiler did not write (src/tychoc.c:14399). A file WE left
# behind starts with the runtime banner and is fair game; anything else is the
# user's and the intermediate would destroy it.
fn _guard_c(c_path: string):
    match io.read_text(c_path):
        Ok(s):
            head := s
            if len(head) > 79:
                head = head[0:79]
            if not strings.contains(head, "Tycho runtime"):
                eprint("tychoc1: " + c_path + " already exists and was not written by tychoc1 -- " +
                    "the intermediate C would destroy it.\n" +
                    "  rename it, or build elsewhere with -o <dir>/<name>\n")
                exit(1)
        Err(e): pass

# The pkg-config flags every loaded package asks for, in one list. A package
# with no `deps` file contributes nothing; a pkg-config that fails is skipped
# rather than fatal, exactly as a missing optional dependency is elsewhere.
# gap: the flags are split on spaces, so a path containing a space would break.
fn _pkgflags(p: types.Program) -> [string]:
    out := []string
    seen := []string: bool
    for f in p.files:
        if f.dir in seen:
            continue
        seen[f.dir] = true
        match io.read_text(f.dir + "/deps"):
            Ok(txt):
                for ln in split(txt, "\n"):
                    t := strings.trim(ln)
                    if len(t) == 0 or t[0] == 35 or (t in seen):
                        continue
                    seen[t] = true
                    r := os.run("pkg-config --cflags --libs " + t)
                    if r.code != 0:
                        continue
                    for w in split(strings.trim(r.out), " "):
                        if len(strings.trim(w)) > 0:
                            push(out, strings.trim(w))
            Err(e): pass
    return out

# `cc9` is the C compiler to drive (--cc), `xtra` the -L/-I/-l/pkg-config flags
# (--link, --pkg, -L, -I), `shim9` the extra shim sources (--shim), and `nat`
# is --native. src/tychoc.c takes all five; tychoc1 took none, so an FFI build
# could not name its library at all.
fn build(src_path: string, runtime_path: string, base: string, argv0: string,
         cc9: string, xtra: [string], shim9: [string], nat: bool, dbg: bool):
    c_path := base + ".c"
    _guard_c(c_path)
    p := types.Program([]types.File, "", "", "", "")
    check_into(src_path, argv0, &p)
    emit_to(p, runtime_path, argv0, c_path)
    # -O2 and -fno-semantic-interposition were measured here and neither pays:
    # compiling compiler/main.ty is 1181.3e6 Ir at -O2 against 1051.3e6 at -O3,
    # and -fno-semantic-interposition moves nothing (one static TU, nothing to
    # interpose). `--param inline-unit-growth=150` DOES -- 1051.3e6 -> 864.2e6 Ir
    # and a wall ratio vs ./tychoc of 1.134 -> 0.984 -- and is deliberately NOT
    # taken: this line builds EVERY Tycho program, and bench/transient is 3-5%
    # SLOWER under it at every growth value tested (+1.3% at 40, +4.3% at 60,
    # +4.5% at 100), the regression scaling with the budget. `sh bench/run.sh`
    # cannot see any of this -- it compiles with its own `cc -O2 -std=c11` line
    # and never reads this one, so it is green for a flag change either way.
    # TYCHO_CFLAGS appends to the cc line. It exists so the MAKEFILE can pick
    # the compiler binary's own flags, exactly as it picks ./tychoc's -O2,
    # without changing what every other Tycho program is built with.
    argv := [cc9, "-O3", "-fwrapv", "-pthread"]
    if nat:
        push(argv, "-march=native")
    if dbg:
        push(argv, "-g")
    for f in split(getenv("TYCHO_CFLAGS"), " "):
        if len(f) > 0:
            push(argv, f)
    root := types.corelib_root(argv0)
    if len(root) > 0:
        push(argv, "-I" + root)
    push(argv, "-o")
    push(argv, base)
    push(argv, c_path)
    for sh in _shims(p):
        push(argv, sh)
    for sh9 in shim9:
        push(argv, sh9)
    for l in _links(p):
        push(argv, "-l" + l)
    # Each loaded package's `deps` file names pkg-config packages; their cflags
    # and libs go on the cc line, or a program using core:tls/zip/compress/
    # crypto/image/http/sqlite does not LINK (24 of them did not).
    for fl in _pkgflags(p):
        push(argv, fl)
    for x9 in xtra:
        push(argv, x9)
    push(argv, "-lm")
    if os.exec(argv) != 0:
        # the .c SURVIVES a cc failure on purpose: it is the evidence
        eprint("tychoc1: C compilation failed\n")
        exit(1)
    match io.remove(c_path):
        Ok(b): pass
        Err(e): pass
    print("built " + base + "\n")

# --- --bundle ------------------------------------------------------------------
# The whole import graph as one post-order source stream. types.load already walks
# it in that order, so the only work here is the entry package's header: its files
# become `package main`, because the bundle has no prefixes.

fn _as_main(src: string) -> string:
    i := 0
    for i < len(src):
        e := i
        for e < len(src) and src[e] != 10:
            e += 1
        if strings.starts_with(src[i:e], "package "):
            return src[0:i] + "package main" + src[e:]
        if e >= len(src):
            break
        i = e + 1
    return src

fn bundle(src_path: string, argv0: string):
    p := types.Program([]types.File, "", "", "", "")
    types.load_into(src_path, argv0, &p)
    out := ""
    for f in p.files:
        if f.dir == p.entry_dir:
            out = out + _as_main(f.src) + "\n"
        else:
            out = out + f.src + "\n"
    print(out)

# `--print-shims` / `--print-deps`: the transitive closure of the C shims each
# loaded package ships, and the pkg-config NAMES it needs. The harnesses read
# both -- one to link, the other to decide whether a missing library is a SKIP
# rather than a failure (src/tychoc.c's own comment beside print_deps).
fn print_shims(src_path: string, argv0: string):
    p := types.Program([]types.File, "", "", "", "")
    types.load_into(src_path, argv0, &p)
    out := ""
    for c in _shims(p):
        out = out + c + "\n"
    print(out)

fn print_deps(src_path: string, argv0: string):
    p := types.Program([]types.File, "", "", "", "")
    types.load_into(src_path, argv0, &p)
    seen := []string: bool
    out := ""
    for f in p.files:
        if f.dir in seen:
            continue
        seen[f.dir] = true
        match io.read_text(f.dir + "/deps"):
            Ok(txt):
                for ln in split(txt, "\n"):
                    t := strings.trim(ln)
                    if len(t) > 0 and t[0] != 35 and not (t in seen):
                        seen[t] = true
                        out = out + t + "\n"
            Err(e): pass
    print(out)

fn compile(src_path: string, runtime_path: string, out_c: string, argv0: string):
    p := types.Program([]types.File, "", "", "", "")
    check_into(src_path, argv0, &p)
    emit_to(p, runtime_path, argv0, out_c)

# --- --dump-tokens ----------------------------------------------------------
# The lexer's own gate. One line per token so a disagreement names a position
# rather than a file.

fn dump_tokens(src_path: string):
    src := ""
    match io.read_text(src_path):
        Ok(s): src = s
        Err(e): die("tychoc1: cannot read '" + src_path + "'")
    toks := lex.tokenize(src)
    out := ""
    for k := 0; k < len(toks); k += 1:
        t := toks[k]
        out = out + str(t.line) + ":" + str(t.col) + " " + lex.kname(t.k) + " " + lex.spell(t) + "\n"
    print(out)

# The `# deprecated:` notes the lexer kept, one per line, so the fn each one
# attaches to can be named. `dnote_above` is the same lookup src/tychoc.c does.
fn dump_dnotes(src_path: string):
    src := ""
    match io.read_text(src_path):
        Ok(s): src = s
        Err(e): die("tychoc1: cannot read '" + src_path + "'")
    notes := lex.dnotes(src)
    toks := lex.tokenize(src)
    out := ""
    for k := 0; k < len(notes); k += 1:
        out = out + str(notes[k].line) + " deprecated: " + notes[k].msg + "\n"
    for k := 0; k + 1 < len(toks); k += 1:
        if toks[k].k == lex.K_KW and toks[k].text == "fn" and toks[k + 1].k == lex.K_IDENT:
            d := lex.dnote_above(notes, toks[k].line)
            if len(d) > 0:
                out = out + "attached fn " + toks[k + 1].text + ": " + d + "\n"
    print(out)

# Whitespace is the only thing a token stream is allowed to lose, so it is
# removed from BOTH sides -- including from inside string literals, since the
# same removal is applied to each. What survives is the real property: every
# non-whitespace byte of the source is covered by exactly one token, in order.
fn strip_ws(s: string) -> string:
    out := ""
    seg := 0
    for k := 0; k < len(s); k += 1:
        c := s[k]
        if c == 32 or c == 9 or c == 13 or c == 10:
            out = out + s[seg:k]
            seg = k + 1
    return out + s[seg:]

fn roundtrip(src_path: string):
    src := ""
    match io.read_text(src_path):
        Ok(s): src = s
        Err(e): die("tychoc1: cannot read '" + src_path + "'")
    toks := lex.tokenize_ex(src, true)
    joined := ""
    for k := 0; k < len(toks); k += 1:
        joined = joined + toks[k].raw
    a := strip_ws(src)
    b := strip_ws(joined)
    if a == b:
        print("RT-OK " + str(len(a)) + "\n")
        return
    d := 0
    for d < len(a) and d < len(b) and a[d] == b[d]:
        d += 1
    print("RT-FAIL " + src_path + " src=" + str(len(a)) + " toks=" + str(len(b)) +
        " first-diff-at=" + str(d) + " src<<" + a[d:d + 30] + ">> toks<<" + b[d:d + 30] + ">>\n")
    die("round trip failed")

# --- --parse / --parse-census -----------------------------------------------
# The parser's own gate. `--parse` is the accept/reject verdict; `--parse-census`
# is the leg that verdict cannot carry, because a wrong tree still parses.

fn _read(src_path: string) -> string:
    match io.read_text(src_path):
        Ok(s): return s
        Err(e): die("tychoc1: cannot read '" + src_path + "'")
    return ""

fn parse_only(src_path: string):
    toks, notes := lex.tokenize_all(_read(src_path), false)
    u := parse.unit(toks, notes)
    print("PARSE-OK " + str(len(u.fns)) + "\n")

fn parse_census(src_path: string):
    toks, notes := lex.tokenize_all(_read(src_path), false)
    u := parse.unit(toks, notes)
    ks := ast.census(u)
    counts := []string: int
    for k in ks:
        counts[k] = counts.get(k, 0) + 1
    names := keys(counts)
    sort.asc(names)
    out := ""
    for n in names:
        out = out + n + " " + str(counts[n]) + "\n"
    print(out)

# --- --resolve / --resolve-census / --dump-symbols ---------------------------
# Phase 5's gates. `--resolve` is the accept/reject verdict for NAME resolution;
# `--resolve-census` is the leg that verdict cannot carry, because a name that
# resolves to the WRONG declaration is accepted either way -- it prints the
# resolved, package-mangled name of every use, so a misresolution moves a
# counted line. `--dump-symbols` is the table itself.

fn resolve_only(src_path: string, argv0: string):
    p := types.Program([]types.File, "", "", "", "")
    types.load_into(src_path, argv0, &p)
    rs := types.resolve(p)
    if len(rs.errs) > 0:
        out := ""
        for e in rs.errs:
            out = out + e + "\n"
        eprint(out)
        exit(1)
    out2 := ""
    for l in types.late_lines(rs):
        out2 = out2 + "late: " + l + "\n"
    eprint(out2)
    print("RESOLVE-OK files=" + str(len(p.files)) + " symbols=" + str(len(rs.syms)) +
        " late=" + str(len(types.late_lines(rs))) + "\n")

fn resolve_census(src_path: string, argv0: string):
    p := types.Program([]types.File, "", "", "", "")
    types.load_into(src_path, argv0, &p)
    rs := types.resolve(p)
    out := ""
    for l in types.census_lines(rs):
        out = out + l + "\n"
    print(out)

fn dump_symbols(src_path: string, argv0: string):
    p := types.Program([]types.File, "", "", "", "")
    types.load_into(src_path, argv0, &p)
    rs := types.resolve(p)
    out := ""
    for l in types.symbol_lines(rs):
        out = out + l + "\n"
    print(out)

# --- --typecheck / --type-census --------------------------------------------
# Phase 6a. NAME resolution runs first and its diagnostics win, exactly as
# src/tychoc.c resolves a name before it can have a type -- so a file that fails
# to resolve reports the same message it did at Phase 5, and the TYPE class is
# only ever reached on a file that resolves cleanly.

fn typecheck_only(src_path: string, argv0: string):
    p := types.Program([]types.File, "", "", "", "")
    types.load_into(src_path, argv0, &p)
    rs := types.resolve(p)
    if len(rs.errs) > 0:
        out := ""
        for e in rs.errs:
            out = out + e + "\n"
        eprint(out)
        exit(1)
    cs := types.check(p)
    errs := types.check_errs(cs)
    if len(errs) > 0:
        out2 := ""
        for e in errs:
            out2 = out2 + e + "\n"
        eprint(out2)
        exit(1)
    sixb := "0"
    if types.check_uses6b(cs):
        sixb = "1"
    print("TYPECHECK-OK files=" + str(len(p.files)) + " sixb=" + sixb + "\n")

fn type_census(src_path: string, argv0: string):
    p := types.Program([]types.File, "", "", "", "")
    types.load_into(src_path, argv0, &p)
    rs := types.resolve(p)
    if len(rs.errs) > 0:
        exit(1)
    cs := types.check(p)
    out := ""
    for l in types.check_census(cs):
        out = out + l + "\n"
    print(out)

# A written type back as source text, for the --symbols index. _enc and _ty
# both need their pass's context; this needs neither.
fn _ty_src(t: ast.Ty) -> string:
    match t:
        ast.TPrim(n): return n
        ast.TParam(n): return "$" + n
        ast.TName(q, n, a):
            base := n
            if len(q) > 0:
                base = q + "." + n
            if len(a) == 0:
                return base
            out := base + "("
            for i := 0; i < len(a); i += 1:
                if i > 0:
                    out = out + ", "
                out = out + _ty_src(a[i])
            return out + ")"
        ast.TArr(e):
            if len(e) == 1:
                return "[" + _ty_src(e[0]) + "]"
        ast.TFix(n, e):
            if len(e) == 1:
                return "[" + n + "]" + _ty_src(e[0])
        ast.TMap(e):
            if len(e) == 2:
                return "[" + _ty_src(e[0]) + ": " + _ty_src(e[1]) + "]"
        ast.TTup(e):
            out2 := "("
            for i := 0; i < len(e); i += 1:
                if i > 0:
                    out2 = out2 + ", "
                out2 = out2 + _ty_src(e[i])
            return out2 + ")"
        ast.TSoa(e):
            if len(e) == 1:
                return "soa [" + _ty_src(e[0]) + "]"
        ast.TBnd(n, e):
            if len(e) == 1:
                return "bounded[" + n + "]" + _ty_src(e[0])
        ast.TFn(hr, e):
            out3 := "fn("
            np := len(e)
            if hr:
                np = np - 1
            for i := 0; i < np; i += 1:
                if i > 0:
                    out3 = out3 + ", "
                out3 = out3 + _ty_src(e[i])
            out3 = out3 + ")"
            if hr and len(e) > 0:
                out3 = out3 + " -> " + _ty_src(e[len(e) - 1])
            return out3
        _: pass
    return "?"

# --- --symbols: the LSP index, in src/tychoc.c@emit_symbols' exact format -----
# Tab-separated, one record per line. tychoc1's own --dump-symbols is a DEBUG
# dump in a different shape; an editor reading this one needs the reference's.

# Prints per record. Accumulating into one string is quadratic under value
# semantics -- every `out = out + x` copies the whole buffer -- and over a
# corelib-sized program that never finished.
fn _sym_locals(b: [ast.Stmt], fnline: int):
    for s in b:
        match s:
            ast.Decl(l, n, t, r, v):
                ty9 := "?"
                if len(t) == 1:
                    ty9 = _ty_src(t[0])
                print("local\t" + n + "\t" + ty9 + "\t" + str(fnline) + "\t" + str(l) + "\n")
            ast.MDecl(l, d, ns, r):
                for n2 in ns:
                    print("local\t" + n2 + "\t?\t" + str(fnline) + "\t" + str(l) + "\n")
            ast.IfS(l, c, bb, e):
                _sym_locals(bb, fnline)
                _sym_locals(e, fnline)
            ast.WhileS(l, c, bb): _sym_locals(bb, fnline)
            ast.For3(l, ip, c, bb):
                _sym_locals(ip, fnline)
                _sym_locals(bb, fnline)
            ast.ForIn(l, n, c, bb): _sym_locals(bb, fnline)
            ast.ForRange(l, n, c, bb): _sym_locals(bb, fnline)
            ast.MatchS(l, sj, arms):
                for a in arms:
                    _sym_locals(a.body, fnline)
            ast.SelectS(l, arms):
                for a in arms:
                    _sym_locals(a.body, fnline)
            _: pass
    return

fn emit_symbols(src_path: string, argv0: string):
    p := types.Program([]types.File, "", "", "", "")
    types.load_into(src_path, argv0, &p)
    for f in p.files:
        for fd in f.unit.fns:
            nm9 := f.prefix + fd.name
            sig := "fn " + nm9 + "("
            for j := 0; j < len(fd.params); j += 1:
                if j > 0:
                    sig = sig + ", "
                pt := "?"
                if len(fd.params[j].ty) == 1:
                    pt = _ty_src(fd.params[j].ty[0])
                sig = sig + fd.params[j].name + ": " + pt
            sig = sig + ")"
            if len(fd.ret) == 1:
                sig = sig + " -> " + _ty_src(fd.ret[0])
            print("fn\t" + nm9 + "\t" + str(fd.line) + "\t" + sig + "\n")
            for j := 0; j < len(fd.params); j += 1:
                pt2 := "?"
                if len(fd.params[j].ty) == 1:
                    pt2 = _ty_src(fd.params[j].ty[0])
                print("param\t" + fd.params[j].name + "\t" + pt2 + "\t" + str(fd.line) + "\n")
            _sym_locals(fd.body, fd.line)
        for sd in f.unit.structs:
            print("struct\t" + f.prefix + sd.name + "\t" + str(sd.line) + "\n")
            for j := 0; j < len(sd.fields); j += 1:
                print("field\t" + f.prefix + sd.name + "\t" + sd.fields[j].name + "\t" +
                    _ty_src(sd.fields[j].ty) + "\n")
        for ed in f.unit.enums:
            print("enum\t" + f.prefix + ed.name + "\t" + str(ed.line) + "\n")
            for j := 0; j < len(ed.variants); j += 1:
                print("variant\t" + f.prefix + ed.name + "\t" + ed.variants[j].name + "\n")
