# run.sh builds into a `mktemp -d` (examples/webserver/run.sh), so nothing
# lands here from the gate. These catch the manual form: the README's
# `./tychoc examples/webserver/main.ty -o server` run from inside this directory,
# and the mechanical `-o examples/webserver/main` (plus main.c with --emit-c).
# The self-test and `--serve` write nothing; content/ IS tracked input.
# (expected.out is un-ignored in the root .gitignore, like the other goldens.)
/main
/main.c
/server
/server.c
