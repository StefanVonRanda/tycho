package main

# A web server, written in Tycho, that serves a small site -- a landing page, a
# Markdown blog (index + posts), and a Markdown wiki -- over core:httpd + core:net,
# rendering content through core:markdown inside a shared HTML layout. This is the
# website dogfood: it exercises the HTTP server plumbing, the new markdown renderer
# (its second consumer, after examples/site), and io/path/sort together.
#
#   ./server --serve            # listen on 127.0.0.1:8080
#   ./server                    # self-test: dispatch fixed routes and print them
#                               #  (deterministic -> golden-locked; see run.sh)
#
# Routing is a pure `route(req) -> Response`; --serve wraps it in a net accept
# loop, the self-test wraps it in a fixed-path loop -- so the interesting logic is
# transport-independent and testable without a live socket.

import "core:httpd"
import "core:net"
import "core:io"
import "core:result"
import "core:strings"
import "core:sort"
import "core:markdown"

const ROOT = "examples/webserver/content"
const IDLE_MS = 5000        # drop a keep-alive connection idle this long

struct Page:
    ok: bool
    title: string
    date: string
    body_html: string

# A URL path segment used to build a filename must be alnum+dash only -- reject
# anything else (Rule 5: blocks `..`, `/`, and other path-traversal payloads).
fn safe_slug(s: string) -> bool:
    if s == "" or len(s) > 64:
        return false
    i := 0
    for i < len(s):
        c := s[i]
        ok := (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 45   # a-z 0-9 -
        if not ok:
            return false
        i = i + 1
    return true

# --- static assets ---
struct Asset:
    ok: bool
    ctype: string
    body: bytes

fn safe_asset(name: string) -> bool:
    if name == "" or len(name) > 64:
        return false
    if strings.contains(name, "/") or strings.contains(name, ".."):
        return false
    i := 0
    for i < len(name):
        c := name[i]
        ok := (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 45 or c == 46
        if not ok:
            return false
        i = i + 1
    return true

fn static_asset(p: string) -> Asset:
    name := ""
    if p == "/favicon.ico":
        name = "favicon.png"
    elif strings.starts_with(p, "/static/"):
        name = substr(p, 8, len(p))
    else:
        return Asset(false, "", to_bytes(""))
    if not safe_asset(name):
        return Asset(false, "", to_bytes(""))
    # io.read_bytes returns Result(bytes, io.IoErr): a missing asset is
    # Err(io.NotFound), which no longer looks like a zero-byte file.
    rb := io.read_bytes(ROOT + "/static/" + name)
    if result.is_err(rb):
        return Asset(false, "", to_bytes(""))
    return Asset(true, httpd.content_type(name), result.unwrap_or(rb, to_bytes("")))

# Assets go through the ordinary Response path now that bodies are `bytes` --
# the hand-rolled header writer this example used to carry is gone.
fn asset_response(a: Asset) -> httpd.Response:
    return httpd.with_header(httpd.response(200, a.body), "Content-Type", a.ctype)

# Read `<ROOT>/<rel>`, peel an optional leading `date: ...` frontmatter line, take
# the title from the first `# ` heading, and render the body Markdown to HTML.
fn load_page(rel: string) -> Page:
    raw := io.read(ROOT + "/" + rel)
    if raw == "":
        return Page(false, "", "", "")
    lines := strings.lines(raw)
    date := ""
    start := 0
    if len(lines) > 0 and strings.starts_with(lines[0], "date: "):
        date = strings.trim(substr(lines[0], 6, len(lines[0])))
        start = 1
    title := ""
    have_title := false
    body := ""
    first := true
    i := start
    for i < len(lines):
        ln := lines[i]
        if not have_title and strings.starts_with(ln, "# "):
            title = strings.trim(substr(ln, 2, len(ln)))
            have_title = true
        if not first:
            body = body + "\n"
        body = body + ln
        first = false
        i = i + 1
    return Page(true, title, date, markdown.render(body))

fn layout(title: string, body: string) -> string:
    t := title
    if t == "":
        t = "Tycho"
    return "<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\"><title>" + markdown.esc(t) + "</title><link rel=\"stylesheet\" href=\"/static/style.css\"><link rel=\"icon\" href=\"/favicon.ico\"></head>\n<body>\n<nav><a href=\"/\">Home</a> &middot; <a href=\"/blog\">Blog</a> &middot; <a href=\"/wiki/getting-started\">Wiki</a></nav>\n<main>\n" + body + "</main>\n<footer>Served by Tycho.</footer>\n</body></html>\n"

fn html(status: int, body: string) -> httpd.Response:
    return httpd.with_header(httpd.text_response(status, body), "Content-Type", "text/html; charset=utf-8")

fn not_found() -> httpd.Response:
    return html(404, layout("Not Found", "<h1>404 Not Found</h1>\n<p>No such page.</p>\n"))

fn page_response(pg: Page) -> httpd.Response:
    return html(200, layout(pg.title, pg.body_html))

# The blog index: list every content/blog/*.md, newest first (ISO dates sort
# lexically), as a Markdown list -- then render it (dogfooding markdown again).
fn blog_index() -> string:
    files := io.list(ROOT + "/blog")
    slugs := []string
    dates := []string
    titles := []string
    for f in files:
        if not strings.ends_with(f, ".md"):
            continue
        pg := load_page("blog/" + f)
        push(slugs, substr(f, 0, len(f) - 3))     # strip ".md"
        push(dates, pg.date)
        push(titles, pg.title)
    ord := sort.argsort_desc(dates)
    md := "# Blog\n\n"
    k := 0
    for k := 0; k < len(ord); k += 1:
        j := ord[k]
        md = md + "- " + dates[j] + " — [" + titles[j] + "](/blog/" + slugs[j] + ")\n"
    return markdown.render(md)

fn route(req: httpd.Request) -> httpd.Response:
    if req.method != "GET":
        return html(405, layout("Method Not Allowed", "<h1>405</h1>\n"))
    p := req.path
    if p == "/" or p == "/index.html":
        return page_response(load_page("home.md"))
    if p == "/blog" or p == "/blog/":
        return html(200, layout("Blog", blog_index()))
    if strings.starts_with(p, "/blog/"):
        slug := substr(p, 6, len(p))
        if not safe_slug(slug):
            return not_found()
        pg := load_page("blog/" + slug + ".md")
        if not pg.ok:
            return not_found()
        return page_response(pg)
    if strings.starts_with(p, "/wiki/"):
        page := substr(p, 6, len(p))
        if not safe_slug(page):
            return not_found()
        pg := load_page("wiki/" + page + ".md")
        if not pg.ok:
            return not_found()
        return page_response(pg)
    return not_found()

fn main():
    raw := args()
    serve := false
    i := 0
    for i := 0; i < len(raw); i += 1:
        if raw[i] == "--serve":
            serve = true

    if serve:
        port := 8080
        pe := getenv("PORT")
        if pe != "":
            port = strings.parse_int(pe)
        # core:net's TCP calls return Result(T, net.NetErr) and httpd.read_request
        # returns Result(Request, httpd.ReqErr). main() is void, so `or_return` is
        # unavailable here and core:result's combinators do the collapsing.
        lr := net.listen("127.0.0.1", port)
        if result.is_err(lr):
            eprint("webserver: cannot bind 127.0.0.1:" + str(port) + " (in use?)\n")
            return
        srv := result.unwrap_or(lr, -1)
        eprint("webserver: serving http://127.0.0.1:" + str(port) + "/\n")
        for true:
            ar := net.accept(srv)
            conn := result.unwrap_or(ar, -1)
            if conn < 0:
                continue
            # HTTP/1.1 keep-alive: serve requests off one socket until the peer
            # asks to close, hangs up, or goes idle for IDLE_MS -- the timeout is
            # what stops a slow-loris peer from pinning this loop forever.
            armed := net.set_read_timeout_ms(conn, IDLE_MS)
            alive := true
            for alive:
                # Err says which failure: httpd.Malformed deserves a 400, while
                # Closed and Timeout just end the connection.
                match httpd.read_request(conn):
                    Err(e):
                        if e == httpd.Malformed:
                            w := httpd.write_response(conn, httpd.text_response(400, "bad request\n"))
                        alive = false
                    Ok(req):
                        alive = not httpd.connection_close(req)
                        a := static_asset(req.path)
                        resp := httpd.text_response(200, "")
                        if a.ok:
                            resp = asset_response(a)
                        else:
                            resp = route(req)
                        wr := httpd.write_response(conn, httpd.with_connection(resp, alive))
                        if result.is_err(wr):
                            alive = false       # peer hung up mid-write
            net.close_fd(conn)
    else:
        # Deterministic self-test: dispatch a fixed route list through the same
        # handler and print status + body. Golden-locked (no socket needed).
        cr := httpd.crlf()
        paths := ["/", "/blog", "/blog/hello-tycho", "/wiki/getting-started", "/blog/../secret", "/blog/missing", "/nope"]
        j := 0
        for j := 0; j < len(paths); j += 1:
            req := result.unwrap_or(httpd.parse_request("GET " + paths[j] + " HTTP/1.1" + cr + cr), httpd.bad_request())
            resp := route(req)
            println("### GET " + paths[j] + " -> " + str(resp.status))
            print(to_str(resp.body))
            println("")
        # static assets are served as raw bytes (not through route); print their
        # metadata -- content type + byte length -- rather than dumping binary.
        spaths := ["/static/style.css", "/favicon.ico", "/static/missing.png", "/static/../secret"]
        k := 0
        for k := 0; k < len(spaths); k += 1:
            a := static_asset(spaths[k])
            if a.ok:
                println("### GET " + spaths[k] + " -> 200 " + a.ctype + " (" + str(len(a.body)) + " bytes)")
            else:
                println("### GET " + spaths[k] + " -> 404")
