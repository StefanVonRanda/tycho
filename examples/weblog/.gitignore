# run.sh builds into a `mktemp -d` (examples/weblog/run.sh:24), so nothing lands
# here from the gate. These catch the manual form: the README's
# `tychoc examples/weblog/main.ty -o weblog` run from inside this directory, and
# the mechanical `-o examples/weblog/main` (plus main.c with --emit-c).
# The demo log goes to an absolute /tmp path (examples/weblog/main.ty:143), not here.
# (expected.out is un-ignored in the root .gitignore; access.log IS tracked input.)
/main
/main.c
/weblog
/weblog.c
