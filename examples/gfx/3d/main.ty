package main

import "core:gfx"
import "core:gfx3d"
import "core:gfxgpu"
import "core:image"
import "core:io"
import "core:strings"
import "core:time"

# The SDL shim is already linked by core:gfx. libm supplies only the two trig
# functions the software camera needs; everything else is in Tycho.
extern "m" fn sin(x: float) -> float
extern "m" fn cos(x: float) -> float

extern fn gfx_open(w: int, h: int, title: string) -> gfx.Window
extern fn gfx_audio_open(rate: int, channels: int) -> gfx.Audio
extern fn gfx_texset_open(g: gfx.Window) -> gfx.TexSet
extern fn gfxgpu_open(w: gfx.Window) -> gfxgpu.Gpu
extern fn gfxgpu_frame_scene(g: gfxgpu.Gpu, verts: [float], mvp: [float],
                             overlay: bytes, w: int, h: int) -> int

const RW = 480
const RH = 270
const WIN_W = 960
const WIN_H = 540
const FOCAL = 300.0
const EYE = 1.55
const ARENA = 10.0
const TILE = 2.0
const WALL_H = 3.2
const MOVE_STEP = 0.075
const TURN_STEP = 0.045
const STEP_MS = 16

const MODE_MENU = 0
const MODE_PLAY = 1
const MODE_PAUSE = 2
const MODE_WIN = 3

struct Player:
    x: float
    z: float
    yaw: float

struct Pickup:
    x: float
    z: float
    taken: bool

fn shade(color: int, factor: float) -> int:
    r := (color / 65536) % 256
    gc := (color / 256) % 256
    b := color % 256
    rr := to_int(to_float(r) * factor)
    gg := to_int(to_float(gc) * factor)
    bb := to_int(to_float(b) * factor)
    if rr < 0:
        rr = 0
    if rr > 255:
        rr = 255
    if gg < 0:
        gg = 0
    if gg > 255:
        gg = 255
    if bb < 0:
        bb = 0
    if bb > 255:
        bb = 255
    return gfx.rgb(rr, gg, bb)

fn fog(color: int, dist: float) -> int:
    f := 1.0 - dist / 28.0
    if f < 0.28:
        f = 0.28
    if f > 1.0:
        f = 1.0
    return shade(color, f)

fn draw_floor(fb: inout [int], zbuf: inout [float], cam: gfx3d.Camera,
              target: gfx3d.Target):
    n := 10
    for iz := 0; iz < n; iz += 1:
        z0 := 0.0 - ARENA + to_float(iz) * TILE
        z1 := z0 + TILE
        for ix := 0; ix < n; ix += 1:
            x0 := 0.0 - ARENA + to_float(ix) * TILE
            x1 := x0 + TILE
            cx := x0 + TILE * 0.5
            cz := z0 + TILE * 0.5
            dx := cx - cam.eye.x
            dz := cz - cam.eye.z
            dist := sqrt(dx * dx + dz * dz)
            base := gfx.rgb(18, 43, 48)
            if (ix + iz) % 2 == 0:
                base = gfx.rgb(24, 55, 62)
            gfx3d.draw_quad(&fb, &zbuf, target, cam,
                            gfx3d.Vec3(x0, 0.0, z0), gfx3d.Vec3(x0, 0.0, z1),
                            gfx3d.Vec3(x1, 0.0, z1), gfx3d.Vec3(x1, 0.0, z0),
                            fog(base, dist))

fn draw_walls(fb: inout [int], zbuf: inout [float], cam: gfx3d.Camera,
              target: gfx3d.Target):
    n := 10
    for i := 0; i < n; i += 1:
        a := 0.0 - ARENA + to_float(i) * TILE
        b := a + TILE
        base := gfx.rgb(38, 68, 82)
        if i % 2 == 0:
            base = gfx.rgb(32, 59, 73)
        # z = -ARENA and z = +ARENA
        for side := 0; side < 2; side += 1:
            z := 0.0 - ARENA
            if side == 1:
                z = ARENA
            cx := a + TILE * 0.5
            dz := z - cam.eye.z
            dx := cx - cam.eye.x
            dist := sqrt(dx * dx + dz * dz)
            col := fog(base, dist)
            gfx3d.draw_quad(&fb, &zbuf, target, cam,
                            gfx3d.Vec3(a, 0.0, z), gfx3d.Vec3(b, 0.0, z),
                            gfx3d.Vec3(b, WALL_H, z), gfx3d.Vec3(a, WALL_H, z), col)
        # x = -ARENA and x = +ARENA
        for side := 0; side < 2; side += 1:
            x := 0.0 - ARENA
            if side == 1:
                x = ARENA
            cz := a + TILE * 0.5
            dx := x - cam.eye.x
            dz := cz - cam.eye.z
            dist := sqrt(dx * dx + dz * dz)
            col := fog(base, dist)
            gfx3d.draw_quad(&fb, &zbuf, target, cam,
                            gfx3d.Vec3(x, 0.0, a), gfx3d.Vec3(x, 0.0, b),
                            gfx3d.Vec3(x, WALL_H, b), gfx3d.Vec3(x, WALL_H, a), col)

fn draw_pillars(fb: inout [int], zbuf: inout [float], cam: gfx3d.Camera,
                target: gfx3d.Target):
    gfx3d.draw_box(&fb, &zbuf, target, cam, -4.0, 1.2, 2.0, 1.8, 2.4, 1.8, gfx.rgb(62, 88, 105))
    gfx3d.draw_box(&fb, &zbuf, target, cam, 4.0, 1.2, -2.0, 1.8, 2.4, 1.8, gfx.rgb(72, 78, 105))
    gfx3d.draw_box(&fb, &zbuf, target, cam, 3.0, 1.2, 4.5, 1.8, 2.4, 1.8, gfx.rgb(62, 100, 88))

fn draw_pickups(fb: inout [int], zbuf: inout [float], cam: gfx3d.Camera,
                target: gfx3d.Target, pickups: [Pickup], anim_ms: int):
    for i := 0; i < len(pickups); i += 1:
        if not pickups[i].taken:
            bob := sin(to_float(anim_ms) * 0.004 + to_float(i) * 0.8) * 0.12
            y := 1.1 + bob
            gfx3d.draw_box(&fb, &zbuf, target, cam, pickups[i].x, y, pickups[i].z,
                           0.46, 0.46, 0.46, gfx.rgb(255, 182, 38))
            gfx3d.draw_box(&fb, &zbuf, target, cam, pickups[i].x, y, pickups[i].z,
                           0.24, 0.24, 0.24, gfx.rgb(255, 242, 170))

fn draw_portal(fb: inout [int], zbuf: inout [float], cam: gfx3d.Camera,
               target: gfx3d.Target, active: bool, anim_ms: int):
    pulse := 0.62 + 0.38 * sin(to_float(anim_ms) * 0.006)
    col := gfx.rgb(48, 68, 82)
    if active:
        col = shade(gfx.rgb(70, 255, 155), pulse)
    # A frame, not a solid sheet: the player has to be able to see through the
    # exit while walking into it.
    gfx3d.draw_quad(&fb, &zbuf, target, cam,
                    gfx3d.Vec3(-1.15, 0.0, ARENA - 0.16),
                    gfx3d.Vec3(-0.85, 0.0, ARENA - 0.16),
                    gfx3d.Vec3(-0.85, 2.9, ARENA - 0.16),
                    gfx3d.Vec3(-1.15, 2.9, ARENA - 0.16), col)
    gfx3d.draw_quad(&fb, &zbuf, target, cam,
                    gfx3d.Vec3(0.85, 0.0, ARENA - 0.16),
                    gfx3d.Vec3(1.15, 0.0, ARENA - 0.16),
                    gfx3d.Vec3(1.15, 2.9, ARENA - 0.16),
                    gfx3d.Vec3(0.85, 2.9, ARENA - 0.16), col)
    gfx3d.draw_quad(&fb, &zbuf, target, cam,
                    gfx3d.Vec3(-1.15, 2.6, ARENA - 0.16),
                    gfx3d.Vec3(1.15, 2.6, ARENA - 0.16),
                    gfx3d.Vec3(1.15, 2.9, ARENA - 0.16),
                    gfx3d.Vec3(-1.15, 2.9, ARENA - 0.16), col)

fn crosshair(fb: inout [int]):
    cx := RW / 2
    cy := RH / 2
    col := gfx.rgb(180, 255, 205)
    for d := -2; d <= 2; d += 1:
        if d != 0:
            fb[cy * RW + cx + d] = col
            fb[(cy + d) * RW + cx] = col

fn draw_scene(fb: inout [int], zbuf: inout [float], cam: gfx3d.Camera,
              target: gfx3d.Target, pickups: [Pickup], collected: int, anim_ms: int):
    bg := gfx.rgb(7, 11, 19)
    gfx3d.clear(&fb, &zbuf, target, bg)
    draw_floor(&fb, &zbuf, cam, target)
    draw_walls(&fb, &zbuf, cam, target)
    draw_pillars(&fb, &zbuf, cam, target)
    draw_portal(&fb, &zbuf, cam, target, collected == len(pickups), anim_ms)
    draw_pickups(&fb, &zbuf, cam, target, pickups, anim_ms)
    crosshair(&fb)

fn blocked(x: float, z: float) -> bool:
    if x < 0.0 - ARENA + 0.7 or x > ARENA - 0.7:
        return true
    if z < 0.0 - ARENA + 0.7 or z > ARENA - 0.7:
        return true
    if fabs(x + 4.0) < 1.25 and fabs(z - 2.0) < 1.25:
        return true
    if fabs(x - 4.0) < 1.25 and fabs(z + 2.0) < 1.25:
        return true
    if fabs(x - 3.0) < 1.25 and fabs(z - 4.5) < 1.25:
        return true
    return false

fn move(p: inout Player, dx: float, dz: float):
    nx := p.x + dx
    if not blocked(nx, p.z):
        p.x = nx
    nz := p.z + dz
    if not blocked(p.x, nz):
        p.z = nz

fn fresh_pickups() -> [Pickup]:
    ps := []Pickup
    push(ps, Pickup(-6.2, -3.0, false))
    push(ps, Pickup(6.4, -3.4, false))
    push(ps, Pickup(-7.0, 3.0, false))
    push(ps, Pickup(7.0, 4.0, false))
    push(ps, Pickup(-2.0, 7.0, false))
    push(ps, Pickup(2.0, -6.5, false))
    push(ps, Pickup(5.5, 7.0, false))
    push(ps, Pickup(-5.5, 6.5, false))
    return ps

fn reset_game(p: inout Player, pickups: inout [Pickup],
              collected: inout int, play_ms: inout int):
    p = Player(0.0, -7.0, 0.35)
    pickups = fresh_pickups()
    collected = 0
    play_ms = 0

fn step_game(p: inout Player, pickups: inout [Pickup],
             fwd: bool, back: bool, left: bool, right: bool,
             turn_l: bool, turn_r: bool,
             play_ms: inout int) -> int:
    if turn_l:
        p.yaw = p.yaw - TURN_STEP
    if turn_r:
        p.yaw = p.yaw + TURN_STEP
    sy := sin(p.yaw)
    cy := cos(p.yaw)
    dx := 0.0
    dz := 0.0
    if fwd:
        dx = dx + sy * MOVE_STEP
        dz = dz + cy * MOVE_STEP
    if back:
        dx = dx - sy * MOVE_STEP
        dz = dz - cy * MOVE_STEP
    if left:
        dx = dx - cy * MOVE_STEP
        dz = dz + sy * MOVE_STEP
    if right:
        dx = dx + cy * MOVE_STEP
        dz = dz - sy * MOVE_STEP
    if dx != 0.0 or dz != 0.0:
        move(&p, dx, dz)

    picked := 0
    for i := 0; i < len(pickups); i += 1:
        if not pickups[i].taken:
            ddx := p.x - pickups[i].x
            ddz := p.z - pickups[i].z
            if ddx * ddx + ddz * ddz < 0.49:
                q := pickups[i]
                q.taken = true
                pickups[i] = q
                picked = picked + 1
    play_ms = play_ms + STEP_MS
    return picked

fn gpu_build_static() -> gfx3d.Mesh:
    m := gfx3d.mesh()
    n := 10
    for iz := 0; iz < n; iz += 1:
        z0 := 0.0 - ARENA + to_float(iz) * TILE
        z1 := z0 + TILE
        for ix := 0; ix < n; ix += 1:
            x0 := 0.0 - ARENA + to_float(ix) * TILE
            x1 := x0 + TILE
            col := gfx.rgb(18, 43, 48)
            if (ix + iz) % 2 == 0:
                col = gfx.rgb(24, 55, 62)
            gfx3d.add_quad(&m, gfx3d.Vec3(x0, 0.0, z0), gfx3d.Vec3(x0, 0.0, z1),
                           gfx3d.Vec3(x1, 0.0, z1), gfx3d.Vec3(x1, 0.0, z0), col)
    for i := 0; i < n; i += 1:
        a := 0.0 - ARENA + to_float(i) * TILE
        b := a + TILE
        col := gfx.rgb(38, 68, 82)
        if i % 2 == 0:
            col = gfx.rgb(32, 59, 73)
        gfx3d.add_quad(&m, gfx3d.Vec3(a, 0.0, 0.0 - ARENA),
                       gfx3d.Vec3(b, 0.0, 0.0 - ARENA),
                       gfx3d.Vec3(b, WALL_H, 0.0 - ARENA),
                       gfx3d.Vec3(a, WALL_H, 0.0 - ARENA), col)
        gfx3d.add_quad(&m, gfx3d.Vec3(a, 0.0, ARENA),
                       gfx3d.Vec3(b, 0.0, ARENA),
                       gfx3d.Vec3(b, WALL_H, ARENA),
                       gfx3d.Vec3(a, WALL_H, ARENA), col)
        gfx3d.add_quad(&m, gfx3d.Vec3(0.0 - ARENA, 0.0, a),
                       gfx3d.Vec3(0.0 - ARENA, 0.0, b),
                       gfx3d.Vec3(0.0 - ARENA, WALL_H, b),
                       gfx3d.Vec3(0.0 - ARENA, WALL_H, a), col)
        gfx3d.add_quad(&m, gfx3d.Vec3(ARENA, 0.0, a),
                       gfx3d.Vec3(ARENA, 0.0, b),
                       gfx3d.Vec3(ARENA, WALL_H, b),
                       gfx3d.Vec3(ARENA, WALL_H, a), col)
    gfx3d.add_box(&m, -4.0, 1.2, 2.0, 1.8, 2.4, 1.8, gfx.rgb(62, 88, 105))
    gfx3d.add_box(&m, 4.0, 1.2, -2.0, 1.8, 2.4, 1.8, gfx.rgb(72, 78, 105))
    gfx3d.add_box(&m, 3.0, 1.2, 4.5, 1.8, 2.4, 1.8, gfx.rgb(62, 100, 88))
    return m

fn gpu_build_dynamic(pickups: [Pickup], collected: int, anim_ms: int) -> gfx3d.Mesh:
    m := gfx3d.mesh()
    for i := 0; i < len(pickups); i += 1:
        if not pickups[i].taken:
            bob := sin(to_float(anim_ms) * 0.004 + to_float(i) * 0.8) * 0.12
            gfx3d.add_box(&m, pickups[i].x, 1.1 + bob, pickups[i].z,
                          0.46, 0.46, 0.46, gfx.rgb(255, 182, 38))
            gfx3d.add_box(&m, pickups[i].x, 1.1 + bob, pickups[i].z,
                          0.24, 0.24, 0.24, gfx.rgb(255, 242, 170))
    pulse := 0.62 + 0.38 * sin(to_float(anim_ms) * 0.006)
    col := gfx.rgb(48, 68, 82)
    if collected == len(pickups):
        col = shade(gfx.rgb(70, 255, 155), pulse)
    gfx3d.add_quad(&m, gfx3d.Vec3(-1.15, 0.0, ARENA - 0.16),
                   gfx3d.Vec3(-0.85, 0.0, ARENA - 0.16),
                   gfx3d.Vec3(-0.85, 2.9, ARENA - 0.16),
                   gfx3d.Vec3(-1.15, 2.9, ARENA - 0.16), col)
    gfx3d.add_quad(&m, gfx3d.Vec3(0.85, 0.0, ARENA - 0.16),
                   gfx3d.Vec3(1.15, 0.0, ARENA - 0.16),
                   gfx3d.Vec3(1.15, 2.9, ARENA - 0.16),
                   gfx3d.Vec3(0.85, 2.9, ARENA - 0.16), col)
    gfx3d.add_quad(&m, gfx3d.Vec3(-1.15, 2.6, ARENA - 0.16),
                   gfx3d.Vec3(1.15, 2.6, ARENA - 0.16),
                   gfx3d.Vec3(1.15, 2.9, ARENA - 0.16),
                   gfx3d.Vec3(-1.15, 2.9, ARENA - 0.16), col)
    return m

fn gpu_push_vertex(verts: inout [float], p: gfx3d.Vec3, color: int):
    push(verts, p.x)
    push(verts, p.y)
    push(verts, p.z)
    push(verts, to_float((color / 65536) % 256) / 255.0)
    push(verts, to_float((color / 256) % 256) / 255.0)
    push(verts, to_float(color % 256) / 255.0)

fn gpu_append_mesh(verts: inout [float], m: gfx3d.Mesh):
    for i := 0; i < len(m.tris); i += 1:
        t := m.tris[i]
        gpu_push_vertex(&verts, t.a, t.color)
        gpu_push_vertex(&verts, t.b, t.color)
        gpu_push_vertex(&verts, t.c, t.color)

fn gpu_vertices(static_mesh: gfx3d.Mesh, pickups: [Pickup], collected: int,
                anim_ms: int) -> [float]:
    verts := []float
    gpu_append_mesh(&verts, static_mesh)
    dynamic := gpu_build_dynamic(pickups, collected, anim_ms)
    gpu_append_mesh(&verts, dynamic)
    return verts

fn gpu_build_mvp(cam: gfx3d.Camera, target: gfx3d.Target) -> [float]:
    near := 0.1
    far := 100.0
    sw := 2.0 * cam.focal / to_float(target.w)
    sh := 2.0 * cam.focal / to_float(target.h)
    er := cam.eye.x * cam.right.x + cam.eye.y * cam.right.y + cam.eye.z * cam.right.z
    eu := cam.eye.x * cam.up.x + cam.eye.y * cam.up.y + cam.eye.z * cam.up.z
    ef := cam.eye.x * cam.forward.x + cam.eye.y * cam.forward.y + cam.eye.z * cam.forward.z
    pf := far / (far - near)
    m := []float
    r0x := sw * cam.right.x
    r0y := sw * cam.right.y
    r0z := sw * cam.right.z
    r0w := 0.0 - sw * er
    r1x := sh * cam.up.x
    r1y := sh * cam.up.y
    r1z := sh * cam.up.z
    r1w := 0.0 - sh * eu
    r2x := pf * cam.forward.x
    r2y := pf * cam.forward.y
    r2z := pf * cam.forward.z
    r2w := 0.0 - pf * ef - far * near / (far - near)
    r3x := cam.forward.x
    r3y := cam.forward.y
    r3z := cam.forward.z
    r3w := 0.0 - ef
    push(m, r0x)
    push(m, r1x)
    push(m, r2x)
    push(m, r3x)
    push(m, r0y)
    push(m, r1y)
    push(m, r2y)
    push(m, r3y)
    push(m, r0z)
    push(m, r1z)
    push(m, r2z)
    push(m, r3z)
    push(m, r0w)
    push(m, r1w)
    push(m, r2w)
    push(m, r3w)
    return m

fn ov_rect(ov: inout [int], w: int, x0: int, y0: int, x1: int, y1: int, color: int):
    for y := y0; y < y1; y += 1:
        base := y * w
        for x := x0; x < x1; x += 1:
            ov[base + x] = color

fn ov_text(font: image.Image, ov: inout [int], w: int, x: int, y: int,
           text: string, size: int, r: int, gc: int, b: int):
    if font.width <= 0 or size <= 0:
        return
    advance := size * 3 / 4
    for i := 0; i < len(text); i += 1:
        idx := text[i] - 32
        if idx >= 0 and idx < 96:
            col := idx % 16
            row := idx / 16
            for dy := 0; dy < size; dy += 1:
                sy := row * 32 + dy * 32 / size
                dsty := y + dy
                if dsty >= 0 and dsty < 270:
                    for dx := 0; dx < size; dx += 1:
                        sx0 := col * 32 + dx * 32 / size
                        sx1 := col * 32 + (dx + 1) * 32 / size
                        if sx1 <= sx0:
                            sx1 = sx0 + 1
                        dstx := x + i * advance + dx
                        if dstx >= 0 and dstx < w:
                            a := 0
                            for xx := sx0; xx < sx1; xx += 1:
                                if xx < font.width:
                                    aa := font.pixels[(sy * font.width + xx) * 4 + 3]
                                    if aa > a:
                                        a = aa
                            if a > 100:
                                ov[dsty * w + dstx] = 4278190080 + r * 65536 + gc * 256 + b

fn ov_text_centered(font: image.Image, ov: inout [int], w: int, center_x: int,
                    y: int, text: string, size: int, r: int, gc: int, b: int):
    x := center_x - len(text) * (size * 3 / 4) / 2
    ov_text(font, &ov, w, x, y, text, size, r, gc, b)

fn ov_bytes(ov: [int]) -> bytes:
    out := []int
    reserve(out, len(ov) * 4)
    for i := 0; i < len(ov); i += 1:
        c := ov[i]
        push(out, (c / 65536) % 256)
        push(out, (c / 256) % 256)
        push(out, c % 256)
        push(out, (c / 16777216) % 256)
    return to_bytes(out)

fn build_overlay(font: image.Image, mode: int, collected: int, play_ms: int,
                 total: int) -> bytes:
    ov := []int
    reserve(ov, RW * RH)
    for i := 0; i < RW * RH; i += 1:
        push(ov, 0)
    if mode == MODE_MENU:
        ov_rect(&ov, RW, 55, 34, RW - 55, RH - 44, gfx.rgb(5, 9, 16))
        ov_text_centered(font, &ov, RW, RW / 2, 44, "VECTOR VAULT", 38, 100, 245, 160)
        ov_text_centered(font, &ov, RW, RW / 2, 96, "COLLECT 8 CELLS, THEN FIND THE EXIT", 11, 190, 220, 225)
        ov_text_centered(font, &ov, RW, RW / 2, 122, "SPACE TO START", 20, 255, 210, 80)
        ov_text_centered(font, &ov, RW, RW / 2, 158, "WASD MOVE   Z/C TURN   MOUSE LOOK", 10, 150, 180, 190)
        ov_text_centered(font, &ov, RW, RW / 2, 178, "P PAUSE   R RESTART   ESC QUIT", 10, 150, 180, 190)
    elif mode == MODE_PLAY or mode == MODE_PAUSE:
        cells := "CELLS " + str(collected) + "/" + str(total)
        timer := "TIME " + str(play_ms / 1000) + "S"
        ov_text(font, &ov, RW, 8, 6, cells, 12, 170, 245, 190)
        ov_text(font, &ov, RW, RW - 8 - len(timer) * 9, 6, timer, 12, 170, 245, 190)
        if mode == MODE_PAUSE:
            ov_rect(&ov, RW, 82, 92, RW - 82, 192, gfx.rgb(5, 9, 16))
            ov_text_centered(font, &ov, RW, RW / 2, 112, "PAUSED", 30, 255, 210, 80)
            ov_text_centered(font, &ov, RW, RW / 2, 154, "SPACE RESUME   R RESTART   ESC QUIT", 10, 170, 200, 210)
    elif mode == MODE_WIN:
        ov_rect(&ov, RW, 82, 78, RW - 82, 208, gfx.rgb(5, 9, 16))
        ov_text_centered(font, &ov, RW, RW / 2, 94, "VAULT CLEARED", 30, 100, 245, 160)
        ov_text_centered(font, &ov, RW, RW / 2, 136, "TIME " + str(play_ms / 1000) + "S", 18, 255, 210, 80)
        ov_text_centered(font, &ov, RW, RW / 2, 172, "SPACE OR R TO RUN AGAIN", 10, 170, 200, 210)
    return ov_bytes(ov)

fn main():
    a := args()
    frames := 0
    snap := ""
    headless := false
    for i := 1; i < len(a); i += 1:
        if a[i] == "--headless":
            headless = true
        if a[i] == "--frames" and i + 1 < len(a):
            match strings.parse_int(a[i + 1]):
                Ok(v): frames = v
                Err(e): pass
        if a[i] == "--snapshot" and i + 1 < len(a):
            snap = a[i + 1]
    if headless and frames == 0:
        frames = 240

    win := gfx_open(WIN_W, WIN_H, "Tycho Vector Vault")
    if is_null(win):
        eprintln("3d: could not open a window (SDL3 required)")
        return
    win_w := gfx.window_width(win)
    win_h := gfx.window_height(win)

    texset := gfx_texset_open(win)
    font_id := 0 - 1
    if not is_null(texset):
        font_id = gfx.load_texture(texset, "assets/font.png")
    font_img := image.Image(0, 0, to_bytes([]int))
    match io.read_bytes("assets/font.png"):
        Ok(data):
            match image.decode(data):
                Ok(img): font_img = img
                Err(e): pass
        Err(e): pass

    audio := gfx_audio_open(22050, 1)
    pickup_beep := gfx.make_beep(22050, 880, 65)
    win_beep := gfx.make_beep(22050, 1320, 220)

    fb := []int
    zbuf := []float
    reserve(fb, RW * RH)
    reserve(zbuf, RW * RH)
    for i := 0; i < RW * RH; i += 1:
        push(fb, 0)
        push(zbuf, 0.0)

    player := Player(0.0, -7.0, 0.35)
    pickups := fresh_pickups()
    collected := 0
    play_ms := 0
    mode := MODE_MENU
    if headless:
        mode = MODE_PLAY
    fwd := false
    back := false
    left := false
    right := false
    turn_l := false
    turn_r := false
    last_mouse_x := to_i32(0 - 1)
    clock := gfx.clock_start()
    play_frame := 0
    target := gfx3d.Target(RW, RH)
    gpu := gfxgpu_open(win)
    static_mesh := gfx3d.mesh()
    if not is_null(gpu):
        static_mesh = gpu_build_static()
    gfx.set_title(win, "Tycho Vector Vault")

    for frame := 0; frames == 0 or frame < frames; frame += 1:
        ev := gfx.poll_event(win)
        quit := false
        for ev.kind != 0:
            if ev.kind == 1:
                quit = true
            if ev.kind == 5:
                win_w = gfx.window_width(win)
                win_h = gfx.window_height(win)
            if ev.kind == 3 and mode == MODE_PLAY:
                if last_mouse_x >= to_i32(0):
                    player.yaw = player.yaw + (to_float(ev.x) - to_float(last_mouse_x)) * 0.004
                last_mouse_x = ev.x
            if ev.kind == 2 or ev.kind == 6:
                down := ev.kind == 2
                k := ev.key
                if down:
                    if k == 27:
                        quit = true
                    if k == 32:
                        if mode == MODE_MENU or mode == MODE_WIN:
                            reset_game(&player, &pickups, &collected, &play_ms)
                            mode = MODE_PLAY
                            clock = gfx.clock_start()
                            play_frame = 0
                            last_mouse_x = to_i32(0 - 1)
                            gfx.set_title(win, "Tycho Vector Vault")
                        elif mode == MODE_PAUSE:
                            mode = MODE_PLAY
                            clock = gfx.clock_start()
                    if k == 114:
                        reset_game(&player, &pickups, &collected, &play_ms)
                        mode = MODE_PLAY
                        clock = gfx.clock_start()
                        play_frame = 0
                        last_mouse_x = to_i32(0 - 1)
                        gfx.set_title(win, "Tycho Vector Vault")
                    if k == 112:
                        if mode == MODE_PLAY:
                            mode = MODE_PAUSE
                        elif mode == MODE_PAUSE:
                            mode = MODE_PLAY
                            clock = gfx.clock_start()
                if k == 1:
                    fwd = down
                if k == 3:
                    back = down
                if k == 4:
                    left = down
                if k == 2:
                    right = down
                if k == 122:
                    turn_l = down
                if k == 99:
                    turn_r = down
            ev = gfx.poll_event(win)
        if quit:
            break

        if mode == MODE_PLAY:
            steps := 0
            if headless:
                steps = gfx.clock_advance(&clock, play_frame * STEP_MS, STEP_MS)
            else:
                steps = gfx.clock_tick(&clock, STEP_MS)
            for s := 0; s < steps; s += 1:
                picked := step_game(&player, &pickups, fwd, back, left, right,
                                    turn_l, turn_r, &play_ms)
                if picked > 0:
                    collected = collected + picked
                    gfx.play_beep(audio, pickup_beep)
                    gfx.set_title(win, "Tycho Vector Vault - cells " + str(collected))
                if collected == len(pickups):
                    ddx := player.x - 0.0
                    ddz := player.z - (ARENA - 0.25)
                    if ddx * ddx + ddz * ddz < 1.44:
                        mode = MODE_WIN
                        gfx.play_beep(audio, win_beep)
                        gfx.set_title(win, "Tycho Vector Vault - cleared")
                        break
            play_frame = play_frame + 1

        eye := gfx3d.Vec3(player.x, EYE, player.z)
        look := gfx3d.Vec3(player.x + sin(player.yaw), EYE,
                           player.z + cos(player.yaw))
        cam := gfx3d.look_at(eye, look, gfx3d.Vec3(0.0, 1.0, 0.0), FOCAL)
        gpu_ok := false
        if not is_null(gpu):
            verts := gpu_vertices(static_mesh, pickups, collected, play_frame * STEP_MS)
            mvp := gpu_build_mvp(cam, target)
            overlay := build_overlay(font_img, mode, collected, play_ms, len(pickups))
            if gfxgpu_frame_scene(gpu, verts, mvp, overlay, RW, RH) == 0:
                gpu_ok = true

        if not gpu_ok:
            draw_scene(&fb, &zbuf, cam, target, pickups, collected, play_frame * STEP_MS)
            if mode == MODE_MENU:
                gfx.fill_rect(&fb, RW, 55, 34, RW - 55, RH - 44, gfx.rgb(5, 9, 16))
            if mode == MODE_PAUSE:
                gfx.fill_rect(&fb, RW, 82, 92, RW - 82, 192, gfx.rgb(5, 9, 16))
            if mode == MODE_WIN:
                gfx.fill_rect(&fb, RW, 82, 78, RW - 82, 208, gfx.rgb(5, 9, 16))

            view := gfx.fit_view(RW, RH, win_w, win_h)
            dst := gfx.view_rect(view, 0, 0, RW, RH)
            rc := gfx.begin(win)
            if rc == 0:
                rc = gfx.draw_fb(win, fb, RW, RH, dst)
            if rc == 0 and font_id >= 0:
                if mode == MODE_MENU:
                    gfx.draw_text_centered_view(view, texset, font_id, RW / 2, 44,
                                                "VECTOR VAULT", 40, 100, 245, 160)
                    gfx.draw_text_centered_view(view, texset, font_id, RW / 2, 96,
                                                "COLLECT 8 CELLS, THEN FIND THE EXIT", 12, 190, 220, 225)
                    gfx.draw_text_centered_view(view, texset, font_id, RW / 2, 122,
                                                "SPACE TO START", 20, 255, 210, 80)
                    gfx.draw_text_centered_view(view, texset, font_id, RW / 2, 158,
                                                "WASD MOVE   Z/C TURN   MOUSE LOOK", 11, 150, 180, 190)
                    gfx.draw_text_centered_view(view, texset, font_id, RW / 2, 178,
                                                "P PAUSE   R RESTART   ESC QUIT", 11, 150, 180, 190)
                elif mode == MODE_PLAY or mode == MODE_PAUSE:
                    cells := "CELLS " + str(collected) + "/" + str(len(pickups))
                    timer := "TIME " + str(play_ms / 1000) + "S"
                    gfx.draw_text_view(view, texset, font_id, 8, 6, cells, 12, 170, 245, 190)
                    tw := gfx.text_width(timer, 12)
                    gfx.draw_text_view(view, texset, font_id, RW - 8 - tw, 6, timer, 12, 170, 245, 190)
                    if mode == MODE_PAUSE:
                        gfx.draw_text_centered_view(view, texset, font_id, RW / 2, 112,
                                                    "PAUSED", 30, 255, 210, 80)
                        gfx.draw_text_centered_view(view, texset, font_id, RW / 2, 154,
                                                    "SPACE RESUME   R RESTART   ESC QUIT", 10, 170, 200, 210)
                elif mode == MODE_WIN:
                    gfx.draw_text_centered_view(view, texset, font_id, RW / 2, 94,
                                                "VAULT CLEARED", 30, 100, 245, 160)
                    gfx.draw_text_centered_view(view, texset, font_id, RW / 2, 136,
                                                "TIME " + str(play_ms / 1000) + "S", 18, 255, 210, 80)
                    gfx.draw_text_centered_view(view, texset, font_id, RW / 2, 172,
                                                "SPACE OR R TO RUN AGAIN", 10, 170, 200, 210)
            if rc == 0:
                rc = gfx.present(win)
            if rc != 0:
                eprintln("3d: frame failed: " + str(rc))
                break
        if not headless:
            time.sleep_ms(16)

    if snap != "":
        gfx.save_bmp(snap, fb, RW, RH)
    close(gpu)
    close(texset)
    close(audio)
    close(win)
