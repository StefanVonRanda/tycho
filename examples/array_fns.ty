# Arrays across function boundaries: pass down (borrow) and return up
# (promote). All value-semantic, no pointers, no visible arenas.

fn make_squares(n: int) -> [int]:
    r := []int
    for i := 0; i < n; i += 1:
        push(r, i * i)
    return r                       # promoted into the caller's arena

fn sum(a: [int]) -> int:
    total := 0
    for i := 0; i < len(a); i += 1:        # 'a' is a read-only borrow
        total = total + a[i]
    return total

fn doubled(a: [int]) -> [int]:
    b := a                         # value semantics: independent copy
    for i := 0; i < len(b); i += 1:
        b[i] = b[i] * 2            # mutating the copy, not the caller's array
    return b

fn main():
    sq := make_squares(5)
    print("squares: ")
    for i := 0; i < len(sq); i += 1:
        print(str(sq[i]) + " ")
    println("")

    println("sum = " + str(sum(sq)))

    d := doubled(sq)
    println("doubled[2] = " + str(d[2]) + ", original[2] = " + str(sq[2]))
