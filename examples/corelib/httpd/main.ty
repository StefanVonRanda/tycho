# Example: core:httpd -- parse an HTTP request, build a response, and serve one
# request over the loopback interface (single thread, ephemeral port, so the run
# is self-contained and deterministic). You own the accept loop.
package main
import "core:net"
import "core:httpd"
import "core:result"

fn crlf() -> string:                    # tycho strings have no \r escape
    return chr(13) + chr(10)

# The socket half of the demo. It returns Result(_, net.NetErr) -- the same error
# type every core:net TCP call and httpd.write_response return -- so `or_return`
# handles every failure and the body has no sentinel checks at all.
fn round_trip(nl: string) -> Result(int, net.NetErr):
    srv := net.listen("127.0.0.1", 0) or_return          # port 0 -> kernel picks one
    port := net.port_of(srv) or_return
    conn_out := net.connect("127.0.0.1", port) or_return
    conn_in := net.accept(srv) or_return

    asked := net.write(conn_out, to_bytes("GET / HTTP/1.1" + nl + nl)) or_return
    # read_request returns Result(Request, httpd.ReqErr) -- a DIFFERENT error type
    # from this function's Result(_, net.NetErr), so `or_return` cannot carry it.
    # core:result collapses it in one line.
    served := result.unwrap_or(httpd.read_request(conn_in), httpd.bad_request())
    println("served = " + served.method + " " + served.path)   # GET /
    println("alive  = " + str(not httpd.connection_close(served)))   # true: HTTP/1.1
    answered := httpd.write_response(conn_in, httpd.text_response(200, "pong")) or_return
    net.close_fd(conn_in)

    reply := to_str(net.read(conn_out, 512) or_return)
    body := reply[find(reply, nl + nl) + 4:len(reply)]
    println("reply  = " + body)                          # pong

    net.close_fd(conn_out)
    net.close_fd(srv)
    return Ok(asked + answered)

fn main():
    nl := crlf()

    # --- parse a request (no socket needed) ---
    raw := "GET /hello?name=ada HTTP/1.1" + nl + "Host: localhost" + nl + "Accept: text/plain" + nl + nl
    # parse_request returns Result(Request, httpd.ReqErr): garbage in is
    # Err(httpd.Malformed), not a Request with an empty method.
    match httpd.parse_request(raw):
        Err(e): eprint("httpd example: that was not a request\n")
        Ok(req):
            println("method = " + req.method)                 # GET
            println("path   = " + req.path)                   # /hello?name=ada
            println("host   = " + httpd.header(req, "host"))  # localhost  (case-insensitive)

    # ... and a malformed head is now distinguishable from a hangup or a timeout,
    # which is what a server needs to answer 400 to one and stay silent on the
    # others. `Err(httpd.Malformed)` cannot be a match arm (Tycho has no nested
    # patterns), so the test is err_or plus `==`.
    junk := httpd.parse_request("GARBAGE" + nl + nl)
    println("garbage= " + str(result.err_or(junk, httpd.Failed) == httpd.Malformed))   # true

    # --- build + render a response (Content-Length + default Content-Type added) ---
    # Bodies are `bytes` (binary-safe); text_response is the string convenience.
    resp := httpd.with_header(httpd.text_response(200, "hi\n"), "X-Demo", "1")
    wire := to_str(httpd.render(resp))
    println("status ok = " + str(find(wire, "HTTP/1.1 200 OK") == 0))   # true

    # --- content type comes from the extension; unknown is never text/plain ---
    println("ctype  = " + httpd.content_type("/img/logo.png"))          # image/png
    println("ctype? = " + httpd.content_type("/data.bin"))              # application/octet-stream

    # --- a real one-request round trip to ourselves over 127.0.0.1 ---
    match round_trip(nl):
        Ok(n): println("wire   = " + str(n) + " bytes")
        Err(e): eprint("httpd example: the loopback round trip failed\n")
