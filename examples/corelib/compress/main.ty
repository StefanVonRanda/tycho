# Example: core:compress -- zlib (de)compression of byte buffers.
package main
import "core:compress"

fn main():
    text := ""
    i := 0
    for i < 40:
        text = text + "value semantics, implicit arenas, no GC. "
        i = i + 1
    raw := to_bytes(text)
    packed := compress.compress(raw)
    # decompress returns Result(bytes, ZErr): Ok("") is a real empty payload,
    # Err says corrupt or truncated. This example knows its own input is good.
    back := to_bytes([]int)
    match compress.decompress(packed):
        Ok(d): back = d
        _: println("decompress failed")
    println("original     = " + str(len(raw)) + " bytes")
    println("smaller      = " + str(len(packed) < len(raw)))
    println("roundtrip ok = " + str(to_str(back) == text))
