# Example: core:decimal -- exact base-10 fixed-point (no binary-float rounding).
package main
import "core:decimal"

# div is the one operation with a policy in it: an exact quotient may not exist,
# so the caller states the scale AND the rounding mode. All three ways that can
# go wrong are Errs rather than aborts, and each names what the caller got wrong
# -- so `show` matches the three variants of DivErr separately.
fn show(r: Result(decimal.Decimal, decimal.DivErr)) -> string:
    match r:
        Ok(d): return decimal.to_str(d)
        Err(decimal.DivByZero): return "refused (divide by zero)"
        Err(decimal.BadScale(s)): return "refused (bad scale " + str(s) + ")"
        Err(decimal.BadMode(m)): return "refused (bad mode " + str(m) + ")"

fn main():
    a := decimal.from_str("0.1")
    b := decimal.from_str("0.2")
    println("0.1 + 0.2 = " + decimal.to_str(decimal.add(a, b)))

    price := decimal.from_str("19.99")
    subtotal := decimal.mul(price, decimal.from_int(3))
    println("19.99 x 3 = " + decimal.to_str(subtotal))

    paid := decimal.from_str("100.00")
    println("change    = " + decimal.to_str(decimal.sub(paid, subtotal)))

    eight := decimal.from_int(8)
    println("59.97/8 up= " + show(decimal.div(subtotal, eight, 2, decimal.half_up())))
    println("59.97/8 tz= " + show(decimal.div(subtotal, eight, 2, decimal.toward_zero())))
    println("59.97/0   = " + show(decimal.div(subtotal, decimal.from_int(0), 2, decimal.half_up())))
    println("scale -1  = " + show(decimal.div(subtotal, eight, -1, decimal.half_up())))
    println("mode 7    = " + show(decimal.div(subtotal, eight, 2, 7)))
