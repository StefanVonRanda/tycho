
fn build(n: int) -> [int]:
    r := []int
    for i := 0; i < n; i += 1:
        push(r, i)
    return r

fn total(xs: [int]) -> int:
    t := 0
    for i := 0; i < len(xs); i += 1:
        t = t + xs[i]
    return t

fn main():
    big := build(8000000)     # ~64 MB of longs (plus geometric-growth slack)
    t := (big, 0)             # big is dead -> MOVED into the tuple, no 2nd buffer
    println(str(total(t.0)))
