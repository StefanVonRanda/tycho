
fn word(n: int) -> string:
    s := ""
    m := n
    for d := 0; d < 3; d += 1:                 # 3 letters -> 17576 distinct, covers VOCAB
        s = s + chr(97 + m % 26)
        m = m / 26
    return s

fn main():
    a := args()                        # a[0] is the program name
    if len(a) < 2:
        println("usage: gencorpus <out-dir>")
        return
    dir := a[1]

    n_files := 400
    words_per_file := 4000
    vocab := 5000

    state := 2463534242             # fixed LCG seed
    f := 0
    for f := 0; f < n_files; f += 1:
        body := ""
        w := 0
        for w := 0; w < words_per_file; w += 1:
            state = (state * 1103515245 + 12345) % 2147483648
            idx := state % vocab
            body = body + word(idx)
            if w % 12 == 11:
                body = body + "\n"
            else:
                body = body + " "
        path := dir + "/doc" + str(f) + ".txt"
        if not write_file(path, body):
            println("write failed: " + path)
            return
    println("wrote " + str(n_files) + " files to " + dir)
