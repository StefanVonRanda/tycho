# Expert variant: a record with a separately stored function value, against C's
# raw function pointer. `f` is a Tycho fn value, whose descriptor carries the
# call pointer plus two inline capture slots (24 bytes), so S_Clo is 40 bytes
# and C's Clo is 24. That layout difference is the measured gap: an 8-byte
# descriptor prototype matches C (~63e6 vs ~67e6 cycles at 8000x2000), while a
# capturing fn value cannot be 8 bytes. This is the explicit expert alternate;
# the idiomatic `dispatch` row is the comparable closure claim.
struct Clo:
    i: int
    p: int
    f: fn(int, int, int) -> int
fn body(i: int, p: int, x: int) -> int:
    return x * (i + 1) + p
fn main():
    n := 2000
    k := 2000
    total := 0
    for p := 0; p < k; p += 1:
        fs := []Clo
        for i := 0; i < n; i += 1:
            push(fs, Clo(i, p, body))
        for i := 0; i < n; i += 1:
            total = (total + fs[i].f(fs[i].i, fs[i].p, 7)) & 1048575
    println(str(total))
