# string-pipeline benchmark, Tycho — string-heavy. Build M strings, each K
# digit-chars, by concatenation; hash each (sum of byte codes); checksum.
# Tycho's `s = s + c` compiles to an in-place append (the accumulator opt), so
# the obvious value-semantic code is O(n) per string, no Builder needed.
# `'0' + d` is a char (one byte), so the append never allocates a one-char
# string — the same byte-append the C/Rust/Go versions do (a fair comparison).
fn main():
    m := 4000
    kk := 256
    p := 1000003
    checksum := 0
    for j := 0; j < m; j += 1:
        s := ""
        for i := 0; i < kk; i += 1:
            d := (i + j) - ((i + j) / 10) * 10
            s = s + ('0' + d)
        h := 0
        for i := 0; i < len(s); i += 1:
            h = h + s[i]
        ck := checksum + h
        checksum = ck - (ck / p) * p
    println(str(checksum))
