fn step(a: [int], p: int) -> [int]:
    b := []int
    for i := 0; i < len(a); i += 1:
        t := a[i] * 1103515245 + 12345
        push(b, t - (t / p) * p)
    return b
fn main():
    n := 100000
    m := 2000
    p := 2147483647
    a := []int
    for i := 0; i < n; i += 1:
        push(a, i)
    for j := 0; j < m; j += 1:
        a = step(a, p)
    s := 0
    for i := 0; i < len(a); i += 1:
        s = s + a[i]
    println(str(s - (s / 1000003) * 1000003))
