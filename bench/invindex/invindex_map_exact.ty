fn main():
    n := 300000          # documents
    w := 12              # words per document
    v := 8000            # vocabulary size

    # pass 1: count postings per term (in-place map compound)
    cnt := []string: int
    seed := 1
    d := 0
    for d := 0; d < n; d += 1:
        j := 0
        for j := 0; j < w; j += 1:
            seed = (seed * 1103515245 + 12345) % 2147483647
            tid := seed % v
            cnt["t" + str(tid)] += 1

    # size each posting list exactly once (reserve reaches into the map value)
    idx := []string: [int]
    ck := keys(cnt)
    ci := 0
    for ci := 0; ci < len(ck); ci += 1:
        reserve(idx[ck[ci]], cnt.get(ck[ci], 0))

    # pass 2: replay the LCG, push each posting into its pre-sized list (no regrow)
    seed = 1
    d = 0
    for d := 0; d < n; d += 1:
        j := 0
        for j := 0; j < w; j += 1:
            seed = (seed * 1103515245 + 12345) % 2147483647
            tid := seed % v
            push(idx["t" + str(tid)], d)

    ks := keys(idx)
    sum := 0
    ki := 0
    for ki := 0; ki < len(ks); ki += 1:
        dl := idx.get(ks[ki], []int)
        sum += len(ks[ki]) + len(dl)
        di := 0
        for di := 0; di < len(dl); di += 1:
            sum += dl[di]
    println("vocab=" + str(len(ks)) + " checksum=" + str(sum))
