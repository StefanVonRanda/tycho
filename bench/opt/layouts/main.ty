package main

# AoS vs SoA for an entity update loop. Both layouts are contiguous in Tycho;
# SoA separates fields when a system touches only some of them.
struct Particle:
    x: int
    y: int
    z: int
    vx: int
    vy: int
    vz: int

const N = 200000
const STEPS = 24

fn aos_run() -> int:
    ps := []Particle
    for i := 0; i < N; i += 1:
        push(ps, Particle(i, i * 2, i * 3, 1, 2, 3))
    for s := 0; s < STEPS; s += 1:
        for i := 0; i < N; i += 1:
            ps[i].x = ps[i].x + ps[i].vx
            ps[i].y = ps[i].y + ps[i].vy
            ps[i].z = ps[i].z + ps[i].vz
    sum := 0
    for i := 0; i < N; i += 1:
        sum = sum + ps[i].x + ps[i].y + ps[i].z
    return sum

fn soa_run() -> int:
    ps := soa []Particle
    for i := 0; i < N; i += 1:
        push(ps, Particle(i, i * 2, i * 3, 1, 2, 3))
    for s := 0; s < STEPS; s += 1:
        for i := 0; i < N; i += 1:
            ps[i].x = ps[i].x + ps[i].vx
            ps[i].y = ps[i].y + ps[i].vy
            ps[i].z = ps[i].z + ps[i].vz
    sum := 0
    for i := 0; i < N; i += 1:
        sum = sum + ps[i].x + ps[i].y + ps[i].z
    return sum

fn main():
    mode := args()[1]
    if mode == "aos":
        println("aos=" + str(aos_run()))
    elif mode == "soa":
        println("soa=" + str(soa_run()))
    else:
        eprintln("usage: layouts aos|soa")
