# Fixed-size user enum vs an equivalent inline tag+payload record. This is the
# layout probe for a future inline enum representation; the packed record is a
# lower bound on what unboxing can buy.
enum Kind:
    A
    B(int)
    C(int)

packed struct InlineKind:
    tag: u8
    v: int

const N = 1000000

fn enum_values() -> int:
    xs: [Kind] = []
    for i := 0; i < N; i += 1:
        if i % 3 == 0:
            push(xs, A)
        elif i % 3 == 1:
            push(xs, B(i))
        else:
            push(xs, C(i + 1))
    s := 0
    for i := 0; i < len(xs); i += 1:
        match xs[i]:
            A: s = s + 1
            B(x): s = s + x
            C(y): s = s + y
    return s

fn inline_values() -> int:
    xs: [InlineKind] = []
    for i := 0; i < N; i += 1:
        if i % 3 == 0:
            push(xs, InlineKind(0, 0))
        elif i % 3 == 1:
            push(xs, InlineKind(1, i))
        else:
            push(xs, InlineKind(2, i + 1))
    s := 0
    for i := 0; i < len(xs); i += 1:
        e := xs[i]
        if e.tag == 0:
            s = s + 1
        else:
            s = s + e.v
    return s

fn main():
    mode := args()[1]
    if mode == "enum":
        println(str(enum_values()))
    elif mode == "inline":
        println(str(inline_values()))
