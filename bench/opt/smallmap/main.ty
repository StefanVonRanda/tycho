# O7: the tight small-map loop. A six-entry map literal is rebuilt per pass;
# presizing the literal skips the 0 -> 4 -> 8 growth copies. TYCHOC_NO_MAP_PRESIZE
# is the control. O6's map CoW also applies to `x := m` when the map is shared.
fn main():
    n := 200000
    s := 0
    for i := 0; i < n; i += 1:
        x := [1: 10, 2: 20, 3: 30, 4: 40, 5: 50, 6: 60]
        x[3] = i
        s = s + x[3] + len(x)
    println(str(s))
