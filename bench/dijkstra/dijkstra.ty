package main

struct Edge:
    to: int
    w: int

fn hswap(h: inout [(int, int)], a: int, b: int):
    t := h[a]
    h[a] = h[b]
    h[b] = t

fn hpush(h: inout [(int, int)], d: int, node: int):
    push(h, (d, node))
    i := len(h) - 1
    for i > 0:
        p := (i - 1) / 2
        if h[p].0 <= h[i].0:
            break
        hswap(&h, p, i)
        i = p

fn hpop(h: inout [(int, int)]) -> (int, int):
    top := h[0]
    n := len(h) - 1
    h[0] = h[n]
    _d := pop(h)
    i := 0
    for true:
        l := 2 * i + 1
        r := 2 * i + 2
        small := i
        if l < len(h) and h[l].0 < h[small].0:
            small = l
        if r < len(h) and h[r].0 < h[small].0:
            small = r
        if small == i:
            break
        hswap(&h, i, small)
        i = small
    return top

fn dijkstra(adj: [[Edge]], src: int, n: int) -> [int]:
    inf := 4000000000000000000
    dist := []int
    i := 0
    for i := 0; i < n; i += 1:
        push(dist, inf)
    dist[src] = 0
    heap := [](int, int)
    hpush(&heap, 0, src)
    for len(heap) > 0:
        cur := hpop(&heap)
        d := cur.0
        u := cur.1
        if d > dist[u]:
            continue
        j := 0
        for j := 0; j < len(adj[u]); j += 1:
            e := adj[u][j]
            nd := d + e.w
            if nd < dist[e.to]:
                dist[e.to] = nd
                hpush(&heap, nd, e.to)
    return dist

fn main():
    n := 300000
    deg := 4
    state := 88172645463325252
    adj := [][Edge]
    u := 0
    for u := 0; u < n; u += 1:
        push(adj, []Edge)
    for u := 0; u < n; u += 1:
        k := 0
        for k := 0; k < deg; k += 1:
            state = state * 6364136223846793005 + 1442695040888963407
            to := (state & 1073741823) % n
            state = state * 6364136223846793005 + 1442695040888963407
            w := ((state & 1073741823) % 100) + 1
            push(adj[u], Edge(to, w))
    dist := dijkstra(adj, 0, n)
    inf := 4000000000000000000
    sum := 0
    reach := 0
    i := 0
    for i := 0; i < n; i += 1:
        if dist[i] < inf:
            sum = sum + dist[i]
            reach = reach + 1
    println(str(reach) + " " + str(sum))
