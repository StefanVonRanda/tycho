package main
# tycho-httpd -- a static web server written in Tycho.
#
#   ./tycho-httpd --root server/www --port 8080 --workers 8
#
# It serves a directory of real files -- HTML, CSS, JS, images, fonts -- over
# HTTP/1.1 with persistent connections, correct content types, index resolution,
# and a hard refusal of anything that tries to climb out of the document root.
#
# CONCURRENCY. A fixed pool of worker tasks, each running its own accept(2) loop
# on the one shared listening fd. The pool is built by RECURSIVE FAN-OUT: worker
# k spawns worker k+1 into a frame-local before entering its own loop. That is
# not a stylistic choice. A task handle in Tycho is affine -- it cannot be stored
# in an array, a struct, or any aggregate -- so the only place to keep N live
# handles is N stack frames. See the webserver plan, for the measurements that
# settled this (8 workers, 8 concurrent 500ms clients, 509ms wall).
#
# REQUEST READING. One call: `got, raw := httpd.read_request_capped(conn, MAX_HEAD)`.
# This file used to reimplement the read loop -- 19 lines and a local `Head`
# struct -- for one reason: read_request reported EOF, an idle timeout and a
# malformed request line the same way, as `method == ""`, so a server that must
# answer 400 to garbage while hanging up silently on a disconnect could not use
# it. The corelib says which failure it was now (httpd.ReqErr), and takes the
# byte cap as a parameter and hands the raw buffer back, so the reimplementation
# is gone (the option-result plan; FRICTION.md phase 7).
#
# ERROR MODEL, 2026-07-26. core:net's fallible TCP calls, httpd.parse_request /
# read_request and io.read_bytes all return Result(T, E) instead of a negative
# int, an empty `bytes` or an empty method string. What that bought here, in the
# four places it is visible:
#
#   * serve_conn ACTS on the reason. Err(httpd.Closed) closes with no response
#     and no log line; Err(httpd.Timeout) on a started request answers 408;
#     Err(httpd.TooLarge) answers 431; Err(httpd.Malformed) answers 400. Those
#     were one indistinguishable "nothing arrived" before phase 1.
#   * a file that vanished or turned out to be a directory between resolve() and
#     the read is Err(io.IsDir) / Err(io.NotFound) -> 404, where the empty
#     `bytes` used to be served as a 0-byte 200.
#   * resolve() asks io.is_dir, a real stat(2), instead of `len(io.list(p)) > 0`,
#     so a directory redirects to its slash form whether or not it holds an
#     index -- and only a directory does. That one was never an error-model
#     problem: it was a missing syscall (the option-result plan).
#   * httpd.write_response's `-1` is gone; emit is a tail call onto it and so
#     spends zero lines on plumbing.
#   * `or_return` only short-circuits out of a function that returns a matching
#     Result, so the functions here that return a Response or a count collapse
#     theirs with core:result's `unwrap_or` -- which replaced the hand-written
#     `nwrote` helper this file used to carry (the option-result plan).
#
# CONDITIONAL REQUESTS, 2026-07-31. A GET carrying If-Modified-Since is answered
# 304 when the file's mtime is not newer than the client's timestamp, and every
# 200 for a file carries Last-Modified. The comparison fails closed in the one
# direction that matters -- an absent, unparseable or unanswerable condition is a
# 200, never a 304 -- because a wrong 304 is a client holding a changed file for
# as long as it caches. See serve_conn's 200 arm and parse_http_date.
#
# BYTE RANGES, 2026-07-31. A GET or HEAD carrying `Range: bytes=A-B`, `bytes=A-`
# or `bytes=-N` is answered 206 with that slice, a Content-Range naming it, and a
# Content-Length of the SLICE. The file is never read whole to serve part of it:
# io.size gives the length and io.read_at pread(2)s the slice. A range that
# cannot be satisfied is 416 with `Content-Range: bytes */LEN`; a range this
# server does not understand -- bad syntax, or the multipart form -- is ignored
# and answered 200 with the whole file, which is what RFC 7233 2.1 requires.
# A conditional that resolves to 304 OUTRANKS a range: see serve_conn's 200 arm,
# where the range work is inside the else of the 304 test.
#
# NOT IMPLEMENTED, deliberately: TLS, HTTP/2, multipart ranges, compression,
# ETag, pipelining, virtual hosts. See README.md.

import "core:cli"
import "core:httpd"
import "core:net"
import "core:io"
import "core:result"
import "core:path"
import "core:url"
import "core:strings"
import "core:signal"
import "core:time"
import "core:datetime"

const VERSION     = "tycho-httpd/1.0"
const DEF_HOST    = "127.0.0.1"
const DEF_PORT    = 8080
const DEF_WORKERS = 8
const DEF_IDLE_MS = 5000
const MAX_HEAD    = 16384      # per-request byte budget; past this -> 431, connection closed
const MAX_REQS    = 1024       # requests served on one connection before we close it
const LOG_FIELD   = 160        # longest request target we will echo into a log line
# How long one accept loop keeps trying after a FAILED accept before it gives up
# and retires. See accept_loop's Err arm: 100 * 20ms = two seconds of unbroken
# failure. Sized against the two things it has to separate. A transient burst --
# EMFILE, ENFILE, ECONNABORTED, EPROTO, all of which POSIX says to retry -- is
# survived whole as long as it clears inside that window; measured, a 400ms
# externally-induced EMFILE window used to retire every worker and now retires
# none. A listener that is permanently broken WITHOUT a shutdown signal (nothing
# in this program does that today) still terminates the loop, so the pool can
# never spin forever and wait() can never block forever.
const MAX_ACCEPT_FAILS = 100
const ACCEPT_BACKOFF_MS = 20   # between retries, so a hard failure is not a hot loop

struct Config:
    root: string
    host: string
    port: int
    workers: int
    idle_ms: int
    quiet: bool

# What a request target resolved to. `status` 200 means serve `file`; 301 means
# redirect to `location`; anything else is an error to render.
struct Route:
    status: int
    file: string
    location: string

# What a Range header resolved to against a known file length. THREE outcomes,
# not two, and conflating any pair of them is a wire-visible bug:
#
#   NONE   there is no usable range here -- no header, syntax this server does
#          not accept, or the multipart form. RFC 7233 2.1: "an origin server
#          MUST ignore a Range header field that contains a range unit it does
#          not understand", and an invalid byte-range-set is likewise ignored.
#          So this is a 200 with the WHOLE file, never an error.
#   OK     a satisfiable range. `start`..`end` are absolute byte offsets into
#          the file and BOTH ARE INCLUSIVE -- that is HTTP's convention, not
#          C's, so the length is end - start + 1 and the classic off-by-one is
#          reading end - start bytes.
#   UNSAT  syntactically fine, but no byte of it exists (first-byte-pos at or
#          past EOF, or a zero-length suffix). 416, with `Content-Range:
#          bytes */LEN`.
const RANGE_NONE  = 0
const RANGE_OK    = 1
const RANGE_UNSAT = 2

struct Rng:
    kind: int
    start: int
    end: int

# ---- small helpers ---------------------------------------------------------

fn is_ctl(c: int) -> bool:
    return c < 32 or c == 127

fn is_digits(s: string) -> bool:
    if len(s) == 0:
        return false
    for i := 0; i < len(s); i += 1:
        if s[i] < 48 or s[i] > 57:
            return false
    return true

# RFC 7231 IMF-fixdate, the format Date, Last-Modified and If-Modified-Since
# all want. Exactly 29 characters, fixed field positions, English names:
#   Sun, 26 Jul 2026 08:49:37 GMT
#   0123456789...                29
#
# core:datetime has no IMF-fixdate of its own -- it formats ISO-8601 and parses
# ISO-8601 and CLF -- but it has every PIECE: weekday_name/month_name give the
# English abbreviations, pad2/pad4 the zero padding, from_unix the fields, and
# month_num the inverse. So the format lives here, in the one package that wants
# it, rather than a date library being written from scratch.
fn http_date_at(secs: int) -> string:
    dt := datetime.from_unix(secs)
    out := datetime.weekday_name(dt.weekday) + ", " + datetime.pad2(dt.day)
    out += " " + datetime.month_name(dt.month) + " " + datetime.pad4(dt.year)
    out += " " + datetime.pad2(dt.hour) + ":" + datetime.pad2(dt.minute)
    return out + ":" + datetime.pad2(dt.second) + " GMT"

fn http_date() -> string:
    return http_date_at(now())

# Parse an IMF-fixdate to UNIX seconds, or -1 if it is not one. FAIL-CLOSED, and
# the failure direction is the whole point: -1 means the caller serves 200. A
# wrong parse that reads TOO EARLY costs a needless 200; one that reads too LATE
# hands a client a 304 for a file that changed. So every doubt returns -1.
#
# Only IMF-fixdate is accepted. RFC 7231 7.1.1.1 lists two obsolete forms an
# HTTP/1.1 recipient must also accept -- rfc850 ("Sunday, 06-Nov-94 08:49:37
# GMT") and asctime ("Sun Nov  6 08:49:37 1994"). They are NOT parsed here, and
# what that costs is exactly one needless 200 for a client that sends one: they
# fall out as -1, which is the safe direction. Every client that gets an
# If-Modified-Since from us is echoing back the Last-Modified we wrote, which is
# an IMF-fixdate by construction.
#
# The field scan is delegated: rearranging the fixed positions into the CLF shape
# `dd/Mon/yyyy:HH:MM:SS` lets datetime.parse_clf do the digits, the month name,
# and the range checks (it rejects a 13th month, a 31st of February, hour 24)
# rather than a second copy of that logic living here. What stays here is what
# CLF cannot see: the punctuation that makes this an IMF-fixdate and not
# something else, and the literal GMT.
fn parse_http_date(s: string) -> int:
    if len(s) != 29:
        return -1
    if s[3] != 44 or s[4] != 32 or s[7] != 32 or s[11] != 32:    # ',' ' ' ' ' ' '
        return -1
    if s[16] != 32 or s[25] != 32:                               # ' ' ' '
        return -1
    if s[26:29] != "GMT":                                        # UTC only, by spec
        return -1
    clf := s[5:7] + "/" + s[8:11] + "/" + s[12:16] + ":" + s[17:25]
    dt := datetime.parse_clf(clf)
    if not datetime.ok(dt):
        return -1
    return datetime.to_unix(dt)                                  # GMT, so no offset

# ---- Range ------------------------------------------------------------------

# `s` starts with `p`, comparing ASCII case-insensitively. `p` must be lowercase.
# Needed because a range UNIT is a token (RFC 7233 2.2) and tokens are compared
# case-insensitively -- `Range: BYTES=0-9` is the same request as `bytes=0-9`.
# httpd.header already folds the header NAME; this folds the value's first word.
fn ci_prefix(s: string, p: string) -> bool:
    if len(s) < len(p):
        return false
    for i := 0; i < len(p); i += 1:
        c := s[i]
        if c >= 65 and c <= 90:                # 'A'..'Z' -> lowercase
            c = c + 32
        if c != p[i]:
            return false
    return true

# A byte-position out of a Range header: a run of DIGITS ONLY, or -1 for "that
# is not a position". No sign, no whitespace, no 0x -- RFC 7233's grammar is
# 1*DIGIT and nothing else, and every non-digit here means the whole header is
# ignored, which is a 200. Leading zeros are legal and parse normally.
#
# The length guard is the reason this is not a bare strings.parse_int. A range
# header is attacker-controlled and `bytes=0-99999999999999999999999999` costs
# nothing to send; past ~19 digits the value does not fit an int and what
# parse_int does with it is not something this file should depend on. 16+ digits
# is instead reported as HUGE_POS, which is larger than any file this program
# can open and therefore lands in exactly the arm the true value would have:
# clamped to the end of the file as a last-byte-pos, past EOF (416) as a
# first-byte-pos, and "the whole file" as a suffix length.
const HUGE_POS = 1000000000000000        # 1e15, > any real file, < 2^63

fn parse_pos(s: string) -> int:
    if not is_digits(s):
        return -1
    if len(s) > 15:
        return HUGE_POS
    return strings.parse_int(s)

# Resolve a Range header value against a known file length. `flen` must be the
# real length (io.size); pass -1 when it is unknown and every range becomes
# RANGE_NONE, because a range cannot be checked -- let alone clamped -- without
# it. Returning NONE there is the fail-safe direction: the client gets the whole
# file, which is always a correct answer to a range request.
#
# The three forms, and the fourth this server refuses:
#
#   bytes=A-B   both ends, both INCLUSIVE. B is clamped to the last byte, so
#               `bytes=0-999999` on a 500-byte file is 206 of all 500 bytes and
#               NOT a 416 -- the range overlaps the file, so it is satisfiable.
#               B < A is not a range at all: RFC 7233 2.1 calls that byte-range-
#               spec invalid, and an invalid one makes the whole header ignored.
#   bytes=A-    open-ended: A to the last byte.
#   bytes=-N    SUFFIX: the last N bytes, so it is the only form whose START
#               depends on the length. N larger than the file is the whole file
#               (RFC 7233 2.1 says so outright). N == 0 asks for nothing and is
#               unsatisfiable, which is a 416 rather than an empty 206.
#   A,B         multipart. Out of scope by decision -- a multipart/byteranges
#               body is a second serialization format, not a bigger parser --
#               and answered 200 with the whole file, which is what the RFC
#               permits and what the README records.
fn parse_range(v: string, flen: int) -> Rng:
    if flen < 0:
        return Rng(RANGE_NONE, 0, 0)           # no length: cannot resolve one
    if not ci_prefix(v, "bytes="):
        return Rng(RANGE_NONE, 0, 0)           # absent, or a unit we do not know
    spec := v[6:len(v)]
    if find(spec, ",") >= 0:
        return Rng(RANGE_NONE, 0, 0)           # multipart, out of scope
    d := find(spec, "-")
    if d < 0:
        return Rng(RANGE_NONE, 0, 0)
    lhs := spec[0:d]
    rhs := spec[d + 1:len(spec)]
    if len(lhs) == 0:
        n := parse_pos(rhs)
        if n < 0:
            return Rng(RANGE_NONE, 0, 0)       # "bytes=-" and "bytes=-x"
        if n == 0 or flen == 0:
            return Rng(RANGE_UNSAT, 0, 0)      # nothing to give
        s := flen - n
        if s < 0:
            s = 0                              # a suffix longer than the file
        return Rng(RANGE_OK, s, flen - 1)
    a := parse_pos(lhs)
    if a < 0:
        return Rng(RANGE_NONE, 0, 0)
    if len(rhs) == 0:
        if a >= flen:
            return Rng(RANGE_UNSAT, 0, 0)      # also catches flen == 0
        return Rng(RANGE_OK, a, flen - 1)
    b := parse_pos(rhs)
    if b < 0:
        return Rng(RANGE_NONE, 0, 0)
    if b < a:
        return Rng(RANGE_NONE, 0, 0)           # invalid spec -> ignore the header
    if a >= flen:
        return Rng(RANGE_UNSAT, 0, 0)
    e := b
    if e > flen - 1:
        e = flen - 1                           # clamp, do NOT reject
    return Rng(RANGE_OK, a, e)

# Microseconds as "1.234ms", for the log line.
fn fmt_ms(us: int) -> string:
    frac := str(us % 1000)
    for len(frac) < 3:
        frac = "0" + frac
    return str(us / 1000) + "." + frac + "ms"

# Make an arbitrary byte string safe to put in a log line: control bytes become
# '.', and it is truncated. A request target is attacker-controlled; it must not
# be able to inject newlines into the log or paint the terminal.
#
# Written in `bytes`, which is what a hostile request target is. `b[i]` reads the
# byte value, `b[i:i+1]` copies one byte through unchanged, `+` appends; the
# to_bytes/to_str at the two ends are zero-cost reinterprets of the same buffer
# (src/tychoc.c:9020), so nothing is converted and nothing is copied twice. This
# used to detour string -> []int -> to_bytes -> to_str, where the to_bytes([int])
# leg (src/tychoc.c:9018) was the one REAL conversion and allocation in the path.
fn log_safe(s: string) -> string:
    n := len(s)
    cut := false
    if n > LOG_FIELD:
        n = LOG_FIELD
        cut = true
    b := to_bytes(s)
    scrubbed := to_bytes("")
    for i := 0; i < n; i += 1:
        if is_ctl(b[i]):
            scrubbed = scrubbed + '.'
        else:
            scrubbed = scrubbed + b[i:i + 1]
    out := to_str(scrubbed)
    if cut:
        out += "..."
    return out

# The request line of a raw buffer, for logging a request we could not parse.
fn first_line(raw: string) -> string:
    e := find(raw, "\n")
    if e >= 0:
        return log_safe(raw[0:e])
    return log_safe(raw)

# ---- content types ---------------------------------------------------------

# core:httpd's table covers the web's common types but not the two font formats
# people actually self-host (.ttf/.otf), nor source maps. Extend it here rather
# than in the corelib package: an application knowing its own assets is the right
# layer for this, and the fallback is still application/octet-stream.
fn ctype_for(p: string) -> string:
    if httpd.has_ext(p, ".ttf"):
        return "font/ttf"
    if httpd.has_ext(p, ".otf"):
        return "font/otf"
    if httpd.has_ext(p, ".map"):
        return "application/json"
    if httpd.has_ext(p, ".webmanifest"):
        return "application/manifest+json"
    if httpd.has_ext(p, ".md"):
        return "text/markdown; charset=utf-8"
    return httpd.content_type(p)

# ---- error pages -----------------------------------------------------------

fn explain(status: int) -> string:
    if status == 400:
        return "The request could not be parsed as HTTP."
    if status == 403:
        return "That path is not inside the document root."
    if status == 404:
        return "No file is published at that path."
    if status == 405:
        return "This server is read-only. Use GET or HEAD."
    if status == 408:
        return "The request was not completed before the idle timeout expired."
    if status == 416:
        return "The requested byte range lies outside this file."
    if status == 431:
        return "The request headers exceeded this server's limit."
    return "The server could not complete the request."

# The error page as ONE expression instead of twelve `s +=` statements: adjacent
# string literals join into a single literal at parse time, and (...) joins the
# physical lines. Every run of static markup below is therefore one interned
# literal, so only the five dynamic splices concatenate at run time.
fn error_body(status: int, reason: string) -> string:
    return ("<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\">\n"
            "<title>" + str(status) + " " + reason + "</title>\n"
            "<style>"
            "body{background:#181c30;color:#f0eee6;margin:0;min-height:100vh;"
            "display:grid;place-items:center;font:17px/1.6 ui-sans-serif,system-ui,sans-serif}"
            "main{max-width:32rem;padding:2rem;text-align:center}"
            "h1{font-size:3.5rem;margin:0;color:#7c5cf0;letter-spacing:-.03em}"
            "p{color:#a9a6bb}a{color:#7c5cf0}</style>\n</head>\n<body><main>\n"
            "<h1>" + str(status) + "</h1>\n<p><strong>" + reason + "</strong></p>\n"
            "<p>" + explain(status) + "</p>\n"
            "<p><a href=\"/\">back to the index</a></p>\n"
            "<p style=\"font-size:.8rem\">" + VERSION + "</p>\n"
            "</main></body></html>\n")

fn error_response(status: int) -> httpd.Response:
    reason := httpd.reason_phrase(status)
    r := httpd.response(status, to_bytes(error_body(status, reason)))
    r = httpd.with_header(r, "Content-Type", "text/html; charset=utf-8")
    if status == 405:
        r = httpd.with_header(r, "Allow", "GET, HEAD")
    return r

# ONE ERROR CONSTRUCTOR, and this is why there used to be two: 408 and 431 were
# outside httpd.reason_phrase's table, so httpd.response() rendered them as the
# placeholder "Status" and the only way to set the phrase was to build the struct
# positionally -- a private phrased_response() reimplementing the corelib's own
# constructor, plus a named wrapper per status. Both codes are in the table since
# 2026-07-26 (the friction plan) and httpd.response_reason() exists for the ones that
# are not, so error_response(431) and error_response(408) are the whole of it.
fn redirect_response(location: string) -> httpd.Response:
    body := to_bytes("<!doctype html><meta charset=\"utf-8\"><title>301</title>\n")
    r := httpd.response(301, body)
    r = httpd.with_header(r, "Content-Type", "text/html; charset=utf-8")
    return httpd.with_header(r, "Location", location)

# ---- path resolution -------------------------------------------------------
#
# THE SECURITY BOUNDARY. Everything a request can influence about which file we
# open passes through here, and the order matters:
#
#   1. cut the query and fragment                (?a=1, #frag are not path)
#   2. require origin-form                       (must start with "/")
#   3. percent-decode ONCE                       (so %2e%2e cannot hide a "..")
#   4. reject control bytes, NUL included        (path smuggling, log injection)
#   5. reject any segment starting with "."      (.git, .env, .htpasswd)
#   6. path.safe_join, which returns "" for an absolute rel or one that
#      climbs above the root                     (corelib/path/path.ty:140)
#
# Decoding before the traversal test is the part that is easy to get backwards.
# A single decode is also deliberate: decoding twice would let %252e%252e
# through, which is exactly the historical IIS bug.

fn hidden_segment(rel: string) -> bool:
    opening := true
    for i := 0; i < len(rel); i += 1:
        c := rel[i]
        if opening and c == 46:
            return true
        opening = c == 47
    return false

fn resolve(root: string, target: string) -> Route:
    p := target
    q := find(p, "?")
    if q >= 0:
        p = p[0:q]
    fr := find(p, "#")
    if fr >= 0:
        p = p[0:fr]
    if len(p) == 0 or p[0] != 47:
        return Route(400, "", "")                  # absolute-form or garbage
    dec := url.decode(p)
    for i := 0; i < len(dec); i += 1:
        if is_ctl(dec[i]):
            return Route(400, "", "")
    rel := dec[1:len(dec)]
    dir_form := len(rel) == 0 or rel[len(rel) - 1] == 47
    if dir_form:
        rel += "index.html"
    if hidden_segment(path.clean(rel)):
        return Route(403, "", "")
    fsp := path.safe_join(root, rel)
    if fsp == "":
        return Route(403, "", "")                  # absolute, or escapes root
    # A target with NO trailing slash that names a directory redirects to the slash
    # form, and "is this a directory" is finally asked of the KERNEL: io.is_dir is a
    # real stat(2) (the option-result plan). Only this branch can be one -- the dir_form
    # path has index.html appended, so fsp is a file path there. The old test was
    # `len(io.list(fsp)) > 0`, which calls an EMPTY directory a file, so /emptydir
    # answered 404 where 301 -> /emptydir/ is correct: a directory's CONTENTS
    # decided its STATUS. Ok(false) (it is a file) and Err(NotFound) both fall
    # through to the exists check below, which is where a missing path becomes 404.
    # ONE stat(2) now answers all three tails. This used to be io.is_dir followed by
    # io.exists on the SAME path -- two calls, one question, and the second was the
    # expensive one (it listed the whole parent). io.exists is stat-backed as of
    # the friction plan, which is what made the pair visibly redundant rather than
    # merely ugly, so the pair collapses into the one Result that already carried
    # every answer:
    #   Ok(true)   a directory. With no trailing slash that is a 301 to the slash
    #              form; WITH one, fsp already ends in index.html, so a directory
    #              there is a directory NAMED index.html -- unservable, 404. (That
    #              was a 200 -> read_bytes -> Err(IsDir) -> 404 before: same status,
    #              one syscall fewer and no wrong intermediate.)
    #   Ok(false)  it is there and is not a directory: serve it.
    #   Err(_)     nothing there, or there and unstattable -- 404 both ways, fail
    #              closed. Includes /dir/ with no index.html.
    # (A literal nested pattern -- `Ok(true)` -- is not legal; the friction plan refused
    # non-enum nested patterns with the cost written down. So the bool is bound.)
    match io.is_dir(fsp):
        Ok(isdir):
            if not isdir:
                return Route(200, fsp, "")
            if dir_form:
                return Route(404, "", "")
            return Route(301, "", p + "/")         # /dir -> /dir/, index or not
        Err(e):
            return Route(404, "", "")

# ---- the connection loop ---------------------------------------------------

# httpd.write_response returns Result(int, net.NetErr) now, and emit is a tail
# call onto it -- so emit propagates the failure by returning the same type and
# spends ZERO lines on plumbing. No `or_return` is even needed here; matching
# error types make the sentinel check disappear entirely.
fn emit(conn: int, r: httpd.Response, head_only: bool, keep: bool) -> Result(int, net.NetErr):
    out := httpd.with_connection(r, keep)
    out = httpd.with_header(out, "Server", VERSION)
    out = httpd.with_header(out, "Date", http_date())
    # TWO THINGS SUPPRESS A BODY HERE AND THEY ARE NOT THE SAME THING, which is
    # why the guard is not redundant. HEAD suppresses the body while KEEPING the
    # Content-Length a GET would have reported -- that is the entire point of
    # HEAD, and the explicit header is what stops render_head recomputing it from
    # the now-empty body. A 304 suppresses the body AND the length, because there
    # is no representation being described (httpd.bodyless, and RFC 7230 3.3.2:
    # the only Content-Length a 304 may carry is the 200's, which the 304 path
    # deliberately never learns -- it does not open the file). Run the HEAD arm on
    # a 304 and it stamps `Content-Length: 0`, the one value that rule forbids.
    # A bodyless response has an empty body already, so there is nothing to strip.
    #
    # A HEAD CARRYING A RANGE is the third case and it needs NO third rule, which
    # is the point of stating it here. 206 is not bodyless, so this arm runs and
    # reports len(out.body) -- and out.body is the SLICE, because the 206 was
    # built with the slice as its body. So a HEAD with `Range: bytes=0-99` gets
    # 206, the Content-Range of the slice, `Content-Length: 100` and no bytes:
    # exactly the head its GET would have produced, which is what HEAD means.
    # The alternative -- skipping the pread on HEAD and setting the length by
    # arithmetic -- would be a second, unexercised way to compute the number this
    # server's whole Range feature turns on.
    if head_only and not httpd.bodyless(out.status):
        out = httpd.with_header(out, "Content-Length", str(len(out.body)))
        out = httpd.with_body(out, to_bytes(""))
    return httpd.write_response(conn, out)

# One line per request on stderr: worker, CLIENT, method, target, status, body
# bytes, duration. Built whole and written with a single eprint, because N workers
# share one stderr and there is no lock to take.
#
# `peer` is the client address, from net.peer_addr (getpeername) -- the field every
# real access log leads with, and one that no Tycho program could obtain before
# 2026-07-26: core:net wrapped getsockname and nothing else (FRICTION.md phase 7,
# the friction plan). It is `-` when the fd could not be asked, which is honest
# rather than blank: an unaskable fd is a connection that has already gone.
#
# `wrote` is what write_response returned. It is < 0 when the peer vanished
# mid-response; the line then reports 0 bytes and says so, rather than claiming
# a body that never reached anyone.
fn log_req(cfg: Config, wid: int, peer: string, method: string, target: string, status: int, nbytes: int, wrote: int, us: int):
    if cfg.quiet:
        return
    n := nbytes
    tail := ""
    if wrote < 0:
        n = 0
        tail = " write-failed"
    ln := "w" + str(wid) + " " + peer + " " + log_safe(method) + " " + target + " "
    ln += str(status) + " " + str(n) + " " + fmt_ms(us) + tail + "\n"
    eprint(ln)

# Answer a request that could not be read, and log it. The three refusable read
# failures (400 Malformed, 408 Timeout, 431 TooLarge) differ only in status and
# body, so the wire-and-log tail lives here once instead of in each arm of
# serve_conn's cause match. `-` is the method: there is no parsed request to name
# one, and first_line(raw) is all the log can honestly report.
fn refuse(cfg: Config, wid: int, peer: string, conn: int, raw: string, st: int, r: httpd.Response, sw: int):
    n := result.unwrap_or(emit(conn, r, false, false), -1)
    log_req(cfg, wid, peer, "-", first_line(raw), st, len(r.body), n, time.elapsed_us(sw))

fn serve_conn(cfg: Config, conn: int, wid: int) -> int:
    served := 0
    alive := true
    # Asked ONCE per connection, not once per request: the peer of an accepted fd
    # cannot change, and keep-alive would otherwise repeat the syscall per request.
    peer := result.unwrap_or(net.peer_addr(conn), "-")
    # THE SHUTDOWN CHECK GOES IN THE LOOP CONDITION, and nowhere else in here.
    # This is the one point in serve_conn where nothing is in flight: the previous
    # response has been written and logged, and the next blocking read has not
    # started. Testing the flag here means a worker never COMMITS to another
    # read_request_capped once shutdown is under way -- which is the whole cost,
    # because that read blocks for up to cfg.idle_ms and the loop cannot be
    # re-entered until it returns. Testing it any deeper would abandon a request
    # mid-answer; testing it any shallower (in accept_loop only, which also tests
    # it) never sees a kept-alive connection at all.
    #
    # The busy case, where the loop is actually reached between requests, went
    # from 102215 ms to 6-8 ms -- and that 102 s, not the 5 s that was reported,
    # was the real worst case here: it is MAX_REQS requests served at the
    # client's own pace, because nothing was telling the loop to stop.
    #
    # What this check ALONE does not fix, and what does. A worker ALREADY blocked
    # in that read when the signal lands cannot reach this condition at all; it
    # stays in recv until SO_RCVTIMEO expires, because shutting down the LISTENER
    # wakes accept(2) and nothing else. That cost one full idle timeout -- 4878 ms
    # measured at --idle-ms 5000 with four parked clients. It is fixed on the
    # other side, by registering each accepted fd so the handler shuts those down
    # too (accept_loop below, and corelib/signal/signal.ty's register_conn):
    # 4878 ms -> 1 ms, 5 runs out of 5. The two halves are complementary, not
    # alternatives -- the registry releases a parked read, this condition stops
    # the loop from starting another one.
    #
    # A connection accepted but not yet spoken on is dropped here without an
    # answer. That is the same bargain core:signal already documents for the
    # backlog, and the same thing the idle-expiry arm at server/main.ty:431-435
    # does for a keep-alive connection whose peer went quiet.
    for alive and served < MAX_REQS and not signal.shutdown_requested():
        # ONE corelib call does the read, the cap and the parse. `raw` is the second
        # tuple element, for the two jobs the Result cannot do: name a request that
        # would not parse in the access log, and answer "did this peer even start
        # talking" below. This one line replaced a 19-line local read loop and its
        # `Head` struct.
        got, raw := httpd.read_request_capped(conn, MAX_HEAD)
        sw := time.start()
        match got:
            # The five causes, ACTED ON rather than collapsed, and since
            # the friction plan each one is its OWN
            # ARM. This used to be `Err(e)` followed by
            # five `e == httpd.X` comparisons and an `answer` bool, because there
            # were no nested patterns; the causes are the same, the two-step is not.
            # (What phases 1-3 were for: the old local read loop could only say
            # "nothing arrived", so each of these was a 400 or a silent close chosen
            # by guessing from len(raw).)
            #
            #   Closed    the peer hung up. No response, no log line: there is
            #             nobody to answer and nothing was asked.
            #   Failed    the socket is broken (reset, bad fd); a write would fail
            #             too, so treat it like Closed.
            Err(httpd.Closed):
                alive = false
            Err(httpd.Failed):
                alive = false
            #   Timeout   the SO_RCVTIMEO deadline expired. With bytes in `raw` a
            #             request was under way and stalled -- 408 is the honest
            #             answer. With `raw` empty this is only keep-alive idle
            #             expiry, which no client is waiting on (nginx closes
            #             quietly here too), so close quietly.
            Err(httpd.Timeout):
                alive = false
                if len(raw) > 0:
                    served += 1
                    refuse(cfg, wid, peer, conn, raw, 408, error_response(408), sw)
            #   TooLarge  MAX_HEAD bytes with no terminator -> 431. This is the cap
            #             decision that used to be `len(raw) >= MAX_HEAD`.
            Err(httpd.TooLarge):
                alive = false
                served += 1
                refuse(cfg, wid, peer, conn, raw, 431, error_response(431), sw)
            #   Malformed a complete head that is not HTTP -> 400.
            Err(httpd.Malformed):
                alive = false
                served += 1
                refuse(cfg, wid, peer, conn, raw, 400, error_response(400), sw)
            Ok(req):
                served += 1
                keep := not httpd.connection_close(req)
                # read_request_capped consumes Content-Length body bytes, so a
                # well-formed bodied request no longer desyncs the socket by
                # itself -- but one whose body it had to truncate at MAX_HEAD
                # would, and this server serves no method that takes a body.
                # Answer, then close.
                clh := httpd.header(req, "content-length")
                if clh != "" or httpd.header(req, "transfer-encoding") != "":
                    keep = false
                # A Content-Length that is not a plain decimal count ("-5", "1x",
                # "0x10") is a request smuggling primitive, not a typo. Refuse it
                # rather than letting to_uint's lenient parse pick a number.
                bad_len := clh != "" and not is_digits(clh)
                head_only := req.method == "HEAD"
                target := log_safe(req.path)
                if bad_len:
                    r := error_response(400)
                    n := result.unwrap_or(emit(conn, r, false, false), -1)
                    log_req(cfg, wid, peer, "-", first_line(raw), 400, len(r.body), n, time.elapsed_us(sw))
                    alive = false
                elif req.method != "GET" and req.method != "HEAD":
                    r := error_response(405)
                    n := result.unwrap_or(emit(conn, r, false, keep), -1)
                    log_req(cfg, wid, peer, req.method, target, 405, len(r.body), n, time.elapsed_us(sw))
                    if n < 0:
                        alive = false
                else:
                    rt := resolve(cfg.root, req.path)
                    st := rt.status
                    r := error_response(st)
                    if st == 200:
                        # THE CONDITIONAL GET, and the direction of every doubt.
                        # A 304 is this server telling a client "what you already
                        # have is current", so a wrong 304 is a browser holding a
                        # changed file for as long as it caches. Three separate
                        # ways to not know the answer all fall through to 200:
                        #
                        #   lm < 0    io.mtime failed. No Last-Modified is sent
                        #             (a header we cannot fill is worse than none)
                        #             and no 304 is possible, since the comparison
                        #             has nothing to compare.
                        #   ims < 0   no If-Modified-Since, or one that is not an
                        #             IMF-fixdate. parse_http_date fails closed;
                        #             an unparseable header is not a weaker
                        #             condition, it is no condition.
                        #   lm > ims  the file is NEWER than what the client holds.
                        #
                        # `lm <= ims` and not `lm < ims` is the load-bearing
                        # comparison: equal means the client holds exactly this
                        # version. mtime is whole seconds (corelib/io/io.ty@mtime)
                        # and so is an IMF-fixdate, so the two are directly
                        # comparable with no rounding on either side.
                        lm := -1
                        match io.mtime(rt.file):
                            Ok(secs):
                                lm = secs
                            Err(e):
                                lm = -1
                        ims := -1
                        if httpd.header(req, "if-modified-since") != "":
                            ims = parse_http_date(httpd.header(req, "if-modified-since"))
                        if lm >= 0 and ims >= 0 and lm <= ims:
                            # The file is never opened on this path -- one stat(2)
                            # and no read -- so the hot 304 is CHEAPER than the
                            # serve it replaces, not an extra cost on top of it.
                            st = 304
                            r = httpd.response(304, to_bytes(""))
                            r = httpd.with_header(r, "Last-Modified", http_date_at(lm))
                            r = httpd.with_header(r, "Cache-Control", "no-cache")
                        else:
                            # THE RANGE, and it is DELIBERATELY INSIDE THIS ELSE.
                            # RFC 7232 6 orders the two: a conditional that
                            # resolves to 304 is evaluated BEFORE Range, and a
                            # 304 wins -- the client is being told "what you
                            # hold is current", which answers a request for part
                            # of it as completely as a request for all of it.
                            # Sending 206 there would hand back bytes the client
                            # already has AND drop the 304's promise. Nesting is
                            # what enforces the order; a flat `elif` chain on
                            # (ims, range) would let the two race on edit.
                            #
                            # The length comes from io.size -- ONE stat(2), no
                            # read. This is the whole reason phase 6 exists: all
                            # three forms and the 416 need LEN before they know
                            # what to read, and `len(io.read_bytes(p))` would
                            # allocate the file to serve a kilobyte of it.
                            flen := -1
                            match io.size(rt.file):
                                Ok(sz):
                                    flen = sz
                                Err(e):
                                    flen = -1
                            rg := parse_range(httpd.header(req, "range"), flen)
                            if rg.kind == RANGE_UNSAT:
                                # No byte of the requested range exists. The
                                # unsatisfied-range form of Content-Range names
                                # the length and nothing else, which is how the
                                # client learns what it should have asked for.
                                st = 416
                                r = error_response(416)
                                r = httpd.with_header(r, "Content-Range", "bytes */" + str(flen))
                                if lm >= 0:
                                    r = httpd.with_header(r, "Last-Modified", http_date_at(lm))
                            elif rg.kind == RANGE_OK:
                                # end is INCLUSIVE, so the count is +1. Reading
                                # end - start is the off-by-one this comment
                                # exists to prevent, and it is one byte short of
                                # the Content-Range this same arm advertises.
                                match io.read_at(rt.file, rg.start, rg.end - rg.start + 1):
                                    Ok(part):
                                        if len(part) == 0:
                                            # The file shrank between io.size and
                                            # the pread. Not reachable from a
                                            # correct client, but the honest
                                            # answer is the one for "no such
                                            # bytes", not a 206 describing an
                                            # empty slice.
                                            st = 416
                                            r = error_response(416)
                                            r = httpd.with_header(r, "Content-Range", "bytes */" + str(flen))
                                        else:
                                            # Content-Range reports what was
                                            # ACTUALLY read, not what was asked
                                            # for: a short read (the same shrink
                                            # race, partway) must not be
                                            # described as the full slice, or the
                                            # client stitches a hole into the file
                                            # it is reassembling.
                                            st = 206
                                            last := rg.start + len(part) - 1
                                            r = httpd.response(206, part)
                                            r = httpd.with_header(r, "Content-Type", ctype_for(rt.file))
                                            r = httpd.with_header(r, "Cache-Control", "no-cache")
                                            r = httpd.with_header(r, "Accept-Ranges", "bytes")
                                            r = httpd.with_header(r, "Content-Range",
                                                                  "bytes " + str(rg.start) + "-" + str(last)
                                                                  + "/" + str(flen))
                                            if lm >= 0:
                                                r = httpd.with_header(r, "Last-Modified", http_date_at(lm))
                                    Err(e):
                                        st = 404
                                        r = error_response(404)
                            else:
                                # io.read_bytes is a Result now, so the read has an answer
                                # for a file that vanished (or turned out to be a
                                # directory) between resolve() and here. The empty `bytes`
                                # it used to return was served as a 0-byte 200 --
                                # indistinguishable from a real empty file, and wrong for
                                # both.
                                match io.read_bytes(rt.file):
                                    Ok(body):
                                        r = httpd.response(200, body)
                                        r = httpd.with_header(r, "Content-Type", ctype_for(rt.file))
                                        r = httpd.with_header(r, "Cache-Control", "no-cache")
                                        # ADVERTISED, and only on the two responses
                                        # that describe this file's bytes. RFC 7233
                                        # 2.3 says a server that supports ranges
                                        # SHOULD send it, and the point is that a
                                        # resuming client can see it WITHOUT
                                        # spending a probe request to find out --
                                        # which is the only way to learn otherwise.
                                        # Not on 304: RFC 7232 4.1 lists what a 304
                                        # should carry and this is not on it, and a
                                        # 304 describes no representation. Not on an
                                        # error page either -- the ranges of a
                                        # generated 404 body are of no use to anyone.
                                        r = httpd.with_header(r, "Accept-Ranges", "bytes")
                                        if lm >= 0:
                                            r = httpd.with_header(r, "Last-Modified", http_date_at(lm))
                                    Err(e):
                                        st = 404
                                        r = error_response(404)
                    elif st == 301:
                        r = redirect_response(rt.location)
                    nb := len(r.body)
                    if head_only:
                        nb = 0
                    n := result.unwrap_or(emit(conn, r, head_only, keep), -1)
                    log_req(cfg, wid, peer, req.method, target, st, nb, n, time.elapsed_us(sw))
                    if n < 0:
                        alive = false               # peer hung up mid-write
                if not keep:
                    alive = false
    return served

# ---- the worker pool -------------------------------------------------------

# WHY THIS LOOP USES accept_wait, NOT blocking accept.
#
# signal.on_shutdown calls shutdown() on the listener. Linux wakes every thread
# blocked in accept(), but POSIX does not promise that and macOS leaves workers
# parked. A clean shutdown cannot depend on a Linux-only wakeup.
#
# net.accept_wait bounds that wait at 100ms. Its shim makes the listener
# nonblocking before select(), so two workers woken for one arrival cannot leave
# the loser stuck in accept(). Accepted sockets are put back in blocking mode.
#
# Timeout is not a listener failure. It is the ordinary idle result and gives
# each worker a chance to read signal.shutdown_requested(); no traffic is needed
# to release the pool after SIGTERM or SIGINT.
# shutdown() remains the fast wakeup on kernels that support it; the timeout is
# the portable ceiling when they do not. The handler still releases accepted
# connections immediately, so parked readers do not wait for their idle timer.
# This bounds shutdown without changing the blocking net.accept contract.
#
# Failed remains distinct. A transient EMFILE, ENFILE, ECONNABORTED or EPROTO is
# retried with ACCEPT_BACKOFF_MS, while MAX_ACCEPT_FAILS retires a permanently
# broken loop instead of spinning forever and making wait() hang forever.
#
# Existing net.accept callers keep their blocking contract. Only this server,
# which needs bounded cross-platform shutdown, opts into the timed form. The
# server harness exercises both the connection path and every shutdown path.
fn accept_loop(cfg: Config, srv: int, wid: int) -> int:
    served := 0
    running := true
    fails := 0                             # CONSECUTIVE failures; any Ok clears it
    for running:
        # `if conn < 0` became `Err(e)`. accept_loop returns the served count, not
        # a Result, so `or_return` is NOT available here (the compiler rejects it:
        # "or_return requires the enclosing function to return a Result, but it
        # returns int"). A match is the only tool, and it costs the same two
        # branches the sentinel test cost -- with the fd unreachable on failure.
        match net.accept_wait(srv, 100):
            Ok(conn):
                fails = 0
                # REGISTER FIRST, RETIRE BEFORE CLOSE. The signal handler shuts
                # down the listener, which releases accept(2) but does nothing
                # for a worker already parked in recv(2) on an accepted
                # connection -- that one waits out its whole SO_RCVTIMEO
                # (measured: 4733 ms at --idle-ms 5000). Publishing the fd lets
                # the handler shutdown() it too, which is what turns the
                # parked-idle case from one idle timeout into milliseconds.
                #
                # The slot is wid-1 because worker ids run 1..cfg.workers and the
                # registry is indexed from 0; cfg.workers is pinned to 1..256 at
                # server/main.ty@workers, which is exactly the table's width. One
                # slot per worker needs NO LOCK: this body is sequential, so
                # worker wid holds at most one connection at a time and is the
                # only writer of its own slot. A mutex here would be a handler
                # deadlock waiting to happen -- it is not async-signal-safe.
                #
                # A refusal is ignored on purpose: register_conn fails closed, and
                # an unregistered connection behaves exactly as it did before this
                # existed. Nothing to report and nothing to abort.
                slot := wid - 1
                reg := signal.register_conn(slot, conn)
                if not reg and not cfg.quiet:
                    eprint("w" + str(wid) + " warn: connection not registered for shutdown\n")
                armed := net.set_read_timeout_ms(conn, cfg.idle_ms)
                if not armed and not cfg.quiet:
                    eprint("w" + str(wid) + " warn: idle timeout not armed\n")
                served += serve_conn(cfg, conn, wid)
                # BEFORE close_fd, not after. A slot still naming a closed fd is a
                # number the kernel can hand back out to the next accept, and the
                # handler would then shutdown() a stranger's connection.
                signal.retire_conn(slot)
                net.close_fd(conn)
            Err(Timeout):
                running = not signal.shutdown_requested()
            Err(e):
                if signal.shutdown_requested():
                    running = false                # the listener was shut down
                else:
                    fails += 1
                    if fails >= MAX_ACCEPT_FAILS:
                        running = false            # not transient: give this one up
                        if not cfg.quiet:
                            eprint("w" + str(wid) + " warn: accept failed " + str(fails) + " times, retiring this loop\n")
                    else:
                        time.sleep_ms(ACCEPT_BACKOFF_MS)
    return served

# Worker k spawns worker k+1 into a frame-local, then runs its own accept loop;
# the last one just runs the loop. See the header note on affine task handles.
fn worker(cfg: Config, srv: int, wid: int, remaining: int) -> int:
    if remaining > 1:
        peer := spawn worker(cfg, srv, wid + 1, remaining - 1)
        n := accept_loop(cfg, srv, wid)
        return n + wait(peer)
    return accept_loop(cfg, srv, wid)

# ---- command line ----------------------------------------------------------

fn usage() -> string:
    return ("tycho-httpd -- a static web server written in Tycho\n\n"
            "usage: tycho-httpd [options]\n\n"
            "  --root DIR       directory to serve            (default: .)\n"
            "  --host ADDR      address to bind               (default: " + DEF_HOST + ")\n"
            "  --port N         port to bind, 0 = pick free   (default: " + str(DEF_PORT) + ")\n"
            "  --workers N      concurrent accept loops       (default: " + str(DEF_WORKERS) + ")\n"
            "  --idle-ms N      keep-alive idle timeout, ms   (default: " + str(DEF_IDLE_MS) + ")\n"
            "  --quiet, -q      do not log requests\n"
            "  --help, -h       this text\n\n"
            "Both spellings work: --port 8080 and --port=8080.\n")

fn as_uint(s: string, what: string) -> int:
    if not is_digits(s):
        die("tycho-httpd: " + what + " wants a non-negative integer, got: " + s + "\n")
    return strings.parse_int(s)

# Until the friction plan the 45 lines below were a hand-rolled parser -- opt_name,
# opt_inline, wants_value and a stepping loop -- because core:cli could only read
# an `=`-attached value and this server's interface is documented as accepting
# both spellings (usage(), last line). cli.parse_spec now carries the schema, so
# the only thing left here is the part that is genuinely this program's: which
# names exist, what their defaults are, and what counts as out of range.
fn parse_args(av: [string]) -> Config:
    # the whole schema: names that take a value, and names that are booleans.
    # Both without dashes, which is the spelling cli.get/cli.flag already take.
    valued := ["root", "host", "port", "workers", "idle-ms"]
    boolean := ["quiet", "q", "help", "h"]
    c := cli.parse_spec(av, valued, boolean)

    # --help wins over a bad flag beside it. The old loop was argv-ordered, so
    # `--bogus --help` exited 1 and `--help --bogus` exited 0; there is no order
    # information in a parsed Cli, and of the two invariants "--help always
    # answers" is the one worth keeping. `exit(0)` is the friction plan: before it,
    # die() was the only exit and always exited 1, so an answered --help had to
    # be threaded back to main as a `help: bool` field on Config.
    if cli.flag(c, "help") or cli.flag(c, "h"):
        print(usage())
        exit(0)
    bad := cli.unknown(c)
    if len(bad) > 0:
        die("tycho-httpd: unknown option: " + bad[0] + "\n\n" + usage())
    # this server takes no positional arguments, so one is as wrong as a typo,
    # and it keeps the message the hand-rolled loop produced for the same input.
    stray := cli.positionals(c)
    if len(stray) > 0:
        die("tycho-httpd: unknown option: " + stray[0] + "\n\n" + usage())
    nov := cli.missing(c)
    if len(nov) > 0:
        die("tycho-httpd: " + nov[0] + " needs a value\n\n" + usage())

    port := as_uint(cli.get(c, "port", str(DEF_PORT)), "--port")
    workers := as_uint(cli.get(c, "workers", str(DEF_WORKERS)), "--workers")
    idle := as_uint(cli.get(c, "idle-ms", str(DEF_IDLE_MS)), "--idle-ms")
    if port > 65535:
        die("tycho-httpd: --port must be 0..65535\n")
    if workers < 1 or workers > 256:
        die("tycho-httpd: --workers must be 1..256\n")
    if idle < 1:
        die("tycho-httpd: --idle-ms must be at least 1\n")
    return Config(path.clean(cli.get(c, "root", ".")), cli.get(c, "host", DEF_HOST),
                  port, workers, idle, cli.flag(c, "quiet") or cli.flag(c, "q"))

fn main():
    # cli.argv() is args() with the program path dropped (the friction plan).
    # This was a four-line copy loop, and the identical loop was in
    # examples/weblog/main.ty, because args() includes argv[0] and cli.parse
    # does not want it.
    cfg := parse_args(cli.argv())

    # --root sanity, asked as four separate questions. Until phase 5 this was one:
    #     if len(io.list(cfg.root)) == 0:  "... is empty or not a directory"
    # -- and the "or" in that message is the corelib admitting it could not tell.
    # An empty-but-perfectly-good document root, a plain file, a missing path and
    # an unreadable one all produced the same sentence, and three of them are
    # operator errors while the first is not. io.is_dir (phase 4) separates them:
    # Ok(true)/Ok(false) are both answers, Err says why there is none. Still a
    # WARNING and not a die()/exit(): serving an empty tree is legal -- every
    # request 404s honestly -- so a judgement call about someone else's directory
    # is not this program's to terminate on, whatever status it could now pick.
    match io.is_dir(cfg.root):
        Ok(isdir):
            if not isdir:
                eprint("tycho-httpd: warning: " + cfg.root + " is not a directory\n")
            elif len(io.list(cfg.root)) == 0:
                eprint("tycho-httpd: warning: " + cfg.root + " is an empty directory\n")
        Err(io.NotFound):
            eprint("tycho-httpd: warning: " + cfg.root + " does not exist\n")
        Err(e):
            eprint("tycho-httpd: warning: " + cfg.root + " cannot be read\n")

    # The value-match form, which is what a Result is for. Until the friction plan
    # this needed a dummy `srv := 0` and a statement match, because die() is typed
    # void and was not modelled as DIVERGING -- so the failure arm was rejected with
    # "a value if/match branch must produce a value, not void", and the Result
    # version came out one line LONGER than the `if srv < 0: die(...)` it replaced.
    srv := match net.listen(cfg.host, cfg.port):
        Ok(fd): fd
        Err(e): die("tycho-httpd: cannot bind " + cfg.host + ":" + str(cfg.port) + "\n")
    # -1 in the banner if unknowable.
    bound := result.unwrap_or(net.port_of(srv), -1)

    # SIGTERM/SIGINT -> shutdown(srv, SHUT_RDWR) -> every accept loop's next
    # net.accept returns Err -> accept_loop's Err arm (:493-494) sets
    # running = false -> worker() unwinds through wait(peer) -> the stopped line
    # at the bottom of this function. No new control flow: the wind-down arm was
    # already there and was simply unreachable, because nothing ever made accept
    # fail.
    #
    # HERE, and not elsewhere, for three reasons:
    #   * AFTER net.listen, because on_shutdown takes the listening fd. Before it
    #     there is no fd to register.
    #   * BEFORE the fan-out at the bottom of main. `worker(cfg, srv, 1, ...)` is
    #     a direct call, not a spawn -- worker k spawns k+1 and then runs accept
    #     loop k itself -- so main IS accept loop 1 and never returns here until
    #     the whole pool has wound down. Anything after that call is shutdown
    #     code, not startup code.
    #   * BEFORE the banner, which is the readiness signal server/run.sh polls
    #     for. Arming afterwards leaves a window in which a reader has been told
    #     "serving" while SIGTERM still has its default disposition, i.e. kills
    #     the process where it stands -- a race the gate would hit rarely and
    #     confusingly.
    # One arm for the whole pool: the handler is per-process, not per-thread, and
    # it acts on the shared listener, so which thread the kernel picks does not
    # matter. That property is why core:signal chose shutdown() over close() --
    # the signals plan.
    if not signal.on_shutdown(srv):
        eprint("tycho-httpd: warning: SIGTERM handler not installed;"
               + " shutdown will not be clean\n")

    banner := "tycho-httpd: serving " + cfg.root
    banner += " on http://" + cfg.host + ":" + str(bound) + "/"
    banner += "  workers=" + str(cfg.workers)
    banner += " idle=" + str(cfg.idle_ms) + "ms\n"
    eprint(banner)

    total := worker(cfg, srv, 1, cfg.workers)
    eprint("tycho-httpd: stopped after " + str(total) + " requests\n")
