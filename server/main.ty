package main

import "core:cli"
import "core:httpd"
import "core:net"
import "core:io"
import "core:result"
import "core:path"
import "core:url"
import "core:strings"
import "core:signal"
import "core:time"
import "core:datetime"

const VERSION     = "tycho-httpd/1.0"
const DEF_HOST    = "127.0.0.1"
const DEF_PORT    = 8080
const DEF_WORKERS = 8
const DEF_IDLE_MS = 5000
const DEF_HEAD_MS = 15000
# THE FIRST-BYTE DEADLINE: how long a peer that has said NOTHING may keep its
# connection. It is no longer a bound on worker occupancy -- accept_loop polls,
# so a silent peer costs a pollfd slot -- but it is still the only thing that
# retires a connection nobody will ever use, and it is still the ceiling on ONE
# stalled head read (head_budget). --idle-ms is the different, longer patience a
# peer earns by completing a request.
const DEF_FIRST_MS = 1000
# THE WHOLE-CONNECTION BUDGET. Written when a parked keep-alive peer held one of
# --workers accept loops for a whole --idle-ms and this was the only bound
# available without an event loop. That loop now exists, so this is NO LONGER
# what stops starvation -- it is a plain lifetime cap on one connection, and 0
# (off) is a supportable setting again rather than the pathological one. What
# still needs it: a peer that keeps a connection useful-looking indefinitely.
const DEF_CONN_MS = 30000
# The ceiling on one pass of the poll loop, so shutdown and the reaper are never
# more than this late. A pass with a nearer deadline waits only that long.
const POLL_TICK_MS = 100
# Connections one worker may hold. Past it the listener is dropped from that
# worker's poll set: the peer waits in the kernel backlog or goes to another
# worker, which is honest backpressure rather than an unbounded fd table.
const MAX_CONNS = 512
const MAX_HEAD    = 16384      # per-request byte budget; past this -> 431, connection closed
const MAX_REQS    = 1024       # requests served on one connection before we close it
const LOG_FIELD   = 160        # longest request target we will echo into a log line
const MAX_ACCEPT_FAILS = 100
const ACCEPT_BACKOFF_MS = 20   # between retries, so a hard failure is not a hot loop

struct Config:
    root: string
    host: string
    port: int
    workers: int
    idle_ms: int
    first_ms: int
    conn_ms: int
    quiet: bool

# One live connection a worker is holding. The two stopwatches are the model:
# `opened` bounds the connection, `last` bounds the silence since this peer last
# did anything. Neither is a blocking read now -- the reaper reads them on every
# pass, which is what stops an idle peer costing a worker. `armed` is what
# SO_RCVTIMEO currently holds, so re-arming is one syscall per CHANGE.
struct Conn:
    fd: int
    peer: string
    served: int
    opened: int
    last: int
    armed: int

# What a request target resolved to. `status` 200 means serve `file`; 301 means
# redirect to `location`; anything else is an error to render.
struct Route:
    status: int
    file: string
    location: string

# What a Range header resolved to against a known file length. THREE outcomes,
# not two, and conflating any pair of them is a wire-visible bug:
#
#   NONE   there is no usable range here -- no header, syntax this server does
#          not accept, or the multipart form. RFC 7233 2.1: "an origin server
#          MUST ignore a Range header field that contains a range unit it does
#          not understand", and an invalid byte-range-set is likewise ignored.
#          So this is a 200 with the WHOLE file, never an error.
#   OK     a satisfiable range. `start`..`end` are absolute byte offsets into
#          the file and BOTH ARE INCLUSIVE -- that is HTTP's convention, not
#          C's, so the length is end - start + 1 and the classic off-by-one is
#          reading end - start bytes.
#   UNSAT  syntactically fine, but no byte of it exists (first-byte-pos at or
#          past EOF, or a zero-length suffix). 416, with `Content-Range:
#          bytes */LEN`.
const RANGE_NONE  = 0
const RANGE_OK    = 1
const RANGE_UNSAT = 2

struct Rng:
    kind: int
    start: int
    end: int

# ---- small helpers ---------------------------------------------------------

fn is_ctl(c: int) -> bool:
    return c < 32 or c == 127

fn is_digits(s: string) -> bool:
    if len(s) == 0:
        return false
    for i := 0; i < len(s); i += 1:
        if s[i] < 48 or s[i] > 57:
            return false
    return true

fn http_date_at(secs: int) -> string:
    dt := datetime.from_unix(secs)
    out := datetime.weekday_name(dt.weekday) + ", " + datetime.pad2(dt.day)
    out += " " + datetime.month_name(dt.month) + " " + datetime.pad4(dt.year)
    out += " " + datetime.pad2(dt.hour) + ":" + datetime.pad2(dt.minute)
    return out + ":" + datetime.pad2(dt.second) + " GMT"

fn http_date() -> string:
    return http_date_at(now())

# Parse an IMF-fixdate to UNIX seconds, or -1 if it is not one. FAIL-CLOSED, and
# the failure direction is the whole point: -1 means the caller serves 200. A
# wrong parse that reads TOO EARLY costs a needless 200; one that reads too LATE
# hands a client a 304 for a file that changed. So every doubt returns -1.
#
# Only IMF-fixdate is accepted. RFC 7231 7.1.1.1 lists two obsolete forms an
# HTTP/1.1 recipient must also accept -- rfc850 ("Sunday, 06-Nov-94 08:49:37
# GMT") and asctime ("Sun Nov  6 08:49:37 1994"). They are NOT parsed here, and
# what that costs is exactly one needless 200 for a client that sends one: they
# fall out as -1, which is the safe direction. Every client that gets an
# If-Modified-Since from us is echoing back the Last-Modified we wrote, which is
# an IMF-fixdate by construction.
#
# The field scan is delegated: rearranging the fixed positions into the CLF shape
# `dd/Mon/yyyy:HH:MM:SS` lets datetime.parse_clf do the digits, the month name,
# and the range checks (it rejects a 13th month, a 31st of February, hour 24)
# rather than a second copy of that logic living here. What stays here is what
# CLF cannot see: the punctuation that makes this an IMF-fixdate and not
# something else, and the literal GMT.
fn parse_http_date(s: string) -> int:
    if len(s) != 29:
        return -1
    if s[3] != 44 or s[4] != 32 or s[7] != 32 or s[11] != 32:    # ',' ' ' ' ' ' '
        return -1
    if s[16] != 32 or s[25] != 32:                               # ' ' ' '
        return -1
    if s[26:29] != "GMT":                                        # UTC only, by spec
        return -1
    clf := s[5:7] + "/" + s[8:11] + "/" + s[12:16] + ":" + s[17:25]
    dt := datetime.parse_clf(clf)
    if not datetime.ok(dt):
        return -1
    return datetime.to_unix(dt)                                  # GMT, so no offset

# ---- Range ------------------------------------------------------------------

# `s` starts with `p`, comparing ASCII case-insensitively. `p` must be lowercase.
# Needed because a range UNIT is a token (RFC 7233 2.2) and tokens are compared
# case-insensitively -- `Range: BYTES=0-9` is the same request as `bytes=0-9`.
# httpd.header already folds the header NAME; this folds the value's first word.
fn ci_prefix(s: string, p: string) -> bool:
    if len(s) < len(p):
        return false
    for i := 0; i < len(p); i += 1:
        c := s[i]
        if c >= 65 and c <= 90:                # 'A'..'Z' -> lowercase
            c = c + 32
        if c != p[i]:
            return false
    return true

const HUGE_POS = 1000000000000000        # 1e15, > any real file, < 2^63

fn parse_pos(s: string) -> int:
    if not is_digits(s):
        return -1
    if len(s) > 15:
        return HUGE_POS
    return strings.parse_int(s)

fn parse_range(v: string, flen: int) -> Rng:
    if flen < 0:
        return Rng(RANGE_NONE, 0, 0)           # no length: cannot resolve one
    if not ci_prefix(v, "bytes="):
        return Rng(RANGE_NONE, 0, 0)           # absent, or a unit we do not know
    spec := v[6:len(v)]
    if find(spec, ",") >= 0:
        return Rng(RANGE_NONE, 0, 0)           # multipart, out of scope
    d := find(spec, "-")
    if d < 0:
        return Rng(RANGE_NONE, 0, 0)
    lhs := spec[0:d]
    rhs := spec[d + 1:len(spec)]
    if len(lhs) == 0:
        n := parse_pos(rhs)
        if n < 0:
            return Rng(RANGE_NONE, 0, 0)       # "bytes=-" and "bytes=-x"
        if n == 0 or flen == 0:
            return Rng(RANGE_UNSAT, 0, 0)      # nothing to give
        s := flen - n
        if s < 0:
            s = 0                              # a suffix longer than the file
        return Rng(RANGE_OK, s, flen - 1)
    a := parse_pos(lhs)
    if a < 0:
        return Rng(RANGE_NONE, 0, 0)
    if len(rhs) == 0:
        if a >= flen:
            return Rng(RANGE_UNSAT, 0, 0)      # also catches flen == 0
        return Rng(RANGE_OK, a, flen - 1)
    b := parse_pos(rhs)
    if b < 0:
        return Rng(RANGE_NONE, 0, 0)
    if b < a:
        return Rng(RANGE_NONE, 0, 0)           # invalid spec -> ignore the header
    if a >= flen:
        return Rng(RANGE_UNSAT, 0, 0)
    e := b
    if e > flen - 1:
        e = flen - 1                           # clamp, do NOT reject
    return Rng(RANGE_OK, a, e)

fn fmt_ms(us: int) -> string:
    frac := str(us % 1000)
    for len(frac) < 3:
        frac = "0" + frac
    return str(us / 1000) + "." + frac + "ms"

fn log_safe(s: string) -> string:
    n := len(s)
    cut := false
    if n > LOG_FIELD:
        n = LOG_FIELD
        cut = true
    b := to_bytes(s)
    scrubbed := to_bytes("")
    for i := 0; i < n; i += 1:
        if is_ctl(b[i]):
            scrubbed = scrubbed + '.'
        else:
            scrubbed = scrubbed + b[i:i + 1]
    out := to_str(scrubbed)
    if cut:
        out += "..."
    return out

# The request line of a raw buffer, for logging a request we could not parse.
fn first_line(raw: string) -> string:
    e := find(raw, "\n")
    if e >= 0:
        return log_safe(raw[0:e])
    return log_safe(raw)

# ---- content types ---------------------------------------------------------

fn ctype_for(p: string) -> string:
    if httpd.has_ext(p, ".ttf"):
        return "font/ttf"
    if httpd.has_ext(p, ".otf"):
        return "font/otf"
    if httpd.has_ext(p, ".map"):
        return "application/json"
    if httpd.has_ext(p, ".webmanifest"):
        return "application/manifest+json"
    if httpd.has_ext(p, ".md"):
        return "text/markdown; charset=utf-8"
    return httpd.content_type(p)

# ---- error pages -----------------------------------------------------------

fn explain(status: int) -> string:
    if status == 400:
        return "The request could not be parsed as HTTP."
    if status == 403:
        return "That path is not inside the document root."
    if status == 404:
        return "No file is published at that path."
    if status == 405:
        return "This server is read-only. Use GET or HEAD."
    if status == 408:
        return "The request was not completed before the idle timeout expired."
    if status == 416:
        return "The requested byte range lies outside this file."
    if status == 431:
        return "The request headers exceeded this server's limit."
    return "The server could not complete the request."

# The error page as ONE expression instead of twelve `s +=` statements: adjacent
# string literals join into a single literal at parse time, and (...) joins the
# physical lines. Every run of static markup below is therefore one interned
# literal, so only the five dynamic splices concatenate at run time.
fn error_body(status: int, reason: string) -> string:
    return ("<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\">\n"
            "<title>" + str(status) + " " + reason + "</title>\n"
            "<style>"
            "body{background:#181c30;color:#f0eee6;margin:0;min-height:100vh;"
            "display:grid;place-items:center;font:17px/1.6 ui-sans-serif,system-ui,sans-serif}"
            "main{max-width:32rem;padding:2rem;text-align:center}"
            "h1{font-size:3.5rem;margin:0;color:#7c5cf0;letter-spacing:-.03em}"
            "p{color:#a9a6bb}a{color:#7c5cf0}</style>\n</head>\n<body><main>\n"
            "<h1>" + str(status) + "</h1>\n<p><strong>" + reason + "</strong></p>\n"
            "<p>" + explain(status) + "</p>\n"
            "<p><a href=\"/\">back to the index</a></p>\n"
            "<p style=\"font-size:.8rem\">" + VERSION + "</p>\n"
            "</main></body></html>\n")

fn error_response(status: int) -> httpd.Response:
    reason := httpd.reason_phrase(status)
    r := httpd.response(status, to_bytes(error_body(status, reason)))
    r = httpd.with_header(r, "Content-Type", "text/html; charset=utf-8")
    if status == 405:
        r = httpd.with_header(r, "Allow", "GET, HEAD")
    return r

fn redirect_response(location: string) -> httpd.Response:
    body := to_bytes("<!doctype html><meta charset=\"utf-8\"><title>301</title>\n")
    r := httpd.response(301, body)
    r = httpd.with_header(r, "Content-Type", "text/html; charset=utf-8")
    return httpd.with_header(r, "Location", location)


fn hidden_segment(rel: string) -> bool:
    opening := true
    for i := 0; i < len(rel); i += 1:
        c := rel[i]
        if opening and c == 46:
            return true
        opening = c == 47
    return false

# The dotfile rule applied to the ANSWER rather than the request. It is a THIRD
# guard, not a restatement of the second: an in-root symlink named `x.txt` may
# resolve into `.hidden/` while the request never spelled a dot segment, and
# hidden_segment(rel) cannot see that. Silent when the answer is not under the
# resolved root -- deciding THAT is resolve_under's job, and a guard that also
# answers a question it was not asked is a guard nobody can reason about.
fn hidden_answer(root: string, fsp: string) -> bool:
    rroot := path.real(root)
    if rroot == "" or len(fsp) <= len(rroot) + 1:
        return false
    if fsp[0:len(rroot)] != rroot or fsp[len(rroot)] != 47:
        return false
    return hidden_segment(path.clean(fsp[len(rroot) + 1:len(fsp)]))

fn resolve(root: string, target: string) -> Route:
    p := target
    q := find(p, "?")
    if q >= 0:
        p = p[0:q]
    fr := find(p, "#")
    if fr >= 0:
        p = p[0:fr]
    if len(p) == 0 or p[0] != 47:
        return Route(400, "", "")                  # absolute-form or garbage
    dec := url.decode(p)
    for i := 0; i < len(dec); i += 1:
        if is_ctl(dec[i]):
            return Route(400, "", "")
    rel := dec[1:len(dec)]
    dir_form := len(rel) == 0 or rel[len(rel) - 1] == 47
    if dir_form:
        rel += "index.html"
    if hidden_segment(path.clean(rel)):
        return Route(403, "", "")
    # NOT safe_join: that is string math, and a symlink is invisible to it. A
    # link under --root pointing outside it passed every lexical test and this
    # server answered 200 with the outside file's bytes -- measured. resolve_under
    # applies the containment test to what the path RESOLVES to, and hands back
    # the resolved path so the read below opens what was checked.
    fsp := path.resolve_under(root, rel)
    if fsp == "":
        return Route(403, "", "")                  # absolute, escaping, or resolving outside root
    if hidden_answer(root, fsp):
        return Route(403, "", "")
    match io.is_dir(fsp):
        Ok(isdir):
            if not isdir:
                return Route(200, fsp, "")
            if dir_form:
                return Route(404, "", "")
            return Route(301, "", p + "/")         # /dir -> /dir/, index or not
        Err(e):
            return Route(404, "", "")

# ---- the connection loop ---------------------------------------------------

# httpd.write_response returns Result(int, net.NetErr) now, and emit is a tail
# call onto it -- so emit propagates the failure by returning the same type and
# spends ZERO lines on plumbing. No `or_return` is even needed here; matching
# error types make the sentinel check disappear entirely.
fn emit(conn: int, r: httpd.Response, head_only: bool, keep: bool) -> Result(int, net.NetErr):
    out := httpd.with_connection(r, keep)
    out = httpd.with_header(out, "Server", VERSION)
    out = httpd.with_header(out, "Date", http_date())
    # TWO THINGS SUPPRESS A BODY HERE AND THEY ARE NOT THE SAME THING, which is
    # why the guard is not redundant. HEAD suppresses the body while KEEPING the
    # Content-Length a GET would have reported -- that is the entire point of
    # HEAD, and the explicit header is what stops render_head recomputing it from
    # the now-empty body. A 304 suppresses the body AND the length, because there
    # is no representation being described (httpd.bodyless, and RFC 7230 3.3.2:
    # the only Content-Length a 304 may carry is the 200's, which the 304 path
    # deliberately never learns -- it does not open the file). Run the HEAD arm on
    # a 304 and it stamps `Content-Length: 0`, the one value that rule forbids.
    # A bodyless response has an empty body already, so there is nothing to strip.
    #
    # A HEAD CARRYING A RANGE is the third case and it needs NO third rule, which
    # is the point of stating it here. 206 is not bodyless, so this arm runs and
    # reports len(out.body) -- and out.body is the SLICE, because the 206 was
    # built with the slice as its body. So a HEAD with `Range: bytes=0-99` gets
    # 206, the Content-Range of the slice, `Content-Length: 100` and no bytes:
    # exactly the head its GET would have produced, which is what HEAD means.
    # The alternative -- skipping the pread on HEAD and setting the length by
    # arithmetic -- would be a second, unexercised way to compute the number this
    # server's whole Range feature turns on.
    if head_only and not httpd.bodyless(out.status):
        out = httpd.with_header(out, "Content-Length", str(len(out.body)))
        out = httpd.with_body(out, to_bytes(""))
    return httpd.write_response(conn, out)

fn log_req(cfg: Config, wid: int, peer: string, method: string, target: string, status: int, nbytes: int, wrote: int, us: int):
    if cfg.quiet:
        return
    n := nbytes
    tail := ""
    if wrote < 0:
        n = 0
        tail = " write-failed"
    ln := "w" + str(wid) + " " + peer + " " + log_safe(method) + " " + target + " "
    ln += str(status) + " " + str(n) + " " + fmt_ms(us) + tail + "\n"
    eprint(ln)

# Answer a request that could not be read, and log it. The three refusable read
# failures (400 Malformed, 408 Timeout, 431 TooLarge) differ only in status and
# body, so the wire-and-log tail lives here once instead of in each arm of
# serve_conn's cause match. `-` is the method: there is no parsed request to name
# one, and first_line(raw) is all the log can honestly report.
fn refuse(cfg: Config, wid: int, peer: string, conn: int, raw: string, st: int, r: httpd.Response, sw: int):
    n := result.unwrap_or(emit(conn, r, false, false), -1)
    log_req(cfg, wid, peer, "-", first_line(raw), st, len(r.body), n, time.elapsed_us(sw))

# How long ONE ready connection's head read may block this worker, and the only
# blocking read left in the server. A connection is read only when poll(2) has
# said it is readable, so this budget is spent solely by a peer that starts a
# head and stalls inside it -- the slowloris case --first-ms exists for.
fn head_budget(cfg: Config, c: Conn) -> int:
    hm := cfg.first_ms
    if c.served > 0:
        hm = DEF_HEAD_MS
    if cfg.conn_ms > 0:
        left := cfg.conn_ms - time.elapsed_ms(c.opened)
        if left < 1:
            left = 1
        if hm > left:
            hm = left
    return hm

# Milliseconds until this connection must be retired, <= 0 meaning now. This is
# the deadline enforcement that used to be a blocking read: --first-ms for a peer
# that has said nothing, --idle-ms for one that has been answered, and --conn-ms
# over the whole connection, whichever falls first. The reaper reads it on every
# pass of the poll loop, so an expiring peer costs a comparison, not a worker.
fn due_in(cfg: Config, c: Conn) -> int:
    want := cfg.first_ms
    if c.served > 0:
        want = cfg.idle_ms
    d := want - time.elapsed_ms(c.last)
    if cfg.conn_ms > 0:
        e := cfg.conn_ms - time.elapsed_ms(c.opened)
        if e < d:
            d = e
    return d

# Serve exactly ONE request on a connection poll(2) has just called readable.
# Returns (keep the connection, requests to count). This is the old serve_conn's
# loop body with the loop taken off it: the loop moved into accept_loop, where it
# is now a loop over READY descriptors rather than over one socket's lifetime.
fn serve_once(cfg: Config, conn: int, wid: int, peer: string, head_ms: int) -> (bool, int):
    # ONE corelib call does the read, the cap and the parse. `raw` is the second
    # tuple element, for the two jobs the Result cannot do: name a request that
    # would not parse in the access log, and answer "did this peer even start
    # talking" below.
    got, raw := httpd.read_request_deadline(conn, MAX_HEAD, head_ms)
    sw := time.start()
    match got:
        Err(httpd.Closed):
            return (false, 0)
        Err(httpd.Failed):
            return (false, 0)
        #   Timeout   the head read deadline expired. With bytes in `raw` a
        #             request was under way and stalled -- 408 is the honest
        #             answer. With `raw` empty the peer became readable and then
        #             said nothing, which no client is waiting on, so close
        #             quietly (nginx does the same).
        Err(httpd.Timeout):
            if len(raw) > 0:
                refuse(cfg, wid, peer, conn, raw, 408, error_response(408), sw)
                return (false, 1)
            return (false, 0)
        Err(httpd.TooLarge):
            refuse(cfg, wid, peer, conn, raw, 431, error_response(431), sw)
            return (false, 1)
        #   Malformed a complete head that is not HTTP -> 400.
        Err(httpd.Malformed):
            refuse(cfg, wid, peer, conn, raw, 400, error_response(400), sw)
            return (false, 1)
        Ok(req):
            keep := not httpd.connection_close(req)
            clh := httpd.header(req, "content-length")
            if clh != "" or httpd.header(req, "transfer-encoding") != "":
                keep = false
            teh := httpd.header(req, "transfer-encoding")
            # A SECOND LINE, deliberately kept though it is currently
            # unreachable: since the framing rewrite, corelib refuses all
            # three of these (`corelib/httpd/httpd.ty@framing`) and the read
            # comes back Err(Malformed), so the Ok(req) arm never sees one.
            # It stays because request smuggling is what it prevents and the
            # cost is three string tests on a path that already parsed a
            # head; if the corelib check is ever loosened this answers 400
            # rather than serving an ambiguously-framed request.
            bad_len := (clh != "" and not is_digits(clh)) or
                    httpd.content_length_conflict(req) or
                    (clh != "" and teh != "")
            head_only := req.method == "HEAD"
            target := log_safe(req.path)
            if bad_len:
                r := error_response(400)
                n := result.unwrap_or(emit(conn, r, false, false), -1)
                log_req(cfg, wid, peer, "-", first_line(raw), 400, len(r.body), n, time.elapsed_us(sw))
                return (false, 1)
            if req.method != "GET" and req.method != "HEAD":
                r := error_response(405)
                n := result.unwrap_or(emit(conn, r, false, keep), -1)
                log_req(cfg, wid, peer, req.method, target, 405, len(r.body), n, time.elapsed_us(sw))
                return (keep and n >= 0, 1)
            rt := resolve(cfg.root, req.path)
            st := rt.status
            r := error_response(st)
            if st == 200:
                lm := -1
                match io.mtime(rt.file):
                    Ok(secs):
                        lm = secs
                    Err(e):
                        lm = -1
                ims := -1
                if httpd.header(req, "if-modified-since") != "":
                    ims = parse_http_date(httpd.header(req, "if-modified-since"))
                if lm >= 0 and ims >= 0 and lm <= ims:
                    # The file is never opened on this path -- one stat(2)
                    # and no read -- so the hot 304 is CHEAPER than the
                    # serve it replaces, not an extra cost on top of it.
                    st = 304
                    r = httpd.response(304, to_bytes(""))
                    r = httpd.with_header(r, "Last-Modified", http_date_at(lm))
                    r = httpd.with_header(r, "Cache-Control", "no-cache")
                else:
                    flen := -1
                    match io.size(rt.file):
                        Ok(sz):
                            flen = sz
                        Err(e):
                            flen = -1
                    rg := parse_range(httpd.header(req, "range"), flen)
                    if rg.kind == RANGE_UNSAT:
                        # No byte of the requested range exists. The
                        # unsatisfied-range form of Content-Range names
                        # the length and nothing else, which is how the
                        # client learns what it should have asked for.
                        st = 416
                        r = error_response(416)
                        r = httpd.with_header(r, "Content-Range", "bytes */" + str(flen))
                        if lm >= 0:
                            r = httpd.with_header(r, "Last-Modified", http_date_at(lm))
                    elif rg.kind == RANGE_OK:
                        # end is INCLUSIVE, so the count is +1. Reading
                        # end - start is the off-by-one this comment
                        # exists to prevent, and it is one byte short of
                        # the Content-Range this same arm advertises.
                        match io.read_at(rt.file, rg.start, rg.end - rg.start + 1):
                            Ok(part):
                                if len(part) == 0:
                                    # The file shrank between io.size and
                                    # the pread. Not reachable from a
                                    # correct client, but the honest
                                    # answer is the one for "no such
                                    # bytes", not a 206 describing an
                                    # empty slice.
                                    st = 416
                                    r = error_response(416)
                                    r = httpd.with_header(r, "Content-Range", "bytes */" + str(flen))
                                else:
                                    # Content-Range reports what was
                                    # ACTUALLY read, not what was asked
                                    # for: a short read (the same shrink
                                    # race, partway) must not be
                                    # described as the full slice, or the
                                    # client stitches a hole into the file
                                    # it is reassembling.
                                    st = 206
                                    last := rg.start + len(part) - 1
                                    r = httpd.response(206, part)
                                    r = httpd.with_header(r, "Content-Type", ctype_for(rt.file))
                                    r = httpd.with_header(r, "Cache-Control", "no-cache")
                                    r = httpd.with_header(r, "Accept-Ranges", "bytes")
                                    r = httpd.with_header(r, "Content-Range",
                                                          "bytes " + str(rg.start) + "-" + str(last)
                                                          + "/" + str(flen))
                                    if lm >= 0:
                                        r = httpd.with_header(r, "Last-Modified", http_date_at(lm))
                            Err(e):
                                st = 404
                                r = error_response(404)
                    else:
                        match io.read_bytes(rt.file):
                            Ok(body):
                                r = httpd.response(200, body)
                                r = httpd.with_header(r, "Content-Type", ctype_for(rt.file))
                                r = httpd.with_header(r, "Cache-Control", "no-cache")
                                # ADVERTISED, and only on the two responses
                                # that describe this file's bytes. RFC 7233
                                # 2.3 says a server that supports ranges
                                # SHOULD send it, and the point is that a
                                # resuming client can see it WITHOUT
                                # spending a probe request to find out --
                                # which is the only way to learn otherwise.
                                # Not on 304: RFC 7232 4.1 lists what a 304
                                # should carry and this is not on it, and a
                                # 304 describes no representation. Not on an
                                # error page either -- the ranges of a
                                # generated 404 body are of no use to anyone.
                                r = httpd.with_header(r, "Accept-Ranges", "bytes")
                                if lm >= 0:
                                    r = httpd.with_header(r, "Last-Modified", http_date_at(lm))
                            Err(e):
                                st = 404
                                r = error_response(404)
            elif st == 301:
                r = redirect_response(rt.location)
            nb := len(r.body)
            if head_only:
                nb = 0
            n := result.unwrap_or(emit(conn, r, head_only, keep), -1)
            log_req(cfg, wid, peer, req.method, target, st, nb, n, time.elapsed_us(sw))
            return (keep and n >= 0, 1)          # n < 0: peer hung up mid-write

# ---- the worker pool -------------------------------------------------------

# ONE poll(2) over the listener AND every connection this worker holds, then work
# on whatever came back ready. That is the whole change, and the bound it buys is
# the point: a connection this worker is not reading costs a slot in a pollfd
# array, not a worker. Before this, each of --workers loops served exactly one
# connection at a time and K peers cost ceil(K / workers) rounds of whatever
# deadline applied -- measured at commit d48dc822 with K=64 against 4 workers: 64 silent
# sockets delayed a legitimate GET by 2080ms, and of 64 keep-alive peers only 4,
# exactly --workers, could be answered at all before the probe gave up.
fn accept_loop(cfg: Config, srv: int, wid: int) -> int:
    served := 0
    running := true
    fails := 0                             # CONSECUTIVE accept failures; any Ok clears it
    conns := []Conn
    for running:
        if signal.shutdown_requested():
            running = false
        else:
            # The poll set: the listener, then every live connection. The listener
            # is left OUT once this worker is full, which is the backpressure --
            # another worker, or the kernel backlog, holds the new peer instead.
            fds := []int
            if len(conns) < MAX_CONNS:
                push(fds, srv)
            # The tick is capped by the NEAREST deadline, so a reap is never late
            # by more than the loop's own resolution.
            tick := POLL_TICK_MS
            for i := 0; i < len(conns); i += 1:
                push(fds, conns[i].fd)
                d := due_in(cfg, conns[i])
                if d < tick:
                    tick = d
            if tick < 1:
                tick = 1
            ready := []int
            match net.wait_readable(fds, tick):
                Ok(r):
                    ready = r
                Err(Timeout):
                    ready = []int          # nothing to do; the reaper still runs
                Err(e):
                    if signal.shutdown_requested():
                        running = false
                    else:
                        fails += 1
                        if fails >= MAX_ACCEPT_FAILS:
                            running = false
                            if not cfg.quiet:
                                eprint("w" + str(wid) + " warn: poll failed " + str(fails) + " times, retiring this loop\n")
                        else:
                            time.sleep_ms(ACCEPT_BACKOFF_MS)
            # Only descriptors that were in `fds` can come back ready, so the walk
            # is bounded by the length conns had BEFORE any accept below appends
            # to it. `ready` is the subset of `fds` IN THE ORDER GIVEN, which is
            # what lets one forward cursor find each connection instead of a scan
            # per ready descriptor.
            nlive := len(conns)
            cur := 0
            for i := 0; i < len(ready); i += 1:
                if ready[i] == srv:
                    accepting := true
                    for accepting and len(conns) < MAX_CONNS:
                        match net.accept_wait(srv, 0):
                            Ok(cfd):
                                fails = 0
                                # Asked ONCE per connection: the peer of an
                                # accepted fd cannot change.
                                p := result.unwrap_or(net.peer_addr(cfd), "-")
                                at := time.start()
                                push(conns, Conn(cfd, p, 0, at, at, -1))
                            Err(Timeout):
                                accepting = false   # backlog drained, or another worker won the race
                            Err(e):
                                accepting = false
                                if signal.shutdown_requested():
                                    running = false
                                elif len(conns) > 0:
                                    # NOT counted, and this is new with the poll
                                    # loop. A worker holding connections is FULL
                                    # (EMFILE), not broken, and the old rule --
                                    # retire after MAX_ACCEPT_FAILS consecutive
                                    # failures -- would have retired every worker
                                    # in turn once the fd table filled. It still
                                    # applies to a worker holding nothing, which
                                    # is the case the EMFILE leg exercises.
                                    time.sleep_ms(ACCEPT_BACKOFF_MS)
                                else:
                                    fails += 1
                                    if fails >= MAX_ACCEPT_FAILS:
                                        running = false
                                        if not cfg.quiet:
                                            eprint("w" + str(wid) + " warn: accept failed " + str(fails) + " times, retiring this loop\n")
                                    else:
                                        time.sleep_ms(ACCEPT_BACKOFF_MS)
                else:
                    for cur < nlive and conns[cur].fd != ready[i]:
                        cur += 1
                    if cur < nlive:
                        hm := head_budget(cfg, conns[cur])
                        if hm != conns[cur].armed:
                            if not net.set_read_timeout_ms(conns[cur].fd, hm) and not cfg.quiet:
                                eprint("w" + str(wid) + " warn: read timeout not re-armed\n")
                            conns[cur].armed = hm
                        # Registered for the duration of the READ AND THE WRITE and
                        # no longer, because that is the only stretch a SIGTERM
                        # cannot otherwise interrupt: an idle connection is left in
                        # the poll set, and poll returns within `tick` on its own.
                        # One slot per worker, which is what keeps 256 slots enough
                        # for a worker holding hundreds of connections.
                        slot := wid - 1
                        if not signal.register_conn(slot, conns[cur].fd) and not cfg.quiet:
                            eprint("w" + str(wid) + " warn: connection not registered for shutdown\n")
                        alive, n := serve_once(cfg, conns[cur].fd, wid, conns[cur].peer, hm)
                        signal.retire_conn(slot)
                        served += n
                        conns[cur].served = conns[cur].served + n
                        conns[cur].last = time.start()
                        if not alive or conns[cur].served >= MAX_REQS:
                            net.close_fd(conns[cur].fd)
                            conns[cur].fd = -1     # tombstone; compacted below
                        cur += 1
            # Reap whatever ran out of time, then compact. Both deadlines are
            # enforced HERE now rather than by a blocking read, which is why an
            # expired peer no longer has to be holding a worker to be noticed.
            for i := 0; i < len(conns); i += 1:
                if conns[i].fd >= 0 and due_in(cfg, conns[i]) <= 0:
                    net.close_fd(conns[i].fd)
                    conns[i].fd = -1
            k := 0
            for k < len(conns):
                if conns[k].fd < 0:
                    last := len(conns) - 1
                    if k != last:
                        conns[k] = conns[last]
                    pop(conns)
                else:
                    k += 1
    # A retiring worker owes its peers a close; the fd would otherwise outlive
    # the loop that was answering on it.
    for i := 0; i < len(conns); i += 1:
        if conns[i].fd >= 0:
            net.close_fd(conns[i].fd)
    return served

fn workers(cfg: Config, srv: int, n: int) -> int:
    served := 0
    parallel(n) for wid in 0..<n:
        served = served + accept_loop(cfg, srv, wid + 1)
    return served

# ---- command line ----------------------------------------------------------

fn usage() -> string:
    return ("tycho-httpd -- a static web server written in Tycho\n\n"
            "usage: tycho-httpd [options]\n\n"
            "  --root DIR       directory to serve            (default: .)\n"
            "  --host ADDR      address to bind               (default: " + DEF_HOST + ")\n"
            "  --port N         port to bind, 0 = pick free   (default: " + str(DEF_PORT) + ")\n"
            "  --workers N      concurrent accept loops       (default: " + str(DEF_WORKERS) + ")\n"
            "  --idle-ms N      keep-alive idle timeout, ms   (default: " + str(DEF_IDLE_MS) + ")\n"
            "  --first-ms N     deadline for a peer that has\n"
            "                   sent nothing yet, ms          (default: " + str(DEF_FIRST_MS) + ")\n"
            "  --conn-ms N      total time one connection may\n"
            "                   hold a worker, ms, 0 = off    (default: " + str(DEF_CONN_MS) + ")\n"
            "  --quiet, -q      do not log requests\n"
            "  --help, -h       this text\n\n"
            "Both spellings work: --port 8080 and --port=8080.\n")

fn as_uint(s: string, what: string) -> int:
    if not is_digits(s):
        die("tycho-httpd: " + what + " wants a non-negative integer, got: " + s + "\n")
    return strings.parse_int(s)

fn parse_args(av: [string]) -> Config:
    # the whole schema: names that take a value, and names that are booleans.
    # Both without dashes, which is the spelling cli.get/cli.flag already take.
    valued := ["root", "host", "port", "workers", "idle-ms", "first-ms", "conn-ms"]
    boolean := ["quiet", "q", "help", "h"]
    c := cli.parse_spec(av, valued, boolean)

    if cli.flag(c, "help") or cli.flag(c, "h"):
        print(usage())
        exit(0)
    bad := cli.unknown(c)
    if len(bad) > 0:
        die("tycho-httpd: unknown option: " + bad[0] + "\n\n" + usage())
    # this server takes no positional arguments, so one is as wrong as a typo,
    # and it keeps the message the hand-rolled loop produced for the same input.
    stray := cli.positionals(c)
    if len(stray) > 0:
        die("tycho-httpd: unknown option: " + stray[0] + "\n\n" + usage())
    nov := cli.missing(c)
    if len(nov) > 0:
        die("tycho-httpd: " + nov[0] + " needs a value\n\n" + usage())

    port := as_uint(cli.get(c, "port", str(DEF_PORT)), "--port")
    workers := as_uint(cli.get(c, "workers", str(DEF_WORKERS)), "--workers")
    idle := as_uint(cli.get(c, "idle-ms", str(DEF_IDLE_MS)), "--idle-ms")
    first := as_uint(cli.get(c, "first-ms", str(DEF_FIRST_MS)), "--first-ms")
    conn := as_uint(cli.get(c, "conn-ms", str(DEF_CONN_MS)), "--conn-ms")
    if port > 65535:
        die("tycho-httpd: --port must be 0..65535\n")
    if workers < 1 or workers > 256:
        die("tycho-httpd: --workers must be 1..256\n")
    if idle < 1:
        die("tycho-httpd: --idle-ms must be at least 1\n")
    if first < 1:
        die("tycho-httpd: --first-ms must be at least 1\n")
    if conn > 0 and conn < first:
        die("tycho-httpd: --conn-ms must be 0 or at least --first-ms\n")
    return Config(path.clean(cli.get(c, "root", ".")), cli.get(c, "host", DEF_HOST),
                  port, workers, idle, first, conn,
                  cli.flag(c, "quiet") or cli.flag(c, "q"))

fn main():
    cfg := parse_args(cli.argv())

    match io.is_dir(cfg.root):
        Ok(isdir):
            if not isdir:
                eprint("tycho-httpd: warning: " + cfg.root + " is not a directory\n")
            elif len(io.list(cfg.root)) == 0:
                eprint("tycho-httpd: warning: " + cfg.root + " is an empty directory\n")
        Err(io.NotFound):
            eprint("tycho-httpd: warning: " + cfg.root + " does not exist\n")
        Err(e):
            eprint("tycho-httpd: warning: " + cfg.root + " cannot be read\n")

    srv := match net.listen(cfg.host, cfg.port):
        Ok(fd): fd
        Err(e): die("tycho-httpd: cannot bind " + cfg.host + ":" + str(cfg.port) + "\n")
    # -1 in the banner if unknowable.
    bound := result.unwrap_or(net.port_of(srv), -1)

    if not signal.on_shutdown(srv):
        eprint("tycho-httpd: warning: SIGTERM handler not installed;"
               + " shutdown will not be clean\n")

    banner := "tycho-httpd: serving " + cfg.root
    banner += " on http://" + cfg.host + ":" + str(bound) + "/"
    banner += "  workers=" + str(cfg.workers)
    banner += " idle=" + str(cfg.idle_ms) + "ms"
    banner += " first=" + str(cfg.first_ms) + "ms"
    banner += " conn=" + str(cfg.conn_ms) + "ms\n"
    eprint(banner)

    total := workers(cfg, srv, cfg.workers)
    eprint("tycho-httpd: stopped after " + str(total) + " requests\n")
