package graph

import "../stage"


# The pipeline, described. Copying one is copying the description; `with_cap`
# and `named` return modified copies rather than mutating, because value
# semantics is what a plan built in one scope and run in another needs.
struct Plan($T):
    name: string
    cap: int
    keep: fn($T) -> bool
    work: fn($T) -> $T
    check: fn($T) -> Result($T, string)

# `cap` starts at 4: small enough that the ring is a real constraint on the
# demo rather than a formality. `with_cap` is how a caller says otherwise.
fn plan(name: string, keep: fn($T) -> bool, work: fn($T) -> $T, check: fn($T) -> Result($T, string)) -> Plan($T):
    return Plan(name, 4, keep, work, check)

fn with_cap(p: Plan($T), cap: int) -> Plan($T):
    return Plan(p.name, cap, p.keep, p.work, p.check)

fn named(p: Plan($T), name: string) -> Plan($T):
    return Plan(name, p.cap, p.keep, p.work, p.check)

fn describe(p: Plan($T)) -> string:
    return p.name + ": filter then work, ring of " + str(p.cap)

fn cap_of(p: Plan($T)) -> int:
    return p.cap

# --- running a plan ----------------------------------------------------------

# The total path: one spawnable stage that filters and works in a single pool.
# Rejects never reach a worker's output, survivors keep their SOURCE index, so
# the answer is still reassembled by `collect` below and is still independent of
# the pool width.
#
# `ks := [p.keep]` for the same reason `stage.pool` writes `fs := [f]`: a
# function value in the callee position of a call inside a `parallel for` body
# is not collected into the chunk's capture set, and a struct field is the worst
# case of it (`p.keep(...)` emits a reference to an undeclared `h_p`). Indexing
# an array is the spelling that gets captured.
fn run(p: Plan($T), inp: Channel(stage.Item($T)), out: Channel(stage.Item($T))) -> int:
    ks := [p.keep]
    ws := [p.work]
    n := 0
    parallel for it in inp:
        if ks[0](it.val):
            send(out, stage.Item(it.idx, ws[0](it.val)))
            n = n + 1
    close(out)
    return n

# The fallible path: the same Plan, run with its `check` instead of its `work`,
# emitting `Result` items for `stage.guard` to watch. ONE worker on purpose --
# the pool would make WHICH error arrives first a race, and the whole point of
# reporting a cause is that the cause is reproducible. The filter still runs, so
# an element the plan rejects cannot fail the plan.
fn run_try(p: Plan($T), inp: Channel(stage.Item($T)), out: Channel(Result(stage.Item($T), stage.FlowErr))) -> int:
    n := 0
    for true:
        match recv(inp):
            Some(it):
                if p.keep(it.val):
                    match p.check(it.val):
                        Ok(v): send(out, Ok(stage.Item(it.idx, v)))
                        Err(why): send(out, Err(stage.Failed(p.name, it.idx, why)))
                    n = n + 1
            None:
                break
    close(out)
    return n

# Arrival order in, source order out, with the plan's name on any complaint.
# The link check first: `reorder` alone would report a lost element as a
# truncation, which names the symptom; `check_link` names the stage.
fn collect(p: Plan($T), got: [stage.Item($T)], made: int) -> Result([$T], stage.FlowErr):
    match stage.check_link(p.name, made, len(got)):
        Ok(): return stage.reorder(got, made)
        Err(e): return Err(e)
