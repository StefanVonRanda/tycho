package main
import "core:io"
import "core:path"
import "core:sort"
import "core:strings"

# tycho-docs: render a Markdown documentation tree to standalone HTML pages.
#
# Rule: one HTML page per `.md` file, same relative path with `.html`, plus a
# top-level index. The Markdown subset is the examples/site one — `# `/`## `/`### `
# headings (with id anchors), `- ` lists, `> ` quotes, `| ` tables, ``` fences,
# `---` rules, blank-separated paragraphs, inline `code`/`**bold**`/[links] —
# plus two docs-tree rules: `<!-- ... -->` marker lines are dropped, and a
# relative `X.md` link target becomes `X.html` so the tree browses as-is.

fn esc_html(s: string) -> string:            # &, <, > -> entities (& first)
    r := strings.replace(s, "&", "&amp;")
    r = strings.replace(r, "<", "&lt;")
    r = strings.replace(r, ">", "&gt;")
    return r

# GitHub-style heading slug: lowercase alphanumerics kept, space/-/_ become
# `-`, everything else dropped.
fn slug(s: string) -> string:
    out := ""
    for i := 0; i < len(s); i += 1:
        c := s[i]
        if c >= 97 and c <= 122:
            out = out + s[i:i+1]
        elif c >= 65 and c <= 90:
            out = out + chr(c + 32)
        elif c >= 48 and c <= 57:
            out = out + s[i:i+1]
        elif c == 32 or c == 45 or c == 95:   # space, '-', '_'
            out = out + "-"
    return out

# A relative `X.md` target becomes `X.html` (exact or `X.md#frag` form).
# Absolute URLs and same-page `#frag` links pass through untouched.
fn rewrite_link(u: string) -> string:
    if strings.starts_with(u, "http://"):
        return u
    if strings.starts_with(u, "https://"):
        return u
    if strings.starts_with(u, "mailto:"):
        return u
    if strings.starts_with(u, "#"):
        return u
    n := len(u)
    if n >= 3 and u[n-3:n] == ".md":
        return u[0:n-3] + ".html"
    i := 0
    for i + 3 < n:
        if u[i:i+3] == ".md" and u[i+3:i+4] == "#":
            return u[0:i] + ".html" + u[i+3:n]
        i = i + 1
    return u

# Split a table row on `|`, trimming cells; a leading or trailing pipe leaves
# an empty edge cell that is dropped.
fn split_cells(s: string) -> [string]:
    cells := []string
    cur := ""
    for i := 0; i < len(s); i += 1:
        if s[i] == 124:                        # '|'
            push(cells, strings.trim(cur))
            cur = ""
        else:
            cur = cur + s[i:i+1]
    push(cells, strings.trim(cur))
    lo := 0
    hi := len(cells)
    if hi > 0 and cells[0] == "":
        lo = 1
    if hi > lo and cells[hi-1] == "":
        hi = hi - 1
    out := []string
    for i := lo; i < hi; i += 1:
        push(out, cells[i])
    return out

# A separator row is only `-` and `:` per cell: `| --- | :--- |`.
fn is_sep(cells: [string]) -> bool:
    if len(cells) == 0:
        return false
    for i := 0; i < len(cells); i += 1:
        c := cells[i]
        if len(c) == 0:
            return false
        for j := 0; j < len(c); j += 1:
            if c[j] != 45 and c[j] != 58:      # '-' and ':'
                return false
    return true

# Inline spans over HTML-escaped text (escaping introduces no span
# characters, so scanning the escaped form is safe): `code`, **bold**,
# [text](url) with the docs-tree link rewrite. An unmatched opener is
# emitted literally. Span bodies recurse, so **[`code`](url)** renders all
# three layers.
fn render_inline(s: string) -> string:
    return render_spans(esc_html(s))

fn render_spans(e: string) -> string:
    out := ""
    i := 0
    for i < len(e):
        if e[i] == 96:                          # '`'
            j := i + 1
            for j < len(e) and e[j] != 96:
                j = j + 1
            if j < len(e):
                out = out + "<code>" + e[i+1:j] + "</code>"
                i = j + 1
            else:
                out = out + e[i:i+1]
                i = i + 1
        elif e[i] == 42 and i + 1 < len(e) and e[i+1] == 42:   # '**'
            k := i + 2
            found := 0 - 1
            for k + 1 < len(e):
                if e[k] == 42 and e[k+1] == 42:
                    found = k
                    break
                k = k + 1
            if found >= 0:
                out = out + "<strong>" + render_spans(e[i+2:found]) + "</strong>"
                i = found + 2
            else:
                out = out + e[i:i+1]
                i = i + 1
        elif e[i] == 91:                        # '['
            k := i + 1
            for k < len(e) and e[k] != 93:      # ']'
                k = k + 1
            if k < len(e) and k + 1 < len(e) and e[k+1] == 40:   # '('
                m := k + 2
                for m < len(e) and e[m] != 41:  # ')'
                    m = m + 1
                if m < len(e):
                    out = out + "<a href=\"" + rewrite_link(e[k+2:m]) + "\">" + render_spans(e[i+1:k]) + "</a>"
                    i = m + 1
                else:
                    out = out + e[i:i+1]
                    i = i + 1
            else:
                out = out + e[i:i+1]
                i = i + 1
        else:
            out = out + e[i:i+1]
            i = i + 1
    return out

# NOTE (inout): the chunk helpers below take plain parameters and RETURN
# their HTML; the caller appends it and resets state itself. Passing a
# loop-grown accumulator through `inout` to a callee that appends loses the
# callee's bytes while scalar write-backs survive — so no helper here takes
# `inout` on the output.
fn close_list_html(in_list: bool) -> string:
    if in_list:
        return "</ul>\n"
    return ""

fn flush_rows_html(rows: [string]) -> string:
    if len(rows) == 0:
        return ""
    head := split_cells(rows[0])
    out := "<table>\n"
    start := 0
    if len(rows) > 1:
        sep := split_cells(rows[1])
        if len(sep) == len(head) and is_sep(sep):
            start = 2
            out = out + "<tr>"
            for c := 0; c < len(head); c += 1:
                out = out + "<th>" + render_inline(head[c]) + "</th>"
            out = out + "</tr>\n"
    for r := start; r < len(rows); r += 1:
        cells := split_cells(rows[r])
        out = out + "<tr>"
        for c := 0; c < len(cells); c += 1:
            out = out + "<td>" + render_inline(cells[c]) + "</td>"
        out = out + "</tr>\n"
    return out + "</table>\n"

fn flush_quote_html(quote: [string]) -> string:
    if len(quote) == 0:
        return ""
    out := "<blockquote>\n"
    for i := 0; i < len(quote); i += 1:
        out = out + "<p>" + render_inline(quote[i]) + "</p>\n"
    return out + "</blockquote>\n"

fn render_md(body: string) -> string:
    out := ""
    in_list := false
    in_fence := false
    rows := []string
    quote := []string
    lines := strings.lines(body)
    for i := 0; i < len(lines); i += 1:
        t := strings.trim(lines[i])
        if in_fence:
            if strings.starts_with(t, "```"):
                out = out + "</code></pre>\n"
                in_fence = false
            else:
                out = out + esc_html(lines[i]) + "\n"
        elif strings.starts_with(t, "```"):
            out = out + close_list_html(in_list)
            in_list = false
            out = out + flush_rows_html(rows)
            rows = []string
            out = out + flush_quote_html(quote)
            quote = []string
            lang := strings.trim(t[3:len(t)])
            out = out + "<pre><code"
            if len(lang) > 0:
                out = out + " class=\"language-" + esc_html(lang) + "\""
            out = out + ">"
            in_fence = true
        elif strings.starts_with(t, "<!--"):
            out = out + close_list_html(in_list)
            in_list = false
            out = out + flush_rows_html(rows)
            rows = []string
            out = out + flush_quote_html(quote)
            quote = []string
        elif strings.starts_with(t, "|"):
            out = out + close_list_html(in_list)
            in_list = false
            out = out + flush_quote_html(quote)
            quote = []string
            push(rows, t)
        else:
            out = out + flush_rows_html(rows)
            rows = []string
            if len(t) == 0:
                out = out + close_list_html(in_list)
                in_list = false
            elif t == "---":
                out = out + close_list_html(in_list)
                in_list = false
                out = out + flush_quote_html(quote)
                quote = []string
                out = out + "<hr/>\n"
            elif strings.starts_with(t, "### "):
                out = out + close_list_html(in_list)
                in_list = false
                out = out + flush_quote_html(quote)
                quote = []string
                h := t[4:len(t)]
                out = out + "<h3 id=\"" + slug(h) + "\">" + render_inline(h) + "</h3>\n"
            elif strings.starts_with(t, "## "):
                out = out + close_list_html(in_list)
                in_list = false
                out = out + flush_quote_html(quote)
                quote = []string
                h := t[3:len(t)]
                out = out + "<h2 id=\"" + slug(h) + "\">" + render_inline(h) + "</h2>\n"
            elif strings.starts_with(t, "# "):
                out = out + close_list_html(in_list)
                in_list = false
                out = out + flush_quote_html(quote)
                quote = []string
                h := t[2:len(t)]
                out = out + "<h1 id=\"" + slug(h) + "\">" + render_inline(h) + "</h1>\n"
            elif strings.starts_with(t, "> "):
                out = out + close_list_html(in_list)
                in_list = false
                push(quote, strings.trim(t[2:len(t)]))
            elif strings.starts_with(t, "- "):
                out = out + flush_quote_html(quote)
                quote = []string
                if in_list == false:
                    out = out + "<ul>\n"
                    in_list = true
                out = out + "<li>" + render_inline(t[2:len(t)]) + "</li>\n"
            else:
                out = out + close_list_html(in_list)
                in_list = false
                out = out + flush_quote_html(quote)
                quote = []string
                out = out + "<p>" + render_inline(t) + "</p>\n"
    out = out + close_list_html(in_list)
    out = out + flush_rows_html(rows)
    out = out + flush_quote_html(quote)
    if in_fence:
        out = out + "</code></pre>\n"
    return out

fn page_css() -> string:
    return ":root{--paper:#000000;--ink:#ffffff;--ink-soft:#e6e6e6;--dim:#b3b3b3;--faint:#a6a6a6;--line:#808080;--code-bg:#0d0d0d;--code-fg:#f5f5f5;--code-dim:#a3a3a3;--code-line:#616161;--acc:#ffffff;--acc-code:#ffffff;--acc-on:#000000}:root[data-theme=\"light\"]{--paper:#ffffff;--ink:#000000;--ink-soft:#222222;--dim:#4d4d4d;--faint:#595959;--line:#767676;--code-bg:#0d0d0d;--code-fg:#f5f5f5;--code-dim:#a3a3a3;--code-line:#616161;--acc:#000000;--acc-code:#ffffff;--acc-on:#ffffff}*{box-sizing:border-box}body{margin:0 auto;max-width:44rem;padding:24px 20px 64px;background:var(--paper);color:var(--ink-soft);font-family:\"Space Grotesk\",system-ui,-apple-system,\"Segoe UI\",Roboto,sans-serif;font-size:17px;line-height:1.7}a{color:inherit;text-decoration:none}::selection{background:var(--acc);color:var(--acc-on)}.skip{position:absolute;left:12px;top:-56px;z-index:100;background:var(--ink);color:var(--paper);padding:12px 20px;font-size:14px;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}.skip:focus{top:8px}a:focus-visible,input:focus-visible{outline:2px solid var(--acc);outline-offset:3px}h1,h2,h3{font-family:\"Fraunces\",Georgia,\"Times New Roman\",serif;font-weight:600;color:var(--ink);line-height:1.15;letter-spacing:0}h1{font-size:34px;margin:0 0 24px}h2{font-size:26px;margin:40px 0 16px}h3{font-size:20px;margin:32px 0 12px}p{margin:0 0 16px}p a,li a,td a,blockquote a{color:var(--ink);text-decoration:underline;text-underline-offset:3px}strong{color:var(--ink)}pre,code{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}pre{background:var(--code-bg);color:var(--code-fg);border:1px solid var(--code-line);border-radius:8px;padding:20px 24px;overflow-x:auto;font-size:13px;line-height:1.8}code{font-size:.9em;color:var(--ink)}table{border-collapse:collapse;margin:24px 0}th,td{border:1px solid var(--line);padding:8px 12px;text-align:left}th{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--dim)}td{font-size:14.5px}blockquote{border-left:2px solid var(--ink);margin:24px 0;padding:4px 0 4px 16px;color:var(--dim)}hr{border:0;border-top:1px solid var(--line);margin:32px 0}nav.crumb{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;color:var(--faint);margin-bottom:24px}nav.crumb a{color:var(--dim)}nav.crumb a:hover{color:var(--ink)}.masthead{position:sticky;top:0;z-index:50;background:var(--paper);border-bottom:1px solid var(--line)}.masthead .in{padding:12px 0;display:flex;align-items:center;gap:16px}.wordmark{display:flex;align-items:center;gap:8px;color:var(--ink);font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:14px;font-weight:700;letter-spacing:.12em}.wordmark svg{width:18px;height:18px}.masthead nav{display:flex;gap:4px;margin-left:auto}.masthead nav a{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--dim);padding:8px 12px}.masthead nav a:hover{color:var(--ink)}.search{margin:0 0 8px;max-width:34em}#q{font:inherit;width:100%;padding:12px;border:1px solid var(--line);border-radius:8px;background:var(--paper);color:var(--ink)}#q::placeholder{color:var(--faint)}#r{margin:12px 0 0}#r .n{font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--faint);margin:0 0 4px}#r a.r{display:flex;align-items:baseline;gap:12px;padding:10px 4px;border-bottom:1px solid var(--line);color:var(--dim)}#r a.r:first-of-type{border-top:1px solid var(--line)}#r a.r:hover{color:var(--ink)}#r a.r .t{color:var(--ink)}#r a.r .arr{margin-left:auto;color:var(--faint)}#r .none{color:var(--faint);font-size:14px;padding:12px 4px}ul.pages{list-style:none;margin:32px 0 0;padding:0}ul.pages li{padding:12px 4px;border-top:1px solid var(--line);color:var(--dim)}ul.pages li:first-child{border-top:0}ul.pages li a{color:var(--ink);text-decoration:underline;text-underline-offset:3px}footer{margin-top:64px;padding:40px 0;text-align:center;border-top:1px solid var(--line);font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;font-size:12px;color:var(--dim)}.fbrand{display:flex;align-items:center;justify-content:center;gap:8px;color:var(--ink);font-weight:700;font-size:14px;letter-spacing:.12em;margin-bottom:12px}.fbrand svg{width:18px;height:18px}.tagline{color:var(--faint);font-size:14px}"
fn up_prefix(rel: string) -> string:
    up := ""
    for i := 0; i < len(rel); i += 1:
        if rel[i:i+1] == "/":
            up = up + "../"
    return up

fn page_html(title: string, home: string, crumb: string, content: string) -> string:
    h := "<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>" + esc_html(title) + " — Tycho docs</title>\n<script>(function(){try{var d=document.documentElement;var e=localStorage.getItem('tycho-theme');d.dataset.theme=e||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');}catch(e){}})();</script>\n<style>" + page_css() + "</style>\n</head>\n<body>\n<a class=\"skip\" href=\"#main\">Skip to content</a>\n<div class=\"masthead\"><div class=\"in\"><a class=\"wordmark\" href=\"" + home + "\"><svg viewBox=\"0 0 200 200\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"14\" aria-hidden=\"true\"><circle cx=\"100\" cy=\"100\" r=\"40\"/><circle cx=\"100\" cy=\"100\" r=\"8\" fill=\"currentColor\" stroke=\"none\"/></svg><span>TYCHO</span></a><nav aria-label=\"Docs\"><a href=\"" + home + "\">Docs</a><a href=\"https://github.com/StefanVonRanda/tycho\">GitHub</a></nav></div></div>\n<main id=\"main\">\n<nav class=\"crumb\"><a href=\"" + home + "\">docs</a> / " + crumb + "</nav>\n"
    return h + content + "</main>\n<footer><div class=\"fbrand\"><svg viewBox=\"0 0 200 200\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"14\" aria-hidden=\"true\"><circle cx=\"100\" cy=\"100\" r=\"40\"/><circle cx=\"100\" cy=\"100\" r=\"8\" fill=\"currentColor\" stroke=\"none\"/></svg><span>TYCHO</span></div><p class=\"tagline\">Generated from the repo — pre-1.0, subject to change.</p></footer>\n</body>\n</html>\n"

# The page title is the first `# ` heading; empty when the file has none.
fn title_of(text: string) -> string:
    lines := strings.lines(text)
    for i := 0; i < len(lines); i += 1:
        t := strings.trim(lines[i])
        if strings.starts_with(t, "# "):
            return t[2:len(t)]
    return ""

# Collect every `.md` file under dir, as paths relative to base, sorted.
fn collect(dir: string, base: string, acc: [string]) -> [string]:
    got := acc
    names := io.list(dir)
    for i := 0; i < len(names); i += 1:
        p := path.join(dir, names[i])
        match io.is_dir(p):
            Ok(v):
                if v:
                    got = collect(p, base, got)
                else:
                    if path.ext(names[i]) == ".md":
                        rel := p[len(base)+1:len(p)]
                        push(got, rel)
            Err(_):
                println("tycho-docs: cannot stat " + p)
    return got

fn dir_of(rel: string) -> string:
    d := ""
    for i := 0; i < len(rel); i += 1:
        if rel[i:i+1] == "/":
            d = rel[0:i]
    return d

fn parent_of(d: string) -> string:
    s := d
    for len(s) > 0 and s[len(s)-1:len(s)] == "/":
        s = s[0:len(s)-1]
    p := ""
    for i := 0; i < len(s); i += 1:
        if s[i:i+1] == "/":
            p = s[0:i]
    if len(p) > 0:
        return p
    return "."

# Index of sub in s at or after from, or -1.
fn find_from(s: string, sub: string, from: int) -> int:
    i := from
    for i + len(sub) <= len(s):
        if s[i:i+len(sub)] == sub:
            return i
        i = i + 1
    return 0 - 1

# Drop a <style>...</style> block so CSS never lands in the search index.
fn strip_style(s: string) -> string:
    out := ""
    i := 0
    for i < len(s):
        if i + 7 <= len(s) and s[i:i+7] == "<style>":
            j := find_from(s, "</style>", i + 7)
            if j >= 0:
                i = j + 8
            else:
                i = len(s)
        else:
            out = out + s[i:i+1]
            i = i + 1
    return out

# Drop <...> tags for the search index. Quotes survive; the caller
# JSON-escapes afterwards.
fn strip_tags(s: string) -> string:
    out := ""
    i := 0
    for i < len(s):
        if s[i] == 60:                          # '<'
            j := find_from(s, ">", i + 1)
            if j >= 0:
                i = j + 1
            else:
                out = out + s[i:i+1]
                i = i + 1
        else:
            out = out + s[i:i+1]
            i = i + 1
    return out

# JSON string escaping for the search index.
fn json_esc(s: string) -> string:
    out := ""
    for i := 0; i < len(s); i += 1:
        c := s[i]
        if c == 34:                             # '"'
            out = out + "\\\""
        elif c == 92:                           # backslash
            out = out + "\\\\"
        elif c == 10:                           # newline
            out = out + "\\n"
        elif c == 13:
            out = out + ""
        elif c == 9:
            out = out + " "
        else:
            out = out + s[i:i+1]
    return out

fn search_script() -> string:
    return "<script>(function(){var box=document.getElementById('q'),res=document.getElementById('r'),idx=null;var root=(document.querySelector('nav.crumb a')||{getAttribute:function(){return 'index.html';}}).getAttribute('href').replace(/index.html$/,'');fetch(root+'search.json').then(function(r){return r.json();}).then(function(j){idx=j;});box.addEventListener('input',function(){var q=box.value.toLowerCase().trim(),out='',n=0,i,e;if(idx&&q.length>1){for(i=0;i<idx.length&&n<20;i++){e=idx[i];if(e.t.toLowerCase().indexOf(q)>=0||e.x.toLowerCase().indexOf(q)>=0){out+='<a class=\"r\" href=\"'+root+e.u+'\"><span class=\"t\">'+e.t+'</span><span class=\"arr\">&rarr;</span></a>';n++;}}out=(n>0?'<div class=\"n\">'+n+' match'+(n===1?'':'es')+'</div>':'<div class=\"none\">No matches.</div>')+out;}res.innerHTML=out;});})();</script>"

fn group_of(d: string) -> string:
    if len(d) == 0:
        return "Guide"
    if d == "reference":
        return "Reference"
    if d == "spec":
        return "Specification"
    return "Maintainer records"

fn build(docs_dir: string, out_dir: string):
    match io.make_dir_all(out_dir):
        Ok(_):
            pass
        Err(e):
            println("tycho-docs: cannot mkdir " + out_dir)
            return
    got := collect(docs_dir, docs_dir, []string)
    files := sort.asc(got)
    rels := []string
    outs := []string
    titles := []string
    groups := []string
    search := "["
    first_entry := true
    n := 0
    idx := ""
    for i := 0; i < len(files); i += 1:
        rel := files[i]
        text := io.read(path.join(docs_dir, rel))
        title := title_of(text)
        if len(title) == 0:
            title = rel
        html_rel := rel[0:len(rel)-3] + ".html"
        home := up_prefix(rel) + "index.html"
        d := dir_of(rel)
        if len(d) > 0:
            match io.make_dir_all(path.join(out_dir, d)):
                Ok(_):
                    pass
                Err(e):
                    println("tycho-docs: cannot mkdir " + d)
        crumb := esc_html(rel)
        html := page_html(title, home, crumb, render_md(text))
        if io.write(path.join(out_dir, html_rel), html):
            n = n + 1
        push(rels, rel)
        push(outs, html_rel)
        push(titles, title)
        push(groups, group_of(d))
        x := strip_tags(strip_style(html))
        if len(x) > 20000:
            x = x[0:20000]
        if first_entry:
            first_entry = false
        else:
            search = search + ","
        search = search + "{\"u\":\"" + html_rel + "\",\"t\":\"" + json_esc(esc_html(title)) + "\",\"x\":\"" + json_esc(x) + "\"}"
        if rel == "README.md":
            io.write(path.join(out_dir, "index.html"), page_html(title, "index.html", crumb, render_md(text)))
        else:
            if path.base(html_rel) == "README.html":
                io.write(path.join(out_dir, dir_of(html_rel) + "/index.html"), html)
    root := parent_of(docs_dir)
    xnames := ["CHANGELOG.md", "RELEASE_NOTES.md"]
    xouts := ["changelog.html", "release-notes.html"]
    xtitles := ["Changelog", "Release notes"]
    for i := 0; i < 2; i += 1:
        text := io.read(path.join(root, xnames[i]))
        title := xtitles[i]
        body := render_md(text)
        html := page_html(title, "index.html", esc_html(xnames[i]), body)
        if io.write(path.join(out_dir, xouts[i]), html):
            n = n + 1
        push(rels, xnames[i])
        push(outs, xouts[i])
        push(titles, title)
        push(groups, "Project")
        x := strip_tags(strip_style(html))
        if len(x) > 20000:
            x = x[0:20000]
        search = search + ",{\"u\":\"" + xouts[i] + "\",\"t\":\"" + json_esc(esc_html(title)) + "\",\"x\":\"" + json_esc(x) + "\"}"
    io.write(path.join(out_dir, "search.json"), search + "]")
    idx = "<h1>Tycho documentation</h1>\n<p>" + str(len(rels)) + " pages, generated from the docs tree. Maintainer records are written for maintainers; start with the Guide.</p>\n"
    idx = idx + "<div class=\"search\"><input id=\"q\" type=\"text\" placeholder=\"Search the docs\" aria-label=\"Search the docs\" autocomplete=\"off\"/><div id=\"r\" aria-live=\"polite\"></div></div>\n"
    order := ["Guide", "Reference", "Specification", "Maintainer records", "Project"]
    for g := 0; g < len(order); g += 1:
        shown := false
        for i := 0; i < len(rels); i += 1:
            if groups[i] == order[g]:
                if shown == false:
                    idx = idx + "<h2>" + order[g] + "</h2>\n<ul class=\"pages\">\n"
                    shown = true
                idx = idx + "<li><a href=\"" + outs[i] + "\">" + esc_html(titles[i]) + "</a></li>\n"
        if shown:
            idx = idx + "</ul>\n"
    idx = idx + search_script()
    io.write(path.join(out_dir, "index.html"), page_html("Tycho documentation", "index.html", "index", idx))
    println("docs-site: " + str(n) + " pages from " + docs_dir)
    println("index: index.html (" + str(len(rels)) + " links)")

fn main():
    a := args()
    if len(a) < 3:
        println("usage: docs-site <docs_dir> <out_dir>")
    else:
        build(a[1], a[2])
