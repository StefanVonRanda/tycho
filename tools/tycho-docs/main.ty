package main
import "core:io"
import "core:path"
import "core:sort"
import "core:strings"

# tycho-docs: render a Markdown documentation tree to standalone HTML pages.
#
# Rule: one HTML page per `.md` file, same relative path with `.html`, plus a
# top-level index. The Markdown subset is the examples/site one — `# `/`## `/`### `
# headings (with id anchors), `- ` lists, `> ` quotes, `| ` tables, ``` fences,
# `---` rules, blank-separated paragraphs, inline `code`/`**bold**`/[links] —
# plus two docs-tree rules: `<!-- ... -->` marker lines are dropped, and a
# relative `X.md` link target becomes `X.html` so the tree browses as-is.

fn esc_html(s: string) -> string:            # &, <, > -> entities (& first)
    r := strings.replace(s, "&", "&amp;")
    r = strings.replace(r, "<", "&lt;")
    r = strings.replace(r, ">", "&gt;")
    return r

# GitHub-style heading slug: lowercase alphanumerics kept, space/-/_ become
# `-`, everything else dropped.
fn slug(s: string) -> string:
    out := ""
    for i := 0; i < len(s); i += 1:
        c := s[i]
        if c >= 97 and c <= 122:
            out = out + char_at(s, i)
        elif c >= 65 and c <= 90:
            out = out + chr(c + 32)
        elif c >= 48 and c <= 57:
            out = out + char_at(s, i)
        elif c == 32 or c == 45 or c == 95:   # space, '-', '_'
            out = out + "-"
    return out

# A relative `X.md` target becomes `X.html` (exact or `X.md#frag` form).
# Absolute URLs and same-page `#frag` links pass through untouched.
fn rewrite_link(u: string) -> string:
    if strings.starts_with(u, "http://"):
        return u
    if strings.starts_with(u, "https://"):
        return u
    if strings.starts_with(u, "mailto:"):
        return u
    if strings.starts_with(u, "#"):
        return u
    n := len(u)
    if n >= 3 and u[n-3:n] == ".md":
        return u[0:n-3] + ".html"
    i := 0
    for i + 3 < n:
        if u[i:i+3] == ".md" and u[i+3:i+4] == "#":
            return u[0:i] + ".html" + u[i+3:n]
        i = i + 1
    return u

# Split a table row on `|`, trimming cells; a leading or trailing pipe leaves
# an empty edge cell that is dropped.
fn split_cells(s: string) -> [string]:
    cells := []string
    cur := ""
    for i := 0; i < len(s); i += 1:
        if s[i] == 124:                        # '|'
            push(cells, strings.trim(cur))
            cur = ""
        else:
            cur = cur + char_at(s, i)
    push(cells, strings.trim(cur))
    lo := 0
    hi := len(cells)
    if hi > 0 and cells[0] == "":
        lo = 1
    if hi > lo and cells[hi-1] == "":
        hi = hi - 1
    out := []string
    for i := lo; i < hi; i += 1:
        push(out, cells[i])
    return out

# A separator row is only `-` and `:` per cell: `| --- | :--- |`.
fn is_sep(cells: [string]) -> bool:
    if len(cells) == 0:
        return false
    for i := 0; i < len(cells); i += 1:
        c := cells[i]
        if len(c) == 0:
            return false
        for j := 0; j < len(c); j += 1:
            if c[j] != 45 and c[j] != 58:      # '-' and ':'
                return false
    return true

# Inline spans over HTML-escaped text (escaping introduces no span
# characters, so scanning the escaped form is safe): `code`, **bold**,
# [text](url) with the docs-tree link rewrite. An unmatched opener is
# emitted literally. Span bodies recurse, so **[`code`](url)** renders all
# three layers.
fn render_inline(s: string) -> string:
    return render_spans(esc_html(s))

fn render_spans(e: string) -> string:
    out := ""
    i := 0
    for i < len(e):
        if e[i] == 96:                          # '`'
            j := i + 1
            for j < len(e) and e[j] != 96:
                j = j + 1
            if j < len(e):
                out = out + "<code>" + e[i+1:j] + "</code>"
                i = j + 1
            else:
                out = out + char_at(e, i)
                i = i + 1
        elif e[i] == 42 and i + 1 < len(e) and e[i+1] == 42:   # '**'
            k := i + 2
            found := 0 - 1
            for k + 1 < len(e):
                if e[k] == 42 and e[k+1] == 42:
                    found = k
                    break
                k = k + 1
            if found >= 0:
                out = out + "<strong>" + render_spans(e[i+2:found]) + "</strong>"
                i = found + 2
            else:
                out = out + char_at(e, i)
                i = i + 1
        elif e[i] == 91:                        # '['
            k := i + 1
            for k < len(e) and e[k] != 93:      # ']'
                k = k + 1
            if k < len(e) and k + 1 < len(e) and e[k+1] == 40:   # '('
                m := k + 2
                for m < len(e) and e[m] != 41:  # ')'
                    m = m + 1
                if m < len(e):
                    out = out + "<a href=\"" + rewrite_link(e[k+2:m]) + "\">" + render_spans(e[i+1:k]) + "</a>"
                    i = m + 1
                else:
                    out = out + char_at(e, i)
                    i = i + 1
            else:
                out = out + char_at(e, i)
                i = i + 1
        else:
            out = out + char_at(e, i)
            i = i + 1
    return out

# NOTE (inout): the chunk helpers below take plain parameters and RETURN
# their HTML; the caller appends it and resets state itself. Passing a
# loop-grown accumulator through `inout` to a callee that appends loses the
# callee's bytes while scalar write-backs survive — so no helper here takes
# `inout` on the output.
fn close_list_html(tag: string, item: string) -> string:
    if len(tag) > 0:
        return "<li>" + render_inline(item) + "</li>\n</" + tag + ">\n"
    return ""

# Return the length of a bullet or numeric-list marker, or zero.
fn list_prefix(t: string) -> int:
    if strings.starts_with(t, "- ") or strings.starts_with(t, "* ") or strings.starts_with(t, "+ "):
        return 2
    i := 0
    for i < len(t) and t[i] >= 48 and t[i] <= 57:
        i += 1
    if i > 0 and (t[i:i+2] == ". " or t[i:i+2] == ") "):
        return i + 2
    return 0

fn flush_rows_html(rows: [string]) -> string:
    if len(rows) == 0:
        return ""
    head := split_cells(rows[0])
    out := "<table>\n"
    start := 0
    if len(rows) > 1:
        sep := split_cells(rows[1])
        if len(sep) == len(head) and is_sep(sep):
            start = 2
            out = out + "<tr>"
            for c := 0; c < len(head); c += 1:
                out = out + "<th>" + render_inline(head[c]) + "</th>"
            out = out + "</tr>\n"
    for r := start; r < len(rows); r += 1:
        cells := split_cells(rows[r])
        out = out + "<tr>"
        for c := 0; c < len(cells); c += 1:
            out = out + "<td>" + render_inline(cells[c]) + "</td>"
        out = out + "</tr>\n"
    return out + "</table>\n"

fn flush_quote_html(quote: [string]) -> string:
    if len(quote) == 0:
        return ""
    out := "<blockquote>\n"
    paragraph := ""
    for i := 0; i < len(quote); i += 1:
        if len(quote[i]) == 0:
            if len(paragraph) > 0:
                out = out + "<p>" + render_inline(paragraph) + "</p>\n"
                paragraph = ""
        else:
            if len(paragraph) > 0:
                paragraph = paragraph + " "
            paragraph = paragraph + quote[i]
    if len(paragraph) > 0:
        out = out + "<p>" + render_inline(paragraph) + "</p>\n"
    return out + "</blockquote>\n"

fn render_md(body: string) -> string:
    out := ""
    list_tag := ""
    list_item := ""
    in_fence := false
    rows := []string
    quote := []string
    paragraph := ""
    lines := strings.lines(body)
    for i := 0; i < len(lines); i += 1:
        t := strings.trim(lines[i])
        if in_fence:
            if strings.starts_with(t, "```"):
                out = out + "</code></pre>\n"
                in_fence = false
            else:
                out = out + esc_html(lines[i]) + "\n"
            continue
        marker := list_prefix(t)
        fence := strings.starts_with(t, "```")
        heading := strings.starts_with(t, "# ") or strings.starts_with(t, "## ") or strings.starts_with(t, "### ")
        quoted := t == ">" or strings.starts_with(t, "> ")
        table := strings.starts_with(t, "|")
        comment := strings.starts_with(t, "<!--")
        continuation := len(list_tag) > 0 and marker == 0 and len(t) > 0 and not fence and not heading and not quoted and not table and not comment and (strings.starts_with(lines[i], "  ") or strings.starts_with(lines[i], "\t"))
        if continuation:
            list_item = list_item + " " + t
            continue
        boundary := len(t) == 0 or t == "---" or heading or marker > 0 or quoted or table or fence or comment
        if boundary and len(paragraph) > 0:
            out = out + "<p>" + render_inline(paragraph) + "</p>\n"
            paragraph = ""
        if not table:
            out = out + flush_rows_html(rows)
            rows = []string
        if not quoted:
            out = out + flush_quote_html(quote)
            quote = []string
        if marker > 0:
            tag := "ul"
            if t[0] >= 48 and t[0] <= 57:
                tag = "ol"
            if list_tag != tag:
                out = out + close_list_html(list_tag, list_item)
                start := ""
                if tag == "ol" and t[0:marker-2] != "1":
                    start = " start=\"" + t[0:marker-2] + "\""
                out = out + "<" + tag + start + ">\n"
                list_tag = tag
            else:
                out = out + "<li>" + render_inline(list_item) + "</li>\n"
            list_item = t[marker:len(t)]
            continue
        out = out + close_list_html(list_tag, list_item)
        list_tag = ""
        list_item = ""
        if fence:
            lang := strings.trim(t[3:len(t)])
            out = out + "<pre><code"
            if len(lang) > 0:
                out = out + " class=\"language-" + esc_html(lang) + "\""
            out = out + ">"
            in_fence = true
        elif comment or len(t) == 0:
            pass
        elif table:
            push(rows, t)
        elif quoted:
            push(quote, strings.trim(t[2:len(t)]))
        elif t == "---":
            out = out + "<hr/>\n"
        elif heading:
            level := 1
            for level < len(t) and t[level] == 35:
                level += 1
            h := t[level+1:len(t)]
            tag := "h" + str(level)
            out = out + "<" + tag + " id=\"" + slug(h) + "\">" + render_inline(h) + "</" + tag + ">\n"
        else:
            if len(paragraph) > 0:
                paragraph = paragraph + " "
            paragraph = paragraph + t
    if len(paragraph) > 0:
        out = out + "<p>" + render_inline(paragraph) + "</p>\n"
    out = out + close_list_html(list_tag, list_item) + flush_rows_html(rows) + flush_quote_html(quote)
    if in_fence:
        out = out + "</code></pre>\n"
    return out

fn up_prefix(rel: string) -> string:
    up := ""
    for i := 0; i < len(rel); i += 1:
        if rel[i:i+1] == "/":
            up = up + "../"
    return up

# Source links outside docs/ belong on GitHub, not at nonexistent .html paths.
# The home link encodes the page's depth; one further parent exits the docs tree.
fn published_links(content: string, home: string, source_root: bool) -> string:
    outside := strings.replace(home, "index.html", "../")
    root := strings.replace(home, "index.html", "")
    out := ""
    i := 0
    for i < len(content):
        if content[i:i+6] == "href=\"":
            j := i + 6
            for j < len(content) and content[j:j+1] != "\"":
                j += 1
            u := content[i+6:j]
            target := ""
            if strings.starts_with(u, outside):
                target = u[len(outside):len(u)]
            elif source_root and not strings.starts_with(u, "https:") and not strings.starts_with(u, "http:") and not strings.starts_with(u, "mailto:") and not strings.starts_with(u, "#"):
                if strings.starts_with(u, "docs/"):
                    u = u[5:len(u)]
                else:
                    target = u
            if len(target) > 0:
                if strings.starts_with(target, "CHANGELOG.html"):
                    u = root + strings.replace(target, "CHANGELOG.html", "changelog.html")
                elif strings.starts_with(target, "RELEASE_NOTES.html"):
                    u = root + strings.replace(target, "RELEASE_NOTES.html", "release-notes.html")
                else:
                    u = "https://github.com/StefanVonRanda/tycho/blob/main/" + strings.replace(target, ".html", ".md")
            out = out + "href=\"" + u
            i = j
        else:
            out = out + char_at(content, i)
            i += 1
    return out

fn contents_html(content: string) -> string:
    out := ""
    i := 0
    for i < len(content):
        h2 := content[i:i+8] == "<h2 id=\""
        h3 := content[i:i+8] == "<h3 id=\""
        if h2 or h3:
            end_id := find_from(content, "\"", i + 8)
            end_tag := find_from(content, ">", end_id)
            end_text := find_from(content, "</h", end_tag)
            if end_id >= 0 and end_tag >= 0 and end_text >= 0:
                cls := ""
                if h3:
                    cls = " class=\"sub\""
                out = out + "<a" + cls + " href=\"#" + content[i+8:end_id] + "\">" + strip_tags(content[end_tag+1:end_text]) + "</a>\n"
                i = end_text
            else:
                i += 1
        else:
            i += 1
    if len(out) == 0:
        return ""
    return "<aside class=\"contents\"><details class=\"contents-nav\" open><summary class=\"eyebrow\">On this page</summary><nav aria-label=\"On this page\">" + out + "</nav></details></aside>"

fn page_html(title: string, home: string, crumb: string, content: string, navigation: string, header: string, footer: string) -> string:
    linked := published_links(content, home, crumb == "CHANGELOG.md" or crumb == "RELEASE_NOTES.md")
    root := strings.replace(home, "index.html", "")
    landing := root + "../"
    h := "<!doctype html>\n<html lang=\"en\">\n<head><meta charset=\"utf-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n<title>" + esc_html(title) + " — Tycho docs</title>\n<script>(function(){try{var d=document.documentElement;var e=localStorage.getItem('tycho-theme');d.dataset.theme=e||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');}catch(e){}})();</script>\n<link rel=\"icon\" href=\"" + landing + "favicon.svg\" type=\"image/svg+xml\">\n<link rel=\"stylesheet\" href=\"" + root + "site.css\">\n<script src=\"" + root + "site.js\" defer></script>\n</head>\n<body>\n<a class=\"skip\" href=\"#main\">Skip to content</a>\n"
    h = h + strings.replace(strings.replace(header, "{{root}}", landing), "{{docs}}", root) + "<div class=\"page docs-layout\">\n<aside class=\"docs-sidebar\">" + navigation + "</aside>\n" + contents_html(linked) + "\n<main class=\"doc-content\" id=\"main\" tabindex=\"-1\">\n"
    h = h + "<nav class=\"crumb\" aria-label=\"Breadcrumb\"><a href=\"" + home + "\">Docs</a> / " + crumb + "</nav>\n"
    return h + linked + "</main>\n</div>\n" + strings.replace(strings.replace(footer, "{{root}}", landing), "{{docs}}", root) + "</body>\n</html>\n"

# The page title is the first `# ` heading; empty when the file has none.
fn title_of(text: string) -> string:
    lines := strings.lines(text)
    for i := 0; i < len(lines); i += 1:
        t := strings.trim(lines[i])
        if strings.starts_with(t, "# "):
            return t[2:len(t)]
    return ""

# Collect every `.md` file under dir, as paths relative to base, sorted.
fn collect(dir: string, base: string, acc: [string]) -> [string]:
    got := acc
    names := io.list(dir)
    for i := 0; i < len(names); i += 1:
        p := path.join(dir, names[i])
        match io.is_dir(p):
            Ok(v):
                if v:
                    got = collect(p, base, got)
                else:
                    if path.ext(names[i]) == ".md":
                        rel := p[len(base)+1:len(p)]
                        push(got, rel)
            Err(_):
                println("tycho-docs: cannot stat " + p)
    return got

fn dir_of(rel: string) -> string:
    d := ""
    for i := 0; i < len(rel); i += 1:
        if rel[i:i+1] == "/":
            d = rel[0:i]
    return d

fn parent_of(d: string) -> string:
    s := d
    for len(s) > 0 and s[len(s)-1:len(s)] == "/":
        s = s[0:len(s)-1]
    p := ""
    for i := 0; i < len(s); i += 1:
        if s[i:i+1] == "/":
            p = s[0:i]
    if len(p) > 0:
        return p
    return "."

# Index of sub in s at or after from, or -1.
fn find_from(s: string, sub: string, from: int) -> int:
    i := from
    for i + len(sub) <= len(s):
        if s[i:i+len(sub)] == sub:
            return i
        i = i + 1
    return 0 - 1

# Drop <...> tags for the search index. Quotes survive; the caller
# JSON-escapes afterwards.
fn strip_tags(s: string) -> string:
    out := ""
    i := 0
    for i < len(s):
        if s[i] == 60:                          # '<'
            j := find_from(s, ">", i + 1)
            if j >= 0:
                i = j + 1
            else:
                out = out + char_at(s, i)
                i = i + 1
        else:
            out = out + char_at(s, i)
            i = i + 1
    return out

# JSON string escaping for the search index.
fn json_esc(s: string) -> string:
    out := ""
    for i := 0; i < len(s); i += 1:
        c := s[i]
        if c == 34:                             # '"'
            out = out + "\\\""
        elif c == 92:                           # backslash
            out = out + "\\\\"
        elif c == 10:                           # newline
            out = out + "\\n"
        elif c == 13:
            out = out + ""
        elif c == 9:
            out = out + " "
        else:
            out = out + char_at(s, i)
    return out

fn group_of(d: string) -> string:
    if len(d) == 0:
        return "Guide"
    if d == "reference":
        return "Reference"
    if d == "spec":
        return "Specification"
    return "Maintainer records"

fn navigation_html(outs: [string], titles: [string], groups: [string], current: string, prefix: string) -> string:
    home_selected := ""
    if current == "index.html":
        home_selected = " aria-current=\"page\""
    out := "<details class=\"docs-nav\" open><summary>Browse documentation</summary><nav aria-label=\"Documentation\"><a class=\"docs-home\" href=\"" + prefix + "index.html\"" + home_selected + ">Documentation home</a>"
    order := ["Guide", "Reference", "Specification", "Maintainer records", "Project"]
    active_group := ""
    for i := 0; i < len(outs); i += 1:
        if outs[i] == current:
            active_group = groups[i]
    for g := 0; g < len(order); g += 1:
        shown := false
        for i := 0; i < len(outs); i += 1:
            if groups[i] == order[g]:
                if not shown:
                    open := ""
                    if groups[i] == active_group or (current == "index.html" and (groups[i] == "Guide" or groups[i] == "Reference")):
                        open = " open"
                    out = out + "<details" + open + "><summary>" + order[g] + "</summary>"
                    shown = true
                selected := ""
                if outs[i] == current:
                    selected = " aria-current=\"page\""
                out = out + "<a href=\"" + prefix + outs[i] + "\"" + selected + ">" + esc_html(titles[i]) + "</a>"
        if shown:
            out = out + "</details>"
    return out + "</nav></details>"

fn build(docs_dir: string, out_dir: string):
    root := parent_of(docs_dir)
    assets := path.join(root, "tools/tycho-docs")
    header := io.read(path.join(assets, "header.html"))
    footer := io.read(path.join(assets, "footer.html"))
    css := io.read(path.join(assets, "site.css"))
    js := io.read(path.join(assets, "site.js"))
    if len(header) == 0 or len(footer) == 0 or len(css) == 0 or len(js) == 0:
        println("tycho-docs: missing site assets under " + assets)
        return
    match io.make_dir_all(out_dir):
        Ok(_):
            pass
        Err(e):
            println("tycho-docs: cannot mkdir " + out_dir)
            return
    io.write(path.join(out_dir, "site.css"), css)
    io.write(path.join(out_dir, "site.js"), js)
    sorted := sort.asc(collect(docs_dir, docs_dir, []string))
    preferred := ["tutorial.md", "README.md", "from-c-to-arenas.md", "idioms.md", "memory-model.md", "quiet-results.md", "performance.md", "platforms.md", "debugging.md", "architecture.md", "thesis.md", "perf.md", "controls.md"]
    files := []string
    for name in preferred:
        for rel in sorted:
            if name == rel:
                push(files, rel)
    for rel in sorted:
        found := false
        for name in preferred:
            if name == rel:
                found = true
        if not found:
            push(files, rel)
    outs := []string
    titles := []string
    groups := []string
    sources := []string
    rels := []string
    for i := 0; i < len(files); i += 1:
        rel := files[i]
        text := io.read(path.join(docs_dir, rel))
        title := title_of(text)
        if len(title) == 0:
            title = rel
        push(rels, rel)
        push(sources, text)
        push(outs, rel[0:len(rel)-3] + ".html")
        push(titles, title)
        push(groups, group_of(dir_of(rel)))
    for name in ["CHANGELOG", "RELEASE_NOTES"]:
        text := io.read(path.join(root, name + ".md"))
        push(rels, name + ".md")
        push(sources, text)
        push(outs, strings.replace(strings.to_lower(name), "_", "-") + ".html")
        push(titles, title_of(text))
        push(groups, "Project")
    search := "["
    n := 0
    for i := 0; i < len(outs); i += 1:
        rel := rels[i]
        d := dir_of(rel)
        if len(d) > 0:
            match io.make_dir_all(path.join(out_dir, d)):
                Ok(_):
                    pass
                Err(e):
                    println("tycho-docs: cannot mkdir " + d)
        prefix := up_prefix(rel)
        body := render_md(sources[i])
        nav := navigation_html(outs, titles, groups, outs[i], prefix)
        html := page_html(titles[i], prefix + "index.html", esc_html(rel), body, nav, header, footer)
        if io.write(path.join(out_dir, outs[i]), html):
            n += 1
        if d != "" and path.base(outs[i]) == "README.html":
            io.write(path.join(out_dir, d + "/index.html"), html)
        if i > 0:
            search = search + ","
        # Per-page intermediates belong to this loop, not the growing index.
        search_title := json_esc(titles[i])
        search_text := json_esc(strip_tags(body))
        search = search + "{\"u\":\"" + outs[i] + "\",\"t\":\"" + search_title + "\",\"x\":\"" + search_text + "\"}"
    io.write(path.join(out_dir, "search.json"), search + "]")
    idx := "<h1>Tycho documentation</h1>\n<p>Guides to get you started. A reference for the language and corelib. A specification for the precise contract.</p>\n<div class=\"start\"><p><strong>New to Tycho?</strong> Start with the <a href=\"tutorial.html\">tutorial</a>, then explore <a href=\"from-c-to-arenas.html\">the memory model</a> and <a href=\"idioms.html\">Thinking in Tycho</a>.</p><p>Looking up syntax? Open the <a href=\"reference/index.html\">language reference</a>. For the precise contract, use the <a href=\"spec/index.html\">specification</a>.</p></div>\n"
    order := ["Guide", "Reference", "Specification", "Maintainer records", "Project"]
    for g := 0; g < len(order); g += 1:
        shown := false
        for i := 0; i < len(outs); i += 1:
            if groups[i] == order[g]:
                if not shown:
                    idx = idx + "<h2 id=\"" + slug(order[g]) + "\">" + order[g] + "</h2>\n<ul class=\"pages\">\n"
                    shown = true
                idx = idx + "<li><a href=\"" + outs[i] + "\">" + esc_html(titles[i]) + "</a></li>\n"
        if shown:
            idx = idx + "</ul>\n"
    nav := navigation_html(outs, titles, groups, "index.html", "")
    io.write(path.join(out_dir, "index.html"), page_html("Tycho documentation", "index.html", "Home", idx, nav, header, footer))
    println("docs-site: " + str(n) + " pages from " + docs_dir)
    println("index: index.html (" + str(len(outs)) + " links)")

fn main():
    a := args()
    if len(a) < 3:
        println("usage: docs-site <docs_dir> <out_dir>")
    else:
        build(a[1], a[2])
