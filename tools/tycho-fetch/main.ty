package main

import "core:http"
import "core:sha256"
import "core:io"

fn main():
    a := args()
    local := false
    i := 1
    if len(a) > 1 and a[1] == "--local":
        local = true
        i = 2
    if len(a) < i + 2:
        println("usage: tycho-fetch <url> <name>")
        println("       tycho-fetch --local <path> <name>")
        println("  vendor a package tarball into vendor/<name>")
        println("  the tarball must have a single top-level directory")
        println("  <url> is fetched over http/https; --local reads an ordinary file")
        exit(2)
    url := a[i]
    name := a[i + 1]
    if not safe_name(name):
        die("tycho-fetch: <name> must be a plain directory name (letters, digits, '.', '_', '-')")
    if not local and has_prefix(url, "file://"):
        die("tycho-fetch: file:// is not fetched over HTTP -- use: tycho-fetch --local <path> " + name)
    body := load(local, url)
    sha := sha256.hex(to_str(body))
    println("tycho-fetch: " + url)
    println("  sha256 : " + sha)
    if not io.exists("vendor"):
        if not mkdir("vendor"):
            die("tycho-fetch: cannot create vendor/")
    arch := "vendor/.fetch-" + name + ".tar.gz"
    if not write_bin(arch, body):
        die("tycho-fetch: cannot write " + arch)
    dest := "vendor/" + name
    if io.exists(dest):
        _ := io.remove(arch)
        die("tycho-fetch: " + dest + " already exists -- remove it first")
    if not mkdir(dest):
        _ := io.remove(arch)
        die("tycho-fetch: cannot create " + dest)
    if tycho_run("tar -xf " + shq(arch) + " -C " + shq(dest) + " --strip-components=1 >" + null_dev() + " 2>&1") != 0:
        _ := io.remove(arch)
        die("tycho-fetch: " + url + " is not a tarball with a single top-level directory")
    _ := io.remove(arch)
    println("  vendored " + name + " -> " + dest)

# `corelib/http/http_shim.c@CURLOPT_PROTOCOLS_STR` pins curl to http,https --
# http.get("file:///etc/passwd") used to return the file. Reading a tarball off
# local disk is not an HTTP operation, so --local goes straight to core:io and
# never builds a URL. That is the only scheme this tool ever wanted beyond
# http/https, so narrowing that list further cannot break tycho-fetch again.
fn load(local: bool, src: string) -> bytes:
    if local:
        match io.read_bytes(src):
            Ok(b):
                return b
            Err(_):
                die("tycho-fetch: cannot read " + src)
    r := http.get(src)
    st := http.status(r)
    body := http.body_bytes(r)
    http.release(r)
    # Status 0 means the request did not complete; the 0-with-a-body arm is kept
    # for a proxy that answers without a status line, and fails closed on empty.
    if st != 200 and (st != 0 or len(body) == 0):
        die("tycho-fetch: " + src + " -> HTTP " + str(st))
    return body

fn has_prefix(s: string, p: string) -> bool:
    if len(s) < len(p):
        return false
    return s[0:len(p)] == p

extern fn tycho_run(cmd: string) -> int        # system(cmd); raw wait status, 0 == ok
extern fn tycho_is_windows() -> int            # 1 under _WIN32: null device + quoting style

# The extract step is the tool's OWN shell-out, not user text, so it has to be
# spelled for the shell that will parse it. On Windows that is cmd.exe, where
# "/dev/null" is an ordinary filename and a single quote is a literal character
# -- so the redirect failed, the quoted paths reached tar WITH the quotes in
# them, and every fetch died as "not a tarball with a single top-level
# directory". (The buildfile RECIPES that tycho-build runs are a different
# thing: those are the user's text and stay verbatim.)
fn null_dev() -> string:
    if tycho_is_windows() == 1:
        return "nul"
    return "/dev/null"

fn shq(s: string) -> string:
    if tycho_is_windows() == 1:
        return "\"" + s + "\""
    return "'" + s + "'"

# a vendored package name must be one safe path component: no separators, no '..'
fn safe_name(name: string) -> bool:
    if len(name) == 0 or name == "." or name == "..":
        return false
    for i := 0; i < len(name); i += 1:
        c := name[i]
        if not ((c >= 97 and c <= 122) or (c >= 65 and c <= 90) or (c >= 48 and c <= 57)
                or c == 46 or c == 95 or c == 45):
            return false
    return true

fn mkdir(p: string) -> bool:
    match io.make_dir(p):
        Ok(ok):
            return ok
        Err(_):
            return false

fn write_bin(p: string, b: bytes) -> bool:
    match io.write_bytes(p, b):
        Ok():
            return true
        Err(_):
            return false
