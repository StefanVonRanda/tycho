
extern fn tycho_run(cmd: string) -> int        # system(cmd); raw wait status, 0 == ok
extern fn tycho_sleep_ms(ms: int) -> int       # usleep(ms*1000)
extern fn tycho_is_windows() -> int            # 1 under _WIN32: null device, temp root, .exe suffix
extern fn tycho_remove(path: string) -> int    # unlink one file (cmd.exe has no `rm`)
extern fn tycho_copy(src: string, dst: string) -> int      # byte copy (cmd.exe has no `cp`)
extern fn tycho_rename(src: string, dst: string) -> int    # atomic replace (cmd.exe has no `mv`)
extern fn tycho_files_equal(a: string, b: string) -> int   # 1 same / 0 differ / -1 unreadable (no `diff`)

fn null_dev() -> string:
    if tycho_is_windows() == 1:
        return "nul"
    return "/dev/null"

# Quote ONE argument for the shell tycho_run() hands the line to: sh on POSIX,
# cmd.exe on Windows. A filename or a forwarded arg is attacker-shaped -- never
# interpolate one raw. (Same spelling as tools/tycho-debug/main.ty@shq.)
fn shq(s: string) -> string:
    if tycho_is_windows() == 1:
        out := "\""
        for i := 0; i < len(s); i += 1:
            if s[i] == 34:                              # 34 = double quote
                out = out + "\\\""
            else:
                out = out + substr(s, i, i + 1)
        return out + "\""
    out := "'"
    for i := 0; i < len(s); i += 1:
        if s[i] == 39:                                  # 39 = single quote
            out = out + "'\\''"
        else:
            out = out + substr(s, i, i + 1)
    return out + "'"

# Where the throwaway build/check artifacts live. Drive-anchored on Windows so
# the path does not depend on which drive the current directory sits on.
fn tmp_dir() -> string:
    if tycho_is_windows() == 1:
        return "C:/tmp"
    return "/tmp"

# Make tmp_dir() exist. POSIX /tmp always does; on Windows it is C:\tmp and a
# fresh box has none, so the first redirect there would write nothing.
fn ensure_tmp_root():
    if tycho_is_windows() == 1:
        tycho_run("if not exist C:\\tmp mkdir C:\\tmp")

# The suffix a linked program has to carry to be startable. mingw's linker
# appends ".exe" itself when the -o name has no extension, which would leave
# every "built <name>" line naming a file that does not exist -- so ask for it
# explicitly instead, and print what is actually on disk.
fn with_exe(name: string) -> string:
    if tycho_is_windows() != 1:
        return name
    n := len(name)
    if n > 4:
        if substr(name, n - 4, n) == ".exe":
            return name
    return name + ".exe"

# the compiler to invoke (TYCHOC override, else "tychoc" off PATH)
fn compiler() -> string:
    c := getenv("TYCHOC")
    if c == "":
        return "tychoc"
    return c

# the formatter to invoke (TYCHOFMT override, else "tychofmt" off PATH)
fn formatter() -> string:
    f := getenv("TYCHOFMT")
    if f == "":
        return "tychofmt"
    return f

# the debugger to invoke (TYCHODEBUG override, else "tycho-debug" off PATH)
fn debugger() -> string:
    d := getenv("TYCHODEBUG")
    if d == "":
        return "tycho-debug"
    return d

# output binary name for `build`: drop the directory and a trailing ".ty"
fn out_name(file: string) -> string:
    parts := split(file, "/")
    base := parts[len(parts) - 1]
    n := len(base)
    if n > 3:
        if substr(base, n - 3, n) == ".ty":
            return substr(base, 0, n - 3)
    return base

# join a[start:] with single spaces, each argument shell-quoted
fn join_from(a: [string], start: int) -> string:
    s := ""
    i := start
    for i < len(a):
        if i > start:
            s = s + " "
        s = s + shq(a[i])
        i = i + 1
    return s

fn usage():
    println("tycho - build/run/check/watch for .ty programs")
    println("usage:")
    println("  tycho run   <file.ty> [args...]   build + run (args forwarded)")
    println("  tycho build <file.ty> [-o out]    build to a binary")
    println("  tycho check <file.ty>             parse/type only, no cc (fast)")
    println("  tycho watch <file.ty>             re-check on change")
    println("  tycho fmt   <file.ty> [-w]        format to stdout (-w: safe in-place write)")
    println("  tycho debug <file.ty> [args...]   compile with -g and debug under gdb")
    println("  (TYCHOC/TYCHOFMT/TYCHODEBUG override compiler/formatter/debugger)")

fn cmd_run(a: [string], cc: string):
    file := a[2]
    ensure_tmp_root()
    exe := with_exe(tmp_dir() + "/.tycho_run_bin")
    # build to a throwaway temp; tychoc emits <exe>, and <exe>.c survives a cc
    # failure on purpose (src/tychoc.c:14891) -- so clean both, either way
    if tycho_run(cc + " " + shq(file) + " -o " + shq(exe) + " > " + null_dev()) != 0:
        tycho_remove(exe)
        tycho_remove(exe + ".c")
        die("tycho run: build failed: " + file)
    code := tycho_run(shq(exe) + " " + join_from(a, 3))
    tycho_remove(exe)                              # the generated binary
    tycho_remove(exe + ".c")                       # and its transpiled C, if a failure left one
    if code != 0:
        die("tycho run: program exited non-zero")

fn cmd_build(a: [string], cc: string):
    file := a[2]
    out := out_name(file)
    if len(a) >= 5:
        if a[3] == "-o":
            out = a[4]
    out = with_exe(out)                            # an explicit -o gets it too: cmd needs the suffix
    if tycho_run(cc + " " + shq(file) + " -o " + shq(out) + " > " + null_dev()) != 0:
        die("tycho build: failed: " + file)
    println("built " + out)

fn cmd_check(a: [string], cc: string):
    file := a[2]
    # --emit-c runs the whole front-end (parse + type + codegen) but skips cc;
    # the throwaway C goes to a temp, errors land on stderr (inherited -> shown).
    ensure_tmp_root()
    if tycho_run(cc + " " + shq(file) + " --emit-c -o " + shq(tmp_dir() + "/.tycho_check") + " > " + null_dev()) != 0:
        die("tycho check: " + file + " has errors")
    println("ok: " + file)

# `tycho fmt <file>` prints the formatted source (safe, works on any file).
# `tycho fmt -w <file>` rewrites it IN PLACE -- but only after proving the program
# is unchanged: format to a sibling temp, emit-C the original AND the formatted
# from the SAME path (controls for the filename), require byte-identical C, then
# atomically rename. Any failure leaves the original untouched (fail closed).
fn cmd_fmt(a: [string], cc: string):
    fmtr := formatter()
    write := false
    file := ""
    i := 2
    for i < len(a):
        if a[i] == "-w":
            write = true
        else:
            file = a[i]
        i = i + 1
    if file == "":
        die("tycho fmt: no file given")
    if not write:
        tycho_run(fmtr + " " + shq(file))                     # preview to stdout
        return
    tmp := file + ".tychofmt~"                                # sibling temp -> same FS -> atomic rename
    if tycho_run(fmtr + " " + shq(file) + " > " + shq(tmp)) != 0:
        tycho_remove(tmp)
        die("tycho fmt -w: formatter failed on " + file)
    ensure_tmp_root()
    chk := tmp_dir() + "/.tychofmt_check.ty"
    ca := tmp_dir() + "/.tychofmt_a"
    cb := tmp_dir() + "/.tychofmt_b"
    tycho_copy(file, chk)
    if tycho_run(cc + " " + shq(chk) + " --emit-c -o " + shq(ca) + " > " + null_dev() + " 2>&1") != 0:
        tycho_remove(tmp)
        die("tycho fmt -w: " + file + " does not compile -- fix it first (preview with: tycho fmt " + file + ")")
    tycho_copy(tmp, chk)
    if tycho_run(cc + " " + shq(chk) + " --emit-c -o " + shq(cb) + " > " + null_dev() + " 2>&1") != 0:
        tycho_remove(tmp)
        die("tycho fmt -w: REFUSED -- formatted output does not compile; " + file + " left unchanged")
    # anything but a proven-identical pair refuses: 0 is "differs", -1 is "one of
    # them could not be read", and neither is grounds for overwriting the source
    if tycho_files_equal(ca + ".c", cb + ".c") != 1:
        tycho_remove(tmp)
        die("tycho fmt -w: REFUSED -- formatting would change the program; " + file + " left unchanged")
    if tycho_rename(tmp, file) != 0:
        die("tycho fmt -w: failed to replace " + file)
    println("formatted " + file)

fn cmd_debug(a: [string], cc: string):
    # hand off to tycho-debug (compile with -g + drive gdb); everything after
    # `debug` is forwarded, including -b flags and the debuggee's args
    if tycho_run(debugger() + " " + join_from(a, 2)) != 0:
        die("tycho debug: session ended with an error")

fn cmd_watch(a: [string], cc: string):
    file := a[2]
    println("watching " + file + " (Ctrl-C to stop)")
    ensure_tmp_root()
    last := ""
    for true:
        cur := read_file(file)
        if cur != last:
            last = cur
            println("--- change detected, checking ---")
            tycho_run(cc + " " + shq(file) + " --emit-c -o " + shq(tmp_dir() + "/.tycho_check") + " > " + null_dev())
        tycho_sleep_ms(300)

fn main():
    a := args()
    if len(a) < 3:
        usage()
        return
    cc := compiler()
    cmd := a[1]
    if cmd == "run":
        cmd_run(a, cc)
    elif cmd == "build":
        cmd_build(a, cc)
    elif cmd == "check":
        cmd_check(a, cc)
    elif cmd == "watch":
        cmd_watch(a, cc)
    elif cmd == "fmt":
        cmd_fmt(a, cc)
    elif cmd == "debug":
        cmd_debug(a, cc)
    else:
        println("tycho: unknown command '" + cmd + "'")
        usage()
