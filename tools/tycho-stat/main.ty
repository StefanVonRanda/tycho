package main

import "core:cli"
import "core:io"
import "core:strings"
import "num"

fn field(tok_in: string) -> Result(int, string):
    tok := strings.trim(tok_in)
    if len(tok) == 0:
        return Err("empty field")
    start := 0
    if tok[0] == 45 and len(tok) > 1:      # a leading '-'
        start = 1
    for i := start; i < len(tok); i += 1:
        if tok[i] < 48 or tok[i] > 57:
            return Err("not a number: " + tok)
    return Ok(strings.parse_int(tok))

fn parse_all(fields: [string]) -> [int]:
    out := []int
    for f in fields:
        if len(strings.trim(f)) == 0:
            continue
        match field(f):
            Ok(v): push(out, v)
            Err(e): die("tycho-stat: " + e)
    return out

fn show(label: string, xs: [int]):
    println(label + ":")
    println("  count = " + str(num.count(xs...)))
    println("  sum   = " + str(num.total(xs)))
    match num.min_of(xs...):
        Some(v): println("  min   = " + str(v))
        None: println("  min   = -")
    match num.max_of(xs...):
        Some(v): println("  max   = " + str(v))
        None: println("  max   = -")
    match num.mean(xs):
        Some(v): println("  mean  = " + str(v))
        None: println("  mean  = -")

fn main():
    c := cli.Cli([], [], [], [], [], [])
    match cli.parse_checked(cli.argv(), ["nums", "file", "label"], ["help"]):
        Ok(v): c = v
        Err(cli.Unknown(tok)): die("tycho-stat: unknown option " + tok)
        Err(cli.NoValue(tok)): die("tycho-stat: " + tok + " needs a value")

    nums := cli.get(c, "nums", "")
    path := cli.get(c, "file", "")
    label := cli.get(c, "label", "stat")

    if nums == "" and path == "":
        println("usage: tycho-stat --nums 3,1,4 [--label NAME] | --file FILE")
        exit(2)

    xs := []int
    if nums != "":
        xs = parse_all(split(nums, ","))
    else:
        text := ""
        match io.read_text(path):
            Ok(t): text = t
            Err(e): die("tycho-stat: cannot read " + path)
        xs = parse_all(strings.lines(text))

    show(label, xs)

    println("empty count = " + str(num.count$(int)()))
    println("empty sum   = " + str(num.total([]int)))
