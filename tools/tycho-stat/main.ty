# tycho-stat -- summary statistics over a list of integers.
#
# WHY THIS PROGRAM EXISTS. A dogfood audit (docs/internals/FRICTION.md).
# Measured 2026-08-14 with `grep -F`: a variadic parameter (`...T`) was DECLARED
# in exactly three files, all under `tests/`, and `zero$(` appeared in three
# fixtures plus the frozen `compiler/tychoc0.ty`. Both were features whose only
# caller was their own fixture. This program is the first consumer, and building
# it broke three things at once -- FRICTION #38, #39 and #40.
#
#   tycho-stat --nums 3,1,4,1,5 [--label NAME]
#   tycho-stat --file FILE          # one integer per line
#
# THE GATE IS `make stat-check` (tools/tycho-stat/run.sh).
package main

import "core:cli"
import "core:io"
import "core:strings"
import "num"

# Parse one field, refusing anything that is not a whole number. `parse_int`
# fails open on trailing garbage (FRICTION #34), so the digits are checked here
# rather than trusted -- "3x" must not read as 3.
fn field(tok_in: string) -> Result(int, string):
    tok := strings.trim(tok_in)
    if len(tok) == 0:
        return Err("empty field")
    start := 0
    if tok[0] == 45 and len(tok) > 1:      # a leading '-'
        start = 1
    for i := start; i < len(tok); i += 1:
        if tok[i] < 48 or tok[i] > 57:
            return Err("not a number: " + tok)
    return Ok(strings.parse_int(tok))

fn parse_all(fields: [string]) -> [int]:
    out := []int
    for f in fields:
        if len(strings.trim(f)) == 0:
            continue
        match field(f):
            Ok(v): push(out, v)
            Err(e): die("tycho-stat: " + e)
    return out

fn show(label: string, xs: [int]):
    println(label + ":")
    # The spread form hands a whole array to a variadic. Through a package
    # qualifier this did not pack at all until 2026-08-14 (FRICTION #38).
    println("  count = " + str(num.count(xs...)))
    println("  sum   = " + str(num.total(xs)))
    match num.min_of(xs...):
        Some(v): println("  min   = " + str(v))
        None: println("  min   = -")
    match num.max_of(xs...):
        Some(v): println("  max   = " + str(v))
        None: println("  max   = -")
    match num.mean(xs):
        Some(v): println("  mean  = " + str(v))
        None: println("  mean  = -")

fn main():
    c := cli.Cli([], [], [], [], [], [])
    match cli.parse_checked(cli.argv(), ["nums", "file", "label"], ["help"]):
        Ok(v): c = v
        Err(cli.Unknown(tok)): die("tycho-stat: unknown option " + tok)
        Err(cli.NoValue(tok)): die("tycho-stat: " + tok + " needs a value")

    nums := cli.get(c, "nums", "")
    path := cli.get(c, "file", "")
    label := cli.get(c, "label", "stat")

    if nums == "" and path == "":
        println("usage: tycho-stat --nums 3,1,4 [--label NAME] | --file FILE")
        exit(2)

    xs := []int
    if nums != "":
        xs = parse_all(split(nums, ","))
    else:
        text := ""
        match io.read_text(path):
            Ok(t): text = t
            Err(e): die("tycho-stat: cannot read " + path)
        xs = parse_all(strings.lines(text))

    show(label, xs)

    # The empty case is not a special path in this program -- it is the identity
    # the features supply. `zero$(T)` seeds the fold, so a sum of nothing is 0
    # without a branch; the explicit type argument is what lets an EMPTY generic
    # variadic name its element type, which was an error until 2026-08-14
    # (FRICTION #40), and writing it through a qualifier was a parse error
    # (FRICTION #39).
    println("empty count = " + str(num.count$(int)()))
    println("empty sum   = " + str(num.total([]int)))
