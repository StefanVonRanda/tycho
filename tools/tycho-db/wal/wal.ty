package wal

import "core:io"
import "core:path"
import "../store"

# The write-ahead log. Every mutation is framed, checksummed and written to
# <store>.wal BEFORE store.flush touches the store file, so a process that dies
# mid-script replays to a state in which each row is either wholly there or
# wholly absent.
#
# WHY A LOG IS NEEDED AT ALL HERE. store.flush is io.write_bytes, which is
# fopen("wb") -- it TRUNCATES the store and then rewrites it whole. A process
# killed during that rewrite leaves a short file, i.e. the store's own format
# is the thing most exposed to a crash. The log is what that file is rebuilt
# from.
#
# WHAT DURABILITY IS ACTUALLY CLAIMED. Machine death, on a platform that can
# flush -- widened from process death on 2026-08-12, when core:io gained `sync`
# (fsync(2)). Before that this file said "core:io has no fsync -- grep it" and
# could promise only that a record written before the WRITING PROCESS died was
# read by the next one, because close(2) reaches the page cache and the page
# cache is RAM.
#
# Now append() returns only after io.sync has flushed the log file to the
# device, and after the PARENT DIRECTORY is flushed on the append that created
# the file -- the two halves of a durable create, since a file's bytes and a
# file's name live in different places and a power cut can otherwise return a
# file that does not exist. checkpoint() flushes the store BEFORE it rewinds the
# log, which is the ordering the rewind's safety already depended on.
#
# WHAT IS STILL NOT CLAIMED, because these are still true:
#   * A platform with no flush degrades to the OLD guarantee, silently to the
#     data but not to the reader -- see _sync: Err(Unsupported) is allowed to
#     proceed precisely because it means the bytes are where every core:io
#     writer has always left them. On such a host this file claims process
#     death and no more.
#   * A DRIVE THAT LIES. fsync returning 0 is the kernel's assertion that it
#     pushed the data at the device; a disk with a volatile write cache that
#     acknowledges early makes that assertion false, and nothing in this
#     process can detect it.
#   * The gate does not TEST power loss and cannot -- it kills a process, which
#     is a strictly weaker event. What is verified is that the flush is
#     requested, in the right order, and that its failure is not swallowed.
#
# FRAMING: length prefix AND checksum, because they catch different tears.
#   [u32 len][u32 fnv1a(payload)][payload]
# The length alone cannot tell a complete record from one whose payload was
# lost and left zero-filled -- write_at pwrites at an offset, so a gap in a
# file is a run of zero bytes, not a short file. The checksum alone cannot be
# read without first knowing where the payload ends. A trailing record is
# discarded when it is short, when its length runs past end-of-file, or when
# its checksum disagrees; the records before it are kept.
#
# This is the opposite POLICY to store.decode over the same MECHANISM. decode
# treats "file ends mid-record" as Corrupt and refuses the whole file, which is
# right for a file that is only ever written whole. A log's last record is
# expected to be torn -- that is the crash signature, not damage -- so the tail
# is dropped and the prefix stands.
#
# IDEMPOTENCE: records are numbered, and the number of the last one folded into
# the store travels IN the store file (store.Db.applied_lsn). Replay applies
# only records above it. Replaying twice is therefore a no-op the second time,
# which is what makes an interrupted checkpoint safe rather than merely
# unlikely.

const MAGIC = "TYWAL"
const VERSION = 1
const HDR = 17             # 5 magic + 4 version + 8 base_lsn
const FRAME = 8            # 4 length + 4 checksum

const R_CREATE = 1
const R_INSERT = 2

# FNV-1a, 32-bit. A few lines and no dependency, against core:sha256 which is
# 256 bits of cryptographic strength for a job that only has to notice a torn
# or zero-filled payload -- and which would hash every record on every open.
# The multiply stays under 2^56 and `int` is 64-bit two's complement by spec
# (docs/spec/03-types.md:41), so this does not depend on the host's word size.
const FNV_OFF = 2166136261
const FNV_PRIME = 16777619
const M32 = 4294967296

enum WalErr:
    Storage(store.StoreErr)
    NotWritten(string)
    BadLog(string)
    LostPrefix(string, int)

# A mutation. SELECT is absent on purpose: it changes nothing, so logging it
# would only make the log grow.
enum Rec:
    RCreate(string, [store.Col])
    RInsert(string, [store.Val])

struct Log:
    path: string
    base_lsn: int          # lsn of the record before the first one in this file
    next_lsn: int          # lsn of the most recent record; the next is this + 1
    end: int               # byte offset just past the last VALID record

struct Session:
    db: store.Db
    log: Log
    replayed: int
    torn: bool
    rebuilt: bool

struct Scan:
    present: bool
    base_lsn: int
    recs: [Rec]
    end: int
    torn: bool

fn err_str(e: WalErr) -> string:
    match e:
        Storage(s): return store.err_str(s)
        NotWritten(p): return "cannot write " + p
        BadLog(p): return "not a tycho-db log: " + p
        LostPrefix(p, n):
            return p + " is unreadable and its log no longer reaches back past lsn " + str(n)

fn log_path(store_path: string) -> string:
    return store_path + ".wal"

# Flush `p` to the storage device, mapping core:io's three failure causes onto
# the only two answers this log has a use for.
#
# Err(Unsupported) IS Ok(false), NOT AN ERROR, and that distinction is the reason
# core:io spends a variant on it. It means the platform has no flush for this
# object, so the bytes sit exactly where every core:io writer has always left
# them -- the page cache -- which is the guarantee this file shipped before sync
# existed. Turning that into a hard error would make tycho-db refuse to run on a
# host where it previously worked correctly, to punish it for a promise it never
# made. The claim degrades; the database does not stop.
#
# Every other Err IS fatal, and reported as NotWritten. A failed fsync is not a
# retryable hiccup: the kernel tried to push the record at the device and did
# not get it there, so the record is not durably logged -- which is precisely
# what NotWritten's message ("cannot write <path>") already says. Swallowing it
# would leave the store free to move ahead of a log that does not have the
# record, which is the exact failure the log exists to prevent.
fn _sync(p: string) -> Result(bool, WalErr):
    match io.sync(p):
        Ok(x): return Ok(true)
        Err(io.Unsupported): return Ok(false)
        _: return Err(NotWritten(p))

fn checksum(b: bytes, from: int, to: int) -> int:
    h := FNV_OFF
    for i := from; i < to; i += 1:
        h = (h ^ b[i]) % M32
        h = (h * FNV_PRIME) % M32
    return h

# ---- record codec ---------------------------------------------------------
#
# Built from store's exported primitives rather than a second set here, so a
# value encodes identically in both files and cannot drift out of step.

fn put_rec(r: Rec) -> bytes:
    match r:
        RCreate(name, cols):
            out := to_bytes([R_CREATE]) + store.put_str(name) + store.put_u32(len(cols))
            for c in cols:
                out = out + store.put_col(c)
            return out
        RInsert(name, vals):
            out := to_bytes([R_INSERT]) + store.put_str(name) + store.put_u32(len(vals))
            for v in vals:
                out = out + store.put_val(v)
            return out

fn take_rec(b: bytes, off: inout int) -> Result(Rec, store.StoreErr):
    store.need(b, off, 1) or_return
    tag := b[off]
    off += 1
    name := store.take_str(b, &off) or_return
    n := store.take_u32(b, &off) or_return
    if tag == R_CREATE:
        cols: [store.Col] = []
        for i := 0; i < n; i += 1:
            c := store.take_col(b, &off) or_return
            push(cols, c)
        return Ok(RCreate(name, cols))
    if tag != R_INSERT:
        return Err(store.Corrupt("unknown log record tag " + str(tag)))
    vals: [store.Val] = []
    for i := 0; i < n; i += 1:
        v := store.take_val(b, &off) or_return
        push(vals, v)
    return Ok(RInsert(name, vals))

fn _header(base_lsn: int) -> bytes:
    return to_bytes(MAGIC) + store.put_u32(VERSION) + store.put_u64(base_lsn)

# ---- reading the log ------------------------------------------------------

fn scan(path: string) -> Result(Scan, WalErr):
    none: [Rec] = []
    if not io.exists(path):
        return Ok(Scan(false, 0, none, 0, false))
    blob := to_bytes("")
    match io.read_bytes(path):
        Ok(x): blob = x
        Err(e): return Err(BadLog(path))

    # A zero-length log is a checkpoint that died between truncating the file
    # and writing the new header. It is not damage: there is simply nothing to
    # replay, and the caller re-bases the log from the store's applied_lsn.
    if len(blob) == 0:
        return Ok(Scan(true, 0, none, 0, false))
    if len(blob) < HDR or to_str(blob[0:5]) != MAGIC:
        return Err(BadLog(path))
    off := 5
    version := store.get_u32(blob, off)
    off += 4
    if version != VERSION:
        return Err(BadLog(path))
    base := store.get_u64(blob, off)
    off += 8

    recs: [Rec] = []
    end := off
    torn := false
    # `i` bounds the walk, it is not the cursor: every iteration consumes at
    # least one byte, so len(blob) iterations cannot be exceeded and a corrupt
    # length can never spin this forever.
    for i := 0; i < len(blob); i += 1:
        if off >= len(blob):
            break
        if off + FRAME > len(blob):
            torn = true
            break
        n := store.get_u32(blob, off)
        want := store.get_u32(blob, off + 4)
        body := off + FRAME
        if n <= 0 or body + n > len(blob):
            torn = true
            break
        if checksum(blob, body, body + n) != want:
            torn = true
            break
        p := body
        ok := true
        match take_rec(blob, &p):
            Ok(r): push(recs, r)
            Err(e): ok = false
        if not ok:
            torn = true
            break
        off = body + n
        end = off
    return Ok(Scan(true, base, recs, end, torn))

# ---- appending ------------------------------------------------------------

# Append one record and return its lsn. On return the record is ON THE DEVICE,
# not merely in the page cache -- that is what "logged before the store changes"
# means here, and since 2026-08-12 it is a claim about power loss rather than
# only about process death. See the durability note at the top for the two cases
# that still weaken it.
fn append(lg: inout Log, r: Rec) -> Result(int, WalErr):
    created := false
    if lg.end == 0:
        # No header yet: lay one down whole, so magic and base_lsn land in a
        # single write rather than leaving a half-header behind.
        match io.write_bytes(lg.path, _header(lg.base_lsn)):
            Ok(x): pass
            Err(e): return Err(NotWritten(lg.path))
        lg.end = HDR
        created = true
    body := put_rec(r)
    frame := store.put_u32(len(body)) + store.put_u32(checksum(body, 0, len(body))) + body
    # Written AT lg.end, which is the end of the last VALID record -- so a torn
    # tail left by an earlier crash is overwritten rather than preserved.
    match io.write_at(lg.path, lg.end, frame):
        Ok(x): pass
        Err(e): return Err(NotWritten(lg.path))
    # THE FLUSH IS THE POINT OF THE WHOLE FILE, so it happens before the lsn is
    # handed back and before any caller can take Ok as licence to touch the store.
    hit := _sync(lg.path) or_return
    # And on the append that CREATED the log, the parent directory too: the file's
    # bytes and the file's NAME are flushed by different calls, so a log synced
    # without its parent can come back from a power cut as a log that does not
    # exist. Only on create -- later appends change no directory entry, so paying
    # this per record would be cost with nothing bought.
    if created:
        dhit := _sync(path.dir(lg.path)) or_return
    lg.end += len(frame)
    lg.next_lsn += 1
    return Ok(lg.next_lsn)

# ---- checkpoint -----------------------------------------------------------

# Fold the log into the store and rewind it. The ORDER is the whole contract:
#
#   1. write the store, stamped with the lsn it now includes
#   2. only if that returned Ok, rewind the log
#
# Rewinding a log over a store that never landed would destroy the only copy
# of the missing rows, so step 2 is guarded by step 1's result and nothing
# else. That guard is sound because io.write_bytes fails CLOSED: it checks
# both the short fwrite and the fclose (corelib/io/io_shim.c@iox_write_bytes),
# so an Ok means the whole file was written and closed.
#
# An earlier draft re-read the store here and compared the stamp before
# rewinding. It was removed: given the above it can only fire if the OS
# reports a success it did not perform, no fixture can reach it, and this
# runner's own break-test confirmed that deleting the check reddened nothing.
# A guard no test can fail is not protection, it is decoration.
#
# INTERRUPTED AT ANY POINT, THIS IS SAFE:
#   during 1 -- flush never returns, so the log is never rewound; the store is
#               torn but the log is intact from base 0 and the next open
#               rebuilds from it.
#   during 2 -- the store is good and stamped; the log is either the old one
#               (whose records are all <= applied_lsn, so replay skips every
#               one) or empty (nothing to replay). Idempotence is what makes
#               both outcomes harmless rather than merely improbable.
fn checkpoint(db: inout store.Db, lg: inout Log) -> Result(bool, WalErr):
    db.applied_lsn = lg.next_lsn
    match store.flush(db):
        Ok(x): pass
        Err(e): return Err(Storage(e))
    # STEP 1 IS NOT FINISHED UNTIL THE STORE IS ON THE DEVICE. The rewind below
    # destroys the only other copy of these rows, and it was already guarded by
    # flush's result; a flush that returned Ok with the bytes still in RAM makes
    # that guard true and useless against a power cut. So the guard now waits for
    # the device, and the store file's directory entry is flushed with it because
    # this is the write that may have created it.
    shit := _sync(db.path) or_return
    sdhit := _sync(path.dir(db.path)) or_return
    match io.write_bytes(lg.path, _header(lg.next_lsn)):
        Ok(x): pass
        Err(e): return Err(NotWritten(lg.path))
    # And the rewound header itself, so a crash cannot resurrect the old records
    # from a stale page and replay them over a store that already has them.
    lhit := _sync(lg.path) or_return
    lg.base_lsn = lg.next_lsn
    lg.end = HDR
    return Ok(true)

# ---- opening and replay ---------------------------------------------------

fn _apply(db: inout store.Db, r: Rec) -> Result(bool, WalErr):
    match r:
        RCreate(name, cols):
            match store.create_table(&db, name, cols):
                Ok(x): return Ok(true)
                Err(e): return Err(Storage(e))
        RInsert(name, vals):
            match store.insert(&db, name, vals):
                Ok(x): return Ok(true)
                Err(e): return Err(Storage(e))

# Open the store with its log applied. This, not store.open, is the entry
# point a caller wants: it is the only one that returns a Db reflecting
# mutations that were logged but never folded in.
fn open_db(store_path: string) -> Result(Session, WalErr):
    lp := log_path(store_path)
    sc := scan(lp) or_return

    empty: [store.Table] = []
    db := store.Db(store_path, empty, 0)
    rebuilt := false
    match store.open(store_path):
        Ok(d): db = d
        Err(e):
            # The store would not decode. Rebuilding is only honest when a log
            # exists AND still reaches back to the beginning; with no log at
            # all the corruption is the answer, and is reported unchanged.
            if not sc.present:
                return Err(Storage(e))
            if sc.base_lsn != 0:
                return Err(LostPrefix(store_path, sc.base_lsn))
            rebuilt = true

    # A log with no header (absent, or zero-length from an interrupted
    # checkpoint) is re-based on the store, so the next record is numbered
    # above what the store already contains instead of restarting at 1 and
    # being skipped by its own idempotence check.
    base := sc.base_lsn
    if sc.end == 0:
        base = db.applied_lsn

    lsn := base
    replayed := 0
    for r in sc.recs:
        lsn += 1
        if lsn > db.applied_lsn:
            ok := _apply(&db, r) or_return
            replayed += 1

    lg := Log(lp, base, base + len(sc.recs), sc.end)

    # A torn tail was dropped from the reading, but the junk is still on disk
    # and write_at cannot shorten a file. Rewrite the log from the records that
    # survived so the next append is not sitting in front of garbage.
    if sc.torn:
        out := _header(base)
        for r in sc.recs:
            body := put_rec(r)
            out = out + store.put_u32(len(body)) + store.put_u32(checksum(body, 0, len(body))) + body
        match io.write_bytes(lp, out):
            Ok(x): pass
            Err(e): return Err(NotWritten(lp))
        # Flushed like any other log write: this one SHORTENS the file, and a
        # truncation left in the page cache can come back as the torn tail it
        # just removed.
        thit := _sync(lp) or_return
        lg.end = len(out)

    return Ok(Session(db, lg, replayed, sc.torn, rebuilt))
