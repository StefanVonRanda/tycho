package main

import "core:cli"
import "core:io"
import "core:os"
import "core:strings"
import "core:time"
import "sql"
import "store"
import "exec"
import "wal"

# tycho-db -- a small relational database written in Tycho.
#
# This entry point is deliberately thin: it parses a line with sql, runs it
# with exec against the store, and prints what came back. Every decision
# belongs to a layer below.
#
# It opens through wal.open_db rather than store.open, because that is the
# only entry point that returns a database including mutations which were
# logged but never folded into the store file -- i.e. the ones a crash left
# behind.

fn show_rows(r: exec.Rows):
    head := ""
    for k := 0; k < len(r.cols); k += 1:
        if k > 0:
            head += " | "
        head += r.cols[k]
    println("  cols  " + head)
    for i := 0; i < len(r.rows); i += 1:
        line := ""
        for k := 0; k < len(r.rows[i]); k += 1:
            if k > 0:
                line += " | "
            line += store.val_str(r.rows[i][k])
        println("  row   " + line)
    println("  ok    " + str(len(r.rows)) + " row(s)")

fn show(o: exec.Outcome):
    match o:
        exec.Created(n): println("  ok    created " + n)
        exec.Inserted(n): println("  ok    1 row into " + n)
        exec.Selected(rs): show_rows(rs)

# Returns 1 if the statement failed, and reports through `mutated` whether it
# was a mutation -- which is what the crash hook below counts.
fn run_line(db: inout store.Db, lg: inout wal.Log, src: string, mutated: inout bool) -> int:
    mutated = false
    trimmed := strings.trim(src)
    if trimmed == "" or strings.starts_with(trimmed, "--"):
        return 0
    match sql.parse(trimmed):
        Ok(st):
            match exec.run(&db, &lg, st):
                Ok(o):
                    match o:
                        exec.Selected(rs): pass
                        _: mutated = true
                    show(o)
                    return 0
                Err(e):
                    println("  ERR   " + exec.err_str(e))
                    return 1
        Err(e):
            println("  ERR   " + sql.err_str(e))
            return 1

# The crash hook. Not a simulated crash and not an exit(): kill(1) delivers a
# real SIGKILL to THIS process, so nothing is flushed, no cleanup runs and the
# buffered stdout is lost -- exactly what a `kill -9` from outside would do,
# but landing at a point the gate can name. It fires after `n` mutations have
# been logged and before the script reaches its checkpoint, which is the whole
# window the log exists to cover.
fn _crash():
    os.system("kill -9 $PPID")
    # The signal is delivered by another process, so it does not land on a
    # guaranteed instruction. Park rather than race on: returning from here
    # and going on to checkpoint would be the one outcome that invalidates the
    # test.
    for i := 0; i < 100; i += 1:
        time.sleep_ms(100)

# db and lg travel as separate inout parameters rather than one Session,
# because two fields of a single struct cannot both be borrowed mutably.
fn run_script(script: string, db: inout store.Db, lg: inout wal.Log, crash_after: int) -> Result(void, string):
    bad := 0
    done := 0
    for line in io.read_lines(script):
        if strings.trim(line) != "":
            println(line)
        m := false
        bad += run_line(&db, &lg, line, &m)
        if m:
            done += 1
            if crash_after > 0 and done >= crash_after:
                _crash()

    match wal.checkpoint(&db, &lg):
        Ok(x): pass
        Err(e): return Err(wal.err_str(e))
    if bad > 0:
        return Err(str(bad) + " statement(s) failed")
    return Ok()

fn main() -> Result(void, string):
    av := cli.argv()
    # --crash-after=N is a crash-injection hook for the gate, not a feature:
    # it is what lets a test name the instant between "logged" and "stored".
    # Kept visible in --help's usage line rather than hidden behind an
    # environment variable, because a process that can kill itself should say so.
    crash_after := 0
    args: [string] = []
    for a in av:
        if strings.starts_with(a, "--crash-after="):
            crash_after = strings.parse_int(a[14:len(a)])
        else:
            push(args, a)
    if len(args) == 0:
        return Err("usage: tycho-db <script.sql> [store] [--crash-after=N]")
    if not io.exists(args[0]):
        return Err("no such file: " + args[0])
    path := "tycho.db"
    if len(args) > 1:
        path = args[1]

    match wal.open_db(path):
        Ok(s):
            db := s.db
            lg := s.log
            println("  db    " + db.path + " (" + str(len(db.tables)) + " table(s))")
            if s.rebuilt:
                println("  wal   store unreadable, rebuilt from the log")
            if s.torn:
                println("  wal   discarded a torn trailing record")
            if s.replayed > 0:
                println("  wal   replayed " + str(s.replayed) + " record(s)")
            return run_script(args[0], &db, &lg, crash_after)
        Err(e):
            return Err(wal.err_str(e))
