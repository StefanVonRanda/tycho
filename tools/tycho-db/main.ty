package main

import "core:cli"
import "core:io"
import "core:os"
import "core:strings"
import "core:time"
import "sql"
import "store"
import "exec"
import "wal"
import "srv"

# tycho-db -- a small relational database written in Tycho.
#
# This entry point is deliberately thin: it parses a line with sql, runs it
# with exec against the store, and prints what came back. Every decision
# belongs to a layer below.
#
# It opens through wal.open_db rather than store.open, because that is the
# only entry point that returns a database including mutations which were
# logged but never folded into the store file -- i.e. the ones a crash left
# behind.

fn show_rows(r: exec.Rows):
    head := ""
    for k := 0; k < len(r.cols); k += 1:
        if k > 0:
            head += " | "
        head += r.cols[k]
    println("  cols  " + head)
    for i := 0; i < len(r.rows); i += 1:
        line := ""
        for k := 0; k < len(r.rows[i]); k += 1:
            if k > 0:
                line += " | "
            line += store.val_str(r.rows[i][k])
        println("  row   " + line)
    # RETURNED and EXAMINED, on the line a reader already looks at. The second
    # number is the one that moves when the planner picks the index over the
    # scan, and printing it is what makes that choice checkable from outside
    # rather than a claim in a comment.
    println("  ok    " + str(len(r.rows)) + " row(s) from " + str(r.examined) + " examined")

fn show(o: exec.Outcome):
    match o:
        exec.Created(n): println("  ok    created " + n)
        exec.Inserted(n): println("  ok    1 row into " + n)
        exec.Selected(rs): show_rows(rs)
        exec.Explained(lines):
            for l in lines:
                println("  plan  " + l)

# Returns 1 if the statement failed, and reports through `mutated` whether it
# was a mutation -- which is what the crash hook below counts.
fn run_line(db: inout store.Db, lg: inout wal.Log, src: string, mutated: inout bool) -> int:
    mutated = false
    trimmed := strings.trim(src)
    if trimmed == "" or strings.starts_with(trimmed, "--"):
        return 0
    match sql.parse(trimmed):
        Ok(st):
            match exec.run(&db, &lg, st):
                Ok(o):
                    # Listed as what a mutation IS, not as what it is not: an
                    # outcome added later defaults to "did not change the
                    # store", which is the answer that cannot corrupt the
                    # crash hook's count if it is wrong.
                    match o:
                        exec.Created(n): mutated = true
                        exec.Inserted(n): mutated = true
                        _: mutated = false
                    show(o)
                    return 0
                Err(e):
                    println("  ERR   " + exec.err_str(e))
                    return 1
        Err(e):
            println("  ERR   " + sql.err_str(e))
            return 1

# The crash hook. Not a simulated crash and not an exit(): kill(1) delivers a
# real SIGKILL to THIS process, so nothing is flushed, no cleanup runs and the
# buffered stdout is lost -- exactly what a `kill -9` from outside would do,
# but landing at a point the gate can name. It fires after `n` mutations have
# been logged and before the script reaches its checkpoint, which is the whole
# window the log exists to cover.
fn _crash():
    os.system("kill -9 $PPID")
    # The signal is delivered by another process, so it does not land on a
    # guaranteed instruction. Park rather than race on: returning from here
    # and going on to checkpoint would be the one outcome that invalidates the
    # test.
    for i := 0; i < 100; i += 1:
        time.sleep_ms(100)

# db and lg travel as separate inout parameters rather than one Session,
# because two fields of a single struct cannot both be borrowed mutably.
fn run_script(script: string, db: inout store.Db, lg: inout wal.Log, crash_after: int) -> Result(void, string):
    bad := 0
    done := 0
    for line in io.read_lines(script):
        if strings.trim(line) != "":
            println(line)
        m := false
        bad += run_line(&db, &lg, line, &m)
        if m:
            done += 1
            if crash_after > 0 and done >= crash_after:
                _crash()

    match wal.checkpoint(&db, &lg):
        Ok(x): pass
        Err(e): return Err(wal.err_str(e))
    if bad > 0:
        return Err(str(bad) + " statement(s) failed")
    return Ok()

# ---- server mode ----------------------------------------------------------
#
# The store is opened ONCE, here, and every session runs against that one
# in-memory database -- which is only sound because srv serialises sessions.
# See the concurrency note in srv/srv.ty.
fn serve(path: string, host: string, port: int) -> Result(void, string):
    match wal.open_db(path):
        Ok(s):
            db := s.db
            lg := s.log
            fd := 0
            real := 0
            match srv.listen(host, port):
                Ok(b):
                    fd = b.fd
                    real = b.port
                Err(e): return Err(srv.err_str(e))
            # The banner is the readiness signal, and its ORDER is load-bearing:
            # printed after the socket is listening and before the first accept,
            # so a client that connects on seeing it is queued by the kernel
            # rather than refused. It carries the bound port because --port=0
            # means the caller does not know it -- which is what lets a gate run
            # without claiming a fixed port.
            eprint("tycho-db: listening on " + host + ":" + str(real) + " store=" + db.path + "\n")
            match srv.serve_forever(fd, &db, &lg):
                Ok: return Ok()
                Err(e): return Err(srv.err_str(e))
        Err(e): return Err(wal.err_str(e))

# ---- client mode ----------------------------------------------------------
#
# The same transcript shape as the local script mode -- the statement, then its
# result indented -- so the two can be compared line for line. That is what
# makes "the server answers what the CLI answers" an assertion rather than an
# impression.
fn client(addr: string, script: string) -> Result(void, string):
    host, ps := strings.split_once(addr, ":")
    if host == "" or ps == "":
        return Err("--client wants HOST:PORT, got " + addr)
    fd := 0
    match srv.connect(host, strings.parse_int(ps)):
        Ok(f): fd = f
        Err(e): return Err(srv.err_str(e))
    buf := ""
    bad := 0
    for line in io.read_lines(script):
        t := strings.trim(line)
        if t == "" or strings.starts_with(t, "--"):
            continue
        println(t)
        match srv.request(fd, t, &buf):
            Ok(lines):
                for l in lines:
                    println("  " + l)
                    if strings.starts_with(l, "err "):
                        bad += 1
            Err(e):
                srv.close_conn(fd)
                return Err(srv.err_str(e))
    match srv.request(fd, "QUIT", &buf):
        Ok(lines): pass
        Err(e):
            srv.close_conn(fd)
            return Err(srv.err_str(e))
    srv.close_conn(fd)
    if bad > 0:
        return Err(str(bad) + " statement(s) failed")
    return Ok()

fn main() -> Result(void, string):
    av := cli.argv()
    # --crash-after=N is a crash-injection hook for the gate, not a feature:
    # it is what lets a test name the instant between "logged" and "stored".
    # Kept visible in --help's usage line rather than hidden behind an
    # environment variable, because a process that can kill itself should say so.
    crash_after := 0
    serve_mode := false
    host := "127.0.0.1"
    port := 0
    addr := ""
    args: [string] = []
    for a in av:
        if strings.starts_with(a, "--crash-after="):
            crash_after = strings.parse_int(a[14:len(a)])
        elif a == "--serve":
            serve_mode = true
        elif strings.starts_with(a, "--host="):
            host = a[7:len(a)]
        elif strings.starts_with(a, "--port="):
            port = strings.parse_int(a[7:len(a)])
        elif strings.starts_with(a, "--client="):
            addr = a[9:len(a)]
        else:
            push(args, a)

    # Server mode takes no script: it runs statements its clients send, so the
    # store is the only positional it wants.
    if serve_mode:
        sp := "tycho.db"
        if len(args) > 0:
            sp = args[0]
        return serve(sp, host, port)

    if len(args) == 0:
        return Err("usage: tycho-db <script.sql> [store] [--crash-after=N]\n" +
                   "       tycho-db --serve [store] [--host=H] [--port=N]\n" +
                   "       tycho-db --client=HOST:PORT <script.sql>")
    if not io.exists(args[0]):
        return Err("no such file: " + args[0])

    # Client mode touches no store of its own -- the server owns the file.
    if addr != "":
        return client(addr, args[0])

    path := "tycho.db"
    if len(args) > 1:
        path = args[1]

    match wal.open_db(path):
        Ok(s):
            db := s.db
            lg := s.log
            println("  db    " + db.path + " (" + str(len(db.tables)) + " table(s))")
            if s.rebuilt:
                println("  wal   store unreadable, rebuilt from the log")
            if s.torn:
                println("  wal   discarded a torn trailing record")
            if s.replayed > 0:
                println("  wal   replayed " + str(s.replayed) + " record(s)")
            return run_script(args[0], &db, &lg, crash_after)
        Err(e):
            return Err(wal.err_str(e))
