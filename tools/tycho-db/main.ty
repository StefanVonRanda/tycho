package main

import "core:cli"
import "core:io"
import "core:strings"
import "sql"
import "store"
import "exec"

# tycho-db -- a small relational database written in Tycho.
#
# This entry point is deliberately thin: it parses a line with sql, runs it
# with exec against the store, and prints what came back. Every decision
# belongs to a layer below.

fn nop():
    return

fn show_rows(r: exec.Rows):
    head := ""
    for k := 0; k < len(r.cols); k += 1:
        if k > 0:
            head += " | "
        head += r.cols[k]
    println("  cols  " + head)
    for i := 0; i < len(r.rows); i += 1:
        line := ""
        for k := 0; k < len(r.rows[i]); k += 1:
            if k > 0:
                line += " | "
            line += store.val_str(r.rows[i][k])
        println("  row   " + line)
    println("  ok    " + str(len(r.rows)) + " row(s)")

fn show(o: exec.Outcome):
    match o:
        exec.Created(n): println("  ok    created " + n)
        exec.Inserted(n): println("  ok    1 row into " + n)
        exec.Selected(rs): show_rows(rs)

fn run_line(db: inout store.Db, src: string) -> int:
    trimmed := strings.trim(src)
    if trimmed == "" or strings.starts_with(trimmed, "--"):
        return 0
    match sql.parse(trimmed):
        Ok(st):
            match exec.run(&db, st):
                Ok(o):
                    show(o)
                    return 0
                Err(e):
                    println("  ERR   " + exec.err_str(e))
                    return 1
        Err(e):
            println("  ERR   " + sql.err_str(e))
            return 1

fn run_script(script: string, db: inout store.Db) -> Result(void, string):
    println("  db    " + db.path + " (" + str(len(db.tables)) + " table(s))")
    bad := 0
    for line in io.read_lines(script):
        if strings.trim(line) != "":
            println(line)
        bad += run_line(&db, line)

    match store.flush(db):
        Ok(x): nop()
        Err(e): return Err(store.err_str(e))
    if bad > 0:
        return Err(str(bad) + " statement(s) failed")
    return Ok()

fn main() -> Result(void, string):
    av := cli.argv()
    if len(av) == 0:
        return Err("usage: tycho-db <script.sql> [store]")
    if not io.exists(av[0]):
        return Err("no such file: " + av[0])
    path := "tycho.db"
    if len(av) > 1:
        path = av[1]

    match store.open(path):
        Ok(d):
            db := d
            return run_script(av[0], &db)
        Err(e):
            return Err(store.err_str(e))
