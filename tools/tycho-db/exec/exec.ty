package exec

import "../sql"
import "../store"
import "../wal"
import "../plan"


enum ExecErr:
    Storage(store.StoreErr)
    Wal(wal.WalErr)
    Plan(plan.PlanErr)
    NoColumn(string, string)
    Uncomparable(string, string)
    NotAValue(string)
    NotAPredicate(string)

# `examined` is what the ACCESS PATH produced, before the residual predicate
# ran. It is carried beside the rows rather than printed from inside _select
# because it is a result, not a log line: a caller that wants to assert which
# path ran -- the gate does -- needs it as a value.
struct Rows:
    cols: [string]
    rows: [[store.Val]]
    examined: int

enum Outcome:
    Created(string)
    Inserted(string)
    Selected(Rows)
    Explained([string])

fn err_str(e: ExecErr) -> string:
    match e:
        Storage(s): return store.err_str(s)
        Wal(w): return wal.err_str(w)
        Plan(p): return plan.err_str(p)
        NoColumn(t, c): return t + " has no column " + c
        Uncomparable(a, b): return "cannot compare " + a + " with " + b
        NotAValue(s): return "not a value: " + s
        NotAPredicate(s): return "not a predicate: " + s

# ---- helpers --------------------------------------------------------------

fn _col_index(cols: [store.Col], name: string) -> int:
    for i := 0; i < len(cols); i += 1:
        if cols[i].name == name:
            return i
    return -1

fn _lit(e: sql.Expr) -> Result(store.Val, ExecErr):
    match e:
        sql.LitInt(n): return Ok(store.VInt(n))
        sql.LitStr(s): return Ok(store.VText(s))
        _: return Err(NotAValue(sql.show_expr(e)))

fn _eval(tbl: string, cols: [store.Col], row: [store.Val], e: sql.Expr) -> Result(store.Val, ExecErr):
    match e:
        sql.Col(c):
            j := _col_index(cols, c)
            if j < 0:
                return Err(NoColumn(tbl, c))
            return Ok(row[j])
        _: return _lit(e)

# -1, 0, 1. The QUERY rule that two values of different types do not compare
# lives here; the ordering of two values that do is store.val_cmp's, which the
# index also sorts by -- so a row found through the index and the same row
# found through a scan can never be ordered differently.
fn _cmp(a: store.Val, b: store.Val) -> Result(int, ExecErr):
    at := store.val_ty(a)
    bt := store.val_ty(b)
    if at != bt:
        return Err(Uncomparable(at, bt))
    return Ok(store.val_cmp(a, b))

fn _pred(tbl: string, cols: [store.Col], row: [store.Val], e: sql.Expr) -> Result(bool, ExecErr):
    match e:
        sql.And(l, r):
            left := _pred(tbl, cols, row, l) or_return
            if not left:
                return Ok(false)
            return _pred(tbl, cols, row, r)
        sql.Cmp(op, l, r):
            lv := _eval(tbl, cols, row, l) or_return
            rv := _eval(tbl, cols, row, r) or_return
            c := _cmp(lv, rv) or_return
            return Ok(sql.holds(op, c))
        _: return Err(NotAPredicate(sql.show_expr(e)))

# ---- the statements -------------------------------------------------------

fn _create(db: inout store.Db, lg: inout wal.Log, name: string, defs: [sql.ColDef]) -> Result(Outcome, ExecErr):
    cols: [store.Col] = []
    for k := 0; k < len(defs); k += 1:
        t := store.ColInt
        if sql.ty_name(defs[k].ty) == "text":
            t = store.ColText
        push(cols, store.Col(defs[k].name, t, defs[k].key))
    match store.create_table(&db, name, cols):
        Ok(x): pass
        Err(e): return Err(Storage(e))
    # Logged after the apply, not before: the apply is in MEMORY and the store
    # file is untouched until checkpoint, so the record still reaches disk
    # first -- and a statement the store rejected never enters the log, which
    # keeps replay from re-running a failure.
    match wal.append(&lg, wal.RCreate(name, cols)):
        Ok(n): return Ok(Created(name))
        Err(e): return Err(Wal(e))

fn _insert(db: inout store.Db, lg: inout wal.Log, name: string, exprs: [sql.Expr]) -> Result(Outcome, ExecErr):
    vals: [store.Val] = []
    for k := 0; k < len(exprs); k += 1:
        v := _lit(exprs[k]) or_return
        push(vals, v)
    match store.insert(&db, name, vals):
        Ok(x): pass
        Err(e): return Err(Storage(e))
    match wal.append(&lg, wal.RInsert(name, vals)):
        Ok(n): return Ok(Inserted(name))
        Err(e): return Err(Wal(e))

# The planner's inputs that only the catalogue can supply.
fn _plan_for(db: store.Db, st: sql.Stmt, tbl: string) -> Result(plan.Plan, ExecErr):
    ix: [string] = []
    match store.indexed_cols(db, tbl):
        Ok(cs): ix = cs
        Err(e): return Err(Storage(e))
    match plan.build(st, ix):
        Ok(p): return Ok(p)
        Err(e): return Err(Plan(e))

# Open the access path the plan chose. This is the ONE place the two paths are
# distinguished, and what it returns is the `examined` set -- the rows the
# residual predicate will then be run over.
fn _open(db: store.Db, p: plan.Plan) -> Result([[store.Val]], ExecErr):
    match p.access:
        plan.NoRows:
            # The predicate was decided without a row, so the table is not
            # opened at all. This is the folding made visible: 0 examined over
            # a table that has rows in it.
            none: [[store.Val]] = []
            return Ok(none)
        plan.Scan:
            match store.scan(db, p.table):
                Ok(rs): return Ok(rs)
                Err(e): return Err(Storage(e))
        plan.IndexEq(col, key):
            k := _lit(key) or_return
            match store.probe(db, p.table, col, k):
                Ok(rs): return Ok(rs)
                Err(e): return Err(Storage(e))

fn _select(db: store.Db, st: sql.Stmt, want: [string], tbl: string) -> Result(Outcome, ExecErr):
    cols: [store.Col] = []
    match store.columns(db, tbl):
        Ok(cs): cols = cs
        Err(e): return Err(Storage(e))
    p := _plan_for(db, st, tbl) or_return
    all := _open(db, p) or_return

    names: [string] = []
    idx: [int] = []
    if len(want) == 0:
        for k := 0; k < len(cols); k += 1:
            push(names, cols[k].name)
            push(idx, k)
    else:
        for k := 0; k < len(want); k += 1:
            j := _col_index(cols, want[k])
            if j < 0:
                return Err(NoColumn(tbl, want[k]))
            push(names, want[k])
            push(idx, j)

    out: [[store.Val]] = []
    for r := 0; r < len(all); r += 1:
        keep := true
        match p.residual:
            Some(q): keep = _pred(tbl, cols, all[r], q) or_return
            None: keep = true
        if keep:
            proj: [store.Val] = []
            for k := 0; k < len(idx); k += 1:
                push(proj, all[r][idx[k]])
            push(out, proj)
    return Ok(Selected(Rows(names, out, len(all))))

# EXPLAIN builds the plan and stops. It runs plan.build on the SAME statement
# _select would, through the same helper, so the plan shown is the plan used
# and not a description of one.
fn _explain(db: store.Db, inner: sql.Stmt) -> Result(Outcome, ExecErr):
    match inner:
        sql.Select(want, t, w):
            p := _plan_for(db, inner, t) or_return
            return Ok(Explained(plan.show(p)))
        _:
            # Routed through plan.build rather than refused here, so the rule
            # about what has a plan lives in exactly one file.
            empty: [string] = []
            match plan.build(inner, empty):
                Ok(p): return Ok(Explained(plan.show(p)))
                Err(e): return Err(Plan(e))

fn run(db: inout store.Db, lg: inout wal.Log, st: sql.Stmt) -> Result(Outcome, ExecErr):
    match st:
        sql.Create(name, defs): return _create(&db, &lg, name, defs)
        sql.Insert(name, exprs): return _insert(&db, &lg, name, exprs)
        sql.Select(want, tbl, w): return _select(db, st, want, tbl)
        sql.Explain(inner): return _explain(db, inner)
