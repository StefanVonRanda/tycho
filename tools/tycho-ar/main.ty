# tycho-ar -- a deterministic archiver, in Tycho.
#
# Walks a directory, and for every regular file records its relative path, its
# size, its mtime and the sha256 of its contents; gzips the contents; and writes
# one archive file. `c` creates, `t` lists, `x` extracts.
#
# Build and run, from the repo root:
#     ./tychoc tools/tycho-ar/main.ty -o build/tycho-ar
#     ./build/tycho-ar c out.tyar some/dir
#     ./build/tycho-ar t out.tyar
#     ./build/tycho-ar x out.tyar some/dest
#
# WHY THIS IS A DIRECTORY AND NOT A FLAT `tools/tycho-ar.ty`. A program that
# imports `core:*` needs a `package` header, and a `package` header makes tychoc
# compile the whole containing directory as one unit -- so a flat file in
# `tools/` would pull `tools/lsp.ty`, `tools/tychofmt.ty` and `tools/tycho.ty`
# into this program. `tools/prunner/` is a directory for exactly that reason and
# this follows it. (Confirmed: `Makefile:128` builds prunner from
# `tools/prunner/main.ty`, a lone file in its own directory.)
#
# ===========================================================================
# THE FORMAT
# ===========================================================================
#
# Everything is written little-endian-free: all numbers are ASCII decimal, all
# structural markers are ASCII literals, and the only binary spans are the file
# payloads, each preceded by its own byte count. That is deliberate -- a format
# whose framing is text can be eyeballed with `head -c`, and its corruption
# cases can be produced by hand for the gate of the tycho-ar plan
# phase 2.
#
#     archive := magic member* trailer
#
#     magic   := "TYAR1\n"
#
#     member  := "F " size " " mtime " " clen " " plen " " sha " " csha "\n"
#                path                          -- exactly plen bytes, raw
#                "\n"
#                payload                       -- exactly clen bytes, gzip
#                "\nTYAR-M\n"                  -- the member footer, 8 bytes
#
#     trailer := "TYAR-DIR " count "\nTYAR-END\n"
#
#       size   the ORIGINAL byte length of the file, ASCII decimal
#       mtime  st_mtime as a Unix epoch second, ASCII decimal (see MTIME below)
#       clen   the byte length of the gzip payload, ASCII decimal
#       plen   the byte length of `path`, ASCII decimal
#       sha    sha256 of the ORIGINAL contents, 64 lowercase hex chars
#       csha   sha256 of the GZIP PAYLOAD, 64 lowercase hex chars
#       path   the file's path relative to the walked root, raw bytes
#       count  the number of members, ASCII decimal
#
# FINDING THE MEMBER BOUNDARY WITHOUT TRUSTING `clen`. This is the property the
# format is built around, because a reader that can only believe the length
# field is a reader that cannot tell a truncated archive from a short one. There
# are three independent checks and a truncation has to defeat all three:
#
#   1. THE MEMBER FOOTER. After skipping `clen` payload bytes the next 8 bytes
#      must be exactly "\nTYAR-M\n". A `clen` that is wrong -- because the field
#      was damaged, or because the archive was cut short -- lands the cursor
#      somewhere else, and the odds that arbitrary bytes spell the footer are
#      nil. This is what makes `clen` a HINT that gets confirmed rather than a
#      promise that gets believed.
#   2. `csha` OVER THE PAYLOAD. A payload whose length is right but whose bytes
#      were flipped passes check 1 and fails here. Checked before decompression,
#      so a reader never hands damaged input to zlib in the first place.
#   3. `size` AND `sha` OVER THE INFLATED BYTES. This is the check that keeps a
#      corrupt member distinguishable from an empty one, and it is the one the
#      whole format was designed around. See EMPTY VERSUS CORRUPT below.
#
# And the trailer's `count` catches the one thing per-member checks cannot: a
# whole member sheared off the end. Nine members plus a trailer saying ten is a
# truncation that every individual member survived.
#
# EVERY ONE OF THOSE CHECKS IS AN EXPLICIT LENGTH TEST, NOT AN EXPECTED ABORT.
# A `bytes` slice CLAMPS its bounds rather than aborting
# (`docs/spec/03-types.md:139`), exactly as a string slice does -- so
# `data[p:p + 8]` on a truncated archive quietly yields three bytes instead of
# trapping. A reader that treated the slice as a bounds check would read a short
# footer, compare it against the real one, and get the right answer by accident;
# a reader that sliced a payload and hashed it would hash a prefix. Every read
# below therefore checks `len(...)` of what it got against what it asked for
# BEFORE using it. The clamp is the right default for a text tool and a trap for
# a format parser, and the difference is worth naming.
#
# ===========================================================================
# EMPTY VERSUS CORRUPT -- what the tycho-ar plan settled
# ===========================================================================
#
# `compress.decompress` FAILS CLOSED TO EMPTY BYTES on damaged input: every error
# path in `corelib/compress/compress_shim.c@zx_decompress` sets `*outlen = 0` and
# returns, and a legitimately empty member inflates to zero bytes too. So the
# worry was that a corrupt member and an empty file are indistinguishable, which
# would make an archiver silently replace damaged data with an empty file -- the
# worst thing a tool trusted to store bytes can do.
#
# MEASURED, not reasoned about. Compressing "" and inflating it, inflating a
# 65-byte payload with byte 12 XORed by 0xFF, and inflating that payload cut in
# half all produce the SAME answer:
#
#     legit-empty:  inflated len=0  sha=e3b0c442…7852b855
#     corrupt    :  inflated len=0  sha=e3b0c442…7852b855
#     truncated  :  inflated len=0  sha=e3b0c442…7852b855
#
# The return value carries NO discriminator at all -- not a length, not a sha,
# not an error. Everything that tells the two apart has to come from outside the
# payload, and that is what the header fields are for. Three of them, in the
# order the reader applies them:
#
#   `csha` FIRST, over the raw gzip payload, BEFORE decompression. A flipped byte
#   dies here, and the reader never hands damaged input to zlib at all. This is
#   also what stops check 2 from ever being the only line of defence: a corrupt
#   member whose `size` happens to be 0 would pass the size check (an empty file
#   is what it inflates to, and that is even the right content) -- csha catches
#   it first, on the bytes themselves.
#
#   `size` SECOND, against `len(inflated)`. This is the actual discriminator the
#   Pre-flight asked for. A zero-byte file is `size 0`; a member that inflated to
#   nothing because it was damaged has a nonzero `size` that does not match, and
#   is rejected instead of extracted. Cheap, and it is a length comparison rather
#   than a hash, so it fires before any work.
#
#   `sha` THIRD, over the inflated bytes. Catches the residue: an inflate that
#   produced the right NUMBER of bytes but the wrong ones.
#
# A zero-byte file survives all three -- `size 0` and the sha256 of the empty
# string, e3b0c442… -- so the round trip keeps its empty files, which is the
# other half of getting this right. An archiver that rejected empty files to be
# safe would have failed the same test from the other side.
#
# ===========================================================================
# CHUNKED HASHING, AND WHY THE HASHER LIVES HERE
# ===========================================================================
#
# A file's contents are hashed CHUNK bytes at a time through `io.read_at`, never
# read whole to be hashed. What that costs and what it buys is worth stating
# exactly, because the obvious summary -- "the archiver no longer holds a whole
# file" -- is FALSE and this phase does not make it true.
#
# WHY THE STREAMING SHA-256 IS IN THIS FILE AND NOT CALLED FROM `core:sha256`.
# `core:sha256` exposes exactly two entry points over a message, `digest(msg)`
# and `hex(msg)`, and both take the WHOLE message as one `string`. There is no
# init/update/final anywhere in the corelib -- verified by grepping
# `corelib/sha256`, `corelib/md5`, `corelib/crypto` and `corelib/hash` for
# sha256_init/update/final, EVP_DigestUpdate and `fn init`/`fn update`/`fn final`:
# zero hits. `core:crypto`'s `cx_sha256_hex` is one-shot too, and wants its
# message HEX-ENCODED, which would double the buffer this is trying to bound.
#
# AND THE ONE-SHOT SHAPE IS NOT AN OVERSIGHT -- the language makes it the natural
# one. A streaming digest is a mutable state threaded through many calls, and a
# Tycho parameter is BORROWED READ-ONLY: `fn bump(a: [int]): a[0] = 1` is
# `error: cannot mutate parameter 'a' (it is borrowed read-only; copy it with
# `y := a` first)`, and that suggested copy is a real copy -- `c := a` then
# `c[0] = 999` leaves `a[0]` alone. So an `update(state, chunk)` either returns a
# fresh state per 64-byte block or takes `inout`. `inout` is the answer, it works
# on `[u32]` and on `bytes`, and it forwards (`sha_feed` hands its own `&H`
# straight to `sha_block`) -- but it has to be reached for deliberately, and a
# one-shot function needs none of it. `core:sha256` never having grown a
# streaming form is the language's default showing through the library.
#
# THE PIECES WERE ALL REACHABLE, which is why this is ~60 lines and not a second
# SHA-256. `sha256.k_table`, `h_init`, `ch`, `maj`, `bigsig0/1`, `smallsig0/1`,
# `pow2` and `hex2` are all callable from here: a Tycho package has NO private
# top-level functions, so every helper `core:sha256` wrote for itself is public
# API whether it meant it or not. Not one constant is duplicated below -- the
# round table and the initial state come from `core:sha256` itself, so a fix
# there is a fix here. The only thing written here is the block loop and the
# padding, i.e. the part `digest` inlined into a single function because it had
# to.
#
# WHAT CHUNKING ACTUALLY CHANGED. `sha256.digest` expands its whole message into
# `buf := []int`, ONE MACHINE INT PER BYTE, before it processes a single block --
# so hashing an n-byte file allocated 8n bytes of int array on top of the n bytes
# of file. That expansion was the dominant term in this program's peak memory and
# it is GONE: `sha_block` indexes the `bytes` value directly, the only `[int]` is
# the 8-word state, and the largest live buffer in the hash path is one CHUNK.
#
# WHAT IT DID NOT CHANGE, said plainly so the win is not read as bigger than it
# is. `c` STILL HOLDS EACH FILE WHOLE, because `compress.compress` is
# `bytes -> bytes`: a one-shot with no streaming counterpart, exactly like
# `sha256.hex` was. The payload has to be materialised for the compressor no
# matter how the digest is computed, so PEAK MEMORY FOR `c` IS STILL O(file
# size) and chunked hashing did not fix it. It removed the 8x multiplier on top,
# not the file itself. Bounding that last term needs a streaming deflate, which
# is a `core:compress` change and not this program's to make.
#
# SO THE FILE IS READ TWICE -- once whole for the compressor, once in chunks for
# the digest -- and that is a deliberate trade rather than an oversight. Folding
# the two into one pass means growing a `bytes` by `+` per chunk, and `bytes +
# bytes` allocates and copies both sides, so accumulating a file in n/CHUNK
# pieces is quadratic. Two linear passes over a page-cache-warm file beat one
# quadratic one, and neither would be needed if the compressor could be fed
# incrementally.
#
# THE LOOP'S TERMINATION CONDITION IS DEFENDED, NOT ASSUMED, because both of the
# primitives involved answer out-of-range requests by shrugging rather than by
# failing. `io.read_at` CLAMPS ITS ALLOCATION TO THE FILE and returns `Ok` with
# ZERO BYTES for an offset at or past EOF (`corelib/io/io.ty@read_at`) -- an
# error condition that is not an `Err` -- and a `bytes` slice CLAMPS too, so
# neither a short read nor an over-long slice announces itself. A loop that
# simply asked for CHUNK bytes until it got fewer would therefore spin forever on
# a file that stopped yielding, or silently hash a prefix. Instead: the bound is
# `size`, taken from the same read the compressor is fed; each request is for
# `min(CHUNK, size - off)`, so a conforming read can never overshoot; a read
# returning 0 before `off == size` is FATAL rather than a loop exit, because at
# that point the file has changed under us and a digest over a prefix is exactly
# the silent corruption this program exists not to commit; and every iteration
# advances `off` by at least one byte or dies. The loop runs at most `size`
# times by construction.
#
# ONE THING IT STILL CANNOT DO: read the file atomically. `core:io` is
# path-based with no file handles, so the compressor's read and the digest's
# reads are separate `open(2)`s and a writer racing between them is detectable
# (the checks above) but not preventable.
#
# ===========================================================================
# WHY `t` PRINTS NOTHING BUT MEMBER LINES
# ===========================================================================
#
# There is no `eprintln`. The builtins are `println`, `die` (stderr, then exit 1)
# and `exit(n)`, so the only way to write to stderr is to terminate. A warning
# that does not terminate can only go to stdout -- and `t`'s stdout IS its data.
#
# The consequence is an interface decision, not a workaround: `t` IS ALL OR
# NOTHING. It verifies the framing, the paths, the footers, the payload digests
# and the trailer count for EVERY member before printing a single line; then it
# prints one line per member and nothing else. There is no summary line, no
# "listed 8 of 9", no "member 3 looks damaged" -- because every one of those
# would be a diagnostic sharing a stream with the listing, and a consumer reading
# `t`'s output cannot tell a diagnostic from a filename. A bad archive exits
# nonzero with the reason on stderr and an empty stdout, which is a signal a
# caller can actually act on.
#
# `t` does NOT inflate. Its checks stop at `csha`, which is where the evidence
# stops being free; `x` does the remaining two because it is producing the bytes
# anyway. So `t` proves an archive is INTACT and `x` proves it is CORRECT, and
# the split is honest about which is which.
#
# One thing `t` cannot fix, and it is POSIX's fault rather than the corelib's: a
# filename may contain a newline, so a line-oriented listing of such an archive
# is ambiguous by construction. The path is printed last on the line and printed
# raw. `x` is the interface that handles those names correctly; `t` is for eyes.
#
# `plen` is why the path is length-prefixed rather than newline-terminated. A
# POSIX filename may contain any byte but '/' and NUL -- including '\n'. A
# newline-terminated path would silently split such a name into a short path
# plus garbage, and the two paths that differ only by where the reader guessed
# the break would collide. Length-prefixed, a path containing a newline is
# stored and read back exactly.
#
# ===========================================================================
# DETERMINISM, AND THE THREE THINGS THAT COULD HAVE BROKEN IT
# ===========================================================================
#
# The property: archiving the same tree twice produces two byte-identical files.
# Three sources of nondeterminism had to be settled for that to hold.
#
#   ENTRY ORDER. `io.list` is `readdir(3)` (`runtime/tycho_rt.c@tycho_list_dir`),
#   which returns entries in whatever order the filesystem hands back -- hash
#   order on ext4, so it varies with inode numbers and is NOT stable across two
#   trees with the same contents. Every path is collected first and the whole
#   list is sorted with `sort.asc` before a single byte is written. String
#   comparison is `memcmp` over the length header
#   (`runtime/tycho_rt.c@tycho_str_cmp`), so the order is unsigned-byte
#   lexicographic and does not depend on locale.
#
#   THE GZIP HEADER'S MTIME FIELD. RFC 1952 puts a 4-byte modification time in
#   every gzip header, and a compressor that fills it in makes every archive
#   differ from the last. zlib's `deflateInit2` writes zero there unless the
#   caller supplies a `gz_header`, and `corelib/compress/compress_shim.c@zx_compress`
#   supplies none -- so the payloads are byte-stable. This was checked rather
#   than assumed; it is the one place where determinism depended on a default in
#   a library three layers down.
#
#   MTIME IN THE MEMBER HEADER, which is stored, and here is the decision.
#   `io.mtime` returns the real st_mtime. Storing it means an archive of the SAME
#   tree is byte-identical across runs -- mtimes do not move when nothing writes
#   -- but an archive of a COPIED tree is not, because `cp` gives the copy new
#   mtimes. The alternative, storing a constant zero, would make copies match at
#   the cost of an archiver that cannot restore what it was handed.
#
#   The mtime is stored. An archiver's job is to give back the tree it was given,
#   and mtime is part of that tree; dropping it to make an unrelated pair of
#   directories compare equal is trading a property the tool is for against a
#   property nothing asked for. And the weaker guarantee is the honest one: two
#   runs over one tree are identical, which is exactly what the gate asserts,
#   and content equality between two different trees is a question about the
#   `sha` fields, which a reader can ask directly.
#
# ===========================================================================
# WHAT THIS FORMAT DOES NOT STORE, said plainly so no one infers it
# ===========================================================================
#
#   * PERMISSION BITS. An extracted file gets the umask default. A restored
#     executable is not executable.
#   * EMPTY DIRECTORIES. Only regular files are members, so a directory with no
#     files under it does not survive a round trip.
#   * SYMLINKS, as links. `io.is_dir` is `stat(2)`, which follows them, so a
#     symlink to a file is archived as an ordinary file holding a copy of the
#     target's bytes, and a symlink to a directory is walked into. A symlink
#     cycle would therefore not terminate. Nothing here calls `lstat(2)`,
#     because the corelib does not expose one.
#   * HARD LINKS, as links. Two names for one inode become two members.
#
# Each of those is a real archiver feature and each needs a corelib call that
# does not exist today. They are named here rather than discovered later.
#
# AND ONE THAT IS STORED BUT CANNOT BE RESTORED: mtime. Every member header
# carries the real st_mtime, `t` prints it, and `x` DROPS IT -- an extracted file
# gets the time it was written. `core:io` has `io.mtime` to read one and nothing
# to set one; grepping `corelib/io/io.ty` and `corelib/io/io_shim.c` for
# utimensat/utimes/chmod finds nothing. This is a different shape of gap from the
# four above: those are data the format never captured, this is data the format
# captured faithfully and the extractor is unable to apply. `diff -r` does not
# compare mtimes, so the round-trip gate stays green over a hole a user would
# notice on the first restore. Said here so the green is not read as a promise.

package main

import "core:cli"
import "core:compress"
import "core:io"
import "core:path"
import "core:sha256"
import "core:sort"

const MAGIC   = "TYAR1\n"
const MFOOTER = "\nTYAR-M\n"
const TRAILER = "TYAR-END\n"

# The read granularity for hashing. A MULTIPLE OF 64 on purpose: SHA-256's block
# is 64 bytes, so a chunk this size is a whole number of blocks and the carry
# between chunks is empty for every read but the last. Correctness does not
# depend on that -- `sha_feed` carries a partial block either way -- but it means
# the common path never copies.
const CHUNK = 65536

# One regular file, as the archive will record it. Built entirely before
# anything is written, so a read failure aborts before a partial archive lands.
struct Member:
    rel:   string    # path relative to the walked root
    size:  int       # original byte length
    mtime: int       # Unix epoch seconds
    sha:   string    # sha256 of the original contents, hex
    csha:  string    # sha256 of the gzip payload, hex
    data:  bytes     # the gzip payload

# ---------------------------------------------------------------------------
# CHUNKED SHA-256 -- see CHUNKED HASHING above for why it is here at all
# ---------------------------------------------------------------------------

# Fold ONE 64-byte block, `src[base .. base+64)`, into the running state `H`.
# The caller guarantees those 64 bytes exist; this indexes `src` directly rather
# than copying it into an `[int]`, which is the whole point.
fn sha_block(H: inout [u32], K: [u32], src: bytes, base: int):
    W := []u32
    t := 0
    for t < 16:
        q := base + t * 4
        push(W, (to_u32(src[q]) << 24) | (to_u32(src[q + 1]) << 16) | (to_u32(src[q + 2]) << 8) | to_u32(src[q + 3]))
        t = t + 1
    for t < 64:
        push(W, sha256.smallsig1(W[t - 2]) + W[t - 7] + sha256.smallsig0(W[t - 15]) + W[t - 16])
        t = t + 1
    a := H[0]
    b := H[1]
    c := H[2]
    d := H[3]
    e := H[4]
    f := H[5]
    g := H[6]
    h := H[7]
    i := 0
    for i < 64:
        t1 := h + sha256.bigsig1(e) + sha256.ch(e, f, g) + K[i] + W[i]
        t2 := sha256.bigsig0(a) + sha256.maj(a, b, c)
        h = g
        g = f
        f = e
        e = d + t1
        d = c
        c = b
        b = a
        a = t1 + t2
        i = i + 1
    H[0] = H[0] + a
    H[1] = H[1] + b
    H[2] = H[2] + c
    H[3] = H[3] + d
    H[4] = H[4] + e
    H[5] = H[5] + f
    H[6] = H[6] + g
    H[7] = H[7] + h

# Absorb `src`, leaving whatever did not fill a block in `pending` (always < 64
# bytes). `inout` on both, because a Tycho parameter is borrowed read-only and a
# streaming state has to be mutated by the callee -- see CHUNKED HASHING above.
fn sha_feed(H: inout [u32], pending: inout bytes, K: [u32], src: bytes):
    # Only concatenate when there really is a carry: `bytes + bytes` copies both
    # sides, and with CHUNK a multiple of 64 this branch is not taken mid-file.
    work := src
    if len(pending) > 0:
        work = pending + src
    nb := len(work) / 64
    for k := 0; k < nb; k += 1:
        sha_block(&H, K, work, k * 64)
    pending = work[nb * 64:len(work)]

# Pad per FIPS 180-4 and emit the 64-char hex digest. `total` is the number of
# message bytes fed, which the caller knows and the state does not carry.
# The padding is built as a `string` because `chr(n)` is the only way to make a
# byte from a number, and a Tycho string holds a 0x00 like any other byte.
fn sha_finish(H: inout [u32], K: [u32], pending: bytes, total: int) -> string:
    tail := to_str(pending) + chr(128)
    zeros := (56 - (len(tail) % 64) + 64) % 64
    for i := 0; i < zeros; i += 1:
        tail = tail + chr(0)
    bitlen := total * 8
    sh := 56
    for i := 0; i < 8; i += 1:
        tail = tail + chr((bitlen / sha256.pow2(sh)) % 256)
        sh = sh - 8
    tb := to_bytes(tail)
    nb := len(tb) / 64
    for k := 0; k < nb; k += 1:
        sha_block(&H, K, tb, k * 64)
    out := ""
    for vi := 0; vi < 8; vi += 1:
        v := H[vi]
        out = out + sha256.hex2(to_int((v >> 24) & 255)) + sha256.hex2(to_int((v >> 16) & 255))
        out = out + sha256.hex2(to_int((v >> 8) & 255)) + sha256.hex2(to_int(v & 255))
    return out

# sha256 of a value already in memory, a block at a time. Replaces
# `sha256.hex(to_str(b))` at every call site: same digest, without expanding the
# message into one `int` per byte first. Note that the bytes/string seam is gone
# from the hash path entirely -- it existed only because `core:sha256`'s one-shot
# entry point insists on a `string`.
fn sha_bytes(b: bytes) -> string:
    K := sha256.k_table()
    H := sha256.h_init()
    pending := to_bytes("")
    sha_feed(&H, &pending, K, b)
    return sha_finish(&H, K, pending, len(b))

# sha256 of a FILE, read CHUNK bytes at a time. `size` is the authoritative
# length -- the caller passes the length of the buffer it compressed, so the
# digest and the payload provably describe the same byte count. See CHUNKED
# HASHING above for why the termination condition looks like this: `io.read_at`
# answers an at-or-past-EOF offset with `Ok` and zero bytes rather than an error,
# so "got nothing" cannot be a loop exit.
fn sha_file(abs: string, size: int) -> string:
    K := sha256.k_table()
    H := sha256.h_init()
    pending := to_bytes("")
    off := 0
    for off < size:
        want := size - off
        if want > CHUNK:
            want = CHUNK
        chunk := to_bytes("")
        match io.read_at(abs, off, want):
            Ok(b):
                chunk = b
            Err(e):
                die("tycho-ar: cannot read " + abs + " at offset " + str(off))
        n := len(chunk)
        # ZERO PROGRESS IS FATAL, not a break. We are inside `off < size`, so
        # there are bytes left to hash and the file no longer has them: it was
        # truncated between the compressor's read and this one. Hashing the
        # prefix and calling it the file is the corruption this program exists
        # not to commit.
        if n == 0:
            die("tycho-ar: " + abs + ": read 0 bytes at offset " + str(off) + " of " + str(size) + " (file changed under us)")
        # Cannot happen -- the request was clamped to `size - off` -- but a read
        # that returns more than it was asked for would walk `off` past `size`
        # and hash the wrong span, so it is checked rather than trusted.
        if n > want:
            die("tycho-ar: " + abs + ": read " + str(n) + " bytes at offset " + str(off) + ", asked for " + str(want))
        sha_feed(&H, &pending, K, chunk)
        off = off + n
    return sha_finish(&H, K, pending, size)

# Every regular file under `root`, as paths relative to `root`, in `readdir`
# order -- the caller sorts. Iterative rather than recursive because the
# directory queue IS the recursion, and a queue can be read.
fn walk(root: string) -> [string]:
    out := []string
    dirs := []string
    push(dirs, "")            # "" is the root itself
    i := 0
    for i < len(dirs):
        rel := dirs[i]
        i = i + 1
        abs := root
        if rel != "":
            abs = path.join(root, rel)
        names := io.list(abs)
        for j := 0; j < len(names); j += 1:
            child_rel := names[j]
            if rel != "":
                child_rel = rel + "/" + names[j]
            child_abs := path.join(root, child_rel)
            isdir := false
            match io.is_dir(child_abs):
                Ok(b):
                    isdir = b
                Err(e):
                    die("tycho-ar: cannot stat " + child_abs)
            if isdir:
                push(dirs, child_rel)
            else:
                push(out, child_rel)
    return out

# Read, hash and compress one file into a Member. Aborts on an unreadable file
# rather than recording a member it could not read -- an archiver that stores a
# guess is worse than one that stops.
fn member_of(root: string, rel: string) -> Member:
    abs := path.join(root, rel)
    raw := to_bytes("")
    match io.read_bytes(abs):
        Ok(b):
            raw = b
        Err(e):
            die("tycho-ar: cannot read " + abs)
    mt := 0
    match io.mtime(abs):
        Ok(t):
            mt = t
        Err(e):
            die("tycho-ar: cannot stat " + abs)
    # THE bytes/string SEAM IS GONE FROM THE HASH PATH. It existed because
    # `sha256.hex` takes a `string` while `io.read_bytes` yields `bytes`, so
    # every file was hashed as `sha256.hex(to_str(raw))`. `sha_file`/`sha_bytes`
    # take `bytes`, so no crossing happens at all -- the seam was an artefact of
    # the corelib's one-shot entry point, not of the data. (The crossing was
    # never lossy: `to_str` is a zero-cost reinterpret of the same
    # length-headered buffer, docs/spec/06-conversions.md, and all eight fixture
    # digests -- interior NULs and 100 KB of /dev/urandom included -- matched
    # `sha256sum` exactly. It is simply no longer needed.)
    #
    # `len(raw)` is passed as the length to hash so the digest covers exactly the
    # byte count that was compressed. The contents are re-read in chunks rather
    # than hashed out of `raw`; see CHUNKED HASHING above for why both reads
    # exist and what bounds the loop.
    packed := compress.compress(raw)
    return Member(rel, len(raw), mt, sha_file(abs, len(raw)), sha_bytes(packed), packed)

fn encode_member(m: Member) -> bytes:
    # Written as three statements, not one expression over three lines: an
    # expression here cannot be continued onto the next line even with a trailing
    # `+`, and the diagnostic is "error: expected an expression" pointing at the
    # column after the operator.
    head := "F " + str(m.size) + " " + str(m.mtime) + " " + str(len(m.data))
    head = head + " " + str(len(m.rel)) + " " + m.sha + " " + m.csha + "\n"
    head = head + m.rel + "\n"
    return to_bytes(head) + m.data + to_bytes(MFOOTER)

fn create(archive: string, root: string):
    isdir := false
    match io.is_dir(root):
        Ok(b):
            isdir = b
        Err(e):
            die("tycho-ar: no such directory: " + root)
    if not isdir:
        die("tycho-ar: not a directory: " + root)

    # SORTED BEFORE ANYTHING IS WRITTEN. This one line is the determinism
    # guarantee; see THE FORMAT above for why `readdir` order cannot be trusted.
    files := sort.asc(walk(root))

    out := to_bytes(MAGIC)
    for i := 0; i < len(files); i += 1:
        out = out + encode_member(member_of(root, files[i]))
    out = out + to_bytes("TYAR-DIR " + str(len(files)) + "\n" + TRAILER)

    # `io.write` takes a `string`, and `tycho_write_file`
    # (`runtime/tycho_rt.c@tycho_write_file`) fwrites the header length to a "wb"
    # handle -- so this writes the payload bytes verbatim, NULs and all.
    if not io.write(archive, to_str(out)):
        die("tycho-ar: cannot write " + archive)
    println("tycho-ar: " + archive + ": " + str(len(files)) + " files, " + str(len(out)) + " bytes")

# ---------------------------------------------------------------------------
# READING
# ---------------------------------------------------------------------------

# One member as the header describes it. `off` is the absolute offset of the
# gzip payload inside the archive, so `t` can verify every member without
# copying a single payload out.
struct Entry:
    rel:   string
    size:  int
    mtime: int
    clen:  int
    sha:   string
    csha:  string
    off:   int

# A STRICT decimal parser, and the reason it is not `strings.parse_int`.
# `strings.parse_int` FAILS OPEN: it returns 0 for the empty string and for a
# leading non-digit, and it stops at the first non-digit rather than objecting
# (`corelib/strings/strings.ty@parse_int`). Those are sane choices for parsing
# user input, where 0 is a fine default. They are the wrong choices for a length
# field in a format, where a damaged `clen` of "1x4" must be an error and not a
# silent 1 -- a wrong length that parses is exactly how a reader ends up hashing
# the wrong span. Returns -1 for anything that is not a non-empty run of ASCII
# digits, and for anything absurdly large.
fn parse_uint(s: string) -> int:
    if len(s) == 0:
        return -1
    v := 0
    for i := 0; i < len(s); i += 1:
        c := s[i]
        if c < 48 or c > 57:
            return -1
        v = v * 10 + (c - 48)
        if v > 1000000000000000000:
            return -1
    return v

# 64 lowercase hex digits, the shape `sha256.hex` produces. Checked so a damaged
# digest field is a parse error rather than a mismatch reported against garbage.
fn is_hex64(s: string) -> bool:
    if len(s) != 64:
        return false
    for i := 0; i < 64; i += 1:
        c := s[i]
        if (c < 48 or c > 57) and (c < 97 or c > 102):
            return false
    return true

# Offset of the next '\n' at or after `from`, searching at most `cap` bytes.
# The cap is a fail-closed bound, not an optimisation: a header line is at most
# 211 bytes (2 + four decimals + three spaces + two 64-char digests), so a scan
# that runs past 256 is looking at binary and should stop rather than sweep a
# hundred-kilobyte payload hunting for a byte that means nothing there.
fn find_nl(data: bytes, from: int, cap: int) -> int:
    stop := from + cap
    if stop > len(data):
        stop = len(data)
    i := from
    for i < stop:
        if data[i] == 10:
            return i
        i = i + 1
    return -1

fn read_archive(archive: string) -> bytes:
    data := to_bytes("")
    match io.read_bytes(archive):
        Ok(b):
            data = b
        Err(e):
            die("tycho-ar: cannot read " + archive)
    return data

# Parse and STRUCTURALLY VERIFY the whole archive: magic, every member's header,
# path, footer and payload digest, and the trailer. Nothing is returned unless
# everything checked out, so no caller ever holds a half-trusted archive. Does
# not inflate -- that is `x`'s job, and the last two checks with it.
fn parse(archive: string, data: bytes) -> [Entry]:
    out := []Entry
    if len(data) < len(MAGIC) or to_str(data[0:len(MAGIC)]) != MAGIC:
        die("tycho-ar: " + archive + ": not a tycho-ar archive (bad magic)")
    p := len(MAGIC)
    for p < len(data):
        if to_str(data[p:p + 9]) == "TYAR-DIR ":
            break
        who := "member " + str(len(out))
        if to_str(data[p:p + 2]) != "F ":
            die("tycho-ar: " + archive + ": " + who + ": no record marker at byte " + str(p))
        nl := find_nl(data, p, 256)
        if nl < 0:
            die("tycho-ar: " + archive + ": " + who + ": unterminated header at byte " + str(p))
        f := split(to_str(data[p:nl]), " ")
        if len(f) != 7:
            die("tycho-ar: " + archive + ": " + who + ": header has " + str(len(f)) + " fields, want 7")
        size := parse_uint(f[1])
        mtime := parse_uint(f[2])
        clen := parse_uint(f[3])
        plen := parse_uint(f[4])
        if size < 0 or mtime < 0 or clen < 0 or plen < 0:
            die("tycho-ar: " + archive + ": " + who + ": header has a non-numeric length field")
        if not is_hex64(f[5]) or not is_hex64(f[6]):
            die("tycho-ar: " + archive + ": " + who + ": header digest is not 64 hex digits")
        # THE PATH. Length-prefixed, so a '\n' inside a filename is data. The
        # `len(rel) != plen` test is the truncation check -- the slice clamps.
        ps := nl + 1
        pe := ps + plen
        if pe >= len(data):
            die("tycho-ar: " + archive + ": " + who + ": truncated inside the path")
        rel := to_str(data[ps:pe])
        if len(rel) != plen:
            die("tycho-ar: " + archive + ": " + who + ": path is " + str(len(rel)) + " bytes, header says " + str(plen))
        if data[pe] != 10:
            die("tycho-ar: " + archive + ": " + who + ": path is not newline-terminated (plen is wrong)")
        # THE PAYLOAD, then the footer that confirms `clen` was telling the truth.
        ds := pe + 1
        de := ds + clen
        if de + len(MFOOTER) > len(data):
            die("tycho-ar: " + archive + ": " + who + ": truncated inside the payload")
        payload := data[ds:de]
        if len(payload) != clen:
            die("tycho-ar: " + archive + ": " + who + ": payload is " + str(len(payload)) + " bytes, header says " + str(clen))
        if to_str(data[de:de + len(MFOOTER)]) != MFOOTER:
            die("tycho-ar: " + archive + ": " + who + ": member footer missing (clen is wrong, or the payload was cut)")
        if sha_bytes(payload) != f[6]:
            die("tycho-ar: " + archive + ": " + who + " (" + rel + "): payload digest mismatch (csha)")
        push(out, Entry(rel, size, mtime, clen, f[5], f[6], ds))
        p = de + len(MFOOTER)
    # THE TRAILER. Reached either by `break` or by running out of bytes, and the
    # same test settles both: if the trailer is not here, the archive was cut.
    if to_str(data[p:p + 9]) != "TYAR-DIR ":
        die("tycho-ar: " + archive + ": truncated (no trailer after " + str(len(out)) + " members)")
    tnl := find_nl(data, p, 256)
    if tnl < 0:
        die("tycho-ar: " + archive + ": unterminated trailer")
    tline := to_str(data[p:tnl])
    count := parse_uint(substr(tline, 9, len(tline)))
    if count < 0:
        die("tycho-ar: " + archive + ": trailer count is not a number")
    # The one truncation every per-member check survives: a whole member gone.
    if count != len(out):
        die("tycho-ar: " + archive + ": trailer says " + str(count) + " members, found " + str(len(out)))
    es := tnl + 1
    if es + len(TRAILER) != len(data) or to_str(data[es:es + len(TRAILER)]) != TRAILER:
        die("tycho-ar: " + archive + ": archive does not end exactly at TYAR-END")
    return out

# `io.make_dir` is ONE level -- `mkdir(2)` and nothing else
# (`corelib/io/io_shim.c@iox_make_dir`), which is the right primitive and not
# the one an extractor wants. There is no `mkdir -p` in the corelib, so the
# chain is built here a component at a time. `Ok(false)` means "already a
# directory", which is a success: extracting ten files into one subdirectory
# calls this ten times and creates it once.
fn mkdir_p(p: string):
    if len(p) == 0 or p == "." or p == "/":
        return
    rooted := p[0] == 47
    parts := split(p, "/")
    cur := ""
    for i := 0; i < len(parts); i += 1:
        seg := parts[i]
        if len(seg) == 0 or seg == ".":
            continue
        if len(cur) == 0:
            if rooted:
                cur = "/" + seg
            else:
                cur = seg
        else:
            cur = cur + "/" + seg
        # `Ok(_)` because BOTH booleans are successes -- true created it, false
        # it was already a directory -- and there is nothing to do with either.
        # The arm is `continue` rather than empty because an arm with no body is
        # `error: expected an indented block`; the match is the last thing in the
        # loop, so `continue` is exactly "nothing more to do here".
        match io.make_dir(cur):
            Ok(_):
                continue
            Err(e):
                die("tycho-ar: cannot create directory " + cur)

# LIST. Every member is verified before the first line is printed, and nothing
# but member lines is printed -- see WHY `t` PRINTS NOTHING BUT MEMBER LINES.
fn cmd_t(archive: string):
    entries := parse(archive, read_archive(archive))
    for i := 0; i < len(entries); i += 1:
        e := entries[i]
        line := str(e.size) + " " + str(e.mtime) + " " + e.sha + " " + e.rel
        println(line)

# EXTRACT.
fn cmd_x(archive: string, dest: string):
    data := read_archive(archive)
    entries := parse(archive, data)

    # EVERY PATH IS CHECKED BEFORE ANY FILE IS WRITTEN. `path.safe_join` returns
    # "" for a member path that is absolute or climbs out of `dest` with ".."
    # (`corelib/path/path.ty@safe_join`), and that refusal is fatal. Doing the
    # whole sweep first is the difference between "refused" and "refused after
    # writing eight files": a hostile archive that puts its escape in the last
    # member must not get the first eight extracted before anyone objects.
    targets := []string
    for i := 0; i < len(entries); i += 1:
        t := path.safe_join(dest, entries[i].rel)
        if t == "":
            die("tycho-ar: " + archive + ": refusing member " + str(i) + ": path escapes the destination: " + entries[i].rel)
        push(targets, t)

    # WHAT IS AND IS NOT ATOMIC, said plainly. Paths are ALL validated above
    # before one byte is written, so a hostile archive cannot get its first
    # members extracted before the reader reaches the escape in its last one.
    # Content is verified per member as it is written, so a member that fails
    # the inflate checks below leaves the members before it on disk and exits
    # nonzero. That is deliberate: verifying every payload into memory first
    # would hold the whole inflated archive at once. It is also nearly
    # unreachable by accident -- `parse` already matched `csha` against every
    # payload, so getting here means the gzip bytes are exactly what the writer
    # digested and still do not inflate to what the header claims, which is
    # forgery rather than damage. A damaged archive is caught before any write.
    mkdir_p(dest)
    for i := 0; i < len(entries); i += 1:
        e := entries[i]
        raw := compress.decompress(data[e.off:e.off + e.clen])
        # THE EMPTY-VERSUS-CORRUPT CHECK. `decompress` fails closed to empty
        # bytes and says nothing else, so `size` is the only thing that can tell
        # a damaged member from a zero-byte file. Length first, digest second.
        if len(raw) != e.size:
            die("tycho-ar: " + archive + ": " + e.rel + ": inflated to " + str(len(raw)) + " bytes, header says " + str(e.size) + " (corrupt payload)")
        if sha_bytes(raw) != e.sha:
            die("tycho-ar: " + archive + ": " + e.rel + ": content digest mismatch (sha)")
        mkdir_p(path.dir(targets[i]))
        # `io.write` takes a `string`; `tycho_write_file` is length-header-driven
        # (`runtime/tycho_rt.c@tycho_write_file`), so NULs survive.
        if not io.write(targets[i], to_str(raw)):
            die("tycho-ar: cannot write " + targets[i])
    println("tycho-ar: " + dest + ": " + str(len(entries)) + " files extracted")

fn usage():
    println("usage: tycho-ar c <archive> <dir>")
    println("       tycho-ar t <archive>")
    println("       tycho-ar x <archive> <dest>")
    println("")
    println("  c   create <archive> from every regular file under <dir>")
    println("  t   list <archive> as: size mtime sha256 path")
    println("  x   extract <archive> under <dest>")
    println("")
    println("Entries are stored in sorted path order, so archiving one tree")
    println("twice produces two byte-identical files. See the format comment")
    println("at the top of tools/tycho-ar/main.ty.")

fn main():
    av := cli.argv()
    if len(av) == 0 or av[0] == "-h" or av[0] == "--help":
        usage()
        exit(0)
    cmd := av[0]
    if cmd == "c":
        if len(av) != 3:
            die("tycho-ar: c takes exactly <archive> and <dir> (try --help)")
        create(av[1], av[2])
    elif cmd == "t":
        if len(av) != 2:
            die("tycho-ar: t takes exactly <archive> (try --help)")
        cmd_t(av[1])
    elif cmd == "x":
        if len(av) != 3:
            die("tycho-ar: x takes exactly <archive> and <dest> (try --help)")
        cmd_x(av[1], av[2])
    else:
        die("tycho-ar: unknown command: " + cmd + " (try --help)")
