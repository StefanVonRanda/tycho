package main

import "core:cli"
import "core:csv"
import "core:decimal"
import "core:io"
import "core:json"
import "core:strings"

# ---------------------------------------------------------------------------
# tokens
# ---------------------------------------------------------------------------

const T_EOF   = 0
const T_INT   = 1
const T_DEC   = 2
const T_STR   = 3
const T_IDENT = 4        # a bare word: a keyword, a column, or a source path
const T_PUNCT = 5        # an operator, a parenthesis, a comma, or `*`

struct Tok:
    kind: int
    text: string         # the token's value: raw identifier, decoded string body, operator
    low:  string         # `text` ASCII-lowercased; keyword and operator matching uses this
    off:  int            # byte offset of the token's first byte in the query text

# A parse or lex failure. Carried as the `E` of every `Result` in the parser.
struct PErr:
    msg: string          # what was expected, in the reader's terms
    tok: string          # the offending token as the user would recognise it
    off: int             # its byte offset in the query text

# A load or evaluation failure: a bad file, an unknown column, a comparison
# between kinds that do not compare, a division with no exact answer.
#
# WHY A SECOND ERROR TYPE, AND WHAT IT COSTS. A parse error has a byte offset
# into the query text and a runtime error does not -- it has a row number, or
# a column name, or nothing at all -- so folding them into one struct would
# mean a meaningless `off: 0` on two thirds of the messages. The cost is that
# `or_return` does not cross the boundary: no function may propagate from the
# parser into the evaluator or back, because `Result(T, PErr)` and
# `Result(T, RErr)` are different types and Tycho has no `From`-style error
# conversion to bridge them. In practice the two chains meet only in `main`,
# which `match`es each separately, so the cost is one extra `match` -- but a
# program with three error types and a call graph that mixed them would pay
# this at every boundary, and there is no language feature here to make that
# cheaper.
struct RErr:
    msg: string

# ---------------------------------------------------------------------------
# the value model and the AST
# ---------------------------------------------------------------------------

enum Value:
    VNull
    VBool(bool)
    VInt(int)
    VDec(decimal.Decimal)
    VStr(string)

# The AST. Recursion is DIRECT -- `EBin` holds two `Expr` payloads, not two
# indices into a node array -- which a probe established before this file was
# written: an enum declared in a program (not the corelib) may recurse both
# directly and through an array payload, and `match` may bind a payload and
# recurse into the same function -- `show_expr` and `eval` below both do it.
enum Expr:
    ELit(Value)
    ECol(string)
    EUn(string, Expr)          # op is "neg" or "not"
    EBin(string, Expr, Expr)   # op is the source spelling: "+", "==", "and", ...

# One `select` item. An enum rather than a struct with a `star: bool`, so that
# `select *` cannot carry a meaningless expression alongside the flag.
enum Item:
    IStar
    IExpr(Expr, string)        # expression, alias ("" when there is no `as`)

# One `order by` key.
struct OrdKey:
    expr: Expr
    desc: bool

struct Query:
    sel: [Item]
    src: string                # the source path, unquoted
    filt: Option(Expr)         # the `where` expression, if any
    ord:  [OrdKey]             # empty when there is no `order by`
    lim:  Option(int)          # the `limit`, if any

# ---------------------------------------------------------------------------
# the lexer
# ---------------------------------------------------------------------------

fn is_ws(c: int) -> bool:
    return c == 32 or c == 9 or c == 10 or c == 13

fn is_digit(c: int) -> bool:
    return c >= 48 and c <= 57

fn is_alpha(c: int) -> bool:
    return (c >= 97 and c <= 122) or (c >= 65 and c <= 90) or c == 95

# The continuation set for a bare word once it has hit a `.` or a `/`: this is
# what makes `sales.csv` and `data/sales.csv` single tokens. See the header.
fn is_pathchar(c: int) -> bool:
    return is_alpha(c) or is_digit(c) or c == 46 or c == 47

fn mktok(kind: int, text: string, off: int) -> Tok:
    return Tok(kind, text, strings.to_lower(text), off)

# A string literal. The opening quote byte is read from `s[pos]`; `\` escapes
# the next byte and nothing else is special. An unterminated literal is an
# error naming the offset of the OPENING quote, the byte the user has to fix.
#
# WHY THIS TAKES NO `start` PARAMETER, though it reads better with one. The
# obvious signature is `(s, n, start: int, pos: inout int)` and the obvious
# call is `lex_string(s, n, pos, &pos)` -- which the compiler refuses:
# "variable 'pos' is passed to an inout parameter and also by value in the same
# call ... the by-value copy would alias the inout'd value". That is a GOOD
# diagnostic and it is right, but the consequence is a shape rule worth knowing
# before writing a lexer here: a cursor threaded by `inout` can never also be
# handed over as a plain value in the same call, so every function that wants
# both "where I started" and "where I am" has to derive the first from the
# second on entry.
fn lex_string(s: string, n: int, pos: inout int) -> Result(Tok, PErr):
    start := pos
    quote := s[start]
    pos = start + 1
    body := ""
    for pos < n and s[pos] != quote:
        if s[pos] == 92 and pos + 1 < n:       # backslash
            pos = pos + 1
        body = body + chr(s[pos])
        pos = pos + 1
    if pos >= n:
        # Phrased as an expectation, not as a diagnosis, because `main` renders
        # every PErr as "unexpected token X (expected MSG)" and a reason read
        # into that slot comes out as nonsense.
        return Err(PErr("a closing " + chr(quote) + " for the string literal opened here", chr(quote), start))
    pos = pos + 1                              # skip the closing quote
    return Ok(mktok(T_STR, body, start))

# A number. Digits, then at most one `.` followed by at least one digit. A
# trailing `.` with no digit after it (`1.`) is rejected rather than silently
# read as `1` -- see the fail-closed note in the header.
fn lex_number(s: string, n: int, pos: inout int) -> Result(Tok, PErr):
    start := pos
    for pos < n and is_digit(s[pos]):
        pos = pos + 1
    kind := T_INT
    if pos < n and s[pos] == 46:               # '.'
        if pos + 1 >= n or not is_digit(s[pos + 1]):
            return Err(PErr("a digit after the decimal point", substr(s, start, pos + 1), start))
        kind = T_DEC
        pos = pos + 1
        for pos < n and is_digit(s[pos]):
            pos = pos + 1
    return Ok(mktok(kind, substr(s, start, pos), start))

fn lex(s: string) -> Result([Tok], PErr):
    n := len(s)
    out := []Tok
    pos := 0
    for pos < n:
        c := s[pos]
        if is_ws(c):
            pos = pos + 1
        elif c == 39 or c == 34:               # ' or "
            push(out, lex_string(s, n, &pos) or_return)
        elif is_digit(c):
            push(out, lex_number(s, n, &pos) or_return)
        elif is_alpha(c):
            start := pos
            for pos < n and (is_alpha(s[pos]) or is_digit(s[pos])):
                pos = pos + 1
            # A `.` or `/` here turns the word into a path token (header).
            if pos < n and (s[pos] == 46 or s[pos] == 47):
                for pos < n and is_pathchar(s[pos]):
                    pos = pos + 1
            push(out, mktok(T_IDENT, substr(s, start, pos), start))
        else:
            start := pos
            two := ""
            if pos + 1 < n:
                two = substr(s, pos, pos + 2)
            if two == "==" or two == "!=" or two == "<=" or two == ">=":
                pos = pos + 2
                push(out, mktok(T_PUNCT, two, start))
            elif c == 40 or c == 41 or c == 44 or c == 42 or c == 47 or c == 37 or c == 43 or c == 45 or c == 60 or c == 62:
                # ( ) , * / % + - < >
                pos = pos + 1
                push(out, mktok(T_PUNCT, chr(c), start))
            else:
                # Includes a lone `=`, which is NOT an alias for `==` here: an
                # assignment-looking comparison is a classic silent bug, so it
                # is named rather than guessed at.
                return Err(PErr("an operator or an operand", chr(c), start))
    push(out, mktok(T_EOF, "<eof>", n))
    return Ok(out)

# ---------------------------------------------------------------------------
# token-stream helpers
# ---------------------------------------------------------------------------

fn cur(ts: [Tok], p: int) -> Tok:
    if p < len(ts):
        return ts[p]
    return ts[len(ts) - 1]                     # the EOF token; the stream never runs out

fn is_kw(t: Tok, k: string) -> bool:
    return t.kind == T_IDENT and t.low == k

fn is_op(t: Tok, o: string) -> bool:
    return t.kind == T_PUNCT and t.text == o

# `text` is the decoded body for a T_STR, so a bad token that happens to be a
# string would be reported without its quotes. Put them back for the message.
fn shown(t: Tok) -> string:
    if t.kind == T_STR:
        return "\"" + t.text + "\""
    return t.text

fn oops(t: Tok, want: string) -> PErr:
    return PErr(want, shown(t), t.off)

# Consume a keyword or die trying. The `int` payload is the placeholder
# discussed in the header: `Result(void, E)` is not expressible, so a helper
# that only fails has to return something.
fn eat_kw(ts: [Tok], p: inout int, k: string, want: string) -> Result(int, PErr):
    if not is_kw(cur(ts, p), k):
        return Err(oops(cur(ts, p), want))
    p = p + 1
    return Ok(0)

# ---------------------------------------------------------------------------
# the expression parser (recursive descent, one function per precedence level)
# ---------------------------------------------------------------------------

fn parse_primary(ts: [Tok], p: inout int) -> Result(Expr, PErr):
    t := cur(ts, p)
    if t.kind == T_INT:
        p = p + 1
        return Ok(ELit(VInt(strings.parse_int(t.text))))
    if t.kind == T_DEC:
        p = p + 1
        return Ok(ELit(VDec(decimal.from_str(t.text))))
    if t.kind == T_STR:
        p = p + 1
        return Ok(ELit(VStr(t.text)))
    if is_op(t, "("):
        p = p + 1
        e := parse_expr(ts, &p) or_return
        if not is_op(cur(ts, p), ")"):
            return Err(oops(cur(ts, p), "`)` to close the group"))
        p = p + 1
        return Ok(e)
    if t.kind == T_IDENT:
        # The three word-shaped literals are checked BEFORE the column route,
        # so `true` is never a column reference. A column that really is named
        # `true` is unreachable, which is the accepted cost of not having
        # delimited identifiers (header).
        if t.low == "true":
            p = p + 1
            return Ok(ELit(VBool(true)))
        if t.low == "false":
            p = p + 1
            return Ok(ELit(VBool(false)))
        if t.low == "null":
            p = p + 1
            return Ok(ELit(VNull))
        if is_reserved(t.low):
            return Err(oops(t, "an operand (that word is a reserved keyword)"))
        p = p + 1
        return Ok(ECol(t.text))
    return Err(oops(t, "an operand"))

# The clause keywords cannot be column references, or `select a from x` would
# parse `from` as a column and then fail somewhere unhelpful. `and`/`or`/`not`
# are here too: they are operators, never operands.
fn is_reserved(w: string) -> bool:
    return w == "select" or w == "from" or w == "where" or w == "order" or w == "by" or w == "asc" or w == "desc" or w == "limit" or w == "as" or w == "and" or w == "or" or w == "not"

fn parse_unary(ts: [Tok], p: inout int) -> Result(Expr, PErr):
    t := cur(ts, p)
    if is_op(t, "-"):
        p = p + 1
        e := parse_unary(ts, &p) or_return
        return Ok(EUn("neg", e))
    if is_kw(t, "not"):
        p = p + 1
        e := parse_unary(ts, &p) or_return
        return Ok(EUn("not", e))
    return parse_primary(ts, &p)

fn parse_mul(ts: [Tok], p: inout int) -> Result(Expr, PErr):
    lhs := parse_unary(ts, &p) or_return
    for is_op(cur(ts, p), "*") or is_op(cur(ts, p), "/") or is_op(cur(ts, p), "%"):
        op := cur(ts, p).text
        p = p + 1
        rhs := parse_unary(ts, &p) or_return
        lhs = EBin(op, lhs, rhs)
    return Ok(lhs)

fn parse_add(ts: [Tok], p: inout int) -> Result(Expr, PErr):
    lhs := parse_mul(ts, &p) or_return
    for is_op(cur(ts, p), "+") or is_op(cur(ts, p), "-"):
        op := cur(ts, p).text
        p = p + 1
        rhs := parse_mul(ts, &p) or_return
        lhs = EBin(op, lhs, rhs)
    return Ok(lhs)

fn is_cmp(t: Tok) -> bool:
    return is_op(t, "==") or is_op(t, "!=") or is_op(t, "<") or is_op(t, "<=") or is_op(t, ">") or is_op(t, ">=")

fn parse_cmp(ts: [Tok], p: inout int) -> Result(Expr, PErr):
    lhs := parse_add(ts, &p) or_return
    for is_cmp(cur(ts, p)):
        op := cur(ts, p).text
        p = p + 1
        rhs := parse_add(ts, &p) or_return
        lhs = EBin(op, lhs, rhs)
    return Ok(lhs)

fn parse_and(ts: [Tok], p: inout int) -> Result(Expr, PErr):
    lhs := parse_cmp(ts, &p) or_return
    for is_kw(cur(ts, p), "and"):
        p = p + 1
        rhs := parse_cmp(ts, &p) or_return
        lhs = EBin("and", lhs, rhs)
    return Ok(lhs)

fn parse_expr(ts: [Tok], p: inout int) -> Result(Expr, PErr):
    lhs := parse_and(ts, &p) or_return
    for is_kw(cur(ts, p), "or"):
        p = p + 1
        rhs := parse_and(ts, &p) or_return
        lhs = EBin("or", lhs, rhs)
    return Ok(lhs)

# ---------------------------------------------------------------------------
# the clause parser
# ---------------------------------------------------------------------------

fn parse_item(ts: [Tok], p: inout int) -> Result(Item, PErr):
    # `*` is only a select-star in the item position, and only when it stands
    # alone: `select *` is the star, `select a * b` reaches this with `a` and
    # never sees the `*` here.
    if is_op(cur(ts, p), "*"):
        p = p + 1
        return Ok(IStar)
    e := parse_expr(ts, &p) or_return
    if is_kw(cur(ts, p), "as"):
        p = p + 1
        a := cur(ts, p)
        if a.kind != T_IDENT or is_reserved(a.low):
            return Err(oops(a, "an alias name after `as`"))
        p = p + 1
        return Ok(IExpr(e, a.text))
    return Ok(IExpr(e, ""))

fn parse_source(ts: [Tok], p: inout int) -> Result(string, PErr):
    t := cur(ts, p)
    if t.kind == T_STR:
        p = p + 1
        return Ok(t.text)
    if t.kind == T_IDENT and not is_reserved(t.low):
        p = p + 1
        return Ok(t.text)
    return Err(oops(t, "a source path after `from`"))

fn parse_key(ts: [Tok], p: inout int) -> Result(OrdKey, PErr):
    e := parse_expr(ts, &p) or_return
    if is_kw(cur(ts, p), "desc"):
        p = p + 1
        return Ok(OrdKey(e, true))
    if is_kw(cur(ts, p), "asc"):
        p = p + 1
        return Ok(OrdKey(e, false))
    return Ok(OrdKey(e, false))                # ascending is the default

fn parse_query(s: string) -> Result(Query, PErr):
    ts := lex(s) or_return
    p := 0

    _ := eat_kw(ts, &p, "select", "`select` at the start of the query") or_return
    sel := []Item
    push(sel, parse_item(ts, &p) or_return)
    for is_op(cur(ts, p), ","):
        p = p + 1
        push(sel, parse_item(ts, &p) or_return)

    _ = eat_kw(ts, &p, "from", "`from` after the select list") or_return
    src := parse_source(ts, &p) or_return

    filt := None
    if is_kw(cur(ts, p), "where"):
        p = p + 1
        filt = Some(parse_expr(ts, &p) or_return)

    ord := []OrdKey
    if is_kw(cur(ts, p), "order"):
        p = p + 1
        _ = eat_kw(ts, &p, "by", "`by` after `order`") or_return
        push(ord, parse_key(ts, &p) or_return)
        for is_op(cur(ts, p), ","):
            p = p + 1
            push(ord, parse_key(ts, &p) or_return)

    lim := None
    if is_kw(cur(ts, p), "limit"):
        p = p + 1
        t := cur(ts, p)
        if t.kind != T_INT:
            return Err(oops(t, "a non-negative integer after `limit`"))
        p = p + 1
        lim = Some(strings.parse_int(t.text))

    # The trailing check is what makes a typo in a clause keyword land here
    # with the right token rather than being silently ignored. Without it,
    # `select a from x limitt 3` would parse clean and drop `limitt 3`.
    if cur(ts, p).kind != T_EOF:
        return Err(oops(cur(ts, p), "the end of the query"))
    return Ok(Query(sel, src, filt, ord, lim))

# ---------------------------------------------------------------------------
# `--explain`: render the AST as an s-expression
# ---------------------------------------------------------------------------

fn esc(s: string) -> string:
    out := ""
    for i := 0; i < len(s); i += 1:
        c := s[i]
        if c == 34:
            out = out + "\\\""
        elif c == 92:
            out = out + "\\\\"
        elif c == 10:
            out = out + "\\n"
        elif c == 9:
            out = out + "\\t"
        else:
            out = out + chr(c)
    return out

fn show_value(v: Value) -> string:
    match v:
        VNull:
            return "null"
        VBool(b):
            if b:
                return "true"
            return "false"
        VInt(n):
            return str(n)
        VDec(d):
            return decimal.to_str(d)
        VStr(s):
            return "\"" + esc(s) + "\""

fn show_expr(e: Expr) -> string:
    match e:
        ELit(v):
            return show_value(v)
        ECol(name):
            return "(col " + name + ")"
        EUn(op, x):
            return "(" + op + " " + show_expr(x) + ")"
        EBin(op, l, r):
            return "(" + op + " " + show_expr(l) + " " + show_expr(r) + ")"

fn show_item(it: Item) -> string:
    match it:
        IStar:
            return "*"
        IExpr(e, alias):
            if alias == "":
                return show_expr(e)
            return "(as " + alias + " " + show_expr(e) + ")"

fn where_line(o: Option(Expr)) -> string:
    match o:
        Some(e):
            return "  (where " + show_expr(e) + ")"
        None:
            return ""

fn limit_line(o: Option(int)) -> string:
    match o:
        Some(n):
            return "  (limit " + str(n) + ")"
        None:
            return ""

fn explain(q: Query):
    println("(query")
    line := "  (select"
    for i := 0; i < len(q.sel); i += 1:
        line = line + " " + show_item(q.sel[i])
    println(line + ")")
    # The source is rendered QUOTED even though it usually needs no quotes:
    # `from 'has space.csv'` is legal, and a bare rendering of that path would
    # make `(from has space.csv)` -- three atoms where the AST has one.
    println("  (from \"" + esc(q.src) + "\")")
    w := where_line(q.filt)
    if w != "":
        println(w)
    if len(q.ord) > 0:
        line = "  (order"
        for i := 0; i < len(q.ord); i += 1:
            dir := "asc"
            if q.ord[i].desc:
                dir = "desc"
            line = line + " (key " + show_expr(q.ord[i].expr) + " " + dir + ")"
        println(line + ")")
    l := limit_line(q.lim)
    if l != "":
        println(l)
    println(")")

# ---------------------------------------------------------------------------
# values: kinds, rendering, and the comparisons
# ---------------------------------------------------------------------------

const K_NULL = 0
const K_BOOL = 1
const K_INT  = 2
const K_DEC  = 3
const K_STR  = 4

fn kind(v: Value) -> int:
    match v:
        VNull:
            return K_NULL
        VBool(b):
            return K_BOOL
        VInt(n):
            return K_INT
        VDec(d):
            return K_DEC
        VStr(s):
            return K_STR

fn kind_name(v: Value) -> string:
    k := kind(v)
    if k == K_NULL:
        return "null"
    if k == K_BOOL:
        return "bool"
    if k == K_INT:
        return "int"
    if k == K_DEC:
        return "decimal"
    return "string"

fn is_num(v: Value) -> bool:
    k := kind(v)
    return k == K_INT or k == K_DEC

# Payload accessors. Each has a total `match`, so each needs a value for the
# arms that cannot happen -- the same missing "unreachable" that `kind` works
# around. Every call site guards with `kind` first; the fallbacks are never
# reached and are chosen to be inert rather than plausible.
fn int_of(v: Value) -> int:
    match v:
        VInt(n):
            return n
        _:
            return 0

fn bool_of(v: Value) -> bool:
    match v:
        VBool(b):
            return b
        _:
            return false

fn str_of(v: Value) -> string:
    match v:
        VStr(s):
            return s
        _:
            return ""

# A numeric value as a Decimal. `VInt` widens exactly (`decimal.from_int`), so
# this is the common denominator for a mixed `VInt`/`VDec` comparison or sum.
fn dec_of(v: Value) -> decimal.Decimal:
    match v:
        VDec(d):
            return d
        VInt(n):
            return decimal.from_int(n)
        _:
            return decimal.from_int(0)

# How a value goes back out as a CSV field. `csv.stringify` adds the quoting;
# this only decides the bytes. `VNull` and `VStr("")` both render empty, which
# is what makes DECISION 1's null choice free on the way out.
fn render(v: Value) -> string:
    match v:
        VNull:
            return ""
        VBool(b):
            if b:
                return "true"
            return "false"
        VInt(n):
            return str(n)
        VDec(d):
            return decimal.to_str(d)
        VStr(s):
            return s

# Byte-lexicographic string order: -1 / 0 / 1. Written here rather than reached
# for because this program needs the ORDER, not just equality, and a byte order
# is the only one it can honestly claim -- `café` sorts by its UTF-8 bytes.
fn str_cmp(a: string, b: string) -> int:
    na := len(a)
    nb := len(b)
    n := na
    if nb < n:
        n = nb
    for i := 0; i < n; i += 1:
        if a[i] != b[i]:
            if a[i] < b[i]:
                return 0 - 1
            return 1
    if na < nb:
        return 0 - 1
    if na > nb:
        return 1
    return 0

# Three-way compare, or an error. Compatible kinds only: numeric with numeric,
# string with string, bool with bool. `VNull` never orders (header).
fn cmp_vals(a: Value, b: Value) -> Result(int, RErr):
    if is_num(a) and is_num(b):
        if kind(a) == K_INT and kind(b) == K_INT:
            x := int_of(a)
            y := int_of(b)
            if x < y:
                return Ok(0 - 1)
            if x > y:
                return Ok(1)
            return Ok(0)
        return Ok(decimal.cmp(dec_of(a), dec_of(b)))
    if kind(a) == K_STR and kind(b) == K_STR:
        return Ok(str_cmp(str_of(a), str_of(b)))
    if kind(a) == K_BOOL and kind(b) == K_BOOL:
        x := 0
        y := 0
        if bool_of(a):
            x = 1
        if bool_of(b):
            y = 1
        return Ok(x - y)
    return Err(RErr("cannot compare " + kind_name(a) + " " + shown_val(a) + " with " + kind_name(b) + " " + shown_val(b)))

# Equality: `cmp_vals` plus the one `VNull` exception (header).
fn eq_vals(a: Value, b: Value) -> Result(bool, RErr):
    if kind(a) == K_NULL or kind(b) == K_NULL:
        return Ok(kind(a) == K_NULL and kind(b) == K_NULL)
    c := cmp_vals(a, b) or_return
    return Ok(c == 0)

# A value in a diagnostic. Strings are quoted so that `cannot compare string
# "007" with int 42` cannot be misread as being about the number 7.
fn shown_val(v: Value) -> string:
    if kind(v) == K_STR:
        return "\"" + esc(str_of(v)) + "\""
    if kind(v) == K_NULL:
        return "(empty)"
    return render(v)

# ---------------------------------------------------------------------------
# ORDER 1 in code: the total order `order by` uses (see the header block)
# ---------------------------------------------------------------------------

# The KIND RANK. Numbers share one rank so that `VInt` and `VDec` fall through
# to a comparison BY VALUE and `1` sorts equal to `1.00`, exactly as `==` says.
const R_NULL = 0
const R_BOOL = 1
const R_NUM  = 2
const R_STR  = 3

fn ord_rank(v: Value) -> int:
    k := kind(v)
    if k == K_NULL:
        return R_NULL
    if k == K_BOOL:
        return R_BOOL
    if k == K_STR:
        return R_STR
    return R_NUM

# TOTAL: every pair of values has an answer, including pairs `cmp_vals` refuses.
# This is the ONLY place in the program where two different kinds are compared
# instead of being an error, and the header says at length why sorting may do
# that where `where` may not.
fn ord_cmp(a: Value, b: Value) -> int:
    ra := ord_rank(a)
    rb := ord_rank(b)
    if ra != rb:
        if ra < rb:
            return 0 - 1
        return 1
    if ra == R_NULL:
        return 0                               # two nulls are equal, always
    # Equal rank means COMPATIBLE kinds, so `cmp_vals` -- the same function
    # `where` uses -- cannot fail here, and the within-kind order is therefore
    # the same one by construction rather than by a promise in a comment. The
    # `Err` arm is unreachable for that reason and returns an inert 0, the same
    # shape as the unreachable arms of `int_of` and friends above.
    match cmp_vals(a, b):
        Ok(c):
            return c
        Err(e):
            return 0

# Compare two rows of the precomputed key matrix, first key first, each key
# NEGATED if that key is `desc`. Negating the comparison rather than reversing
# the output is what lets `asc` and `desc` mix in one `order by` at all.
fn cmp_key_rows(keys: [[Value]], dirs: [bool], i: int, j: int) -> int:
    for k := 0; k < len(dirs); k += 1:
        c := ord_cmp(keys[i][k], keys[j][k])
        if dirs[k]:
            c = 0 - c
        if c != 0:
            return c
    return 0

# Bottom-up merge sort over an index array, STABLE, taking the comparator as a
# first-class function value. See ORDER 2 in the header for why this is written
# here instead of being reached for in `core:sort`, and for what the probe
# established about fallible comparators.
#
# Bottom-up rather than recursive because it needs no array slicing: the runs
# are addressed by index arithmetic into two flat buffers that are the same
# size for the whole sort.
fn merge_sort(idx: [int], less: fn(int, int) -> int) -> [int]:
    n := len(idx)
    a := []int
    b := []int
    for i := 0; i < n; i += 1:
        push(a, idx[i])
        push(b, 0)
    width := 1
    for width < n:
        lo := 0
        for lo < n:
            mid := lo + width
            hi := lo + width + width
            if mid > n:
                mid = n
            if hi > n:
                hi = n
            i := lo
            j := mid
            k := lo
            for k < hi:
                take_left := false
                if i >= mid:
                    take_left = false
                elif j >= hi:
                    take_left = true
                else:
                    # `<= 0` -- NOT `< 0` -- is the whole of the stability
                    # guarantee: on a tie the LEFT run, which holds the earlier
                    # input rows, goes first.
                    take_left = (less(a[i], a[j]) <= 0)
                if take_left:
                    b[k] = a[i]
                    i = i + 1
                else:
                    b[k] = a[j]
                    j = j + 1
                k = k + 1
            lo = lo + width + width
        for t := 0; t < n; t += 1:
            a[t] = b[t]
        width = width + width
    return a

# ---------------------------------------------------------------------------
# DECISION 1 in code: a cell becomes a Value (see the header block)
# ---------------------------------------------------------------------------

# 0 = not a number at all, 1 = integer shape, 2 = decimal shape.
# The whole accepted shape is `-? digit+ ( "." digit+ )?` and nothing else.
# This runs BEFORE `strings.parse_int`, so that fail-open primitive never sees
# a byte it could mis-read.
fn num_shape(s: string) -> int:
    n := len(s)
    i := 0
    if i < n and s[i] == 45:                   # '-'
        i = i + 1
    d0 := i
    for i < n and is_digit(s[i]):
        i = i + 1
    if i == d0:
        return 0                                # no digits at all, or "-" alone
    if i == n:
        return 1
    if s[i] != 46:                             # something that is not a point
        return 0
    i = i + 1
    d1 := i
    for i < n and is_digit(s[i]):
        i = i + 1
    if i == d1:
        return 0                                # a point with no digits after it
    if i != n:
        return 0                                # trailing junk after the digits
    return 2

fn classify(cell: string) -> Value:
    if cell == "":
        return VNull
    sh := num_shape(cell)
    if sh == 0:
        return VStr(cell)
    if sh == 1:
        n := strings.parse_int(cell)
        # THE ROUND TRIP. `007` renders as `7`, `-0` as `0`, and an integer too
        # large for `int` renders as its wrapped self -- none of them equal to
        # the cell, so none of them is taken.
        if str(n) == cell:
            return VInt(n)
    d := decimal.from_str(cell)
    if decimal.to_str(d) == cell:
        return VDec(d)
    return VStr(cell)

# ---------------------------------------------------------------------------
# the table
# ---------------------------------------------------------------------------

struct Table:
    hdr:  [string]
    rows: [[Value]]

fn col_index(hdr: [string], name: string) -> int:
    for i := 0; i < len(hdr); i += 1:
        if hdr[i] == name:
            return i
    return 0 - 1

fn join_names(hdr: [string]) -> string:
    out := ""
    for i := 0; i < len(hdr); i += 1:
        if i > 0:
            out = out + ", "
        out = out + hdr[i]
    return out

# The bytes of the source, or a diagnosis of why there are none.
fn read_source(path: string) -> Result(string, RErr):
    match io.size(path):
        Err(io.NotFound):
            return Err(RErr("no such file: " + path))
        Err(io.IsDir):
            return Err(RErr("not a file: " + path + " is a directory"))
        Err(other):
            return Err(RErr("cannot read: " + path))
        Ok(sz):
            ok := sz
    return Ok(io.read(path))

# The source path decides the reader, on its extension and nothing else. There
# is no content sniffing: a `.json` file that is really CSV should say so in
# its name, and guessing from the first byte is how a tool ends up reading a
# quoted CSV field as a JSON array.
fn load(path: string) -> Result(Table, RErr):
    text := read_source(path) or_return
    if strings.ends_with(strings.to_lower(path), ".json"):
        return load_json(path, text)
    return load_csv(path, text)

# Read a CSV file and type every cell. Everything that can be checked ONCE, for
# the whole file, is checked here rather than per row: an empty file, a
# duplicated header name, a ragged row. A check that runs per row can only fail
# on a file that has rows, and a query over a file with none would then pass a
# check it should have failed.
fn load_csv(path: string, text: string) -> Result(Table, RErr):
    raw := csv.parse(text)
    if len(raw) == 0:
        return Err(RErr("empty file, so there is no header row: " + path))
    hdr := raw[0]
    for i := 0; i < len(hdr); i += 1:
        for j := i + 1; j < len(hdr); j += 1:
            if hdr[i] == hdr[j]:
                # Refused rather than resolved first-wins: a column reference
                # that could mean either of two columns is exactly the "wrong
                # rows, presented as data" failure this program refuses.
                return Err(RErr("the header of " + path + " names the column `" + hdr[i] + "` twice"))
    rows := [][Value]
    for r := 1; r < len(raw); r += 1:
        src := raw[r]
        if len(src) != len(hdr):
            return Err(RErr(path + ": row " + str(r + 1) + " has " + str(len(src)) + " fields but the header has " + str(len(hdr))))
        row := []Value
        for c := 0; c < len(src); c += 1:
            push(row, classify(src[c]))
        push(rows, row)
    return Ok(Table(hdr, rows))

# ---------------------------------------------------------------------------
# DECISION 3 in code: JSON input (see the header block for the probe that
# forced this shape)
# ---------------------------------------------------------------------------

fn json_err(path: string, e: json.JsonErr) -> RErr:
    m := path + ": byte " + str(json.err_offset(e)) + ": " + json.err_reason(e)
    match e:
        json.BadFloat(o):
            return RErr(m + " -- a JSON number needs at least one digit after the `.` and at least one after the `e`, so `1.5`, `1.50` and `-0.125` are numbers and `1.`, `1e` and `1e+` are not. Fix the digits rather than quoting the value: a JSON string is not re-typed here, so quoting it would make it order as text (see DECISION 3 at the top of tools/tycho-q/main.ty)")
        _:
            return RErr(m)

# The parse, with the corelib's failure relabelled as one of ours.
fn json_root(path: string, text: string) -> Result(json.Json, RErr):
    r := json.parse_checked(text)
    match r:
        Ok(j):
            return Ok(j)
        Err(e):
            return Err(json_err(path, e))

fn a_kind(k: string) -> string:
    if k == "arr":
        return "an array"
    if k == "obj":
        return "an object"
    if k == "num":
        return "a number"
    if k == "float":
        return "a number"
    if k == "str":
        return "a string"
    if k == "bool":
        return "a boolean"
    return "null"

fn json_float_cell(path: string, r: int, key: string, lx: string) -> Result(Value, RErr):
    if num_shape(lx) != 0:
        d := decimal.from_str(lx)
        if decimal.to_str(d) == lx:
            return Ok(VDec(d))
    return Err(RErr(path + ": row " + str(r + 1) + ", key `" + key + "`: the number " + lx + " has no exact decimal spelling here. tycho-q reads a JSON number through core:decimal, whose shape is `-? digit+ ( \".\" digit+ )?` and nothing else -- the same shape a CSV cell must match -- so an exponent (`1e3`) and a negative zero (`-0.0`) are refused rather than rounded through a float. Write the value in plain positional notation, or as a string if the text is what matters (see DECISION 3 at the top of tools/tycho-q/main.ty)"))

# One JSON value as a cell. JSON did not lose the type, so this BELIEVES it and
# does NOT re-run DECISION 1's round trip over a string (header).
fn json_cell(path: string, r: int, key: string, j: json.Json) -> Result(Value, RErr):
    k := json.kind(j)
    if k == "null":
        return Ok(VNull)
    if k == "bool":
        return Ok(VBool(json.as_bool(j)))
    if k == "num":
        return Ok(VInt(json.as_num(j)))
    if k == "float":
        return json_float_cell(path, r, key, json.as_lexeme(j))
    if k == "str":
        return Ok(VStr(json.as_str(j)))
    return Err(RErr(path + ": row " + str(r + 1) + ", key `" + key + "`: the value is " + a_kind(k) + ", and a table cell cannot hold one -- flattening it would invent a spelling that every later query would then depend on (see DECISION 3 at the top of tools/tycho-q/main.ty)"))

fn load_json(path: string, text: string) -> Result(Table, RErr):
    root := json_root(path, text) or_return
    if json.kind(root) != "arr":
        return Err(RErr(path + ": the top level of a JSON source must be an ARRAY of objects, one object per row, and this is " + a_kind(json.kind(root))))
    nrows := json.len_of(root)
    if nrows == 0:
        return Err(RErr("an empty array, so there are no keys and therefore no header: " + path))

    # The header is the UNION of every object's keys, in first-appearance
    # order. It is built in a whole pass of its own, BEFORE any cell is read,
    # because a column that appears for the first time in the last row is still
    # a column of the table and every earlier row needs a null in it.
    hdr := []string
    for r := 0; r < nrows; r += 1:
        ob := json.at(root, r)
        if json.kind(ob) != "obj":
            return Err(RErr(path + ": row " + str(r + 1) + " is " + a_kind(json.kind(ob)) + ", but every element of the array must be an object -- one object is one row"))
        ks := json.keys(ob)
        for a := 0; a < len(ks); a += 1:
            for b := a + 1; b < len(ks); b += 1:
                if ks[a] == ks[b]:
                    # The same refusal as a duplicated CSV header name, for the
                    # same reason: `json.get` would answer with the first, and
                    # a reference that could mean either is not a column.
                    return Err(RErr(path + ": row " + str(r + 1) + " names the key `" + ks[a] + "` twice"))
            if col_index(hdr, ks[a]) < 0:
                push(hdr, ks[a])

    rows := [][Value]
    for r := 0; r < nrows; r += 1:
        ob := json.at(root, r)
        ks := json.keys(ob)
        row := []Value
        for c := 0; c < len(hdr); c += 1:
            if col_index(ks, hdr[c]) < 0:
                push(row, VNull)               # a MISSING key, not a null one
            else:
                push(row, json_cell(path, r, hdr[c], json.get(ob, hdr[c])) or_return)
        push(rows, row)
    return Ok(Table(hdr, rows))

# ---------------------------------------------------------------------------
# the evaluator
# ---------------------------------------------------------------------------

fn need_bool(v: Value, ctx: string) -> Result(bool, RErr):
    if kind(v) != K_BOOL:
        return Err(RErr(ctx + " needs a boolean, got " + kind_name(v) + " " + shown_val(v) + " -- there is no truthiness here"))
    return Ok(bool_of(v))

# The target scale every `/` is computed at. There is no syntax for naming one
# per query yet, so this is THE scale -- see DECISION 2 for why 6 and not 2.
const DIV_SCALE = 6

fn arith(op: string, a: Value, b: Value) -> Result(Value, RErr):
    if not is_num(a) or not is_num(b):
        return Err(RErr("`" + op + "` needs two numbers, got " + kind_name(a) + " " + shown_val(a) + " and " + kind_name(b) + " " + shown_val(b)))
    if kind(a) == K_INT and kind(b) == K_INT:
        x := int_of(a)
        y := int_of(b)
        if op == "+":
            return Ok(VInt(x + y))
        if op == "-":
            return Ok(VInt(x - y))
        if op == "*":
            return Ok(VInt(x * y))
        if op == "%":
            if y == 0:
                return Err(RErr("`%` by zero"))
            return Ok(VInt(x % y))
        # `/` falls through to the decimal path: it is a decimal on every input,
        # and tycho's integer `/` is never reached (see DECISION 2).
    da := dec_of(a)
    db := dec_of(b)
    if op == "+":
        return Ok(VDec(decimal.add(da, db)))
    if op == "-":
        return Ok(VDec(decimal.sub(da, db)))
    if op == "*":
        return Ok(VDec(decimal.mul(da, db)))
    if op == "%":
        return Err(RErr("`%` needs two integers, got " + kind_name(a) + " and " + kind_name(b)))
    dr := decimal.div(da, db, DIV_SCALE, decimal.half_up())
    match dr:
        Ok(d):
            return Ok(VDec(d))
        Err(e):
            match e:
                decimal.DivByZero:
                    return Err(RErr("`/` by zero: " + shown_val(a) + " / " + shown_val(b) + " -- the divisor is zero on this row"))
                _:
                    return Err(RErr("`/` was refused by core:decimal: the scale or the rounding mode tycho-q asked for is not valid. That is a bug in tycho-q, not in the query (see DECISION 2 at the top of tools/tycho-q/main.ty)"))

fn eval(e: Expr, hdr: [string], row: [Value]) -> Result(Value, RErr):
    match e:
        ELit(v):
            return Ok(v)
        ECol(name):
            i := col_index(hdr, name)
            if i < 0:
                return Err(RErr("no such column: " + name))
            return Ok(row[i])
        EUn(op, x):
            v := eval(x, hdr, row) or_return
            if op == "not":
                b := need_bool(v, "`not`") or_return
                return Ok(VBool(not b))
            if kind(v) == K_INT:
                return Ok(VInt(0 - int_of(v)))
            if kind(v) == K_DEC:
                return Ok(VDec(decimal.neg(dec_of(v))))
            return Err(RErr("unary `-` needs a number, got " + kind_name(v) + " " + shown_val(v)))
        EBin(op, l, r):
            # `and` / `or` short-circuit, so the right side is not evaluated --
            # and therefore cannot error -- on a row the left side settles.
            if op == "and" or op == "or":
                lv := eval(l, hdr, row) or_return
                lb := need_bool(lv, "`" + op + "`") or_return
                if op == "and" and not lb:
                    return Ok(VBool(false))
                if op == "or" and lb:
                    return Ok(VBool(true))
                rv := eval(r, hdr, row) or_return
                rb := need_bool(rv, "`" + op + "`") or_return
                return Ok(VBool(rb))
            a := eval(l, hdr, row) or_return
            b := eval(r, hdr, row) or_return
            if op == "==":
                eq := eq_vals(a, b) or_return
                return Ok(VBool(eq))
            if op == "!=":
                eq := eq_vals(a, b) or_return
                return Ok(VBool(not eq))
            if op == "<" or op == "<=" or op == ">" or op == ">=":
                c := cmp_vals(a, b) or_return
                if op == "<":
                    return Ok(VBool(c < 0))
                if op == "<=":
                    return Ok(VBool(c <= 0))
                if op == ">":
                    return Ok(VBool(c > 0))
                return Ok(VBool(c >= 0))
            return arith(op, a, b)

fn check_cols(e: Expr, hdr: [string]) -> Result(int, RErr):
    match e:
        ELit(v):
            return Ok(0)
        ECol(name):
            if col_index(hdr, name) < 0:
                return Err(RErr("no such column: " + name + " (the header has: " + join_names(hdr) + ")"))
            return Ok(0)
        EUn(op, x):
            return check_cols(x, hdr)
        EBin(op, l, r):
            _ := check_cols(l, hdr) or_return
            return check_cols(r, hdr)

# The output header name for one un-aliased select item. A bare column keeps
# its own name; anything computed gets its s-expression, which is ugly on
# purpose -- it is a legible instruction to write `as`.
fn expr_header(e: Expr) -> string:
    match e:
        ECol(name):
            return name
        _:
            return show_expr(e)

fn header_row(q: Query, hdr: [string]) -> [string]:
    names := []string
    for i := 0; i < len(q.sel); i += 1:
        match q.sel[i]:
            IStar:
                for j := 0; j < len(hdr); j += 1:
                    push(names, hdr[j])
            IExpr(e, alias):
                if alias != "":
                    push(names, alias)
                else:
                    push(names, expr_header(e))
    return names

fn project(q: Query, hdr: [string], row: [Value]) -> Result([string], RErr):
    out := []string
    for i := 0; i < len(q.sel); i += 1:
        match q.sel[i]:
            IStar:
                for j := 0; j < len(row); j += 1:
                    push(out, render(row[j]))
            IExpr(e, alias):
                v := eval(e, hdr, row) or_return
                push(out, render(v))
    return Ok(out)

fn has_limit(o: Option(int)) -> bool:
    match o:
        Some(n):
            return true
        None:
            return false

fn limit_of(o: Option(int)) -> int:
    match o:
        Some(n):
            return n
        None:
            return 0

# `order by total` where `total` is an alias in the select list and not a
# column of the source. The plan's own headline query is
# `select name, qty * price as total ... order by total desc`, so without this
# the tool does not run its own example.
#
# THE RESOLUTION IS DELIBERATELY NARROW: only a key that is EXACTLY a bare
# column reference is considered, never an alias buried inside a larger
# expression (`order by total * 2` still means the COLUMN `total`, and says so
# by failing if there is none). Substituting inside an expression would mean a
# name resolving one way at the top of a key and another way underneath it.
fn alias_expr(q: Query, name: string) -> Option(Expr):
    for i := 0; i < len(q.sel); i += 1:
        match q.sel[i]:
            IStar:
                _ := 0
            IExpr(e, alias):
                if alias == name:
                    return Some(e)
    return None

# A column of the source WINS over nothing, an alias wins over nothing, and a
# name that is BOTH is refused rather than resolved by a precedence rule. Either
# choice would be defensible and neither is guessable from the query text, and
# "the same query means two different things depending on the file's header" is
# the wrong-rows-as-data failure again.
fn resolve_key(q: Query, hdr: [string], k: OrdKey) -> Result(OrdKey, RErr):
    match k.expr:
        ECol(name):
            in_hdr := col_index(hdr, name) >= 0
            match alias_expr(q, name):
                Some(e):
                    if in_hdr:
                        return Err(RErr("`order by " + name + "` is ambiguous: `" + name + "` is both a column of " + q.src + " and an alias in the select list -- rename the alias"))
                    return Ok(OrdKey(e, k.desc))
                None:
                    return Ok(k)
        _:
            return Ok(k)

# The whole result is built BEFORE anything is printed. That is what makes the
# "a runtime error prints nothing on stdout" guarantee true: an error on the
# last row of a million must not leave 999,999 rows already emitted, because a
# consumer reading a truncated CSV cannot tell it is truncated.
fn execute(q: Query) -> Result([[string]], RErr):
    t := load(q.src) or_return

    ord := []OrdKey
    for i := 0; i < len(q.ord); i += 1:
        push(ord, resolve_key(q, t.hdr, q.ord[i]) or_return)

    for i := 0; i < len(q.sel); i += 1:
        match q.sel[i]:
            IStar:
                _ := 0
            IExpr(e, alias):
                _ := check_cols(e, t.hdr) or_return
    match q.filt:
        Some(fe):
            _ := check_cols(fe, t.hdr) or_return
        None:
            _ := 0
    for i := 0; i < len(ord); i += 1:
        _ := check_cols(ord[i].expr, t.hdr) or_return

    kept := [][Value]
    for r := 0; r < len(t.rows); r += 1:
        row := t.rows[r]
        keep := true
        match q.filt:
            Some(fe):
                v := eval(fe, t.hdr, row) or_return
                keep = need_bool(v, "`where`") or_return
            None:
                keep = true
        if keep:
            push(kept, row)

    # ORDER BY. The keys are evaluated ONCE PER ROW, here, and not inside the
    # comparator: a sort makes O(n log n) comparisons over n rows, so a key
    # computed in the comparator is computed a logarithmic factor too often --
    # and `qty * price` is a `core:decimal` multiply. Evaluating up front is
    # also what keeps the comparator INFALLIBLE, because this is the step that
    # can fail (an unknown column is already ruled out, but `/` need not be
    # exact and `+` need not have two numbers), and it fails HERE, with
    # `or_return`, before a single comparison is made.
    if len(ord) > 0:
        keys := [][Value]
        for r := 0; r < len(kept); r += 1:
            kr := []Value
            for k := 0; k < len(ord); k += 1:
                push(kr, eval(ord[k].expr, t.hdr, kept[r]) or_return)
            push(keys, kr)
        dirs := []bool
        for k := 0; k < len(ord); k += 1:
            push(dirs, ord[k].desc)
        idx := []int
        for r := 0; r < len(kept); r += 1:
            push(idx, r)
        less := fn(i: int, j: int) -> int: cmp_key_rows(keys, dirs, i, j)
        pos := merge_sort(idx, less)
        sorted := [][Value]
        for r := 0; r < len(pos); r += 1:
            push(sorted, kept[pos[r]])
        kept = sorted

    # LIMIT, applied AFTER the ordering -- `order by x limit 3` is the top
    # three by x, not three arbitrary rows put in order. `limit 0` is a legal
    # query with an empty answer, so it yields the header and nothing else; it
    # is not the same as no `limit` at all, which is why the option is kept as
    # an `Option(int)` rather than as a sentinel 0.
    n := len(kept)
    if has_limit(q.lim):
        lv := limit_of(q.lim)
        if lv < n:
            n = lv

    out := [][string]
    push(out, header_row(q, t.hdr))
    for r := 0; r < n; r += 1:
        push(out, project(q, t.hdr, kept[r]) or_return)
    return Ok(out)

# ---------------------------------------------------------------------------
# entry point
# ---------------------------------------------------------------------------

fn usage():
    println("usage: tycho-q [--explain] '<query>'")
    println("")
    println("  --explain   parse the query and print its AST as an s-expression,")
    println("              reading no file and evaluating no row")
    println("")
    println("Without --explain the query is run. A `.json` source is read as an")
    println("array of objects, one object per row; anything else is read as CSV")
    println("with row 0 as the header. `where` is evaluated per row, `order by`")
    println("sorts (stable, multi-key, per-key asc/desc), `limit` truncates, and")
    println("the surviving rows are printed as CSV on stdout, header first.")
    println("")
    println("The accepted grammar, the cell-typing rule, what `/` does, the total")
    println("order `order by` uses and what JSON input can and cannot carry are")
    println("all at the top of tools/tycho-q/main.ty.")

fn run(q: Query):
    match execute(q):
        Ok(rows):
            # `csv.stringify` already terminates every row with '\n', so this
            # is `print` and not `println` -- the latter would add a blank
            # line that a byte-exact golden would then have to carry.
            print(csv.stringify(rows))
        Err(er):
            die("tycho-q: " + er.msg)

fn main():
    av := cli.argv()
    if len(av) == 0 or av[0] == "-h" or av[0] == "--help":
        usage()
        exit(0)
    explaining := false
    qtext := ""
    if av[0] == "--explain":
        if len(av) != 2:
            die("tycho-q: --explain takes exactly one query argument (try --help)")
        explaining = true
        qtext = av[1]
    elif strings.starts_with(av[0], "-"):
        die("tycho-q: unknown option: " + av[0] + " (try --help)")
    else:
        if len(av) != 1:
            die("tycho-q: takes exactly one query argument (try --help)")
        qtext = av[0]
    match parse_query(qtext):
        Ok(q):
            if explaining:
                explain(q)
            else:
                run(q)
        Err(e):
            die("tycho-q: parse error at byte " + str(e.off) + ": unexpected token " + e.tok + " (expected " + e.msg + ")")
