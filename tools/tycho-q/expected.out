=== Q01 precedence
(query
  (select (+ 1 (* 2 3)))
  (from "x.csv")
)
=== Q02 left assoc
(query
  (select (- (- 1 2) 3))
  (from "x.csv")
)
=== Q03 parens + unary
(query
  (select (* (+ 1 2) 3) (+ (neg 1) 2))
  (from "x.csv")
)
=== Q04 literals
(query
  (select 1 1.50 0.1 "eu" "sq" true false null)
  (from "x.csv")
)
=== Q05 and/or/not
(query
  (select (or (and (== (col a) 1) (> (col b) 2)) (not (col c))))
  (from "x.csv")
)
=== Q06 all clauses
(query
  (select (col name) (as total (* (col qty) (col price))))
  (from "sales.csv")
  (where (and (== (col region) "eu") (> (col qty) 10)))
  (order (key (col total) desc))
  (limit 5)
)
=== Q07 multi-key
(query
  (select (col a))
  (from "x.csv")
  (order (key (col a) asc) (key (col b) desc) (key (col c) asc))
  (limit 0)
)
