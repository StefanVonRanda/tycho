package main

import "core:cli"
import "core:io"
import "core:strings"
import "core:time"
import "core:utf8"
import "buf"

# tycho-ed -- a terminal text editor. THIS SLICE HAS NO TERMINAL.
#
# What it has instead is `--script`, which drives the buffer from a file of key
# names and prints what the screen would show. That is deliberate and it is
# first, not last: an editor whose only entry point is a tty cannot be checked
# by anything except a human looking at it, and two programs landed in this
# tree this week with no gate for exactly that reason. Every behaviour the raw
# terminal mode will later expose is reachable from here, so when the lane
# lands it has something to run.
#
# The script language, one command per line:
#
#   # ...              comment; blank lines are ignored
#   ins <text>         insert the rest of the line at the cursor
#   nl                 press Enter (split the line)
#   bs | del           backspace / forward delete, ONE codepoint
#   left right up down home end
#   goto <line> <col>  move; <col> counts CHARACTERS, not bytes
#   undo | redo
#   dump               the buffer, the cursor, and the counts
#   hex                the current line's bytes, to prove what a delete removed
#
# `--backend=string` (default) or `--backend=gap` picks which representation
# holds the line being edited. It is a performance switch and must move no
# output: see buf/buf.ty's Buf, and the --stress header below for the number it
# was built to produce.
#
# Every command echoes as `> cmd`, and a failure prints `  ERR <cause>` and
# keeps going -- a script is a test, so the error is an observation, not a stop.

fn _hex(s: string) -> string:
    digits := "0123456789abcdef"
    out := ""
    for i := 0; i < len(s); i += 1:
        if i > 0:
            out += " "
        b := s[i]
        out += digits[b / 16:b / 16 + 1] + digits[b % 16:b % 16 + 1]
    return out

# Both readers take the buffer by value and read b.lines directly, so both need
# the gap flushed first -- a by-value reader cannot flush what it was handed.
fn dump(b: inout buf.Buf):
    buf.sync(&b)
    cps := buf.cp_count(b)
    tag := str(cps) + " codepoints"
    if cps < 0:
        tag = "INVALID UTF-8"
    println("  --- " + str(buf.line_count(b)) + " lines, " +
            str(buf.byte_count(b)) + " bytes, " + tag + " ---")
    for i := 0; i < buf.line_count(b); i += 1:
        mark := "   "
        if i == b.cur.line:
            mark = "  >"
        println(mark + " " + str(i) + " | " + b.lines[i])
    println("  --- cursor line " + str(b.cur.line) +
            " char " + str(buf.cur_cp_col(b)) +
            " (byte " + str(b.cur.col) + ")" +
            "  undo " + str(buf.undo_depth(b)) +
            " redo " + str(buf.redo_depth(b)) + " ---")

fn hexline(b: inout buf.Buf):
    buf.sync(&b)
    s := b.lines[b.cur.line]
    println("  line " + str(b.cur.line) + ": " + str(len(s)) + " bytes, " +
            str(utf8.count(s)) + " codepoints")
    println("  bytes: " + _hex(s))

# Returns the command's error, if it had one. Motion past an edge is a real
# BufErr here rather than a silent clamp; see the note on AtStart in buf.ty.
fn run_cmd(b: inout buf.Buf, line: string) -> Result(void, buf.BufErr):
    verb, rest := strings.split_once(line, " ")
    if verb == "":
        verb = line
    if verb == "ins":
        return buf.insert(&b, rest)
    elif verb == "nl":
        return buf.newline(&b)
    elif verb == "bs":
        return buf.del_back(&b)
    elif verb == "del":
        return buf.del_fwd(&b)
    elif verb == "left":
        return buf.left(&b)
    elif verb == "right":
        return buf.right(&b)
    elif verb == "up":
        return buf.up(&b)
    elif verb == "down":
        return buf.down(&b)
    elif verb == "undo":
        return buf.undo(&b)
    elif verb == "redo":
        return buf.redo(&b)
    elif verb == "home":
        buf.home(&b)
    elif verb == "end":
        buf.line_end(&b)
    elif verb == "goto":
        a, c := strings.split_once(rest, " ")
        return buf.goto(&b, strings.parse_int(a), strings.parse_int(c))
    elif verb == "dump":
        dump(&b)
    elif verb == "hex":
        hexline(&b)
    else:
        println("  ERR unknown command: " + verb)
    return Ok()

fn script(path: string, gap: bool) -> Result(void, string):
    b := buf.from_text("")
    if gap:
        b = buf.from_text_gap("")
    for raw in io.read_lines(path):
        line := strings.trim(raw)
        if line == "" or strings.starts_with(line, "#"):
            continue
        println("> " + line)
        match run_cmd(&b, line):
            Ok: pass
            Err(e): println("  ERR " + buf.err_str(e))
    return Ok()

fn stress(n: int, snapshot: bool, gap: bool):
    glyphs := ["a", "b", "c", " ", "é", "ö", "字", "e"]
    buckets := 10
    per := n / buckets
    if per < 1:
        per = 1
    b := buf.from_text("")
    if gap:
        b = buf.from_text_gap("")
    snaps: [[string]] = []
    first := 0
    last := 0
    println("  edits    ns/edit")
    for k := 0; k < buckets; k += 1:
        sw := time.start()
        for j := 0; j < per; j += 1:
            i := k * per + j
            if i % 60 == 59:
                match buf.newline(&b):
                    Ok: pass
                    Err(e): println("  ERR " + buf.err_str(e))
            else:
                match buf.insert(&b, glyphs[i % 8]):
                    Ok: pass
                    Err(e): println("  ERR " + buf.err_str(e))
            if snapshot:
                push(snaps, b.lines)
        ea := time.elapsed_ns(sw) / per
        if k == 0:
            first = ea
        last = ea
        println("  " + strings.pad_left(str((k + 1) * per), 7, " ") +
                strings.pad_left(str(ea), 11, " "))
    buf.sync(&b)                     # the counts below read b.lines
    kind := "journal"
    if snapshot:
        kind = "snapshot"
    back := "string"
    if gap:
        back = "gap"
    println("  mode          " + kind)
    println("  backend       " + back)
    println("  lines         " + str(buf.line_count(b)))
    println("  bytes         " + str(buf.byte_count(b)))
    println("  undo entries  " + str(buf.undo_depth(b)))
    println("  undo bytes    " + str(buf.undo_bytes(b)))
    if snapshot:
        held := 0
        for i := 0; i < len(snaps); i += 1:
            for j := 0; j < len(snaps[i]); j += 1:
                held += len(snaps[i][j])
        println("  snapshot bytes " + str(held))
    # last/first as a percentage, so "flat" is a number and not an impression.
    if first > 0:
        println("  last/first    " + str(last * 100 / first) + "%")

fn main() -> Result(void, string):
    av := cli.argv()
    path := ""
    n := 0
    snapshot := false
    gap := false
    for a in av:
        if strings.starts_with(a, "--script="):
            path = a[9:len(a)]
        elif strings.starts_with(a, "--stress="):
            n = strings.parse_int(a[9:len(a)])
        elif a == "--snapshot":
            snapshot = true
        elif a == "--backend=gap":
            gap = true
        elif a == "--backend=string":
            gap = false
        else:
            return Err("unknown argument: " + a)
    if n > 0:
        stress(n, snapshot, gap)
        return Ok()
    if path == "":
        return Err("usage: tycho-ed --script=<file> [--backend=string|gap]\n" +
                   "       tycho-ed --stress=<N> [--snapshot] [--backend=string|gap]")
    if not io.exists(path):
        return Err("no such file: " + path)
    return script(path, gap)
