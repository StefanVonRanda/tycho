package build

import "core:io"
import "core:os"
import "core:sha256"
import "core:strings"
import "core:arrays"
import "../graph"

# tycho-make, slice 2: decide what is stale, run it with bounded parallelism,
# and print a log whose bytes do not depend on how the work was scheduled.
#
# THE SCHEDULER IS A WORK QUEUE: one coordinator and N stateless workers, which
# is the textbook design and is expressible here. It replaced a wavefront
# (`parallel for` over one depth of the graph, depths in order) on 2026-08-13.
# The wavefront was an unnecessary restriction, and the two rules that were
# thought to forbid a work queue do not reach this shape:
#
#   - `Task(T)` is affine and non-storable, so a pool of handles cannot be an
#     array -- but the pool is not handles. It is ONE spawned task whose body is
#     a `parallel for` over a slot list, every chunk pulling from the one jobs
#     channel. One handle, named individually, is all that is ever held.
#   - A `parallel for` body may not write a captured variable -- but no worker
#     needs to. The indegree table lives in the coordinator, which is a single
#     thread mutating its OWN locals; workers are stateless pullers that receive
#     a job and send an outcome. Neither rule applies.
#
# A node therefore starts when its own dependencies finish, not when its whole
# level does. `tools/tycho-make/run.sh` [8b] asserts exactly that difference: a
# chain node must start before a wide level of sleepers beside it has finished,
# which a wavefront cannot do.
#
# WHAT A WORKER IS TOLD. `Job` carries the node index and the CURRENT hash of
# each of its dependencies, because the coordinator is the only thread that owns
# the completed-state array and a worker must not read it. So the data a worker
# needs arrives with the work, and nothing is shared.
#
# WHERE DETERMINISM COMES FROM. Outcomes arrive on a channel in COMPLETION
# order, which is a race -- and a wider race than the wavefront's, since the
# ready set is no longer bounded by a level. Nothing is printed from a worker.
# Each outcome carries the node index it belongs to, the coordinator files it by
# that index, and the log is emitted afterwards by walking the TOPOLOGICAL
# ORDER. So the log is a function of the graph and the disk, never of the pool
# -- the same bytes at any TYCHO_THREADS. Recipe output is captured and printed
# in the same place, so even two recipes racing to write to their stdout cannot
# interleave in the log. The error is chosen the same way: by DAG position, not
# by who failed first.
#
# WHY IT CANNOT DEADLOCK. Both channels are sized to the node count, so the
# coordinator can never block sending a job and a worker can never block sending
# an outcome. The loop is driven by an in-flight count, so it ends when the last
# dispatched job has reported; `close(jobs)` then releases every worker.
#
# WHAT MAKES IT A CONTENT HASH AND NOT A STAT. mtime decides whether to READ a
# file; the SHA-256 of the bytes decides whether to REBUILD. A file whose mtime
# moved and whose content did not is reported `touched` and rebuilds nothing.
# That also gives early cutoff for free: a rule that reruns and produces the
# same bytes does not make its dependents stale.
#
# THE RACY WINDOW IS HANDLED. `io.mtime` has one-second granularity, so an
# mtime-keyed hash cache is unsound for an edit landing in the same second as
# the stamp write -- the mtime would match and the stale hash would be trusted.
# Any file whose mtime is >= the stamp file's own mtime is therefore re-read
# regardless. This is git's racy-timestamp rule and without it this program is
# wrong on a fast machine, not merely flaky.

# gap: a file is hashed via io.read_text, so a target holding bytes that are not
#   valid text is out of scope. gap: no parallelism inside one node's recipe
#   list; the lines of one rule run in order, and the first non-zero exit stops
#   the build.

struct Stamp:
    mtime: int
    hash: string

# `state` is one of the S* codes below and is what the log reports.
struct Stat:
    present: bool
    mtime: int
    hash: string
    state: int

const SABSENT   = 0
const SUNCHANGED = 1
const STOUCHED  = 2
const SCHANGED  = 3
const SNEW      = 4

const KSOURCE = 0
const KGROUP  = 1
const KRAN    = 2
const KSKIP   = 3

enum BuildErr:
    MissingSource(string)
    RecipeFailed(string, string, int)
    NoOutput(string, string)
    Unreadable(string)
    StampBroken(int, string)
    WorkLost(int, int)

# One node's verdict, tagged with the node index that produced it. `err` holds
# nought or one element: a `Result` cannot come back through a channel arm and
# an `Option` would force a two-arm match at every read, where `len(e) > 0` is
# one line and orders the errors by DAG position for free. BuildErr is declared
# ABOVE this struct because a field type must already be known -- tychoc does
# not forward-declare.
struct Outcome:
    idx: int
    kind: int
    why: string
    st: Stat
    out: string
    err: [BuildErr]

# One unit of work. `dep_hash[j]` is the current hash of `deps_at(g, idx)[j]`,
# filled in by the coordinator: a worker never reads the completed-state array,
# so everything it needs travels with the job.
struct Job:
    idx: int
    dep_hash: [string]

# No message names a path: the driver is handed one rulefile, the recipes name
# their own files, and a path here would put the gate's temp directory in the
# golden.
fn err_str(e: BuildErr) -> string:
    match e:
        MissingSource(n): return "no rule to make '" + n + "' and no such file"
        RecipeFailed(n, c, rc): return "recipe for '" + n + "' failed with exit " + str(rc) + ": " + c
        NoOutput(n, c): return "recipe for '" + n + "' succeeded but did not create it: " + c
        Unreadable(n): return "cannot read '" + n + "' to hash it"
        StampBroken(l, t): return "stamp line " + str(l) + " is not <name> <mtime> <hash>: [" + t + "]"
        WorkLost(want, got): return "work lost: " + str(want) + " nodes in the graph, " + str(got) + " reported"

# --- the stamp file ----------------------------------------------------------

fn cut(s: string, at: int) -> (string, string):
    return (substr(s, 0, at), substr(s, at + 1, len(s)))

# `<name>\t<mtime>\t<hash>`. A name cannot hold a tab because the rulefile
# parser splits targets on whitespace, so two cuts are unambiguous.
fn stamps_read(path: string) -> Result([string: Stamp], BuildErr):
    m := []string: Stamp
    text := ""
    match io.read_text(path):
        Ok(s): text = s
        Err(e): return Ok(m)
    ls := strings.lines(text)
    for i := 0; i < len(ls); i += 1:
        if len(ls[i]) == 0:
            continue
        a := find(ls[i], "\t")
        if a < 0:
            return Err(StampBroken(i + 1, ls[i]))
        nm, rest := cut(ls[i], a)
        b := find(rest, "\t")
        if b < 0 or len(nm) == 0:
            return Err(StampBroken(i + 1, ls[i]))
        mt, hs := cut(rest, b)
        if len(hs) != 64:
            return Err(StampBroken(i + 1, ls[i]))
        m[nm] = Stamp(strings.parse_int(mt), hs)
    return Ok(m)

# Node-index order, so the file itself is deterministic. Written only after a
# build has fully succeeded: a stamp for a half-done tree would record inputs
# against outputs that were never made from them.
fn stamps_write(path: string, g: graph.Graph, now: [Stat]) -> bool:
    ls := []string
    for i := 0; i < len(now); i += 1:
        if now[i].present:
            push(ls, graph.name_at(g, i) + "\t" + str(now[i].mtime) + "\t" + now[i].hash)
    return io.write_lines(path, ls)

# --- staleness ---------------------------------------------------------------

# `racy` is the stamp file's own mtime. Trusting the cached hash is allowed only
# for a file strictly older than that; see the header.
# An absent Stat carries mtime -1 when the file is not there at all and its real
# mtime when it is there but could not be read -- a directory named as a source
# is the case that matters, and the two deserve different messages.
fn probe(name: string, prev: [string: Stamp], racy: int) -> Stat:
    mt := 0
    match io.mtime(name):
        Ok(v): mt = v
        Err(e): return Stat(false, -1, "", SABSENT)
    known := name in prev
    if known and prev[name].mtime == mt and mt < racy:
        return Stat(true, mt, prev[name].hash, SUNCHANGED)
    h := ""
    match io.read_text(name):
        Ok(s): h = sha256.hex(s)
        Err(e): return Stat(false, mt, "", SABSENT)
    if not known:
        return Stat(true, mt, h, SNEW)
    if h != prev[name].hash:
        return Stat(true, mt, h, SCHANGED)
    if mt != prev[name].mtime:
        return Stat(true, mt, h, STOUCHED)
    return Stat(true, mt, h, SUNCHANGED)

fn state_word(s: int) -> string:
    if s == SNEW:
        return "new"
    if s == SCHANGED:
        return "changed"
    if s == STOUCHED:
        return "touched (content identical)"
    return "unchanged"

fn was_hash(prev: [string: Stamp], g: graph.Graph, d: int) -> string:
    if graph.name_at(g, d) in prev:
        return prev[graph.name_at(g, d)].hash
    return ""

# The whole decision for one node, run on a worker. Every dependency's current
# hash arrived in the job, so this reads nothing shared and writes nothing
# outside itself.
fn do_node(g: graph.Graph, prev: [string: Stamp], racy: int, jb: Job) -> Outcome:
    i := jb.idx
    name := graph.name_at(g, i)
    deps := graph.deps_at(g, i)
    rec := graph.recipe_at(g, i)
    none : [BuildErr] = []
    if len(rec) == 0:
        if len(deps) > 0:
            return Outcome(i, KGROUP, "", Stat(false, 0, "", SABSENT), "", none)
        st := probe(name, prev, racy)
        if not st.present:
            if st.mtime < 0:
                return Outcome(i, KSOURCE, "", st, "", [MissingSource(name)])
            return Outcome(i, KSOURCE, "", st, "", [Unreadable(name)])
        return Outcome(i, KSOURCE, state_word(st.state), st, "", none)
    cur := probe(name, prev, racy)
    why := ""
    if not cur.present:
        why = "missing"
    elif not (name in prev):
        why = "no record"
    elif cur.hash != prev[name].hash:
        why = "output modified"
    else:
        for j := 0; j < len(deps); j += 1:
            if jb.dep_hash[j] != was_hash(prev, g, deps[j]):
                why = graph.name_at(g, deps[j]) + " changed"
                break
    if why == "":
        return Outcome(i, KSKIP, "up to date", cur, "", none)
    txt := ""
    for j := 0; j < len(rec); j += 1:
        # stderr is folded into stdout: a build log that showed only half of what
        # a failing recipe said would be the wrong half.
        r := os.run("{ " + rec[j] + " ; } 2>&1")
        txt = txt + r.out
        if r.code != 0:
            return Outcome(i, KRAN, why, cur, txt, [RecipeFailed(name, rec[j], r.code)])
    after := probe(name, []string: Stamp, 0)
    if not after.present:
        if after.mtime < 0:
            return Outcome(i, KRAN, why, after, txt, [NoOutput(name, rec[len(rec) - 1])])
        return Outcome(i, KRAN, why, after, txt, [Unreadable(name)])
    return Outcome(i, KRAN, why, after, txt, none)

# --- the scheduler -----------------------------------------------------------

# THE POOL. One spawned task, `parallel for` over a slot list, every chunk
# looping on the same jobs channel until it is closed and drained. `slots` sets
# the width, so this is a pool and not one pipeline per slot. The count returned
# is the reduction a `parallel for` body is allowed to write; the caller checks
# it against what it dispatched.
fn pool(g: graph.Graph, prev: [string: Stamp], racy: int,
        jobs: Channel(Job), outs: Channel(Outcome), slots: [int]) -> int:
    done := 0
    parallel for s in slots:
        for true:
            match recv(jobs):
                Some(jb):
                    send(outs, do_node(g, prev, racy, jb))
                    done = done + 1
                None: break
    return done

# The coordinator's half of one dispatch: read the dependency hashes it already
# owns and hand them to the worker with the index.
fn job_for(g: graph.Graph, now: [Stat], i: int) -> Job:
    hs := []string
    for j := 0; j < len(graph.deps_at(g, i)); j += 1:
        push(hs, now[graph.deps_at(g, i)[j]].hash)
    return Job(i, hs)

# Reverse edges: `rdeps[d]` is every node naming `d` as a dependency, which is
# what turns one completion into the set of nodes that may have just become
# ready.
fn rdeps_of(g: graph.Graph) -> [[int]]:
    out : [[int]] = []
    for i := 0; i < graph.node_count(g); i += 1:
        push(out, []int)
    for i := 0; i < graph.node_count(g); i += 1:
        for j := 0; j < len(graph.deps_at(g, i)); j += 1:
            push(out[graph.deps_at(g, i)[j]], i)
    return out

# --- the build ---------------------------------------------------------------

# THE COORDINATOR, and the ordered reassembly. `indeg`, `blocked`, `res` and
# `now` are this thread's own locals and no other thread ever sees them; that is
# what makes a mutable indegree table legal. Outcomes arrive in completion order
# and are filed by node index, which is the only place the two orders meet.
# Everything downstream reads `res` and walks `ord`, so nothing downstream can
# see the pool at all.
fn build(g: graph.Graph, ord: [int], stamp: string) -> Result([string], BuildErr):
    prev := []string: Stamp
    match stamps_read(stamp):
        Ok(m): prev = m
        Err(e): return Err(e)
    racy := 0
    match io.mtime(stamp):
        Ok(v): racy = v
        Err(e): racy = 0
    n := graph.node_count(g)
    blank := Outcome(-1, KGROUP, "", Stat(false, 0, "", SABSENT), "", [])
    res : [Outcome] = []
    now : [Stat] = []
    for i := 0; i < n; i += 1:
        push(res, blank)
        push(now, Stat(false, 0, "", SABSENT))
    indeg := []int
    blocked := []bool
    for i := 0; i < n; i += 1:
        push(indeg, len(graph.deps_at(g, i)))
        push(blocked, false)
    rd := rdeps_of(g)
    # Sized to the whole graph, so neither end can ever park on a full channel.
    jobs := channel(Job, n + 1)
    outs := channel(Outcome, n + 1)
    slots := []int
    for i := 0; i < ncpu(); i += 1:
        push(slots, i)
    w := spawn pool(g, prev, racy, jobs, outs, slots)
    sent := 0
    for i := 0; i < n; i += 1:
        if indeg[i] == 0:
            send(jobs, job_for(g, now, i))
            sent = sent + 1
    live := sent
    for live > 0:
        match recv(outs):
            Some(o):
                live = live - 1
                res[o.idx] = o
                now[o.idx] = o.st
                for k := 0; k < len(rd[o.idx]); k += 1:
                    r := rd[o.idx][k]
                    indeg[r] = indeg[r] - 1
                    # A dependent of a failed node is never dispatched, so a
                    # broken build stops spreading without stopping the nodes
                    # that had nothing to do with it -- and which those are does
                    # not depend on when the failure happened to arrive.
                    if len(o.err) > 0:
                        blocked[r] = true
                    if indeg[r] == 0 and not blocked[r]:
                        send(jobs, job_for(g, now, r))
                        sent = sent + 1
                        live = live + 1
            None: break
    close(jobs)
    ran := wait(w)
    # Raised in TOPOLOGICAL order, so which recipe lost the race cannot decide
    # which failure the user is told about.
    for k := 0; k < len(ord); k += 1:
        if len(res[ord[k]].err) > 0:
            return Err(res[ord[k]].err[0])
    # No failure, so nothing was blocked: every node must have reported, and
    # under its own index. A misfiled or never-ready node is caught here.
    filed := 0
    for i := 0; i < n; i += 1:
        if res[i].idx == i:
            filed = filed + 1
    if filed != n or ran != sent:
        return Err(WorkLost(n, filed))
    stamps_write(stamp, g, now)
    return Ok(log_of(g, ord, res))

# The log, emitted by walking the topological order. Recipe output is indented
# under the rule that produced it with a '| ' marker, so a recipe printing
# something that looks like a log line cannot forge one.
fn log_of(g: graph.Graph, ord: [int], res: [Outcome]) -> [string]:
    out := []string
    tgt := 0
    ran := 0
    src := 0
    fresh := 0
    moved := 0
    tapped := 0
    for k := 0; k < len(ord); k += 1:
        o := res[ord[k]]
        name := graph.name_at(g, ord[k])
        if o.kind == KGROUP:
            push(out, "group " + name)
        elif o.kind == KSOURCE:
            src = src + 1
            if o.st.state == SNEW:
                fresh = fresh + 1
            elif o.st.state == SCHANGED:
                moved = moved + 1
            elif o.st.state == STOUCHED:
                tapped = tapped + 1
            push(out, "src " + name + " " + o.why)
        elif o.kind == KSKIP:
            tgt = tgt + 1
            push(out, "skip " + name + " (up to date)")
        else:
            tgt = tgt + 1
            ran = ran + 1
            push(out, "run " + name + " (" + o.why + ")")
            for t in emitted(o.out):
                push(out, "| " + t)
    push(out, "targets " + str(tgt) + ": " + str(ran) + " run, " + str(tgt - ran) + " up to date")
    push(out, "sources " + str(src) + ": " + str(fresh) + " new, " + str(moved) + " changed, " +
              str(tapped) + " touched, " + str(src - fresh - moved - tapped) + " unchanged")
    if ran == 0:
        push(out, "nothing to do")
    return out

# strings.lines leaves a trailing empty element for text ending in a newline,
# which every well-behaved command produces; printing it would put a bare '| '
# under every rule.
fn emitted(s: string) -> [string]:
    if len(s) == 0:
        return []string
    ls := strings.lines(s)
    if len(ls) > 0 and len(ls[len(ls) - 1]) == 0:
        return arrays.take(ls, len(ls) - 1)
    return ls
