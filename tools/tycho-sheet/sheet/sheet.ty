package sheet

import "core:sort"
import "core:strings"
import "../cell"

# The grid, the dependency graph, and the recalculation order.
#
# RECALCULATION IS ITERATIVE, AND THAT IS THE WHOLE DESIGN. The obvious
# implementation -- evaluate a cell, recursing into each cell it reads -- costs
# one C stack frame per link, so `A1 = A2 + 1` repeated ten thousand times
# segfaults. Kahn's algorithm walks the same graph with an explicit queue and a
# loop, so the depth of the chain costs nothing but heap. A 10000-deep chain
# evaluates here; so does a 100000-deep one. tests/recursion/ is the precedent
# for treating a deep input as something to survive rather than to document.
#
# A CYCLE IS DETECTED BY WHAT KAHN LEAVES BEHIND, not by a depth counter. When
# the queue drains, every cell still holding a non-zero indegree is either in a
# cycle or downstream of one -- there is no recursion to overflow and no limit
# to tune. Those cells then get walked ONCE to recover the actual loop, so the
# error reads `#CYCLE! A1 -> B1 -> A1` and names the cells to go and look at.
# "#CYCLE!" on its own tells you a cycle exists, which you already knew.
#
# ORDER IS DETERMINISTIC EVERYWHERE. Keys are sorted before the queue is seeded
# and before anything is printed, so the same script produces byte-identical
# output on every run. A map's iteration order is not something to rely on.

struct Rec:
    src: string                    # exactly what was typed
    formula: bool
    ast: cell.Ast
    val: cell.Value
    deps: [int]                    # packed keys this formula reads

struct Sheet:
    recs: [int: Rec]
    keys: [int]                    # occupied keys; sorted by _sorted_keys before use

fn new() -> Sheet:
    m := []int: Rec
    return Sheet(m, []int)

fn _sorted_keys(sh: inout Sheet) -> [int]:
    return sort.asc(sh.keys)

fn _empty_ast() -> cell.Ast:
    return cell.Ast([]cell.Node, -1)

# Type a value or a formula into a cell.
#
# A malformed formula is an Err and NOTHING is stored: the sheet is left exactly
# as it was. That is the parse/value split from cell/cell.ty showing up at the
# API -- `=1/0` is accepted and becomes #DIV/0!, `=1/` is refused and the cell
# keeps whatever it held.
fn set(sh: inout Sheet, row: int, col: int, src: string) -> Result(void, string):
    k := cell.key(row, col)
    if strings.starts_with(src, "="):
        a := _empty_ast()
        match cell.parse(src[1:len(src)]):
            Ok(x): a = x
            Err(e): return Err(cell.ref_name(row, col) + ": " + cell.parse_err_str(e))
        ds: [int] = []
        match cell.deps_of(a, &ds):
            Ok(): pass
            Err(m): return Err(cell.ref_name(row, col) + ": " + m)
        if not (k in sh.recs):
            push(sh.keys, k)
        sh.recs[k] = Rec(src, true, a, cell.empty(), ds)
        return Ok()
    # A literal. Numbers are parsed with strtod so `0.1` in a cell is the same
    # double `0.1` in a formula is -- the two must not disagree.
    v := cell.empty()
    t := strings.trim(src)
    if t == "":
        v = cell.empty()
    elif strings.to_upper(t) == "TRUE":
        v = cell.boolean(true)
    elif strings.to_upper(t) == "FALSE":
        v = cell.boolean(false)
    else:
        match cell.parse_num(t):
            Ok(f): v = cell.num(f)
            Err(e): v = cell.text(src)
    if not (k in sh.recs):
        push(sh.keys, k)
    sh.recs[k] = Rec(src, false, _empty_ast(), v, []int)
    return Ok()

fn get(sh: inout Sheet, row: int, col: int) -> cell.Value:
    k := cell.key(row, col)
    if k in sh.recs:
        return sh.recs[k].val
    return cell.empty()

# Recover the loop a stuck cell sits on: follow one dependency at a time,
# staying inside the stuck set, until a cell repeats. Bounded by the size of
# that set, so a cycle-free path into a cycle terminates too.
fn _cycle_from(sh: inout Sheet, start: int, stuck: inout [int: bool]) -> [int]:
    path: [int] = []
    seen := []int: int
    at := start
    for i := 0; i < len(sh.keys) + 2; i += 1:
        if at in seen:
            out: [int] = []
            for j := seen[at]; j < len(path); j += 1:
                push(out, path[j])
            return out
        seen[at] = len(path)
        push(path, at)
        nxt := -1
        if at in sh.recs:
            r := sh.recs[at]
            for j := 0; j < len(r.deps); j += 1:
                d := r.deps[j]
                if d in stuck:
                    nxt = d
                    break
        if nxt < 0:
            return []int
        at = nxt
    return []int

fn _cycle_text(ks: [int]) -> string:
    out := ""
    for i := 0; i < len(ks); i += 1:
        if i > 0:
            out += " -> "
        out += cell.ref_name(ks[i] / cell.COLS(), ks[i] % cell.COLS())
    if len(ks) > 0:
        out += " -> " + cell.ref_name(ks[0] / cell.COLS(), ks[0] % cell.COLS())
    return out

# Recalculate every cell, in dependency order. Returns the number of cells that
# could not be evaluated because they sit on or below a cycle.
fn recalc(sh: inout Sheet) -> int:
    ks := _sorted_keys(&sh)
    env := cell.env_new()
    indeg := []int: int
    dependents := []int: [int]
    for i := 0; i < len(ks); i += 1:
        indeg[ks[i]] = 0
    # Edges run dep -> reader, and only between cells that EXIST. A formula that
    # reads a blank cell reads a constant Empty, which is not a scheduling
    # constraint and must not become one.
    for i := 0; i < len(ks); i += 1:
        k := ks[i]
        r := sh.recs[k]
        if not r.formula:
            continue
        for j := 0; j < len(r.deps); j += 1:
            d := r.deps[j]
            if d in sh.recs:
                indeg[k] = indeg[k] + 1
                if d in dependents:
                    lst := dependents[d]
                    push(lst, k)
                    dependents[d] = lst
                else:
                    dependents[d] = [k]
    queue: [int] = []
    for i := 0; i < len(ks); i += 1:
        if indeg[ks[i]] == 0:
            push(queue, ks[i])
    done := []int: bool
    qi := 0
    for qi < len(queue):
        k := queue[qi]
        qi += 1
        r := sh.recs[k]
        v := r.val
        if r.formula:
            v = cell.eval(r.ast, &env)
        r.val = v
        sh.recs[k] = r
        cell.env_set(&env, k / cell.COLS(), k % cell.COLS(), v)
        done[k] = true
        if k in dependents:
            ds := dependents[k]
            for j := 0; j < len(ds); j += 1:
                indeg[ds[j]] = indeg[ds[j]] - 1
                if indeg[ds[j]] == 0:
                    push(queue, ds[j])
    stuck := []int: bool
    nstuck := 0
    for i := 0; i < len(ks); i += 1:
        if not (ks[i] in done):
            stuck[ks[i]] = true
            nstuck += 1
    for i := 0; i < len(ks); i += 1:
        k := ks[i]
        if k in done:
            continue
        loop := _cycle_from(&sh, k, &stuck)
        txt := "reaches a cycle"
        if len(loop) > 0:
            txt = _cycle_text(loop)
        r := sh.recs[k]
        r.val = cell.bad(cell.Cycle(txt))
        sh.recs[k] = r
        cell.env_set(&env, k / cell.COLS(), k % cell.COLS(), r.val)
    return nstuck

# Every occupied cell, in row-major order: the reference, what was typed, and
# what it evaluates to.
fn dump(sh: inout Sheet) -> [string]:
    ks := _sorted_keys(&sh)
    out: [string] = []
    for i := 0; i < len(ks); i += 1:
        k := ks[i]
        r := sh.recs[k]
        name := cell.ref_name(k / cell.COLS(), k % cell.COLS())
        push(out, strings.pad_right(name, 8, " ") +
                  strings.pad_right(r.src, 26, " ") +
                  cell.detail_value(r.val))
    return out
