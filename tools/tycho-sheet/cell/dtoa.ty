package cell

import "core:strings"


fn is_nan(v: float) -> bool:
    return v != v

fn is_inf(v: float) -> bool:
    return v > 1.7976931348623157e308 or v < -1.7976931348623157e308

fn _fabs(v: float) -> float:
    if v < 0.0:
        return -v
    return v

# True for -0.0 only. 0.0 == -0.0 under IEEE, so the sign has to be read out of
# a division: 1/-0.0 is -inf, 1/0.0 is +inf.
fn is_neg_zero(v: float) -> bool:
    if v != 0.0:
        return false
    return 1.0 / v < 0.0

# 10^k, EXACTLY, for 0 <= k <= 22. Every power of ten up to 10^22 is a binary64
# with no rounding at all -- past that the mantissa runs out. That bound is the
# whole reason this table exists.
fn _pow10(k: int) -> float:
    t := [1e0, 1e1, 1e2, 1e3, 1e4, 1e5, 1e6, 1e7, 1e8, 1e9, 1e10, 1e11,
          1e12, 1e13, 1e14, 1e15, 1e16, 1e17, 1e18, 1e19, 1e20, 1e21, 1e22]
    return t[k]

fn _scale(m: float, k: int) -> float:
    x := m
    kk := k
    for kk > 22:
        x *= 1e22
        kk -= 22
    for kk < -22:
        x /= 1e22
        kk += 22
    if kk >= 0:
        return x * _pow10(kk)
    return x / _pow10(-kk)

fn _big(v: float) -> (int, int):
    m := v
    e := 0
    for m >= 1e32:
        m /= 1e32
        e += 32
    for m >= 1e8:
        m /= 1e8
        e += 8
    for m >= 10.0:
        m /= 10.0
        e += 1
    for m < 1e-32:
        m *= 1e32
        e -= 32
    for m < 1e-8:
        m *= 1e8
        e -= 8
    for m < 1.0:
        m *= 10.0
        e -= 1
    if m >= 10.0:
        m /= 10.0
        e += 1
    big := to_int(_scale(v, 17 - e))
    # The scaling can land one decade out either way; nudge rather than trust it.
    for big >= 1000000000000000000:
        big /= 10
        e += 1
    for big > 0 and big < 100000000000000000:
        big = to_int(_scale(v, 17 - e + 1))
        e -= 1
    return (big, e)

# 10^k as an integer, for 0 <= k <= 18. The candidate arithmetic in render() is
# integer, so it needs the integer table as well as the float one.
fn _p10i(k: int) -> int:
    t := [1, 10, 100, 1000, 10000, 100000, 1000000, 10000000, 100000000,
          1000000000, 10000000000, 100000000000, 1000000000000,
          10000000000000, 100000000000000, 1000000000000000,
          10000000000000000, 100000000000000000, 1000000000000000000]
    return t[k]

# Dekker's exact product: a * b == p + err, with no wider type in the language.
# The splitter is 2^27+1, which needs |a| under ~1.3e300 -- _ref guarantees it.
fn _two_prod(a: float, b: float) -> (float, float):
    p := a * b
    ca := 134217729.0 * a
    ah := ca - (ca - a)
    al := a - ah
    cb := 134217729.0 * b
    bh := cb - (cb - b)
    bl := b - bh
    return (p, ((ah * bh - p) + ah * bl + al * bh) + al * bl)

fn _quick_sum(a: float, b: float) -> (float, float):
    s := a + b
    return (s, b - (s - a))

fn _dd_mul(hi: float, lo: float, d: float) -> (float, float):
    p, ep := _two_prod(hi, d)
    return _quick_sum(p, ep + lo * d)

fn _dd_div(hi: float, lo: float, d: float) -> (float, float):
    q := hi / d
    p, ep := _two_prod(q, d)
    return _quick_sum(q, (((hi - p) - ep) + lo) / d)

# |v| * 10^k as an integer near 10^18, plus the fraction that did not fit.
#
# WHY NOT _scale. _scale rounds once, and at 10^17 one rounding is ~11 units in
# the last digit -- fine for "which digits are roughly right", useless for
# "which decimal is NEAREST", a question decided a digit or two BELOW the 17
# a binary64 can name. This carries every rounding of the scaling forward as a
# second float instead of discarding it, so the pair is good to about 32
# digits; the caller reads the 18 it needs off the integer and settles ties on
# the fraction.
fn _ref(v: float, k: int) -> (int, float):
    hi := v
    lo := 0.0
    g := 0
    # Powers of two are exact in both directions: pull the two extremes into the
    # range where the splitter cannot overflow and an error term cannot underflow.
    if hi > 1e290:
        hi /= 18446744073709551616.0
        g = 1
    if hi < 1e-290:
        hi *= 18446744073709551616.0
        g = -1
    kk := k
    for kk >= 22:
        nh, nl := _dd_mul(hi, lo, 1e22)
        hi = nh
        lo = nl
        kk -= 22
    for kk <= -22:
        nh, nl := _dd_div(hi, lo, 1e22)
        hi = nh
        lo = nl
        kk += 22
    if kk > 0:
        mh, ml := _dd_mul(hi, lo, _pow10(kk))
        hi = mh
        lo = ml
    if kk < 0:
        dh, dl := _dd_div(hi, lo, _pow10(-kk))
        hi = dh
        lo = dl
    if g == 1:
        hi *= 18446744073709551616.0
        lo *= 18446744073709551616.0
    if g == -1:
        hi /= 18446744073709551616.0
        lo /= 18446744073709551616.0
    n := to_int(hi)
    a := to_int(lo)
    return (n + a, lo - to_float(a))

# The `count` decimal digits of `n`, most significant first.
fn _int_digits(n: int, count: int) -> [int]:
    ds: [int] = []
    for i := 0; i < count; i += 1:
        push(ds, 0)
    x := n
    for i := count - 1; i >= 0; i -= 1:
        ds[i] = x % 10
        x /= 10
    return ds

# Round an 18-digit run to `p` digits, half-up. Returns the digits and 1 if the
# carry ran off the front (999 -> 100 with the exponent one higher).
fn _round_to(ds: [int], p: int) -> ([int], int):
    out: [int] = []
    for i := 0; i < p; i += 1:
        push(out, ds[i])
    carry := 0
    if ds[p] >= 5:
        carry = 1
    for i := p - 1; i >= 0; i -= 1:
        t := out[i] + carry
        carry = 0
        if t > 9:
            t = 0
            carry = 1
        out[i] = t
    if carry == 1:
        nw: [int] = [1]
        for i := 0; i < p - 1; i += 1:
            push(nw, out[i])
        return (nw, 1)
    return (out, 0)

fn _digit_str(ds: [int], from: int, to: int) -> string:
    digits := "0123456789"
    out := ""
    for i := from; i < to; i += 1:
        d := ds[i]
        out += digits[d:d + 1]
    return out

# Lay `p` digits out as text. Plain decimal in the range a person reads as a
# number, exponential outside it. The thresholds are fixed constants, not a
# function of the value's history, so the same double always prints the same way.
fn _format(neg: bool, ds: [int], p: int, e: int) -> string:
    sign := ""
    if neg:
        sign = "-"
    if e >= p - 1 and e <= 20:
        # integer, no point: digits then the zeros that follow them
        return sign + _digit_str(ds, 0, p) + strings.repeat("0", e - p + 1)
    if e >= 0 and e < p - 1:
        return sign + _digit_str(ds, 0, e + 1) + "." + _digit_str(ds, e + 1, p)
    if e < 0 and e >= -5:
        return sign + "0." + strings.repeat("0", -e - 1) + _digit_str(ds, 0, p)
    ex := "+"
    a := e
    if a < 0:
        ex = "-"
        a = -a
    mant := _digit_str(ds, 0, 1)
    if p > 1:
        mant += "." + _digit_str(ds, 1, p)
    return sign + mant + "e" + ex + str(a)

# Does `s` read back as exactly `v`? Bit equality, so -0.0 does not pass as 0.0
# and a NaN never passes at all.
fn _same(s: string, v: float) -> bool:
    match strings.parse_float(s):
        Ok(b):
            if b != v:
                return false
            return is_neg_zero(b) == is_neg_zero(v)
        Err(e): return false

# The shortest decimal string that parses back to exactly `v`.
#
# NaN and the infinities have no such string -- strtod rejects all three here --
# so they get names a reader understands and are reported by cell code as
# errors rather than pretended to be numbers.
fn render(v: float) -> string:
    if is_nan(v):
        return "NaN"
    if is_inf(v):
        if v < 0.0:
            return "-Inf"
        return "Inf"
    if v == 0.0:
        if is_neg_zero(v):
            return "-0"
        return "0"
    neg := v < 0.0
    big, e := _big(_fabs(v))
    n, frac := _ref(_fabs(v), 17 - e)
    # _big chose the decade from a value one rounding wide; _ref is the sharper
    # instrument, so it gets the last word on which decade the digits sit in.
    if n >= 1000000000000000000:
        e += 1
        n, frac = _ref(_fabs(v), 17 - e)
    if n < 100000000000000000:
        e -= 1
        n, frac = _ref(_fabs(v), 17 - e)
    for p := 1; p <= 17; p += 1:
        sc := _p10i(18 - p)
        q := n / sc
        rem := n - q * sc
        # Round to p digits on n AND the fraction under it: v is n + frac, and at
        # 0.1+0.2 the fraction is -0.59, which is the whole difference between
        # ...004 and ...005.
        if to_float(rem * 2 - sc) + frac + frac >= 0.0:
            q += 1
        ee := e
        if q >= _p10i(p):
            q /= 10
            sc *= 10
            ee += 1
        step := 1
        if to_float(n - q * sc) + frac < 0.0:
            step = -1
        for w := 0; w < 2; w += 1:
            c := q + w * step
            if c >= _p10i(p - 1) and c < _p10i(p):
                cand := _format(neg, _int_digits(c, p), p, ee)
                if _same(cand, v):
                    return cand
    b17 := big / 10
    if big % 10 >= 5:
        b17 += 1
    for pass := 0; pass < 4; pass += 1:
        for adj := -8; adj <= 8; adj += 1:
            c := b17 + adj
            if c >= 10000000000000000 and c < 100000000000000000:
                nds := _int_digits(c * 10, 18)
                for p := 16; p <= 17; p += 1:
                    rd, bump := _round_to(nds, p)
                    cand := _format(neg, rd, p, e + bump)
                    if _same(cand, v):
                        return cand
        cur := _format(neg, _int_digits(b17, 17), 17, e)
        match strings.parse_float(cur):
            Ok(b):
                step := to_int(_scale(_fabs(v) - _fabs(b), 16 - e))
                if step == 0:
                    return "#NUM!"
                b17 += step
            Err(er): return "#NUM!"
    # Nothing round-trips. Say so in the cell rather than print a number that is
    # not the one held: a silently wrong digit is the failure this file exists
    # to prevent.
    return "#NUM!"

# Text to float, for formula literals. strtod, so it is correctly rounded --
# the round trip render() promises is only true against this parser.
fn parse_num(s: string) -> Result(float, string):
    match strings.parse_float(s):
        Ok(v): return Ok(v)
        Err(e): return Err("not a number: " + s)
