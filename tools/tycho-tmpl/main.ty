package main

import "core:cli"
import "core:io"
import "core:strings"
import "doc"

# Substitute every `{{name}}` in one line. Err names the first missing key.
fn expand(line: string, keys: [string], vals: [string]) -> Result(string, string):
    out := ""
    i := 0
    n := len(line)
    for i < n:
        if i + 1 < n and line[i] == 123 and line[i + 1] == 123:      # "{{"
            close := -1
            j := i + 2
            for j + 1 < n:
                if line[j] == 125 and line[j + 1] == 125:            # "}}"
                    close = j
                    j = n
                else:
                    j += 1
            if close < 0:
                return Err("unclosed {{ in: " + line)
            name := line[i + 2:close]
            hit := -1
            for k := 0; k < len(keys); k += 1:
                if keys[k] == name:
                    hit = k
            if hit < 0:
                return Err("no value for {{" + name + "}}")
            out = out + vals[hit]
            i = close + 2
        else:
            out = out + line[i:i + 1]
            i += 1
    return Ok(out)

# Every non-empty line expanded, or death naming the first bad one. Returning
# the array rather than filling a caller's is what lets `doc.of` ADOPT it: a
# call's result is a fresh value, and fresh values are adoptable.
fn expand_all(text: string, keys: [string], vals: [string]) -> [string]:
    out := []string
    for line in strings.lines(text):
        if len(line) == 0:
            continue
        match expand(line, keys, vals):
            Ok(s): push(out, s)
            Err(e): die("tycho-tmpl: " + e)
    return out

fn main():
    c := cli.Cli([], [], [], [], [], [])
    match cli.parse_checked(cli.argv(), ["tmpl", "set", "sep"], ["help"]):
        Ok(v): c = v
        Err(cli.Unknown(tok)): die("tycho-tmpl: unknown option " + tok)
        Err(cli.NoValue(tok)): die("tycho-tmpl: " + tok + " needs a value")

    path := cli.get(c, "tmpl", "")
    if path == "":
        println("usage: tycho-tmpl --tmpl FILE --set k=v [--set k=v ...] [--sep S]")
        exit(2)
    sep := cli.get(c, "sep", "\n")

    # cli.get keeps the LAST --set, so the pairs come from the raw argv: every
    # `--set k=v` in order. A repeated key is last-wins, stated here rather than
    # left to the reader.
    keys := []string
    vals := []string
    av := cli.argv()
    for i := 0; i < len(av); i += 1:
        if av[i] == "--set" and i + 1 < len(av):
            kv := split(av[i + 1], "=")
            if len(kv) != 2:
                die("tycho-tmpl: --set wants k=v, got " + av[i + 1])
            push(keys, kv[0])
            push(vals, kv[1])

    text := ""
    match io.read_text(path):
        Ok(t): text = t
        Err(e): die("tycho-tmpl: cannot read " + path)

    n := len(expand_all(text, keys, vals))
    println(doc.render(doc.join(doc.of(expand_all(text, keys, vals)),
                                doc.add(doc.empty(), "-- rendered " + str(n) + " line(s)")),
                       sep))
