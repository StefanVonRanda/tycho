package doc

struct Doc:
    parts: [string]
    n: int

fn empty() -> Doc:
    return Doc([]string, 0)

fn of(xs: sink [string]) -> Doc:
    return Doc(xs, len(xs))

# Consumes `d`, returns it grown. The caller writes `d = doc.add(d, "x")`, and
# any other use of the old `d` is a compile error rather than a second buffer.
fn add(d: sink Doc, s: string) -> Doc:
    push(d.parts, s)
    d.n = d.n + 1
    return d

# Consumes two documents into one. Both arguments are dead after the call, which
# is what makes the concatenation a move rather than two copies.
fn join(a: sink Doc, b: sink Doc) -> Doc:
    for p in b.parts:
        push(a.parts, p)
    a.n = a.n + b.n
    return a

# The terminal step: consumes the document and yields the text. There is no Doc
# afterwards, which is the property `sink` states and `inout` cannot.
fn render(d: sink Doc, sep: string) -> string:
    out := ""
    for i := 0; i < len(d.parts); i += 1:
        if i > 0:
            out = out + sep
        out = out + d.parts[i]
    return out

fn count(d: Doc) -> int:      # an ordinary borrow: reading does not consume
    return d.n
