; Fixed global depths must work both in initializers and in functions they call.
(define (read-b) b)
(define a 7)
(define b (+ a 1))
(define c (read-b))
(define early (begin (set! a 9) (read-b)))
(define (bump) (set! b (+ b 1)) b)
(define d (bump))
(define (make-getter) (lambda () a))
(define getter (make-getter))
(define nil-value '())
(define nil-copy nil-value)
(define total (sum '(1 2 3)))
(define mapped (map (lambda (x) (+ x a)) '(1 2)))

; A function's binding can change; aliases retain the original closure value.
(define (f x) (+ x 1))
(define through-alias f)
(define initial (f 10))
(define (rebind) (set! f (lambda (x) (+ x 100))))
(define changed (begin (rebind) (f 10)))
; Mutation discovered before a declaration must also defeat static calls.
(define (replace-later) (set! later (lambda (x) (+ x 200))))
(define (later x) (+ x 2))
(define before (later 10))
(define after (begin (replace-later) (later 10)))
(define (dup x) (+ x 3))
(define dup-before (dup 10))
(define dup-alias dup)
(define (dup x) (+ x 4))
(define dup-after (dup 10))
(define counter 1)
(define counter (+ counter 1))

; Direct recursive entries must still box captured parameters on every call.
(define (boxed-sum n)
  (define here (lambda () n))
  (if (< n 1) (here) (+ (here) (boxed-sum (- n 1)))))
(define boxed-init (boxed-sum 4))
; Function-value entry checks establish the same initialized-prefix invariant.
(define (checked-inc x) (+ (abs x) 1))
(define checked-alias checked-inc)
(define alias-init (checked-alias -4))

(set! a 10)
(display a) (newline)
(display b) (newline)
(display c) (newline)
(display early) (newline)
(display d) (newline)
(display (getter)) (newline)
(display nil-copy) (newline)
(display total) (newline)
(display mapped) (newline)
(display initial) (newline)
(display changed) (newline)
(display before) (newline)
(display after) (newline)
(display dup-before) (newline)
(display dup-after) (newline)
(display (dup-alias 10)) (newline)
(display counter) (newline)
(display (through-alias 10)) (newline)
(display boxed-init) (newline)
(display alias-init) (newline)
