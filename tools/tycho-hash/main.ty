package main

import "core:io"
import "core:path"
import "core:sha256"
import "core:strings"
import "core:sort"

struct Job:
    idx:  int
    rel:  string
    abs:  string

struct Res:
    idx:  int
    rel:  string
    hash: string
    size: int

fn fail(msg: string):
    eprint("tycho-hash: " + msg + "\n")
    exit(2)

# Every regular file under `root`, relative to it, sorted -- the WALK is what
# makes the file set deterministic; the hashing below is what makes the report
# deterministic. Both are needed and they are separate properties.
fn walk(root: string) -> [string]:
    out := []string
    dirs := []string
    push(dirs, "")
    i := 0
    for i < len(dirs):
        rel := dirs[i]
        i = i + 1
        abs := root
        if rel != "":
            abs = path.join(root, rel)
        names := []string
        # Same gap io.list() has in tycho-ar: an unreadable directory reads as an
        # empty one, so the digest covered fewer files than the report claimed.
        match io.list_checked(abs):
            Ok(ns):
                names = ns
            Err(e):
                die("tycho-hash: cannot list " + abs)
        for name in names:
            crel := name
            if rel != "":
                crel = rel + "/" + name
            cabs := path.join(root, crel)
            isdir := false
            match io.is_dir(cabs):
                Ok(b): isdir = b
                Err(e): isdir = false
            if isdir:
                push(dirs, crel)
            else:
                push(out, crel)
    return sort.asc(out)

# One worker: pull jobs until the channel is closed and drained, hash, send back.
# The channels are PARAMETERS, not captures -- an affine value cannot be captured
# by a closure or a `parallel for`, so this is the shape that exists.
fn worker(id: int, live: int, jobs: Channel(Job), out: Channel(Res)) -> int:
    # A task cannot live in an array, so the worker set is a fixed list of named
    # spawns and --workers cannot change how MANY are spawned. It changes how many
    # CONSUME: a worker past the live count returns at once and never pulls a job.
    # Written after the first version ignored --workers entirely and the
    # determinism check silently compared eight workers against eight.
    if id >= live:
        return 0
    did := 0
    for true:
        match recv(jobs):
            Some(j):
                h := ""
                n := 0
                match io.read_bytes(j.abs):
                    Ok(b):
                        st := sha256.init()
                        sha256.update(&st, b)
                        h = sha256.final_hex(&st)
                        n = len(b)
                    Err(e):
                        h = "unreadable"
                        n = 0 - 1
                send(out, Res(j.idx, j.rel, h, n))
                did = did + 1
            None: return did
    return did

fn main():
    av := args()
    root := ""
    nw := 4
    show_dist := false
    for i := 1; i < len(av); i += 1:
        a := av[i]
        if strings.starts_with(a, "--workers="):
            rest := a[10:len(a)]
            match strings.parse_int_checked(rest):
                Ok(v): nw = v
                _: fail("--workers needs a number, got '" + rest + "'")
            if nw < 1 or nw > 8:
                fail("--workers must be 1..8, got " + str(nw))
        elif a == "--dist":
            show_dist = true
        elif strings.starts_with(a, "-"):
            fail("unknown option: " + a)
        else:
            root = a
    if root == "":
        fail("usage: tycho-hash DIR [--workers=N]")
    match io.is_dir(root):
        Ok(b):
            if not b:
                fail("not a directory: " + root)
        Err(e): fail("cannot stat: " + root)

    rels := walk(root)
    n := len(rels)
    if n == 0:
        println("0 files")
        exit(0)

    jobs := channel(Job, 32)
    out := channel(Res, 32)

    # Fixed fan-out: a task cannot be stored in an array, so a worker count is a
    # set of NAMED tasks, not a loop. Eight is the cap the option enforces.
    w1 := spawn worker(0, nw, jobs, out)
    w2 := spawn worker(1, nw, jobs, out)
    w3 := spawn worker(2, nw, jobs, out)
    w4 := spawn worker(3, nw, jobs, out)
    w5 := spawn worker(4, nw, jobs, out)
    w6 := spawn worker(5, nw, jobs, out)
    w7 := spawn worker(6, nw, jobs, out)
    w8 := spawn worker(7, nw, jobs, out)

    for i := 0; i < n; i += 1:
        send(jobs, Job(i, rels[i], path.join(root, rels[i])))
    close(jobs)

    # Collect by INDEX. Results arrive in completion order; the report does not.
    hashes := []string
    sizes := []int
    for i := 0; i < n; i += 1:
        push(hashes, "")
        push(sizes, 0)
    got := 0
    for got < n:
        match recv(out):
            Some(r):
                hashes[r.idx] = r.hash
                sizes[r.idx] = r.size
                got = got + 1
            None: got = n

    # Join every worker and sum what each did: the total must equal the file
    # count exactly -- not "about right" -- or a job was dropped or done twice.
    d1 := wait(w1)
    d2 := wait(w2)
    d3 := wait(w3)
    d4 := wait(w4)
    d5 := wait(w5)
    d6 := wait(w6)
    d7 := wait(w7)
    d8 := wait(w8)
    done := d1 + d2 + d3 + d4 + d5 + d6 + d7 + d8
    # The per-worker split, on STDERR so it cannot disturb the report. Without it
    # "identical at every worker count" is vacuous: it would also hold if one
    # worker did every file. The lane reads this to assert the pool really shares.
    if show_dist:
        eprint("dist " + str(d1) + " " + str(d2) + " " + str(d3) + " " + str(d4) + " "
             + str(d5) + " " + str(d6) + " " + str(d7) + " " + str(d8) + "\n")

    total := 0
    for i := 0; i < n; i += 1:
        println(hashes[i] + "  " + str(sizes[i]) + "  " + rels[i])
        if sizes[i] > 0:
            total = total + sizes[i]
    println("-- " + str(n) + " files, " + str(total) + " bytes, " + str(done) + " hashed")
    exit(0)
