package pipe

# --- generic combinators over an array ---------------------------------------

# Keep the elements a predicate accepts. No constraint: nothing here touches the
# element beyond copying it.
fn keep(xs: [$T], f: fn($T) -> bool) -> [$T]:
    out := []$T
    for x in xs:
        if f(x):
            push(out, x)
    return out

# Map to a DIFFERENT element type -- the two-parameter case, which is where a
# single-parameter mental model breaks.
fn to(xs: [$T], f: fn($T) -> $U) -> [$U]:
    out := []
    for x in xs:
        push(out, f(x))
    return out

# Fold with an explicit accumulator type: three types in one signature.
fn fold(xs: [$T], init: $A, f: fn($A, $T) -> $A) -> $A:
    acc := init
    for x in xs:
        acc = f(acc, x)
    return acc

# --- a generic struct, and the group-by that motivates it ---------------------

# Counts per key. `hashable(K)` is what the map inside needs; the struct itself
# carries the constraint at every function that touches the map, not on the
# declaration, which is the rule this package exists to find out about.
struct Tally($K):
    keys: [$K]                  # insertion order, so a report is reproducible
    n: [$K: int]


fn bump(t: inout Tally($K), k: $K) where hashable(K):
    if k in t.n:
        t.n[k] = t.n[k] + 1
    else:
        push(t.keys, k)
        t.n[k] = 1

fn count_of(t: Tally($K), k: $K) -> int where hashable(K):
    if k in t.n:
        return t.n[k]
    return 0

fn distinct(t: Tally($K)) -> int:
    return len(t.keys)

fn group_into(t: inout Tally($K), xs: [$T], key: fn($T) -> $K) where hashable(K):
    for x in xs:
        bump(&t, key(x))
