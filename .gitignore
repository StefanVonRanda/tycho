# macOS
.DS_Store

# Scratch + build-temp artifacts that must never be committed. Two slipped into
# release tarballs via an unscoped `git add`: a ~3.8MB tmpXXXX/ scratch dir
# (v0.1.0) and a cc-generated ccXXXXXX.s assembler temp (v0.1.1). Match tmp-named
# files AND dirs, plus stray compiler temps (the repo has no hand-written .s).
/tmp*
*.s
cc??????.s
# personal local book draft — not part of the repo
/book/
# profiler output (valgrind --tool=callgrind/cachegrind, perf, gprof) — scratch, never source
cachegrind.out.*
callgrind.out.*
perf.data*
gmon.out
# transpiled C emitted by `tychoc <pkg>.ty --emit-c` next to the source
# (e.g. compiler/tychoc0.c) — a build artifact, never source
/compiler/*.c

# The compiled Tycho compiler (built by `make`)
/tychoc

# The self-hosted compiler binary + its emitted C, when built at the repo root
# (e.g. `tychoc compiler/tychoc0.ty -o ./tychoc0`) — build artifacts, never source
/tychoc0
/tychoc0.c
# ...and the same binary built next to its source (`tychoc compiler/tychoc0.ty
# -o compiler/tychoc0`). The emitted C there is already covered by /compiler/*.c.
/compiler/tychoc0

# The five `.c` entries below are NOT produced by their `make` target any more.
# docs/internals/plan-loops-cleanup-DONE.md phase 52 made the plain build `remove()` its own intermediate
# (src/tychoc.c:13647), so `make tycho`, `make tychofmt`, `make tycho-lsp` and
# `make server` now leave only a binary. They are kept because they still catch a
# real artifact by the OTHER route: `--emit-c -o <base>` writes `<base>.c` and
# deliberately keeps it (src/tychoc.c:13616-13618), which is the documented way to
# debug the toolchain itself (docs/guides/debugging.md:37). Verified 2026-07-30 by
# running `./tychoc tools/tycho.ty --shim tools/tycho_shim.c --emit-c -o tycho`:
# `tycho.c` appeared at the root and `git status --short` stayed empty.

# The compiled `tycho` daily-driver CLI (`make tycho`) + its `--emit-c -o tycho` C
/tycho
/tycho.c

# The compiled `tychofmt` formatter (`make tychofmt`) + its `--emit-c -o tychofmt` C
/tychofmt
/tychofmt.c

# The compiled `tycho-lsp` language server (`make tycho-lsp`) + its `--emit-c` C
/tycho-lsp
/tycho-lsp.c

# The compiled `tycho-debug` gdb adapter (`make tycho-debug`) + its `--emit-c` C
/tycho-debug
/tycho-debug.c

# The compiled static web server (built by `make server` from server/main.ty).
# server/main.ty and server/www/ ARE tracked; the binary is not. Also catch the
# form built next to its source: a plain `./tychoc server/main.ty` still leaves
# the `server/main` BINARY (verified 2026-07-30), only its `.c` is now removed.
/tycho-httpd
/tycho-httpd.c
/server/tycho-httpd
/server/main
/server/main.c

# Playwright MCP scratch (screenshots, snapshots) — never source
/.playwright-mcp/

# Editor-extension dev artifacts (the sources under editors/ ARE tracked)
/editors/**/node_modules/
/editors/**/*.vsix

# Generated runtime-embed header (built by `make` from runtime/tycho_rt.c)
/build/

# Per-example outputs: generated C and native binaries. The .ty sources are
# tracked; everything else in examples/ is reproducible with `make` / `./tychoc`.
/examples/*
!/examples/*.ty
!/examples/README.md
# the sqlite FFI example is a multi-file dir (shim + harness); track it (its own
# .gitignore drops the build artifacts, the root *.out exception keeps the golden).
!/examples/sqlite
# the Conway's Life example is also a shim dir (own .gitignore drops the binary +
# intermediate C; the root *.out exception below keeps its golden).
!/examples/life
# the Snake example is a shim dir too (termios input shim + own .gitignore).
!/examples/snake
# the Minesweeper example is a shim dir too (termios input shim + own .gitignore).
!/examples/minesweeper
# the corelib usage examples (one program per core module + their goldens) are
# tracked; the runner builds into a temp dir, so no binaries land here.
!/examples/corelib
# the fetch CLI dogfood (main.ty + fixture + runner + golden); builds into a temp dir.
!/examples/fetch
# the static-site generator dogfood (main.ty + fixture site + runner + golden).
!/examples/site
# The four below each hold a TRACKED expected.out and, until 2026-08-02, no
# un-ignore at all: the `/examples/*` rule above swallowed the whole directory
# and only the index kept those goldens alive. A tracked file beats every ignore
# rule, so nothing showed -- but `RECORD=1` over a deleted one re-created an
# INVISIBLE file, and scripts/check_goldens.py could not see it because "is it
# tracked" is a different question from "would .gitignore let it back in".
# Un-ignoring cost nothing here: all four runners already build into a
# `mktemp -d` (examples/mandelbrot/run.sh:22, examples/raytrace/run.sh:22,
# examples/weblog/run.sh:37, examples/webserver/run.sh:46), so no build artifact
# lands in these directories. Each still carries its own .gitignore for the
# manual `tychoc examples/<lane>/main.ty -o ...` case, as examples/sqlite does.
!/examples/mandelbrot
!/examples/raytrace
!/examples/weblog
!/examples/webserver

# Editor/OS noise
*.o
*.out
*.dSYM/

# ...but the recorded test-suite goldens ARE tracked (expected output, not a
# build artifact). Must come after the broad *.out rule above.
!/tests/*.out
# package-program goldens live in a subdir, so they need a separate un-ignore
!/tests/pkg/*.out
# HISTORY: a `!/tests/postfreeze/*.out` exception sat here from 2026-07-29 until
# later the same day, when the tychoc0 freeze lanes were retired and that
# directory was folded back into tests/. Its goldens are now covered by the
# `!/tests/*.out` rule above, which is where they came from.
# corelib test goldens (corelib/test/<name>.out) are tracked too
!/corelib/test/*.out
# FFI regression golden (tests/ffi/expected.out) is tracked too
!/tests/ffi/*.out
# the sqlite FFI example's golden is tracked too
!/examples/sqlite/*.out
# the Conway's Life example's golden is tracked too
!/examples/life/*.out
# the Snake example's golden is tracked too
!/examples/snake/*.out
# the Minesweeper example's golden is tracked too
!/examples/minesweeper/*.out
# the corelib usage examples' goldens (examples/corelib/<name>.out) are tracked too
!/examples/corelib/*.out
# the fetch dogfood's golden (examples/fetch/expected.out) is tracked too
!/examples/fetch/*.out
# the site dogfood's golden (examples/site/expected.out) is tracked too
!/examples/site/*.out
# ...and the four whose directories were un-ignored above. Both halves are
# required: un-ignoring the directory alone leaves the broad `*.out` rule to
# swallow the golden again. scripts/check_goldens.py asserts this now.
!/examples/mandelbrot/*.out
!/examples/raytrace/*.out
!/examples/weblog/*.out
!/examples/webserver/*.out
.koka/
# concurrency suite goldens (tests/conc/<name>.out) are tracked too
!/tests/conc/*.out
# the tycho-ar archiver's listing golden (tools/tycho-ar/expected.out) is tracked
# too -- it is a recorded assertion, not a build artifact. Without this line the
# broad `*.out` rule above swallows it silently and `make ar-check` fails on a
# fresh clone with "no golden".
!/tools/tycho-ar/*.out
# the tycho-q query tool's transcript golden (tools/tycho-q/expected.out) is
# tracked too, for the same reason and against the same trap: the golden gets
# written, `make q-check` goes green, and without this line the file never
# appears in `git status` at all, so a fresh clone fails with "no golden". That
# is not hypothetical -- it is exactly what happened to tycho-ar's golden above.
!/tools/tycho-q/*.out
# the tycho-vm bytecode tool's golden (tools/tycho-vm/expected.out) is tracked
# too -- the disassembly listings, the three programs' output and fib's trace
# excerpt are recorded assertions, not build artifacts. Same line, same reason
# as the two above; the runner builds the binary and every .tyc into a
# `mktemp -d`, so nothing else in that directory needs un-ignoring.
!/tools/tycho-vm/*.out
# the tycho-scheme interpreter's golden (tools/tycho-scheme/expected.out) is
# tracked too, same line, same reason as the three above; the runner builds the
# binary into a `mktemp -d`, so nothing else in that directory needs
# un-ignoring.
!/tools/tycho-scheme/*.out
# the tycho-kv store's golden (tools/tycho-kv/expected.out) is tracked too --
# the map backend's locked output over the three command scripts. Same line,
# same reason; the runner works in a `mktemp -d`.
!/tools/tycho-kv/*.out
# the tycho-rsa selfcheck transcript golden (tools/tycho-rsa/expected.out) is
# tracked too, same line, same reason as the four above; the runner works in a
# `mktemp -d`.
!/tools/tycho-rsa/*.out
# the tycho-kvsrv daemon gate's transcript golden (tools/tycho-kvsrv/expected.out)
# is tracked too, same line, same reason; the runner works in a `mktemp -d`.
!/tools/tycho-kvsrv/*.out
# the tycho-sat corpus-gate transcript golden (tools/tycho-sat/expected.out)
# is tracked too, same line, same reason; the runner works in a `mktemp -d`.
!/tools/tycho-sat/*.out

# Claude Code session state (locks, worktrees) — never publish
/.claude/
dist/

# generated wiki mirror (see scripts/sync-wiki.py, make wiki)
.wiki/
# the tycho-chess engine's perft divide transcript golden
# (tools/tycho-chess/expected.out) is tracked too, same line, same reason as
# the four above; the runner builds the binary into a `mktemp -d`.
!/tools/tycho-chess/*.out

# the agent instructions live on disk but are not part of the repo
/CLAUDE.md
# the tycho-build tool's dispatch-order golden (tools/tycho-build/expected.out) is
# tracked too, same shape as the other tool lanes.
!/tools/tycho-build/*.out
# the tycho-db database's transcript golden (tools/tycho-db/expected.out) is
# tracked too, same line, same reason as every lane above it.
!/tools/tycho-db/*.out
/tools/tycho-db/tycho-db
# the tycho-flow pipeline engine's transcript golden
# (tools/tycho-flow/expected.out) is tracked too, same line, same reason as
# every lane above it: *.out is ignored broadly, so without this the golden is
# green on the author's disk and absent from a fresh clone.
!/tools/tycho-flow/*.out
# the tycho-ed editor's transcript golden (tools/tycho-ed/expected.out) is
# tracked too, same line, same reason as every lane above it.
!/tools/tycho-ed/*.out
# the tycho-sheet spreadsheet engine's transcript golden
# (tools/tycho-sheet/expected.out), same line, same reason.
!/tools/tycho-sheet/*.out
# the tycho-sim entity simulation's transcript golden
# (tools/tycho-sim/expected.out), same line, same reason.
!/tools/tycho-sim/*.out
# the tycho-tmpl renderer's golden
# (tools/tycho-tmpl/tmpl.out), same line, same reason.
!/tools/tycho-tmpl/*.out
# the tycho-stat statistics program's golden
# (tools/tycho-stat/stat.out), same line, same reason.
!/tools/tycho-stat/*.out
# the tycho-ledger totals program's golden
# (tools/tycho-ledger/ledger.out), same line, same reason.
!/tools/tycho-ledger/*.out
# the tycho-fh handle counter's golden
# (tools/tycho-fh/fh.out), same line, same reason.
!/tools/tycho-fh/*.out
# the tycho-grid golden
# (tools/tycho-grid/grid.out), same line, same reason.
!/tools/tycho-grid/*.out
# the tycho-agg group-and-count's report golden
# (tools/tycho-agg/agg.out), same line, same reason.
!/tools/tycho-agg/*.out
# the tycho-tally ledger's suite+report golden
# (tools/tycho-tally/tally.out), same line, same reason.
!/tools/tycho-tally/*.out
# the tycho-snap snapshot tool's transcript golden
# (tools/tycho-snap/snap.out), same line, same reason.
!/tools/tycho-snap/*.out
# the tycho-make dependency graph's transcript golden
# (tools/tycho-make/expected.out), same line, same reason.
!/tools/tycho-make/*.out

# bench/peakrss is a built binary (bench/peakrss.c); bench/run.sh and
# bench/transpile/run.sh compile it on demand.
/bench/peakrss

# python bytecode from running the gate scripts directly
__pycache__/
*.pyc
