package compress

# Why a compression or decompression failed. Payload-free, so `==` works.
enum ZErr:
    Corrupt        # inflate refused the data: bad wrapper, bad checksum, needs a dictionary
    Truncated      # the input stops mid-stream
    Failed         # init or allocation failed -- nothing to do with the payload
    TooBig         # the output passed the decompression ceiling -- a bomb, not a
                   # damaged stream: the input is VALID and that is the danger

# ---- shim externs (zlib; defined in compress_shim.c) ----
# The inflate pair take a `status: inout int` out-param, the same FFI shape
# core:io's iox_read_file uses: a `bytes` return cannot also carry a code.
extern fn zx_compress(data: bytes) -> bytes
extern fn zx_decompress(data: bytes, status: inout int) -> bytes
extern fn zx_raw_deflate(data: bytes) -> bytes
extern fn zx_raw_inflate(data: bytes, status: inout int) -> bytes
extern fn zx_deflate_new(level: int, status: inout int) -> ptr
extern fn zx_inflate_new(status: inout int) -> ptr
extern fn zx_deflate_free(s: ptr)
extern fn zx_inflate_free(s: ptr)
extern fn zx_deflate_chunk(s: ptr, data: bytes, status: inout int) -> bytes
extern fn zx_deflate_finish(s: ptr, status: inout int) -> bytes
extern fn zx_inflate_chunk(s: ptr, data: bytes, status: inout int) -> bytes
extern fn zx_inflate_finish(s: ptr, status: inout int) -> bytes
extern fn bzx_available() -> int
extern fn bzx_compress(data: bytes, status: inout int) -> bytes
extern fn bzx_decompress(data: bytes, status: inout int) -> bytes

# PPMd and PKZIP legacy codecs (vendored public-domain C; no runtime library).
extern fn ppx_decompress_7z(data: bytes, order: int, mem_size: int, expected_size: int, status: inout int) -> bytes
extern fn ppx_compress_7z(data: bytes, order: int, mem_size: int, status: inout int) -> bytes
extern fn ppx_decompress_zip(data: bytes, order: int, mem_size: int, restore: int, expected_size: int, status: inout int) -> bytes
extern fn ppx_compress_zip(data: bytes, order: int, mem_size: int, restore: int, status: inout int) -> bytes
extern fn pkx_unshrink(data: bytes, expected_size: int, status: inout int) -> bytes
extern fn pkx_explode(data: bytes, expected_size: int, flags: int, status: inout int) -> bytes
extern fn pkx_expand(data: bytes, expected_size: int, factor: int, status: inout int) -> bytes
extern fn pkx_shrink(data: bytes, status: inout int) -> bytes
extern fn pkx_implode(data: bytes, flags: int, status: inout int) -> bytes
extern fn pkx_reduce(data: bytes, factor: int, status: inout int) -> bytes
extern fn dfx_compress(data: bytes, status: inout int) -> bytes
extern fn dfx_decompress(data: bytes, expected_size: int, status: inout int) -> bytes

const ZD_OK = 0
const ZD_CORRUPT = 1
const ZD_TRUNCATED = 2
const ZD_TOOBIG = 3
const ZD_FAILED = 4

fn compress(data: bytes) -> bytes:
    return zx_compress(data)

# Shared decode of the shim's status code, so both inflate entry points answer
# with the same set of causes.
fn _cause(st: int) -> ZErr:
    if st == ZD_CORRUPT:
        return Corrupt
    if st == ZD_TRUNCATED:
        return Truncated
    if st == ZD_TOOBIG:
        return TooBig
    if st == ZD_FAILED:
        return Failed
    return Failed

# Ok(b) on success -- and an empty payload is Ok with len(b) == 0, a real value
# now distinct from Err. That distinction is the whole point of the signature.
fn decompress(data: bytes) -> Result(bytes, ZErr):
    st := 0
    b := zx_decompress(data, &st)
    if st == ZD_OK:
        return Ok(b)
    return Err(_cause(st))

# bzip2 is loaded at run time (libbz2.so.1 / libbz2.dylib / libbz2.dll), so
# core:compress has no hard link dependency on it. Check availability first.
fn bzip2_available() -> bool:
    return bzx_available() == 1

fn bzip2_compress(data: bytes) -> Result(bytes, ZErr):
    st := 0
    b := bzx_compress(data, &st)
    if st == ZD_OK:
        return Ok(b)
    return Err(_cause(st))

fn bzip2_decompress(data: bytes) -> Result(bytes, ZErr):
    st := 0
    b := bzx_decompress(data, &st)
    if st == ZD_OK:
        return Ok(b)
    return Err(_cause(st))

# Raw DEFLATE (RFC 1951), no wrapper -- the stream zip entries use.
fn raw_compress(data: bytes) -> bytes:
    return zx_raw_deflate(data)

# NOTE on the Err cause here: raw DEFLATE has no wrapper and no checksum, so
# arbitrary bytes are a valid-looking bit stream that simply runs out -- zlib
# reports that as "no progress", which decodes to Truncated. Do not read
# Truncated on a RAW stream as "the rest exists somewhere"; on a raw stream it
# means "not a deflate stream" just as often. The gzip/zlib entry point above
# has a header and a checksum and can tell the two apart.
fn raw_decompress(data: bytes) -> Result(bytes, ZErr):
    st := 0
    b := zx_raw_inflate(data, &st)
    if st == ZD_OK:
        return Ok(b)
    return Err(_cause(st))

struct Deflater:
    p: ptr

struct Inflater:
    p: ptr

# Gzip-wrapped streaming deflater. Each chunk may produce zero bytes; finish
# emits the trailer and marks the stream ended.
fn deflater_new(level: int) -> Result(Deflater, ZErr):
    st := 0
    p := zx_deflate_new(level, &st)
    if is_null(p):
        return Err(_cause(st))
    return Ok(Deflater(p))

fn deflate_chunk(d: inout Deflater, data: bytes) -> Result(bytes, ZErr):
    st := 0
    b := zx_deflate_chunk(d.p, data, &st)
    if st == ZD_OK:
        return Ok(b)
    return Err(_cause(st))

fn deflate_finish(d: inout Deflater) -> Result(bytes, ZErr):
    st := 0
    b := zx_deflate_finish(d.p, &st)
    if st == ZD_OK:
        return Ok(b)
    return Err(_cause(st))

fn deflater_free(d: Deflater):
    zx_deflate_free(d.p)

# Inflater auto-detects gzip or zlib wrappers, matching decompress().
fn inflater_new() -> Result(Inflater, ZErr):
    st := 0
    p := zx_inflate_new(&st)
    if is_null(p):
        return Err(_cause(st))
    return Ok(Inflater(p))

fn inflate_chunk(i: inout Inflater, data: bytes) -> Result(bytes, ZErr):
    st := 0
    b := zx_inflate_chunk(i.p, data, &st)
    if st == ZD_OK:
        return Ok(b)
    return Err(_cause(st))

fn inflate_finish(i: inout Inflater) -> Result(bytes, ZErr):
    st := 0
    b := zx_inflate_finish(i.p, &st)
    if st == ZD_OK:
        return Ok(b)
    return Err(_cause(st))

fn inflater_free(i: Inflater):
    zx_inflate_free(i.p)

# ---- reversible filters (delta, x86 BCJ, byte swaps) ----
enum FilterErr:
    BadDistance
    BadAlignment

struct Delta:
    distance: int
    history: [int]

fn delta_new(distance: int) -> Result(Delta, FilterErr):
    if distance < 1 or distance > 256:
        return Err(BadDistance)
    h := []int
    for i := 0; i < distance; i += 1:
        push(h, 0)
    return Ok(Delta(distance, h))

fn _delta_update_bytes(d: inout Delta, src: bytes):
    n := len(src)
    if n >= d.distance:
        for j := 0; j < d.distance; j += 1:
            d.history[j] = src[n - d.distance + j]
    else:
        for j := 0; j < d.distance - n; j += 1:
            d.history[j] = d.history[j + n]
        for j := 0; j < n; j += 1:
            d.history[d.distance - n + j] = src[j]

fn _delta_update_ints(d: inout Delta, src: [int]):
    n := len(src)
    if n >= d.distance:
        for j := 0; j < d.distance; j += 1:
            d.history[j] = src[n - d.distance + j]
    else:
        for j := 0; j < d.distance - n; j += 1:
            d.history[j] = d.history[j + n]
        for j := 0; j < n; j += 1:
            d.history[d.distance - n + j] = src[j]

fn delta_encode(d: inout Delta, data: bytes) -> bytes:
    out := []int
    for i := 0; i < len(data); i += 1:
        prev := 0
        if i >= d.distance:
            prev = data[i - d.distance]
        else:
            prev = d.history[i]
        v := data[i] - prev
        if v < 0:
            v += 256
        push(out, v)
    _delta_update_bytes(&d, data)
    return to_bytes(out)

fn delta_decode(d: inout Delta, data: bytes) -> bytes:
    out := []int
    for i := 0; i < len(data); i += 1:
        prev := 0
        if i >= d.distance:
            prev = out[i - d.distance]
        else:
            prev = d.history[i]
        v := data[i] + prev
        if v >= 256:
            v -= 256
        push(out, v)
    _delta_update_ints(&d, out)
    return to_bytes(out)

enum BcjArch:
    X86
    PowerPC
    IA64
    ARM
    ARM_Thumb
    SPARC
    ARM64
    RISCV

struct Bcj:
    arch: BcjArch
    pc: int
    mask: int

fn _bcj_align(arch: BcjArch) -> int:
    if arch == X86:
        return 1
    if arch == ARM_Thumb or arch == RISCV:
        return 2
    if arch == IA64:
        return 16
    return 4

fn bcj_new(arch: BcjArch, start_offset: int) -> Result(Bcj, FilterErr):
    if start_offset < 0 or start_offset % _bcj_align(arch) != 0:
        return Err(BadAlignment)
    return Ok(Bcj(arch, start_offset, 0))

fn _x86_scan(d: [int], pos: int, limit: int) -> int:
    i := pos
    for i < limit and (d[i] & 254) != 232:
        i += 1
    return i

fn _x86_bit(mask: int) -> int:
    if mask == 0 or mask == 1 or mask == 2:
        return mask
    if mask == 3 or mask == 4:
        return 2
    return 3

fn _x86_allowed(mask: int) -> bool:
    return mask == 0 or mask == 1 or mask == 2 or mask == 4

fn _x86_convert(b: inout Bcj, data: bytes, encoding: bool) -> bytes:
    n := len(data)
    if n < 5:
        return data
    d := []int
    for i := 0; i < n; i += 1:
        push(d, data[i])
    ip := b.pc + 5
    prev_mask := b.mask & 7
    prev_pos := 0 - 1
    pos := 0
    limit := n - 4
    for true:
        pos = _x86_scan(d, pos, limit)
        if pos >= limit:
            break
        distance := pos - prev_pos
        if distance > 3:
            prev_mask = 0
        else:
            prev_mask = (prev_mask << (distance - 1)) & 7
            if prev_mask != 0:
                b4 := d[pos + 4 - _x86_bit(prev_mask)]
                if not _x86_allowed(prev_mask) or b4 == 0 or b4 == 255:
                    prev_pos = pos
                    prev_mask = ((prev_mask << 1) & 7) | 1
                    pos += 1
                    continue
        prev_pos = pos
        b4 := d[pos + 4]
        if b4 != 0 and b4 != 255:
            prev_mask = ((prev_mask << 1) & 7) | 1
            pos += 1
            continue
        src := (b4 << 24) | (d[pos + 3] << 16) | (d[pos + 2] << 8) | d[pos + 1]
        dest := 0
        for true:
            if encoding:
                dest = (ip + pos + src) & 4294967295
            else:
                dest = (src - (ip + pos)) & 4294967295
            if prev_mask == 0:
                break
            index := _x86_bit(prev_mask) * 8
            chk := (dest >> (24 - index)) & 255
            if chk != 0 and chk != 255:
                break
            src = dest ^ ((1 << (32 - index)) - 1)
        if ((dest >> 24) & 1) == 1:
            d[pos + 4] = 255
        else:
            d[pos + 4] = 0
        d[pos + 3] = (dest >> 16) & 255
        d[pos + 2] = (dest >> 8) & 255
        d[pos + 1] = dest & 255
        pos += 5
    distance := pos - prev_pos
    if distance > 3:
        b.mask = 0
    else:
        b.mask = (prev_mask << (distance - 1)) & 7
    b.pc += pos
    return to_bytes(d)

fn _bcj_ints(data: bytes) -> [int]:
    d := []int
    for i := 0; i < len(data); i += 1:
        push(d, data[i])
    return d

fn _le16(d: [int], i: int) -> int:
    return d[i] | (d[i + 1] << 8)

fn _le32(d: [int], i: int) -> int:
    return (d[i] | (d[i + 1] << 8) | (d[i + 2] << 16) | (d[i + 3] << 24)) & 4294967295

fn _be32(d: [int], i: int) -> int:
    return ((d[i] << 24) | (d[i + 1] << 16) | (d[i + 2] << 8) | d[i + 3]) & 4294967295

fn _put_le16(d: inout [int], i: int, v: int):
    d[i] = v & 255
    d[i + 1] = (v >> 8) & 255

fn _put_le32(d: inout [int], i: int, v: int):
    d[i] = v & 255
    d[i + 1] = (v >> 8) & 255
    d[i + 2] = (v >> 16) & 255
    d[i + 3] = (v >> 24) & 255

fn _put_be32(d: inout [int], i: int, v: int):
    d[i] = (v >> 24) & 255
    d[i + 1] = (v >> 16) & 255
    d[i + 2] = (v >> 8) & 255
    d[i + 3] = v & 255

fn _arm_convert(d: inout [int], pc: int, encoding: bool) -> int:
    size := len(d) / 4 * 4
    for i := 0; i < size; i += 4:
        if d[i + 3] == 235:
            v := _le32(d, i)
            c := (pc + i + 8) >> 2
            if encoding:
                v = (v + c) & 4294967295
            else:
                v = (v - c) & 4294967295
            _put_le32(&d, i, (v & 16777215) | 3942645760)
    return size

fn _armt_convert(d: inout [int], pc: int, encoding: bool) -> int:
    size := len(d) / 2 * 2
    if size <= 2:
        return 0
    limit := size - 2
    i := 0
    for i < limit:
        if (d[i + 3] & (d[i + 1] ^ 8)) < 248:
            i += 2
            continue
        v := (_le16(d, i) << 11) | (_le16(d, i + 2) & 2047)
        c := (pc + i + 4) >> 1
        if encoding:
            v = (v + c) & 4294967295
        else:
            v = (v - c) & 4294967295
        _put_le16(&d, i, ((v >> 11) & 2047) | 61440)
        _put_le16(&d, i + 2, (v & 65535) | 63488)
        i += 4
    return i

fn _ppc_convert(d: inout [int], pc: int, encoding: bool) -> int:
    size := len(d) / 4 * 4
    for i := 0; i < size; i += 4:
        if _le32(d, i) & 50331900 == 16777288:
            v := _be32(d, i)
            c := pc + i
            if encoding:
                v = (v + c) & 4294967295
            else:
                v = (v - c) & 4294967295
            _put_be32(&d, i, (v & 67108863) | 1207959552)
    return size

fn _sparc_convert(d: inout [int], pc: int, encoding: bool) -> int:
    flag := 1 << 22
    size := len(d) / 4 * 4
    for i := 0; i < size; i += 4:
        v := _be32(d, i)
        v = ((v << 2) | (v >> 30)) & 4294967295
        v = (v + ((flag << 2) - 1)) & 4294967295
        if v & 4261412867 != 0:
            continue
        c := pc + i
        if encoding:
            v = (v + c) & 4294967295
        else:
            v = (v - c) & 4294967295
        v = v & ((flag << 3) - 1)
        v = (v - ((flag << 2) - 1)) & 4294967295
        v = ((v >> 2) | (v << 30)) & 4294967295
        _put_be32(&d, i, v)
    return size

fn _ia64_convert(d: inout [int], pc: int, encoding: bool) -> int:
    size := len(d) / 16 * 16
    ip := (pc - 16) >> 3
    for i := 0; i < size; i += 16:
        ip += 2
        m := (860553216 >> (d[i] & 30)) & 3
        if m == 0:
            continue
        p := i + m * 5 - 4
        for true:
            t := _le16(d, p)
            z := (_le32(d, p + 1) >> m) & 4294967295
            p += 5
            if ((t >> m) & 224) == 0 and (((z - 167772160) & 503316480) & 4294967295) == 0:
                v := 18874367 & z
                z = z ^ v
                if encoding:
                    ip = ip & 4194303
                    v = (v + ip) & 4294967295
                else:
                    ip = ip | ((~4194303) & 4294967295)
                    v = (v - ip) & 4294967295
                v = v & ((~12582912) & 4294967295)
                v = (v + 14680064) & 4294967295
                v = v & 18874367
                z = z | v
                z = (z << m) & 4294967295
                _put_le32(&d, p - 4, z)
            m = (m + 1) & 3
            if m == 0:
                break
    return size

fn _arm64_convert(d: inout [int], pc: int, encoding: bool) -> int:
    flag := 1 << 20
    mask := (1 << 24) - (flag << 1)
    size := len(d) / 4 * 4
    for i := 0; i < size; i += 4:
        v := _le32(d, i)
        if ((v - 2483027968) & 4227858432) == 0:
            c := (pc + i) >> 2
            if encoding:
                v = (v + c) & 4294967295
            else:
                v = (v - c) & 4294967295
            _put_le32(&d, i, (v & 67108863) | 2483027968)
            continue
        v = (v - 2415919104) & 4294967295
        if v & 2667577344 != 0:
            continue
        v = (v + flag) & 4294967295
        if v & mask != 0:
            continue
        z := (v & 4294967264) | (v >> 26)
        c := ((pc + i) >> 9) & 4294967288
        if encoding:
            z = (z + c) & 4294967295
        else:
            z = (z - c) & 4294967295
        v = v & 31
        v = v | 2415919104
        v = v | ((z << 26) & 4294967295)
        v = v | (16777184 & (((z & ((flag << 1) - 1)) - flag) & 4294967295))
        _put_le32(&d, i, v)
    return size

fn _rv_check1(v: int, b: int) -> bool:
    return ((((b - 3) & 4294967295) ^ ((v << 8) & 4294967295)) & 1015811) == 0

fn _rv_check2(v: int, r: int) -> bool:
    return ((((v - 12552) << 18) & 4294967295) < (r & 29))

fn _rv_scan(d: [int], i: inout int, limit: int) -> (int, bool):
    for i < limit:
        a := (_le16(d, i) ^ 16) + 1
        if (a & 119) == 0:
            return a, true
        a = (_le16(d, i + 2) ^ 16) + 1
        i += 4
        if (a & 119) == 0:
            i -= 2
            if i >= limit:
                return 0, false
            return a, true
    return 0, false

fn _riscv_encode(d: inout [int], pc: int) -> int:
    size := len(d) / 2 * 2
    if size <= 6:
        return 0
    limit := size - 6
    i := 0
    for true:
        pair := _rv_scan(d, &i, limit)
        v := pair.0
        if not pair.1:
            break
        a := _le32(d, i)
        if v & 8 == 0:
            if (v - 256) & 3456 != 0:
                i += 2
                continue
            v = (((a & 2147483648) >> 11) | ((a & 2145386496) >> 20) | ((a & 1048576) >> 9) | (a & 1044480)) & 4294967295
            v = (v + pc + i) & 4294967295
            d[i + 1] = ((v >> 13) & 240) | ((a >> 8) & 15)
            d[i + 2] = (v >> 9) & 255
            d[i + 3] = (v >> 1) & 255
            i += 4
            continue
        if v & 3712 != 0:
            b := _le32(d, i + 4)
            if not _rv_check1(v, b):
                i += 6
                continue
            _put_le32(&d, i, ((b << 12) | 273) & 4294967295)
            a = a & 4294963200
            sb := b
            if b >= 2147483648:
                sb = b - 4294967296
            a = (a + (sb >> 20) + pc + i) & 4294967295
            _put_be32(&d, i + 4, a)
            i += 8
        else:
            r := a >> 27
            if not _rv_check2(v, r):
                i += 4
                continue
            v2 := _le32(d, i + 4)
            r2 := ((r << 7) + 23 + (v2 & 4294963200)) & 4294967295
            a2 := ((a >> 12) | ((v2 << 20) & 4294967295)) & 4294967295
            _put_le32(&d, i, r2)
            _put_le32(&d, i + 4, a2)
            i += 8
    return i

fn _riscv_decode(d: inout [int], pc: int) -> int:
    size := len(d) / 2 * 2
    if size <= 6:
        return 0
    limit := size - 6
    i := 0
    for true:
        pair := _rv_scan(d, &i, limit)
        a := pair.0
        if not pair.1:
            break
        if a & 8 == 0:
            a = a - 129
            if a & 3456 != 0:
                i += 2
                continue
            a_old := (a + 112) & 4095
            v := ((d[i + 3] << 1) | (d[i + 2] << 9) | ((a & 61440) << 5)) & 4294967295
            v = (v - (pc + i)) & 4294967295
            a = (a_old | ((v << 11) & 2147483648) | ((v << 20) & 2145386496) | ((v << 9) & 1048576) | (v & 1044480)) & 4294967295
            _put_le32(&d, i, a)
            i += 4
            continue
        v := a
        a = _le32(d, i)
        if v & 3712 == 0:
            r := a >> 27
            if not _rv_check2(v, r):
                i += 4
                continue
            b := _be32(d, i + 4)
            v2 := a >> 12
            b = (b - (pc + i)) & 4294967295
            a2 := ((r << 7) + 23) & 4294967295
            a2 = (a2 + ((b + 2048) & 4294963200)) & 4294967295
            v2 = (v2 | ((b << 20) & 4294967295)) & 4294967295
            _put_le32(&d, i, a2)
            _put_le32(&d, i + 4, v2)
            i += 8
        else:
            b := _le32(d, i + 4)
            if not _rv_check1(v, b):
                i += 6
                continue
            v2 := ((a & 4294963200) | (b >> 20)) & 4294967295
            a2 := ((b << 12) | 273) & 4294967295
            _put_le32(&d, i, a2)
            _put_le32(&d, i + 4, v2)
            i += 8
    return i

fn bcj_encode(b: inout Bcj, data: bytes) -> bytes:
    if b.arch == X86:
        return _x86_convert(&b, data, true)
    d := _bcj_ints(data)
    p := 0
    if b.arch == ARM:
        p = _arm_convert(&d, b.pc, true)
    elif b.arch == ARM_Thumb:
        p = _armt_convert(&d, b.pc, true)
    elif b.arch == PowerPC:
        p = _ppc_convert(&d, b.pc, true)
    elif b.arch == SPARC:
        p = _sparc_convert(&d, b.pc, true)
    elif b.arch == IA64:
        p = _ia64_convert(&d, b.pc, true)
    elif b.arch == ARM64:
        p = _arm64_convert(&d, b.pc, true)
    elif b.arch == RISCV:
        p = _riscv_encode(&d, b.pc)
    b.pc += p
    return to_bytes(d)

fn bcj_decode(b: inout Bcj, data: bytes) -> bytes:
    if b.arch == X86:
        return _x86_convert(&b, data, false)
    d := _bcj_ints(data)
    p := 0
    if b.arch == ARM:
        p = _arm_convert(&d, b.pc, false)
    elif b.arch == ARM_Thumb:
        p = _armt_convert(&d, b.pc, false)
    elif b.arch == PowerPC:
        p = _ppc_convert(&d, b.pc, false)
    elif b.arch == SPARC:
        p = _sparc_convert(&d, b.pc, false)
    elif b.arch == IA64:
        p = _ia64_convert(&d, b.pc, false)
    elif b.arch == ARM64:
        p = _arm64_convert(&d, b.pc, false)
    elif b.arch == RISCV:
        p = _riscv_decode(&d, b.pc)
    b.pc += p
    return to_bytes(d)

fn swap2(data: bytes) -> bytes:
    out := []int
    i := 0
    for i + 2 <= len(data):
        push(out, data[i + 1])
        push(out, data[i])
        i += 2
    for i < len(data):
        push(out, data[i])
        i += 1
    return to_bytes(out)

fn swap4(data: bytes) -> bytes:
    out := []int
    i := 0
    for i + 4 <= len(data):
        push(out, data[i + 3])
        push(out, data[i + 2])
        push(out, data[i + 1])
        push(out, data[i])
        i += 4
    for i < len(data):
        push(out, data[i])
        i += 1
    return to_bytes(out)

# ---- PPMd (7z method 03 04 01 / ZIP method 98) and PKZIP legacy methods ----

# Shared failure type for the codecs below. Names are prefixed because Tycho
# enum variants share one package-wide namespace with ZErr's.
enum CodecErr:
    CodecInvalidProps
    CodecBadOption
    CodecCorrupt
    CodecTruncated
    CodecTooBig
    CodecFailed

enum PpmdVariant:
    H                                  # PPMd var.H, used by 7z
    I                                  # PPMd var.I, used by ZIP method 98

struct PpmdProps:
    variant: PpmdVariant
    order: int
    mem_size: int
    restore: int                       # 0 restart, 1 cut-off, 2 freeze (var.I)

fn _codec_cause(st: int) -> CodecErr:
    if st == 1:
        return CodecCorrupt
    if st == 2:
        return CodecTruncated
    if st == 3:
        return CodecTooBig
    if st == 5:
        return CodecInvalidProps
    if st == 6:
        return CodecBadOption
    return CodecFailed

fn _ppmd_valid(p: PpmdProps) -> bool:
    if p.order < 2 or p.mem_size < 2048 or p.mem_size > 4294967284:
        return false
    if p.variant == H:
        return p.order <= 64 and p.restore == 0
    if p.order > 16 or p.restore < 0 or p.restore > 2:
        return false
    if p.restore == 1 and p.mem_size < 2064:
        return false
    return true

# PPMd var.H decoder for the raw stream 7z stores after the 5-byte properties.
# `expected_size` is the 7z unpack size; there is no end marker.
fn ppmd_decompress_7z(data: bytes, props: PpmdProps, expected_size: int) -> Result(bytes, CodecErr):
    if props.variant != H or not _ppmd_valid(props):
        return Err(CodecInvalidProps)
    if expected_size < 0:
        return Err(CodecBadOption)
    st := 0
    b := ppx_decompress_7z(data, props.order, props.mem_size, expected_size, &st)
    if st == 0:
        return Ok(b)
    return Err(_codec_cause(st))

# PPMd var.H encoder. Output is byte-identical to 7-Zip for the same
# order/memory properties.
fn ppmd_compress_7z(data: bytes, props: PpmdProps) -> Result(bytes, CodecErr):
    if props.variant != H or not _ppmd_valid(props):
        return Err(CodecInvalidProps)
    st := 0
    b := ppx_compress_7z(data, props.order, props.mem_size, &st)
    if st == 0:
        return Ok(b)
    return Err(_codec_cause(st))

# PPMd var.I decoder for ZIP method 98. `data` starts after the two property
# bytes; `expected_size` is the ZIP uncompressed size. The stream carries an
# end marker, which is checked after the last output byte.
fn ppmd_decompress_zip(data: bytes, props: PpmdProps, expected_size: int) -> Result(bytes, CodecErr):
    if props.variant != I or not _ppmd_valid(props):
        return Err(CodecInvalidProps)
    if expected_size < 0:
        return Err(CodecBadOption)
    st := 0
    b := ppx_decompress_zip(data, props.order, props.mem_size, props.restore, expected_size, &st)
    if st == 0:
        return Ok(b)
    return Err(_codec_cause(st))

fn ppmd_compress_zip(data: bytes, props: PpmdProps) -> Result(bytes, CodecErr):
    if props.variant != I or not _ppmd_valid(props):
        return Err(CodecInvalidProps)
    st := 0
    b := ppx_compress_zip(data, props.order, props.mem_size, props.restore, &st)
    if st == 0:
        return Ok(b)
    return Err(_codec_cause(st))

fn ppmd_decode_props_7z(data: bytes) -> Result(PpmdProps, CodecErr):
    if len(data) < 5:
        return Err(CodecInvalidProps)
    mem := data[1] | (data[2] << 8) | (data[3] << 16) | (data[4] << 24)
    p := PpmdProps(H, data[0], mem, 0)
    if not _ppmd_valid(p):
        return Err(CodecInvalidProps)
    return Ok(p)

fn ppmd_encode_props_7z(props: PpmdProps) -> Result(bytes, CodecErr):
    if props.variant != H or not _ppmd_valid(props):
        return Err(CodecInvalidProps)
    m := props.mem_size
    return Ok(to_bytes([props.order, m & 255, (m >> 8) & 255, (m >> 16) & 255, (m >> 24) & 255]))

fn ppmd_decode_props_zip(data: bytes) -> Result(PpmdProps, CodecErr):
    if len(data) < 2:
        return Err(CodecInvalidProps)
    w := data[0] | (data[1] << 8)
    restore := w >> 12
    if restore > 2:
        return Err(CodecInvalidProps)
    p := PpmdProps(I, (w & 15) + 1, (((w >> 4) & 255) + 1) << 20, restore)
    if not _ppmd_valid(p):
        return Err(CodecInvalidProps)
    return Ok(p)

fn ppmd_encode_props_zip(props: PpmdProps) -> Result(bytes, CodecErr):
    if props.variant != I or not _ppmd_valid(props):
        return Err(CodecInvalidProps)
    if props.mem_size % (1 << 20) != 0 or props.mem_size > (256 << 20):
        return Err(CodecInvalidProps)
    w := (props.order - 1) | (((props.mem_size >> 20) - 1) << 4) | (props.restore << 12)
    return Ok(to_bytes([w & 255, (w >> 8) & 255]))

# Preset properties, matching 7-Zip's level mapping. `input_size` < 0 leaves
# the level's memory size unchanged; a non-negative size is capped so small
# inputs do not reserve the full level memory.
fn ppmd_level_properties(variant: PpmdVariant, level: int, input_size: int) -> PpmdProps:
    l := level
    if l < 0:
        l = 0
    if l > 9:
        l = 9
    mem := 1 << (19 + l)
    order := 3
    restore := 0
    if variant == H:
        orders: [10]int = [3, 4, 4, 5, 5, 6, 8, 16, 24, 32]
        order = orders[l]
    else:
        order = 3 + l
        if l >= 7:
            restore = 1
        if mem < (1 << 20):
            mem = 1 << 20
    if input_size >= 0:
        reduced := 1 << 16
        for reduced < 16 * input_size and reduced < mem:
            reduced = reduced << 1
        if variant == I and reduced < (1 << 20):
            reduced = 1 << 20
        if reduced < mem:
            mem = reduced
    return PpmdProps(variant, order, mem, restore)

# ---- PKZIP legacy methods 1, 2-5 and 6 ----

fn unshrink(data: bytes, expected_size: int) -> Result(bytes, CodecErr):
    if expected_size < 0:
        return Err(CodecBadOption)
    st := 0
    b := pkx_unshrink(data, expected_size, &st)
    if st == 0:
        return Ok(b)
    return Err(_codec_cause(st))

fn expand(data: bytes, factor: int, expected_size: int) -> Result(bytes, CodecErr):
    if factor < 1 or factor > 4 or expected_size < 0:
        return Err(CodecBadOption)
    st := 0
    b := pkx_expand(data, expected_size, factor, &st)
    if st == 0:
        return Ok(b)
    return Err(_codec_cause(st))

fn explode(data: bytes, large_window: bool, literal_tree: bool, expected_size: int) -> Result(bytes, CodecErr):
    if expected_size < 0:
        return Err(CodecBadOption)
    flags := 0
    if large_window:
        flags = flags | 2
    if literal_tree:
        flags = flags | 4
    st := 0
    b := pkx_explode(data, expected_size, flags, &st)
    if st == 0:
        return Ok(b)
    return Err(_codec_cause(st))

fn shrink(data: bytes) -> Result(bytes, CodecErr):
    st := 0
    b := pkx_shrink(data, &st)
    if st == 0:
        return Ok(b)
    return Err(_codec_cause(st))

fn implode(data: bytes, large_window: bool, literal_tree: bool) -> Result(bytes, CodecErr):
    flags := 0
    if large_window:
        flags = flags | 2
    if literal_tree:
        flags = flags | 4
    st := 0
    b := pkx_implode(data, flags, &st)
    if st == 0:
        return Ok(b)
    return Err(_codec_cause(st))

fn reduce(data: bytes, factor: int) -> Result(bytes, CodecErr):
    if factor < 1 or factor > 4:
        return Err(CodecBadOption)
    st := 0
    b := pkx_reduce(data, factor, &st)
    if st == 0:
        return Ok(b)
    return Err(_codec_cause(st))

# ---- Deflate64 (PKZIP method 9) ----

# Conservative output bound for `deflate64_compress`.
fn deflate64_bound(len: int) -> int:
    if len < 0:
        return -1
    return len + len / 8 + 4096

# Raw Deflate64 stream. The decoder accepts the full 64 KiB/65538-byte form;
# the encoder emits the standard 32 KiB/257-byte subset, which every Deflate64
# decoder accepts.
fn deflate64_compress(data: bytes) -> Result(bytes, CodecErr):
    st := 0
    b := dfx_compress(data, &st)
    if st == 0:
        return Ok(b)
    return Err(_codec_cause(st))

fn deflate64_decompress(data: bytes, expected_size: int) -> Result(bytes, CodecErr):
    if expected_size < 0:
        return Err(CodecBadOption)
    st := 0
    b := dfx_decompress(data, expected_size, &st)
    if st == 0:
        return Ok(b)
    return Err(_codec_cause(st))
