# corelib: pure-Tycho raster image codecs -- BMP and QOI, no external dependency
# (unlike core:image's PNG, which needs libpng). Import with `import "core:raster"`.
#
# An Image is 8-bit RGBA (4 bytes/pixel), row-major, top-to-bottom -- the same
# layout core:image uses. Pixel data is `bytes`; decoders build it with
# to_bytes([int]) so interior 0x00 bytes are preserved (a black or transparent
# pixel is 0x00 components).
#
#   raster.encode_bmp(img) -> bytes     32-bit BGRA, bottom-up, BI_RGB
#   raster.decode_bmp(bytes) -> Image   24- or 32-bit BI_RGB; 0x0 Image on error
#   raster.encode_qoi(img) -> bytes     QOI (RGBA, sRGB)
#   raster.decode_qoi(bytes) -> Image   QOI; 0x0 Image on error
#   raster.make(w, h, pixels) -> Image
#
# Decoders FAIL CLOSED: a malformed / truncated / wrong-format input yields a 0x0
# Image (check width > 0), and so does one whose declared dimensions ask for more
# than MAX_OUT bytes of RGBA. encode/decode round-trip losslessly.
package raster

struct Image:
    width: int
    height: int
    pixels: bytes         # width*height*4 bytes, RGBA, row-major top-to-bottom

fn make(width: int, height: int, pixels: bytes) -> Image:
    return Image(width, height, pixels)

fn empty_image() -> Image:
    return Image(0, 0, to_bytes([]int))

# Decoded-size ceiling, mirroring core:image's IMG_MAX_OUT (corelib/image/image_shim.c@IMG_MAX_OUT).
# A header declares w and h as 32-bit fields, so w*h and rowsize*h overflow int64
# long before either dimension does: decode_qoi's npx wrapped NEGATIVE and it
# returned the declared dimensions with an EMPTY pixel buffer, and decode_bmp's
# `offset + rowsize * h > n` wrapped past the guard and aborted the process on
# a negative string index. The product is therefore never formed -- the two
# bounds are checked by division.
const MAX_OUT = 536870912          # 512 MiB of decoded RGBA, the same ceiling core:image uses
const MAX_PX = 134217728           # MAX_OUT / 4 -- the pixel count that buys

fn too_big(w: int, h: int) -> bool:
    if w <= 0 or h <= 0:
        return true
    if w > MAX_PX:
        return true
    return h > MAX_PX / w

# ---- BMP's 54-byte header, stated as a layout --------------------------------
#
# BMP is defined LITTLE-ENDIAN (Microsoft BITMAPFILEHEADER / BITMAPINFOHEADER:
# every multi-byte member is a little-endian DWORD/WORD), which is the order
# to_bytes/from_bytes use on every host (spec s17.1b). The hand-rolled readers
# this replaces agreed: rd_u32_le read `s[i] + s[i+1]*256 + ...` and wr_u32
# pushed `n & 255` first, LSB-first on both sides.
#
# QOI is the opposite and is NOT converted -- see decode_qoi below.

packed struct BmpHeader:                    # 14 + 40 = 54 bytes
    b: u8                                   # 'B'
    m: u8                                   # 'M'
    filesize: u32
    reserved: u32
    pixoff: u32                             # pixel data offset
    hdrsize: u32                            # BITMAPINFOHEADER size, 40
    width: i32
    height: i32                             # positive -> bottom-up
    planes: u16
    bpp: u16
    compression: u32                        # 0 BI_RGB, 3 BI_BITFIELDS
    imgsize: u32
    xppm: i32
    yppm: i32
    ncolors: u32
    nimportant: u32

# QOI stores width and height BIG-endian (qoiformat.org), the one big-endian
# record in this package, so it stays hand-rolled: the bytes bridge is
# little-endian by decision and reading this header through it would produce
# plausible wrong dimensions on every host.
fn rd_u32_be(s: string, i: int) -> int:
    return s[i] * 16777216 + s[i + 1] * 65536 + s[i + 2] * 256 + s[i + 3]

# ---- BMP --------------------------------------------------------------------

# Encode to a 32-bit BGRA, bottom-up, uncompressed (BI_RGB) BMP. 32bpp rows are
# 4-byte aligned already, so there is no row padding.
fn encode_bmp(img: Image) -> bytes:
    w := img.width
    h := img.height
    ps := to_str(img.pixels)
    imgsize := w * h * 4
    filesize := 54 + imgsize
    hdr := to_bytes(BmpHeader(to_u8(66), to_u8(77), to_u32(filesize), to_u32(0),
        to_u32(54), to_u32(40), to_i32(w), to_i32(h), to_u16(1), to_u16(32),
        to_u32(0), to_u32(imgsize), to_i32(2835), to_i32(2835), to_u32(0), to_u32(0)))
    out := []int
    # pixel data, bottom row first, each pixel B,G,R,A
    y := h - 1
    for y >= 0:
        row := y * w * 4
        for x := 0; x < w; x += 1:
            p := row + x * 4
            push(out, ps[p + 2])           # B
            push(out, ps[p + 1])           # G
            push(out, ps[p])               # R
            push(out, ps[p + 3])           # A
        y = y - 1
    return hdr + to_bytes(out)

# Decode a BI_RGB BMP (24 or 32 bpp). Returns a 0x0 Image on anything unexpected.
fn decode_bmp(data: bytes) -> Image:
    s := to_str(data)
    n := len(s)
    # from_bytes refuses any length but size_of$(BmpHeader), so the guard comes
    # first and the slice is taken only after it
    if n < size_of$(BmpHeader):
        return empty_image()
    hd := from_bytes$(BmpHeader)(data[0:size_of$(BmpHeader)])
    if to_int(hd.b) != 66 or to_int(hd.m) != 77:   # 'B' 'M'
        return empty_image()
    offset := to_int(hd.pixoff)
    w := to_int(hd.width)
    hraw := to_int(hd.height)
    bpp := to_int(hd.bpp)
    comp := to_int(hd.compression)
    if comp != 0 and comp != 3:            # only uncompressed
        return empty_image()
    if bpp != 24 and bpp != 32:
        return empty_image()
    if w <= 0 or hraw == 0:
        return empty_image()
    topdown := false
    h := hraw
    if hraw < 0:
        topdown = true
        h = 0 - hraw
    if too_big(w, h):                      # before rowsize * h can overflow
        return empty_image()
    bpx := bpp / 8
    rowsize := ((bpp * w + 31) / 32) * 4   # rows padded to 4 bytes
    if offset + rowsize * h > n:
        return empty_image()
    px := []int
    for y := 0; y < h; y += 1:
        srcy := h - 1 - y
        if topdown:
            srcy = y
        base := offset + srcy * rowsize
        for x := 0; x < w; x += 1:
            p := base + x * bpx
            r := s[p + 2]
            g := s[p + 1]
            b := s[p]
            a := 255
            if bpp == 32:
                a = s[p + 3]
            push(px, r)
            push(px, g)
            push(px, b)
            push(px, a)
    return Image(w, h, to_bytes(px))

# ---- QOI --------------------------------------------------------------------
# The QOI format (qoiformat.org): a 14-byte header, then chunks (RUN / INDEX /
# DIFF / LUMA / RGB / RGBA) over a running previous-pixel and a 64-entry seen
# table, ended by seven 0x00 bytes and a 0x01. RGBA, sRGB.

fn qoi_hash(r: int, g: int, b: int, a: int) -> int:
    return (r * 3 + g * 5 + b * 7 + a * 11) % 64

# signed 8-bit wraparound (QOI diffs are modular over the byte range)
fn wrap8(d: int) -> int:
    m := d % 256
    if m < 0:
        m = m + 256
    if m > 127:
        m = m - 256
    return m

fn encode_qoi(img: Image) -> bytes:
    w := img.width
    h := img.height
    ps := to_str(img.pixels)
    npx := w * h
    out := []int
    push(out, 113)                         # 'q'
    push(out, 111)                         # 'o'
    push(out, 105)                         # 'i'
    push(out, 102)                         # 'f'
    push(out, (w / 16777216) & 255)        # width, big-endian
    push(out, (w / 65536) & 255)
    push(out, (w / 256) & 255)
    push(out, w & 255)
    push(out, (h / 16777216) & 255)        # height, big-endian
    push(out, (h / 65536) & 255)
    push(out, (h / 256) & 255)
    push(out, h & 255)
    push(out, 4)                           # channels = RGBA
    push(out, 0)                           # colorspace = sRGB with linear alpha
    index := []int
    for i := 0; i < 256; i += 1:
        push(index, 0)
    pr := 0
    pg := 0
    pb := 0
    pa := 255
    run := 0
    for k := 0; k < npx; k += 1:
        p := k * 4
        r := ps[p]
        g := ps[p + 1]
        b := ps[p + 2]
        a := ps[p + 3]
        if r == pr and g == pg and b == pb and a == pa:
            run = run + 1
            if run == 62 or k == npx - 1:
                push(out, 192 + run - 1)   # QOI_OP_RUN
                run = 0
        else:
            if run > 0:
                push(out, 192 + run - 1)
                run = 0
            hh := qoi_hash(r, g, b, a)
            ii := hh * 4
            if index[ii] == r and index[ii + 1] == g and index[ii + 2] == b and index[ii + 3] == a:
                push(out, hh)              # QOI_OP_INDEX
            else:
                index[ii] = r
                index[ii + 1] = g
                index[ii + 2] = b
                index[ii + 3] = a
                if a == pa:
                    vr := wrap8(r - pr)
                    vg := wrap8(g - pg)
                    vb := wrap8(b - pb)
                    vgr := wrap8(vr - vg)
                    vgb := wrap8(vb - vg)
                    if vr >= 0 - 2 and vr <= 1 and vg >= 0 - 2 and vg <= 1 and vb >= 0 - 2 and vb <= 1:
                        push(out, 64 + (vr + 2) * 16 + (vg + 2) * 4 + (vb + 2))   # QOI_OP_DIFF
                    elif vg >= 0 - 32 and vg <= 31 and vgr >= 0 - 8 and vgr <= 7 and vgb >= 0 - 8 and vgb <= 7:
                        push(out, 128 + (vg + 32))                                # QOI_OP_LUMA
                        push(out, (vgr + 8) * 16 + (vgb + 8))
                    else:
                        push(out, 254)     # QOI_OP_RGB
                        push(out, r)
                        push(out, g)
                        push(out, b)
                else:
                    push(out, 255)         # QOI_OP_RGBA
                    push(out, r)
                    push(out, g)
                    push(out, b)
                    push(out, a)
        pr = r
        pg = g
        pb = b
        pa = a
    for i := 0; i < 7; i += 1:                     # end marker: 7x 0x00 then 0x01
        push(out, 0)
    push(out, 1)
    return to_bytes(out)

fn decode_qoi(data: bytes) -> Image:
    s := to_str(data)
    n := len(s)
    if n < 14:
        return empty_image()
    if s[0] != 113 or s[1] != 111 or s[2] != 105 or s[3] != 102:   # 'qoif'
        return empty_image()
    w := rd_u32_be(s, 4)
    h := rd_u32_be(s, 8)
    if too_big(w, h):                      # before npx can overflow
        return empty_image()
    npx := w * h
    index := []int
    for i := 0; i < 256; i += 1:
        push(index, 0)
    pr := 0
    pg := 0
    pb := 0
    pa := 255
    px := []int
    pos := 14
    run := 0
    done := 0
    for done < npx:
        r := pr
        g := pg
        b := pb
        a := pa
        if run > 0:
            run = run - 1
        else:
            if pos >= n:
                return empty_image()       # truncated
            op := s[pos]
            pos = pos + 1
            if op == 254:                  # QOI_OP_RGB
                if pos + 3 > n:
                    return empty_image()
                r = s[pos]
                g = s[pos + 1]
                b = s[pos + 2]
                pos = pos + 3
            elif op == 255:                # QOI_OP_RGBA
                if pos + 4 > n:
                    return empty_image()
                r = s[pos]
                g = s[pos + 1]
                b = s[pos + 2]
                a = s[pos + 3]
                pos = pos + 4
            elif op < 64:                  # QOI_OP_INDEX (top 2 bits 00)
                ii := op * 4
                r = index[ii]
                g = index[ii + 1]
                b = index[ii + 2]
                a = index[ii + 3]
            elif op < 128:                 # QOI_OP_DIFF (01)
                r = (pr + ((op / 16) % 4) - 2) & 255
                g = (pg + ((op / 4) % 4) - 2) & 255
                b = (pb + (op % 4) - 2) & 255
            elif op < 192:                 # QOI_OP_LUMA (10)
                if pos >= n:
                    return empty_image()
                b2 := s[pos]
                pos = pos + 1
                vg := (op % 64) - 32
                r = (pr + vg + ((b2 / 16) % 16) - 8) & 255
                g = (pg + vg) & 255
                b = (pb + vg + (b2 % 16) - 8) & 255
            else:                          # QOI_OP_RUN (11)
                run = (op % 64)            # bias -1 handled by consuming this pixel now
        hh := qoi_hash(r, g, b, a)
        ii := hh * 4
        index[ii] = r
        index[ii + 1] = g
        index[ii + 2] = b
        index[ii + 3] = a
        push(px, r)
        push(px, g)
        push(px, b)
        push(px, a)
        pr = r
        pg = g
        pb = b
        pa = a
        done = done + 1
    return Image(w, h, to_bytes(px))
