package fixed

import "core:fmath"

# Q16.16 fixed point: 16 fractional bits, signed 64-bit storage.
type Fixed = int

const SCALE = 65536
const HALF = 32768

fn from_int(n: int) -> Fixed:
    return Fixed(n * SCALE)

fn from_float(x: float) -> Fixed:
    return Fixed(to_int(fmath.round(x * 65536.0)))

fn as_float(x: Fixed) -> float:
    return to_float(to_int(x)) / 65536.0

fn to_int_trunc(x: Fixed) -> int:
    return to_int(x) / SCALE

fn zero() -> Fixed:
    return Fixed(0)

fn one() -> Fixed:
    return Fixed(SCALE)

fn add(a: Fixed, b: Fixed) -> Fixed:
    return Fixed(to_int(a) + to_int(b))

fn sub(a: Fixed, b: Fixed) -> Fixed:
    return Fixed(to_int(a) - to_int(b))

fn neg(a: Fixed) -> Fixed:
    return Fixed(0 - to_int(a))

fn abs(a: Fixed) -> Fixed:
    if to_int(a) < 0:
        return Fixed(0 - to_int(a))
    return a

fn mul(a: Fixed, b: Fixed) -> Fixed:
    return Fixed((to_int(a) * to_int(b)) >> 16)

fn div(a: Fixed, b: Fixed) -> Fixed:
    if to_int(b) == 0:
        die("fixed.div: division by zero")
    return Fixed((to_int(a) << 16) / to_int(b))

fn floor_fixed(x: Fixed) -> Fixed:
    return Fixed(to_int(x) & (0 - SCALE))

fn frac(x: Fixed) -> Fixed:
    return sub(x, floor_fixed(x))

fn round(x: Fixed) -> Fixed:
    if to_int(x) >= 0:
        return Fixed((to_int(x) + HALF) & (0 - SCALE))
    return Fixed(0 - ((0 - to_int(x) + HALF) & (0 - SCALE)))

fn sign(x: Fixed) -> int:
    if to_int(x) < 0:
        return -1
    if to_int(x) > 0:
        return 1
    return 0
