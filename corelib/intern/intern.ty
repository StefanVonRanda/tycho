package intern

type Handle = int            # index into `nodes`; type-distinct from a raw int

struct Interner($K, $V):
    nodes: [$V]              # the canonical store, append-only
    lookup: [$K: int]        # key -> node index

# Canonical handle for key `k`. First sight stores `v` and mints the handle;
# later sights of the same key return the same handle and ignore `v`.
fn intern(i: inout Interner($K, $V), k: $K, v: $V) -> Handle where hashable(K):
    if k in i.lookup:
        return Handle(i.lookup[k])
    h := len(i.nodes)
    push(i.nodes, v)
    i.lookup[k] = h
    return Handle(h)

# Read the canonical value behind a handle (a copy, like every read in Tycho).
fn get(i: Interner($K, $V), h: Handle) -> $V where hashable(K):
    return i.nodes[to_int(h)]

# Number of interned values (== number of distinct keys ever seen).
fn count(i: Interner($K, $V)) -> int:
    return len(i.nodes)
