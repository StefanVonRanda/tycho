package terminal

import "core:utf8"

extern fn termx_is_tty(fd: int) -> int
extern fn termx_cols(fd: int) -> int
extern fn termx_rows(fd: int) -> int
extern fn termx_ansi(fd: int) -> int
extern fn termx_raw_enter(fd: int) -> ptr
extern fn termx_raw_leave(h: ptr)
extern fn termx_read_byte(fd: int) -> int

fn _esc(body: string) -> string:
    return chr(27) + body

fn reset() -> string:
    return _esc("[0m")

fn bold() -> string:
    return _esc("[1m")

fn dim() -> string:
    return _esc("[2m")

fn italic() -> string:
    return _esc("[3m")

fn underline() -> string:
    return _esc("[4m")

fn reverse() -> string:
    return _esc("[7m")

fn fg(n: int) -> string:
    if n < 0 or n > 255:
        die("terminal.fg: colour must be 0..255, got " + str(n))
    return _esc("[38;5;" + str(n) + "m")

fn bg(n: int) -> string:
    if n < 0 or n > 255:
        die("terminal.bg: colour must be 0..255, got " + str(n))
    return _esc("[48;5;" + str(n) + "m")

fn fg_rgb(r: int, g: int, b: int) -> string:
    if r < 0 or r > 255 or g < 0 or g > 255 or b < 0 or b > 255:
        die("terminal.fg_rgb: components must be 0..255")
    return _esc("[38;2;" + str(r) + ";" + str(g) + ";" + str(b) + "m")

fn bg_rgb(r: int, g: int, b: int) -> string:
    if r < 0 or r > 255 or g < 0 or g > 255 or b < 0 or b > 255:
        die("terminal.bg_rgb: components must be 0..255")
    return _esc("[48;2;" + str(r) + ";" + str(g) + ";" + str(b) + "m")

fn clear_screen() -> string:
    return _esc("[2J")

fn clear_line() -> string:
    return _esc("[2K")

# 1-based cursor position.
fn move(row: int, col: int) -> string:
    r := row
    c := col
    if r < 1:
        r = 1
    if c < 1:
        c = 1
    return _esc("[" + str(r) + ";" + str(c) + "H")

fn hide_cursor() -> string:
    return _esc("[?25l")

fn show_cursor() -> string:
    return _esc("[?25h")

fn is_tty(fd: int) -> bool:
    return termx_is_tty(fd) == 1

# Columns and rows, or None when the descriptor is not a terminal or the
# platform cannot answer.
fn size(fd: int) -> Option((int, int)):
    c := termx_cols(fd)
    r := termx_rows(fd)
    if c <= 0 or r <= 0:
        return None
    return Some((c, r))

fn supports_ansi(fd: int) -> bool:
    return termx_ansi(fd) == 1

# Put a terminal into cbreak/raw mode. Returns null on a non-terminal or a
# failed ioctl; pair every non-null handle with raw_leave.
fn raw_enter(fd: int) -> ptr:
    return termx_raw_enter(fd)

# Restore the saved mode and free the handle. Leaving twice is a use-after-free.
fn raw_leave(h: ptr):
    termx_raw_leave(h)

# One byte from fd, or None at EOF/error.
fn read_byte(fd: int) -> Option(int):
    b := termx_read_byte(fd)
    if b < 0:
        return None
    return Some(b)

enum Key:
    Char(int)
    Enter
    Tab
    Backspace
    Escape
    Up
    Down
    Left
    Right
    Home
    End
    Delete
    Unknown

# Decode one raw key sequence. Printable UTF-8 yields Char(codepoint), CR/LF
# yields Enter, and the common CSI arrows/Home/End/Delete are recognized.
fn parse_key(data: bytes) -> Key:
    if len(data) == 0:
        return Unknown
    b := data[0]
    if b == 27:
        if len(data) == 1:
            return Escape
        if len(data) >= 3 and data[1] == 91:
            c := data[2]
            if c == 65:
                return Up
            if c == 66:
                return Down
            if c == 67:
                return Right
            if c == 68:
                return Left
            if c == 72:
                return Home
            if c == 70:
                return End
            if c == 51 and len(data) >= 4 and data[3] == 126:
                return Delete
        return Unknown
    if b == 10 or b == 13:
        return Enter
    if b == 9:
        return Tab
    if b == 127:
        return Backspace
    cp, w := utf8.decode(to_str(data), 0)
    if cp >= 0:
        return Char(cp)
    return Char(b)

# ---- cursor position query (ANSI DSR / Windows console) ----

enum TermErr:
    BadArg
    NotTty
    Timeout
    BadResponse
    Failed

struct CursorPos:
    row: int
    col: int

extern fn termx_cursor_query(out_fd: int, in_fd: int, timeout_ms: int, row: inout int, col: inout int) -> int

# Parse a terminal's `ESC [ row ; col R` (or `ESC [ ? row ; col R`) reply.
fn parse_cursor_response(data: bytes) -> Option(CursorPos):
    i := 0
    for i < len(data):
        if data[i] != 27:
            i += 1
            continue
        i += 1
        if i >= len(data) or data[i] != 91:
            continue
        i += 1
        if i < len(data) and data[i] == 63:
            i += 1
        row := 0
        have_row := false
        for i < len(data) and data[i] >= 48 and data[i] <= 57:
            row = row * 10 + (data[i] - 48)
            i += 1
            have_row = true
        if not have_row or i >= len(data) or data[i] != 59:
            continue
        i += 1
        col := 0
        have_col := false
        for i < len(data) and data[i] >= 48 and data[i] <= 57:
            col = col * 10 + (data[i] - 48)
            i += 1
            have_col = true
        if not have_col or i >= len(data) or data[i] != 82:
            continue
        if row > 0 and col > 0:
            return Some(CursorPos(row, col))
        return None
    return None

fn _cursor_cause(st: int) -> TermErr:
    if st == 1:
        return NotTty
    if st == 2:
        return Timeout
    if st == 3:
        return BadResponse
    return Failed

# Query the cursor position. `out_fd` receives the DSR request; `in_fd` is the
# terminal input. On a Windows console the position is read directly; a
# non-console Windows tty (MSYS pty) falls back to the ANSI query.
fn cursor_query(out_fd: int, in_fd: int, timeout_ms: int) -> Result(CursorPos, TermErr):
    if out_fd < 0 or in_fd < 0 or timeout_ms < 0:
        return Err(BadArg)
    row := 0
    col := 0
    st := termx_cursor_query(out_fd, in_fd, timeout_ms, &row, &col)
    if st == 0:
        return Ok(CursorPos(row, col))
    return Err(_cursor_cause(st))

# Query on one bidirectional terminal descriptor (e.g. /dev/tty).
fn cursor_position(fd: int) -> Result(CursorPos, TermErr):
    return cursor_query(fd, fd, 1000)
