
package crypto

# ---- shim externs (OpenSSL EVP; defined in crypto_shim.c) ----
extern fn cx_key_random(n: int) -> ptr
extern fn cx_key_from_hex(hex: string) -> ptr
extern fn cx_key_export_hex(k: ptr) -> string
extern fn cx_key_len(k: ptr) -> int
extern fn cx_key_free(k: ptr)
extern fn cx_random_hex(n: int) -> string
extern fn cx_sha256_hex(msg_hex: string) -> string
extern fn cx_sha512_hex(msg_hex: string) -> string
extern fn cx_sha3_256_hex(msg_hex: string) -> string
extern fn cx_sha3_512_hex(msg_hex: string) -> string
extern fn cx_shake128_hex(msg_hex: string, outlen: int) -> string
extern fn cx_shake256_hex(msg_hex: string, outlen: int) -> string
extern fn cx_blake2b_hex(msg_hex: string) -> string
extern fn cx_blake2s_hex(msg_hex: string) -> string
extern fn cx_hmac_sha256_hex(k: ptr, msg_hex: string) -> string
extern fn cx_hmac_sha512_hex(k: ptr, msg_hex: string) -> string
extern fn cx_hkdf_sha256(ikm: ptr, salt_hex: string, info_hex: string, outlen: int) -> ptr
extern fn cx_pbkdf2_sha256(password: string, pwlen: int, salt_hex: string, iters: int, dklen: int) -> ptr
extern fn cx_ct_equal(a_hex: string, alen: int, b_hex: string, blen: int) -> int
extern fn cx_aead_encrypt(k: ptr, nonce_hex: string, pt_hex: string, aad_hex: string) -> string
extern fn cx_aead_decrypt(k: ptr, nonce_hex: string, ct_hex: string, aad_hex: string) -> string
extern fn cx_aes_gcm_encrypt(k: ptr, nonce_hex: string, pt_hex: string, aad_hex: string) -> string
extern fn cx_aes_gcm_decrypt(k: ptr, nonce_hex: string, ct_hex: string, aad_hex: string) -> string
extern fn cx_aes_ctr_hex(k: ptr, iv_hex: string, data_hex: string) -> string
extern fn cx_ed25519_key_random() -> ptr
extern fn cx_ed25519_key_from_seed(seed_hex: string) -> ptr
extern fn cx_ed25519_pubkey_hex(k: ptr) -> string
extern fn cx_ed25519_sign_hex(k: ptr, msg_hex: string) -> string
extern fn cx_ed25519_verify(pub_hex: string, msg_hex: string, sig_hex: string) -> int
extern fn cx_x25519_key_random() -> ptr
extern fn cx_x25519_key_from_secret(sec_hex: string) -> ptr
extern fn cx_x25519_pubkey_hex(k: ptr) -> string
extern fn cx_x25519_shared(k: ptr, their_pub_hex: string) -> ptr
extern fn cx_rsa_key_from_pem(pem: string) -> ptr
extern fn cx_rsa_pubkey_from_pem(pem: string) -> ptr
extern fn cx_rsa_key_random(bits: int) -> ptr
extern fn cx_rsa_key_free(k: ptr)
extern fn cx_rsa_key_bits(k: ptr) -> int
extern fn cx_rsa_key_to_pem(k: ptr) -> string
extern fn cx_rsa_pubkey_to_pem(k: ptr) -> string
extern fn cx_rsa_sign_sha256(k: ptr, msg_hex: string) -> string
extern fn cx_rsa_verify_sha256(k: ptr, msg_hex: string, sig_hex: string) -> int

# Hex arguments cross to C strings; reject embedded NULs before strlen-based
# decoding so distinct Tycho values can never collapse to the same prefix.
fn _has_nul_hex(s: string) -> bool:
    for i := 0; i < len(s); i += 1:
        if s[i] == 0:
            return true
    return false

# ---- secret key handles ----
# A new secret key of n random bytes. Returns a handle (null on failure).
fn key_random(n: int) -> ptr:
    return cx_key_random(n)

# Import a key from hex (e.g. one you stored). Returns a handle (null on bad hex).
fn key_from_hex(hex: string) -> ptr:
    if _has_nul_hex(hex):
        return null
    return cx_key_from_hex(hex)

# Re-materialize a key as hex -- the one place a secret leaves the handle. Use
# only to persist or transmit a key you must keep.
fn key_export_hex(k: ptr) -> string:
    return cx_key_export_hex(k)

# Length of the key in bytes (-1 if the handle is null).
fn key_len(k: ptr) -> int:
    return cx_key_len(k)

# Wipe and free a key handle. Call exactly once per handle.
# A second free, or any use of the handle afterwards, DIES at RUN time --
# "tycho: double free of crypto key handle" / "... used after free". A `ptr` is
# not affine, so this is a run-time diagnostic and never a compile error.
fn key_free(k: ptr):
    cx_key_free(k)

# ---- CSPRNG for PUBLIC bytes (nonces, salts) ----
# n cryptographically secure random bytes as hex. For a secret KEY use key_random.
fn random_hex(n: int) -> string:
    return cx_random_hex(n)

# ---- hashing (public data; message is hex) ----
fn sha256(msg_hex: string) -> string:
    if _has_nul_hex(msg_hex):
        return "!err"
    return cx_sha256_hex(msg_hex)

fn sha512(msg_hex: string) -> string:
    if _has_nul_hex(msg_hex):
        return "!err"
    return cx_sha512_hex(msg_hex)

fn sha3_256(msg_hex: string) -> string:
    if _has_nul_hex(msg_hex):
        return "!err"
    return cx_sha3_256_hex(msg_hex)

fn sha3_512(msg_hex: string) -> string:
    if _has_nul_hex(msg_hex):
        return "!err"
    return cx_sha3_512_hex(msg_hex)

# SHAKE128 extendable-output hash; `outlen` bytes of output as hex.
fn shake128(msg_hex: string, outlen: int) -> string:
    if _has_nul_hex(msg_hex) or outlen < 1:
        return "!err"
    return cx_shake128_hex(msg_hex, outlen)

fn shake256(msg_hex: string, outlen: int) -> string:
    if _has_nul_hex(msg_hex) or outlen < 1:
        return "!err"
    return cx_shake256_hex(msg_hex, outlen)

fn blake2b(msg_hex: string) -> string:
    if _has_nul_hex(msg_hex):
        return "!err"
    return cx_blake2b_hex(msg_hex)

fn blake2s(msg_hex: string) -> string:
    if _has_nul_hex(msg_hex):
        return "!err"
    return cx_blake2s_hex(msg_hex)

# ---- MAC / KDF / constant-time compare ----
# HMAC-SHA256 under a key handle -> 32-byte tag (64 hex).
fn hmac_sha256(key: ptr, msg_hex: string) -> string:
    if _has_nul_hex(msg_hex):
        return "!err"
    return cx_hmac_sha256_hex(key, msg_hex)

fn hmac_sha512(key: ptr, msg_hex: string) -> string:
    if _has_nul_hex(msg_hex):
        return "!err"
    return cx_hmac_sha512_hex(key, msg_hex)

# HKDF-SHA256 (RFC 5869) -> a derived KEY handle of `outlen` bytes. IKM is a
# key handle; salt and info are hex (empty is allowed). Free the result when done.
fn hkdf_sha256(ikm: ptr, salt_hex: string, info_hex: string, outlen: int) -> ptr:
    if _has_nul_hex(salt_hex) or _has_nul_hex(info_hex) or outlen < 1:
        return null
    return cx_hkdf_sha256(ikm, salt_hex, info_hex, outlen)

# PBKDF2-HMAC-SHA256 -> a derived KEY handle (dklen bytes). password is text;
# salt is hex. Use a high iteration count (>= 600000) and a random salt. Free
# the returned handle when done. `iters` above 2^31-1 is REFUSED (null handle)
# rather than truncated -- a truncated count derives a silently weaker key.
fn pbkdf2_sha256(password: string, salt_hex: string, iters: int, dklen: int) -> ptr:
    if _has_nul_hex(salt_hex):
        return null
    return cx_pbkdf2_sha256(password, len(password), salt_hex, iters, dklen)

# Constant-time equality of two hex byte strings (compare MACs this way so the
# timing does not leak how much matched).
fn ct_equal(a_hex: string, b_hex: string) -> bool:
    # Lengths passed: an interior NUL would otherwise shorten both sides, and two
    # different hex strings truncating to the same prefix compared equal.
    if _has_nul_hex(a_hex) or _has_nul_hex(b_hex):
        return false
    return cx_ct_equal(a_hex, len(a_hex), b_hex, len(b_hex)) == 1

# ---- AEAD: ChaCha20-Poly1305 (32-byte key handle, 12-byte nonce / 24 hex) ----
# Encrypt-and-authenticate. Returns ciphertext concatenated with the 16-byte tag,
# as hex. The nonce MUST be unique per key (a counter or random_hex(12)).
fn aead_encrypt(key: ptr, nonce_hex: string, plaintext_hex: string, aad_hex: string) -> string:
    if _has_nul_hex(nonce_hex) or _has_nul_hex(plaintext_hex) or _has_nul_hex(aad_hex):
        return "!err"
    return cx_aead_encrypt(key, nonce_hex, plaintext_hex, aad_hex)

# Verify-and-decrypt. Returns the plaintext as hex, or "!err" if authentication
# fails. Always check for "!err" before trusting the result.
fn aead_decrypt(key: ptr, nonce_hex: string, ciphertext_hex: string, aad_hex: string) -> string:
    if _has_nul_hex(nonce_hex) or _has_nul_hex(ciphertext_hex) or _has_nul_hex(aad_hex):
        return "!err"
    return cx_aead_decrypt(key, nonce_hex, ciphertext_hex, aad_hex)

# AES-GCM with a 16/24/32-byte key handle and a 12-byte nonce. The result is
# ciphertext concatenated with the 16-byte tag, as hex; decrypt returns "!err"
# on authentication failure. Same contract as the ChaCha20-Poly1305 pair.
fn aes_gcm_encrypt(key: ptr, nonce_hex: string, plaintext_hex: string, aad_hex: string) -> string:
    if _has_nul_hex(nonce_hex) or _has_nul_hex(plaintext_hex) or _has_nul_hex(aad_hex):
        return "!err"
    return cx_aes_gcm_encrypt(key, nonce_hex, plaintext_hex, aad_hex)

fn aes_gcm_decrypt(key: ptr, nonce_hex: string, ciphertext_hex: string, aad_hex: string) -> string:
    if _has_nul_hex(nonce_hex) or _has_nul_hex(ciphertext_hex) or _has_nul_hex(aad_hex):
        return "!err"
    return cx_aes_gcm_decrypt(key, nonce_hex, ciphertext_hex, aad_hex)

# AES-CTR keystream (encrypt and decrypt are the same call). 16/24/32-byte key,
# 16-byte counter block; output length equals input length.
fn aes_ctr(key: ptr, iv_hex: string, data_hex: string) -> string:
    if _has_nul_hex(iv_hex) or _has_nul_hex(data_hex):
        return "!err"
    return cx_aes_ctr_hex(key, iv_hex, data_hex)

fn _ed25519_key_random() -> ptr:
    return cx_ed25519_key_random()

# A signing key from a known 32-byte seed (hex). Null on bad input.
fn ed25519_key_from_seed(seed_hex: string) -> ptr:
    if _has_nul_hex(seed_hex):
        return null
    return cx_ed25519_key_from_seed(seed_hex)

# The public key (hex) for a signing-key handle.
fn ed25519_pubkey(key: ptr) -> string:
    return cx_ed25519_pubkey_hex(key)

# Sign a message (hex) -> 64-byte signature (128 hex).
fn ed25519_sign(key: ptr, msg_hex: string) -> string:
    if _has_nul_hex(msg_hex):
        return "!err"
    return cx_ed25519_sign_hex(key, msg_hex)

# Verify a signature against a public key and message. true iff valid.
fn ed25519_verify(pub_hex: string, msg_hex: string, sig_hex: string) -> bool:
    if _has_nul_hex(pub_hex) or _has_nul_hex(msg_hex) or _has_nul_hex(sig_hex):
        return false
    return cx_ed25519_verify(pub_hex, msg_hex, sig_hex) == 1

# ---- X25519 key exchange (secret = key handle; public = hex; shared = handle) ----
# A fresh X25519 secret key. Free it when done.
fn x25519_key_random() -> ptr:
    return cx_x25519_key_random()

# An X25519 secret from a known 32-byte secret (hex). Null on bad input.
fn x25519_key_from_secret(secret_hex: string) -> ptr:
    if _has_nul_hex(secret_hex):
        return null
    return cx_x25519_key_from_secret(secret_hex)

# The public key (hex) for a secret-key handle.
fn x25519_pubkey(key: ptr) -> string:
    return cx_x25519_pubkey_hex(key)

# Diffie-Hellman: combine my secret (handle) with their public key (hex) -> a
# shared-secret KEY handle. Both sides get the same value. Free it when done; do
# not use it as a key directly -- derive one (e.g. hmac_sha256 / pbkdf2) first.
fn x25519_shared(my_key: ptr, their_pubkey_hex: string) -> ptr:
    if _has_nul_hex(their_pubkey_hex):
        return null
    return cx_x25519_shared(my_key, their_pubkey_hex)

# ---- RSA (PKCS#1 v1.5, SHA-256) ----
# PEM/DER material crosses as text; keys are opaque handles with an explicit
# free. Generation is bounded to 2048..8192 bits and is intentionally slow.
fn rsa_key_from_pem(pem: string) -> ptr:
    if _has_nul_hex(pem):
        return null
    return cx_rsa_key_from_pem(pem)

fn rsa_pubkey_from_pem(pem: string) -> ptr:
    if _has_nul_hex(pem):
        return null
    return cx_rsa_pubkey_from_pem(pem)

fn rsa_key_random(bits: int) -> ptr:
    return cx_rsa_key_random(bits)

fn rsa_key_free(k: ptr):
    cx_rsa_key_free(k)

fn rsa_key_bits(k: ptr) -> int:
    return cx_rsa_key_bits(k)

fn rsa_key_to_pem(k: ptr) -> string:
    return cx_rsa_key_to_pem(k)

fn rsa_pubkey_to_pem(k: ptr) -> string:
    return cx_rsa_pubkey_to_pem(k)

fn rsa_sign_sha256(k: ptr, msg_hex: string) -> string:
    if _has_nul_hex(msg_hex):
        return "!err"
    return cx_rsa_sign_sha256(k, msg_hex)

fn rsa_verify_sha256(k: ptr, msg_hex: string, sig_hex: string) -> bool:
    if _has_nul_hex(msg_hex) or _has_nul_hex(sig_hex):
        return false
    return cx_rsa_verify_sha256(k, msg_hex, sig_hex) == 1
