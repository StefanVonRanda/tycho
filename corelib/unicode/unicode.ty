fn _upper_full(s: string) -> string:
    keys := _upper_exp_keys()
    off := _upper_exp_off()
    data := _upper_exp_data()
    out := ""
    for cp in _decode_cps(s):
        if cp < 0:
            out = out + chr(0 - cp)
            continue
        i := _idx(keys, cp)
        if i >= 0:
            for x in data[off[i]:off[i + 1]]:
                out = out + utf8.encode(x)
        else:
            out = out + utf8.encode(to_upper_char(cp))
    return out

fn _lower_full(s: string) -> string:
    keys := _lower_exp_keys()
    off := _lower_exp_off()
    data := _lower_exp_data()
    out := ""
    for cp in _decode_cps(s):
        if cp < 0:
            out = out + chr(0 - cp)
            continue
        i := _idx(keys, cp)
        if i >= 0:
            for x in data[off[i]:off[i + 1]]:
                out = out + utf8.encode(x)
        else:
            out = out + utf8.encode(to_lower_char(cp))
    return out

fn _casefold_full(s: string) -> string:
    keys := _fold_exp_keys()
    off := _fold_exp_off()
    data := _fold_exp_data()
    out := ""
    for cp in _decode_cps(s):
        if cp < 0:
            out = out + chr(0 - cp)
            continue
        i := _idx(keys, cp)
        if i >= 0:
            for x in data[off[i]:off[i + 1]]:
                out = out + utf8.encode(x)
        else:
            out = out + utf8.encode(to_casefold_char(cp))
    return out


