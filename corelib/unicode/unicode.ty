fn to_title_char(cp: int) -> int:
    if cp >= 97 and cp <= 122:
        return cp - 32
    if cp < 128:
        return cp
    return _lookup(_title_map(), cp)

fn to_title(s: string) -> string:
    out := ""
    for cp in _decode_cps(s):
        if cp < 0:
            out = out + chr(0 - cp)
        else:
            out = out + utf8.encode(to_title_char(cp))
    return out
