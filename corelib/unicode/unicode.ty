fn _idx(keys: [int], cp: int) -> int:
    lo := 0
    hi := len(keys) - 1
    for lo <= hi:
        mid := (lo + hi) / 2
        k := keys[mid]
        if k == cp:
            return mid
        if k < cp:
            lo = mid + 1
        else:
            hi = mid - 1
    return -1

fn _ccc(cp: int, ck: [int], cv: [int]) -> int:
    i := _idx(ck, cp)
    if i < 0:
        return 0
    return cv[i]

const S_BASE = 44032
const L_BASE = 4352
const V_BASE = 4449
const T_BASE = 4519
const L_COUNT = 19
const V_COUNT = 21
const T_COUNT = 28
const N_COUNT = 588
const S_COUNT = 11172

fn _hangul_decomp(cp: int) -> [int]:
    s := cp - S_BASE
    l := L_BASE + s / N_COUNT
    v := V_BASE + (s % N_COUNT) / T_COUNT
    t := T_BASE + s % T_COUNT
    out := []int
    push(out, l)
    push(out, v)
    if t != T_BASE:
        push(out, t)
    return out

fn _decomp(cp: int, compat: bool, keys: [int], off: [int], data: [int]) -> [int]:
    if cp >= S_BASE and cp < S_BASE + S_COUNT:
        return _hangul_decomp(cp)
    i := _idx(keys, cp)
    if i < 0:
        out := []int
        push(out, cp)
        return out
    return data[off[i]:off[i + 1]]

fn _decode_cps(s: string) -> [int]:
    cps := []int
    i := 0
    for i < len(s):
        cp, w := utf8.decode(s, i)
        if cp < 0:
            push(cps, 0 - s[i])
            i += 1
        else:
            push(cps, cp)
            i += w
    return cps

fn _encode_cps(cps: [int]) -> string:
    out := ""
    for cp in cps:
        if cp < 0:
            out = out + chr(0 - cp)
        else:
            out = out + utf8.encode(cp)
    return out

fn _decompose(s: string, compat: bool) -> [int]:
    cps := _decode_cps(s)
    keys := _canon_keys()
    off := _canon_off()
    data := _canon_data()
    if compat:
        keys = _compat_keys()
        off = _compat_off()
        data = _compat_data()
    out := []int
    for cp in cps:
        if cp < 0:
            push(out, cp)
        else:
            for x in _decomp(cp, compat, keys, off, data):
                push(out, x)
    return out

fn _reorder(cps: [int], ck: [int], cv: [int]) -> [int]:
    out := cps
    i := 1
    for i < len(out):
        j := i
        for j > 0 and _ccc(out[j], ck, cv) != 0 and _ccc(out[j - 1], ck, cv) > _ccc(out[j], ck, cv):
            tmp := out[j - 1]
            out[j - 1] = out[j]
            out[j] = tmp
            j -= 1
        i += 1
    return out

fn _compose_pair(a: int, b: int, ca: [int], cb: [int], cp: [int]) -> int:
    l := a - L_BASE
    if l >= 0 and l < L_COUNT and b >= V_BASE and b < V_BASE + V_COUNT:
        return S_BASE + (l * V_COUNT + (b - V_BASE)) * T_COUNT
    if a >= S_BASE and a < S_BASE + S_COUNT and (a - S_BASE) % T_COUNT == 0 and b > T_BASE and b < T_BASE + T_COUNT:
        return a + (b - T_BASE)
    lo := 0
    hi := len(ca) - 1
    for lo <= hi:
        mid := (lo + hi) / 2
        if ca[mid] == a and cb[mid] == b:
            return cp[mid]
        if ca[mid] < a or (ca[mid] == a and cb[mid] < b):
            lo = mid + 1
        else:
            hi = mid - 1
    return -1

fn _compose(cps: [int], ck: [int], cv: [int], ca: [int], cb: [int], cp: [int]) -> [int]:
    out := []int
    starter := -1
    last_cc := 0
    for x in cps:
        cc := 0
        if x >= 0:
            cc = _ccc(x, ck, cv)
        if starter >= 0 and (last_cc < cc or last_cc == 0):
            c := _compose_pair(out[starter], x, ca, cb, cp)
            if c >= 0:
                out[starter] = c
                continue
        push(out, x)
        if cc == 0:
            starter = len(out) - 1
        last_cc = cc
    return out

fn normalize_nfd(s: string) -> string:
    cps := _decompose(s, false)
    return _encode_cps(_reorder(cps, _ccc_keys(), _ccc_vals()))

fn normalize_nfkd(s: string) -> string:
    cps := _decompose(s, true)
    return _encode_cps(_reorder(cps, _ccc_keys(), _ccc_vals()))

fn normalize_nfc(s: string) -> string:
    cps := _reorder(_decompose(s, false), _ccc_keys(), _ccc_vals())
    return _encode_cps(_compose(cps, _ccc_keys(), _ccc_vals(), _comp_a(), _comp_b(), _comp_cp()))

fn normalize_nfkc(s: string) -> string:
    cps := _reorder(_decompose(s, true), _ccc_keys(), _ccc_vals())
    return _encode_cps(_compose(cps, _ccc_keys(), _ccc_vals(), _comp_a(), _comp_b(), _comp_cp()))


