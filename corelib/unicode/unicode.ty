fn _range_prop(starts: [int], ends: [int], props: [int], cp: int) -> int:
    lo := 0
    hi := len(starts) - 1
    for lo <= hi:
        mid := (lo + hi) / 2
        if cp < starts[mid]:
            hi = mid - 1
        elif cp > ends[mid]:
            lo = mid + 1
        else:
            return props[mid]
    return 0

fn _gcb_of(cp: int) -> int:
    return _range_prop(_gcb_starts(), _gcb_ends(), _gcb_props(), cp)

fn _wb_of(cp: int) -> int:
    return _range_prop(_wb_starts(), _wb_ends(), _wb_props(), cp)

fn _ep_of(cp: int) -> bool:
    return _range_prop(_ep_starts(), _ep_ends(), _ep_props(), cp) == 1

fn _incb_of(cp: int) -> int:
    return _range_prop(_incb_starts(), _incb_ends(), _incb_props(), cp)

fn _is_gcb_control(p: int) -> bool:
    return p == 1 or p == 2 or p == 3

fn graphemes(s: string) -> [string]:
    cps := _decode_cps(s)
    out := []string
    cur := ""
    ri_run := 0
    pict := 0
    incb := 0
    i := 0
    prev_prop := 0
    for i < len(cps):
        cp := cps[i]
        if cp < 0:
            if i > 0:
                push(out, cur)
                cur = ""
            cur = cur + chr(0 - cp)
            prev_prop = 0
            ri_run = 0
            pict = 0
            incb = 0
            i += 1
            continue
        p := _gcb_of(cp)
        brk := false
        if i > 0:
            if prev_prop == 1 and p == 2:
                brk = false
            elif _is_gcb_control(prev_prop):
                brk = true
            elif _is_gcb_control(p):
                brk = true
            elif prev_prop == 9 and (p == 9 or p == 10 or p == 12 or p == 13):
                brk = false
            elif (prev_prop == 12 or prev_prop == 10) and (p == 10 or p == 11):
                brk = false
            elif (prev_prop == 13 or prev_prop == 11) and p == 11:
                brk = false
            elif p == 4 or p == 5:
                brk = false
            elif p == 8:
                brk = false
            elif prev_prop == 7:
                brk = false
            elif pict == 3 and _ep_of(cp):
                brk = false
            elif incb == 2 and _incb_of(cp) == 1:
                brk = false
            elif prev_prop == 6 and p == 6 and ri_run % 2 == 1:
                brk = false
            else:
                brk = true
        if brk:
            push(out, cur)
            cur = ""
        cur = cur + utf8.encode(cp)
        # state updates after the boundary decision
        if p == 6:
            if prev_prop == 6:
                ri_run += 1
            else:
                ri_run = 1
        else:
            ri_run = 0
        ic := _incb_of(cp)
        if ic == 1:
            incb = 1
        elif ic == 2 and incb >= 1:
            incb = 2
        elif ic == 3 and incb >= 1:
            pass
        else:
            incb = 0
        if _ep_of(cp):
            pict = 1
        elif p == 4 and (pict == 1 or pict == 2):
            pict = 2
        elif p == 5 and (pict == 1 or pict == 2):
            pict = 3
        else:
            pict = 0
        prev_prop = p
        i += 1
    if len(cur) > 0 or len(cps) == 0:
        push(out, cur)
    return out

fn _is_wb_ignore(p: int) -> bool:
    return p == 4 or p == 5 or p == 7

fn _ahletter(p: int) -> bool:
    return p == 9 or p == 10

fn _midnumletq(p: int) -> bool:
    return p == 11 or p == 13

fn words(s: string) -> [string]:
    cps := _decode_cps(s)
    props := []int
    for cp in cps:
        if cp < 0:
            push(props, 0)
        else:
            push(props, _wb_of(cp))
    out := []string
    cur := ""
    ri_run := 0
    i := 0
    for i < len(cps):
        cp := cps[i]
        if cp < 0:
            if i > 0:
                push(out, cur)
                cur = ""
            cur = cur + chr(0 - cp)
            ri_run = 0
            i += 1
            continue
        p := props[i]
        brk := false
        if i > 0:
            pp := props[i - 1]
            if _is_wb_ignore(p):
                if pp == 1 or pp == 2 or pp == 3:
                    brk = true
                else:
                    brk = false
            else:
                pi := i - 1
                for pi >= 0 and _is_wb_ignore(props[pi]):
                    pi -= 1
                if pi < 0:
                    brk = false
                else:
                    a := props[pi]
                    ppi := pi - 1
                    for ppi >= 0 and _is_wb_ignore(props[ppi]):
                        ppi -= 1
                    aa := 0
                    if ppi >= 0:
                        aa = props[ppi]
                    ni := i + 1
                    for ni < len(props) and _is_wb_ignore(props[ni]):
                        ni += 1
                    b := p
                    n := 0
                    if ni < len(props):
                        n = props[ni]
                    if a == 1 or a == 2 or a == 3:
                        brk = true
                    elif b == 1 or b == 2 or b == 3:
                        brk = true
                    elif a == 5 and _ep_of(cp):
                        brk = false
                    elif a == 18 and b == 18:
                        brk = false
                    elif _ahletter(a) and _ahletter(b):
                        brk = false
                    elif _ahletter(a) and (_midnumletq(b) or b == 14) and _ahletter(n):
                        brk = false
                    elif _ahletter(aa) and (a == 14 or _midnumletq(a)) and _ahletter(b):
                        brk = false
                    elif a == 9 and b == 11:
                        brk = false
                    elif a == 9 and b == 12 and n == 9:
                        brk = false
                    elif a == 12 and b == 9:
                        brk = false
                    elif a == 16 and b == 16:
                        brk = false
                    elif _ahletter(a) and b == 16:
                        brk = false
                    elif a == 16 and _ahletter(b):
                        brk = false
                    elif a == 16 and (b == 15 or _midnumletq(b)) and n == 16:
                        brk = false
                    elif (a == 15 or _midnumletq(a)) and aa == 16 and b == 16:
                        brk = false
                    elif a == 8 and b == 8:
                        brk = false
                    elif (_ahletter(a) or a == 16 or a == 8 or a == 17) and b == 17:
                        brk = false
                    elif a == 17 and (_ahletter(b) or b == 16 or b == 8):
                        brk = false
                    elif a == 6 and b == 6 and ri_run % 2 == 1:
                        brk = false
                    elif props[i - 1] == 5 and _ep_of(cp):
                        brk = false
                    else:
                        brk = true
        if brk:
            push(out, cur)
            cur = ""
        cur = cur + utf8.encode(cp)
        if p == 6:
            if i > 0 and props[i - 1] == 6:
                ri_run += 1
            else:
                ri_run = 1
        else:
            ri_run = 0
        i += 1
    if len(cur) > 0 or len(cps) == 0:
        push(out, cur)
    return out


