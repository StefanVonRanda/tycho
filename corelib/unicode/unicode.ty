fn _cat_of(cp: int) -> int:
    if cp < 0 or cp > 1114111:
        return 0
    return _range_prop(_cat_starts(), _cat_ends(), _cat_vals(), cp)

fn _in_prop(cp: int, starts: [int], ends: [int]) -> bool:
    lo := 0
    hi := len(starts) - 1
    for lo <= hi:
        mid := (lo + hi) / 2
        if cp < starts[mid]:
            hi = mid - 1
        elif cp > ends[mid]:
            lo = mid + 1
        else:
            return true
    return false

fn _named(starts: [int], ends: [int], vals: [int], names: [string], cp: int) -> string:
    if cp < 0 or cp > 1114111:
        return names[0]
    return names[_range_prop(starts, ends, vals, cp)]

fn _category(c: int) -> Category:
    if c == 1:
        return Lu
    if c == 2:
        return Ll
    if c == 3:
        return Lt
    if c == 4:
        return Lm
    if c == 5:
        return Lo
    if c == 6:
        return Mn
    if c == 7:
        return Mc
    if c == 8:
        return Me
    if c == 9:
        return Nd
    if c == 10:
        return Nl
    if c == 11:
        return No
    if c == 12:
        return Pc
    if c == 13:
        return Pd
    if c == 14:
        return Ps
    if c == 15:
        return Pe
    if c == 16:
        return Pi
    if c == 17:
        return Pf
    if c == 18:
        return Po
    if c == 19:
        return Sm
    if c == 20:
        return Sc
    if c == 21:
        return Sk
    if c == 22:
        return So
    if c == 23:
        return Zs
    if c == 24:
        return Zl
    if c == 25:
        return Zp
    if c == 26:
        return Cc
    if c == 27:
        return Cf
    if c == 28:
        return Cs
    if c == 29:
        return Co
    return Cn

fn _cat_names() -> [string]:
    return ["Cn", "Lu", "Ll", "Lt", "Lm", "Lo", "Mn", "Mc", "Me", "Nd",
            "Nl", "No", "Pc", "Pd", "Ps", "Pe", "Pi", "Pf", "Po", "Sm",
            "Sc", "Sk", "So", "Zs", "Zl", "Zp", "Cc", "Cf", "Cs", "Co"]

fn general_category(cp: int) -> Category:
    return _category(_cat_of(cp))

fn category_name(cp: int) -> string:
    return _cat_names()[_cat_of(cp)]

fn combining_class(cp: int) -> int:
    return _ccc(cp, _ccc_keys(), _ccc_vals())

fn is_letter(cp: int) -> bool:
    c := _cat_of(cp)
    return c >= 1 and c <= 5

fn is_alpha(cp: int) -> bool:
    return is_letter(cp)

fn is_alphabetic(cp: int) -> bool:
    return _in_prop(cp, _alpha_starts(), _alpha_ends())

fn is_upper(cp: int) -> bool:
    return _cat_of(cp) == 1

fn is_lower(cp: int) -> bool:
    return _cat_of(cp) == 2

fn is_title(cp: int) -> bool:
    return _cat_of(cp) == 3

fn is_decimal(cp: int) -> bool:
    return _cat_of(cp) == 9

fn is_digit(cp: int) -> bool:
    return is_decimal(cp)

fn is_number(cp: int) -> bool:
    c := _cat_of(cp)
    return c >= 9 and c <= 11

fn is_alnum(cp: int) -> bool:
    return is_letter(cp) or is_number(cp)

fn is_alphanumeric(cp: int) -> bool:
    return is_alnum(cp)

fn is_space(cp: int) -> bool:
    return _in_prop(cp, _space_starts(), _space_ends())

fn is_whitespace(cp: int) -> bool:
    return is_space(cp)

fn is_control(cp: int) -> bool:
    return _cat_of(cp) == 26

fn is_punct(cp: int) -> bool:
    c := _cat_of(cp)
    return c >= 12 and c <= 18

fn is_symbol(cp: int) -> bool:
    c := _cat_of(cp)
    return c >= 19 and c <= 22

fn is_mark(cp: int) -> bool:
    c := _cat_of(cp)
    return c >= 6 and c <= 8

fn is_separator(cp: int) -> bool:
    c := _cat_of(cp)
    return c >= 23 and c <= 25

fn is_graphic(cp: int) -> bool:
    c := _cat_of(cp)
    return c >= 1 and c <= 22

fn is_print(cp: int) -> bool:
    c := _cat_of(cp)
    return c >= 1 and c <= 23

fn is_ascii(cp: int) -> bool:
    return cp >= 0 and cp <= 127

fn is_hex_digit(cp: int) -> bool:
    return _in_prop(cp, _hexd_starts(), _hexd_ends())

fn is_combining(cp: int) -> bool:
    return combining_class(cp) != 0

fn is_emoji(cp: int) -> bool:
    return _in_prop(cp, _emoji_starts(), _emoji_ends())

fn is_emoji_modifier(cp: int) -> bool:
    return _in_prop(cp, _emod_starts(), _emod_ends())

fn is_emoji_extended_pictographic(cp: int) -> bool:
    return _ep_of(cp)

fn script(cp: int) -> string:
    return _named(_script_starts(), _script_ends(), _script_vals(), _script_names(), cp)

fn block(cp: int) -> string:
    return _named(_block_starts(), _block_ends(), _block_vals(), _block_names(), cp)


