fn to_casefold_char(cp: int) -> int:
    if cp >= 65 and cp <= 90:
        return cp + 32
    if cp < 128:
        return cp
    return _lookup(_fold_map(), cp)

# Full case folding with one-to-many expansions; invalid UTF-8 bytes pass through.
fn to_casefold(s: string) -> string:
    return _casefold_full(s)



