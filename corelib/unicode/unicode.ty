fn _lookup(m: [(int, int)], cp: int) -> int:
    lo := 0
    hi := len(m) - 1
    for lo <= hi:
        mid := (lo + hi) / 2
        k := m[mid].0
        if k == cp:
            return m[mid].1
        if k < cp:
            lo = mid + 1
        else:
            hi = mid - 1
    return cp

fn to_upper_char(cp: int) -> int:
    if cp >= 97 and cp <= 122:
        return cp - 32
    if cp < 128:
        return cp
    return _lookup(_upper_map(), cp)

fn to_lower_char(cp: int) -> int:
    if cp >= 65 and cp <= 90:
        return cp + 32
    if cp < 128:
        return cp
    return _lookup(_lower_map(), cp)

# Full case mapping with one-to-many expansions; invalid UTF-8 bytes pass through.
fn to_upper(s: string) -> string:
    return _upper_full(s)


fn to_lower(s: string) -> string:
    return _lower_full(s)



