# core:testing -- a unit-test framework. Import with `import "core:testing"`.
#
# Tycho has no globals, so a test's state is an explicit value the caller owns
# and threads through `inout` (the same shape as core:rand's state):
#
#   t := testing.new("parser")
#   testing.check(&t, len(s) > 0, "non-empty input")
#   testing.eq(&t, parse(s), 42, "parse result")
#   exit(testing.report(t))
#
# Every `check`/`eq` records one assertion; a failing one prints its message
# (so failures are visible while a suite runs, not only in the summary).
# `report` prints the verdict line and returns 0 on a fully passing test, 1
# otherwise -- the convention is `exit(testing.report(t))`, which fails the
# whole run on the first failing test. The golden-friendly output shape:
#
#   ok   parser (3 checks)
#         FAIL: empty input
#   FAIL parser (1 of 3 checks failed)
#
# The framework is a library, not syntax: a suite is a `main` that runs its
# test cases and exits with the combined verdict. Generic `eq` covers the
# comparable scalars (int/float/string/char); for a composite value (array,
# struct, map) compare with `==` and pass the message yourself --
# `check(&t, a == b, "trees equal")`.
package testing

struct T:
    name: string
    nchecks: int
    nfail: int

fn new(name: string) -> T:
    return T(name, 0, 0)

# Record one assertion; on failure print `msg` (indented, so failures are
# visible inline) and count it.
fn check(t: inout T, cond: bool, msg: string):
    t.nchecks = t.nchecks + 1
    if not cond:
        t.nfail = t.nfail + 1
        print("      FAIL: " + msg + "\n")

# Generic equality assertion for the comparable scalars. The message names the
# check and shows both sides, so a failure reads "eq result (got 1, want 2)".
fn eq(t: inout T, got: $T, want: $T, msg: string) where comparable(T):
    check(&t, got == want, msg + " (got " + str(got) + ", want " + str(want) + ")")

# Print the verdict and return 0 if every check passed, else 1 (for exit()).
fn report(t: T) -> int:
    if t.nfail == 0:
        print("ok   " + t.name + " (" + str(t.nchecks) + " checks)\n")
        return 0
    print("FAIL " + t.name + " (" + str(t.nfail) + " of " + str(t.nchecks) + " checks failed)\n")
    return 1
