package testing

struct T:
    name: string
    nchecks: int
    nfail: int

fn new(name: string) -> T:
    return T(name, 0, 0)

# Record one assertion; on failure print `msg` (indented, so failures are
# visible inline) and count it.
fn check(t: inout T, cond: bool, msg: string):
    t.nchecks = t.nchecks + 1
    if not cond:
        t.nfail = t.nfail + 1
        print("      FAIL: " + msg + "\n")

# Generic equality assertion for the comparable scalars. The message names the
# check and shows both sides, so a failure reads "eq result (got 1, want 2)".
fn eq(t: inout T, got: $T, want: $T, msg: string) where comparable(T):
    check(&t, got == want, msg + " (got " + str(got) + ", want " + str(want) + ")")

# Print the verdict and return 0 if every check passed, else 1 (for exit()).
fn report(t: T) -> int:
    if t.nfail == 0:
        print("ok   " + t.name + " (" + str(t.nchecks) + " checks)\n")
        return 0
    print("FAIL " + t.name + " (" + str(t.nfail) + " of " + str(t.nchecks) + " checks failed)\n")
    return 1

struct Bench:
    name: string
    iters: int
    ns: int

# Run `f` `iters` times and record the wall time. This is a microbenchmark,
# not a sampling profiler; report_bench formats the result.
fn bench(name: string, iters: int, f: fn()) -> Bench:
    n := iters
    if n < 0:
        n = 0
    start := clock()
    i := 0
    for i < n:
        f()
        i += 1
    return Bench(name, n, clock() - start)

fn report_bench(b: Bench) -> string:
    per := 0
    if b.iters > 0:
        per = b.ns / b.iters
    return b.name + ": " + str(b.iters) + " iters, " + str(b.ns) + " ns, " + str(per) + " ns/op"

# A child test named `parent/name`; merge its counters back when it finishes.
fn subtest(parent: T, name: string) -> T:
    return T(parent.name + "/" + name, 0, 0)

fn merge(parent: inout T, child: T):
    parent.nchecks += child.nchecks
    parent.nfail += child.nfail
