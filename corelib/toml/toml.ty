package toml

import "core:strings"
import "core:utf8"

const TOML_MAX_INPUT = 65536
const TOML_MAX_ENTRIES = 512
const TOML_MAX_NESTING = 128

enum Value:
    TStr(string)
    TInt(int)
    TFloat(float)
    TBool(bool)
    TArr([Value])
    TTable([string], [Value])        # parallel keys/values, insertion order

# --- table accessors --------------------------------------------------------

# Walk a quote-aware dotted path (`"a.b.c"`, or `"\"a.b\".c"`) down from a
# table; None on a missing key or a path that crosses a non-table value.
fn get(t: Value, path: string) -> Option(Value):
    parts: [string] = []string
    match _parse_key(path):
        Ok(p): parts = p
        Err(_): return None
    cur := t
    for i := 0; i < len(parts); i += 1:
        if parts[i] == "":
            return None
        match cur:
            TTable(ks, vs):
                idx := index_of(ks, parts[i])
                if idx < 0:
                    return None
                if i + 1 == len(parts):
                    return Some(vs[idx])
                cur = vs[idx]
            _:
                return None
    return None

# An empty table value (a fresh root / section).
fn empty_table() -> Value:
    return TTable([]string, []Value)

# Would `_assign(tbl, path, _)` overwrite something? True when the exact path is
# already bound, and also when a PREFIX of it names a non-table -- `a = 1` then
# `a.b = 2` replaces the scalar, which is the same silent override.
fn _has_path(tbl: Value, path: [string]) -> bool:
    cur := tbl
    for i := 0; i < len(path); i += 1:
        match cur:
            TTable(ks, vs):
                idx := index_of(ks, path[i])
                if idx < 0:
                    return false
                if i + 1 == len(path):
                    return true
                cur = vs[idx]
            _:
                return true
    return false

fn index_of(ks: [string], k: string) -> int:
    for i := 0; i < len(ks); i += 1:
        if ks[i] == k:
            return i
    return -1

# The table's keys, in insertion order.
fn keys(t: Value) -> [string]:
    match t:
        TTable(ks, vs):
            return ks
        _:
            return []string

# --- writing helpers (parse-side) -------------------------------------------

# Set tbl[path] = v inside a table value, creating intermediate tables for
# dotted keys.
fn _assign(tbl: Value, path: [string], v: Value) -> Value:
    ks := []string
    vs := []Value
    match tbl:
        TTable(k, vv):
            ks = k
            vs = vv
        _:
            ks = []string
            vs = []Value
    if len(path) == 1:
        idx := index_of(ks, path[0])
        if idx >= 0:
            vs[idx] = v
        else:
            push(ks, path[0])
            push(vs, v)
        return TTable(ks, vs)
    sub := TTable([]string, []Value)
    idx := index_of(ks, path[0])
    if idx >= 0:
        match vs[idx]:
            TTable(k2, v2):
                sub = vs[idx]
            _:
                sub = TTable([]string, []Value)
    sub = _assign(sub, path[1:], v)
    if idx >= 0:
        vs[idx] = sub
    else:
        push(ks, path[0])
        push(vs, sub)
    return TTable(ks, vs)

# Merge a later explicit parent table into the implicit table created by an
# earlier child header. Existing keys are not overwritten.
fn _merge_tables(old: Value, incoming: Value) -> Result(Value, string):
    old_keys: [string] = []
    old_vals: [Value] = []
    new_keys: [string] = []
    new_vals: [Value] = []
    match old:
        TTable(ks, vs):
            old_keys = ks
            old_vals = vs
        _: return Err("table header conflicts with a non-table")
    match incoming:
        TTable(ks, vs):
            new_keys = ks
            new_vals = vs
        _: return Err("table header is not a table")
    for i := 0; i < len(new_keys); i += 1:
        if index_of(old_keys, new_keys[i]) >= 0:
            return Err("duplicate key while merging table: " + new_keys[i])
        push(old_keys, new_keys[i])
        push(old_vals, new_vals[i])
    return Ok(TTable(old_keys, old_vals))

# Place `tbl` at root[path...], creating intermediate tables. For an array
# section ([[..]]) the leaf is an array-of-tables; nested headers descend into
# the most recently appended table, as TOML specifies.
fn _place(root: Value, path: [string], tbl: Value, is_arr: bool) -> Result(Value, string):
    ks := []string
    vs := []Value
    match root:
        TTable(k, vv):
            ks = k
            vs = vv
        _:
            return Err("table path crosses a non-table")
    if len(path) == 0:
        return Err("empty table path")
    idx := index_of(ks, path[0])
    if len(path) == 1:
        if is_arr:
            arr := []Value
            if idx >= 0:
                match vs[idx]:
                    TArr(e): arr = e
                    _: return Err("array-of-tables conflicts with existing value: " + path[0])
            push(arr, tbl)
            if idx >= 0:
                vs[idx] = TArr(arr)
            else:
                push(ks, path[0])
                push(vs, TArr(arr))
            return Ok(TTable(ks, vs))
        if idx >= 0:
            merged := _merge_tables(vs[idx], tbl) or_return
            vs[idx] = merged
        else:
            push(ks, path[0])
            push(vs, tbl)
        return Ok(TTable(ks, vs))

    rest := path[1:]
    if idx < 0:
        sub := _place(TTable([]string, []Value), rest, tbl, is_arr) or_return
        push(ks, path[0])
        push(vs, sub)
        return Ok(TTable(ks, vs))
    match vs[idx]:
        TTable(k2, v2):
            sub := _place(vs[idx], rest, tbl, is_arr) or_return
            vs[idx] = sub
        TArr(arr):
            if len(arr) == 0:
                return Err("empty array-of-tables at " + path[0])
            last := len(arr) - 1
            match arr[last]:
                TTable(k2, v2):
                    sub := _place(arr[last], rest, tbl, is_arr) or_return
                    arr[last] = sub
                    vs[idx] = TArr(arr)
                _: return Err("array-of-tables contains a non-table: " + path[0])
        _: return Err("table path crosses a non-table: " + path[0])
    return Ok(TTable(ks, vs))

# --- scalar parsers ---------------------------------------------------------

fn _parse_value(tok: string) -> Result(Value, string):
    return _parse_value_depth(tok, 0)

fn _parse_value_depth(tok: string, depth: int) -> Result(Value, string):
    if depth > TOML_MAX_NESTING:
        return Err("TOML value nesting exceeds " + str(TOML_MAX_NESTING))
    if len(tok) == 0:
        return Err("empty value")
    c := tok[0]
    if c == 34:                    # '"' basic string
        return _parse_basic(tok)
    if c == 39:                    # "'" literal string
        close := -1
        for i := 1; i < len(tok); i += 1:
            if tok[i] == 39:
                close = i
                break
        if close < 0:
            return Err("unterminated literal string")
        if close != len(tok) - 1:
            return Err("trailing text after a literal string: " + tok)
        return Ok(TStr(tok[1:close]))
    if c == 91:                    # '[' array
        return _parse_array(tok, depth)
    if tok == "true":
        return Ok(TBool(true))
    if tok == "false":
        return Ok(TBool(false))
    if len(tok) >= 10 and _is_date_head(tok):
        if not _is_date_valid(tok):
            return Err("not a real date: " + tok)
        if not _is_time_valid(tok):
            return Err("not a real time: " + tok)
        return Ok(TStr(tok))       # ISO-8601 datetime, kept as a string
    if _is_num_start(c) or c == 43 or c == 45:
        return _parse_number(tok)
    return Err("cannot parse value: " + tok)

fn _dnum(t: string, a: int, b: int) -> int:
    v := 0
    for i := a; i < b; i += 1:
        v = v * 10 + (t[i] - 48)
    return v

# A SHAPE is not a date: `9999-99-99` is ten bytes shaped NNNN-NN-NN and was
# accepted whole as a datetime string. Month and day ranges, leap year included.
fn _is_date_valid(t: string) -> bool:
    y := _dnum(t, 0, 4)
    m := _dnum(t, 5, 7)
    d := _dnum(t, 8, 10)
    if m < 1 or m > 12 or d < 1:
        return false
    dim := 31
    if m == 4 or m == 6 or m == 9 or m == 11:
        dim = 30
    elif m == 2:
        dim = 28
        if y % 4 == 0 and (y % 100 != 0 or y % 400 == 0):
            dim = 29
    return d <= dim

# Two digits at `i`, or -1. The -1 is what makes every t[i+k] below in range.
fn _d2(t: string, i: int) -> int:
    if i + 2 > len(t):
        return -1
    if t[i] < 48 or t[i] > 57:
        return -1
    if t[i + 1] < 48 or t[i + 1] > 57:
        return -1
    return (t[i] - 48) * 10 + (t[i + 1] - 48)

# Everything after the ten-byte date head. Was accepted whole, so
# `2023-01-01T99:99:99` and `2023-01-01hello` were both datetimes.
fn _is_time_valid(t: string) -> bool:
    if len(t) == 10:
        return true                       # local date, no time half
    sep := t[10]
    if sep != 84 and sep != 116 and sep != 32:    # 'T' / 't' / ' '
        return false
    a := 11
    h := _d2(t, a)
    m := _d2(t, a + 3)
    s := _d2(t, a + 6)
    if h < 0 or m < 0 or s < 0:
        return false
    if t[a + 2] != 58 or t[a + 5] != 58:          # ':'
        return false
    if h > 23 or m > 59 or s > 60:                # 60 is a leap second
        return false
    i := a + 8
    if i < len(t) and t[i] == 46:                 # '.' fractional seconds
        i = i + 1
        n := 0
        for i < len(t) and t[i] >= 48 and t[i] <= 57:
            i = i + 1
            n = n + 1
        if n == 0:
            return false
    if i == len(t):
        return true                       # local datetime, offset omitted
    c := t[i]
    if c == 90 or c == 122:                       # 'Z' / 'z'
        return i + 1 == len(t)
    if c != 43 and c != 45:                       # '+' / '-'
        return false
    oh := _d2(t, i + 1)
    om := _d2(t, i + 4)
    if oh < 0 or om < 0:
        return false
    if t[i + 3] != 58:
        return false
    return oh <= 23 and om <= 59 and i + 6 == len(t)

fn _is_date_head(t: string) -> bool:       # YYYY-MM-DD shape only
    for i := 0; i < 10; i += 1:
        if i == 4 or i == 7:
            if t[i] != 45:
                return false
        elif t[i] < 48 or t[i] > 57:
            return false
    return true

fn _is_num_start(c: int) -> bool:
    return (c >= 48 and c <= 57) or c == 120 or c == 88   # digit, x, X

fn _parse_basic(t: string) -> Result(Value, string):
    out := ""
    i := 1
    for i < len(t):
        c := t[i]
        if c == 34:
            if i != len(t) - 1:
                return Err("trailing text after a string value: " + t)
            return Ok(TStr(out))
        if c == 92:                # backslash escape
            i = i + 1
            if i >= len(t):
                return Err("unterminated escape in string")
            e := t[i]
            if e == 110:
                out = out + "\n"
            elif e == 116:
                out = out + "\t"
            elif e == 114:
                out = out + "\r"
            elif e == 98:
                out = out + chr(8)
            elif e == 102:
                out = out + chr(12)
            elif e == 92 or e == 34:
                out = out + chr(e)
            elif e == 117:          # \uXXXX
                if i + 4 >= len(t):
                    return Err("short \\u escape")
                cp := 0
                for k := 0; k < 4; k += 1:
                    d := _hex_digit(t[i + 1 + k])
                    if d < 0:
                        return Err("bad \\u escape")
                    cp = cp * 16 + d
                if cp >= 55296 and cp <= 57343:
                    return Err("surrogate code point in \\u escape")
                out = out + utf8.encode(cp)
                i = i + 4
            else:
                return Err("unsupported escape \\" + chr(e))
        else:
            out = out + chr(c)
        i = i + 1
    return Err("unterminated basic string")

fn _hex_digit(c: int) -> int:
    if c >= 48 and c <= 57:
        return c - 48
    if c >= 97 and c <= 102:
        return c - 97 + 10
    if c >= 65 and c <= 70:
        return c - 65 + 10
    return -1

const TOML_INT_MIN = (0 - 9223372036854775807) - 1

fn _parse_number(t: string) -> Result(Value, string):
    neg := false
    i := 0
    if t[0] == 43:
        i = 1
    elif t[0] == 45:
        neg = true
        i = 1
    if i < len(t) and t[i] == 48 and i + 1 < len(t) and (t[i + 1] == 120 or t[i + 1] == 88 or t[i + 1] == 111 or t[i + 1] == 79 or t[i + 1] == 98 or t[i + 1] == 66):
        base := 16
        if t[i + 1] == 111 or t[i + 1] == 79:
            base = 8
        elif t[i + 1] == 98 or t[i + 1] == 66:
            base = 2
        if not _underscores_ok(t, i + 2, base):
            return Err("bad number: " + t)
        v := 0
        seen := false
        j := i + 2
        for j < len(t):
            if t[j] == 95:
                j = j + 1
                continue
            d := -1
            if base == 16:
                d = _hex_digit(t[j])
            elif base == 8:
                if t[j] >= 48 and t[j] <= 55:
                    d = t[j] - 48
            else:
                if t[j] == 48 or t[j] == 49:
                    d = t[j] - 48
            if d < 0:
                return Err("bad base-" + str(base) + " integer: " + t)
            # Accumulate NEGATIVE so INT_MIN is reachable, and refuse rather than
            # wrap -- `0xFFFFFFFFFFFFFFFFFF` read back as -1 before this. Same
            # guard as strings.parse_int, generalised to the base.
            if v < (TOML_INT_MIN + d) / base:
                return Err("integer out of range: " + t)
            v = v * base - d
            seen = true
            j = j + 1
        if not seen:
            return Err("empty base-" + str(base) + " integer")
        if neg:
            return Ok(TInt(v))
        if v == TOML_INT_MIN:
            return Err("integer out of range: " + t)
        return Ok(TInt(0 - v))
    # decimal int or float: fold with float arithmetic when a '.' or exponent
    # appears, else exact int arithmetic.
    is_float := false
    for k := i; k < len(t); k += 1:
        c := t[k]
        if c == 46 or c == 101 or c == 69:
            is_float = true
            break
        if (c < 48 or c > 57) and c != 95:
            return Err("bad number: " + t)
    # Both remaining shapes go through strings' checked parsers rather than a
    # third hand-rolled accumulator. The hand-rolled float loop built the
    # exponent digit by digit and then multiplied by 10.0 that many times, so
    # `1e99999999999` looped ~10^11 times (a hang, not an answer) and `1e400`
    # came back as infinity; the hand-rolled int wrapped silently.
    if not _underscores_ok(t, i, 10):
        return Err("bad number: " + t)
    clean := _strip_underscores(t)
    if is_float:
        match strings.parse_float(clean):
            Ok(v):
                return Ok(TFloat(v))
            Err(strings.Overflow):
                return Err("float out of range: " + t)
            Err(strings.Underflow):
                return Err("float underflows to zero: " + t)
            Err(e):
                return Err("bad float: " + t)
    if len(clean) > 0 and clean[0] == 43:      # parse_int takes '-' only
        clean = clean[1:len(clean)]
    match strings.parse_int(clean):
        Ok(iv):
            return Ok(TInt(iv))
        Err(strings.OutOfRange):
            return Err("integer out of range: " + t)
        Err(e2):
            return Err("bad number: " + t)

fn _digit_ok(c: int, base: int) -> bool:
    if base == 16:
        return _hex_digit(c) >= 0
    if base == 8:
        return c >= 48 and c <= 55
    if base == 2:
        return c == 48 or c == 49
    return c >= 48 and c <= 57

# TOML allows `_` only BETWEEN digits. strip_underscores dropped one anywhere,
# so `1__0`, `_1` and `1_` read back as 10, 1 and 1 -- a wrong answer, not a
# refusal. `from` is the first digit position (past any sign or base prefix).
fn _underscores_ok(t: string, from: int, base: int) -> bool:
    for i := from; i < len(t); i += 1:
        if t[i] != 95:
            continue
        if i == from or i + 1 >= len(t):
            return false
        if not _digit_ok(t[i - 1], base) or not _digit_ok(t[i + 1], base):
            return false
    return true

fn _strip_underscores(t: string) -> string:
    out := ""
    for i := 0; i < len(t); i += 1:
        if t[i] != 95:
            out = out + chr(t[i])
    return out

# Split an array body on the commas that SEPARATE ELEMENTS -- not the ones inside
# a nested array or a quoted string. `split(body, ",")` did neither, so
# `[1, [2, 3]]` came apart into `[1`, `[2` and `3]` ("bad number: 3]") and
# `["x,y"]` into `["x` and `y"]` ("unterminated basic string"). Both are valid
# TOML and both were refused; `[[1],[2]]` worked only because no comma fell
# inside an element.
fn _split_items(body: string) -> [string]:
    out := []string
    depth := 0
    instr := false
    quote := 0
    start := 0
    for i := 0; i < len(body); i += 1:
        c := body[i]
        if instr:
            if c == 92 and quote == 34:        # a backslash escape, basic strings only
                i = i + 1
            elif c == quote:
                instr = false
        elif c == 34 or c == 39:
            instr = true
            quote = c
        elif c == 91:
            depth = depth + 1
        elif c == 93:
            depth = depth - 1
        elif c == 44 and depth == 0:
            push(out, body[start:i])
            start = i + 1
    push(out, body[start:len(body)])
    return out

fn _parse_array(t: string, depth: int) -> Result(Value, string):
    # The terminator is CHECKED, like the literal-string branch in parse_value.
    # Without this, `[1, 2` had its last byte stripped as if it were the `]`,
    # leaving `1,`, and the array came back as [1] -- an element silently lost.
    if len(t) < 2 or t[len(t) - 1] != 93:
        return Err("unterminated array: " + t)
    body := strings.trim(t[1:len(t) - 1])
    if body == "":
        return Ok(TArr([]Value))
    if body[len(body) - 1] == 44:      # trailing comma
        body = strings.trim(body[0:len(body) - 1])
    items := _split_items(body)
    arr := []Value
    for it in items:
        it2 := strings.trim(it)
        if it2 == "":
            return Err("empty array element")
        v := _parse_value_depth(it2, depth + 1) or_return
        push(arr, v)
    return Ok(TArr(arr))

# --- the document parser ----------------------------------------------------

# Index of the first `target` byte that is OUTSIDE a quoted string, or -1.
# The single `instr` toggle this replaces flipped on EITHER quote character and
# ignored escapes, so `x = 'it"s' # c` looked like an open string at the `#` and
# the comment was kept -- valid TOML, refused. Same state machine as
# split_items: a string closes only on its OWN quote, and a backslash escape is
# skipped inside a basic string.
fn _find_outside_quotes(ln: string, target: int) -> int:
    instr := false
    quote := 0
    for i := 0; i < len(ln); i += 1:
        c := ln[i]
        if instr:
            if c == 92 and quote == 34:
                i = i + 1
            elif c == quote:
                instr = false
        elif c == 34 or c == 39:
            instr = true
            quote = c
        elif c == target:
            return i
    return -1

fn _strip_comment(ln: string) -> string:   # drop an unquoted # ... comment
    p := _find_outside_quotes(ln, 35)
    if p < 0:
        return ln
    return ln[0:p]

fn _split_dotted(s: string) -> Result([string], string):
    out := []string
    start := 0
    quote := 0
    i := 0
    for i < len(s):
        c := s[i]
        if quote != 0:
            if c == 92 and quote == 34:
                i += 1
            elif c == quote:
                quote = 0
        elif c == 34 or c == 39:
            quote = c
        elif c == 46:
            part := strings.trim(s[start:i])
            if part == "":
                return Err("empty dotted-key segment")
            push(out, part)
            start = i + 1
        i += 1
    if quote != 0:
        return Err("unterminated quoted key")
    part := strings.trim(s[start:len(s)])
    if part == "":
        return Err("empty dotted-key segment")
    push(out, part)
    return Ok(out)

fn _find_key_eq(ln: string) -> int:        # index of the separator '=' outside quotes
    return _find_outside_quotes(ln, 61)

fn _parse_key(key: string) -> Result([string], string):
    parts := _split_dotted(key) or_return
    out := []string
    for p in parts:
        p2 := strings.trim(p)
        if len(p2) == 0:
            return Err("empty key segment")
        if p2[0] == 34:
            if len(p2) < 2 or p2[len(p2) - 1] != 34:
                return Err("unterminated quoted key: " + p2)
            parsed := _parse_basic(p2) or_return
            match parsed:
                TStr(s): push(out, s)
                _: return Err("invalid basic key")
        elif p2[0] == 39:
            if len(p2) < 2 or p2[len(p2) - 1] != 39:
                return Err("unterminated literal key: " + p2)
            push(out, p2[1:len(p2) - 1])
        else:
            for i := 0; i < len(p2); i += 1:
                c := p2[i]
                if not ((c >= 65 and c <= 90) or (c >= 97 and c <= 122) or
                        (c >= 48 and c <= 57) or c == 95 or c == 45):
                    return Err("invalid bare key: " + p2)
            push(out, p2)
    return Ok(out)

# Retained as a public compatibility helper; parser internals use the checked
# Result-returning form above so malformed paths can be reported.
fn split_path(body: string) -> [string]:
    match _parse_key(body):
        Ok(parts): return parts
        Err(_): return []string
    return []string

fn parse(s: string) -> Result(Value, string):
    if len(s) > TOML_MAX_INPUT:
        return Err("TOML document exceeds " + str(TOML_MAX_INPUT) + " bytes")
    ls := strings.lines(s)
    root := TTable([]string, []Value)
    cur := TTable([]string, []Value)
    cur_path := []string            # where cur lives under root (empty = root)
    cur_arr := false                # is cur's section a [[array-of-tables]]?
    cur_dirty := false              # has the current section been written to?
    seen := []string
    entries := 0
    for i := 0; i < len(ls); i += 1:
        ln := ls[i]
        ln = _strip_comment(ln)
        ln = strings.trim(ln)
        if ln == "":
            continue
        if ln[0] == 91:             # '[' a header
            is_arr := len(ln) >= 2 and ln[1] == 91
            # The header's CLOSE is checked, like parse_array's. Without this
            # `[ab` had its last byte sliced off as if it were the `]` and
            # became table `a` -- a section silently renamed.
            body := ln
            if is_arr:
                if len(ln) < 5 or ln[len(ln) - 1] != 93 or ln[len(ln) - 2] != 93:
                    return Err("unterminated table header: " + ln)
                body = ln[2:len(ln) - 2]
            else:
                if len(ln) < 3 or ln[len(ln) - 1] != 93:
                    return Err("unterminated table header: " + ln)
                body = ln[1:len(ln) - 1]
            path := _parse_key(body) or_return
            if len(path) == 0:
                return Err("empty table header")
            if len(path) > TOML_MAX_NESTING:
                return Err("TOML table nesting exceeds " + str(TOML_MAX_NESTING))
            entries += 1
            if entries > TOML_MAX_ENTRIES:
                return Err("TOML entry count exceeds " + str(TOML_MAX_ENTRIES))
            if is_arr == false:
                jp := ""
                for pi := 0; pi < len(path); pi += 1:
                    jp = jp + str(len(path[pi])) + ":" + path[pi] + ";"
                if index_of(seen, jp) >= 0:
                    return Err("duplicate table header: [" + body + "]")
                push(seen, jp)
            if len(cur_path) > 0 or cur_dirty:
                if len(cur_path) == 0:
                    root = cur                       # root-level section: cur IS the root
                else:
                    root = _place(root, cur_path, cur, cur_arr) or_return
            cur = TTable([]string, []Value)
            cur_path = path
            cur_arr = is_arr
            cur_dirty = false
            continue
        eq := _find_key_eq(ln)
        if eq < 0:
            return Err("expected 'key = value' or a [header], got: " + ln)
        key := strings.trim(ln[0:eq])
        val := strings.trim(ln[eq + 1:])
        kp := _parse_key(key) or_return
        if len(kp) == 0:
            return Err("empty key in: " + ln)
        if len(kp) > TOML_MAX_NESTING:
            return Err("TOML key nesting exceeds " + str(TOML_MAX_NESTING))
        entries += 1
        if entries > TOML_MAX_ENTRIES:
            return Err("TOML entry count exceeds " + str(TOML_MAX_ENTRIES))
        # TOML forbids redefining a key. Accepting it silently meant a later
        # line overrode an earlier one with no diagnostic -- in a config file
        # that is an override nobody can see. The check used to look at
        # single-segment keys ONLY, so `a.b = 1` then `a.b = 2` still overrode.
        if _has_path(cur, kp):
            return Err("duplicate key: " + key)
        v := _parse_value(val) or_return
        cur = _assign(cur, kp, v)
        cur_dirty = true
    if len(cur_path) == 0:
        root = cur
    else:
        root = _place(root, cur_path, cur, cur_arr) or_return
    return Ok(root)
