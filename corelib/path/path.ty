package path

# Index of the last '/' in s, or -1 if there is none.
fn last_slash(s: string) -> int:
    i := len(s) - 1
    for i >= 0:
        if s[i] == 47:                        # '/'
            return i
        i = i - 1
    return 0 - 1

# True if the path is absolute (begins with '/').
fn is_abs(p: string) -> bool:
    return len(p) > 0 and p[0] == 47

# Final path element, trailing slashes ignored.
#   ""        -> "."      "/"        -> "/"     "file.txt" -> "file.txt"
#   "/a/b/c"  -> "c"      "/a/b/c/"  -> "c"     "a/b/"     -> "b"
fn base(p: string) -> string:
    if len(p) == 0:
        return "."
    e := len(p)                               # strip trailing slashes
    for e > 0 and p[e - 1] == 47:
        e = e - 1
    if e == 0:
        return "/"                            # the path was all slashes
    s := e                                    # walk back to the slash before e
    for s > 0 and p[s - 1] != 47:
        s = s - 1
    return p[s:e]

# Everything but the final element, trailing slashes ignored.
#   ""        -> "."      "foo"      -> "."     "/foo"     -> "/"
#   "/a/b/c"  -> "/a/b"   "/a/b/c/"  -> "/a/b"  "a/b"      -> "a"
fn dir(p: string) -> string:
    e := len(p)                               # strip trailing slashes (mirror base)
    for e > 0 and p[e - 1] == 47:
        e = e - 1
    if e == 0:
        if len(p) > 0:
            return "/"                        # the path was all slashes
        return "."                            # the path was empty
    i := e                                    # i = one past the last slash in [0, e)
    for i > 0 and p[i - 1] != 47:
        i = i - 1
    if i == 0:
        return "."                            # no directory component
    d := i - 1                                # drop the slash, then its run
    for d > 0 and p[d - 1] == 47:
        d = d - 1
    if d == 0:
        return "/"
    return p[0:d]

# Extension of the final element, INCLUDING the dot, or "" if none. A leading
# dot is not an extension (dotfiles).  "a.txt"->".txt"  ".bashrc"->""
#   "archive.tar.gz" -> ".gz"   "noext" -> ""   "/a/b.c/d" -> ""
fn ext(p: string) -> string:
    b := base(p)
    i := len(b) - 1
    for i > 0:                                # i > 0: a leading dot is not an ext
        if b[i] == 46:                        # '.'
            return b[i:len(b)]
        i = i - 1
    return ""

# The final element without its extension.  "a.txt"->"a"  ".bashrc"->".bashrc"
fn stem(p: string) -> string:
    b := base(p)
    e := ext(p)
    return b[0:len(b) - len(e)]

# Join two segments with exactly one '/'. Empty operands drop out.
#   ("a","b")->"a/b"  ("a/","b")->"a/b"  ("a","/b")->"a/b"  ("/","x")->"/x"
fn join(a: string, b: string) -> string:
    if len(a) == 0:
        return b
    if len(b) == 0:
        return a
    ae := len(a)                              # strip trailing slashes of a
    for ae > 0 and a[ae - 1] == 47:
        ae = ae - 1
    bs := 0                                   # strip leading slashes of b
    for bs < len(b) and b[bs] == 47:
        bs = bs + 1
    return a[0:ae] + "/" + b[bs:len(b)]

# Split into (dir, base) -- the pieces path.join would recombine.
fn split_path(p: string) -> (string, string):
    return (dir(p), base(p))

# Lexically normalize: collapse repeated slashes, drop "." segments, resolve
# ".." against the preceding real segment (but never above the root, and never
# past a leading ".." in a relative path). Pure string math -- no filesystem.
#   "a/./b/../c" -> "a/c"   "/a//b/" -> "/a/b"   "/.." -> "/"
#   "" -> "."   "." -> "."   "../a" -> "../a"
fn clean(p: string) -> string:
    if len(p) == 0:
        return "."
    rooted := p[0] == 47
    parts := split(p, "/")
    out := []string                           # stack of kept segments
    for i := 0; i < len(parts); i += 1:
        seg := parts[i]
        if seg == "..":
            if len(out) > 0 and out[len(out) - 1] != "..":
                pop(out)                       # pop the real segment ".." cancels
            elif not rooted:
                push(out, "..")                # relative: keep a leading ".."
            # rooted with nothing to pop: ".." at the root is a no-op
        elif len(seg) > 0 and seg != ".":
            push(out, seg)                     # skip "" (// ) and "."
    r := ""
    for j := 0; j < len(out); j += 1:
        if j > 0:
            r = r + "/"
        r = r + out[j]
    if rooted:
        r = "/" + r
    if len(r) == 0:
        return "."
    return r

# Safely join an UNTRUSTED relative segment `rel` under a trusted `base`.
# Returns the cleaned joined path when `rel` stays within `base`, or "" when
# `rel` is absolute or escapes `base` via "..". Use this for any path built
# from external input (request params, upload names):
#   safe_join("/srv/data", "user/report.txt") -> "/srv/data/user/report.txt"
#   safe_join("/srv/data", "../../etc/passwd") -> ""
#   safe_join("/srv/data", "/etc/passwd")      -> ""
#   safe_join("/srv/data", "..\\etc\\passwd")  -> ""   (backslash: see below)
# Fail-closed: callers MUST treat "" as rejected before using the path. The
# escape test is base-independent -- clean() leaves a leading ".." exactly
# when the relative path climbs above its own start.
#
# DESIGN CHOICE, backslash: `clean` stays POSIX-only -- `\` is a LEGAL byte in a
# POSIX filename, and rewriting it to "/" there would silently open a different
# file than the caller named. But `..\` IS a parent reference on the Windows
# target this repo ships (server/winsignal.c, `make wine-ubsan`), so safe_join
# REFUSES any `rel` carrying a backslash or a `X:` drive prefix rather than
# interpreting it. Refusing is correct on both platforms: on Windows it closes
# the traversal, on POSIX it costs only an exotic filename that no caller of an
# untrusted-input guard should be accepting anyway. The answer must NOT vary by
# build -- a security rule that differs per target is one nobody can reason about.
fn safe_join(base: string, rel: string) -> string:
    if is_abs(rel):
        return ""
    for i := 0; i < len(rel); i += 1:
        if rel[i] == 92:                       # '\' -- never interpreted, always refused
            return ""
    if len(rel) >= 2 and rel[1] == 58:         # "X:" drive prefix, absolute on Windows
        return ""
    cr := clean(rel)
    if cr == "..":
        return ""
    if len(cr) >= 3 and cr[0] == 46 and cr[1] == 46 and cr[2] == 47:   # "../"
        return ""
    return clean(join(base, rel))

# ---- the filesystem fence --------------------------------------------------
#
# Everything above this line is string math and answers the same on every host.
# These two are the exception, and they exist because a lexical fence CANNOT SEE
# A SYMLINK: `safe_join("/srv/www", "link.txt")` is a perfectly contained answer
# whether or not `link.txt` points at /etc/passwd. A static server built on
# safe_join alone served the target of such a link with 200 -- measured, not
# supposed. So the containment test has to be applied to what the path RESOLVES
# TO, which takes a real syscall.

# realpath(3): the absolute path with every symlink and ".." resolved, or "" if
# the path does not exist, cannot be read, or does not fit. Fail-closed.
extern fn pathx_real(p: string) -> string

fn real(p: string) -> string:
    for i := 0; i < len(p); i += 1:
        if p[i] == 0:
            return ""                          # a NUL truncates the C string
    return pathx_real(p)

# True when `p` IS `root` or lies underneath it. Both must already be resolved:
# this is the comparison, not the resolution.
fn under(root: string, p: string) -> bool:
    if root == "" or p == "":
        return false
    if p == root:
        return true
    if len(p) <= len(root):
        return false
    return p[0:len(root)] == root and (p[len(root)] == 47 or root[len(root) - 1] == 47)

# Resolve an UNTRUSTED relative `rel` under a trusted `base` and prove the ANSWER
# is inside `base`. Returns the path to use, or "" when `rel` is refused.
#
#   resolve_under("/srv/www", "a/b.txt")   -> "/srv/www/a/b.txt" (resolved)
#   resolve_under("/srv/www", "../etc")    -> ""   (lexical, safe_join)
#   resolve_under("/srv/www", "link.txt")  -> ""   if link.txt leaves the root
#   resolve_under("/srv/www", "link.txt")  -> the target, if it stays inside
#
# A path that does not exist is NOT a refusal: the longest existing ancestor is
# resolved instead and checked, and the lexical join comes back so the caller can
# report its own "not found" rather than a spurious "forbidden". Nothing can
# escape through a component that is not there -- there is no symlink to follow.
#
# RESIDUAL RACE, stated rather than hidden: between this check and the caller's
# open(2) an attacker WITH WRITE ACCESS INSIDE the root could replace a resolved
# component with a symlink. Closing that needs the open itself to be done here,
# with O_NOFOLLOW per component. This narrows an unconditional escape to a race
# an outside attacker cannot reach; it does not remove it.
fn resolve_under(base: string, rel: string) -> string:
    j := safe_join(base, rel)
    if j == "":
        return ""
    rb := real(base)
    if rb == "":
        return ""                              # no usable root: refuse everything
    p := j
    for len(p) > 0:
        rp := real(p)
        if rp != "":
            if not under(rb, rp):
                return ""                      # resolved outside the root
            if p == j:
                return rp                      # fully resolved: hand back the real path
            return j                           # a missing leaf under a real ancestor
        up := dir(p)
        if up == p:
            return ""                          # walked off the top without a hit
        p = up
    return ""
