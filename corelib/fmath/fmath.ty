# corelib: float math. Import with `import "core:fmath"`. The scalar comparators
# (min/max/clamp/sign) are generic in core:math now; these are the float-specific
# pieces. sqrt/pow/floor/fabs are float builtins, so these build on them. No trig
# (the language has no libm sin/cos builtin).
package fmath

fn pi() -> float:
    return 3.141592653589793

fn e() -> float:
    return 2.718281828459045

fn trunc(x: float) -> float:                 # toward zero
    if x < 0.0:
        return 0.0 - floor(0.0 - x)
    return floor(x)

# Round half away from zero. Decided by the FRACTION, never by `floor(x + 0.5)`:
# that addition rounds before floor ever runs, and it was wrong twice --
# round(0.49999999999999994) gave 1.0 for a value strictly BELOW a half, and
# round(2^52+1) moved an input that was already an exact integer (2026-08-15).
# `x - trunc(x)` is exact for every finite x, and `t + 1.0` is reached only when
# x is not an integer, so |x| < 2^52 there and it cannot overflow. An infinity
# and a NaN both make the fraction NaN, fail both tests and return trunc's answer,
# which is themselves.
fn round(x: float) -> float:
    t := trunc(x)
    d := x - t
    if d >= 0.5:
        return t + 1.0
    if d <= 0.0 - 0.5:
        return t - 1.0
    return t

# Linear interpolation, t in [0,1]. The ENDPOINTS are exact and are special-cased
# to make them so: `a + (b - a) * t` loses them when a and b are far apart, and it
# is not a rounding wobble -- lerp(1e308, 1.0, 1.0) returned 0.0, because
# 1.0 - 1e308 IS -1e308 and the b is gone before t is applied (2026-08-15). The
# same subtraction makes t=0 return NaN when b - a overflows to an infinity.
fn lerp(a: float, b: float, t: float) -> float:
    if t == 0.0:
        return a
    if t == 1.0:
        return b
    return a + (b - a) * t

fn approx_eq(a: float, b: float, eps: float) -> bool:
    return fabs(a - b) <= eps
