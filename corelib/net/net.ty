package net

# Why a socket call failed. Every variant is payload-free so `==` works on it.
enum NetErr:
    Eof                # the peer closed the connection cleanly (recv == 0)
    Timeout            # the SO_RCVTIMEO deadline expired with no data
    Failed             # the syscall failed (bad fd, refused, reset, ...)
    BadAddr            # `host` holds an interior NUL -- see has_nul. NOT Failed:
                       # no syscall was made, so retrying cannot help.

fn has_nul(host: string) -> bool:
    for i := 0; i < len(host); i += 1:
        if host[i] == 0:
            return true
    return false

# ---- shim externs (libc sockets; defined in net_shim.c) ----
# The `netx_` prefix keeps these off the real libc socket symbols (listen/connect
# /accept are libc names), so each binds to the shim, not the kernel wrapper.
extern fn netx_listen(host: string, port: int) -> int
extern fn netx_accept(fd: int) -> int
extern fn netx_connect(host: string, port: int) -> int
extern fn netx_port_of(fd: int) -> int
extern fn netx_peer_addr(fd: int) -> string
extern fn netx_write(fd: int, data: bytes) -> int
# `status` is the recv classification: 0 EOF, 1 data, 2 timeout, 3 error. It is an
# `inout int`, which lowers to a tycho_int* out-param ahead of the two out-params
# the `bytes` return uses -- see the block comment on netx_read in net_shim.c.
extern fn netx_read(fd: int, max: int, status: inout int) -> bytes
extern fn netx_set_read_timeout(fd: int, ms: int) -> int
extern fn netx_close(fd: int)
extern fn netx_udp_bind(host: string, port: int) -> int
extern fn netx_udp_send(fd: int, host: string, port: int, data: bytes) -> int
extern fn netx_udp_read(fd: int, max: int) -> bytes

# The shim's read-status codes, named once so net.read reads as prose.
const RD_EOF  = 0
const RD_DATA = 1
const RD_TMO  = 2

# ---- TCP ----
fn listen(host: string, port: int) -> Result(int, NetErr):
    if has_nul(host):
        return Err(BadAddr)
    fd := netx_listen(host, port)
    if fd < 0:
        return Err(Failed)
    return Ok(fd)

fn accept(fd: int) -> Result(int, NetErr):
    c := netx_accept(fd)
    if c < 0:
        return Err(Failed)
    return Ok(c)

fn connect(host: string, port: int) -> Result(int, NetErr):
    if has_nul(host):
        return Err(BadAddr)
    fd := netx_connect(host, port)
    if fd < 0:
        return Err(Failed)
    return Ok(fd)

fn port_of(fd: int) -> Result(int, NetErr):
    p := netx_port_of(fd)
    if p < 0:
        return Err(Failed)
    return Ok(p)

# The peer's address as text. Ok("127.0.0.1"); Err(Failed) if the fd is not a
# connected socket, or its address family is one the shim does not render. The
# empty string is never an Ok value -- an access log that cannot name the client
# should say so, not print a blank column.
fn peer_addr(fd: int) -> Result(string, NetErr):
    a := netx_peer_addr(fd)
    if a == "":
        return Err(Failed)
    return Ok(a)

# Send the whole buffer. Ok(n) with n == len(data); the shim loops over short
# writes, so a partial send is reported as a failure rather than a smaller n.
fn write(fd: int, data: bytes) -> Result(int, NetErr):
    n := netx_write(fd, data)
    if n < 0:
        return Err(Failed)
    return Ok(n)

fn read(fd: int, max: int) -> Result(bytes, NetErr):
    st := 0
    b := netx_read(fd, max, &st)
    if st == RD_DATA:
        return Ok(b)
    if st == RD_EOF:
        return Err(Eof)
    if st == RD_TMO:
        return Err(Timeout)
    return Err(Failed)

# Arm a receive timeout on `fd`: after `ms` idle milliseconds a read yields
# Err(Timeout), which is now distinct from Err(Eof). `ms <= 0` restores the
# blocking default. Returns false if the socket option could not be set (fail
# closed: the socket keeps blocking).
fn set_read_timeout_ms(fd: int, ms: int) -> bool:
    return netx_set_read_timeout(fd, ms) == 1

fn close_fd(fd: int):
    netx_close(fd)

fn udp_bind(host: string, port: int) -> int:
    if has_nul(host):
        return -1
    return netx_udp_bind(host, port)

fn udp_send(fd: int, host: string, port: int, data: bytes) -> int:
    if has_nul(host):
        return -1
    return netx_udp_send(fd, host, port, data)

fn udp_read(fd: int, max: int) -> bytes:
    return netx_udp_read(fd, max)

# Wait at most `ms` for one connection. Timeout is not a listener failure.
# Existing accept() stays blocking; servers that need bounded shutdown use this.
extern fn netx_accept_wait(fd: int, ms: int) -> int
fn accept_wait(fd: int, ms: int) -> Result(int, NetErr):
    conn := netx_accept_wait(fd, ms)
    if conn == -2:
        return Err(Timeout)
    if conn < 0:
        return Err(Failed)
    return Ok(conn)

# ---- readiness over a set of descriptors ----
# The shim's poll classification, named once the way RD_* above is.
const PL_READY = 0
const PL_TMO   = 1

extern fn netx_poll_readable(fds: [int], ms: int, status: inout int) -> [int]

# Which of `fds` can be read without blocking right now, waiting at most `ms`
# milliseconds for the first one. Ok(ready) is the SUBSET of `fds` that are
# readable, in the order they were given -- never the whole set, and never empty.
# A peer that closed is READY, not absent: the following net.read answers Eof,
# which is what a caller needs to retire the connection.
#
# Err(Timeout) means the deadline passed with none ready. That is an answer, not
# a failure -- accept_wait draws the same line.
# Err(Failed) covers a caller bug as well as a syscall failure: an empty set, a
# negative fd anywhere in it, or a negative `ms`. Reporting those as Timeout
# would turn each into a silent spin.
#
# poll(2) underneath, not select(2): select cannot represent a descriptor at or
# above 1024 at all, and a set of descriptors is exactly where that bites.
fn wait_readable(fds: [int], ms: int) -> Result([int], NetErr):
    st := 0
    ready := netx_poll_readable(fds, ms, &st)
    if st == PL_READY:
        return Ok(ready)
    if st == PL_TMO:
        return Err(Timeout)
    return Err(Failed)
