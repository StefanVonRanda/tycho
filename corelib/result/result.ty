# corelib: the collapses every `Result` / `Option` caller was writing by hand.
# Import with `import "core:result"`.
#
# WHY THIS EXISTS. `or_return` unwraps a Result only inside a function that
# returns a compatible Result (`docs/spec/10-statements.md:75`). A `main()`, a
# request handler returning a Response, or any function that owns a real return
# type cannot use it, and before this package the only remaining tool was a
# three-line `match` -- written once per call site. docs/internals/plan-option-result-DONE.md phase 1 measured that
# duplication as the single largest cost of adopting Result at all:
# server/main.ty had one copy, corelib/test/net and corelib/test/httpd had two
# more, and each was the same four lines.
#
#   n := result.unwrap_or(httpd.write_response(conn, r), -1)   # 1 line
#
#   # what that replaced, per call site:
#   fn nwrote(w: Result(int, net.NetErr)) -> int:
#       match w:
#           Ok(n): return n
#           Err(e): return -1
#
# WHY `==` AND NOT A PATTERN. As of 2026-07-26 (docs/internals/plan-friction-DONE.md phase 3) Tycho DOES have
# nested patterns, so `Err(net.Timeout):` is a legal match arm and is the clearer
# spelling when the caller is already writing a `match`. `err_or` + `==` stays the
# idiom for the caller who is NOT -- a one-line test inside an `if`, with no arm
# for the Ok case it does not care about:
#
#   if result.err_or(net.read(fd, 4096), net.Timeout) == net.Timeout:
#
# It also keeps working where a nested pattern cannot: this package is compiled by
# the frozen compiler/tychoc0.ty (examples/webserver/run.sh), whose grammar has no
# nested pattern, so nothing in `corelib/` may use one.
#
# HISTORICAL CAVEAT, FIXED 2026-07-26 (docs/internals/plan-friction-DONE.md phase 1). A qualified name written
# anywhere in a generic call's argument list used to fail to resolve, so every
# call site in this tree bound the value to a local first:
#
#   result.unwrap_or(net.port_of(fd), -1)     # was: package 'net' has no symbol
#                                             #      'net__port_of'
#   result.err_or(r, net.Failed)              # was: unknown variable 'net'
#   result.unwrap_or(r, httpd.bad_request())  # was: package 'httpd' has no symbol
#                                             #      'httpd__bad_request'
#
# The cause was not generics losing the qualifier. Resolution is not single-pass:
# instantiate_generic resolves every argument once to infer `$T`, then the
# concrete-signature loop resolves the SAME node again -- and the
# `pkg.name` -> `pkg__name` rewrite mutated the node in place without being
# idempotent (the doubled prefix in the old error text was the tell). The generic
# struct and generic enum literal paths resolved their arguments twice for the
# same reason, so `Box(net.Failed)` failed identically. All three spellings above
# now compile; `tests/pkg/generic_qual_arg` is the regression.
#
# Everything here is generic over `$T` / `$E` (and `$F`, the second error type
# map_err re-labels to) and total: no aborts, no panics, no allocation. There is
# nothing to import and no shim.
package result

# The Ok payload, or `fallback` if the Result is an Err. The workhorse: it turns
# a Result back into the plain value a non-Result caller needs, in one line.
fn unwrap_or(r: Result($T, $E), fallback: $T) -> $T:
    match r:
        Ok(v): return v
        Err(e): return fallback

# True if the Result is Ok. Use it when only success/failure matters and the
# payload does not -- `if not result.is_ok(pr)` in place of a sentinel test.
fn is_ok(r: Result($T, $E)) -> bool:
    match r:
        Ok(v): return true
        Err(e): return false

fn is_err(r: Result($T, $E)) -> bool:
    match r:
        Ok(v): return false
        Err(e): return true

# The Err payload, or `fallback` if the Result is Ok. This is how a caller asks
# WHICH failure happened without writing a `match` at all: compare the answer with
# `==` against a payload-free variant. (A caller who IS writing a match should use
# a nested pattern -- `Err(net.Timeout):` -- see the header.) `fallback` may be
# written inline as a qualified variant (`net.Failed`) -- see the HISTORICAL
# CAVEAT in the header.
fn err_or(r: Result($T, $E), fallback: $E) -> $E:
    match r:
        Ok(v): return fallback
        Err(e): return e

# Re-label a Result's error type, so `or_return` works across a package boundary.
# The Ok payload passes through untouched; an Err becomes `replacement`.
#
# WHY THIS EXISTS. `or_return` only short-circuits out of a function whose OWN
# Result has a compatible error type, so a function that calls two packages' fallible
# functions gets `or_return` for whichever error type it adopted and a hand-written
# collapse for the other. examples/corelib/httpd/main.ty's `round_trip` is the
# recorded case (FRICTION.md:152): it returns Result(int, net.NetErr), seven net.*
# calls short-circuit through it, and the one httpd.read_request in the middle
# returns Result(Request, httpd.ReqErr) and had to be collapsed to a dummy Request
# with unwrap_or -- which throws the failure away and carries on with a request
# nobody sent. One map_err makes it an early return instead:
#
#   req := result.map_err(httpd.read_request(fd), net.Failed) or_return
#
# WHY A VALUE AND NOT A FUNCTION. Rust's map_err takes a closure; the function-value
# form does compile here (measured, docs/internals/plan-friction-DONE.md phase 9: `fn map_err(r: Result($T, $E),
# f: fn($E) -> $F) -> Result($T, $F)` with `Err(e): return Err(f(e))` builds and
# runs), and it was still not the one adopted. The caller who needs it has ONE
# target variant in mind, so the function form would cost every call site a named
# two-line helper to convert an enum -- which is the hand-written collapse this
# entry exists to delete. A fixed replacement matches the rest of this package,
# where unwrap_or/err_or/some_or all take a plain fallback and nothing allocates.
# A caller who genuinely wants per-cause mapping writes the match; it is three lines
# and it is clearer than a helper plus a combinator.
#
# WHAT IT COSTS THE CALLER, stated plainly: the original cause is gone. `map_err`
# says "this failure is now MY error type's failure", so use it where the caller's
# own enum already has a variant that means what happened (net.Failed for "the
# exchange broke"). Where the distinction matters, match on the real error instead.
fn map_err(r: Result($T, $E), replacement: $F) -> Result($T, $F):
    match r:
        Ok(v): return Ok(v)
        Err(e): return Err(replacement)

# ---- Option ----------------------------------------------------------------
# The same collapse for the Option half. io.read_line is the corelib's one
# Option-returning function; a caller that treats EOF as an empty line wants
# some_or, not a match.

fn some_or(o: Option($T), fallback: $T) -> $T:
    match o:
        Some(v): return v
        None: return fallback

fn is_some(o: Option($T)) -> bool:
    match o:
        Some(v): return true
        None: return false
