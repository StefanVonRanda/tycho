package result

# AT `Result(void, E)`: is_ok/is_err/err_or work (see is_ok). unwrap_or, map_err
# and map_err_with cannot -- each hands the ok payload BACK, and there is no void
# value to hand; both refuse outright, so reach for is_ok/err_or or match inline.

# The Ok payload, or `fallback` if the Result is an Err. The workhorse: it turns
# a Result back into the plain value a non-Result caller needs, in one line.
fn unwrap_or(r: Result($T, $E), fallback: $T) -> $T:
    match r:
        Ok(v): return v
        Err(e): return fallback

# True if the Result is Ok. Use it when only success/failure matters and the
# payload does not -- `if not result.is_ok(pr)` in place of a sentinel test.
# `is` (§19.8), not a `match`: an `Ok(v)` arm is refused at a void ok payload and
# a bare `Ok:` at every other, so a body binding `v` fits no single spelling.
fn is_ok(r: Result($T, $E)) -> bool:
    return r is Ok

fn is_err(r: Result($T, $E)) -> bool:
    return r is Err

# The Err payload, or `fallback` if the Result is Ok. This is how a caller asks
# WHICH failure happened without writing a `match` at all: compare the answer with
# `==` against a payload-free variant. (A caller who IS writing a match should use
# a nested pattern -- `Err(net.Timeout):` -- see the header.) `fallback` may be
# written inline as a qualified variant (`net.Failed`) -- see the HISTORICAL
# CAVEAT in the header.
# The Ok side is `_:` rather than `Ok(v)`, per is_ok: it names no payload.
fn err_or(r: Result($T, $E), fallback: $E) -> $E:
    match r:
        Err(e): return e
        _: return fallback

fn map_err(r: Result($T, $E), replacement: $F) -> Result($T, $F):
    match r:
        Ok(v): return Ok(v)
        Err(e): return Err(replacement)

# map_err's sibling, for when the cause is worth keeping. Same job and the same
# argument order, except `f` RECEIVES the Err payload and builds the replacement
# from it, so `Syntax(7)` arrives as `FromParse(7)` rather than as a constant.
# Reach for it when the cause carries something the caller still needs -- a byte
# offset, a column name; reach for map_err when it does not, which is the common
# case and the whole reason that one takes a plain value (see its header above).
#
#   n := result.map_err_with(parse(s), from_parse) or_return
fn map_err_with(r: Result($T, $E), f: fn($E) -> $F) -> Result($T, $F):
    match r:
        Ok(v): return Ok(v)
        Err(e): return Err(f(e))

# ---- Option ----------------------------------------------------------------
# The same collapse for the Option half. io.read_line is the corelib's one
# Option-returning function; a caller that treats EOF as an empty line wants
# some_or, not a match.

fn some_or(o: Option($T), fallback: $T) -> $T:
    match o:
        Some(v): return v
        None: return fallback

# `is` (§19.8), not a `match`, for the reason is_ok gives: it names no payload.
fn is_some(o: Option($T)) -> bool:
    return o is Some
