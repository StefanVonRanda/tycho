package main
import "core:image"

fn b2i(b: bool) -> int:
    if b:
        return 1
    return 0

fn why(e: image.ImgErr) -> string:
    match e:
        image.Empty: return "Empty"
        image.NotPng: return "NotPng"
        image.Corrupt: return "Corrupt"
        image.BadDims: return "BadDims"
        image.ShortPixels: return "ShortPixels"
        image.Failed: return "Failed"
        image.TooBig: return "TooBig"
    return "?"

# Report a decode that MUST fail: "Ok" here is the regression, not a pass.
fn dec_err(label: string, data: bytes):
    match image.decode(data):
        Ok(img): println(label + "=Ok " + str(img.width) + "x" + str(img.height))
        Err(e): println(label + "=Err(" + why(e) + ")")

fn enc_err(label: string, img: image.Image):
    match image.encode(img):
        Ok(b): println(label + "=Ok len=" + str(len(b)))
        Err(e): println(label + "=Err(" + why(e) + ")")

# First `n` bytes of `b` -- a truncated PNG whose header is intact.
fn cut(b: bytes, n: int) -> bytes:
    s := ""
    i := 0
    for i < n:
        s = s + chr(b[i])
        i = i + 1
    return to_bytes(s)

fn main():
    # build a 3x2 RGBA image (24 bytes): pixel(x,y) = (x*40, y*80, 100, 255)
    px := ""
    y := 0
    for y < 2:
        x := 0
        for x < 3:
            px = px + chr(x * 40) + chr(y * 80) + chr(100) + chr(255)
            x = x + 1
        y = y + 1
    img := image.make(3, 2, to_bytes(px))            # 3*2*4 = 24 pixel bytes

    png := to_bytes("")
    match image.encode(img):
        Ok(b): png = b
        Err(e): println("encode unexpectedly failed: " + why(e))
    println("encoded_ok=" + str(b2i(len(png) > 0)))                              # 1
    println("is_png=" + str(b2i(len(png) >= 8 and png[0] == 137 and png[1] == 80 and png[2] == 78 and png[3] == 71)))   # 1

    match image.decode(png):
        Ok(back):
            println("dims=" + str(back.width) + "x" + str(back.height))                  # 3x2
            println("pixels_match=" + str(b2i(len(back.pixels) == 24 and to_str(back.pixels) == px)))   # 1
        Err(e):
            println("decode unexpectedly failed: " + why(e))

    # ---- the must-fail cases, each asserting WHICH cause ----
    # Truncated past the header: libpng reads IHDR, then runs out of pixel data.
    dec_err("truncated", cut(png, 60))                                           # Err(Corrupt)
    dec_err("garbage", to_bytes("this is definitely not a png file"))            # Err(NotPng)
    dec_err("empty", to_bytes(""))                                               # Err(Empty)
    enc_err("enc_zero", image.make(0, 0, to_bytes("")))                          # Err(BadDims)
    enc_err("enc_short", image.make(10, 10, to_bytes("abc")))                    # Err(ShortPixels)
