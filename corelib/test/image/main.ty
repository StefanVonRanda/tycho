package main
import "core:base64"
import "core:image"
import "core:io"

const JPEG_B64 = ""

fn rgb_at(img: image.Image, x: int, y: int) -> (int, int, int):
    p := (y * img.width + x) * 4
    return (img.pixels[p], img.pixels[p + 1], img.pixels[p + 2])

fn near(r: int, g: int, b: int, rr: int, gg: int, bb: int, tol: int) -> bool:
    dr := r - rr
    if dr < 0:
        dr = 0 - dr
    dg := g - gg
    if dg < 0:
        dg = 0 - dg
    db := b - bb
    if db < 0:
        db = 0 - db
    return dr <= tol and dg <= tol and db <= tol

fn b2i(b: bool) -> int:
    if b:
        return 1
    return 0

fn why(e: image.ImgErr) -> string:
    match e:
        image.Empty: return "Empty"
        image.NotPng: return "NotPng"
        image.Corrupt: return "Corrupt"
        image.BadDims: return "BadDims"
        image.ShortPixels: return "ShortPixels"
        image.Failed: return "Failed"
        image.TooBig: return "TooBig"
        image.NotBng: return "NotBng"
    return "?"

fn load(path: string) -> bytes:
    match io.read_bytes(path):
        Ok(b):
            return b
        Err(_):
            return to_bytes([]int)

fn same_bytes(a: bytes, b: bytes) -> bool:
    if len(a) != len(b):
        return false
    for i := 0; i < len(a); i += 1:
        if a[i] != b[i]:
            return false
    return true

fn premultiply(src: bytes) -> bytes:
    out := []int
    for i := 0; i < len(src); i += 4:
        r := src[i]
        g := src[i + 1]
        b := src[i + 2]
        a := src[i + 3]
        push(out, (r * a + 127) / 255)
        push(out, (g * a + 127) / 255)
        push(out, (b * a + 127) / 255)
        push(out, a)
    return to_bytes(out)

# Report a decode that MUST fail: "Ok" here is the regression, not a pass.
fn dec_err(label: string, data: bytes):
    match image.decode(data):
        Ok(img): println(label + "=Ok " + str(img.width) + "x" + str(img.height))
        Err(e): println(label + "=Err(" + why(e) + ")")

fn enc_err(label: string, img: image.Image):
    match image.encode(img):
        Ok(b): println(label + "=Ok len=" + str(len(b)))
        Err(e): println(label + "=Err(" + why(e) + ")")

# First `n` bytes of `b` -- a truncated PNG whose header is intact.
fn cut(b: bytes, n: int) -> bytes:
    s := ""
    i := 0
    for i < n:
        s = s + chr(b[i])
        i = i + 1
    return to_bytes(s)

fn main():
    # build a 3x2 RGBA image (24 bytes): pixel(x,y) = (x*40, y*80, 100, 255)
    px := ""
    y := 0
    for y < 2:
        x := 0
        for x < 3:
            px = px + chr(x * 40) + chr(y * 80) + chr(100) + chr(255)
            x = x + 1
        y = y + 1
    img := image.make(3, 2, to_bytes(px))            # 3*2*4 = 24 pixel bytes

    png := to_bytes("")
    match image.encode(img):
        Ok(b): png = b
        Err(e): println("encode unexpectedly failed: " + why(e))
    println("encoded_ok=" + str(b2i(len(png) > 0)))                              # 1
    println("is_png=" + str(b2i(len(png) >= 8 and png[0] == 137 and png[1] == 80 and png[2] == 78 and png[3] == 71)))   # 1

    match image.decode(png):
        Ok(back):
            println("dims=" + str(back.width) + "x" + str(back.height))                  # 3x2
            println("pixels_match=" + str(b2i(len(back.pixels) == 24 and to_str(back.pixels) == px)))   # 1
        Err(e):
            println("decode unexpectedly failed: " + why(e))

    # ---- the must-fail cases, each asserting WHICH cause ----
    # Truncated past the header: libpng reads IHDR, then runs out of pixel data.
    dec_err("truncated", cut(png, 60))                                           # Err(Corrupt)
    dec_err("garbage", to_bytes("this is definitely not a png file"))            # Err(NotPng)
    dec_err("empty", to_bytes(""))                                               # Err(Empty)
    enc_err("enc_zero", image.make(0, 0, to_bytes("")))                          # Err(BadDims)
    enc_err("enc_short", image.make(10, 10, to_bytes("abc")))                    # Err(ShortPixels)

    # ---- baseline JPEG decode (vendored stb_image, JPEG only) ----
    jimg := image.make(0, 0, to_bytes([]int))
    jr := image.decode_jpeg(to_bytes(base64.decode(JPEG_B64)))
    match jr:
        Ok(im): jimg = im
        Err(e): println("jpeg failed: " + why(e))
    println("jpeg_dims=" + str(jimg.width) + "x" + str(jimg.height))
    r1, g1, b1 := rgb_at(jimg, 8, 8)
    r2, g2, b2 := rgb_at(jimg, 24, 8)
    r3, g3, b3 := rgb_at(jimg, 8, 24)
    r4, g4, b4 := rgb_at(jimg, 24, 24)
    println("jpeg_colors=" + str(b2i(near(r1, g1, b1, 255, 0, 0, 100) and near(r2, g2, b2, 0, 255, 0, 100) and near(r3, g3, b3, 0, 0, 255, 100) and near(r4, g4, b4, 255, 255, 255, 100))))
    match image.decode(to_bytes(base64.decode(JPEG_B64))):
        Ok(im): println("jpeg_auto=" + str(b2i(im.width == 32 and im.height == 32)))
        Err(_): println("jpeg_auto=false")
    dec_err("jpeg_corrupt", to_bytes([255, 216, 255]))
    match image.encode_jpeg(jimg):
        Ok(b):
            println("jpeg_encoded=" + str(b2i(len(b) > 0 and b[0] == 255 and b[1] == 216)))
            match image.decode_jpeg(b):
                Ok(im): println("jpeg_enc_roundtrip=" + str(b2i(im.width == 32 and im.height == 32)))
                Err(_): println("jpeg_enc_roundtrip=false")
        Err(_):
            println("jpeg_encoded=false")

    # ---- BNG (Better than PNG) ----
    bng_data := load("corelib/test/image/testcard.bng")
    png_data := load("corelib/test/image/testcard.png")
    match image.decode_bng_premultiplied(bng_data):
        Ok(bi):
            println("bng_dims=" + str(bi.width) + "x" + str(bi.height))
            match image.decode(png_data):
                Ok(pi):
                    println("bng_premult=" + str(b2i(same_bytes(bi.pixels, premultiply(pi.pixels)))))
                Err(_):
                    println("bng_premult=false")
            match image.encode_bng_premultiplied(bi):
                Ok(enc):
                    match image.decode_bng_premultiplied(enc):
                        Ok(rt):
                            println("bng_big_rt=" + str(b2i(same_bytes(rt.pixels, bi.pixels))))
                        Err(_):
                            println("bng_big_rt=false")
                Err(_):
                    println("bng_big_rt=false")
        Err(_):
            println("bng_dims=err")
    match image.decode_bng(bng_data):
        Ok(bi):
            println("bng_straight=" + str(bi.width) + "x" + str(bi.height))
        Err(_):
            println("bng_straight=err")
    match image.decode(bng_data):
        Ok(bi):
            println("bng_auto=" + str(b2i(bi.width == 512 and bi.height == 512)))
        Err(_):
            println("bng_auto=false")
    op := load("corelib/test/image/opaque.bng")
    match image.decode_bng(op):
        Ok(oi):
            ok := oi.width == 4 and oi.height == 4
            for y := 0; y < 4; y += 1:
                for x := 0; x < 4; x += 1:
                    i := (y * 4 + x) * 4
                    if oi.pixels[i] != x * 60 + y * 11 or oi.pixels[i + 1] != y * 50 + x * 7 or oi.pixels[i + 2] != x * 40 + y * 3 or oi.pixels[i + 3] != 255:
                        ok = false
            println("bng_opaque=" + str(b2i(ok)))
            match image.encode_bng(oi):
                Ok(enc):
                    match image.decode_bng(enc):
                        Ok(rt):
                            println("bng_rt=" + str(b2i(same_bytes(rt.pixels, oi.pixels))))
                        Err(_):
                            println("bng_rt=false")
                Err(_):
                    println("bng_rt=false")
        Err(_):
            println("bng_opaque=false")
    raw := load("corelib/test/image/opaque_raw.bng")
    match image.decode_bng(raw):
        Ok(ri):
            want := [201, 57, 13, 255, 88, 3, 240, 255, 12, 190, 77, 255, 250, 99, 5, 255]
            ok := len(ri.pixels) == 16
            for i := 0; i < 16; i += 1:
                if ri.pixels[i] != want[i]:
                    ok = false
            println("bng_raw=" + str(b2i(ok)))
        Err(_):
            println("bng_raw=false")
    match image.decode_bng(to_bytes([0])):
        Err(e):
            println("bng_bad=" + why(e))
        Ok(_):
            println("bng_bad=Ok")
    match image.encode_bng(image.make(2, 2, to_bytes([1, 2, 3]))):
        Err(e):
            println("bng_short=" + why(e))
        Ok(_):
            println("bng_short=Ok")
    match image.decode_bng(bng_data[0:20]):
        Err(e):
            println("bng_truncated=" + why(e))
        Ok(_):
            println("bng_truncated=Ok")
