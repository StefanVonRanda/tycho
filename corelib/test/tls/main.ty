package main
import "core:tls"

fn b2i(b: bool) -> int:
    if b:
        return 1
    return 0

fn main():
    c := tls.connect("127.0.0.1", 1)                      # a closed loopback port -> connection refused
    println("connect_null=" + str(b2i(is_null(c))))       # 1
    println("ok=" + str(b2i(tls.ok(c))))                  # 0

    # read/write/close on the null handle are safe, fail-closed no-ops
    println("write=" + str(tls.write(c, to_bytes("hello"))))   # -1
    println("read_len=" + str(len(tls.read(c, 64))))           # 0
    tls.close_conn(c)                                          # safe on null

    # An interior NUL in the host is REFUSED, not truncated. The shim feeds `host`
    # to tcp_connect, SSL_set_tlsext_host_name (SNI) and SSL_set1_host (the name
    # the certificate is verified against), so a truncation would dial, announce
    # and verify a DIFFERENT name than the caller passed -- while the caller's own
    # allowlist saw the whole string (). core:net has refused this
    # since the NUL sweep; this package had not.
    nulhost := "127.0.0.1" + chr(0) + "evil.example.com"
    cn := tls.connect(nulhost, 443)
    println("nul_host_refused=" + str(b2i(is_null(cn))))       # 1
    println("done=1")
