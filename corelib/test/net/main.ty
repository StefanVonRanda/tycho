
package main
import "core:net"
import "core:result"
import "core:strings"
import "core:time"

# The fd, or -1. Every call below is on loopback and must succeed, so collapsing
# the Result keeps the test's output identical to the sentinel-era golden while
# still going through the new API. Both collapses were a hand-written four-line
# `match` until core:result landed (the option-result plan) -- this is the duplicate it
# removed, one of three copies of the same four lines in this tree.
fn fd_of(r: Result(int, net.NetErr)) -> int:
    return result.unwrap_or(r, -1)

fn why(e: net.NetErr) -> string:
    if e == net.Eof:
        return "Eof"
    if e == net.Timeout:
        return "Timeout"
    return "Failed"

# The payload of a read that must succeed, or empty bytes.
fn data_of(r: Result(bytes, net.NetErr)) -> bytes:
    return result.unwrap_or(r, to_bytes(""))

# Which NetErr, by name -- BadAddr must not collapse into Failed, since telling
# "refused before the syscall" from "the syscall failed" is the point of the variant.
fn nerr(r: Result(int, net.NetErr)) -> string:
    match r:
        Ok(v): return "Ok"
        Err(net.BadAddr): return "BadAddr"
        Err(net.Timeout): return "Timeout"
        Err(net.Eof): return "Eof"
        _: return "Failed"

# The payload is part of the answer for UDP: Ok[] is a legal zero-length
# datagram and must not read like Err(Failed).
fn dwhy(r: Result(bytes, net.NetErr)) -> string:
    match r:
        Ok(b): return "Ok[" + to_str(b) + "]"
        Err(net.Timeout): return "Timeout"
        Err(net.Eof): return "Eof"
        Err(net.BadAddr): return "BadAddr"
        _: return "Failed"


# Render a ready-set as the LABELS of the sockets it names, in the order the set
# came back, so the golden pins WHICH sockets were reported -- a count would pass
# equally on "everything is ready" and on the right answer.
fn names(ready: [int], fds: [int]) -> string:
    s := ""
    for r in ready:
        for i := 0; i < len(fds); i += 1:
            if fds[i] == r:
                if s != "":
                    s = s + ","
                s = s + "c" + str(i)
    return s

fn poll_str(r: Result([int], net.NetErr), fds: [int]) -> string:
    match r:
        Ok(rd): return "[" + names(rd, fds) + "]"
        Err(net.Timeout): return "Timeout"
        Err(net.Eof): return "Eof"
        Err(net.BadAddr): return "BadAddr"
        _: return "Failed"

# Poll until the answer is `want`, or give up and report what it really was. The
# retry is for ARRIVAL, not for the verdict: a byte written on loopback has not
# necessarily landed when the next statement runs, and a fixed single poll would
# make this leg a coin toss rather than a check.
#
# BOUNDED BY THE CLOCK, NOT BY AN ITERATION COUNT, and that distinction is the
# whole fix. This was `for t := 0; t < 50; t += 1` with a 200ms poll deadline,
# which reads like ten seconds of patience and is not: `net.wait_readable`
# returns the instant ANY descriptor is ready, so once c1 was readable every one
# of the 50 calls returned immediately and the loop finished in microseconds --
# never once waiting for the SECOND write to land. A busy spin wearing a retry's
# clothes. It held on an idle machine and lost the race under a full `make ci`,
# which is where it was caught, 2026-09-19 (FRICTION 108):
#
#     poll_two=[c0,c1]     expected, got [c1]
#     poll_hup=[c0,c1,c2]  expected, got [c1]
#
# The 5ms sleep is what makes the budget real: without it the loop still spins,
# it just spins for five seconds instead of microseconds and burns a core to do
# it. The deadline is deliberately generous -- this bounds a FAILURE, and every
# passing run leaves on the first poll that matches.
fn poll_until(fds: [int], want: string) -> string:
    sw := time.start()
    got := ""
    for true:
        got = poll_str(net.wait_readable(fds, 200), fds)
        if got == want:
            return got
        if time.elapsed_ms(sw) >= 5000:
            return got
        time.sleep_ms(5)
    return got

fn main():
    # -- TCP: client <-> server round trip over loopback --
    srv := fd_of(net.listen("127.0.0.1", 0))   # ephemeral port
    println("listen_ok=" + str(srv >= 0))
    port := fd_of(net.port_of(srv))
    println("port_ok=" + str(port > 0))

    cli := fd_of(net.connect("127.0.0.1", port))
    println("connect_ok=" + str(cli >= 0))
    conn := fd_of(net.accept(srv))
    println("accept_ok=" + str(conn >= 0))

    # client -> server
    sent := fd_of(net.write(cli, to_bytes("ping")))
    println("sent=" + str(sent))
    got := data_of(net.read(conn, 64))
    println("got=[" + to_str(got) + "] len=" + str(len(got)))

    # server -> client (echo the same bytes back)
    echoed := fd_of(net.write(conn, got))
    println("echoed=" + str(echoed))
    back := data_of(net.read(cli, 64))
    println("back=[" + to_str(back) + "]")

    # An int64 descriptor must not truncate to an unrelated int descriptor.
    huge_fd := conn + 4294967296
    net.close_fd(huge_fd)
    safe_sent := fd_of(net.write(cli, to_bytes("safe")))
    safe_body := data_of(net.read(conn, 64))
    println("large_fd_rejected=" + str(fd_of(net.port_of(huge_fd)) == -1))
    println("large_fd_close_safe=" + str(safe_sent == 4 and to_str(safe_body) == "safe"))

    # -- EOF is now its own answer -- the client closes, the server reads once --
    net.close_fd(cli)
    match net.read(conn, 64):
        Ok(b): println("eof=unexpected-data")
        Err(e): println("eof=" + why(e))
    net.close_fd(conn)

    cli2 := fd_of(net.connect("127.0.0.1", port))
    conn2 := fd_of(net.accept(srv))
    armed := net.set_read_timeout_ms(conn2, 50)
    println("armed=" + str(armed))
    match net.read(conn2, 64):                 # nobody ever writes -> deadline
        Ok(b): println("tmo=unexpected-data")
        Err(e): println("tmo=" + why(e))
    net.close_fd(cli2)
    net.close_fd(conn2)

    # -- a write timeout is armed, classified, and fail-closed on a bad fd --
    # The peer accepts but never reads, so the send buffer fills; 64 MB is more
    # than any loopback window absorbs. One byte of a partial write is not a
    # success, so the answer must be Timeout rather than a short Ok.
    wsrv := fd_of(net.listen("127.0.0.1", 0))
    wport := fd_of(net.port_of(wsrv))
    wcli := fd_of(net.connect("127.0.0.1", wport))
    wconn := fd_of(net.accept(wsrv))
    println("warmed=" + str(net.set_write_timeout_ms(wcli, 100)))
    println("warmed_bad=" + str(net.set_write_timeout_ms(-1, 100)))
    chunk := to_bytes(strings.repeat("x", 1024 * 1024))
    wres := "Ok"
    for i := 0; i < 64; i += 1:
        v := nerr(net.write(wcli, chunk))
        if v != "Ok":
            wres = v
            break
    println("wtimeout=" + wres)
    net.close_fd(wcli)
    net.close_fd(wconn)
    net.close_fd(wsrv)
    net.close_fd(srv)


    # -- readiness over a SET of descriptors --
    psrv := fd_of(net.listen("127.0.0.1", 0))
    pport := fd_of(net.port_of(psrv))
    pcli := []int
    pconn := []int
    for i := 0; i < 3; i += 1:
        push(pcli, fd_of(net.connect("127.0.0.1", pport)))
        push(pconn, fd_of(net.accept(psrv)))
    println("poll_pairs=" + str(len(pconn)))

    # Nobody has written. The deadline must actually ELAPSE -- a readiness call
    # that returns "nothing" instantly passes every test that only asks whether
    # the program still works.
    pw := time.start()
    println("poll_idle=" + poll_str(net.wait_readable(pconn, 120), pconn))
    println("poll_idle_waited=" + str(time.elapsed_ms(pw) >= 100))

    ignore := fd_of(net.write(pcli[1], to_bytes("b")))
    println("poll_one=" + poll_until(pconn, "[c1]"))
    ignore = fd_of(net.write(pcli[0], to_bytes("a")))
    println("poll_two=" + poll_until(pconn, "[c0,c1]"))

    # A peer that closed is READY, not absent: the read that follows answers Eof.
    net.close_fd(pcli[2])
    println("poll_hup=" + poll_until(pconn, "[c0,c1,c2]"))
    match net.read(pconn[2], 8):
        Ok(bb): println("poll_hup_read=unexpected-data")
        Err(e): println("poll_hup_read=" + why(e))

    # Caller bugs fail closed rather than reading as a timeout, which would spin.
    println("poll_empty=" + poll_str(net.wait_readable([]int, 10), pconn))
    println("poll_negfd=" + poll_str(net.wait_readable([pconn[0], 0 - 1], 10), pconn))
    println("poll_negms=" + poll_str(net.wait_readable(pconn, 0 - 1), pconn))

    for i := 0; i < 3; i += 1:
        net.close_fd(pconn[i])
    net.close_fd(pcli[0])
    net.close_fd(pcli[1])
    net.close_fd(psrv)

    u := net.udp_bind("127.0.0.1", 0)
    println("udp_ok=" + str(u >= 0))
    uport := fd_of(net.port_of(u))
    usent := net.udp_send(u, "127.0.0.1", uport, to_bytes("hello-udp"))
    println("udp_sent=" + str(usent))
    dg := net.udp_read(u, 64)
    println("udp=[" + to_str(dg) + "] len=" + str(len(dg)))

    nh := "127.0.0.1" + chr(0) + "bogus.invalid"
    println("nul_listen=" + nerr(net.listen(nh, 0)))
    println("nul_connect=" + nerr(net.connect(nh, uport)))
    println("nul_udp_bind=" + str(net.udp_bind(nh, 0)))
    println("nul_udp_send=" + str(net.udp_send(u, nh, uport, to_bytes("x"))))

    # Checked UDP: a zero-length datagram is Ok([]), not an error. The status
    # shim is what makes that distinguishable from timeout and failure.
    ucb := net.udp_bind_checked("127.0.0.1", 0)
    println("udp_checked_bind=" + nerr(ucb))
    uc := fd_of(ucb)
    ucp := fd_of(net.port_of(uc))
    println("udp_checked_send=" + nerr(net.udp_send_checked(uc, "127.0.0.1", ucp, to_bytes("chk"))))
    println("udp_checked_read=" + dwhy(net.udp_read_checked(uc, 64)))
    zs := net.udp_send_checked(uc, "127.0.0.1", ucp, to_bytes(""))
    println("udp_checked_zero_send=" + nerr(zs))
    println("udp_checked_zero=" + dwhy(net.udp_read_checked(uc, 64)))
    uarmed := net.set_read_timeout_ms(uc, 100)
    println("udp_checked_timeout_armed=" + str(uarmed))
    println("udp_checked_timeout=" + dwhy(net.udp_read_checked(uc, 64)))
    ucleared := net.set_read_timeout_ms(uc, 0)
    println("udp_checked_timeout_cleared=" + str(ucleared))
    println("udp_checked_err=" + dwhy(net.udp_read_checked(0 - 1, 64)))
    println("udp_checked_nul_bind=" + nerr(net.udp_bind_checked(nh, 0)))
    println("udp_checked_nul_send=" + nerr(net.udp_send_checked(uc, nh, ucp, to_bytes("x"))))
    net.close_fd(uc)

    net.close_fd(u)

    # ---- DNS and socket options ----
    r4 := net.resolve("127.0.0.1")
    match r4:
        Ok(xs):
            found := false
            for a in xs:
                if a == "127.0.0.1":
                    found = true
            println("resolve4 count=" + str(len(xs)) + " found=" + str(found))
        Err(_):
            println("resolve4=ERR")
    rbad := net.resolve("no-such-host.invalid")
    match rbad:
        Ok(_): println("resolve_bad=Ok")
        Err(net.Failed): println("resolve_bad=Failed")
        Err(_): println("resolve_bad=Other")
    rnul := net.resolve("x" + chr(0))
    match rnul:
        Ok(_): println("resolve_nul=Ok")
        Err(net.BadAddr): println("resolve_nul=BadAddr")
        Err(_): println("resolve_nul=Other")
    rlocal := net.resolve("localhost")
    match rlocal:
        Ok(xs): println("resolve_localhost_nonempty=" + str(len(xs) > 0))
        Err(_): println("resolve_localhost_nonempty=false")

    lfd := fd_of(net.listen("127.0.0.1", 0))
    println("opt_reuse=" + str(net.set_reuse_addr(lfd, true)))
    println("opt_keepalive=" + str(net.set_keepalive(lfd, true)))
    println("opt_nonblock=" + str(net.set_nonblocking(lfd, true)) + "," + str(net.set_nonblocking(lfd, false)))
    net.close_fd(lfd)
    ufd := fd_of(net.udp_bind_checked("127.0.0.1", 0))
    println("opt_broadcast=" + str(net.set_broadcast(ufd, true)) + " opt_udp_nonblock=" + str(net.set_nonblocking(ufd, true)))
    println("opt_badfd=" + str(net.set_reuse_addr(0 - 1, true)) + "," + str(net.set_nonblocking(0 - 1, true)))
    net.close_fd(ufd)

    # ---- address parsing and formatting ----
    println("ip4=" + ip4_str(net.parse_ip4("127.0.0.1")))
    println("ip4_lead=" + ip4_str(net.parse_ip4("001.002.003.004")))
    println("ip4_bad=" + ip4_str(net.parse_ip4("256.1.1.1")) + "," + ip4_str(net.parse_ip4("1.2.3")) + "," + ip4_str(net.parse_ip4("1.2.3.4.5")))
    println("ip4_flags=" + str(net.is_ip4("1.2.3.4")) + "," + str(net.is_ip4("1.2.3")))
    println("ip6_loop=" + ip6_str(net.parse_ip6("::1")))
    println("ip6_mid=" + ip6_str(net.parse_ip6("2001:db8::1")))
    println("ip6_full=" + ip6_str(net.parse_ip6("2001:0db8:0000:0000:0000:0000:0000:0001")))
    println("ip6_v4=" + ip6_str(net.parse_ip6("::ffff:192.168.0.1")))
    println("ip6_all=" + ip6_str(net.parse_ip6("::")))
    println("ip6_bad=" + ip6_str(net.parse_ip6("1:2:3:4:5:6:7:8:9")) + "," + ip6_str(net.parse_ip6("1::2::3")) + "," + ip6_str(net.parse_ip6(":::")))
    println("ip6_flags=" + str(net.is_ip6("::1")) + "," + str(net.is_ip6("1:2:3")))
    println("ep_host=" + ep_str(net.parse_endpoint("example.com:80")))
    println("ep_v6=" + ep_str(net.parse_endpoint("[2001:db8::1]:443")))
    println("ep_bare_v6=" + ep_str(net.parse_endpoint("2001:db8::1:443")))
    println("ep_bad=" + ep_str(net.parse_endpoint("host:70000")) + "," + ep_str(net.parse_endpoint("host")))

    # ---- prefix parsing and containment ----
    println("ip4p=" + ip4p_str(net.parse_ip4_prefix("192.168.1.0/24")))
    println("ip4p_bare=" + ip4p_str(net.parse_ip4_prefix("192.168.1.55")))
    println("ip4p_bad=" + ip4p_str(net.parse_ip4_prefix("10.0.0.0/33")))
    match net.parse_ip4_prefix("192.168.1.0/24"):
        Some(p):
            println("ip4p_net=" + net.format_ip4(net.prefix_network_ip4(p)))
            println("ip4p_hit=" + str(p4_contains(p, "192.168.1.55")))
            println("ip4p_miss=" + str(p4_contains(p, "192.168.2.1")))
        None:
            println("ip4p_parse=bad")
    println("ip6p=" + ip6p_str(net.parse_ip6_prefix("2001:db8::/32")))
    println("ip6p_bare=" + ip6p_str(net.parse_ip6_prefix("::1")))
    println("ip6p_bad=" + ip6p_str(net.parse_ip6_prefix("::/129")))
    match net.parse_ip6_prefix("2001:db8::/32"):
        Some(p):
            println("ip6p_net=" + net.format_ip6(net.prefix_network_ip6(p)))
            println("ip6p_hit=" + str(p6_contains(p, "2001:db8:1::1")))
            println("ip6p_miss=" + str(p6_contains(p, "2001:db9::1")))
        None:
            println("ip6p_parse=bad")


fn ip4_str(r: Option(net.Ip4)) -> string:
    match r:
        Some(ip): return net.format_ip4(ip)
        None: return "bad"

fn ip6_str(r: Option(net.Ip6)) -> string:
    match r:
        Some(ip): return net.format_ip6(ip)
        None: return "bad"

fn ep_str(r: Option(net.Endpoint)) -> string:
    match r:
        Some(ep): return net.join_endpoint(ep)
        None: return "bad"

fn ip4p_str(r: Option(net.Ip4Prefix)) -> string:
    match r:
        Some(p): return net.format_ip4_prefix(p)
        None: return "bad"

fn ip6p_str(r: Option(net.Ip6Prefix)) -> string:
    match r:
        Some(p): return net.format_ip6_prefix(p)
        None: return "bad"

fn p4_contains(p: net.Ip4Prefix, addr: string) -> bool:
    match net.parse_ip4(addr):
        Some(ip): return net.prefix_contains_ip4(p, ip)
        None: return false

fn p6_contains(p: net.Ip6Prefix, addr: string) -> bool:
    match net.parse_ip6(addr):
        Some(ip): return net.prefix_contains_ip6(p, ip)
        None: return false
