
package main
import "core:net"
import "core:result"

# The fd, or -1. Every call below is on loopback and must succeed, so collapsing
# the Result keeps the test's output identical to the sentinel-era golden while
# still going through the new API. Both collapses were a hand-written four-line
# `match` until core:result landed (the option-result plan) -- this is the duplicate it
# removed, one of three copies of the same four lines in this tree.
fn fd_of(r: Result(int, net.NetErr)) -> int:
    return result.unwrap_or(r, -1)

fn why(e: net.NetErr) -> string:
    if e == net.Eof:
        return "Eof"
    if e == net.Timeout:
        return "Timeout"
    return "Failed"

# The payload of a read that must succeed, or empty bytes.
fn data_of(r: Result(bytes, net.NetErr)) -> bytes:
    return result.unwrap_or(r, to_bytes(""))

# Which NetErr, by name -- BadAddr must not collapse into Failed, since telling
# "refused before the syscall" from "the syscall failed" is the point of the variant.
fn nerr(r: Result(int, net.NetErr)) -> string:
    match r:
        Ok(v): return "Ok"
        Err(net.BadAddr): return "BadAddr"
        Err(net.Timeout): return "Timeout"
        Err(net.Eof): return "Eof"
        _: return "Failed"

fn main():
    # -- TCP: client <-> server round trip over loopback --
    srv := fd_of(net.listen("127.0.0.1", 0))   # ephemeral port
    println("listen_ok=" + str(srv >= 0))
    port := fd_of(net.port_of(srv))
    println("port_ok=" + str(port > 0))

    cli := fd_of(net.connect("127.0.0.1", port))
    println("connect_ok=" + str(cli >= 0))
    conn := fd_of(net.accept(srv))
    println("accept_ok=" + str(conn >= 0))

    # client -> server
    sent := fd_of(net.write(cli, to_bytes("ping")))
    println("sent=" + str(sent))
    got := data_of(net.read(conn, 64))
    println("got=[" + to_str(got) + "] len=" + str(len(got)))

    # server -> client (echo the same bytes back)
    echoed := fd_of(net.write(conn, got))
    println("echoed=" + str(echoed))
    back := data_of(net.read(cli, 64))
    println("back=[" + to_str(back) + "]")

    # -- EOF is now its own answer -- the client closes, the server reads once --
    net.close_fd(cli)
    match net.read(conn, 64):
        Ok(b): println("eof=unexpected-data")
        Err(e): println("eof=" + why(e))
    net.close_fd(conn)

    cli2 := fd_of(net.connect("127.0.0.1", port))
    conn2 := fd_of(net.accept(srv))
    armed := net.set_read_timeout_ms(conn2, 50)
    println("armed=" + str(armed))
    match net.read(conn2, 64):                 # nobody ever writes -> deadline
        Ok(b): println("tmo=unexpected-data")
        Err(e): println("tmo=" + why(e))
    net.close_fd(cli2)
    net.close_fd(conn2)
    net.close_fd(srv)

    u := net.udp_bind("127.0.0.1", 0)
    println("udp_ok=" + str(u >= 0))
    uport := fd_of(net.port_of(u))
    usent := net.udp_send(u, "127.0.0.1", uport, to_bytes("hello-udp"))
    println("udp_sent=" + str(usent))
    dg := net.udp_read(u, 64)
    println("udp=[" + to_str(dg) + "] len=" + str(len(dg)))

    nh := "127.0.0.1" + chr(0) + "bogus.invalid"
    println("nul_listen=" + nerr(net.listen(nh, 0)))
    println("nul_connect=" + nerr(net.connect(nh, uport)))
    println("nul_udp_bind=" + str(net.udp_bind(nh, 0)))
    println("nul_udp_send=" + str(net.udp_send(u, nh, uport, to_bytes("x"))))

    net.close_fd(u)
