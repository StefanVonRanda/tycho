package main
import "core:sha256"

fn b2i(b: bool) -> int:
    if b:
        return 1
    return 0

fn main():
    println("'' = " + sha256.hex(""))     # e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855
    println("abc= " + sha256.hex("abc"))   # ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad

    # a multi-block message (>64 bytes exercises the block loop + schedule)
    fox := "The quick brown fox jumps over the lazy dog"
    println("fox= " + sha256.hex(fox))     # d7a8fbb307d7809469ca9abcb0082e4f8d5651e46d3cdb762d02d0bf37c9e592
    big := "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789"
    println("AZ = " + sha256.hex(big))     # db4bfcbd4da0cd85a60c3c37d3fbd8805c77f15fc6b1fdfe614ee0a7c8fdb4c0

    # digest() returns 32 bytes; hex length is 64
    d := sha256.digest("abc")
    h := sha256.hex("abc")
    println(f"digest_len={len(d)} hex_len={len(h)} ok={b2i(len(d) == 32 and len(h) == 64)}")

    # streaming == one-shot, fed in awkward chunk sizes (1, 63, 64, 65 bytes)
    # so every boundary of the pending buffer is crossed.
    msg := fox + big
    st := sha256.init()
    for i := 0; i < len(msg); i += 1:      # one byte at a time
        sha256.update(&st, to_bytes(msg[i:i + 1]))
    println("stream1 = " + sha256.final_hex(&st))
    println(f"stream1_eq= {b2i(sha256.hex(msg) == streamed(msg, 63))}")
    println(f"stream2_eq= {b2i(sha256.hex(msg) == streamed(msg, 64))}")
    println(f"stream3_eq= {b2i(sha256.hex(msg) == streamed(msg, 65))}")
    println(f"stream0_eq= {b2i(sha256.hex("") == streamed("", 64))}")

fn streamed(msg: string, chunk: int) -> string:
    st := sha256.init()
    i := 0
    for i < len(msg):
        hi := i + chunk
        if hi > len(msg):
            hi = len(msg)
        sha256.update(&st, to_bytes(msg[i:hi]))
        i = hi
    return sha256.final_hex(&st)
