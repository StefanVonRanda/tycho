# corelib test: core:signal, in one process, with no sleeps and no timing
# assumptions -- the output is locked to corelib/test/signal.out (corelib/run.sh).
#
# WHY THIS IS DETERMINISTIC, which is the only interesting thing about a signal
# test. The signal is sent by `kill -TERM $PPID` from the shell that os.system
# forks, so its target is THIS process. kill(2) makes the signal pending before it
# returns; this process is meanwhile blocked in waitpid(2) inside system(3), and
# the kernel runs a pending, unblocked signal's handler before returning to user
# space. So the handler has run by the time os.system returns -- there is no race
# to lose and nothing to sleep on.
#
# SIGTERM AND NOT SIGINT, on purpose: glibc's system(3) sets SIGINT to SIG_IGN in
# the CALLER for the duration of the call and restores it afterwards, so a
# `kill -INT $PPID` issued through os.system would be swallowed by system(3)
# rather than by anything in core:signal. The handler is installed for both
# (signal_shim.c), and SIGINT is exercised for real by the server gate.
#
# The single-threaded shape is the narrow case: what it proves is that the
# handler is installed, that it fires, and that a bounded accept observes the
# shutdown. Linux wakes accept() immediately; macOS reaches the same Err arm at
# the accept_wait timeout, which is the portable contract the server uses. The
# immediate all-worker wake remains a Linux optimization rather than an API
# promise.

package main
import "core:net"
import "core:os"
import "core:result"
import "core:signal"
import "core:time"

# Windows-only hooks from signal_shim.c, declared HERE rather than exported by
# core:signal: they are this test's delivery mechanism, not part of the
# package's portable surface. POSIX builds link the stubs beside the real
# sigaction path (both call sites are emitted, so both symbols must resolve).
extern fn sigx_win_isolate_console() -> int
extern fn sigx_win_raise_break() -> int

fn why(e: net.NetErr) -> string:
    # Failed on kernels where shutdown wakes accept; Timeout on macOS. Both mean
    # the bounded shutdown contract completed, so keep one cross-platform golden.
    if e == net.Eof:
        return "Eof"
    return "Failed"

fn main():
    # Fail closed: a descriptor that cannot be a listener installs nothing.
    println("armed_bad=" + str(signal.on_shutdown(-1)))
    println("requested_before=" + str(signal.shutdown_requested()))

    srv := result.unwrap_or(net.listen("127.0.0.1", 0), -1)   # ephemeral port
    println("listen_ok=" + str(srv >= 0))
    println("armed=" + str(signal.on_shutdown(srv)))

    # The listener still works while nothing has been signalled: connect from this
    # same thread completes the handshake into the backlog, so accept returns.
    port := result.unwrap_or(net.port_of(srv), -1)
    cli := result.unwrap_or(net.connect("127.0.0.1", port), -1)
    conn := result.unwrap_or(net.accept(srv), -1)
    println("accept_before=" + str(conn >= 0))
    net.close_fd(conn)
    net.close_fd(cli)

    # Signal this process. Two mechanisms, picked by probing rather than by any
    # build-time switch (the language has no conditional compilation).
    #
    # POSIX: `kill -TERM $PPID` through the shell os.system forks. See the
    # header for why the handler has already run when os.system returns.
    #
    # WINDOWS: MSYS2's `kill` cannot signal a NATIVE PE -- it terminates it --
    # which is why this test was skipped there until 2026-08-09. The real
    # mechanism is a console control event, and the shim's SetConsoleCtrlHandler
    # is already armed at the far end. The process first moves to a PRIVATE
    # console (see sigx_win_isolate_console) so the event cannot reach the
    # harness shell, then raises CTRL_BREAK on it.
    #
    # THE ORDERING GUARANTEE DOES NOT TRANSFER. A POSIX handler runs in the
    # signalled thread before the interrupted call returns; a Windows console
    # handler runs on a FRESH thread with no such ordering. So Windows polls the
    # flag with a bound instead of assuming, and the bound failing is a red
    # rather than a hang.
    if os.exec(["/bin/sh", "-c", "exit 0"]) == 0:
        code := os.system("kill -TERM $PPID")
        println("kill_code=" + str(code))
    else:
        println("kill_code=" + str(sigx_win_isolate_console() - 1))   # 1 -> 0, matching a clean POSIX exit code
        sent := sigx_win_raise_break()
        waited := 0
        for i := 0; i < 200; i += 1:                                  # 200 x 10ms = 2s ceiling
            if signal.shutdown_requested():
                break
            time.sleep_ms(10)
            waited += 10
        if sent == 0:
            println("WINDOWS: GenerateConsoleCtrlEvent failed")
    println("requested_after=" + str(signal.shutdown_requested()))

    # The listener has been shut down from handler context: bounded accept reaches
    # the wind-down arm even where shutdown() does not wake a blocking accept.
    match net.accept_wait(srv, 100):
        Ok(c): println("accept_after=unexpected-connection")
        Err(e): println("accept_after=" + why(e))
    net.close_fd(srv)
