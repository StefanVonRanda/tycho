# corelib test: exercises core:httpd over core:net entirely on the loopback
# interface, in one process/thread (connect() into the listen backlog completes
# the handshake before accept(), so listen -> connect -> accept -> exchange runs
# single-threaded and hermetic). No fixed port (bind 0 -> ephemeral). tychoc and
# tychoc0 must agree; output locked to corelib/test/httpd.out (corelib/run.sh).
package main
import "core:net"
import "core:httpd"

fn b(x: bool) -> int:
    if x:
        return 1
    return 0

fn crlf() -> string:                             # no \r escape in tycho strings
    return chr(13) + chr(10)

fn main():
    # ---- pure parsing (no socket): a request with headers + body ----
    nl := crlf()
    raw := "POST /submit?id=7 HTTP/1.1" + nl + "Host: localhost" + nl + "Content-Type: application/json" + nl + "Content-Length: 13" + nl + nl + "{\"a\":\"hello\"}"
    p := httpd.parse_request(raw)
    println("method = " + p.method)
    println("path   = " + p.path)
    println("version= " + p.version)
    println("host   = " + httpd.header(p, "Host"))
    println("ctype  = " + httpd.header(p, "content-type"))     # case-insensitive lookup
    println("clen   = " + httpd.header(p, "Content-Length"))
    println("missing= [" + httpd.header(p, "X-None") + "]")
    println("body   = " + to_str(p.body))
    println("bodylen= " + str(len(p.body)))

    # a malformed request line fails closed
    bad := httpd.parse_request("garbage" + nl + nl)
    println("bad_method_empty = " + str(b(bad.method == "")))

    # render a response: auto Content-Length + default Content-Type
    r0 := httpd.text_response(404, "nope")
    println("--- render ---")
    println(to_str(httpd.render(r0)))

    # ---- content types by extension (unknown must NOT be text/plain) ----
    println("ct_html = " + httpd.content_type("/index.html"))
    println("ct_css  = " + httpd.content_type("/static/style.css"))
    println("ct_png  = " + httpd.content_type("/img/LOGO.PNG"))        # case-insensitive
    println("ct_woff2= " + httpd.content_type("/f/inter.woff2"))
    println("ct_wasm = " + httpd.content_type("/m.wasm"))
    println("ct_none = " + httpd.content_type("/README"))
    println("ct_odd  = " + httpd.content_type("/archive.tar.gz"))

    # ---- keep-alive decisions ----
    k11 := httpd.parse_request("GET / HTTP/1.1" + nl + nl)
    k11c := httpd.parse_request("GET / HTTP/1.1" + nl + "Connection: close" + nl + nl)
    k11m := httpd.parse_request("GET / HTTP/1.1" + nl + "Connection: keep-alive, Upgrade" + nl + nl)
    k10 := httpd.parse_request("GET / HTTP/1.0" + nl + nl)
    k10k := httpd.parse_request("GET / HTTP/1.0" + nl + "Connection: Keep-Alive" + nl + nl)
    println("close_11      = " + str(b(httpd.connection_close(k11))))
    println("close_11_close= " + str(b(httpd.connection_close(k11c))))
    println("close_11_multi= " + str(b(httpd.connection_close(k11m))))
    println("close_10      = " + str(b(httpd.connection_close(k10))))
    println("close_10_ka   = " + str(b(httpd.connection_close(k10k))))
    println("close_bad     = " + str(b(httpd.connection_close(bad))))

    # ---- a binary body survives an interior NUL and a 0xFF byte ----
    png := to_bytes([137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 255])
    bin := httpd.with_header(httpd.response(200, png), "Content-Type", httpd.content_type("x.png"))
    wire_bin := to_str(httpd.render(bin))
    bsep := find(wire_bin, nl + nl)
    got_bin := wire_bin[bsep + 4:len(wire_bin)]
    println("bin_len   = " + str(len(got_bin)))
    println("bin_nul   = " + str(got_bin[8]) + " " + str(got_bin[12]))
    println("bin_ctype = " + str(b(find(wire_bin, "Content-Type: image/png") >= 0)))

    # ---- loopback round trip over core:net ----
    srv := net.listen("127.0.0.1", 0)
    port := net.port_of(srv)
    cli := net.connect("127.0.0.1", port)
    conn := net.accept(srv)
    println("net_ok = " + str(b(srv >= 0 and port > 0 and cli >= 0 and conn >= 0)))

    # client -> server: send the raw request built above
    net.write(cli, to_bytes(raw))
    got := httpd.read_request(conn)
    println("srv_method = " + got.method)
    println("srv_path   = " + got.path)
    println("srv_body   = " + to_str(got.body))
    println("srv_bodylen= " + str(len(got.body)))

    # server -> client: build + send a response with an extra header
    resp := httpd.with_header(httpd.text_response(200, "pong"), "X-Extra", "yes")
    n := httpd.write_response(conn, resp)
    println("wrote_ok = " + str(b(n > 0)))
    net.close_fd(conn)

    # client reads + inspects the response (deterministic header order)
    wire := to_str(net.read(cli, 4096))
    rlines := split(wire, "\n")
    println("status = " + httpd.trim(rlines[0]))            # HTTP/1.1 200 OK
    println("has_extra = " + str(b(find(wire, "X-Extra: yes") >= 0)))
    println("has_clen  = " + str(b(find(wire, "Content-Length: 4") >= 0)))
    println("has_ctype = " + str(b(find(wire, "Content-Type: text/plain") >= 0)))
    rsep := find(wire, nl + nl)
    rbody := wire[rsep + 4:len(wire)]
    println("rbody = " + rbody)                             # pong

    net.close_fd(cli)

    # ---- binary body over a real socket: every byte must survive ----
    cli2 := net.connect("127.0.0.1", port)
    conn2 := net.accept(srv)
    net.write(cli2, to_bytes("GET /logo.png HTTP/1.1" + nl + nl))
    rq2 := httpd.read_request(conn2)
    blob := to_bytes([137, 80, 78, 71, 0, 255, 13, 10, 0, 1])
    br := httpd.with_header(httpd.response(200, blob), "Content-Type", httpd.content_type(rq2.path))
    bn := httpd.write_response(conn2, httpd.with_connection(br, false))
    net.close_fd(conn2)
    w2 := to_str(net.read(cli2, 4096))
    s2 := find(w2, nl + nl)
    body2 := w2[s2 + 4:len(w2)]
    println("sock_bin_len   = " + str(len(body2)))
    println("sock_bin_bytes = " + str(body2[0]) + " " + str(body2[4]) + " " + str(body2[5]) + " " + str(body2[9]))
    println("sock_bin_ctype = " + str(b(find(w2, "Content-Type: image/png") >= 0)))
    println("sock_bin_conn  = " + str(b(find(w2, "Connection: close") >= 0)))
    println("sock_bin_wrote = " + str(b(bn > 0)))
    net.close_fd(cli2)

    # ---- an idle peer is dropped, not waited on forever ----
    cli3 := net.connect("127.0.0.1", port)
    conn3 := net.accept(srv)
    armed := net.set_read_timeout_ms(conn3, 200)
    idle := httpd.read_request(conn3)                       # cli3 sends nothing
    println("timeout_armed  = " + str(b(armed)))
    println("timeout_closes = " + str(b(idle.method == "" and httpd.connection_close(idle))))
    net.close_fd(conn3)
    net.close_fd(cli3)

    net.close_fd(srv)
