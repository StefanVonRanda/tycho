# corelib test: exercises core:httpd over core:net entirely on the loopback interface,
# in one process/thread (connect() into the listen backlog completes the handshake
# before accept(), so listen -> connect -> accept -> exchange runs single-threaded and
# hermetic). No fixed port (bind 0 -> ephemeral). The output is locked to
# corelib/test/httpd.out (corelib/run.sh). The tychoc0 cross-check this line used to
# claim was retired 2026-07-29.
package main
import "core:net"
import "core:httpd"
import "core:result"

fn b(x: bool) -> int:
    if x:
        return 1
    return 0

# core:net's TCP calls and httpd.write_response return Result(_, net.NetErr), and
# httpd.parse_request / read_request return Result(Request, httpd.ReqErr). main()
# is void so `or_return` cannot short-circuit out of it, and every call here is on
# loopback and must succeed -- so these three collapse the Result to the value the
# assertions already print. Each was a hand-written four-line `match` until
# core:result landed (the option-result plan).
fn n_of(r: Result(int, net.NetErr)) -> int:
    return result.unwrap_or(r, -1)

fn data_of(r: Result(bytes, net.NetErr)) -> bytes:
    return result.unwrap_or(r, to_bytes(""))

fn rq(r: Result(httpd.Request, httpd.ReqErr)) -> httpd.Request:
    return result.unwrap_or(r, httpd.bad_request())

# WHICH outcome read_request/parse_request reported, as a stable string. This is
# the assertion the whole conversion exists for: "Malformed", "Closed" and
# "Timeout" were ALL `method == ""` before 2026-07-26.
#
# One arm per cause, since the friction plan. This function was `is_ok` + `err_or`
# plus four `e == httpd.X` comparisons, because `Err(httpd.Timeout)` did not parse.
# The old note here said this could be written HERE and not in corelib/httpd
# itself because no runner fed corelib/test/ to the frozen compiler/tychoc0.ty.
# That constraint died with the tychoc0 lanes on 2026-07-29 and nothing builds
# tychoc0 now, so nested patterns are writable anywhere -- tests/nested_pattern.ty
# is the construct's own fixture under the main golden loop. This arm stays here
# because it is the core:httpd lane, not because anything forbids it elsewhere.
fn why(r: Result(httpd.Request, httpd.ReqErr)) -> string:
    match r:
        Ok(req): return "Ok"
        Err(httpd.Malformed): return "Malformed"
        Err(httpd.Closed): return "Closed"
        Err(httpd.Timeout): return "Timeout"
        _: return "Failed"

fn main():
    # ---- pure parsing (no socket): a request with headers + body ----
    nl := "\r\n"                                 # a literal since the friction plan
    raw := "POST /submit?id=7 HTTP/1.1" + nl + "Host: localhost" + nl + "Content-Type: application/json" + nl + "Content-Length: 13" + nl + nl + "{\"a\":\"hello\"}"
    p := rq(httpd.parse_request(raw))
    println("method = " + p.method)
    println("path   = " + p.path)
    println("version= " + p.version)
    println("host   = " + httpd.header(p, "Host"))
    println("ctype  = " + httpd.header(p, "content-type"))     # case-insensitive lookup
    println("clen   = " + httpd.header(p, "Content-Length"))
    println("missing= [" + httpd.header(p, "X-None") + "]")
    println("body   = " + to_str(p.body))
    println("bodylen= " + str(len(p.body)))

    # a malformed request line fails closed -- as an Err now, not as a Request
    # whose method happens to be ""
    badr := httpd.parse_request("garbage" + nl + nl)
    bad := rq(badr)
    println("bad_why = " + why(badr))

    # render a response: auto Content-Length + default Content-Type
    r0 := httpd.text_response(404, "nope")
    println("--- render ---")
    println(to_str(httpd.render(r0)))

    # ---- content types by extension (unknown must NOT be text/plain) ----
    println("ct_html = " + httpd.content_type("/index.html"))
    println("ct_css  = " + httpd.content_type("/static/style.css"))
    println("ct_png  = " + httpd.content_type("/img/LOGO.PNG"))        # case-insensitive
    println("ct_woff2= " + httpd.content_type("/f/inter.woff2"))
    println("ct_wasm = " + httpd.content_type("/m.wasm"))
    println("ct_none = " + httpd.content_type("/README"))
    println("ct_odd  = " + httpd.content_type("/archive.tar.gz"))

    # ---- keep-alive decisions ----
    k11 := rq(httpd.parse_request("GET / HTTP/1.1" + nl + nl))
    k11c := rq(httpd.parse_request("GET / HTTP/1.1" + nl + "Connection: close" + nl + nl))
    k11m := rq(httpd.parse_request("GET / HTTP/1.1" + nl + "Connection: keep-alive, Upgrade" + nl + nl))
    k10 := rq(httpd.parse_request("GET / HTTP/1.0" + nl + nl))
    k10k := rq(httpd.parse_request("GET / HTTP/1.0" + nl + "Connection: Keep-Alive" + nl + nl))
    println("close_11      = " + str(b(httpd.connection_close(k11))))
    println("close_11_close= " + str(b(httpd.connection_close(k11c))))
    println("close_11_multi= " + str(b(httpd.connection_close(k11m))))
    println("close_10      = " + str(b(httpd.connection_close(k10))))
    println("close_10_ka   = " + str(b(httpd.connection_close(k10k))))
    println("close_bad     = " + str(b(httpd.connection_close(bad))))

    # ---- a binary body survives an interior NUL and a 0xFF byte ----
    png := to_bytes([137, 80, 78, 71, 13, 10, 26, 10, 0, 0, 0, 13, 255])
    bin := httpd.with_header(httpd.response(200, png), "Content-Type", httpd.content_type("x.png"))
    wire_bin := to_str(httpd.render(bin))
    bsep := find(wire_bin, nl + nl)
    got_bin := wire_bin[bsep + 4:len(wire_bin)]
    println("bin_len   = " + str(len(got_bin)))
    println("bin_nul   = " + str(got_bin[8]) + " " + str(got_bin[12]))
    println("bin_ctype = " + str(b(find(wire_bin, "Content-Type: image/png") >= 0)))

    # ---- loopback round trip over core:net ----
    srv := n_of(net.listen("127.0.0.1", 0))
    port := n_of(net.port_of(srv))
    cli := n_of(net.connect("127.0.0.1", port))
    conn := n_of(net.accept(srv))
    println("net_ok = " + str(b(srv >= 0 and port > 0 and cli >= 0 and conn >= 0)))

    # client -> server: send the raw request built above
    w := n_of(net.write(cli, to_bytes(raw)))
    got := rq(httpd.read_request(conn))
    println("srv_method = " + got.method)
    println("srv_path   = " + got.path)
    println("srv_body   = " + to_str(got.body))
    println("srv_bodylen= " + str(len(got.body)))

    # server -> client: build + send a response with an extra header
    resp := httpd.with_header(httpd.text_response(200, "pong"), "X-Extra", "yes")
    n := n_of(httpd.write_response(conn, resp))
    println("wrote_ok = " + str(b(n > 0)))
    net.close_fd(conn)

    # client reads + inspects the response (deterministic header order)
    wire := to_str(data_of(net.read(cli, 4096)))
    rlines := split(wire, "\n")
    println("status = " + httpd.trim(rlines[0]))            # HTTP/1.1 200 OK
    println("has_extra = " + str(b(find(wire, "X-Extra: yes") >= 0)))
    println("has_clen  = " + str(b(find(wire, "Content-Length: 4") >= 0)))
    println("has_ctype = " + str(b(find(wire, "Content-Type: text/plain") >= 0)))
    rsep := find(wire, nl + nl)
    rbody := wire[rsep + 4:len(wire)]
    println("rbody = " + rbody)                             # pong

    net.close_fd(cli)

    # ---- binary body over a real socket: every byte must survive ----
    cli2 := n_of(net.connect("127.0.0.1", port))
    conn2 := n_of(net.accept(srv))
    wb := n_of(net.write(cli2, to_bytes("GET /logo.png HTTP/1.1" + nl + nl)))
    rq2 := rq(httpd.read_request(conn2))
    blob := to_bytes([137, 80, 78, 71, 0, 255, 13, 10, 0, 1])
    br := httpd.with_header(httpd.response(200, blob), "Content-Type", httpd.content_type(rq2.path))
    bn := n_of(httpd.write_response(conn2, httpd.with_connection(br, false)))
    net.close_fd(conn2)
    w2 := to_str(data_of(net.read(cli2, 4096)))
    s2 := find(w2, nl + nl)
    body2 := w2[s2 + 4:len(w2)]
    println("sock_bin_len   = " + str(len(body2)))
    println("sock_bin_bytes = " + str(body2[0]) + " " + str(body2[4]) + " " + str(body2[5]) + " " + str(body2[9]))
    println("sock_bin_ctype = " + str(b(find(w2, "Content-Type: image/png") >= 0)))
    println("sock_bin_conn  = " + str(b(find(w2, "Connection: close") >= 0)))
    println("sock_bin_wrote = " + str(b(bn > 0)))
    net.close_fd(cli2)

    # ---- an idle peer is dropped, not waited on forever ----
    cli3 := n_of(net.connect("127.0.0.1", port))
    conn3 := n_of(net.accept(srv))
    armed := net.set_read_timeout_ms(conn3, 200)
    idle := httpd.read_request(conn3)                       # cli3 sends nothing
    println("timeout_armed  = " + str(b(armed)))
    println("timeout_why    = " + why(idle))                # Timeout, not ""
    println("timeout_closes = " + str(b(httpd.connection_close(rq(idle)))))
    net.close_fd(conn3)
    net.close_fd(cli3)

    # ---- THE POINT OF ReqErr: three failures that used to be one value ----
    # Each peer below produced `method == ""` before 2026-07-26, and a server
    # could not tell which -- so it could not answer 400 to garbage while hanging
    # up silently on a disconnect (FRICTION.md, phase 7). Now each says so.

    # (a) garbage with a complete head -> Malformed (this one deserves a 400)
    cli4 := n_of(net.connect("127.0.0.1", port))
    conn4 := n_of(net.accept(srv))
    g := n_of(net.write(cli4, to_bytes("GARBAGE" + nl + nl)))
    println("garbage_why    = " + why(httpd.read_request(conn4)))
    net.close_fd(conn4)
    net.close_fd(cli4)

    # (b) a peer that connects and hangs up without a byte -> Closed (no 400)
    cli5 := n_of(net.connect("127.0.0.1", port))
    conn5 := n_of(net.accept(srv))
    net.close_fd(cli5)
    println("hangup_why     = " + why(httpd.read_request(conn5)))
    net.close_fd(conn5)

    # (c) a partial head, then a hangup -> Closed, NOT Malformed: the request was
    # never finished, so there is nothing to call bad
    cli6 := n_of(net.connect("127.0.0.1", port))
    conn6 := n_of(net.accept(srv))
    h := n_of(net.write(cli6, to_bytes("GET / HTTP/1.1" + nl)))
    net.close_fd(cli6)
    println("partial_why    = " + why(httpd.read_request(conn6)))
    net.close_fd(conn6)

    net.close_fd(srv)
