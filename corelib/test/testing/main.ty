package main
import "core:testing"

fn noop():
    pass

fn main():
    pass := testing.new("passing")
    testing.check(&pass, 1 + 1 == 2, "arithmetic")
    testing.eq(&pass, 2 + 2, 4, "eq int")
    testing.eq(&pass, "ab" + "c", "abc", "eq string")
    testing.eq(&pass, 1.5 + 1.5, 3.0, "eq float")
    r := testing.report(pass)
    fail := testing.new("failing")
    testing.check(&fail, false, "deliberate failure")
    testing.eq(&fail, 1, 2, "eq fails")
    testing.check(&fail, true, "this one passes")
    r2 := testing.report(fail)
    # the exit-code contract: a fully passing test reports 0, a failing one 1
    print(str(r) + " " + str(r2) + "\n")
    b := testing.bench("noop", 100, noop)
    println("bench=" + str(b.iters == 100 and b.ns >= 0))
    println("report=" + testing.report_bench(testing.Bench("x", 10, 1000)))
    sub := testing.subtest(pass, "child")
    testing.eq(&sub, 3, 3, "sub eq")
    testing.merge(&pass, sub)
    println("subtest_checks=" + str(pass.nchecks == 5) + " sub_fail=" + str(pass.nfail == 0))
