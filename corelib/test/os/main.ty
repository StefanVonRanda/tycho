
package main
import "core:os"
import "core:io"
import "core:strings"          # trim: cmd.exe's `echo` appends CRLF, /bin/sh's printf does not

fn show_opt(o: Option(string)) -> string:
    match o:
        Some(v):
            return "[" + v + "]"
        None:
            return "none"

fn show_os(r: Result(void, os.OsErr)) -> string:
    match r:
        Ok():
            return "Ok"
        Err(os.BadName):
            return "BadName"
        Err(os.BadValue):
            return "BadValue"
        Err(os.BadPath):
            return "BadPath"
        Err(os.NotFound):
            return "NotFound"
        Err(os.Denied):
            return "Denied"
        Err(os.Failed):
            return "Failed"

fn show_cwd(r: Result(string, os.OsErr)) -> string:
    match r:
        Ok(v):
            if len(v) > 0:
                return "Ok"
            return "OkEmpty"
        Err(os.BadName):
            return "BadName"
        Err(os.BadValue):
            return "BadValue"
        Err(os.BadPath):
            return "BadPath"
        Err(os.NotFound):
            return "NotFound"
        Err(os.Denied):
            return "Denied"
        Err(os.Failed):
            return "Failed"

fn main():
    # system(): exit code only. These commands write nothing to stdout, so they
    # never interleave with the println output below (ordering stays stable).
    println("true=" + str(os.system("true")))
    println("false=" + str(os.system("false")))
    println("exit7=" + str(os.system("exit 7")))

    # run(): capture stdout + exit code (printf, not echo, for portable output).
    r := os.run("printf hello")
    println("out=[" + r.out + "] code=" + str(r.code))

    r2 := os.run("printf 'a-b-c'")
    println("out2=[" + r2.out + "]")

    # a non-zero exit with no output.
    r3 := os.run("false")
    println("out3=[" + r3.out + "] code=" + str(r3.code))

    # ---- exec()/exec_out(): the argv path, no shell between here and the kernel.
    #
    # THE CALLEE IS PLATFORM-PICKED, and picked by PROBING rather than by any
    # build-time switch (the language has no conditional compilation). POSIX
    # guarantees /bin/sh at an absolute path; a native Windows binary cannot
    # resolve that path at all, and there cmd.exe is what PATH is guaranteed to
    # find. The probe below is itself the first assertion -- it is an exec call,
    # so a platform where exec is broken lands in neither branch cleanly.
    posix := os.exec(["/bin/sh", "-c", "exit 0"]) == 0
    println("posix=" + str(posix))

    if posix:
        println("e_exit7=" + str(os.exec(["/bin/sh", "-c", "exit 7"])))
        e := os.exec_out(["/bin/sh", "-c", "printf hello"])
        println("e_out=[" + e.out + "] code=" + str(e.code))

        # THE SECURITY PROPERTY, asserted rather than assumed. Through os.run
        # this same text is two commands and the second one runs; through exec
        # it is one ORDINARY ARGUMENT and printf emits it verbatim. Both halves
        # are checked, so the test fails if exec ever grows a shell underneath.
        # (`arg` is the explicit copy the compiler asks for when an aggregate
        # captures a binding that is still live -- `hostile` is used twice)
        hostile := "; printf INJECTED"
        si := os.run("printf %s '' " + hostile)
        println("sh_arg=[" + si.out + "]")
        arg := hostile
        ei := os.exec_out(["/bin/sh", "-c", "printf %s \"$1\"", "sh", arg])
        println("e_arg=[" + ei.out + "]")

        # an argument carrying spaces stays exactly one argument.
        es := os.exec_out(["/bin/sh", "-c", "printf %s \"$1\"", "sh", "a b c"])
        println("e_space=[" + es.out + "]")

        # THE COUNT, not just the contents: a callee ignores arguments it was not
        # asked about, so an argv one entry too LONG (a lost NULL terminator on
        # the shim's execv vector) changes nothing the lines above print. Every
        # other assertion here passed with that bug injected; this one did not.
        ec := os.exec_out(["/bin/sh", "-c", "printf %s $#", "sh", "a b c"])
        println("e_argc=[" + ec.out + "]")

        # Capture keeps the streams apart. The second case writes 200 KB to
        # stderr BEFORE stdout: a sequential reader deadlocks on it, so this is
        # the test that the drain is concurrent.
        cap := os.exec_capture(["/bin/sh", "-c", "printf out; printf err >&2; exit 3"])
        println("cap=[" + cap.out + "][" + cap.err + "] code=" + str(cap.code))
        big := os.exec_capture(["/bin/sh", "-c", "head -c 200000 /dev/zero | tr '\\0' e >&2; printf out"])
        early := -1
        if len(big.err) > 0:
            early = big.err[0]
        println("cap_big_out=[" + big.out + "] errlen=" + str(len(big.err)) + " err0=" + str(early) + " code=" + str(big.code))
    else:
        # Windows. cmd.exe is the CALLEE, never an interposed shell -- exec
        # spawns it directly with CreateProcess, so the argv below is what it
        # receives. The round-trip-a-hostile-argument assertion has no Windows
        # half: it needs a program that echoes argv WITHOUT re-parsing it, and
        # Windows guarantees none (cmd's own `echo` re-parses, which is the
        # documented callee-side caveat in os_shim.c). The quoting algorithm is
        # checked directly against CommandLineToArgvW instead -- see the shim.
        println("e_exit7=" + str(os.exec(["cmd", "/c", "exit 7"])))
        w := os.exec_out(["cmd", "/c", "echo hello"])
        println("e_out=[" + strings.trim(w.out) + "] code=" + str(w.code))

    # fail closed, three ways: an empty argv, and a program that does not exist,
    # both -1 -- and never a fallback to the shell. Identical on both platforms.
    println("e_empty=" + str(os.exec([]string)))
    println("e_nosuch=" + str(os.exec(["/nonexistent/prog"])))
    en := os.exec_out(["/nonexistent/prog"])
    println("e_nosuch_out=[" + en.out + "] code=" + str(en.code))
    ec0 := os.exec_capture([]string)
    ecn := os.exec_capture(["/nonexistent/prog"])
    println("e_cap_empty=[" + ec0.out + "][" + ec0.err + "] code=" + str(ec0.code))
    println("e_cap_nosuch=[" + ecn.out + "][" + ecn.err + "] code=" + str(ecn.code))

    nc := "printf NULBAD" + chr(0) + "; printf TAIL"
    println("nul_system=" + str(os.system(nc)))
    nr := os.run(nc)
    println("nul_run=[" + nr.out + "] code=" + str(nr.code))
    println("nul_exec=" + str(os.exec(["printf", "NULBAD" + chr(0) + "TAIL"])))
    nx := os.exec_out(["printf", "NULBAD" + chr(0) + "TAIL"])
    println("nul_exec_out=[" + nx.out + "] code=" + str(nx.code))
    if posix:
        slash := chr(92)
        rn := os.run("printf 'A" + slash + "000B'")
        enul := os.exec_out(["/usr/bin/printf", "A" + slash + "000B"])
        println("nul_child_run=" + str(len(rn.out)) + "," + str(rn.out[1] == 0) + "," + str(rn.out[2]))
        println("nul_child_exec=" + str(len(enul.out)) + "," + str(enul.out[1] == 0) + "," + str(enul.out[2]))
    else:
        println("nul_child_output=windows-unavailable")

    # ---- environment: unset is None, set-empty is Some("") ----
    ename := "TYCHO_CORELIB_OS_ENV_TEST"
    println("env_clear=" + show_os(os.unset_env(ename)))
    println("env_absent=" + show_opt(os.env(ename)))
    rset := os.set_env(ename, "v1")
    vset := os.env(ename)
    println("env_set=" + show_os(rset) + " value=" + show_opt(vset))
    rempty := os.set_env(ename, "")
    vempty := os.env(ename)
    println("env_empty=" + show_os(rempty) + " value=" + show_opt(vempty))
    runset := os.unset_env(ename)
    vunset := os.env(ename)
    println("env_unset=" + show_os(runset) + " value=" + show_opt(vunset))
    enone := os.env("")
    eset := os.set_env("", "x")
    eeq := os.set_env("A=B", "x")
    println("env_badname=" + show_opt(enone) + " set=" + show_os(eset) + " eq=" + show_os(eeq))
    rnul := os.set_env(ename, "a" + chr(0) + "b")
    vnul := os.env(ename)
    println("env_nulvalue=" + show_os(rnul) + " value=" + show_opt(vnul))

    # ---- cwd/chdir: round-trip, then the refusal paths ----
    before := ""
    match os.cwd():
        Ok(v): before = v
        Err(_): pass
    println("cwd_ok=" + show_cwd(os.cwd()))
    base := os.temp_dir() + "/tycho_os_test_" + str(os.pid())
    match io.make_dir_all(base):
        Ok(_): pass
        Err(_): pass
    cdt := os.chdir(base)
    cdw := os.cwd()
    println("chdir_temp=" + show_os(cdt) + " cwd=" + show_cwd(cdw))
    println("chdir_back=" + show_os(os.chdir(before)))
    println("chdir_missing=" + show_os(os.chdir(base + "/absent")))
    println("chdir_empty=" + show_os(os.chdir("")))
    io.write(base + "/perm", "x")
    println("chmod=" + show_os(os.chmod(base + "/perm", 384)))
    println("chmod_missing=" + show_os(os.chmod(base + "/absent", 384)))
    println("chmod_nul=" + show_os(os.chmod("x" + chr(0), 384)))
    oldmask := os.umask(0)
    restored := os.umask(oldmask)
    println("umask_restore=" + str(restored == 0))
    if posix:
        println("ids=" + str(os.uid() >= 0) + "," + str(os.euid() >= 0) + "," + str(os.gid() >= 0) + "," + str(os.egid() >= 0) + " ppid=" + str(os.ppid() > 0))
    else:
        println("ids=windows")
    match io.remove(base + "/perm"):
        Ok(_): pass
        Err(_): pass
    match io.remove(base):
        Ok(_): pass
        Err(_): pass

    println("pid_positive=" + str(os.pid() > 0))
    hn := false
    match os.hostname():
        Some(h): hn = len(h) > 0
        None: pass
    println("hostname_nonempty=" + str(hn))
    home := false
    match os.home_dir():
        Some(h): home = len(h) > 0
        None: pass
    println("home_nonempty=" + str(home))
    println("temp_nonempty=" + str(len(os.temp_dir()) > 0))
    println("dirs=" + str(len(os.cache_dir()) > 0) + "," + str(len(os.config_dir()) > 0) + "," + str(len(os.data_dir()) > 0))
