# corelib test: exercises core:io; the output is locked to corelib/test/io.out
# (corelib/run.sh). The tychoc0 cross-check this line used to claim was retired
# 2026-07-29.
#
# Filesystem side effects are confined to two fixed throwaway paths under /tmp
# (never the repo). Each run truncates first, so output is deterministic; the
# exists/list checks use repo-relative paths (the harness runs with cwd = repo
# root) and test membership only, never directory order.
package main
import "core:io"
import "core:result"
# No core:os here any more. Until 2026-07-26 this test imported it to run
# os.system("rm -rf ... && mkdir -p ..."), because the corelib could not make a
# directory -- a corelib test shelling out to /bin/sh to set up a syscall test.
# io.make_dir / io.remove replaced it (the option-result plan).

fn b2i(b: bool) -> int:
    if b:
        return 1
    return 0

# REGRESSION (the friction plan): a returned string that ALIASES a scope-owned
# `bytes` must be re-homed into the caller's arena. `to_str` is a zero-cost
# reinterpret, so `out` here IS `b`'s buffer -- but the compiler reported the
# initializer as a call (a "fresh value"), skipped the copy, and freed the scope
# before returning. Measured before the fix: this printed `[8]` for a buffer
# holding "ABCDEFGH". Nothing about this shape needs core:io; it lives here
# because `io.read_bytes` is how a real program gets a scope-owned `bytes`.
fn reinterp_ret(cs: [int]) -> string:
    b := to_bytes(cs)
    out := to_str(b)
    return out

# The two collapses a Result caller needs, now that io.read_bytes returns one.
# main() is void, so `or_return` cannot short-circuit out of it; core:result's
# combinators are the one-line alternative to a `match` per call site.
fn nb(r: Result(bytes, io.IoErr)) -> int:
    return len(result.unwrap_or(r, to_bytes("")))

# The same collapse, but keeping the CONTENT. read_at's fixture below writes the
# file it reads, so its slices can be compared as letters rather than counted --
# a wrong offset then prints the wrong letter instead of the right length.
fn sl(r: Result(bytes, io.IoErr)) -> string:
    return to_str(result.unwrap_or(r, to_bytes("")))

# WHICH outcome, as a stable string. One arm per cause, since the friction plan;
# this was `is_ok` + `err_or` plus three `e == io.X` comparisons, because
# `Err(io.IsDir)` did not parse as a match arm. The old note here said this could
# be written HERE and not in corelib/io itself because no runner fed corelib/test/
# to the frozen compiler/tychoc0.ty. That constraint died with the tychoc0 lanes on
# 2026-07-29 and nothing builds tychoc0 now, so nested patterns are writable
# anywhere -- tests/nested_pattern.ty is the construct's own fixture under the main
# golden loop. This arm stays here because it is the core:io lane, not because
# anything forbids it elsewhere.
fn why(r: Result(bytes, io.IoErr)) -> string:
    match r:
        Ok(bs): return "Ok"
        Err(io.NotFound): return "NotFound"
        Err(io.IsDir): return "IsDir"
        _: return "Failed"

# The same collapse for is_dir's Result(bool, IoErr). Note there is no IsDir arm:
# being a directory is Ok(true) here, not a failure.
fn dwhy(r: Result(bool, io.IoErr)) -> string:
    match r:
        Ok(isdir):
            if isdir:
                return "dir"
            return "file"
        Err(io.NotFound): return "NotFound"
        _: return "Failed"

# make_dir / remove: the same Result(bool, IoErr), but Ok's boolean means "did the
# filesystem change" rather than "is it a directory" -- so it gets its own labels.
# `did` = created/removed, `already` = it was already in the asked-for state (both
# successes). Err(Exists) is make_dir's only extra variant.
fn fswhy(r: Result(bool, io.IoErr)) -> string:
    match r:
        Ok(changed):
            if changed:
                return "did"
            return "already"
        Err(io.NotFound): return "NotFound"
        Err(io.Exists): return "Exists"
        _: return "Failed"

# mtime's Result(int, IoErr). No IsDir arm is REACHED -- a directory is Ok here,
# the same shape is_dir has -- but the arm is written so the golden would move if
# that ever changed silently.
fn mwhy(r: Result(int, io.IoErr)) -> string:
    match r:
        Ok(secs): return "Ok"
        Err(io.NotFound): return "NotFound"
        Err(io.IsDir): return "IsDir"
        _: return "Failed"

# The same collapse for read_text's Result(string, ...). A second copy because a
# Result's OK type is part of its identity -- FRICTION.md's "two error types
# cannot share an or_return chain" is the same shape seen from the error side.
fn twhy(r: Result(string, io.IoErr)) -> string:
    match r:
        Ok(s): return "Ok"
        Err(io.NotFound): return "NotFound"
        Err(io.IsDir): return "IsDir"
        _: return "Failed"

fn jn(xs: [string]) -> string:                 # join with '|' for stable printing
    out := ""
    for i := 0; i < len(xs); i += 1:
        if i > 0:
            out = out + "|"
        out = out + xs[i]
    return out

fn addlen(acc: int, line: string) -> int:      # a fold_lines reducer
    return acc + len(line)

fn main():
    tmp := "/tmp/tycho_corelib_io_selftest.txt"

    # write_bytes: the binary write side of read_bytes. Interior NULs survive
    # (chr(0) is a real byte in a string -- the sha256 padding relies on it),
    # and the missing-path / directory answers match read_bytes'.
    wb := io.write_bytes(tmp, to_bytes("a" + chr(0) + "b"))
    rbb := io.read_bytes(tmp)
    wok := 0
    wlen := -1
    wa := -1
    match wb:
        Ok(v):
            wok = b2i(v)
        Err(e):
            wok = 0
    match rbb:
        Ok(b):
            wlen = len(b)
            if wlen == 3:
                wa = b[0] * 256 + b[2]
        Err(e):
            wlen = -1
    wmiss := io.write_bytes("/tmp/tycho_corelib_io_no_dir_xyz/f", to_bytes(""))
    wdir := io.write_bytes("/tmp", to_bytes(""))
    wmiss_k := 0
    wdir_k := 0
    match wmiss:
        Err(NotFound):
            wmiss_k = 1
        _:
            wmiss_k = 0
    match wdir:
        Err(IsDir):
            wdir_k = 1
        _:
            wdir_k = 0
    println(f"wb_ok={wok} len={wlen} ab={wa} miss={wmiss_k} dir={wdir_k}")

    # write_at: the positional write, the sibling of read_at. Writing at an
    # offset leaves the surrounding bytes untouched (in-place page updates);
    # beyond the current end extends. The file exists (write_bytes just made
    # it) -- the create-if-absent case is the store's init, exercised there.
    wat1 := io.write_at(tmp, 1, to_bytes("X"))
    rat1 := io.read_bytes(tmp)
    watk := 0
    wat1k := 0
    wat2k := 0
    match wat1:
        Ok(v):
            watk = b2i(v)
        Err(e):
            watk = 0
    match rat1:
        Ok(b):
            if len(b) == 3 and b[0] == 97 and b[1] == 88 and b[2] == 98:  # aXb
                wat1k = 1
        Err(e):
            wat1k = 0
    wat2 := io.write_at(tmp, 5, to_bytes("Z"))
    rat2 := io.read_bytes(tmp)
    match rat2:
        Ok(b):
            if len(b) == 6 and b[5] == 90:                                 # ...Z
                wat2k = 1
        Err(e):
            wat2k = 0
    println(f"wat_ok={watk} ins={wat1k} ext={wat2k}")

    # write truncates; read returns the exact bytes; append extends
    w1 := io.write(tmp, "hello\nworld\n")
    body := io.read(tmp)
    w2 := io.append(tmp, "again\n")
    ls := io.read_lines(tmp)
    println(f"write={b2i(w1)} bytes={len(body)} append={b2i(w2)} lines={len(ls)}")
    println("joined=" + jn(ls))

    # write_lines / read_lines round-trip (each line newline-terminated)
    w3 := io.write_lines(tmp, ["a", "b", "c"])
    rl := io.read_lines(tmp)
    println(f"wl={b2i(w3)} rl={len(rl)} " + jn(rl))

    # streaming line reader: one line at a time (bounded memory), round-tripping
    # the content write_lines wrote. An empty middle line stays Some("").
    w4 := io.write_lines(tmp, ["one", "", "three"])
    lr := io.open_lines(tmp)
    sn := 0
    sj := ""
    if not is_null(lr):
        d := false
        for not d:
            match io.read_line(lr):
                Some(s):
                    if sn > 0:
                        sj = sj + "|"
                    sj = sj + s
                    sn = sn + 1
                None:
                    d = true
        io.close_lines(lr)
    println(f"open={b2i(w4)} stream_lines={sn} " + sj)
    # fold_lines: bounded streaming reduce; a missing file folds to init
    tot := io.fold_lines(tmp, 0, addlen)
    missfold := io.fold_lines("/tmp/tycho_corelib_io_absent.xyz", 7, addlen)
    println(f"fold_sumlen={tot} fold_missing={missfold}")

    # read_bytes: binary-safe whole-file read (interior NUL bytes preserved), and
    # the point of the Result -- the four lines below were ALL "empty bytes"
    # before 2026-07-26. An empty file is a success; missing and a directory are
    # not, and they no longer look like each other.
    binf := "/tmp/tycho_corelib_io_bin.dat"
    io.write(binf, "AB" + chr(0) + "CD")
    emptyf := "/tmp/tycho_corelib_io_empty.dat"
    io.write(emptyf, "")
    rb := io.read_bytes(binf)
    rbe := io.read_bytes(emptyf)
    rbmiss := io.read_bytes("/tmp/tycho_corelib_io_absent.xyz")
    rbdir := io.read_bytes("/tmp")
    println(f"read_bytes len={nb(rb)} why={why(rb)}")
    println(f"read_empty len={nb(rbe)} why={why(rbe)}")
    println(f"read_missing len={nb(rbmiss)} why={why(rbmiss)}")
    println(f"read_dir len={nb(rbdir)} why={why(rbdir)}")

    # The `bytes` operators (the friction plan), on the buffer io.read_bytes just
    # handed back -- 5 bytes, with an interior 0x00 at index 2. This is the one
    # property that would break if any of the three went through NUL-terminated
    # code: b[2] would abort or read past, len(b[1:4]) would be 1, and a concat
    # would stop at the NUL. This used to say the case CANNOT live in tests/,
    # because the frozen tychoc0 rejected `b[i]` with "str(x) can't stringify a
    # yte" and every tests/*.ty was fed to it. That block expired 2026-07-29 with
    # the tychoc0 lanes, so tests/ is now merely a place this COULD go. It stays
    # here on §E.1's convention -- a package's own lane covers the package, and
    # nothing moves merely because it now could. The §3.9.4 interior-NUL clause
    # already has its own tests/ witnesses for the string side (tests/string_nul,
    # tests/strbytes); §5.2.6's `bytes` operators are witnessed by this lane, the
    # §5.2.6 spec example and server/main.ty's log_safe, per the Appendix E row --
    # whose surrounding note is still written as if tychoc0 ran (the loops-cleanup plan).
    bb := result.unwrap_or(rb, to_bytes(""))
    b0 := bb[0]
    bnul := bb[2]                        # the interior NUL, read as 0
    blast := bb[4]
    println(f"byte_index b0={b0} b2={bnul} b4={blast}")
    span := bb[1:4]                      # "B" NUL "C" -- a slice ACROSS the NUL
    println(f"byte_slice len={len(span)} s0={span[0]} s1={span[1]} s2={span[2]}")
    both := bb + span + '!'              # bytes+bytes, then bytes+char
    println(f"byte_cat len={len(both)} at5={both[5]} at8={both[8]} eqsrc={b2i(both[0:5] == bb)}")
    # byte-at-a-time rebuild: the shape a scrubber uses, and the accumulator the
    # compiler now grows in place for bytes as it does for string.
    acc := to_bytes("")
    for i := 0; i < len(bb); i += 1:
        acc = acc + bb[i:i + 1]
    println(f"byte_rebuild len={len(acc)} same={b2i(acc == bb)} clamped={len(bb[3:99])}")
    # the re-home regression above: call it, then churn the arena hard enough that
    # a dangling buffer would be overwritten, THEN read the result.
    codes := []int
    for i := 0; i < 8; i += 1:
        push(codes, 65 + i)
    held := reinterp_ret(codes)
    churn := ""
    for i := 0; i < 400; i += 1:
        churn += "ZZZZZZZZZZZZZZZZ"
    println(f"reinterp_ret=[{held}] len={len(held)} churn={len(churn)}")

    # is_dir: the stat(2) the corelib went without until 2026-07-26. The EMPTY
    # directory is the whole point -- `len(io.list(p)) > 0`, the only directory
    # test that existed before, calls it a FILE, which is the wrong answer a real
    # server shipped (the option-result plan). Ok(true) and Ok(false) are both successes;
    # only "nothing there" is an Err.
    #
    # The empty directory is now made with io.make_dir -- no os.system, no /bin/sh.
    # The two unprinted removes ahead of it make the run deterministic whatever a
    # previous (or crashed) run left behind, INNER FIRST because io.remove is not
    # recursive: a non-empty directory is Err(Failed), by design.
    edir := "/tmp/tycho_corelib_io_emptydir"
    inner := edir + "/inner.txt"
    pre1 := io.remove(inner)             # unprinted: prior state is unknown
    pre2 := io.remove(edir)              # unprinted: ditto
    mk := io.make_dir(edir)              # did: created
    mkagain := io.make_dir(edir)         # already: EEXIST on a directory is the goal
    mkonfile := io.make_dir(binf)        # Exists: EEXIST on a plain file is not
    mkdeep := io.make_dir("/tmp/tycho_corelib_io_absent.xyz/child")   # NotFound: no parent
    println(f"mkdir={fswhy(mk)} again={fswhy(mkagain)} onfile={fswhy(mkonfile)} noparent={fswhy(mkdeep)}")
    dfull := io.is_dir("/tmp")
    dempty := io.is_dir(edir)
    dfile := io.is_dir(binf)
    dmiss := io.is_dir("/tmp/tycho_corelib_io_absent.xyz")
    println(f"isdir_tmp={dwhy(dfull)} isdir_empty={dwhy(dempty)}")
    println(f"isdir_file={dwhy(dfile)} isdir_missing={dwhy(dmiss)}")
    # the same empty directory through the OLD test, side by side: this line IS the
    # wrong answer, and the line above it is the right one.
    println(f"list_empty={len(io.list(edir))} old_test_says_dir={b2i(len(io.list(edir)) > 0)}")

    # remove: single-entry, and the test cleans up after itself. `rm -rf` used to be
    # the only way to do this. The middle line is the reason there is no recursive
    # variant -- a non-empty directory is Err(Failed), not a silently deleted tree.
    wi := io.write(inner, "x")
    rmfull := io.remove(edir)            # Failed: ENOTEMPTY, inner.txt is in it
    rminner := io.remove(inner)          # did: a file
    rmdir := io.remove(edir)             # did: an empty directory
    rmgone := io.remove(edir)            # already: nothing there is not a failure
    println(f"wrote_inner={b2i(wi)} rm_nonempty={fswhy(rmfull)} rm_file={fswhy(rminner)}")
    println(f"rm_dir={fswhy(rmdir)} rm_again={fswhy(rmgone)} left={b2i(io.exists(edir))}")

    # a missing file reads as ""
    miss := io.read("/tmp/tycho_corelib_io_absent.xyz")
    println(f"missing=[{miss}] len={len(miss)}")

    # exists, one stat(2) since the friction plan (it was list_dir membership; these
    # four answers are unchanged by the swap, which is what the golden proves).
    # Repo-relative paths; string-literal args bound to locals first -- f-string
    # holes can't hold a string literal.
    es := b2i(io.exists("corelib/test/io/main.ty"))
    en := b2i(io.exists("corelib/test/io/nope.xyz"))
    println(f"exists_self={es} exists_no={en}")
    emk := b2i(io.exists("Makefile"))
    lge := b2i(len(io.list("corelib/test/io")) >= 1)
    println(f"exists_mk={emk} list_ge1={lge}")

    # mtime: the stat(2) field iox_stat_kind was fetching and discarding until
    # 2026-07-31. NOTHING HERE CAN ASSERT AN EXACT EPOCH -- the file is written by
    # this run, so the value is different every time and a golden cannot hold it.
    # What the golden holds instead is the four properties that ARE stable:
    #
    #   ok         the call succeeds on a file this run just wrote
    #   sane       the value is a real timestamp, not 0 and not a status code
    #              leaking through the return -- 1600000000 is 2020-09-13, so any
    #              machine whose clock is roughly right passes and a 0/2/3 fails
    #   notfuture  it is <= now(), the same clock, so an mtime from the future
    #              (a bad cast, a nanosecond field read as seconds) fails
    #   grew       a REWRITE is >= the first reading, which is what proves the
    #              value tracks the file rather than being a constant. `>=` not
    #              `>`: both writes land inside one second on any fast machine,
    #              and st_mtime is truncated to seconds.
    mt1 := io.mtime(tmp)
    s1 := result.unwrap_or(mt1, 0)
    ww := io.write(tmp, "touched")
    s2 := result.unwrap_or(io.mtime(tmp), 0)
    println(f"mtime={mwhy(mt1)} sane={b2i(s1 > 1600000000)} notfuture={b2i(s1 <= now())} grew={b2i(ww and s2 >= s1)}")
    # the error path, and the deliberate non-error: a directory is Ok, because a
    # directory HAS a modification time and stat(2) reports it.
    mtmiss := io.mtime("/tmp/tycho_corelib_io_absent.xyz")
    mtdir := io.mtime("/tmp")
    println(f"mtime_missing={mwhy(mtmiss)} mtime_dir={mwhy(mtdir)}")

    # set_mtime: the write side, added for FRICTION #8 -- an mtime could be READ
    # and recorded into an archive, and nothing could put it back on extract.
    # Unlike mtime above this CAN assert an exact epoch, and that is the whole
    # point: 1416470400 is a value this run did not produce, so `exact` fails if
    # the call is a no-op that leaves the write-time stamp in place.
    # set_missing is the case that MUST fail -- setting a time on a path that is
    # not there is Err(NotFound), not a silent success and not a created file.
    sdir := "/tmp/tycho_corelib_io_mtdir"
    _ := io.make_dir(sdir)
    sm := io.set_mtime(tmp, 1416470400)
    back := result.unwrap_or(io.mtime(tmp), 0)
    smmiss := io.set_mtime("/tmp/tycho_corelib_io_absent.xyz", 1416470400)
    smdir := io.set_mtime(sdir, 1416470400)
    stillmiss := io.exists("/tmp/tycho_corelib_io_absent.xyz")
    println(f"set_mtime={fswhy(sm)} exact={b2i(back == 1416470400)} set_missing={fswhy(smmiss)} made_nothing={b2i(not stillmiss)}")
    dback := result.unwrap_or(io.mtime(sdir), 0)
    srm := io.remove(sdir)
    println(f"set_dir={fswhy(smdir)} dir_back={b2i(dback == 1416470400)} rm={fswhy(srm)}")

    # ---- read_at: pread(2) at an absolute offset -------------------------------
    # Unlike mtime above, this CAN be asserted exactly: the fixture writes the file
    # it reads, so every case below compares LETTERS, not just a length. 26 bytes,
    # byte i == 'A'+i, so an off-by-one offset prints the wrong letter rather than
    # the right count -- which a length-only assertion would pass.
    alpha := "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    rf := "/tmp/tycho_corelib_io_range.dat"
    wrf := io.write(rf, alpha)
    mid := io.read_at(rf, 5, 5)                  # FGHIJ -- an ordinary interior slice
    whole := io.read_at(rf, 0, 26)               # the whole file, through the offset path
    println(f"read_at=[{sl(mid)}] why={why(mid)} whole={b2i(wrf and sl(whole) == alpha)}")

    # BOUNDARY 1 -- an offset PAST EOF is Ok with zero bytes, not an error. That is
    # pread(2)'s own answer, and it is a complete one: the caller chose the offset,
    # so this empty is not the ambiguous empty read_bytes was fixed for. Asserted at
    # EOF exactly (26, the first offset with nothing at it) and far past it.
    at_eof := io.read_at(rf, 26, 5)
    past := io.read_at(rf, 1000, 5)
    println(f"at_eof len={nb(at_eof)} why={why(at_eof)} past len={nb(past)} why={why(past)}")

    # BOUNDARY 2 -- a length running PAST EOF is a SHORT READ: Ok, unpadded, and
    # len() is how the caller learns how much it got. The letters matter here: the
    # six returned must be the LAST six, not the first six.
    short := io.read_at(rf, 20, 100)
    println(f"short=[{sl(short)}] len={nb(short)} why={why(short)}")

    # BOUNDARY 3 -- a NEGATIVE offset is Err(Failed) and never reaches pread(2); it
    # is refused in the shim ahead of open(2), so no off_t width can sign-extend it
    # into a wild read. A negative LENGTH is refused the same way. Neither gets its
    # own IoErr variant: both are unreachable from correct code.
    negoff := io.read_at(rf, -1, 5)
    negn := io.read_at(rf, 0, -1)
    println(f"negoff={why(negoff)} len={nb(negoff)} negn={why(negn)} len={nb(negn)}")

    # A zero length is Ok(empty). And the case that matters once the length comes
    # off the wire: a length far larger than the file allocates the FILE's remaining
    # bytes, not the asked-for count. Without the clamp in iox_read_at this line is
    # a one-terabyte malloc; with it, it reads 26 bytes and prints them.
    zero := io.read_at(rf, 0, 0)
    huge := io.read_at(rf, 0, 1000000000000)
    println(f"zerolen len={nb(zero)} why={why(zero)} huge=[{sl(huge)}] why={why(huge)}")

    # the two non-file paths, answering exactly as read_bytes does for the same two
    ramiss := io.read_at("/tmp/tycho_corelib_io_absent.xyz", 0, 4)
    radir := io.read_at("/tmp", 0, 4)
    println(f"read_at_missing={why(ramiss)} read_at_dir={why(radir)}")

    # ---- size: the file's length, WITHOUT reading the file ---------------------
    # read_at's fixture asserts letters so a wrong offset prints wrong letters. A
    # size fixture is the inverse -- the NUMBER is the assertion -- so the file has
    # to have a length that is unambiguous in this source rather than a property of
    # the machine. `alpha` above is the 26 letters of the alphabet, written by this
    # run, so 26 is a fact of the fixture. It is ALSO cross-checked against
    # len(read_bytes) on the same file -- the read-the-whole-thing way this call
    # exists to replace -- so a size that disagrees with the bytes actually present
    # fails even if the literal 26 were wrong. Both must hold.
    sz := io.size(rf)
    szn := result.unwrap_or(sz, -1)
    println(f"size={mwhy(sz)} n={szn} is26={b2i(szn == 26)} agrees={b2i(szn == nb(io.read_bytes(rf)))}")

    # A ZERO-LENGTH FILE IS Ok(0), and "0" must never be confusable with "failed".
    # That is what the shim's return/out-param split buys: the status rides the
    # return, so a failure is an Err and cannot arrive as a small number. Printed
    # as the PAIR (why, n) for exactly that reason -- an Err collapsing through
    # unwrap_or would read `Failed n=-1`, and a status leaking into the payload
    # would read `Ok n=1`. Only `Ok n=0` passes. A static server meets this file
    # for real and owes it a 200 with Content-Length: 0, not a 500.
    ef := "/tmp/tycho_corelib_io_empty.dat"
    wef := io.write(ef, "")
    esz := io.size(ef)
    esn := result.unwrap_or(esz, -1)
    println(f"size_empty={mwhy(esz)} n={esn} wrote={b2i(wef)} readlen={nb(io.read_bytes(ef))}")

    # The error path, and the one answer where size deliberately DIFFERS from
    # mtime: a directory is Err(IsDir) here and Ok above. st_size on a directory is
    # the size of its own entry structure, not a count of readable bytes, so
    # reporting it would hand a Range caller a length no read could ever produce.
    # These two golden lines and mtime_dir=Ok together are the record of that.
    szmiss := io.size("/tmp/tycho_corelib_io_absent.xyz")
    szdir := io.size("/tmp")
    println(f"size_missing={mwhy(szmiss)} size_dir={mwhy(szdir)}")

    # read_text: read()'s content WITH the error channel read() lacks. read()
    # answers "" for a missing file, an unreadable one and a genuinely empty
    # one -- three different facts flattened into one value. These three lines
    # are the record that read_text keeps them apart.
    println(f"text_ok={twhy(io.read_text(ef))} len={len(result.unwrap_or(io.read_text(ef), "x"))}")
    println(f"text_missing={twhy(io.read_text("/tmp/tycho_corelib_io_absent.xyz"))}")
    println(f"text_dir={twhy(io.read_text("/tmp"))}")
    # and read() itself, fail-open, for the contrast the entry above is about
    println(f"read_missing_len={len(io.read("/tmp/tycho_corelib_io_absent.xyz"))}")
