package main
# corelib test: the GENERIC core:iter across int / string / float, with plain fns
# and capturing closures. The output is locked to corelib/test/iter.out
# (corelib/run.sh). The "all three compile paths" this line used to claim were tychoc
# plus two tychoc0 legs; both tychoc0 legs were retired 2026-07-29.
import "core:iter"
import "core:arrays"

fn b2i(b: bool) -> int:
    if b:
        return 1
    return 0

fn dbl(x: int) -> int:
    return x + x

fn itos(x: int) -> string:      # a NAMED fn whose result type differs from its argument's
    return str(x)

fn nonempty(s: string) -> bool:
    return len(s) > 0

# The fallible half. The payload carries the offending element, so the golden
# says WHICH error came out; `999` dies, so walking past the first error kills
# the program instead of quietly producing a different line.
enum Odd:
    NotEven(int)

fn which(e: Odd) -> int:
    match e:
        NotEven(x): return x

fn half(x: int) -> Result(int, Odd):
    if x == 999:
        die("try_map walked past the first error")
    if x % 2 != 0:
        return Err(NotEven(x))
    return Ok(x / 2)

fn keep_even(x: int) -> Result(bool, Odd):   # a bool like `filter`'s keep, but fallible
    if x == 999:
        die("try_filter walked past the first error")
    if x < 0:
        return Err(NotEven(x))
    return Ok(x % 2 == 0)

fn main():
    xs := [1, 2, 3, 4, 5]
    println("map=" + arrays.join(iter.map(xs, dbl), ","))                          # 2,4,6,8,10
    thr := 10
    println("mapcl=" + arrays.join(iter.map(xs, fn(x: int) -> int: x + thr), ","))  # capturing closure
    println("filter=" + arrays.join(iter.filter(xs, fn(x: int) -> bool: x % 2 != 0), ",")) # odds
    # `a*2+b` on purpose: the old `a+b` read 15 for a right fold, swapped args or a reversed walk.
    println("foldl=" + str(iter.reduce(xs, 0, fn(a: int, b: int) -> int: a * 2 + b)))  # 57 left, 30 swapped, 129 reversed
    lim := 3
    # BOTH answers: `x > 0` holds for every element, `x > 9` for none, so inverting `any`'s
    # test turns 1,0 into 0,1. The old `x != 2` over [1,2,3,4,5] read 1 under either sense.
    println("count!=" + str(iter.count(xs, fn(x: int) -> bool: x != lim)) + " any>0=" + str(b2i(iter.any(xs, fn(x: int) -> bool: x > 0))) + " any>9=" + str(b2i(iter.any(xs, fn(x: int) -> bool: x > 9))))
    # string instance (map closure + named predicate). 3 non-empty of 4: a 2/2 split read 2 inverted too.
    ws := ["hi", "", "yo", "x"]
    println("smap=" + arrays.join(iter.map(ws, fn(s: string) -> string: s + "!"), ",") + " scount=" + str(iter.count(ws, nonempty)))
    # float instance (reduce)
    fs := [1.0, 2.0, 3.0]
    println("freduce=" + str(iter.reduce(fs, 0.0, fn(a: float, b: float) -> float: a * 2.0 + b)))   # 11.0; a+b read 6.0 in any fold order
    # TYPE-CHANGING map: [$T] -> [$U]. `map` was `fn($T) -> $T` until 2026-07-31,
    # which rejected every one of these three. Named fn, closure, and the reverse
    # direction, so a regression to one type variable cannot pass this file.
    println("i2s=" + arrays.join(iter.map(xs, itos), ","))                                     # 1,2,3,4,5 as strings
    println("i2f=" + arrays.join(iter.map(xs, fn(x: int) -> float: to_float(x) / 2.0), ","))   # 0.5,...
    println("s2i=" + arrays.join(iter.map(ws, fn(s: string) -> int: len(s)), ","))             # 2,0,2,0
    # FALLIBLE stages. Each must-fail input has TWO failing elements plus the 999
    # sentinel, so a swallow-and-continue implementation reports the wrong one or dies.
    evens := [2, 4, 6]
    match iter.try_map(evens, half):
        Ok(hs): println("trymap ok=" + arrays.join(hs, ","))
        Err(e): println("trymap ok=UNEXPECTED-ERR " + str(which(e)))
    bad := [2, 5, 4, 7, 999]
    match iter.try_map(bad, half):
        Ok(hs): println("trymap err=UNEXPECTED-OK " + arrays.join(hs, ","))
        Err(e): println("trymap err=" + str(which(e)))
    mixed := [1, 2, 3, 4]
    match iter.try_filter(mixed, keep_even):
        Ok(ks): println("tryfilter ok=" + arrays.join(ks, ","))
        Err(e): println("tryfilter ok=UNEXPECTED-ERR " + str(which(e)))
    badf := [2, 3, -3, 4, -7, 999]
    match iter.try_filter(badf, keep_even):
        Ok(ks): println("tryfilter err=UNEXPECTED-OK " + arrays.join(ks, ","))
        Err(e): println("tryfilter err=" + str(which(e)))
