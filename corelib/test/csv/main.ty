package main
import "core:csv"

fn b2i(b: bool) -> int:
    if b:
        return 1
    return 0

fn vis(s: string) -> string:                   # make control bytes visible
    out := ""
    for i := 0; i < len(s); i += 1:
        c := s[i]
        if c == 10:
            out = out + "\\n"
        elif c == 13:
            out = out + "\\r"
        elif c == 9:
            out = out + "\\t"
        else:
            out = out + chr(c)
    return out

fn dump(rows: [[string]]) -> string:           # rows joined by " ; ", fields by "|"
    out := ""
    for r := 0; r < len(rows); r += 1:
        if r > 0:
            out = out + " ; "
        row := rows[r]
        for c := 0; c < len(row); c += 1:
            if c > 0:
                out = out + "|"
            out = out + vis(row[c])
    return out

fn show(label: string, s: string):
    println(label + dump(csv.parse(s)))

fn main():
    # ---- every documented input shape ----
    simple := "a,b,c"
    show("simple    = ", simple)               # a|b|c
    multi := "a,b\nc,d"
    show("multi     = ", multi)                # a|b ; c|d
    trail := "x,y\n"
    show("trailnl   = ", trail)                # x|y  (no empty trailing row)
    blank := "a\n\nb"
    show("blankline = ", blank)                # a ;  ; b
    empties := "a,,c"
    show("empties   = ", empties)              # a||c
    qcomma := "\"a,b\",c"
    show("qcomma    = ", qcomma)               # a,b|c
    qquote := "\"a\"\"b\",c"
    show("qquote    = ", qquote)               # a"b|c
    qnl := "\"a\nb\",c"
    show("qnewline  = ", qnl)                  # a\nb|c
    crlf := "a,b\r\nc,d"                       # `\r` is a string escape since phase 2
    show("crlf      = ", crlf)                 # a|b ; c|d
    qempty := "\"\",x"
    show("qempty    = ", qempty)               # |x
    unterm := "\"ab"
    show("unterm    = ", unterm)               # ab  (fail closed, no crash)

    # ---- empty input -> zero rows ----
    e := csv.parse("")
    println(f"emptyinput rows={len(e)}")       # 0

    # ---- safe accessor get() ----
    rows := csv.parse("a,b\nc,d")
    g00 := csv.get(rows, 0, 0)
    g11 := csv.get(rows, 1, 1)
    goob := csv.get(rows, 9, 9)
    println(f"get 0,0={g00} 1,1={g11} oob=[{goob}]")   # a d []

    # ---- serialize: only fields that need it are quoted ----
    special := [["a,b", "c\"d", "e\nf"], ["plain", "x"]]
    enc := csv.stringify(special)
    println("stringify = " + vis(enc))

    # ---- round-trip: parse(stringify(rows)) == rows ----
    rt := csv.parse(enc)
    same := b2i(dump(rt) == dump(special))
    println("roundtrip = " + dump(rt))
    nrows := len(rt)
    nr0 := len(rt[0])
    nr1 := len(rt[1])
    println(f"rt_ok={same} rows={nrows} r0={nr0} r1={nr1}")
    # ROUND TRIP for the one shape that lost data: a row of ONE EMPTY FIELD.
    # Unquoted it writes a bare line, which parses back as a row with NO fields,
    # so `parse(stringify(rows)) == rows` -- stringify's own stated contract --
    # was false for it and nothing else. Found by differentialing 414 row-sets
    # against Python's csv module, which quotes it for the same reason.
    one_empty := [][string]
    push(one_empty, [""])
    println("one-empty wire=" + str(len(csv.stringify(one_empty))) + " back=" +
        str(len(csv.parse(csv.stringify(one_empty))[0])))
    # The controls: an EMPTY ROW still has no fields, and a two-field row of
    # empties is unaffected -- so this cannot become "quote every empty field".
    empty_row := [][string]
    push(empty_row, []string)
    println("empty-row back=" + str(len(csv.parse(csv.stringify(empty_row)))))
    two := [][string]
    push(two, ["", ""])
    println("two-empty wire=" + csv.stringify(two)[0:len(csv.stringify(two)) - 1] +
        " back=" + str(len(csv.parse(csv.stringify(two))[0])))
    # A field starting = + - @ is a FORMULA to Excel and Sheets. stringify writes
    # it verbatim, like Python's csv and Go's, and that passthrough is pinned:
    # the safe fix mangles the value and would break parse(stringify(rows))==rows,
    # so it belongs to the caller (see the header). If this is ever changed, the
    # change must be deliberate rather than a drive-by "hardening".
    inj := [["=cmd|' /c calc'!A1"], ["+1"], ["-2"], ["@SUM(1)"]]
    txt := csv.stringify(inj)
    print("inj_verbatim=" + str(txt == "=cmd|' /c calc'!A1\n+1\n-2\n@SUM(1)\n") + "\n")
    irt := csv.parse(txt)
    print("inj_roundtrip=" + str(len(irt) == 4 and irt[0][0] == inj[0][0] and irt[3][0] == inj[3][0]) + "\n")
