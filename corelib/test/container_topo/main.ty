package main
import "core:container"

fn show(r: Result([int], container.TopoErr)) -> string:
    match r:
        Ok(xs):
            out := ""
            for x in xs:
                out = out + str(x) + " "
            return out
        Err(container.Cycle): return "Cycle"

fn main():
    println("dag=" + show(container.topo_sort(5, [(0, 1), (0, 2), (1, 3), (2, 3), (3, 4)])))
    println("isolated=" + show(container.topo_sort(3, [])))
    println("cycle=" + show(container.topo_sort(3, [(0, 1), (1, 2), (2, 0)])))
    println("empty=" + show(container.topo_sort(0, [])))
    println("bad=" + show(container.topo_sort(2, [(0, 5)])))
