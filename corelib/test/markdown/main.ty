# corelib test: exercises core:markdown. The output is locked to
# corelib/test/markdown.out (corelib/run.sh). The tychoc0 cross-check this line used
# to claim was retired 2026-07-29. Pure Tycho -- no filesystem, deterministic.
package main
import "core:markdown"

fn main():
    # headings 1..6 + inline in a heading
    println(markdown.render("# H1 *i*"))
    println(markdown.render("###### H6"))
    # paragraph with every inline: bold, italic (both delims), code, link, image, escapes
    println(markdown.render("a **b** _i_ *j* `x<y` [t](u) ![a](s) & < >"))
    # multi-line paragraph joins; a blank line splits
    println(markdown.render("line one\nline two\n\nsecond para"))
    # unordered (all three markers) and ordered lists with inline
    println(markdown.render("- one\n* two\n+ **three**"))
    println(markdown.render("1. first\n2. second"))
    # blockquote (rendered recursively) and thematic breaks
    println(markdown.render("> quoted **b**\n> still"))
    println(markdown.render("---"))
    println(markdown.render("***"))
    # fenced code escapes HTML, no inline processing
    println(markdown.render("```\nlet x = a<b && c > d; `nope`\n```"))
    # fail-soft: unmatched delimiters pass through as escaped text
    println(markdown.render("un**matched and [broken(link and *lone"))
    # SCHEME ALLOWLIST on href/src. esc() handles `"` so an attribute cannot be
    # broken out of, but escaping says nothing about the scheme: javascript:,
    # data:text/html and vbscript: were emitted verbatim until 2026-08-15. The
    # dangerous ones fail soft to the link text; the safe ones must be UNCHANGED,
    # which is what stops the fix from becoming "drop every link".
    println(markdown.render("[a](javascript:alert`1`) [b](data:text/html;base64,x) [c](vbscript:m)"))
    println(markdown.render("[d](https://e.com/p) [e](/rel/path) [f](mailto:a@b.c) [g](//host/p)"))
    println(markdown.render("[h](a/b:c) [i](#frag) [j](?q=1)"))
    println(markdown.render("![k](javascript:alert(1)) ![l](/img/ok.png)"))
    # case and padding must not slip a scheme past the check
    println(markdown.render("[m](JaVaScRiPt:alert`1`) [n](HTTPS://e.com/p)"))
