package main
import "core:markdown"

fn main():
    # headings 1..6 + inline in a heading
    println(markdown.render("# H1 *i*"))
    println(markdown.render("###### H6"))
    # paragraph with every inline: bold, italic (both delims), code, link, image, escapes
    println(markdown.render("a **b** _i_ *j* `x<y` [t](u) ![a](s) & < >"))
    # multi-line paragraph joins; a blank line splits
    println(markdown.render("line one\nline two\n\nsecond para"))
    # unordered (all three markers) and ordered lists with inline
    println(markdown.render("- one\n* two\n+ **three**"))
    println(markdown.render("1. first\n2. second"))
    # blockquote (rendered recursively) and thematic breaks
    println(markdown.render("> quoted **b**\n> still"))
    println(markdown.render("---"))
    println(markdown.render("***"))
    # fenced code escapes HTML, no inline processing
    println(markdown.render("```\nlet x = a<b && c > d; `nope`\n```"))
    # fail-soft: unmatched delimiters pass through as escaped text
    println(markdown.render("un**matched and [broken(link and *lone"))
    println(markdown.render("[a](javascript:alert`1`) [b](data:text/html;base64,x) [c](vbscript:m)"))
    println(markdown.render("[d](https://e.com/p) [e](/rel/path) [f](mailto:a@b.c) [g](//host/p)"))
    println(markdown.render("[h](a/b:c) [i](#frag) [j](?q=1)"))
    println(markdown.render("![k](javascript:alert(1)) ![l](/img/ok.png)"))
    # case and padding must not slip a scheme past the check
    println(markdown.render("[m](JaVaScRiPt:alert`1`) [n](HTTPS://e.com/p)"))
    println(markdown.render("![\" onerror=\"alert(1)](a.png)"))
    println(markdown.render("[x](http://a/\" onmouseover=\"alert(1))"))
    println(markdown.render("![x](http://a/\" onerror=\"alert(1))"))
    # a quote in link TEXT is element content, not an attribute -- it is escaped
    # too, but it would be harmless either way, so it is not evidence on its own
    println(markdown.render("[\" onmouseover=\"alert(1)](http://a)"))
    # a code-fence language must not reach a class attribute. It is discarded
    # entirely, so there is nothing to escape -- recorded as the reason rather
    # than left looking like an escaping test that passed.
    println(markdown.render("```x\" onload=\"alert(1)\ncode\n```"))

    # SCHEME-CHECK EVASION. The three schemes above are refused; these are the
    # shapes that get past a check written as `starts_with(lower(u), "javascript:")`
    # without more care -- mixed case, a leading space, whitespace or a NUL inside
    # the keyword. Every one must come back as TEXT, with no href at all.
    # A protocol-relative "//host/path" is deliberately NOT in this list: it is an
    # ordinary external link, the same as the http:// one, and linking it is right.
    evade := ["JaVaScRiPt:alert(1)",
              "  javascript:alert(1)",
              "java" + chr(9) + "script:alert(1)",
              "java" + chr(10) + "script:alert(1)",
              "java" + chr(0) + "script:alert(1)",
              "vbscript:msgbox(1)",
              "data:text/html;base64,PHNjcmlwdD4="]
    linked := 0
    for u in evade:
        if find(markdown.render("[x](" + u + ")"), "href=") >= 0:
            linked += 1
    println("evasion vectors=" + str(len(evade)) + " linked=" + str(linked))
    # The control: a legitimate URL in the SAME position must still link, or the
    # count above is satisfied by a renderer that refuses every link there is.
    println("control http linked=" +
            str(find(markdown.render("[x](http://example.com/a)"), "href=") >= 0))

