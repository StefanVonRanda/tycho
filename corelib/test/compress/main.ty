package main
import "core:compress"

fn bytes_of(r: Result(bytes, compress.ZErr)) -> bytes:
    match r:
        Ok(v): return v
        Err(_): return to_bytes([]int)

fn deflater_why(r: Result(compress.Deflater, compress.ZErr)) -> string:
    match r:
        Ok(_): return "Ok"
        Err(_): return "Err"

fn b2i(b: bool) -> int:
    if b:
        return 1
    return 0

fn zwhy(r: Result(bytes, compress.ZErr)) -> string:
    match r:
        Ok(b): return "Ok"
        Err(compress.Corrupt): return "Corrupt"
        Err(compress.Truncated): return "Truncated"
        _: return "Failed"

fn zn(r: Result(bytes, compress.ZErr)) -> int:
    match r:
        Ok(b): return len(b)
        _: return -1                      # -1, never 0: a failure must not read as empty

fn zs(r: Result(bytes, compress.ZErr)) -> string:
    match r:
        Ok(b): return to_str(b)
        _: return ""

fn main():
    # round-trip a compressible (repetitive) buffer
    orig := ""
    i := 0
    for i < 50:
        orig = orig + "The quick brown fox jumps over the lazy dog. "
        i = i + 1
    ob := to_bytes(orig)
    c := compress.compress(ob)
    d := compress.decompress(c)
    println("roundtrip=" + str(b2i(zs(d) == orig)))               # 1
    println("smaller=" + str(b2i(len(c) < len(ob))))              # 1 (repetitive -> compresses)

    # binary-safe: interior NUL bytes survive the round-trip
    nb := to_bytes("a" + chr(0) + "b" + chr(0) + "c")            # 5 bytes
    nd := compress.decompress(compress.compress(nb))
    println("nul_roundtrip=" + str(b2i(zn(nd) == 5)))             # 1

    ed := compress.decompress(compress.compress(to_bytes("")))
    println("empty=" + zwhy(ed) + " len=" + str(zn(ed)))          # Ok len=0 -- a REAL empty payload

    corrupt := compress.decompress(to_bytes("not a gzip stream at all"))
    println("corrupt=" + zwhy(corrupt) + " len=" + str(zn(corrupt)))

    # a real gzip stream cut short: the header is valid, the data stops
    full := compress.compress(ob)
    trunc := compress.decompress(full[0:len(full) / 2])
    println("truncated=" + zwhy(trunc) + " len=" + str(zn(trunc)))

    # Gzip permits concatenated members; trailing non-member data is rejected.
    member1 := compress.compress(to_bytes("left"))
    member2 := compress.compress(to_bytes("right"))
    println("gzip_concat=" + zs(compress.decompress(member1 + member2)))
    println("gzip_trailing=" + zwhy(compress.decompress(member1 + to_bytes("junk"))))

    # raw DEFLATE carries the same three answers
    rc := compress.raw_compress(ob)
    println("raw_ok=" + zwhy(compress.raw_decompress(rc)))
    println("raw_corrupt=" + zwhy(compress.raw_decompress(to_bytes("junk"))))

    # ---- streaming gzip ----
    df := compress.Deflater(null)
    match compress.deflater_new(6):
        Ok(v): df = v
        Err(_): pass
    c1 := compress.deflate_chunk(&df, to_bytes("hello "))
    c2 := compress.deflate_chunk(&df, to_bytes("world"))
    c3 := compress.deflate_finish(&df)
    out := bytes_of(c1) + bytes_of(c2) + bytes_of(c3)
    println("def stream_bytes=" + str(len(out) > 0))
    decoded := compress.decompress(out)
    match decoded:
        Ok(v): println("def roundtrip=" + str(v == to_bytes("hello world")))
        Err(_): println("def roundtrip=false")
    compress.deflater_free(df)

    inf := compress.Inflater(null)
    match compress.inflater_new():
        Ok(v): inf = v
        Err(_): pass
    half := len(out) / 2
    i1 := compress.inflate_chunk(&inf, out[0:half])
    i2 := compress.inflate_chunk(&inf, out[half:len(out)])
    i3 := compress.inflate_finish(&inf)
    plain := bytes_of(i1) + bytes_of(i2) + bytes_of(i3)
    println("inflate roundtrip=" + str(plain == to_bytes("hello world")))
    compress.inflater_free(inf)
    println("deflater_bad=" + deflater_why(compress.deflater_new(99)))
