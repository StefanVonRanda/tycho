# corelib test: exercises core:sqlite over an in-memory database (the lane
# skips when libsqlite3 is absent -- see the deps skip in corelib/run.sh).
# Output locked to corelib/test/sqlite.out.
package main
import "core:sqlite"

fn exec_or_die(d: inout sqlite.Db, sql: string) -> int:
    match sqlite.exec(&d, sql):
        Ok(n):
            return n
        Err(m):
            print("exec error: " + m + "\n")
            exit(1)
            return -1

fn execp_or_die(d: inout sqlite.Db, sql: string, p: [string]) -> int:
    match sqlite.exec_params(&d, sql, p):
        Ok(n):
            return n
        Err(m):
            print("exec error: " + m + "\n")
            exit(1)
            return -1

fn query_or_die(d: inout sqlite.Db, sql: string) -> [[string]]:
    match sqlite.query(&d, sql):
        Ok(rs):
            return rs
        Err(m):
            print("query error: " + m + "\n")
            exit(1)
            return [][string]

fn main():
    db := sqlite.Db(null)
    match sqlite.open(":memory:"):
        Ok(d):
            db = d
        Err(m):
            print("open error: " + m + "\n")
            exit(1)
    exec_or_die(&db, "CREATE TABLE users(id INTEGER, name TEXT, age INTEGER)")
    execp_or_die(&db, "INSERT INTO users VALUES (?, ?, ?)", ["1", "ada", "36"])
    execp_or_die(&db, "INSERT INTO users VALUES (?, ?, ?)", ["2", "alan", "41"])
    n := exec_or_die(&db, "UPDATE users SET age = 37 WHERE name = 'ada'")
    print("changed=" + str(n) + "\n")
    rows := query_or_die(&db, "SELECT id, name, age FROM users ORDER BY id")
    print("rows=" + str(len(rows)) + "\n")
    for r in rows:
        print(r[0] + " " + r[1] + " " + r[2] + "\n")
    sub := [][string]
    match sqlite.query_params(&db, "SELECT name FROM users WHERE age >= ?", ["40"]):
        Ok(rs):
            sub = rs
        Err(m):
            print("query error: " + m + "\n")
            exit(1)
    print("seniors=" + str(len(sub)) + " " + sub[0][0] + "\n")
    bad := false
    match sqlite.query(&db, "SELECT * FROM nosuchtable"):
        Err(_):
            bad = true
        Ok(_):
            bad = false
    print("bad=" + str(bad) + "\n")
    # exec() runs EVERY statement, so its count must cover all of them. It read
    # sqlite3_changes, which describes the most recent statement alone, and two
    # inserted rows reported 1 (2026-08-15). The ROW COUNT is asserted beside it:
    # a count that is merely plausible and a count that matches what landed are
    # different claims, and only the second one catches a half-run statement.
    _ := sqlite.exec(&db, "CREATE TABLE m(x TEXT)")
    match sqlite.exec(&db, "INSERT INTO m VALUES('a'); INSERT INTO m VALUES('b')"):
        Err(m):
            print("multi exec err: " + m + "\n")
        Ok(n):
            print("exec multi changes=" + str(n) + "\n")
    match sqlite.query(&db, "SELECT count(*) FROM m"):
        Err(_):
            print("exec multi rows=?\n")
        Ok(r):
            print("exec multi rows=" + r[0][0] + "\n")
    # exec_params goes through prepare_v2 with a NULL tail, so everything after
    # the first statement is DISCARDED and it still answers Ok. This pins that
    # limitation deliberately (FRICTION #69) -- if it is ever made to fail closed,
    # this line must change on purpose rather than drift.
    match sqlite.exec_params(&db, "INSERT INTO m VALUES('c'); INSERT INTO m VALUES('d')", []string):
        Err(m):
            print("params multi err: " + m + "\n")
        Ok(n):
            print("exec_params multi changes=" + str(n) + "\n")
    match sqlite.query(&db, "SELECT count(*) FROM m"):
        Err(_):
            print("params multi rows=?\n")
        Ok(r):
            print("params multi rows=" + r[0][0] + " (3, not 4: the tail is dropped)\n")
    # A bound parameter must survive an interior NUL. sqlite3_bind_text was given
    # -1, which reads to the first NUL, so this 5-byte value stored TWO bytes and
    # returned Ok (2026-08-15) -- silent truncation at a trust boundary, where two
    # values the program treats as different collapse into one row. The HEX is
    # asserted, not the text: a truncated string prints as perfectly ordinary
    # text and only the bytes show what was lost.
    nul := to_str(to_bytes([104, 105, 0, 122, 122]))         # "hi\0zz", 5 bytes
    _ = sqlite.exec(&db, "CREATE TABLE n(x TEXT)")
    match sqlite.exec_params(&db, "INSERT INTO n VALUES(?)", [nul]):
        Err(m):
            print("nul insert err: " + m + "\n")
        Ok(_):
            print("nul insert ok\n")
    match sqlite.query(&db, "SELECT length(cast(x as blob)), hex(x) FROM n"):
        Err(_):
            print("nul stored=?\n")
        Ok(r):
            print("nul tycho len=" + str(len(nul)) + " stored len=" + r[0][0] + " hex=" + r[0][1] + "\n")
    sqlite.close(&db)
