package main
import "core:json"

fn b2i(b: bool) -> int:
    if b:
        return 1
    return 0

# Render a fallible parse as one line: the whole document on success, the cause
# and the byte offset on failure. Asserting the WHOLE document matters -- the
# fabricated-key bug below exited 0 and only the serialized tree showed it.
fn show(r: Result(json.Json, json.JsonErr)) -> string:
    match r:
        Ok(v): return "ok  " + json.stringify(v)
        Err(e): return "err " + json.err_str(e)

# The byte offset alone, so it can be asserted against the byte it must name.
# -1 on success, which is a value no offset can take.
fn offset_of(r: Result(json.Json, json.JsonErr)) -> int:
    match r:
        Ok(v): return -1
        Err(e): return json.err_offset(e)

fn yn(b: bool) -> string:
    if b:
        return "yes"
    return "no"

# THE NUMBER PROPERTY, on one line: which variant the number landed in, what
# `stringify` emits for it, and whether that is BYTE-IDENTICAL to the input.
#
# `identical` is the whole point of JFloat carrying its lexeme. NOTHING here
# prints a raw float, deliberately: `str(float)` goes through `%.15g`, which
# takes its decimal separator from LC_NUMERIC and renders `1,5.0` under a
# comma-decimal locale -- so a golden containing one would be locale-dependent.
# Values are asserted by comparison instead (`eq` lines below).
fn rt(src: string) -> string:
    match json.parse_checked(src):
        Ok(v):
            out := json.stringify(v)
            return json.kind(v) + " " + out + " identical=" + yn(out == src)
        Err(e):
            return "err " + json.err_str(e)

# Every byte of a string as lowercase hex, space-separated. A decoded \u escape
# is UTF-8 BYTES, and the whole point of this phase is which bytes -- so they are
# asserted directly rather than through a glyph that a terminal might normalise.
fn hex2(c: int) -> string:
    d := "0123456789abcdef"
    return substr(d, c / 16, c / 16 + 1) + substr(d, c % 16, c % 16 + 1)

fn bytes_of(s: string) -> string:
    out := ""
    for i := 0; i < len(s); i += 1:
        if i > 0:
            out = out + " "
        out = out + hex2(s[i])
    return out

# THE FIXED POINT, which is the round-trip property a \u escape can actually
# have. `"\u0041"` is NOT byte-identical through stringify -- it comes back as
# the character `A`, deliberately -- so identity with the source is the wrong
# test. Stability is the right one: parse -> stringify -> parse -> stringify must
# land on the same bytes twice. A lost byte, an invented byte or an escape that
# re-parses as something else all break it.
fn fixed(src: string) -> string:
    match json.parse_checked(src):
        Ok(v1):
            s1 := json.stringify(v1)
            match json.parse_checked(s1):
                Ok(v2):
                    return s1 + " fixed=" + yn(s1 == json.stringify(v2))
                Err(e):
                    return "REPARSE FAILED " + json.err_str(e)
        Err(e):
            return "err " + json.err_str(e)

# The membership test `get` cannot express, written the only way the package
# offers: walk `keys`. It is what separates a null-valued member from an absent
# one, and it is why `get`'s JNull collapse is a limit and not a loss.
fn has_key(j: json.Json, k: string) -> bool:
    ks := json.keys(j)
    for i := 0; i < len(ks); i += 1:
        if ks[i] == k:
            return true
    return false

fn main():
    src := "{\"name\": \"tycho\", \"version\": 7, \"tags\": [\"systems\", \"arena\"], \"nested\": {\"ok\": true, \"n\": -3}, \"empty\": [], \"nothing\": null}"
    j := json.parse(src)

    # round-trip: parse then serialize -> compact canonical form
    println("round-trip: " + json.stringify(j))

    # accessors
    println("kind        = " + json.kind(j))
    println("version     = " + str(json.as_num(json.get(j, "version"))))
    println("name        = " + json.as_str(json.get(j, "name")))
    println("nested.n    = " + str(json.as_num(json.get(json.get(j, "nested"), "n"))))
    println("nested.ok   = " + str(b2i(json.as_bool(json.get(json.get(j, "nested"), "ok")))))
    println("tags.len    = " + str(json.len_of(json.get(j, "tags"))))
    println("tags[1]     = " + json.as_str(json.at(json.get(j, "tags"), 1)))
    println("tags[9]     = " + json.kind(json.at(json.get(j, "tags"), 9)))
    println("empty.len   = " + str(json.len_of(json.get(j, "empty"))))
    println("missing     = " + json.kind(json.get(j, "missing")))
    println("nothing     = " + json.kind(json.get(j, "nothing")))

    # object keys preserve insertion order
    ks := json.keys(j)
    println("keys.len    = " + str(len(ks)))
    println("key0        = " + ks[0])

    # escape round-trip: a JSON string with \" \n \t round-trips byte-identical
    esc_src := "\"a\\\"b\\nc\\td\""
    println("esc rt      = " + json.stringify(json.parse(esc_src)))

    # build a tree programmatically (cross-package variant construction)
    built := json.JArr([json.JNum(1), json.JStr("x"), json.JBool(true), json.JNull])
    println("built       = " + json.stringify(built))
    # a two-payload variant, constructed from OUTSIDE the package
    println("built float = " + json.stringify(json.JFloat(1.5, "1.50")))

    # truncated input fails closed to null (no out-of-bounds abort)
    println("truncated   = " + json.kind(json.parse("   ")))

    println("f scalar    = " + rt("1.5"))
    println("f scalar r  = " + show(json.parse_checked("1.5")))
    # `[{"a":1.5}]`  before: printed `[{"a":1,"5}]":null}]` -- the parser
    #        invented a SECOND column named `5}]`, in a document the caller
    #        believed it had read. The worst of the three: no symptom at all.
    println("f in obj    = " + rt("[{\"a\":1.5}]"))
    # `[1.5]`  before: `tycho: out of memory`, exit 1 -- parse_array consumed
    #        nothing at the `.` and pushed JNum(0) forever. Five bytes of input.
    #        Probed in a throwaway binary under `ulimit -v 262144`, never here.
    println("f in arr    = " + rt("[1.5]"))
    # A float nested in a container keeps its lexeme too, so a whole document
    # of them round-trips: the exponent stays an exponent, un-normalised.
    println("f mixed     = " + rt("{\"a\":[1.5,2,1e3],\"b\":-0.0}"))

    # every shape of the RFC 8259 number grammar, one line each
    println("n 1.5       = " + rt("1.5"))
    println("n -0.0      = " + rt("-0.0"))
    println("n 1e3       = " + rt("1e3"))
    println("n 1E+3      = " + rt("1E+3"))
    println("n 2.5e-3    = " + rt("2.5e-3"))
    println("n 30 digits = " + rt("123456789012345678901234567890"))
    println("n intmax    = " + rt("9223372036854775807"))
    println("n intmax+1  = " + rt("9223372036854775808"))
    println("n 0         = " + rt("0"))
    println("n -3        = " + rt("-3"))
    # `-0` as an INTEGER cannot be a JNum: str(0) is "0", which is not the
    # lexeme, so the round-trip proof fails it into JFloat and the sign lives.
    println("n -0        = " + rt("-0"))
    # `0` is a whole integer part by itself, and a fraction or an exponent may
    # follow it. RFC 8259's rule forbids a zero followed by another DIGIT, and
    # these four are the neighbours of `01` that must survive it.
    println("n 0.5       = " + rt("0.5"))
    println("n 0e1       = " + rt("0e1"))
    println("n -0.5      = " + rt("-0.5"))
    println("n 0 again   = " + rt("0"))

    # the VALUES, asserted by comparison because printing a float is locale-bound
    println("v 1.5 eq1.5 = " + yn(json.as_float(json.parse("1.5")) == 1.5))
    println("v 1.5 eq1   = " + yn(json.as_float(json.parse("1.5")) == 1.0))
    println("v 1e3 eq1000= " + yn(json.as_float(json.parse("1e3")) == 1000.0))
    println("v 1E+3 eq1e3= " + yn(json.as_float(json.parse("1E+3")) == 1000.0))
    println("v -0.0 eq0  = " + yn(json.as_float(json.parse("-0.0")) == 0.0))
    println("v -0.0 neg  = " + yn(1.0 / json.as_float(json.parse("-0.0")) < 0.0))
    println("v 2.5e-3    = " + yn(json.as_float(json.parse("2.5e-3")) == 0.0025))
    println("v JNum wide = " + yn(json.as_float(json.parse("7")) == 7.0))

    println("g3 kind     = " + json.kind(json.parse("9223372036854775808")))
    println("g3 as_num   = " + str(json.as_num(json.parse("9223372036854775808"))))
    println("g3 lexeme   = " + json.as_lexeme(json.parse("9223372036854775808")))
    println("g3 30 lex   = " + json.as_lexeme(json.parse("123456789012345678901234567890")))
    # int max itself still round-trips as an exact integer -- the bound is not
    # off by one, and a JNum's lexeme is its exact rendering.
    println("g3 max kind = " + json.kind(json.parse("9223372036854775807")))
    println("g3 max num  = " + str(json.as_num(json.parse("9223372036854775807"))))
    println("g3 max lex  = " + json.as_lexeme(json.parse("9223372036854775807")))
    println("g3 str lex  = " + json.as_lexeme(json.parse("\"x\"")) + "|")

    # ---- numbers that are still errors, at the byte that must be named ------
    # A malformed fraction/exponent errors where the digit was required.
    println("bad 1.      = " + show(json.parse_checked("1.")))
    println("bad 1e      = " + show(json.parse_checked("1e")))
    println("bad 1e+     = " + show(json.parse_checked("1e+")))
    println("bad 1.x     = " + show(json.parse_checked("1.x")))
    println("bad [1.]off = " + str(offset_of(json.parse_checked("[1.]"))))
    # `.5` and `+1` begin no JSON value at all: the error is at byte 0, from
    # parse_value's dispatch, and parse_number is never entered.
    println("bad .5      = " + show(json.parse_checked(".5")))
    println("bad +1      = " + show(json.parse_checked("+1")))
    # Well-formed, but binary64 holds no such value. Fail closed: never an
    # infinity, never a 0. The offset names the FIRST byte of the number.
    println("bad 1e400   = " + show(json.parse_checked("1e400")))
    println("bad 1e-400  = " + show(json.parse_checked("1e-400")))
    println("bad [1e400] = " + str(offset_of(json.parse_checked("[1e400]"))))

    # the rest of the error channel: one line per failure class
    println("ok doc      = " + show(json.parse_checked("{\"a\":[1,-2,null]}")))
    println("bad byte    = " + show(json.parse_checked("[+1]")))
    println("bad number  = " + show(json.parse_checked("[-x]")))
    println("bad keyword = " + show(json.parse_checked("[tru]")))
    println("bad escape  = " + show(json.parse_checked("[\"a\\q\"]")))
    println("bad key     = " + show(json.parse_checked("{1:2}")))
    println("no colon    = " + show(json.parse_checked("{\"a\" 1}")))
    println("no sep      = " + show(json.parse_checked("[1 2]")))
    println("unclosed [  = " + show(json.parse_checked("[1")))
    println("unclosed {  = " + show(json.parse_checked("{\"a\":1")))
    println("unclosed \"  = " + show(json.parse_checked("\"ab")))
    println("empty       = " + show(json.parse_checked("   ")))
    # escapes the parser DOES represent, round-tripped through the byte values
    println("esc bfr     = " + str(len(json.as_str(json.parse("\"\\b\\f\\r\\/\"")))))

    println("tc arr      = " + show(json.parse_checked("[1,]")))
    println("tc arr off  = " + str(offset_of(json.parse_checked("[1,]"))))
    println("tc obj      = " + show(json.parse_checked("{\"a\":1,}")))
    println("tc obj off  = " + str(offset_of(json.parse_checked("{\"a\":1,}"))))
    # Whitespace between the comma and the closer does not hide it, and the
    # offset still names the comma rather than wherever the scan stopped.
    println("tc ws off   = " + str(offset_of(json.parse_checked("[1,  ]"))))
    println("tc nest off = " + str(offset_of(json.parse_checked("[[1,]]"))))
    # `[1,` is TRUNCATION, not a trailing comma: nothing has closed it yet, so
    # the two failures stay told apart.
    println("tc trunc    = " + show(json.parse_checked("[1,")))
    # THE VALID NEIGHBOURS. A comma between two elements is not a trailing one,
    # and an EMPTY container has no comma to be trailing.
    println("tc ok [1]   = " + show(json.parse_checked("[1]")))
    println("tc ok [1,2] = " + show(json.parse_checked("[1,2]")))
    println("tc ok obj   = " + show(json.parse_checked("{\"a\":1}")))
    println("tc ok []    = " + show(json.parse_checked("[]")))
    println("tc ok {}    = " + show(json.parse_checked("{}")))
    println("lz 01       = " + show(json.parse_checked("01")))
    println("lz 01 off   = " + str(offset_of(json.parse_checked("01"))))
    # `-01` names byte 1: the zero, NOT the sign, which is legal.
    println("lz -01      = " + show(json.parse_checked("-01")))
    println("lz -01 off  = " + str(offset_of(json.parse_checked("-01"))))
    println("lz 00       = " + show(json.parse_checked("00")))
    println("lz 01.5     = " + show(json.parse_checked("01.5")))
    println("lz in arr   = " + str(offset_of(json.parse_checked("[10,01]"))))
    # THE VALID NEIGHBOURS: a lone zero, a signed zero, and a zero that is the
    # whole integer part of a float. `10` and `100` are not leading zeros.
    println("lz ok 0     = " + show(json.parse_checked("0")))
    println("lz ok -0    = " + show(json.parse_checked("-0")))
    println("lz ok 0.5   = " + show(json.parse_checked("0.5")))
    println("lz ok 0e1   = " + show(json.parse_checked("0e1")))
    println("lz ok 10    = " + show(json.parse_checked("10")))
    println("lz ok 100   = " + show(json.parse_checked("100")))
    println("lz ok 0.0e0 = " + show(json.parse_checked("0.0e0")))
    println("tt junk     = " + show(json.parse_checked("{\"a\":1} junk")))
    println("tt junk off = " + str(offset_of(json.parse_checked("{\"a\":1} junk"))))
    println("tt two docs = " + show(json.parse_checked("{\"a\":1}{\"b\":2}")))
    println("tt scalar   = " + show(json.parse_checked("1 2")))
    println("tt closer   = " + show(json.parse_checked("[1]]")))
    println("tt off0     = " + str(offset_of(json.parse_checked("nullx"))))
    println("tt ok pad   = " + show(json.parse_checked("{\"a\":1}   ")))
    println("tt ok nl    = " + show(json.parse_checked("{\"a\":1}\n")))
    println("tt ok lead  = " + show(json.parse_checked("  {\"a\":1}")))
    println("tt ok both  = " + show(json.parse_checked(" \t\r\n{\"a\":1} \t\r\n")))
    println("tt ok scalar= " + show(json.parse_checked(" 1 ")))
    # The lenient wrapper runs the SAME grammar; lenient means it discards the
    # error, not that it accepts more. All three of these fail closed to null.
    println("tt parse    = " + json.kind(json.parse("{\"a\":1} junk")))
    println("tt parse ok = " + json.kind(json.parse("{\"a\":1}\n")))
    println("tc parse    = " + json.kind(json.parse("[1,]")))
    #
    # 4. A RAW CONTROL BYTE inside a string. RFC 8259 s7 allows only
    #    %x20-21 / %x23-5B / %x5D-10FFFF unescaped. The offset names the byte.
    println("cb tab      = " + show(json.parse_checked("\"a\tb\"")))
    println("cb tab off  = " + str(offset_of(json.parse_checked("\"a\tb\""))))
    println("cb nl       = " + show(json.parse_checked("\"a\nb\"")))
    println("cb first    = " + str(offset_of(json.parse_checked("\"\tb\""))))
    # After an escape, so the SLOW path's copy loop is tested and not just the
    # fast scan -- they are two separate loops and each needed its own test.
    println("cb slow     = " + show(json.parse_checked("\"a\\nb\tc\"")))
    println("cb slow off = " + str(offset_of(json.parse_checked("\"a\\nb\tc\""))))
    # In an object KEY, which goes through the same parse_string.
    println("cb key off  = " + str(offset_of(json.parse_checked("{\"a\tb\":1}"))))
    # THE VALID NEIGHBOURS: the ESCAPED forms of the same bytes are still fine,
    # and 0x20 (space) and 0x7F (DEL) are not control bytes for this rule.
    println("cb ok esc   = " + show(json.parse_checked("\"a\\tb\"")))
    println("cb ok uesc  = " + show(json.parse_checked("\"a\\u0009b\"")))
    println("cb ok space = " + show(json.parse_checked("\" \"")))
    println("cb ok e9    = " + bytes_of(json.as_str(json.parse("\"" + chr(195) + chr(169) + "\""))))       # raw "é" (C3 A9)
    println("cb ok 20ac  = " + bytes_of(json.as_str(json.parse("\"" + chr(226) + chr(130) + chr(172) + "\""))))   # raw "€" (E2 82 AC)
    println("cb ok f09f  = " + bytes_of(json.as_str(json.parse("\"" + chr(240) + chr(159) + chr(152) + chr(128) + "\"")))) # raw emoji (F0 9F 98 80)
    println("cb bad ff   = " + show(json.parse_checked("\"a" + chr(255) + "b\"")))
    println("cb bad ff off = " + str(offset_of(json.parse_checked("\"a" + chr(255) + "b\""))))
    println("cb bad 80   = " + show(json.parse_checked("\"" + chr(128) + "\"")))
    println("cb bad c0   = " + show(json.parse_checked("\"" + chr(192) + chr(175) + "\"")))       # overlong "/"
    println("cb bad ed   = " + show(json.parse_checked("\"" + chr(237) + chr(160) + chr(128) + "\"")))  # ED A0 80: surrogate
    println("cb bad f4   = " + show(json.parse_checked("\"" + chr(244) + chr(144) + chr(128) + chr(128) + "\""))) # F4 90: > U+10FFFF
    println("cb bad trunc= " + show(json.parse_checked("\"" + chr(195) + "\"")))                   # C3 with no continuation
    println("cb ok del   = " + bytes_of(json.as_str(json.parse("\"a" + chr(127) + "b\""))))

    # ---- \uXXXX and the surrogate pair (gap 2) ------------------------------
    # Before this, `\u` was the ONE escape parse_string refused: `"\u0041"` was
    # an error at the `u`, and before the error channel it silently became the
    # literal text `u0041` -- four bytes nobody wrote.
    println("u A         = " + json.as_str(json.parse("\"\\u0041\"")) + "|")
    println("u A len     = " + str(len(json.as_str(json.parse("\"\\u0041\"")))))
    println("u A bytes   = " + bytes_of(json.as_str(json.parse("\"\\u0041\""))))
    # A 2-byte code point, and the property the phase names: `\u00e9` and a
    # LITERAL e-acute in the source must produce the SAME string, byte for byte.
    println("u e9 bytes  = " + bytes_of(json.as_str(json.parse("\"\\u00e9\""))))
    println("u e9 == lit = " + yn(json.as_str(json.parse("\"\\u00e9\"")) == json.as_str(json.parse("\"é\""))))
    # Hex is CASE-INSENSITIVE, so the two spellings are one character.
    println("u E9 == e9  = " + yn(json.as_str(json.parse("\"\\u00E9\"")) == json.as_str(json.parse("\"\\u00e9\""))))
    # A 3-byte code point: U+20AC EURO SIGN.
    println("u 20ac      = " + bytes_of(json.as_str(json.parse("\"\\u20ac\""))))
    # THE SURROGATE PAIR. U+1F600 is written in JSON as two UTF-16 halves and is
    # FOUR UTF-8 bytes here -- not two 3-byte surrogates, which is what a parser
    # that encoded each half separately would produce (CESU-8, and wrong).
    println("u emoji len = " + str(len(json.as_str(json.parse("\"\\ud83d\\ude00\"")))))
    println("u emoji     = " + bytes_of(json.as_str(json.parse("\"\\ud83d\\ude00\""))))
    println("u emoji lit = " + yn(json.as_str(json.parse("\"\\ud83d\\ude00\"")) == json.as_str(json.parse("\"😀\""))))
    # The boundary code points of each UTF-8 width, so an off-by-one in `utf8`
    # cannot hide: 0x7F/0x80 and 0x7FF/0x800.
    println("u 007f      = " + bytes_of(json.as_str(json.parse("\"\\u007f\""))))
    println("u 0080      = " + bytes_of(json.as_str(json.parse("\"\\u0080\""))))
    println("u 07ff      = " + bytes_of(json.as_str(json.parse("\"\\u07ff\""))))
    println("u 0800      = " + bytes_of(json.as_str(json.parse("\"\\u0800\""))))
    # The last code point a surrogate pair can name, U+10FFFF. It is the largest
    # value `utf8`'s 4-byte arm can ever be handed.
    println("u 10ffff    = " + bytes_of(json.as_str(json.parse("\"\\udbff\\udfff\""))))
    # A \u escape mid-string, so the slow path's prefix/suffix joining is tested
    # and not just an escape that is the whole string.
    println("u mid       = " + bytes_of(json.as_str(json.parse("\"a\\u00e9b\""))))
    # A NUL byte from `\u0000`: a Tycho string is length-counted, so it is a byte
    # like any other and does NOT truncate the string.
    println("u nul len   = " + str(len(json.as_str(json.parse("\"a\\u0000b\"")))))
    println("u nul bytes = " + bytes_of(json.as_str(json.parse("\"a\\u0000b\""))))

    # ---- the \u failures, each at the byte it must name ---------------------
    # A LONE surrogate is an error, NOT U+FFFD. A replacement character is a
    # guess about what the writer meant, and guessing is what this package spent
    # two plans removing. The offset names the `u` of the unpaired escape (byte
    # 2 in every line below), because no single byte of `\ud83d` is itself wrong.
    println("u lone hi   = " + show(json.parse_checked("\"\\ud83d\"")))
    println("u lone lo   = " + show(json.parse_checked("\"\\ude00\"")))
    println("u hi+hi     = " + show(json.parse_checked("\"\\ud83d\\ud83d\"")))
    println("u hi+char   = " + show(json.parse_checked("\"\\ud83dx\"")))
    println("u hi+esc    = " + show(json.parse_checked("\"\\ud83d\\n\"")))
    println("u lone off  = " + str(offset_of(json.parse_checked("\"\\ud83d\""))))
    # A truncated escape and a non-hex digit name the OFFENDING BYTE itself.
    # `"\u00"` fails at byte 5 -- the closing quote, which is the third "digit".
    println("u trunc     = " + show(json.parse_checked("\"\\u00\"")))
    println("u nonhex    = " + show(json.parse_checked("\"\\uZZZZ\"")))
    println("u trunc off = " + str(offset_of(json.parse_checked("\"\\u00\""))))
    println("u nonhex off= " + str(offset_of(json.parse_checked("\"\\uZZZZ\""))))
    # Input that ends INSIDE the escape is truncation, not a bad digit.
    println("u eof       = " + show(json.parse_checked("\"\\u00")))
    # In a container, so the offset is not accidentally right only at byte 0.
    println("u in arr    = " + show(json.parse_checked("[\"\\uZZZZ\"]")))

    # ---- parse -> stringify -> parse is a FIXED POINT -----------------------
    # `fixed=yes` on every accepted line above. Note what stringify emits: a
    # decoded escape comes back as its UTF-8 BYTES (raw UTF-8 is legal in a JSON
    # string), and a control byte comes back as an ESCAPE -- never raw, which is
    # the one direction of the control-byte gap in the corelib header.
    println("fp A        = " + fixed("\"\\u0041\""))
    println("fp e9       = " + fixed("\"\\u00e9\""))
    println("fp 20ac     = " + fixed("\"\\u20ac\""))
    println("fp emoji    = " + fixed("\"\\ud83d\\ude00\""))
    println("fp 10ffff   = " + fixed("\"\\udbff\\udfff\""))
    println("fp mid      = " + fixed("\"a\\u00e9b\""))
    println("fp classic  = " + fixed("\"a\\\"b\\nc\\td\""))
    println("fp bfr      = " + fixed("\"\\b\\f\\r\""))
    println("fp slash    = " + fixed("\"a\\/b\""))
    println("fp nul      = " + fixed("\"a\\u0000b\""))
    println("fp ctl 1f   = " + fixed("\"\\u001f\""))
    println("fp ctl 0b   = " + fixed("\"\\u000b\""))
    println("fp doc      = " + fixed("{\"\\u0041\":[\"\\ud83d\\ude00\",1.5,null]}"))
    println("fp raw tab  = " + fixed("\"a\tb\""))
    println("fp esc tab  = " + fixed("\"a\\tb\""))

    # ---- the two OBJECT decisions, gated here because nothing else asserts --
    # them and a reader cannot infer either from the signatures. Both are named
    # in the corelib header under OBJECTS.
    #
    # DUPLICATE KEYS: every member is kept, so the round trip is byte-identical
    # and no member is invented or dropped; `get` answers with the FIRST.
    dup := "{\"a\":1,\"a\":2}"
    println("dup rt      = " + fixed(dup))
    println("dup keys    = " + str(len(json.keys(json.parse(dup)))))
    println("dup get     = " + str(json.as_num(json.get(json.parse(dup), "a"))))
    # NULL vs ABSENT: `get` collapses them -- both are JNull. The TREE tells them
    # apart and `keys` is the way to ask, which is what these three lines prove.
    na := json.parse("{\"n\":null,\"e\":\"\"}")
    println("null kind   = " + json.kind(json.get(na, "n")))
    println("empty kind  = " + json.kind(json.get(na, "e")))
    println("absent kind = " + json.kind(json.get(na, "missing")))
    println("get tells   = " + yn(json.kind(json.get(na, "n")) != json.kind(json.get(na, "missing"))))
    println("keys tell   = " + yn(has_key(na, "n") != has_key(na, "missing")))
    dp := ""
    dq := ""
    ins := "[\""
    for i := 0; i < 2000; i += 1:
        dp = dp + "["
    for i := 0; i < 2001; i += 1:
        dq = dq + "["
    for i := 0; i < 5000; i += 1:
        ins = ins + "["
    for i := 0; i < 2000; i += 1:
        dp = dp + "]"
    for i := 0; i < 2001; i += 1:
        dq = dq + "]"
    ins = ins + "\"]"
    println("depth_2000_ok=" + str(parsed_ok(dp)))
    println("depth_2001_refused=" + str(parsed_ok(dq) == false))
    println("brackets_in_string_ok=" + str(parsed_ok(ins)))

fn parsed_ok(s: string) -> bool:
    match json.parse_checked(s):
        Ok(_):
            return true
        Err(_):
            return false
