out    = build/app
level  = 3
missing= DEFAULT
has out= yes
has mis= no
verbose= yes
flag x = yes
flag z = yes
flag q = no
npos   = 4
pos[0]= input.txt
pos[1]= -
pos[2]= --not-an-option
pos[3]= last.txt
empty n= 0
repeat = b
spec root  = /srv/www
spec port  = 8080
spec quiet = yes
spec q     = yes
spec npos  = 2
spec nmiss = 0
spec nunk  = 0
spec pos[0]= file.txt
spec pos[1]= --root
both same  = yes
bool=val   = yes
miss n     = 1
miss[0]    = --port
unk n      = 4
unk[0]    = --bogus
unk[1]    = --bogus=1
unk[2]    = -x
unk[3]    = -qx
swallow    = --port
swallow nu = 0
free root  = no
free flag  = yes
free nmiss = 0
free nunk  = 0
nargs      = 1
nargv      = 0
