package main

import "core:hex"
import "core:varint"

fn hx(b: bytes) -> string:
    return hex.encode(to_str(b))

fn show_u(r: Result((u64, int), varint.VarintErr)) -> string:
    match r:
        Ok(pair): return str(to_int(pair.0)) + "/" + str(pair.1)
        Err(varint.Truncated): return "Truncated"
        Err(varint.Overflow): return "Overflow"

fn show_i(r: Result((int, int), varint.VarintErr)) -> string:
    match r:
        Ok(pair): return str(pair.0) + "/" + str(pair.1)
        Err(varint.Truncated): return "Truncated"
        Err(varint.Overflow): return "Overflow"

fn main():
    for v in [0, 1, 127, 128, 300, 624485]:
        println("u " + str(v) + "=" + hx(varint.put_u64(to_u64(v))))
    println("u max=" + hx(varint.put_u64(to_u64(-1))))
    println("u roundtrip=" + show_u(varint.get_u64(varint.put_u64(to_u64(624485)), 0)))
    println("u offset=" + show_u(varint.get_u64(to_bytes([170]) + varint.put_u64(to_u64(300)), 1)))

    for v in [0, -1, 1, -2, 64, -64, 123456, -123456]:
        println("i " + str(v) + "=" + hx(varint.put_i64(v)))
    println("i roundtrip=" + show_i(varint.get_i64(varint.put_i64(-123456), 0)))

    println("truncated=" + show_u(varint.get_u64(to_bytes([128]), 0)))
    println("empty=" + show_u(varint.get_u64(to_bytes([]int), 0)))
    println("overflow=" + show_u(varint.get_u64(to_bytes([255, 255, 255, 255, 255, 255, 255, 255, 255, 255]), 0)))
