package main
import "core:toml"

fn unwrap_int(v: Option(toml.Value)) -> int:        # value or -999
    match v:
        Some(toml.TInt(x)):
            return x
        _:
            return -999
fn unwrap_str(v: Option(toml.Value)) -> string:
    match v:
        Some(toml.TStr(s)):
            return s
        _:
            return "?"
fn unwrap_float2(v: Option(toml.Value)) -> int:     # int(2*f) or -999
    match v:
        Some(toml.TFloat(f)):
            return to_int(f * 2)
        _:
            return -999
fn unwrap_len(v: Option(toml.Value)) -> int:        # array length or -999
    match v:
        Some(toml.TArr(a)):
            return len(a)
        _:
            return -999

fn show_one(doc: string):
    match toml.parse(doc):
        Ok(v): println("ok")
        Err(e): println("err " + e)

fn main():
    lines := ["# a comment", "title = \"tycho\\u0041\"", "count = 42",
        "ratio = 1.5", "on = true", "hex = 0xFF", "oct = 0o17", "bin = 0b1010",
        "big = 1_000_000", "lit = 'no \\\\ escapes'", "tags = [\"a\", \"b\", \"c\"]",
        "nums = [1, 2, 3,]", "when = 2026-08-04T12:00:00Z", "[server]",
        "host = \"localhost\"", "port = 8080", "[server.details]", "threads = 4",
        "[[user]]", "name = \"ada\"", "[[user]]", "name = \"alan\""]
    doc := ""
    for l in lines:
        doc = doc + l + "\n"
    t := toml.empty_table()
    match toml.parse(doc):
        Ok(tt):
            t = tt
        Err(m):
            print("parse error: " + m + "\n")
            exit(1)
    print("title=" + unwrap_str(toml.get(t, "title")) + "\n")          # escape \u0041 -> A
    print("count=" + str(unwrap_int(toml.get(t, "count"))) + "\n")
    print("ratio=" + str(unwrap_float2(toml.get(t, "ratio"))) + "\n")  # 3
    print("on=" + str(unwrap_int(toml.get(t, "on")) == -999) + "\n")   # bool is not an int
    print("hex=" + str(unwrap_int(toml.get(t, "hex"))) + "\n")         # 255
    print("oct=" + str(unwrap_int(toml.get(t, "oct"))) + "\n")         # 15
    print("bin=" + str(unwrap_int(toml.get(t, "bin"))) + "\n")         # 10
    print("big=" + str(unwrap_int(toml.get(t, "big"))) + "\n")         # 1000000
    print("lit=" + unwrap_str(toml.get(t, "lit")) + "\n")              # literal, no escapes
    print("tags=" + str(unwrap_len(toml.get(t, "tags"))) + "\n")       # 3
    print("nums=" + str(unwrap_len(toml.get(t, "nums"))) + "\n")       # 3 (trailing comma)
    print("when=" + unwrap_str(toml.get(t, "when")) + "\n")            # ISO kept as string
    print("host=" + unwrap_str(toml.get(t, "server.host")) + "\n")    # dotted path
    print("port=" + str(unwrap_int(toml.get(t, "server.port"))) + "\n")
    print("threads=" + str(unwrap_int(toml.get(t, "server.details.threads"))) + "\n")
    print("users=" + str(unwrap_len(toml.get(t, "user"))) + "\n")      # 2 array-of-tables
    missing := false
    match toml.get(t, "nope"):
        None:
            missing = true
        Some(_):
            missing = false
    print("missing=" + str(missing) + "\n")
    cross := false
    match toml.get(t, "server.host.x"):
        None:
            cross = true
        Some(_):
            cross = false
    print("cross=" + str(cross) + "\n")
    # fail-closed: a bad line is an Err, and a bad doc yields no partial value
    bad_err := false
    match toml.parse("a = 1\nnot a key value line\n"):
        Err(_):
            bad_err = true
        Ok(_):
            bad_err = false
    print("bad=" + str(bad_err) + "\n")
    # NESTED ARRAYS and COMMAS INSIDE STRINGS. `split(body, ",")` was not aware
    # of either, so these four were REFUSED -- "bad number: 3]" and
    # "unterminated basic string" -- while being valid TOML.
    show_one("a = [1, [2, 3]]")
    show_one("a = [\"x,y\"]")
    show_one("a = [\"a,b\", [1, 2], \"c\"]")
    show_one("a = [1, [2, [3, 4]], 5]")
    # FAIL-CLOSED, which this package's header promises and did not deliver:
    # each of these was accepted, with a value invented or a key silently lost.
    show_one("a = [1, 2")            # was [1] -- an element dropped
    show_one("a = \"x\" y")          # was "x" -- trailing text discarded
    show_one("a = 1\na = 2")         # was 2 -- a duplicate key overrode silently
    # A repeated [t] REPLACED the earlier table, so x vanished entirely -- filed
    # as a strictness nit and actually the same data loss as the duplicate key
    # above, one worse: that one at least kept a value.
    show_one("[t]\nx = 1\n[t]\ny = 2")
    # ...while [[arr]] must STILL repeat, because that is how an array of tables
    # is spelled, and [a] then [a.b] must not collide -- without these two the
    # refusal above could be a blanket ban on any second header.
    show_one("[[a]]\nx = 1\n[[a]]\nx = 2")
    show_one("[a]\nx = 1\n[a.b]\ny = 2")
    parent_after_child := toml.parse("[a.b]\nx = 1\n[a]\ny = 2")
    parent_values := false
    match parent_after_child:
        Ok(m): parent_values = unwrap_int(toml.get(m, "a.b.x")) == 1 and unwrap_int(toml.get(m, "a.y")) == 2
        Err(_): parent_values = false
    println("parent-after-child=" + str(parent_values))
    nested_aot := toml.parse("[[fruit]]\nname = 'apple'\n[fruit.physical]\ncolor = 'red'\n[[fruit.varieties]]\nname = 'red'\n[[fruit]]\nname = 'banana'\n[[fruit.varieties]]\nname = 'yellow'")
    nested_aot_ok := false
    match nested_aot:
        Ok(m):
            match toml.get(m, "fruit"):
                Some(toml.TArr(fs)):
                    first_varieties := toml.get(fs[0], "varieties")
                    second_varieties := toml.get(fs[1], "varieties")
                    nested_aot_ok = len(fs) == 2 and unwrap_str(toml.get(fs[0], "physical.color")) == "red" and unwrap_len(first_varieties) == 1 and unwrap_len(second_varieties) == 1
                _: nested_aot_ok = false
        Err(_): nested_aot_ok = false
    println("nested-array-tables=" + str(nested_aot_ok))
    # A DATETIME's time half was accepted whole: `T99:99:99` parsed. Each of
    # these must be refused, and the six below must still be accepted -- a
    # refuse-everything check scores full marks on the refusals alone.
    show_one("a = 2023-01-01T99:99:99")
    show_one("a = 2023-01-01T25:61:61+99:99")
    show_one("a = 2023-01-01hello")
    show_one("a = 2023-01-01T12:00:00+24:00")
    show_one("a = 2023-01-01T12:00:00.")
    show_one("a = 2023-01-01T12:00")
    show_one("a = 2023-01-01T12:00:00ZZ")
    show_one("a = 2023-01-01")
    show_one("a = 2023-01-01T12:00:00")
    show_one("a = 2023-01-01T12:00:00Z")
    show_one("a = 2023-01-01 12:00:00z")
    show_one("a = 2023-01-01T23:59:60.123456-05:30")

    deep_value := ""
    deep_path := ""
    for i := 0; i < 129; i += 1:
        deep_value += "["
        if i > 0:
            deep_path += "."
        deep_path += "a"
    deep_value += "0"
    for i := 0; i < 129; i += 1:
        deep_value += "]"
    deep_value_rejected := false
    match toml.parse("value = " + deep_value):
        Err(_): deep_value_rejected = true
        Ok(_): deep_value_rejected = false
    header_depth_rejected := false
    match toml.parse("[" + deep_path + "]\nx = 1"):
        Err(_): header_depth_rejected = true
        Ok(_): header_depth_rejected = false
    many_entries := ""
    for i := 0; i < 513; i += 1:
        many_entries += "k" + str(i) + " = 0\n"
    entry_cap_rejected := false
    match toml.parse(many_entries):
        Err(_): entry_cap_rejected = true
        Ok(_): entry_cap_rejected = false
    oversized := ""
    for i := 0; i < 65537; i += 1:
        oversized += " "
    input_cap_rejected := false
    match toml.parse(oversized):
        Err(_): input_cap_rejected = true
        Ok(_): input_cap_rejected = false
    println("nesting-caps=" + str(deep_value_rejected) + "," + str(header_depth_rejected))
    println("size-caps=" + str(entry_cap_rejected) + "," + str(input_cap_rejected))

    quoted_key_ok := false
    match toml.parse("\"google.com\" = 1"):
        Ok(v):
            ks := toml.keys(v)
            quoted_key_ok = len(ks) == 1 and ks[0] == "google.com"
            match toml.get(v, "\"google.com\""):
                Some(toml.TInt(n)): quoted_key_ok = quoted_key_ok and n == 1
                _: quoted_key_ok = false
        Err(_): quoted_key_ok = false
    quoted_header_ok := false
    match toml.parse("[\"x.y\"]\nz = 1"):
        Ok(v):
            ks := toml.keys(v)
            quoted_header_ok = len(ks) == 1 and ks[0] == "x.y"
            match toml.get(v, "\"x.y\".z"):
                Some(toml.TInt(n)): quoted_header_ok = quoted_header_ok and n == 1
                _: quoted_header_ok = false
        Err(_): quoted_header_ok = false
    quoted_escape_ok := false
    match toml.parse("\"a\\\"b\" = 1"):
        Ok(v):
            ks := toml.keys(v)
            quoted_escape_ok = len(ks) == 1 and ks[0] == "a\"b"
        Err(_): quoted_escape_ok = false
    quoted_bad := false
    match toml.parse("[a]\nx = 1\n[\"a\"]\ny = 2"):
        Err(_): quoted_bad = true
        Ok(_): quoted_bad = false
    literal_bad := false
    match toml.parse("x = 'a' 'b'"):
        Err(_): literal_bad = true
        Ok(_): literal_bad = false
    surrogate_bad := false
    match toml.parse("x = \"\\uD800\""):
        Err(_): surrogate_bad = true
        Ok(_): surrogate_bad = false
    println("quoted-keys=" + str(quoted_key_ok) + "," + str(quoted_header_ok) + "," + str(quoted_escape_ok) + "," + str(quoted_bad))
    println("malformed-strings=" + str(literal_bad) + "," + str(surrogate_bad))
