package main

import "core:gfx3d"

fn main():
    cam := gfx3d.look_at(gfx3d.Vec3(0.0, 0.0, 0.0),
                         gfx3d.Vec3(0.0, 0.0, 1.0),
                         gfx3d.Vec3(0.0, 1.0, 0.0), 100.0)
    target := gfx3d.Target(100, 100)
    p := gfx3d.project(cam, target, gfx3d.Vec3(0.0, 0.0, 1.0))
    println("project=" + str(to_int(p.x)) + " " + str(to_int(p.y)) + " " +
            str(to_int(p.invz)) + " " + str(p.ok))

    fb := []int
    zbuf := []float
    reserve(fb, target.w * target.h)
    reserve(zbuf, target.w * target.h)
    for i := 0; i < target.w * target.h; i += 1:
        push(fb, 0)
        push(zbuf, 0.0)

    green := 4278255360
    red := 4294901760
    gfx3d.clear(&fb, &zbuf, target, green)

    # A green wall sits at depth 2 behind a red triangle whose left vertex is
    # at depth 1 and whose right vertices are at depth 10. At the left side the
    # red triangle must win; swapping the barycentric depth weights would let
    # the far vertices (or the wall) win instead.
    gfx3d.draw_quad(&fb, &zbuf, target, cam,
                    gfx3d.Vec3(-1.0, -1.0, 2.0), gfx3d.Vec3(1.0, -1.0, 2.0),
                    gfx3d.Vec3(1.0, 1.0, 2.0), gfx3d.Vec3(-1.0, 1.0, 2.0), green)
    gfx3d.draw_tri(&fb, &zbuf, target, cam,
                   gfx3d.Vec3(-0.4, 0.0, 1.0), gfx3d.Vec3(0.8, 0.0, 10.0),
                   gfx3d.Vec3(0.0, 0.8, 10.0), red)

    idx := 49 * target.w + 25
    if fb[idx] == red:
        println("depth=red")
    else:
        println("depth=" + str(fb[idx]))

    # A triangle crossing the near plane must still contribute its visible part.
    gfx3d.clear(&fb, &zbuf, target, green)
    gfx3d.draw_tri(&fb, &zbuf, target, cam,
                   gfx3d.Vec3(-0.3, 0.0, 3.0), gfx3d.Vec3(0.3, 0.0, 3.0),
                   gfx3d.Vec3(0.0, 0.5, -1.0), red)
    clipped := 0
    for i := 0; i < len(fb); i += 1:
        if fb[i] == red:
            clipped = clipped + 1
    if clipped > 0:
        println("clip=ok")
    else:
        println("clip=none")

    m := gfx3d.mesh()
    gfx3d.add_box(&m, 0.0, 0.0, 3.0, 0.8, 0.8, 0.8, red)
    place := gfx3d.Place(gfx3d.Vec3(0.0, 0.0, 0.0),
                         gfx3d.Vec3(1.0, 0.0, 0.0),
                         gfx3d.Vec3(0.0, 1.0, 0.0),
                         gfx3d.Vec3(0.0, 0.0, 1.0), 1.0)
    gfx3d.clear(&fb, &zbuf, target, green)
    gfx3d.draw_mesh(&fb, &zbuf, target, cam, &m, place)
    if fb[50 * target.w + 50] != green:
        println("mesh=ok")
    else:
        println("mesh=none")
