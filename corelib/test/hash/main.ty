package main
import "core:hash"

fn b2i(b: bool) -> int:
    if b:
        return 1
    return 0

fn main():
    println("crc ''     = " + hash.to_hex(hash.crc32("")))          # 00000000
    println("crc a      = " + hash.to_hex(hash.crc32("a")))         # e8b7be43
    println("crc abc    = " + hash.to_hex(hash.crc32("abc")))       # 352441c2
    println("crc check  = " + hash.to_hex(hash.crc32("123456789"))) # cbf43926

    # ---- FNV-1a 32 (reference vectors) ----
    println("fnv ''     = " + hash.to_hex(hash.fnv1a_32("")))       # 811c9dc5
    println("fnv a      = " + hash.to_hex(hash.fnv1a_32("a")))      # e40c292c
    println("fnv foobar = " + hash.to_hex(hash.fnv1a_32("foobar"))) # bf9cf968

    # ---- djb2 / sdbm (hand-computed for short inputs) ----
    println("djb2 a     = " + str(hash.djb2("a")))                  # 177670
    println("djb2 ab    = " + str(hash.djb2("ab")))                 # 5863208
    println("sdbm ''    = " + str(hash.sdbm("")))                   # 0
    println("sdbm a     = " + str(hash.sdbm("a")))                  # 97
    println("sdbm ab    = " + str(hash.sdbm("ab")))                 # 6363201

    # ---- to_hex sanity + values stay non-negative and 32-bit ----
    println("tohex 0    = " + hash.to_hex(0))                       # 00000000
    c := hash.crc32("tycho")
    f := hash.fnv1a_32("tycho")
    cc := b2i(c >= 0 and c < 4294967296)
    ff := b2i(f >= 0 and f < 4294967296)
    println(f"in_range crc={cc} fnv={ff}")                              # in_range crc=1 fnv=1

    # ---- hash(x): the generic builtin over any hashable value ----
    # DETERMINISTIC since the deterministic-hash phase: fixed keys/seed, so the
    # same value hashes the same on every run and every machine (the byte-locked
    # golden below is the cross-run proof -- a seeded hash would redden it every
    # run). Equal-by-== values always hash equal. Full 64-bit as a signed int.
    h1 := hash("ab")
    h2 := hash("ab")
    println("ghash str  = " + str(b2i(h1 == h2)))                            # 1
    println("ghash int  = " + str(b2i(hash(7) != hash(8))))                 # 1
    println("ghash arr  = " + str(b2i(hash([1, 2, 3]) == hash([1, 2, 3]))))  # 1
    println("ghash tup  = " + str(b2i(hash((1, "x")) == hash((1, "x")))))   # 1
    println("ghash nest = " + str(b2i(hash([["a"], ["b"]]) == hash([["a"], ["b"]]))))  # 1
    println("ghash det  = " + str(hash(7)) + " " + str(hash("ab")) + " " + str(hash((1, "x"))))

    # ---- xxHash vectors ----
    println("xxh32 empty=" + str(hash.xxh32("", 0) == to_u32(0x02CC5D05)))
    println("xxh32 a=" + str(hash.xxh32("a", 0) == to_u32(0x550D7456)))
    println("xxh32 abc=" + str(hash.xxh32("abc", 0) == to_u32(0x32D153FF)))
    println("xxh64 empty=" + str(hash.xxh64("", 0) == ((to_u64(0xEF46DB37) << 32) | to_u64(0x51D8E999))))
    println("xxh64 abc=" + str(hash.xxh64("abc", 0) == ((to_u64(0x44BC2CF5) << 32) | to_u64(0xAD770999))))
    println("xxh64 long=" + str(hash.xxh64("0123456789abcdef0123456789abcdef0123456789abcdef", 0) != to_u64(0)))

    # ---- CRC-16, CRC-64, Adler-32, Murmur3, FNV-1a 64 ----
    println("crc16=" + str(hash.crc16_ccitt("123456789") == 10673))
    println("crc64=" + str(hash.crc64_ecma("123456789") == ((to_u64(0x6C40DF5F) << 32) | to_u64(0x0B497347))))
    println("adler32=" + str(hash.adler32("Wikipedia") == 300286872))
    println("adler32b=" + str(hash.adler32("123456789") == 152961502))
    println("murmur3=" + str(hash.murmur3_32("hello", 0) == to_u32(0x248BFA47)))
    println("murmur3a=" + str(hash.murmur3_32("a", 0) == to_u32(0x3C2569B2)))
    println("fnv64_empty=" + str(hash.fnv1a_64("") == ((to_u64(0xCBF29CE4) << 32) | to_u64(0x84222325))))
    println("fnv64_a=" + str(hash.fnv1a_64("a") == ((to_u64(0xAF63DC4C) << 32) | to_u64(0x8601EC8C))))
    println("fnv64_foobar=" + str(hash.fnv1a_64("foobar") == ((to_u64(0x85944171) << 32) | to_u64(0xF73967E8))))
