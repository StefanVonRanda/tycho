# corelib test: exercises core:result -- the Result/Option collapses that every
# caller was hand-writing as a four-line `match` before this package existed
# (the option-result plan). Pure computation, no filesystem and no socket, so the run is
# hermetic. Output locked to corelib/test/result.out (corelib/run.sh).
#
# The point of each assertion:
#   * the combinators are generic -- int, string, bytes and a struct payload all
#     instantiate from the same four lines
#   * they work over an error type declared in ANOTHER package (io.IoErr) as well
#     as one declared locally
#   * err_or + `==` is one way a caller asks WHICH failure; since the friction plan
#     a NESTED PATTERN (`Err(io.NotFound):`) is the other, and the last third of
#     this file is its regression -- see `why`, `sized` and `outcome` below
#
# THIS is the regression home for nested patterns and for a Result inside a tuple
# literal, and the reason WAS the frozen compiler, not taste: `tests/*.ty` and
# `tests/pkg/*/main.ty` used to be fed to compiler/tychoc0.ty by
# compiler/fixpoint.sh and scripts/frontparity.sh, and tychoc0 is frozen at a
# grammar that has neither construct. corelib/test/ is golden-validated by
# corelib/run.sh, reached no frozen compiler, so a new-syntax fixture could live
# here and nowhere in tests/.
#
# THAT CONSTRAINT NO LONGER BINDS. Both lanes were retired on 2026-07-29 and
# nothing builds tychoc0 any more (see the header of compiler/fixpoint.sh,
# ROADMAP.md and docs/architecture.md).
#
# SETTLED 2026-07-30, and nothing here moved. Both constructs now have their own
# tests/ fixture -- tests/nested_pattern.ty and tests/result_tuple.ty -- scored by
# the main golden loop (native + ASan + byte-identical + golden), which is the
# discipline the freeze had been costing them. This file is NOT that fixture's
# duplicate and is not going anywhere: it is the core:result lane, and it is the
# only place the two constructs are exercised THROUGH the combinators and across
# a package boundary (io.IoErr). Its placement was over-determined all along --
# the freeze was one reason among several, and it was never the load-bearing one.
# See docs/spec/appendix-e-conformance.md §E.1's 2026-07-30 note for the
# convention this settles on.
package main
import "core:result"
import "core:io"

fn b(x: bool) -> int:
    if x:
        return 1
    return 0

enum Local:
    Nope
    Worse
    Sized(int, string)                           # a payload-carrying variant, for Err(Sized(n, s))

struct Pair:
    a: int
    b: string

fn mk(ok: bool) -> Result(int, Local):
    if ok:
        return Ok(7)
    return Err(Worse)

fn mkstr(ok: bool) -> Result(string, Local):
    if ok:
        return Ok("hi")
    return Err(Nope)

fn mkpair(ok: bool) -> Result(Pair, Local):
    if ok:
        return Ok(Pair(1, "one"))
    return Err(Nope)

fn mkopt(ok: bool) -> Option(string):
    if ok:
        return Some("here")
    return None

# ---- map_err: or_return across TWO error types (the friction plan) ------------
# The regression for the one thing `or_return` could not do. `two_types` owns
# Result(int, io.IoErr); `mk` fails with a Local, declared in this file. Before
# map_err there was no conversion between error enums, so a function touching two
# packages' fallible calls got or_return for whichever error type it adopted and a
# hand-written collapse for the other -- which continues with a value nobody
# produced (FRICTION.md:152). map_err re-labels the error, so the failure ENDS the
# function, and the ONE type param that moves is the error's: $T passes through.
fn two_types(ok: bool) -> Result(int, io.IoErr):
    n := result.map_err(mk(ok), io.Failed) or_return
    return Ok(n * 3)

# ---- nested patterns (the friction plan / FRICTION.md:139) -------------------
#
# Before 2026-07-26 none of the three arms below could be written:
#   Err(Worse)     PARSED -- as a binding named `Worse`, so it matched EVERY Err.
#                  A second Err arm was the only symptom: "duplicate Err arm".
#   Err(io.IsDir)  error: expected ')'
#   Err(Sized(n))  error: expected ')'
# The first is the one that mattered: a wrong parse, not a rejected one.
fn why(k: int) -> string:
    match pick(k):
        Ok(v): return "ok " + str(v)
        Err(Worse): return "worse"                # bare nullary variant: a PATTERN, not a binding
        Err(Nope): return "nope"
        Err(Sized(n, s)): return "sized " + str(n) + " " + s   # the nested variant's own payload

fn pick(k: int) -> Result(int, Local):
    if k == 0:
        return Ok(42)
    if k == 1:
        return Err(Worse)
    if k == 2:
        return Err(Nope)
    return Err(Sized(9, "nine"))

# The refined arms cover every variant of Local, so the match is exhaustive with
# NO unrefined `Err(e)` arm and no `_`. A qualified nested pattern (io.NotFound)
# and an `_` fallback are exercised too.
fn io_why(p: string) -> string:
    match io.read_bytes(p):
        Ok(bs): return "read " + str(len(bs))
        Err(io.NotFound): return "absent"
        Err(io.IsDir): return "a directory"
        _: return "other"

# ---- a Result as a tuple literal element (FRICTION.md:159) -----------------
#
# `return (Err(Worse), "partial")` was rejected with "tuple element 1 needs a
# concrete value" -- E_TUPLE only ever synthesized, and Ok/Err synthesize to a
# partial type that context has to ground.
#
# The old note here said httpd.read_request_capped still builds its outcome in a
# typed local "because it is compiled by frozen tychoc0". That reason expired on
# 2026-07-29 when the tychoc0 lanes were retired; the function's real constraint
# is the one measured in appendix-e-conformance.md §E.2.1. This note used to go on
# to claim that rewriting the tail to `return (Err(why), buf)` "still fails,
# because the Ok payload type cannot be grounded from a partially-inferred
# Request". That claim is FALSE and was corrected on 2026-08-01: the neighbouring
# file already disproves it in its own comment, which records the measurement --
# `corelib/httpd/httpd.ty@read_request_capped` says the rewrite "compiles under
# src/tychoc.c" and that its typed local is "now a style choice ... not a
# requirement". Two files, one construct, opposite claims, and the wrong one sat
# in the test that exists to document the construct. tests/result_tuple.ty is this
# construct's tests/ fixture as of 2026-07-30.
fn outcome(ok: bool) -> (Result(int, Local), string):
    if ok:
        return (Ok(3), "full")
    return (Err(Worse), "partial")

fn main():
    # ---- unwrap_or: the workhorse, over four different payload types ----
    println("int_ok    = " + str(result.unwrap_or(mk(true), -1)))
    println("int_err   = " + str(result.unwrap_or(mk(false), -1)))
    println("str_ok    = " + result.unwrap_or(mkstr(true), "fallback"))
    println("str_err   = " + result.unwrap_or(mkstr(false), "fallback"))
    dp := Pair(0, "none")                        # bind: a struct literal is fine, but see below
    println("struct_ok = " + result.unwrap_or(mkpair(true), dp).b)
    println("struct_err= " + result.unwrap_or(mkpair(false), dp).b)

    # ---- is_ok / is_err ----
    println("is_ok     = " + str(b(result.is_ok(mk(true)))) + " " + str(b(result.is_ok(mk(false)))))
    println("is_err    = " + str(b(result.is_err(mk(true)))) + " " + str(b(result.is_err(mk(false)))))

    # ---- err_or: WHICH failure, compared with == on a payload-free variant ----
    dl := Nope
    println("err_of_err= " + str(b(result.err_or(mk(false), dl) == Worse)))
    println("err_of_ok = " + str(b(result.err_or(mk(true), dl) == Nope)))   # the fallback

    # ---- an error type from ANOTHER package: io.IoErr over bytes ----
    # Both defaults are written inline as qualified names -- the resolution bug
    # that forced them into locals is fixed (the friction plan).
    miss := io.read_bytes("/tmp/tycho_corelib_result_absent.xyz")
    println("io_is_err = " + str(b(result.is_err(miss))))
    println("io_why    = " + str(b(result.err_or(miss, io.Failed) == io.NotFound)))
    println("io_bytes  = " + str(len(result.unwrap_or(miss, to_bytes("")))))

    # ---- the Option half ----
    println("some_or   = " + result.some_or(mkopt(true), "dflt"))
    println("none_or   = " + result.some_or(mkopt(false), "dflt"))
    println("is_some   = " + str(b(result.is_some(mkopt(true)))) + " " + str(b(result.is_some(mkopt(false)))))

    # ---- nested patterns: one arm per cause, no second match and no `==` ----
    println("nest_ok   = " + why(0))
    println("nest_bare = " + why(1))
    println("nest_bare2= " + why(2))
    println("nest_pay  = " + why(3))
    println("nest_qual = " + io_why("/tmp/tycho_corelib_result_absent.xyz"))
    println("nest_dir  = " + io_why("/tmp"))

    # ---- a Result inside a tuple literal, destructured by the caller ----
    r1, s1 := outcome(true)
    r2, s2 := outcome(false)
    println("tup_ok    = " + s1 + " " + str(result.unwrap_or(r1, -1)))
    println("tup_err   = " + s2 + " " + str(result.unwrap_or(r2, -1)))

    # ---- map_err: the Ok passes through, the Err is re-labelled, or_return works ----
    println("map_ok    = " + str(result.unwrap_or(two_types(true), -1)))         # 21: 7 * 3
    println("map_err   = " + str(result.unwrap_or(two_types(false), -1)))        # -1: it returned early
    println("map_why   = " + str(b(result.err_or(two_types(false), io.NotFound) == io.Failed)))
    println("map_thru  = " + result.unwrap_or(result.map_err(mkstr(true), io.Failed), "no"))
