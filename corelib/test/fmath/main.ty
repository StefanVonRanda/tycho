package main
import "core:fmath"
import "core:math"     # min/max/clamp/sign are generic in core:math now (exercised here over float)

fn main():
    println(f"minmax={math.min(2.5, 1.5)},{math.max(2.5, 1.5)}")                # 1.5,2.5 (generic over float)
    println(f"clamp={math.clamp(5.0, 0.0, 1.0)},{math.clamp(0.0 - 1.0, 0.0, 1.0)}")   # 1.0,0.0
    println(f"sign={math.sign(0.0 - 3.0)},{math.sign(3.0)},{math.sign(0.0)}")          # -1,1,0 (sign returns int)
    println(f"round={fmath.round(2.5)},{fmath.round(0.0 - 2.5)},{fmath.round(2.4)}")    # 3.0,-3.0,2.0
    println(f"trunc={fmath.trunc(2.9)},{fmath.trunc(0.0 - 2.9)}")                       # 2.0,-2.0
    println(f"lerp={fmath.lerp(0.0, 10.0, 0.25)}")                                      # 2.5
    println(f"approx={fmath.approx_eq(0.1, 0.1, 0.0001)},{fmath.approx_eq(0.1, 0.2, 0.0001)}")
    println(f"consts={fmath.pi() > 3.0},{fmath.e() > 2.0}")
    # ---- libm bridge: compare with approx_eq, never print raw transcendentals ----
    println("sin0=" + str(fmath.approx_eq(fmath.sin(0.0), 0.0, 0.0000001)))
    println("cos0=" + str(fmath.approx_eq(fmath.cos(0.0), 1.0, 0.0000001)))
    println("sin90=" + str(fmath.approx_eq(fmath.sin(fmath.pi() / 2.0), 1.0, 0.0000001)))
    println("tan45=" + str(fmath.approx_eq(fmath.tan(fmath.pi() / 4.0), 1.0, 0.0000001)))
    println("atan2=" + str(fmath.approx_eq(fmath.atan2(1.0, 1.0), fmath.pi() / 4.0, 0.0000001)))
    println("asin1=" + str(fmath.approx_eq(fmath.asin(1.0), fmath.pi() / 2.0, 0.0000001)))
    println("exp0=" + str(fmath.approx_eq(fmath.exp(0.0), 1.0, 0.0000001)))
    println("logE=" + str(fmath.approx_eq(fmath.log(fmath.e()), 1.0, 0.0000001)))
    println("log2=" + str(fmath.approx_eq(fmath.log2(8.0), 3.0, 0.0000001)))
    println("log10=" + str(fmath.approx_eq(fmath.log10(1000.0), 3.0, 0.0000001)))
    println("hypot=" + str(fmath.approx_eq(fmath.hypot(3.0, 4.0), 5.0, 0.0000001)))
    println("degrees=" + str(fmath.approx_eq(fmath.degrees(fmath.pi()), 180.0, 0.0000001)))
    println("radians=" + str(fmath.approx_eq(fmath.radians(180.0), fmath.pi(), 0.0000001)))
    println("sinh0=" + str(fmath.approx_eq(fmath.sinh(0.0), 0.0, 0.0000001)) + " cosh0=" + str(fmath.approx_eq(fmath.cosh(0.0), 1.0, 0.0000001)))
