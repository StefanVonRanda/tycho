# corelib test: core:decimal (built on core:bignum). Pure base-10 arithmetic -> fully
# deterministic. The headline is 0.1 + 0.2 == 0.3 EXACTLY (a float cannot). The output
# is locked to corelib/test/decimal.out (corelib/run.sh). The tychoc0 cross-check this
# line used to claim was retired 2026-07-29.
package main
import "core:decimal"

fn b2i(b: bool) -> int:
    if b:
        return 1
    return 0

# Render a div result: the value, or which refusal it was.
fn dstr(r: Result(decimal.Decimal, decimal.DivErr)) -> string:
    match r:
        Ok(d):
            return decimal.to_str(d)
        Err(e):
            match e:
                decimal.BadScale(s):
                    return "ERR:scale" + str(s)
                decimal.BadMode(m):
                    return "ERR:mode" + str(m)
                _:
                    return "ERR:divzero"

fn dv(a: string, b: string, sc: int, mode: int) -> string:
    return dstr(decimal.div(decimal.from_str(a), decimal.from_str(b), sc, mode))

# from_str_checked rendered one way, so the two assertion lines below stay short.
fn ck(s: string) -> string:
    match decimal.from_str_checked(s):
        Ok(d): return decimal.to_str(d)
        Err(e): return "ERR:" + decimal.err_str(e)
    return "?"

fn main():
    # from_str / to_str round-trips, stored scale preserved
    println("rt=" + decimal.to_str(decimal.from_str("123.45")) + " " + decimal.to_str(decimal.from_str("-0.001")) + " " + decimal.to_str(decimal.from_str("42")) + " " + decimal.to_str(decimal.from_str("1000.00")))
    println("lead=" + decimal.to_str(decimal.from_str(".5")) + " " + decimal.to_str(decimal.from_str("-.25")))

    # the classic: 0.1 + 0.2 == 0.3 exactly (float gives 0.30000000000000004)
    s := decimal.add(decimal.from_str("0.1"), decimal.from_str("0.2"))
    println("point3=" + decimal.to_str(s) + " ok=" + str(b2i(decimal.to_str(s) == "0.3")))

    # add across scales / sub with borrow across the point
    println("add_mixed=" + decimal.to_str(decimal.add(decimal.from_str("1.5"), decimal.from_str("2.25"))))   # 3.75
    println("sub=" + decimal.to_str(decimal.sub(decimal.from_str("10.00"), decimal.from_str("0.01"))))       # 9.99

    # mul: scales add
    println("mul=" + decimal.to_str(decimal.mul(decimal.from_str("1.5"), decimal.from_str("1.5"))) + " " + decimal.to_str(decimal.mul(decimal.from_str("0.1"), decimal.from_str("0.1"))))   # 2.25 0.01

    # cmp: 1.5 == 1.50, 1.5 < 1.6, 2.0 > 1.99
    println("cmp=" + str(decimal.cmp(decimal.from_str("1.5"), decimal.from_str("1.50"))) + " " + str(decimal.cmp(decimal.from_str("1.5"), decimal.from_str("1.6"))) + " " + str(decimal.cmp(decimal.from_str("2.0"), decimal.from_str("1.99"))))

    # neg / abs
    println("negabs=" + decimal.to_str(decimal.neg(decimal.from_str("3.14"))) + " " + decimal.to_str(decimal.abs(decimal.from_str("-3.14"))))

    # rescale: increase is exact, decrease truncates toward zero
    println("rescale=" + decimal.to_str(decimal.rescale(decimal.from_str("1.5"), 4)) + " " + decimal.to_str(decimal.rescale(decimal.from_str("1.23456"), 2)))   # 1.5000 1.23

    # arbitrary precision: a 39-digit-coefficient decimal round-trips
    big := "123456789012345678901234567890.987654321"
    println("bigprec_ok=" + str(b2i(decimal.to_str(decimal.from_str(big)) == big)))

    # exact money: 100 * 0.01 == 1.00 with no drift
    acc := decimal.from_int(0)
    i := 0
    for i < 100:
        acc = decimal.add(acc, decimal.from_str("0.01"))
        i = i + 1
    println("cents=" + decimal.to_str(acc) + " ok=" + str(b2i(decimal.to_str(acc) == "1.00")))

    # div: exact answers, at the scale the caller asked for. Both modes agree here,
    # because there is no remainder to round.
    println("div_exact=" + dv("6", "2", 0, decimal.half_up()) + " " + dv("6", "2", 0, decimal.toward_zero()) + " " + dv("1.00", "4", 2, decimal.half_up()) + " " + dv("1.00", "4", 2, decimal.toward_zero()))

    # a repeating decimal, cut at the requested scale. 1/3 has no tie to break;
    # 2/3 does, so the two modes part company on the last digit.
    println("div_repeat=" + dv("1", "3", 5, decimal.half_up()) + " " + dv("1", "3", 5, decimal.toward_zero()) + " " + dv("2", "3", 5, decimal.half_up()) + " " + dv("2", "3", 5, decimal.toward_zero()))

    # the modes disagreeing on the SAME input, including the exact tie 1/2 at scale 0
    # (half-up rounds away from zero, toward-zero drops it).
    println("div_modes=" + dv("2", "3", 2, decimal.half_up()) + " " + dv("2", "3", 2, decimal.toward_zero()) + " " + dv("1", "2", 0, decimal.half_up()) + " " + dv("1", "2", 0, decimal.toward_zero()))

    # scale 0: 7/2 is 4 rounded half-up, 3 truncated.
    println("div_scale0=" + dv("7", "2", 0, decimal.half_up()) + " " + dv("7", "2", 0, decimal.toward_zero()))

    # negative operands: the sign comes from the operands, the magnitude is rounded
    # the same way, and two negatives make a positive.
    println("div_neg=" + dv("-2", "3", 2, decimal.half_up()) + " " + dv("2", "-3", 2, decimal.half_up()) + " " + dv("-2", "-3", 2, decimal.half_up()) + " " + dv("-2", "3", 2, decimal.toward_zero()))

    # TOWARD_ZERO must agree with rescale, which also truncates -- x/1 at scale 2 is
    # exactly rescale(x, 2), on both signs.
    tz := dv("1.23456", "1", 2, decimal.toward_zero()) + " " + dv("-1.23456", "1", 2, decimal.toward_zero())
    rs := decimal.to_str(decimal.rescale(decimal.from_str("1.23456"), 2)) + " " + decimal.to_str(decimal.rescale(decimal.from_str("-1.23456"), 2))
    println("div_vs_rescale=" + tz + " ok=" + str(b2i(tz == rs)))

    # the refusals: a zero divisor is an Err, not an abort; so are a negative scale
    # and a mode that is neither of the two.
    println("div_err=" + dv("1", "0", 2, decimal.half_up()) + " " + dv("1", "0.00", 2, decimal.toward_zero()) + " " + dv("1", "2", 0 - 1, decimal.half_up()) + " " + dv("1", "2", 2, 9))

    # from_str_checked: the STRICT sibling. from_str is lax and, unlike parse_int,
    # does not fail to 0 -- the scale counts the garbage as a digit position, so
    # "1.5x" is 0.15 and "1.2.3" is 0.012, plausible WRONG NUMBERS in the type this
    # package exists to make exact. Both are asserted here against the lax answer,
    # so the split is visible and a regression that made from_str strict, or
    # from_str_checked lax, moves this line.
    println("lax_wrong=" + decimal.to_str(decimal.from_str("1.5x")) + " " + decimal.to_str(decimal.from_str("1.2.3")) + " " + decimal.to_str(decimal.from_str("1,5")))
    println("strict_ok=" + ck("1.5") + " " + ck("1.50") + " " + ck("-2.25") + " " + ck("+3") + " " + ck(".5") + " " + ck("5.") + " " + ck("99999999999999999999.5"))
    println("strict_err=" + ck("1.5x") + " " + ck("1.2.3") + " " + ck("") + " " + ck("-") + " " + ck(".") + " " + ck("abc") + " " + ck(" 1.5") + " " + ck("1e5") + " " + ck("1,5"))
