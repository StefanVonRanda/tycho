package main

import "core:intern"

struct Pt:
    x: int
    y: int

fn main():
    # string keys
    i := intern.Interner([]int, []string: int)
    a := intern.intern(&i, "alpha", 10)
    b := intern.intern(&i, "beta", 20)
    a2 := intern.intern(&i, "alpha", 999)      # hit: same handle, 999 dropped
    println("str: get(a)=" + str(intern.get(i, a)) + " get(b)=" + str(intern.get(i, b)))
    println("str: canonical=" + str(a == a2) + " count=" + str(intern.count(i)))

    # [int] keys
    j := intern.Interner([]string, [][int]: int)
    p := intern.intern(&j, [1, 2, 3], "triplet")
    q := intern.intern(&j, [4, 5], "pair")
    p2 := intern.intern(&j, [1, 2, 3], "again")
    println("arr: get(p)=" + intern.get(j, p) + " get(q)=" + intern.get(j, q))
    println("arr: canonical=" + str(p == p2) + " count=" + str(intern.count(j)))

    # struct keys (generic hashable keys: the map hashes composites natively)
    k := intern.Interner([]string, []Pt: int)
    r := intern.intern(&k, Pt(1, 2), "one-two")
    s := intern.intern(&k, Pt(3, 4), "three-four")
    r2 := intern.intern(&k, Pt(1, 2), "again")
    println("st: get(r)=" + intern.get(k, r) + " get(s)=" + intern.get(k, s))
    println("st: canonical=" + str(r == r2) + " count=" + str(intern.count(k)))

    # tuple keys
    t := intern.Interner([]int, [](int, string): int)
    u := intern.intern(&t, (7, "seven"), 70)
    v := intern.intern(&t, (8, "eight"), 80)
    u2 := intern.intern(&t, (7, "seven"), 99)
    println("tu: get(u)=" + str(intern.get(t, u)) + " get(v)=" + str(intern.get(t, v)))
    println("tu: canonical=" + str(u == u2) + " count=" + str(intern.count(t)))
