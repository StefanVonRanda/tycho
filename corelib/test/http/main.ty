package main
import "core:http"
import "core:io"

fn b2i(b: bool) -> int:
    if b:
        return 1
    return 0

fn main():
    dead := "http://127.0.0.1:1/"          # a closed loopback port: connection refused

    r := http.get(dead)
    okv := b2i(http.ok(r))
    nullv := b2i(is_null(r))
    println(f"ok={okv} null={nullv} status={http.status(r)}")   # ok=0 null=1 status=0
    println("body=[" + http.body(r) + "]")                      # body=[]
    http.release(r)                                             # safe on a null handle

    gb := http.get_body(dead)
    gs := http.get_status(dead)
    println(f"get_body=[{gb}] get_status={gs}")                 # get_body=[] get_status=0

    # The SCHEME fence. Until this was added, an unfenced CURLOPT_URL made
    # http.get("file:///etc/passwd") a working file read -- every scheme the
    # linked libcurl carries (FILE, FTP, SCP, SMTP, GOPHER...) was reachable.
    # These legs are not decoration: they are the only place in the tree that
    # would notice the fence being dropped from the FIRST hop, and each one
    # returned real bytes before it existed.
    p := "/tmp/tycho_corelib_http_nul.txt"
    wrote := io.write(p, "eighteen bytes ok\n")
    base := "file://" + p
    ctl := http.get(base)
    println(f"file_get_null={b2i(is_null(ctl))} file_get_len={len(http.body(ctl))}")
    http.release(ctl)
    println("wrote=" + str(b2i(wrote)))
    pc := http.post(base, "x=1", "text/plain")
    println(f"file_post_null={b2i(is_null(pc))} file_post_len={len(http.body(pc))}")
    http.release(pc)
    println(f"file_gb={len(http.get_body(base))}")
    # The interior-NUL guard (FRICTION #78) is NOT scored here any more, and the
    # reason is the whole point: it needs a POSITIVE control -- a URL that really
    # fetches -- and file:// was that control. Now that file:// is refused, a
    # NUL'd URL and a clean one would both answer null/0 here, which is a leg
    # that cannot fail. It moved to scripts/http_verify.sh legs [4]/[4b], where a
    # real server answers 200 and the NUL'd form of the SAME URL must answer 0.
