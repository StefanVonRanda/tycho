# corelib test: exercises core:strings; the output is locked to
# corelib/test/strings.out (corelib/run.sh). The tychoc0 cross-check this line used to
# claim was retired 2026-07-29. (f-string holes avoid nested string literals — the
# lexer would stop at the inner quote.)
package main
import "core:strings"

fn b2i(b: bool) -> int:
    if b:
        return 1
    return 0

fn main():
    println(strings.to_upper("Hello, World!"))           # HELLO, WORLD!
    println(strings.to_lower("Hello, World!"))           # hello, world!
    println(strings.repeat("ab", 3) + "|[" + strings.trim("   spaced text   ") + "]")  # ababab|[spaced text]
    bits := b2i(strings.starts_with("hello", "he")) * 4 + b2i(strings.ends_with("hello", "lo")) * 2 + b2i(strings.contains("hello", "ell"))
    miss := b2i(strings.starts_with("hi", "x")) + b2i(strings.contains("abc", "z"))
    p1 := strings.parse_int("-42")
    p2 := strings.parse_int("123stop")
    println(f"bits={bits} miss={miss} p1={p1} p2={p2}")       # bits=7 miss=0 p1=-42 p2=123
    # parse_int edges: int64 bounds parse exactly; overflow/empty/'-'/garbage -> 0
    pmax := strings.parse_int("9223372036854775807")
    pmin := strings.parse_int("-9223372036854775808")
    println(f"pmax={pmax} pmin={pmin}")                       # pmax=9223372036854775807 pmin=-9223372036854775808
    ovf := strings.parse_int("12345678901234567890")
    ovn := strings.parse_int("-9223372036854775809")
    pe := strings.parse_int("")
    pd := strings.parse_int("-")
    pg := strings.parse_int("garbage")
    # parse_int_checked: the STRICT one -- empty / garbage / overflow are Err
    # naming why, "0" is Ok(0), and the int64 bounds parse exactly.
    c0 := strings.parse_int_checked("0")
    cm := strings.parse_int_checked("-42")
    cb := strings.parse_int_checked("9223372036854775807")
    cmin := strings.parse_int_checked("-9223372036854775808")
    ce := strings.parse_int_checked("")
    cg := strings.parse_int_checked("1x4")
    cd := strings.parse_int_checked("-")
    cov := strings.parse_int_checked("12345678901234567890")
    cow := strings.parse_int_checked("9223372036854775808")
    println(f"c0={c0} cm={cm} cb={cb} cmin={cmin}")
    println(f"ce={ce} cg={cg} cd={cd} cov={cov} cow={cow}")
    println(f"ovf={ovf} ovn={ovn} pe={pe} pd={pd} pg={pg}")   # ovf=0 ovn=0 pe=0 pd=0 pg=0
    # ---- parse_float: the strict opposite of parse_int, under a HOSTILE locale --
    # Everything below runs with LC_NUMERIC switched to a comma-decimal locale, so
    # bare strtod("1.5") would return 1.0 and stop at the '.'. `hostile=1` is the
    # proof that switch took effect; a host with no such locale installed prints
    # `hostile=0` and FAILS here on purpose, rather than quietly testing "C".
    # Nothing below prints a raw float: str(float) goes through printf and so
    # renders "1,5.0" under this locale, which would make the golden depend on the
    # host's LANG. Verdicts (== against a literal) are locale-independent.
    println(f"hostile={strx_test_make_locale_hostile()}")     # hostile=1
    println("pf 1.5      " + pfs("1.5") + " eq1.5=" + pfeq("1.5", 1.5) + " eq1.0=" + pfeq("1.5", 1.0))
    println("pf 1,5      " + pfs("1,5"))                      # the locale trap: Err, never 1.0
    println("pf empty    " + pfs(""))
    println("pf -        " + pfs("-"))
    println("pf 1.5x     " + pfs("1.5x"))                     # no partial parse
    println("pf ' 1.5'   " + pfs(" 1.5"))                     # no leading whitespace
    println("pf 1e400    " + pfs("1e400"))                    # overflow, not +inf
    println("pf 1e-400   " + pfs("1e-400"))                   # underflow, not 0
    println("pf -0.0     " + pfs("-0.0") + " eq0=" + pfeq("-0.0", 0.0) + " neg=" + pfneg("-0.0"))
    println("pf 0        " + pfs("0") + " eq0=" + pfeq("0", 0.0) + " neg=" + pfneg("0"))
    println("pf 1e3      " + pfs("1e3") + " eq1000=" + pfeq("1e3", 1000.0))
    println("pf 1E+3     " + pfs("1E+3") + " eq1000=" + pfeq("1E+3", 1000.0))
    d25 := "1234567890123456789012345"                        # 25 digits: rounded, not refused
    println("pf 25digit  " + pfs(d25) + " eq=" + pfeq(d25, 1.2345678901234568e24))
    # ---- subnormals are VALUES (changed 2026-08-12) -------------------------
    # Every one of these was Err(Underflow) before: strx_parse_double refused
    # anything ERANGE that was not an infinity, which is every subnormal. glibc
    # sets ERANGE for a subnormal result whether or not it is exact, so DBL_MIN
    # -- the smallest NORMAL, one ULP up from this region -- was the last string
    # that parsed. The three `ok`s below are the fix; the two Err lines are the
    # NEGATIVE CONTROL, and they are what says the refusal did not simply widen
    # to accept everything.
    println("pf DBL_MIN  " + pfs("2.2250738585072014e-308") + " eq=" + pfeq("2.2250738585072014e-308", 2.2250738585072014e-308))
    println("pf 5e-324   " + pfs("5e-324") + " eq=" + pfeq("5e-324", 5e-324))
    println("pf 1e-320   " + pfs("1e-320") + " eq=" + pfeq("1e-320", 1e-320))
    println("pf -5e-324  " + pfs("-5e-324") + " neg=" + pfneg("-5e-324"))
    println("pf 1e-400   " + pfs("1e-400") + " (total underflow: still refused)")
    println("pf -1e-400  " + pfs("-1e-400") + " (sign does not change it)")
    # str -> parse_float -> the SAME double, across the whole range. This is the
    # pair of fixes meeting: str emits the shortest round-tripping decimal, and
    # parse_float now accepts every binary64 that decimal can name. Neither half
    # alone makes these `yes` -- before 2026-08-12 the first two were `NO` (str
    # threw digits away) and the third was `err` (parse_float refused it).
    println("rt 0.1+0.2  " + pfrt(0.1 + 0.2))
    println("rt DBL_MAX  " + pfrt(1.7976931348623157e308))
    println("rt 5e-324   " + pfrt(5e-324))
    println("rt 2^53     " + pfrt(9007199254740992.0))
    println("rt -0.0     " + pfrt(-0.0) + " neg=" + pfneg(str(-0.0)))
    # is_space covers \v (11) and \f (12) too: trim strips them
    println("vt=[" + strings.trim(chr(11) + "x" + chr(12)) + "]")   # vt=[x]
    # ---- builtin split shapes (corelib composes with it; empty sep aborts by design) ----
    println("s1=[" + jn(split("a,b,c", ",")) + "]")            # s1=[a|b|c]
    println("s2=[" + jn(split(",a,", ",")) + "]")              # s2=[|a|] (empty pieces kept)
    println("s3=[" + jn(split("abc", ",")) + "]")              # s3=[abc]
    println("s4=" + str(len(split("", ","))))             # s4=1 (one empty piece)
    println("s5=[" + jn(split("a::b::c", "::")) + "]")         # s5=[a|b|c] (multi-char sep)
    # ---- lines: every documented shape ----
    println("l1=[" + jn(strings.lines("a" + chr(10) + "b")) + "]")                       # l1=[a|b]
    println("l2=[" + jn(strings.lines("a" + chr(10) + "b" + chr(10))) + "]")             # l2=[a|b]
    println("l3=[" + jn(strings.lines("a\r\nb")) + "]")                                  # l3=[a|b]
    println("l4=" + str(len(strings.lines(""))))                                    # l4=0
    println("l5=" + str(len(strings.lines(chr(10)))))                               # l5=1 (one empty line)
    # ---- replace (package) + find (builtin substring search) ----
    println("r1=" + strings.replace("a-b-c", "-", "+"))   # r1=a+b+c
    println("r2=" + strings.replace("aaa", "aa", "b"))    # r2=ba (no rescan)
    println("r3=" + strings.replace("x", "", "y"))        # r3=x (empty old: unchanged)
    i1 := find("hello", "ll")
    i2 := find("hello", "zz")
    i3 := find("hello", "")
    println(f"i1={i1} i2={i2} i3={i3}")                        # i1=2 i2=-1 i3=0
    # ---- extensions: count / strip / pad / reverse / capitalize / split_once ----
    c1 := strings.count("a.b.c.d", ".")
    c2 := strings.count("aaa", "aa")
    println(f"count={c1},{c2}")                                # count=3,1
    println("strip=[" + strings.strip_prefix("core:x", "core:") + "][" + strings.strip_suffix("file.ty", ".ty") + "]")   # strip=[x][file]
    println("pad=[" + strings.pad_left("7", 3, "0") + "][" + strings.pad_right("7", 3, ".") + "]")    # pad=[007][7..]
    println("rc=" + strings.reverse("abc") + "," + strings.capitalize("hello"))    # rc=cba,Hello
    bf, af := strings.split_once("k=v=w", "=")
    nb, na := strings.split_once("nosep", "=")
    println("split=[" + bf + "][" + af + "][" + nb + "][" + na + "]")   # split=[k][v=w][nosep][]

    # ---- slice_bytes / slice_str: the FAILING-CLOSED slice ------------------
    # The language's b[a:z] CLAMPS, so it cannot be used as a bounds check: on a
    # 5-byte buffer b[2:10] is three bytes and nothing says so. These two say so.
    bb := to_bytes([65, 66, 67, 68, 69])                       # "ABCDE"
    println("sb in  =" + sb(bb, 1, 4))                         # sb in  =ok:3:BCD
    println("sb full=" + sb(bb, 0, 5))                         # sb full=ok:5:ABCDE
    println("sb zero=" + sb(bb, 5, 5))                         # sb zero=ok:0:
    println("sb past=" + sb(bb, 2, 10))                        # sb past=OutOfBounds  (b[2:10] clamps to 3)
    println("sb far =" + sb(bb, 7, 9))                         # sb far =OutOfBounds  (b[7:9]  clamps to 0)
    println("sb neg =" + sb(bb, 0 - 1, 2))                     # sb neg =OutOfBounds
    println("sb inv =" + sb(bb, 3, 1))                         # sb inv =Inverted
    println("ss in  =" + ss("ABCDE", 1, 3))                    # ss in  =ok:2:BC
    println("ss past=" + ss("ABCDE", 2, 10))                   # ss past=OutOfBounds
    println("ss inv =" + ss("ABCDE", 3, 1))                    # ss inv =Inverted

# ---- slice helpers: render the Result as one word, never a clamped value ----
fn sb(b: bytes, a: int, z: int) -> string:
    match strings.slice_bytes(b, a, z):
        Ok(v): return "ok:" + str(len(v)) + ":" + to_str(v)
        Err(strings.Inverted): return "Inverted"
        Err(strings.OutOfBounds): return "OutOfBounds"

fn ss(s: string, a: int, z: int) -> string:
    match strings.slice_str(s, a, z):
        Ok(v): return "ok:" + str(len(v)) + ":" + v
        Err(strings.Inverted): return "Inverted"
        Err(strings.OutOfBounds): return "OutOfBounds"

# ---- parse_float helpers ----------------------------------------------------
# The test hook lives in corelib/strings/strings_shim.c and is deliberately NOT
# exported by core:strings -- no library function should move a process-wide
# global -- so the extern is declared here, in the only program that wants it.
# tychoc auto-discovers the imported package's shim, which is what resolves it.
extern fn strx_test_make_locale_hostile() -> int

fn pfs(s: string) -> string:      # the outcome as one word, never a value
    match strings.parse_float(s):
        Ok(v): return "ok"
        Err(strings.Empty): return "err Empty"
        Err(strings.Syntax): return "err Syntax"
        Err(strings.Overflow): return "err Overflow"
        Err(strings.Underflow): return "err Underflow"

fn pfeq(s: string, want: float) -> string:   # equality against a literal: locale-proof
    match strings.parse_float(s):
        Ok(v):
            if v == want:
                return "yes"
            return "NO"
        Err(e): return "err"

fn pfneg(s: string) -> string:    # is it NEGATIVE zero? (-0.0 == 0.0, so divide)
    match strings.parse_float(s):
        Ok(v):
            if 1.0 / v < 0.0:
                return "yes"
            return "no"
        Err(e): return "err"

# str(x) -> parse_float -> the same double? Prints a verdict, never the text:
# str(float) renders under the ambient locale-corrected path and this test runs
# with LC_NUMERIC hostile, so the string itself must not reach the golden.
fn pfrt(x: float) -> string:
    match strings.parse_float(str(x)):
        Ok(v):
            if v == x:
                return "yes"
            return "NO"
        Err(strings.Empty): return "err Empty"
        Err(strings.Syntax): return "err Syntax"
        Err(strings.Overflow): return "err Overflow"
        Err(strings.Underflow): return "err Underflow"

fn jn(xs: [string]) -> string:    # local join with '|' so pieces are visible
    r := ""
    for i := 0; i < len(xs); i += 1:
        if i > 0:
            r = r + "|"
        r = r + xs[i]
    return r
