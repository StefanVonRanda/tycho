# corelib test: exercises core:time; the C compiler and tychoc0 must agree (corelib/run.sh).
# Time values are non-deterministic, so the golden locks RELATIONSHIPS (>=0, >0,
# monotonic) and the pure unit conversions -- never raw clock/now readings.
package main
import "core:time"

fn main():
    sw := time.start()
    s := 0
    for i := 0; i < 1000000; i += 1:
        s = s + i
    println(f"sum={s}")
    println(f"elapsed_ns_nonneg={time.elapsed_ns(sw) >= 0}")
    println(f"elapsed_us_nonneg={time.elapsed_us(sw) >= 0}")
    println(f"elapsed_ms_nonneg={time.elapsed_ms(sw) >= 0}")
    println(f"unix_positive={time.unix_secs() > 0}")
    # pure conversions are deterministic
    println(f"conv={time.ns_to_us(2500)},{time.ns_to_ms(2500000)},{time.ns_to_s(3000000000)}")
    # monotonic: a later reading is never before an earlier one
    a := time.start()
    b := time.start()
    println(f"monotonic={b >= a}")
    # sleep: AT LEAST the requested duration (scheduler granularity can make it
    # longer, never shorter), so the golden locks the lower bound plus a loose
    # upper sanity bound -- never an exact duration.
    s1 := time.start()
    time.sleep_ms(200)
    d1 := time.elapsed_ms(s1)
    println(f"sleep_ms_at_least={d1 >= 200}")
    println(f"sleep_ms_sane={d1 < 5000}")
    s2 := time.start()
    time.sleep_ns(50000000)
    println(f"sleep_ns_at_least={time.elapsed_ms(s2) >= 50}")
    # a non-positive duration returns immediately: no syscall, no busy-spin, no abort
    s3 := time.start()
    time.sleep_ms(0)
    time.sleep_ms(-5)
    time.sleep_ns(-1)
    println(f"nonpositive_immediate={time.elapsed_ms(s3) < 50}")
