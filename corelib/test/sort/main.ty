# corelib test: core:sort (argsort family + by_key + sort_by). All sorts stable, inputs unmutated.
package main
import "core:sort"

struct Row:
    dept: string
    pay: int
    name: string

# dept ascending, then pay DESCENDING -- two keys, opposite directions
fn dept_then_pay(x: Row, y: Row) -> int:
    if x.dept < y.dept:
        return -1
    if x.dept > y.dept:
        return 1
    if x.pay > y.pay:
        return -1
    if x.pay < y.pay:
        return 1
    return 0

# count DESCENDING then name ASCENDING, over values a CLOSURE looks up and passes in.
# This is how a comparator reaches data it must capture: the closure stays one
# expression (the only kind there is) and delegates the branching to a named fn.
fn count_then_name(ac: int, bc: int, an: string, bn: string) -> int:
    if ac != bc:
        return bc - ac
    if an < bn:
        return -1
    if an > bn:
        return 1
    return 0

# first character only, descending -- so "b1"/"b2" tie and their order is the test
fn first_desc(x: string, y: string) -> int:
    return to_int(char_at(y, 0)) - to_int(char_at(x, 0))

fn jn(xs: [int]) -> string:
    r := ""
    for i := 0; i < len(xs); i += 1:
        if i > 0:
            r = r + ","
        r = r + str(xs[i])
    return r

fn main():
    keys := [30, 10, 20, 10]
    println("asc=" + jn(sort.argsort(keys)))          # asc=1,3,2,0 (stable: first 10 before second)
    println("desc=" + jn(sort.argsort_desc(keys)))    # desc=0,2,1,3
    println("orig=" + jn(keys))                       # orig=30,10,20,10 (input untouched)
    names := ["carol", "alice", "bob", "alice"]
    println("strs=" + jn(sort.argsort(names)))        # strs=1,3,2,0 (generic argsort over strings)
    # asc/desc: sort the VALUES directly (the common case), generic over comparable
    println("asc2=" + jn(sort.asc(keys)))             # asc2=10,10,20,30 (stable)
    println("desc2=" + jn(sort.desc(keys)))           # desc2=30,20,10,10
    println("ascs=" + str(sort.asc(names)))           # ascs=[alice, alice, bob, carol]
    # parallel-array use: order words by count descending
    words := ["the", "fox", "jumps"]
    counts := [3, 7, 1]
    ord := sort.argsort_desc(counts)
    line := ""
    for i := 0; i < len(ord); i += 1:
        line = line + words[ord[i]] + ":" + str(counts[ord[i]]) + " "
    println(line)                                     # fox:7 the:3 jumps:1
    # by_key with a closure: sort by distance from 50. DEPRECATED since 0.5.0 and
    # still tested on purpose -- it must keep working for all of 0.x. The compile
    # warns; corelib/run.sh discards compiler stderr, so this lane stays quiet.
    xs := [10, 60, 45, 90]
    bk := sort.by_key(xs, fn(x: int) -> int: (x - 50) * (x - 50))
    println("bykey=" + jn(bk))                        # bykey=45,60,10,90 (10/90 tie on key 1600: stable keeps 10 first)
    empty := []int                                         # generic argsort needs a typed empty (can't infer $T from bare [])
    println("edge=" + str(len(sort.argsort(empty))) + str(len(sort.argsort([5]))))   # edge=01
    # sort_by: the order the other entry points cannot express -- a struct (no
    # `comparable` instance) ordered by two keys in opposite directions.
    rows := [Row("eng", 3, "ann"), Row("ops", 5, "bo"), Row("eng", 9, "cy"), Row("eng", 3, "dee")]
    by := sort.sort_by(rows, dept_then_pay)
    out := ""
    for i := 0; i < len(by); i += 1:
        out = out + by[i].dept + str(by[i].pay) + by[i].name + " "
    println("bytwo=" + out)                           # eng9cy eng3ann eng3dee ops5bo -- ann before dee is the stability
    println("rows0=" + rows[0].name)                  # rows0=ann (input untouched)
    # stability under a DESCENDING compare, with ties told apart -- a total-by-index
    # comparator would pass every int test above and reverse these
    tags := ["b1", "a1", "b2", "a2"]
    ds := sort.sort_by(tags, first_desc)
    println("desc3=" + str(ds))                       # desc3=[b1, b2, a1, a2]
    # two keys over CAPTURED state: no globals, so the comparator must be a closure,
    # and a closure is one expression -- it forwards to the named fn above.
    freq := []string: int
    freq["fig"] = 5
    freq["apple"] = 3
    freq["pear"] = 3
    fruit := ["pear", "fig", "apple"]
    byc := sort.sort_by(fruit, fn(a: string, b: string) -> int: count_then_name(freq.get(a, 0), freq.get(b, 0), a, b))
    println("capt=" + str(byc))                       # capt=[fig, apple, pear] -- 5 first, then 3s alphabetical
    println("edge2=" + str(len(sort.sort_by(empty, fn(x: int, y: int) -> int: x - y))) + str(len(sort.sort_by([5], fn(x: int, y: int) -> int: x - y))))
