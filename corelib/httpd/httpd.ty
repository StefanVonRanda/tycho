# corelib: a minimal HTTP/1.1 server toolkit -- request parsing and response
# building in pure Tycho, with thin read/write glue over core:net. Import with
# `import "core:httpd"`. There is no external dependency (core:net is libc-only).
#
# You own the accept loop; this package gives you the request/response plumbing:
#
#   srv := net.listen("127.0.0.1", 8080) or_return   # in a fn -> Result(_, net.NetErr)
#   for true:
#       match net.accept(srv):
#           Err(e): return Err(e)
#           Ok(conn):
#               x := net.set_read_timeout_ms(conn, 5000)  # so an idle peer cannot pin us
#               alive := true
#               for alive:
#                   match httpd.read_request(conn):       # read + parse one request
#                       Err(e):                           # WHICH failure -- see ReqErr
#                           if e == httpd.Malformed:
#                               w := httpd.write_response(conn, httpd.text_response(400, "bad\n"))
#                           alive = false                 # Closed/Timeout: just hang up
#                       Ok(req):
#                           alive = not httpd.connection_close(req)
#                           r := httpd.text_response(200, "hello\n")
#                           w := httpd.write_response(conn, httpd.with_connection(r, alive))
#               net.close_fd(conn)
#
# BINARY-SAFE bodies: `Request.body` and `Response.body` are `bytes`, so a PNG or a
# font round-trips byte for byte. Headers stay `string` -- they are ASCII by spec.
# Build a text body with `text_response(status, s)` (or `response(status,
# to_bytes(s))`); read one back with `to_str(r.body)`. For a status `reason_phrase`
# does not know, or your own wording, `response_reason(status, reason, body)` sets
# the phrase without building the struct positionally.
#
# `write_response` sends the ASCII head and the body as two separate `net.write`
# calls, so the body buffer is never copied into an intermediate string. `render`
# is still there for one-shot use and returns `bytes`.
#
# Content-Length is honored on read and emitted automatically on write.
# `content_type(path)` maps a file extension to a MIME type (unknown ->
# application/octet-stream, never text/plain). `connection_close(req)` /
# `with_connection(r, alive)` implement HTTP/1.1 keep-alive.
package httpd
import "core:net"
import "core:time"
import "core:result"

# Why a request could not be produced. Every variant is payload-free, so both
# spellings work on it: `==` for a one-line test, and a nested pattern
# (`Err(httpd.Timeout):`, since the friction plan) for a caller already writing a
# `match` -- which is how server/main.ty acts on all five causes. Payload-free is
# KEPT: a payload would break every `==` call site in the tree.
#
# These four were ONE value -- a Request whose `method` is "" -- until 2026-07-26.
# A server that must answer 400 to garbage while hanging up silently on a
# disconnect needs Malformed apart from Closed, and one that wants to answer 408
# needs Timeout apart from both (FRICTION.md, phase 7; the option-result plan).
enum ReqErr:
    Malformed          # bytes arrived, but they are not a valid request head
    Closed             # the peer hung up before a complete request arrived
    Timeout            # the socket read deadline expired (net.set_read_timeout_ms)
    Failed             # the socket read failed (reset, bad fd, ...)
    TooLarge           # the cap was reached with no header terminator in sight -> 431

struct Request:
    method: string        # "GET", "POST", ...
    path: string          # the raw request target, e.g. "/x?a=1"
    version: string       # "HTTP/1.1"
    header_keys: [string]  # header names, parallel to header_vals
    header_vals: [string]  # header values (trimmed), parallel to header_keys
    body: bytes           # the entity body (as many bytes as Content-Length)

struct Response:
    status: int
    reason: string
    header_keys: [string]
    header_vals: [string]
    body: bytes

# ---- small pure helpers ----------------------------------------------------

fn ascii_lower(s: string) -> string:
    out := ""
    for i := 0; i < len(s); i += 1:
        c := s[i]
        if c >= 65 and c <= 90:                 # 'A'..'Z' -> 'a'..'z'
            out = out + chr(c + 32)
        else:
            out = out + chr(c)
    return out

# Drop leading/trailing spaces, tabs, and a trailing CR (folds header folding).
fn trim(s: string) -> string:
    a := 0
    b := len(s)
    for a < b and (s[a] == 32 or s[a] == 9):
        a = a + 1
    for b > a and (s[b - 1] == 32 or s[b - 1] == 9 or s[b - 1] == 13):
        b = b - 1
    return s[a:b]

# CR-LF, the HTTP line terminator.
#
# `"\r\n"` IS a string literal since the friction plan, so this function is no longer
# forced. It is KEPT DELIBERATELY, but NOT for the reason this comment used to give:
# it said `core:httpd` is compiled by the FROZEN self-hosted `tychoc0`, which rejects
# `\r`, so writing the literal here would redden `examples/webserver/run.sh`'s
# `tychoc == tychoc0 == golden` comparison. That leg was RETIRED on 2026-07-29 (see
# run.sh's own header) and nothing builds tychoc0 now, so no lexer forbids the
# literal anywhere. What survives is the ordinary reason: `crlf()` is a public entry
# point callers already use (`examples/webserver/main.ty:237`), so it stays for
# compatibility, not for a lexer. Inside this package either spelling is fine.
fn crlf() -> string:
    return chr(13) + chr(10)

# Strip one trailing CR (a line came from splitting on LF).
fn chomp(s: string) -> string:
    if len(s) > 0 and s[len(s) - 1] == 13:
        return s[0:len(s) - 1]
    return s

# Parse leading decimal digits; stops at the first non-digit. "" or non-numeric -> 0.
# Every byte a digit, and at least one. to_uint below stops at the first
# non-digit and returns what it had, which is the right shape for a lenient
# reader and the wrong one for deciding HOW MANY BYTES TO WAIT FOR.
fn all_digits(s: string) -> bool:
    if s == "":
        return false
    for i := 0; i < len(s); i += 1:
        c := s[i]
        if c < 48 or c > 57:
            return false
    return true

# True when Content-Length appears more than once with DIFFERENT values. RFC 7230
# 3.3.3 makes that unanswerable rather than merely odd: the sender and any proxy
# may pick different ones, which is the request-smuggling precondition.
fn content_length_conflict(r: Request) -> bool:
    seen := ""
    found := false
    for i := 0; i < len(r.header_keys); i += 1:
        if ascii_lower(r.header_keys[i]) == "content-length":
            v := trim(r.header_vals[i])
            if found and v != seen:
                return true
            seen = v
            found = true
    return false

fn to_uint(s: string) -> int:
    v := 0
    for i := 0; i < len(s); i += 1:
        c := s[i]
        if c < 48 or c > 57:
            return v
        v = v * 10 + (c - 48)
    return v

# True when `hay` contains `needle` as a comma-separated token, case-insensitively
# (the shape of `Connection: keep-alive, Upgrade`).
fn has_token(hay: string, needle: string) -> bool:
    parts := split(ascii_lower(hay), ",")
    for i := 0; i < len(parts); i += 1:
        if trim(parts[i]) == needle:
            return true
    return false

# An empty Request. Not a failure value any more -- parse_request says Err
# instead -- but still the natural fallback for `result.unwrap_or`, and what
# connection_close treats as "close, fail closed".
fn bad_request() -> Request:
    return Request("", "", "", []string, []string, to_bytes(""))

# ---- request parsing -------------------------------------------------------

# Parse a full raw request (headers, then the body after the blank line).
# Err(Malformed) if the request line is not "METHOD TARGET VERSION" -- fail
# closed. A caller that only wants a value can collapse it in one line:
# `result.unwrap_or(parse_request(raw), bad_request())`.
fn parse_request(raw: string) -> Result(Request, ReqErr):
    sep := find(raw, crlf() + crlf())
    head := raw
    body := ""
    if sep >= 0:
        head = raw[0:sep]
        body = raw[sep + 4:len(raw)]                 # 4 = len(CRLF CRLF)
    lines := split(head, "\n")
    if len(lines) == 0:
        return Err(Malformed)
    parts := split(chomp(lines[0]), " ")
    if len(parts) < 3:
        return Err(Malformed)
    keys := []string
    vals := []string
    for i := 1; i < len(lines); i += 1:
        ln := chomp(lines[i])
        col := find(ln, ":")
        if col > 0:
            push(keys, trim(ln[0:col]))
            push(vals, trim(ln[col + 1:len(ln)]))
    return Ok(Request(parts[0], parts[1], parts[2], keys, vals, to_bytes(body)))

# The value of header `name` (case-insensitive), or "" if absent.
fn header(r: Request, name: string) -> string:
    want := ascii_lower(name)
    out := ""
    for i := 0; i < len(r.header_keys); i += 1:
        if ascii_lower(r.header_keys[i]) == want:
            out = r.header_vals[i]
    return out

# A socket failure, in this package's vocabulary. net.NetErr says what the
# transport did; ReqErr says what it means for a request.
fn cause_of(e: net.NetErr) -> ReqErr:
    if e == net.Eof:
        return Closed
    if e == net.Timeout:
        return Timeout
    return Failed

# The default cap for read_request: the most a single request may occupy in
# memory before the head must have terminated. A server with a tighter budget
# passes its own to read_request_capped -- server/main.ty uses 16 KiB.
const MAX_REQUEST = 1048576

# Read one request off a connected socket and parse it. Reads until the header
# terminator and then exactly Content-Length body bytes (or EOF), bounded so a
# truncated/hostile peer can't spin forever.
#
# Err says which failure it was, and that is the point of this signature:
#
#   Err(Closed)     the peer hung up before a complete head arrived
#   Err(Timeout)    the read deadline expired (net.set_read_timeout_ms) first
#   Err(Failed)     the socket read failed
#   Err(Malformed)  a complete head arrived and is not a valid request
#   Err(TooLarge)   `cap` bytes arrived with no header terminator among them
#
# All of them were `method == ""` before 2026-07-26, which is why server/main.ty
# reimplemented this loop just to answer 400 to garbage and stay silent on a
# hangup (FRICTION.md, phase 7). A keep-alive loop that does not care can still
# close on one test: `result.is_err(read_request(fd))`.
#
# A head that arrived intact is parsed even if the BODY was cut short by the peer
# -- unchanged behaviour, and deliberate: the request line and headers are what
# routing needs, and a short body is visible as len(r.body) < Content-Length.
#
# Once Content-Length is known the read is clamped to the remaining bytes, so a
# well-behaved client's NEXT request is not swallowed. A client that pipelines
# (sends request 2 before reading response 1) can still have bytes consumed
# inside the pre-header 4 KiB read; pipelining is not supported. This wrapper
# DROPS those bytes -- it returns only the Result. Exactly what they are and where
# they go is the SURPLUS BYTES block on read_request_capped below; a caller that
# cares must call that function instead of this one.
fn read_request(fd: int) -> Result(Request, ReqErr):
    got, raw := read_request_capped(fd, MAX_REQUEST)
    return got

# read_request, plus the two things a real server needs and a Result alone cannot
# carry (the option-result plan):
#
#   `cap`         the byte budget for one request. Reaching it with no header
#                 terminator is Err(TooLarge) -- the 431 decision, which used to
#                 be `len(raw) >= MAX_HEAD` in the caller's own reimplemented
#                 read loop.
#   the 2nd value every byte read, on Err as much as on Ok. An access log has to
#                 name a request that would not parse, and the only thing left to
#                 name it with is its first line.
#
# A TUPLE rather than an `inout` out-param or a returned struct: measured against
# both (the option-result plan), it is the only one of the three where the caller writes
# ONE line -- `got, raw := read_request_capped(fd, cap)` -- with no dummy `raw :=
# ""` to initialize and no new type on this package's surface. The cost is inside
# this function: a tuple literal will not infer a Result element ("error: tuple
# element 1 needs a concrete value"), so the outcome is built in a typed local.
#
# SURPLUS BYTES -- the contract, written down here because it is not what a reader
# would assume and nothing else in this package said it. This function reads at most
# ONE request, but NOT at most one request's worth of BYTES: until the head
# terminator is found it reads in 4096-byte gulps (`want := 4096` below), so a
# single net.read can pull in the start of -- or the whole of -- a FOLLOWING
# request. The `need`-based clamp below only narrows a read once `need` is known,
# and `need` is only known after the head has already arrived. Those surplus bytes are off
# the socket for good; this function will never hand them back a second time and a
# later call reads only what arrives AFTER them. They end up in two places:
#
#   * the returned string, the 2nd tuple element. It is "every byte this call took
#     off the socket", NOT "this request's bytes" -- the difference matters to
#     anything that measures with it rather than merely logging its first line.
#   * the returned Request's `body`, because parse_request splits at the FIRST
#     terminator and gives it everything after that. Measured: two GETs in one
#     buffer parse to path=/style.css with a 37-byte body that is verbatim the
#     second request, and no Content-Length header. That absence is the only tell:
#     a non-empty body with no Content-Length and no Transfer-Encoding is surplus,
#     never a body this function was asked to read.
#
# Observed end to end (the webserver-gate plan), two pipelined GETs in one send() to
# server/main.ty: the first is answered, the second is consumed and discarded, and
# the connection then sits idle until the keep-alive deadline closes it quietly --
# 1.005s under --idle-ms 1000. Nothing is corrupted and the access log carries one
# correct line for the request that was served; the second request simply never
# happened. Pipelining is listed as deliberately not implemented in
# server/README.md, and this is what that costs the client that tries it anyway.
# The idle timeout `net.set_read_timeout_ms` gives is PER READ, and a slowloris
# defeats it by dribbling one byte before each expiry: every read succeeds, the
# timer resets, and the connection holds a worker for as long as the attacker
# likes. Measured 2026-08-15 against tycho-httpd with workers=4: twelve dribbling
# connections at one byte / 2s blocked every legitimate request indefinitely, and
# service returned only when they closed.
#
# The fix is a TOTAL deadline on the head, which is what nginx's
# client_header_timeout is. `deadline_ms <= 0` means no deadline, so
# read_request_capped keeps its exact old behaviour and no caller moves -- the
# same split core:strings has between parse_int and parse_int_checked.
fn read_request_deadline(fd: int, cap: int, deadline_ms: int) -> (Result(Request, ReqErr), string):
    sw := time.start()
    buf := ""
    need := -1                                  # total expected bytes once known
    reading := true
    why := Failed                               # the transport cause, if one ends the read
    cut := false                                # a read failed before the head was complete
    term := crlf() + crlf()                     # hoisted: two allocations + a concat per
                                                # loop iteration otherwise (FRICTION.md:123)
    for reading:
        if deadline_ms > 0 and time.elapsed_ms(sw) > deadline_ms:
            return (Err(Timeout), buf)          # the WHOLE head, not one read, ran out
        he := find(buf, term)
        if he >= 0 and need < 0:
            # Only the Content-Length matters here, and a malformed head has no
            # headers to read one from -- so collapsing the Result to an empty
            # Request keeps the pre-2026-07-26 behaviour exactly (bad_request()
            # carried no headers either) in one line instead of a match.
            probe := result.unwrap_or(parse_request(buf), bad_request())
            clh := header(probe, "content-length")
            blen := 0
            # STRICT here, deliberately. This value decides how long to block, and
            # a lenient read of "4x" framed a 4-byte body that never arrived: the
            # caller's own strict check (server/main.ty@bad_len, which names
            # smuggling and answers 400) sits DOWNSTREAM of this read and could
            # not run until the deadline expired. A malformed or conflicting
            # length frames NO body, so the head completes and that check fires.
            # Transfer-Encoding present alongside Content-Length is ambiguous the
            # same way (RFC 7230 3.3.3), and this package does not decode chunked
            # -- so framing by the Content-Length would wait for bytes the sender
            # never framed that way. No body here either; the caller answers 400.
            if all_digits(clh) and not content_length_conflict(probe) and
                    header(probe, "transfer-encoding") == "":
                blen = to_uint(clh)
            need = he + 4 + blen
        if (need >= 0 and len(buf) >= need) or len(buf) >= cap:
            reading = false
        else:
            want := 4096
            if need >= 0 and need - len(buf) < want:
                want = need - len(buf)
            if want > cap - len(buf):
                want = cap - len(buf)
            match net.read(fd, want):
                Ok(chunk): buf = buf + to_str(chunk)
                Err(e):
                    why = cause_of(e)
                    cut = true
                    reading = false
    # TooLarge is the initializer because it is the ONLY other way out of the loop
    # above: with no terminator in `buf`, either a read failed (cut) or the cap was
    # reached. `buf` goes back either way -- Ok or Err.
    #
    # `out` IS KEPT DELIBERATELY, and no longer because the compiler needs it: as of
    # the friction plan a tuple literal DOES infer a Result element, so
    # `return (Err(why), buf)` compiles under src/tychoc.c. The reason this comment
    # used to give for keeping the local was that the same line did NOT compile under
    # the FROZEN compiler/tychoc0.ty, which examples/webserver/run.sh fed this package
    # while asserting tychoc == tychoc0 == golden. That leg was RETIRED on 2026-07-29
    # and nothing builds tychoc0 now, so the constraint is gone -- the typed local is
    # now a style choice (it names the Ok payload type at the one place the tuple
    # would have to infer it), not a requirement. MEASURED, not assumed: rewriting
    # this tail to `return (Err(why), buf)` / `return (parse_request(buf), buf)` and
    # compiling corelib/test/httpd/main.ty succeeds at this tree. The direct form is
    # also demonstrated in corelib/test/result.
    out: Result(Request, ReqErr) = Err(TooLarge)
    if find(buf, term) < 0:
        if cut:
            out = Err(why)                      # no complete head: the transport reason wins
    else:
        out = parse_request(buf)                # Ok, or Err(Malformed) for garbage
    return (out, buf)

# ---- keep-alive ------------------------------------------------------------

# Does this request ask for the connection to be closed after the response?
# HTTP/1.1 defaults to keep-alive; HTTP/1.0 defaults to close. An empty Request
# (bad_request(), the usual unwrap_or fallback) always closes -- fail closed.
fn connection_close(r: Request) -> bool:
    if r.method == "":
        return true
    conn := header(r, "connection")
    if has_token(conn, "close"):
        return true
    if r.version == "HTTP/1.1":
        return false
    return not has_token(conn, "keep-alive")    # 1.0 and anything unknown

# ---- responses -------------------------------------------------------------

fn reason_phrase(status: int) -> string:
    if status == 200:
        return "OK"
    if status == 201:
        return "Created"
    if status == 204:
        return "No Content"
    if status == 206:
        return "Partial Content"
    if status == 301:
        return "Moved Permanently"
    if status == 302:
        return "Found"
    if status == 304:
        return "Not Modified"
    if status == 400:
        return "Bad Request"
    if status == 401:
        return "Unauthorized"
    if status == 403:
        return "Forbidden"
    if status == 404:
        return "Not Found"
    if status == 405:
        return "Method Not Allowed"
    if status == 408:
        return "Request Timeout"
    # RFC 7233 4.4's spelling. RFC 2616 called it "Requested Range Not
    # Satisfiable"; the shorter form is the current one and is what a 7233-era
    # client expects to read back in a log.
    if status == 416:
        return "Range Not Satisfiable"
    if status == 431:
        return "Request Header Fields Too Large"
    if status == 500:
        return "Internal Server Error"
    return "Status"

# Build a response with an EXPLICIT reason phrase. This is the escape hatch for a
# status this table does not carry, and it exists so that no caller has to build
# the struct positionally to set one string: `httpd.Response(431, "...", []string,
# []string, body)` worked, but it coupled the caller to the field order, and
# server/main.ty carried a private phrased_response() doing exactly that for two
# statuses (408, 431) until 2026-07-26 -- FRICTION.md phase 7. Both are now in the
# table above, so the bypass is gone AND unnecessary; this function is what makes
# the next one unnecessary too.
fn response_reason(status: int, reason: string, body: bytes) -> Response:
    return Response(status, reason, []string, []string, body)

# Build a response with a standard reason phrase, no extra headers yet. The body
# is `bytes`, so it is binary-safe; for a text body use text_response.
fn response(status: int, body: bytes) -> Response:
    return response_reason(status, reason_phrase(status), body)

# The text convenience: response(status, to_bytes(body)).
fn text_response(status: int, body: string) -> Response:
    return response(status, to_bytes(body))

# A copy of `r` with one header appended (value semantics -- returns a new value).
fn with_header(r: Response, key: string, val: string) -> Response:
    ks := r.header_keys
    vs := r.header_vals
    push(ks, key)
    push(vs, val)
    return Response(r.status, r.reason, ks, vs, r.body)

# A copy of `r` with a body replacing the old one.
fn with_body(r: Response, body: bytes) -> Response:
    return Response(r.status, r.reason, r.header_keys, r.header_vals, body)

# A copy of `r` carrying the Connection header the keep-alive decision implies.
# Pass the value connection_close(req) gave you, negated: `alive == true` means
# the server intends to keep reading requests off this socket.
fn with_connection(r: Response, alive: bool) -> Response:
    if alive:
        return with_header(r, "Connection", "keep-alive")
    return with_header(r, "Connection", "close")

# ---- content types ---------------------------------------------------------

# Case-insensitive ".ext" suffix test.
fn has_ext(path: string, ext: string) -> bool:
    if len(path) < len(ext):
        return false
    return ascii_lower(path[len(path) - len(ext):len(path)]) == ext

# The MIME type for a filename or URL path, by extension. An UNKNOWN extension
# yields application/octet-stream, never text/plain: a wrong text/* guess is how
# a browser gets talked into rendering (or running) something it should download.
fn content_type(path: string) -> string:
    if has_ext(path, ".html") or has_ext(path, ".htm"):
        return "text/html; charset=utf-8"
    if has_ext(path, ".css"):
        return "text/css; charset=utf-8"
    if has_ext(path, ".js") or has_ext(path, ".mjs"):
        return "text/javascript; charset=utf-8"
    if has_ext(path, ".json"):
        return "application/json"
    if has_ext(path, ".txt"):
        return "text/plain; charset=utf-8"
    if has_ext(path, ".xml"):
        return "application/xml"
    if has_ext(path, ".svg"):
        return "image/svg+xml"
    if has_ext(path, ".png"):
        return "image/png"
    if has_ext(path, ".jpg") or has_ext(path, ".jpeg"):
        return "image/jpeg"
    if has_ext(path, ".gif"):
        return "image/gif"
    if has_ext(path, ".webp"):
        return "image/webp"
    if has_ext(path, ".ico"):
        return "image/x-icon"
    if has_ext(path, ".woff2"):
        return "font/woff2"
    if has_ext(path, ".woff"):
        return "font/woff"
    if has_ext(path, ".pdf"):
        return "application/pdf"
    if has_ext(path, ".wasm"):
        return "application/wasm"
    return "application/octet-stream"

# ---- serialization ---------------------------------------------------------

# A status whose response is ALWAYS terminated by the blank line after the
# headers, whatever headers are present -- RFC 7230 3.3.3 rule 1 names 1xx, 204
# and 304. This is not the same question as "is the body empty": a 404 with an
# empty body still DESCRIBES a body of zero bytes, and `Content-Length: 0` is the
# right thing to say about it. For these three there is no entity to describe at
# all, and RFC 7230 3.3.2 makes `Content-Length: 0` on a 304 a MUST NOT -- the
# only length a 304 may carry is the length the 200 would have had, and a server
# that answers 304 without opening the file does not know it. Synthesising a
# Content-Type for them is the same error one header along: text/plain is a claim
# about a representation that is not being sent.
#
# 1xx is included for completeness; nothing in this package generates one.
fn bodyless(status: int) -> bool:
    return (status >= 100 and status < 200) or status == 204 or status == 304

# The ASCII head: status line, headers, and the blank line that ends them.
# Content-Length is added automatically (unless you set one); Content-Type
# defaults to text/plain when you set none. NEITHER is synthesised for a
# bodyless() status -- see the note there. An explicit header of your own is
# still emitted verbatim in every case; this only governs what gets invented.
fn render_head(r: Response) -> string:
    nl := crlf()
    out := "HTTP/1.1 " + str(r.status) + " " + r.reason + nl
    has_len := bodyless(r.status)
    has_type := has_len
    for i := 0; i < len(r.header_keys); i += 1:
        lk := ascii_lower(r.header_keys[i])
        if lk == "content-length":
            has_len = true
        if lk == "content-type":
            has_type = true
        out = out + r.header_keys[i] + ": " + r.header_vals[i] + nl
    if not has_len:
        out = out + "Content-Length: " + str(len(r.body)) + nl
    if not has_type:
        out = out + "Content-Type: text/plain" + nl
    return out + nl

# The whole response as one buffer. Convenient, but it copies the body; the
# socket path (write_response) does not.
fn render(r: Response) -> bytes:
    return to_bytes(render_head(r) + to_str(r.body))

# Send a response over the socket as head + body, two writes, so the body buffer
# is never copied into an intermediate string. Ok(total bytes written), or the
# net.NetErr of whichever write failed (fail closed -- a partial send is an error).
#
# This is the function that settles whether `or_return` is usable in a real IO
# path. It returns Result(_, net.NetErr) -- the SAME error type net.write returns
# -- so `or_return` propagates the failure with no `if n < 0` and no match. Both
# `-1` returns disappear; the six lines of sentinel checking become two operators.
fn write_response(fd: int, r: Response) -> Result(int, net.NetErr):
    n := net.write(fd, to_bytes(render_head(r))) or_return
    if len(r.body) == 0:
        return Ok(n)
    m := net.write(fd, r.body) or_return
    return Ok(n + m)


# The old two-argument shape, unchanged: no deadline. Kept so every existing
# caller compiles as written; a server that faces the open internet should call
# read_request_deadline instead and say how long a head may take.
fn read_request_capped(fd: int, cap: int) -> (Result(Request, ReqErr), string):
    return read_request_deadline(fd, cap, 0)
