# corelib: time. Import with `import "core:time"`, use `time.start()`, etc.
#
# Wraps the clock() (monotonic nanoseconds) and now() (UNIX seconds) builtins
# with a stopwatch and unit conversions. tycho has no globals, but a monotonic
# reading is just an int the caller holds -- so the stopwatch is value-semantic,
# no inout needed (unlike core:rand's mutable state):
#
#     sw := time.start()
#     # ... work ...
#     ms := time.elapsed_ms(sw)
#
# A function can't be named `now` here -- it would shadow the builtin and recurse
# -- so wall-clock seconds is `unix_secs()`.
package time

# --- monotonic stopwatch: elapsed time, immune to wall-clock adjustments ---

fn start() -> int:                       # a stopwatch handle = a monotonic reading (ns)
    return clock()

fn elapsed_ns(sw: int) -> int:           # nanoseconds since `sw`
    return clock() - sw

fn elapsed_us(sw: int) -> int:           # microseconds since `sw`
    return (clock() - sw) / 1000

fn elapsed_ms(sw: int) -> int:           # milliseconds since `sw`
    return (clock() - sw) / 1000000

# --- duration unit conversions (on nanosecond counts) ---

fn ns_to_us(ns: int) -> int:
    return ns / 1000

fn ns_to_ms(ns: int) -> int:
    return ns / 1000000

fn ns_to_s(ns: int) -> int:
    return ns / 1000000000

# --- wall clock: timestamps (seconds since the UNIX epoch) ---

fn unix_secs() -> int:
    return now()

# --- blocking sleep (libc-only shim, time_shim.c) ---
#
# Three semantics, decided deliberately because callers depend on them:
#
#   1. NON-POSITIVE RETURNS IMMEDIATELY. `sleep_ms(0)` / `sleep_ms(-1)` do
#      nothing at all -- no syscall, no busy-spin, no abort. A zero delay is a
#      normal first value in a retry loop.
#   2. NOT INTERRUPTIBLE. nanosleep can return early when a signal arrives; the
#      shim retries with the remaining time, so the FULL requested duration
#      always elapses. A sleep that silently returned short would turn a backoff
#      schedule into a spin.
#   3. PER-TASK, NOT PER-PROCESS. A tycho task is a thread, and nanosleep parks
#      only the calling thread -- a worker that sleeps does not stall its
#      siblings. (Measured: one task sleeping 500ms alongside one task spinning
#      500ms finishes in ~500ms, not ~1000ms.)
#
# The wait is AT LEAST the requested duration; scheduler granularity can make it
# longer, never shorter.

extern fn tmx_sleep_ns(ns: int)      # libc nanosleep, EINTR-retrying (time_shim.c)

fn sleep_ns(ns: int):                # park this task for `ns` nanoseconds
    tmx_sleep_ns(ns)

fn sleep_ms(ms: int):                # park this task for `ms` milliseconds
    tmx_sleep_ns(ms * 1000000)
