package zip

import "core:compress"

struct Entry:
    name: string
    data: bytes

struct Meta:                      # one central-directory entry (list())
    name: string
    method: int                   # 0 stored, 8 deflate
    usize: int                    # uncompressed size
    csize: int                    # compressed size
    crc: int
    off: int                         # local-file-header offset (one-pass extract)

# --- the three records, stated as layouts ------------------------------------
#
# PKWARE APPNOTE.TXT s4.4: every multi-byte field in a ZIP record is stored
# LITTLE-ENDIAN, which is the order to_bytes/from_bytes use on every host
# (spec s17.1b). So the layout below is the format's, not this machine's, and
# the same source writes the same archive on a big-endian target.
#
# Sizes are asserted by the offsets the readers used before this file stated
# them: 30, 46 and 22 bytes.

packed struct Local:              # local file header, sig 0x04034b50
    sig: u32
    version: u16
    flags: u16
    method: u16
    time: u16
    date: u16
    crc: u32
    csize: u32
    usize: u32
    nlen: u16
    elen: u16

packed struct Central:            # central directory header, sig 0x02014b50
    sig: u32
    made_by: u16
    version: u16
    flags: u16
    method: u16
    time: u16
    date: u16
    crc: u32
    csize: u32
    usize: u32
    nlen: u16
    elen: u16
    clen: u16
    disk: u16
    iattr: u16
    eattr: u32
    off: u32

packed struct Eocd:               # end of central directory, sig 0x06054b50
    sig: u32
    disk: u16
    cd_disk: u16
    n_here: u16
    n_total: u16
    cd_size: u32
    cd_off: u32
    clen: u16

const SIG_LOCAL = 67324752       # 0x04034b50
const SIG_CENTRAL = 33639248     # 0x02014b50
const SIG_EOCD = 101010256       # 0x06054b50

# CRC-32 (IEEE 802.3), bit-by-bit, in u32 like core:hash's.
fn crc32(b: bytes) -> int:
    crc := to_u32(4294967295)
    for i := 0; i < len(b); i += 1:
        crc = crc ^ to_u32(b[i])
        for k := 0; k < 8; k += 1:
            if (crc & 1) == 1:
                crc = (crc >> 1) ^ to_u32(3988292384)
            else:
                crc = crc >> 1
    return to_int(crc ^ to_u32(4294967295))

# --- reading ----------------------------------------------------------------

# The entries of an archive, in central-directory order (insertion order).
fn list(b: bytes) -> [Meta]:
    out := []Meta
    # find the EOCD: scan backwards from the end for the 0x06054b50 signature
    eocd := _find_eocd(b)
    if eocd < 0:
        return out
    e := from_bytes$(Eocd)(b[eocd:eocd + size_of$(Eocd)])
    n := to_int(e.n_total)
    pos := to_int(e.cd_off)
    for i := 0; i < n; i += 1:
        # the exact-length window is taken only after the bound check:
        # from_bytes refuses any other length, so a truncated archive must be
        # rejected HERE rather than by the runtime.
        if pos + size_of$(Central) > len(b):
            return out
        c := from_bytes$(Central)(b[pos:pos + size_of$(Central)])
        if to_int(c.sig) != SIG_CENTRAL:
            return out
        nlen := to_int(c.nlen)
        skip := size_of$(Central) + nlen + to_int(c.elen) + to_int(c.clen)
        if pos + skip > len(b):
            return out
        name := to_str(b[pos + size_of$(Central):pos + size_of$(Central) + nlen])
        push(out, Meta(name, to_int(c.method), to_int(c.usize), to_int(c.csize),
                       to_int(c.crc), to_int(c.off)))
        pos = pos + skip
    return out

fn _find_eocd(b: bytes) -> int:
    # APPNOTE allows at most a 65,535-byte comment after the fixed EOCD.
    # Search only that legal suffix and require the comment to end at EOF, so
    # trailing junk cannot turn every extract into a full-file backwards scan.
    i := len(b) - size_of$(Eocd)
    first := len(b) - size_of$(Eocd) - ZIP_MAX_U16
    if first < 0:
        first = 0
    for i >= first:
        e := from_bytes$(Eocd)(b[i:i + size_of$(Eocd)])
        if to_int(e.sig) == SIG_EOCD and i + size_of$(Eocd) + to_int(e.clen) == len(b):
            return i
        i = i - 1
    return -1

# The bytes of one entry: seek its local header, read the data, inflate if
# method 8, and verify the CRC. Empty on any inconsistency (fail-closed).
fn extract(b: bytes, name: string) -> bytes:
    for e in list(b):
        if e.name == name:
            return extract_entry(b, e)
    return to_bytes([]int)

# Extract a Meta returned by list(), avoiding another EOCD and central-directory
# scan. Iterate `for e in list(archive): extract_entry(archive, e)` for O(archive)
# work across all entries; extract(name) remains a convenient one-shot lookup.
fn extract_entry(b: bytes, e: Meta) -> bytes:
    if e.off < 0 or e.csize < 0 or e.usize < 0:
        return to_bytes([]int)
    off := e.off
    if len(b) < size_of$(Local) or off > len(b) - size_of$(Local):
        return to_bytes([]int)
    lh := from_bytes$(Local)(b[off:off + size_of$(Local)])
    if to_int(lh.sig) != SIG_LOCAL:
        return to_bytes([]int)
    start := off + size_of$(Local)
    nlen := to_int(lh.nlen)
    elen := to_int(lh.elen)
    if nlen > len(b) - start:
        return to_bytes([]int)
    start += nlen
    if elen > len(b) - start:
        return to_bytes([]int)
    start += elen
    if e.csize > len(b) - start:
        return to_bytes([]int)
    raw := b[start:start + e.csize]
    data := to_bytes([]int)
    if e.method == 0:
        data = raw
    elif e.method == 8:
        match compress.raw_decompress(raw):
            Ok(d): data = d
            _: return to_bytes([]int)
    else:
        return to_bytes([]int)
    if len(data) != e.usize or crc32(data) != e.crc:
        return to_bytes([]int)
    return data

# --- writing ----------------------------------------------------------------

const ZIP_MAX_U16 = 65535
const ZIP_MAX_U32 = 4294967295

# Checked writer for untrusted entry lists. Classic ZIP has no ZIP64 records in
# this module, so every count, size, name length and offset must fit its field.
fn create_checked(entries: [Entry]) -> Result(bytes, string):
    if len(entries) > ZIP_MAX_U16:
        return Err("too many ZIP entries")
    for e in entries:
        if len(e.name) > ZIP_MAX_U16:
            return Err("ZIP entry name exceeds 65535 bytes")
        if len(e.data) > ZIP_MAX_U32:
            return Err("ZIP entry data exceeds 32-bit size")

    out := []int
    offs := []int                          # local header offsets, for the CD
    cdatas := []string                      # per-entry compressed bytes
    methods := []int
    crcs := []int
    for e in entries:
        if len(out) > ZIP_MAX_U32:
            return Err("ZIP local-header offset exceeds 32-bit size")
        push(offs, len(out))
        cdata := compress.raw_compress(e.data)
        method := 8
        if len(cdata) >= len(e.data):      # deflate did not help: store raw
            method = 0
            cdata = e.data
        local_bytes := size_of$(Local) + len(e.name)
        if local_bytes > ZIP_MAX_U32 - len(out) or len(cdata) > ZIP_MAX_U32 - len(out) - local_bytes:
            return Err("ZIP local records exceed 32-bit offsets")
        push(cdatas, to_str(cdata))
        push(methods, method)
        push(crcs, crc32(e.data))
        _push_bytes(&out, to_bytes(Local(to_u32(SIG_LOCAL), to_u16(20),
            to_u16(0), to_u16(method), to_u16(0), to_u16(0),
            to_u32(crc32(e.data)), to_u32(len(cdata)), to_u32(len(e.data)),
            to_u16(len(e.name)), to_u16(0))))
        _push_str(&out, e.name)
        _push_bytes(&out, cdata)
    cd_start := len(out)
    if cd_start > ZIP_MAX_U32:
        return Err("ZIP central directory offset exceeds 32-bit size")
    for i := 0; i < len(entries); i += 1:
        e := entries[i]
        cdata := cdatas[i]
        method := methods[i]
        c := crcs[i]
        central_bytes := size_of$(Central) + len(e.name)
        if central_bytes > ZIP_MAX_U32 - len(out):
            return Err("ZIP central directory exceeds 32-bit size")
        _push_bytes(&out, to_bytes(Central(to_u32(SIG_CENTRAL), to_u16(20),
            to_u16(20), to_u16(0), to_u16(method), to_u16(0), to_u16(0),
            to_u32(c), to_u32(len(cdata)), to_u32(len(e.data)),
            to_u16(len(e.name)), to_u16(0), to_u16(0), to_u16(0), to_u16(0),
            to_u32(0), to_u32(offs[i]))))
        _push_str(&out, e.name)
    cd_size := len(out) - cd_start
    if cd_size > ZIP_MAX_U32 or size_of$(Eocd) > ZIP_MAX_U32 - len(out):
        return Err("ZIP archive exceeds classic 32-bit limits")
    _push_bytes(&out, to_bytes(Eocd(to_u32(SIG_EOCD), to_u16(0), to_u16(0),
        to_u16(len(entries)), to_u16(len(entries)), to_u32(cd_size),
        to_u32(cd_start), to_u16(0))))
    return Ok(to_bytes(out))

# Compatibility wrapper: valid archives are unchanged, but limits no longer
# silently wrap into a forged archive. New callers should use create_checked.
fn create(entries: [Entry]) -> bytes:
    match create_checked(entries):
        Ok(archive): return archive
        Err(e):
            die("tycho: core:zip.create: " + e)
            return to_bytes([]int)

fn _push_str(b: inout [int], s: string):
    for i := 0; i < len(s); i += 1:
        push(b, s[i])
fn _push_bytes(b: inout [int], by: bytes):
    for i := 0; i < len(by); i += 1:
        push(b, by[i])
