package zip

import "core:compress"

struct Entry:
    name: string
    data: bytes

struct Meta:                      # one central-directory entry (list())
    name: string
    method: int                   # 0 stored, 8 deflate
    usize: int                    # uncompressed size
    csize: int                    # compressed size
    crc: int

# --- the three records, stated as layouts ------------------------------------
#
# PKWARE APPNOTE.TXT s4.4: every multi-byte field in a ZIP record is stored
# LITTLE-ENDIAN, which is the order to_bytes/from_bytes use on every host
# (spec s17.1b). So the layout below is the format's, not this machine's, and
# the same source writes the same archive on a big-endian target.
#
# Sizes are asserted by the offsets the readers used before this file stated
# them: 30, 46 and 22 bytes.

packed struct Local:              # local file header, sig 0x04034b50
    sig: u32
    version: u16
    flags: u16
    method: u16
    time: u16
    date: u16
    crc: u32
    csize: u32
    usize: u32
    nlen: u16
    elen: u16

packed struct Central:            # central directory header, sig 0x02014b50
    sig: u32
    made_by: u16
    version: u16
    flags: u16
    method: u16
    time: u16
    date: u16
    crc: u32
    csize: u32
    usize: u32
    nlen: u16
    elen: u16
    clen: u16
    disk: u16
    iattr: u16
    eattr: u32
    off: u32

packed struct Eocd:               # end of central directory, sig 0x06054b50
    sig: u32
    disk: u16
    cd_disk: u16
    n_here: u16
    n_total: u16
    cd_size: u32
    cd_off: u32
    clen: u16

const SIG_LOCAL = 67324752       # 0x04034b50
const SIG_CENTRAL = 33639248     # 0x02014b50
const SIG_EOCD = 101010256       # 0x06054b50

# CRC-32 (IEEE 802.3), bit-by-bit, in u32 like core:hash's.
fn crc32(b: bytes) -> int:
    crc := to_u32(4294967295)
    for i := 0; i < len(b); i += 1:
        crc = crc ^ to_u32(b[i])
        for k := 0; k < 8; k += 1:
            if (crc & 1) == 1:
                crc = (crc >> 1) ^ to_u32(3988292384)
            else:
                crc = crc >> 1
    return to_int(crc ^ to_u32(4294967295))

# --- reading ----------------------------------------------------------------

# The entries of an archive, in central-directory order (insertion order).
fn list(b: bytes) -> [Meta]:
    out := []Meta
    # find the EOCD: scan backwards from the end for the 0x06054b50 signature
    eocd := find_eocd(b)
    if eocd < 0:
        return out
    e := from_bytes$(Eocd)(b[eocd:eocd + size_of$(Eocd)])
    n := to_int(e.n_total)
    pos := to_int(e.cd_off)
    for i := 0; i < n; i += 1:
        # the exact-length window is taken only after the bound check:
        # from_bytes refuses any other length, so a truncated archive must be
        # rejected HERE rather than by the runtime.
        if pos + size_of$(Central) > len(b):
            return out
        c := from_bytes$(Central)(b[pos:pos + size_of$(Central)])
        if to_int(c.sig) != SIG_CENTRAL:
            return out
        nlen := to_int(c.nlen)
        skip := size_of$(Central) + nlen + to_int(c.elen) + to_int(c.clen)
        if pos + skip > len(b):
            return out
        name := to_str(b[pos + size_of$(Central):pos + size_of$(Central) + nlen])
        push(out, Meta(name, to_int(c.method), to_int(c.usize), to_int(c.csize),
                       to_int(c.crc)))
        pos = pos + skip
    return out

fn find_eocd(b: bytes) -> int:
    # the EOCD signature is at least 22 bytes from the end; scan back
    i := len(b) - size_of$(Eocd)
    for i >= 0:
        if to_int(from_bytes$(Eocd)(b[i:i + size_of$(Eocd)]).sig) == SIG_EOCD:
            return i
        i = i - 1
    return -1

# The bytes of one entry: seek its local header, read the data, inflate if
# method 8, and verify the CRC. Empty on any inconsistency (fail-closed).
fn extract(b: bytes, name: string) -> bytes:
    for e in list(b):
        if e.name == name:
            return entry_body(b, e)
    return to_bytes([]int)

fn entry_body(b: bytes, e: Meta) -> bytes:
    # walk the central directory again to find this entry's local offset
    eocd := find_eocd(b)
    if eocd < 0:
        return to_bytes([]int)
    d := from_bytes$(Eocd)(b[eocd:eocd + size_of$(Eocd)])
    n := to_int(d.n_total)
    pos := to_int(d.cd_off)
    off := -1
    for i := 0; i < n; i += 1:
        if pos + size_of$(Central) > len(b):
            return to_bytes([]int)
        c := from_bytes$(Central)(b[pos:pos + size_of$(Central)])
        if to_int(c.sig) != SIG_CENTRAL:
            return to_bytes([]int)
        nlen := to_int(c.nlen)
        nm := to_str(b[pos + size_of$(Central):pos + size_of$(Central) + nlen])
        if nm == e.name:
            off = to_int(c.off)
            break
        pos = pos + size_of$(Central) + nlen + to_int(c.elen) + to_int(c.clen)
    if off < 0:
        return to_bytes([]int)
    if off + size_of$(Local) > len(b):
        return to_bytes([]int)
    lh := from_bytes$(Local)(b[off:off + size_of$(Local)])
    if to_int(lh.sig) != SIG_LOCAL:
        return to_bytes([]int)
    start := off + size_of$(Local) + to_int(lh.nlen) + to_int(lh.elen)
    if start + e.csize > len(b):
        return to_bytes([]int)
    raw := b[start:start + e.csize]
    data := to_bytes([]int)
    if e.method == 0:
        data = raw
    elif e.method == 8:
        match compress.raw_decompress(raw):
            Ok(d): data = d
            _: return to_bytes([]int)
    else:
        return to_bytes([]int)
    if len(data) != e.usize or crc32(data) != e.crc:
        return to_bytes([]int)
    return data

# --- writing ----------------------------------------------------------------

fn create(entries: [Entry]) -> bytes:
    out := []int
    offs := []int                          # local header offsets, for the CD
    cdatas := []string                      # per-entry compressed bytes
    methods := []int
    crcs := []int
    for e in entries:
        push(offs, len(out))
        cdata := compress.raw_compress(e.data)
        method := 8
        if len(cdata) >= len(e.data):      # deflate did not help: store raw
            method = 0
            cdata = e.data
        push(cdatas, to_str(cdata))
        push(methods, method)
        push(crcs, crc32(e.data))
        push_bytes(&out, to_bytes(Local(to_u32(SIG_LOCAL), to_u16(20),
            to_u16(0), to_u16(method), to_u16(0), to_u16(0),
            to_u32(crc32(e.data)), to_u32(len(cdata)), to_u32(len(e.data)),
            to_u16(len(e.name)), to_u16(0))))
        push_str(&out, e.name)
        push_bytes(&out, cdata)
    cd_start := len(out)
    for i := 0; i < len(entries); i += 1:
        e := entries[i]
        cdata := cdatas[i]
        method := methods[i]
        c := crcs[i]
        push_bytes(&out, to_bytes(Central(to_u32(SIG_CENTRAL), to_u16(20),
            to_u16(20), to_u16(0), to_u16(method), to_u16(0), to_u16(0),
            to_u32(c), to_u32(len(cdata)), to_u32(len(e.data)),
            to_u16(len(e.name)), to_u16(0), to_u16(0), to_u16(0), to_u16(0),
            to_u32(0), to_u32(offs[i]))))
        push_str(&out, e.name)
    cd_size := len(out) - cd_start
    push_bytes(&out, to_bytes(Eocd(to_u32(SIG_EOCD), to_u16(0), to_u16(0),
        to_u16(len(entries)), to_u16(len(entries)), to_u32(cd_size),
        to_u32(cd_start), to_u16(0))))
    return to_bytes(out)

fn push_str(b: inout [int], s: string):
    for i := 0; i < len(s); i += 1:
        push(b, s[i])
fn push_bytes(b: inout [int], by: bytes):
    for i := 0; i < len(by); i += 1:
        push(b, by[i])
