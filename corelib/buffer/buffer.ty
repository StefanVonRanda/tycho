package buffer

# A growable byte builder. Bytes are kept as bytes ([u8]): appending a `bytes`
# or `string` is one memcpy (push([u8], bytes)) and as_bytes is one copy
# (to_bytes([u8])). It held an [int] until 2026-11-24 -- eight bytes of memory
# per byte, and a byte-at-a-time conversion back (FRICTION 229).
struct Buffer:
    data: [u8]

fn new() -> Buffer:
    return Buffer([]u8)

fn size(b: Buffer) -> int:
    return len(b.data)

fn write_byte(b: inout Buffer, c: int):
    if c < 0 or c > 255:
        die("buffer.write_byte: byte must be 0..255")
    push(b.data, to_u8(c))

fn write(b: inout Buffer, s: string):
    push(b.data, to_bytes(s))

fn write_bytes(b: inout Buffer, x: bytes):
    push(b.data, x)

fn reserve_cap(b: inout Buffer, n: int):
    reserve(b.data, n)

fn as_bytes(b: Buffer) -> bytes:
    return to_bytes(b.data)

fn as_string(b: Buffer) -> string:
    return to_str(to_bytes(b.data))

fn clear(b: inout Buffer):
    b.data = b.data[0:0]
