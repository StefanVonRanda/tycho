# GNU gettext MO catalogs. Qt .qm and locale data are not parsed here.
package i18n

enum I18nErr:
    BadMagic
    Truncated
    Corrupt
    TooBig

struct Entry:
    key: string
    value: string

struct Plural:
    singular: string
    plural: string
    forms: [string]

struct Translation:
    entries: [Entry]
    plurals: [Plural]
    header: string

fn _u32(data: bytes, off: int, big: bool) -> int:
    if off < 0 or off + 4 > len(data):
        return -1
    if big:
        return (data[off] << 24) | (data[off + 1] << 16) | (data[off + 2] << 8) | data[off + 3]
    return data[off] | (data[off + 1] << 8) | (data[off + 2] << 16) | (data[off + 3] << 24)

fn _str(data: bytes, off: int, n: int) -> string:
    if off < 0 or n < 0 or off + n > len(data):
        return ""
    return to_str(data[off:off + n])

fn _split_nul(s: string) -> [string]:
    out := []string
    start := 0
    for i := 0; i < len(s); i += 1:
        if s[i] == 0:
            push(out, s[start:i])
            start = i + 1
    if start < len(s):
        push(out, s[start:len(s)])
    return out

# Parse a GNU MO catalog. Both byte orders are accepted; the strings are
# returned as UTF-8 bytes without decoding. Context strings use the part after
# the first NUL as the lookup key, matching gettext.
fn parse_mo_from_bytes(data: bytes) -> Result(Translation, I18nErr):
    if len(data) < 28:
        return Err(Truncated)
    magic := _u32(data, 0, false)
    big := false
    if magic != 2500072158:
        magic = _u32(data, 0, true)
        big = true
        if magic != 2500072158:
            return Err(BadMagic)
    n := _u32(data, 8, big)
    ooff := _u32(data, 12, big)
    toff := _u32(data, 16, big)
    if n < 0 or ooff < 0 or toff < 0:
        return Err(Corrupt)
    if n > 1000000:
        return Err(TooBig)
    if ooff + n * 8 > len(data) or toff + n * 8 > len(data):
        return Err(Truncated)
    entries := []Entry
    plurals := []Plural
    hdr := ""
    for i := 0; i < n; i += 1:
        olen := _u32(data, ooff + i * 8, big)
        opos := _u32(data, ooff + i * 8 + 4, big)
        tlen := _u32(data, toff + i * 8, big)
        tpos := _u32(data, toff + i * 8 + 4, big)
        if olen < 0 or opos < 0 or tlen < 0 or tpos < 0:
            return Err(Corrupt)
        if opos + olen > len(data) or tpos + tlen > len(data):
            return Err(Truncated)
        mid := _str(data, opos, olen)
        mstr := _str(data, tpos, tlen)
        mparts := _split_nul(mid)
        tparts := _split_nul(mstr)
        if len(mparts) >= 3:
            push(plurals, Plural(mparts[1], mparts[2], tparts))
        elif len(mparts) == 2 and len(tparts) > 1:
            push(plurals, Plural(mparts[0], mparts[1], tparts))
        else:
            key := mid
            if len(mparts) == 2:
                key = mparts[1]
            if key == "":
                hdr = mstr
            else:
                push(entries, Entry(key, mstr))
    return Ok(Translation(entries, plurals, hdr))

# The catalog header, which carries the charset and plural metadata.
fn header(t: Translation) -> string:
    return t.header

# The singular translation, or the key itself when the catalog has no entry.
fn get(t: Translation, key: string) -> string:
    for e in t.entries:
        if e.key == key:
            return e.value
    return key

# The plural form. English's one/other rule is used for catalogs with more than
# one form; a catalog with a single form always returns it.
fn get_n(t: Translation, key: string, n: int) -> string:
    for p in t.plurals:
        if p.singular == key or p.plural == key:
            if len(p.forms) == 0:
                return key
            idx := 0
            if n != 1 and len(p.forms) > 1:
                idx = 1
            if idx >= len(p.forms):
                idx = len(p.forms) - 1
            return p.forms[idx]
    return get(t, key)
