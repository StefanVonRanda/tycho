# core:iter -- generic higher-order helpers over arrays, for any element type `$T`.
# `map` is the one that changes element type (`[$T] -> [$U]`); the rest preserve it.
# Import with `import "core:iter"`. Each takes a function value (a plain fn or a
# closure) -- `iter.map(xs, f)` etc. The function argument is first-class, so a
# CAPTURING closure works (passed downward, never stored). Predicates return
# `bool`; they returned a 0/1 `int` until 2026-08-11.
# `try_map` / `try_filter` are the fallible siblings of `map` / `filter`, for a
# stage whose callback can fail: the callback returns `Result`, the first `Err`
# short-circuits and is returned to the caller. Only these two have siblings --
# `reduce`, `count` and `any` had no caller needing one (2026-08-11).
package iter

# `map` carries TWO type variables on purpose: `$U` is the result element type,
# so `map(xs, to_str)` on an `[int]` yields a `[string]`. It was `fn($T) -> $T`
# until 2026-07-31, which made every map type-PRESERVING and left `[Res] -> [int]`
# inexpressible through the library at all. Same-type calls are unaffected --
# inference simply binds `$U` to `$T`.
fn map(xs: [$T], f: fn($T) -> $U) -> [$U]:
    out := []
    for v in xs:
        push(out, f(v))
    return out

# `try_map` is `map` with a fallible callback: same arguments, same order, `$E`
# inferred alongside `$T`/`$U`. The walk STOPS at the first Err and returns it
# unchanged -- no sentinel element, no partial array, no later error shadowing it.
fn try_map(xs: [$T], f: fn($T) -> Result($U, $E)) -> Result([$U], $E):
    out := []
    for v in xs:
        push(out, f(v) or_return)
    return Ok(out)

fn filter(xs: [$T], keep: fn($T) -> bool) -> [$T]:  # keep(x) true -> retain x
    out := []
    for v in xs:
        if keep(v):
            push(out, v)
    return out

# `try_filter` mirrors `filter`; `keep` answers with a bool wrapped in a Result.
# Same short-circuit: the first Err is the one returned.
fn try_filter(xs: [$T], keep: fn($T) -> Result(bool, $E)) -> Result([$T], $E):
    out := []
    for v in xs:
        k := keep(v) or_return
        if k:
            push(out, v)
    return Ok(out)

fn reduce(xs: [$T], init: $T, f: fn($T, $T) -> $T) -> $T:   # left fold: acc = f(acc, x)
    acc := init
    for v in xs:
        acc = f(acc, v)
    return acc

fn count(xs: [$T], pred: fn($T) -> bool) -> int:    # how many satisfy pred(x)
    n := 0
    for v in xs:
        if pred(v):
            n = n + 1
    return n

fn any(xs: [$T], pred: fn($T) -> bool) -> bool:     # true if pred(x) for some x
    for v in xs:
        if pred(v):
            return true
    return false
