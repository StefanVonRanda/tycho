package os

struct Output:
    code: int
    out: string

struct Capture:
    code: int
    out: string
    err: string

fn _has_nul(s: string) -> bool:
    for i := 0; i < len(s); i += 1:
        if s[i] == 0:
            return true
    return false

fn _argv_has_nul(argv: [string]) -> bool:
    for i := 0; i < len(argv); i += 1:
        if _has_nul(argv[i]):
            return true
    return false

# ---- shim externs (libc; defined in os_shim.c) ----
extern fn osx_system(cmd: string) -> int
extern fn osx_run(cmd: string) -> ptr          # opaque result handle; null only on popen() failure
extern fn osx_run_code(r: ptr) -> int
extern fn osx_run_out(r: ptr) -> bytes
extern fn osx_run_err(r: ptr) -> bytes
extern fn osx_run_free(r: ptr)
extern fn osx_exec(argv: [string]) -> int      # [string] crosses as (const char *const *, len), borrowed
extern fn osx_exec_out(argv: [string]) -> ptr  # same OsRun handle shape osx_run returns
extern fn osx_exec_capture(argv: [string]) -> ptr
extern fn osx_is_windows() -> int              # the build's _WIN32, as a runtime answer
extern fn osx_env_get(name: string) -> Option(string)
extern fn osx_env_set(name: string, value: string) -> int
extern fn osx_env_unset(name: string) -> int
extern fn osx_cwd() -> Option(string)
extern fn osx_chdir(p: string) -> int          # 0 ok, 1 not found, 2 denied, 3 not a dir, 4 failed
extern fn osx_pid() -> int
extern fn osx_hostname() -> Option(string)
extern fn osx_chmod(p: string, mode: int) -> int
extern fn osx_umask(mask: int) -> int
extern fn osx_getuid() -> int
extern fn osx_geteuid() -> int
extern fn osx_getgid() -> int
extern fn osx_getegid() -> int
extern fn osx_getppid() -> int

enum OsErr:
    BadName
    BadValue
    BadPath
    NotFound
    Denied
    Failed

# Run cmd, inheriting stdout/stderr; return its exit code.
fn system(cmd: string) -> int:
    if _has_nul(cmd):
        return -1
    return osx_system(cmd)

# Run cmd, capturing stdout; return Output{code, out}.
fn run(cmd: string) -> Output:
    if _has_nul(cmd):
        return Output(-1, "")
    r := osx_run(cmd)
    if is_null(r):
        return Output(-1, "")
    code := osx_run_code(r)
    out := to_str(osx_run_out(r))                    # the bytes out-param carries interior NULs
    res := Output(code, out)
    osx_run_free(r)                                  # both accessors finish before the handle is freed
    return res

# Run argv with no shell, inheriting stdout/stderr; return its exit code.
# It SPAWNS AND WAITS -- despite the name it never replaces the calling
# process, so execution continues at the next statement (the shim uses
# posix_spawnp, `corelib/os/os_shim.c:126-130` says why). There is no
# process-replacing call in core:os.
# The vector is BORROWED by the shim for the duration of the call and nothing is
# copied or freed on either side; the shim appends the NULL execv wants to a
# vector it owns, and refuses (-1) an empty or oversized argv.
fn exec(argv: [string]) -> int:
    if _argv_has_nul(argv):
        return -1
    return osx_exec(argv)

# Run argv with no shell, capturing stdout; return Output{code, out}.
fn exec_out(argv: [string]) -> Output:
    if _argv_has_nul(argv):
        return Output(-1, "")
    r := osx_exec_out(argv)
    if is_null(r):
        return Output(-1, "")
    code := osx_run_code(r)
    out := to_str(osx_run_out(r))
    res := Output(code, out)
    osx_run_free(r)
    return res

# Run argv with no shell, capturing stdout and stderr SEPARATELY. Same fail-closed
# contract as exec_out: a refused argv or a program that cannot be spawned is
# code -1 with both streams empty. The two pipes are drained concurrently, so a
# child cannot deadlock by filling stderr while stdout is still being read.
fn exec_capture(argv: [string]) -> Capture:
    if _argv_has_nul(argv):
        return Capture(-1, "", "")
    r := osx_exec_capture(argv)
    if is_null(r):
        return Capture(-1, "", "")
    code := osx_run_code(r)
    out := to_str(osx_run_out(r))
    err := to_str(osx_run_err(r))
    res := Capture(code, out, err)
    osx_run_free(r)
    return res

# True when this binary was built for Windows. Fixed at compile time (the shim
# answers from _WIN32), reported at run time because Tycho has no comptime.
fn is_windows() -> bool:
    return osx_is_windows() != 0

fn _bad_env_name(name: string) -> bool:
    if len(name) == 0:
        return true
    for i := 0; i < len(name); i += 1:
        if name[i] == 0 or name[i] == 61:      # NUL or '='
            return true
    return false

# Environment value: None when unset, Some("") when set to empty.
fn env(name: string) -> Option(string):
    if _bad_env_name(name):
        return None
    return osx_env_get(name)

# Set (or replace) an environment variable. Refused names and NUL values are
# BadName/BadValue; nothing is written in either case.
fn set_env(name: string, value: string) -> Result(void, OsErr):
    if _bad_env_name(name):
        return Err(BadName)
    if _has_nul(value):
        return Err(BadValue)
    if osx_env_set(name, value) != 0:
        return Err(Failed)
    return Ok()

# Remove an environment variable; absent is success (idempotent).
fn unset_env(name: string) -> Result(void, OsErr):
    if _bad_env_name(name):
        return Err(BadName)
    if osx_env_unset(name) != 0:
        return Err(Failed)
    return Ok()

# Current working directory. The shim answers through a thread-local buffer, so
# paths longer than that buffer fail with Failed rather than a truncated answer.
fn cwd() -> Result(string, OsErr):
    match osx_cwd():
        Some(p): return Ok(p)
        None: return Err(Failed)

fn chdir(p: string) -> Result(void, OsErr):
    if _has_nul(p) or len(p) == 0:
        return Err(BadName)
    k := osx_chdir(p)
    if k == 0:
        return Ok()
    if k == 1:
        return Err(NotFound)
    if k == 2:
        return Err(Denied)
    return Err(Failed)

fn pid() -> int:
    return osx_pid()

# Host name, or None when the platform call fails or truncates.
fn hostname() -> Option(string):
    return osx_hostname()

# HOME, then USERPROFILE, then HOMEDRIVE+HOMEPATH. Empty values are skipped.
fn home_dir() -> Option(string):
    for name in ["HOME", "USERPROFILE"]:
        match env(name):
            Some(v):
                if len(v) > 0:
                    return Some(v)
            None:
                pass
    drive := ""
    tail := ""
    match env("HOMEDRIVE"):
        Some(v): drive = v
        None: pass
    match env("HOMEPATH"):
        Some(v): tail = v
        None: pass
    if len(drive) > 0 and len(tail) > 0:
        return Some(drive + tail)
    return None

# TMPDIR, then TEMP, then TMP; the platform default when none is set. Not
# guaranteed to exist or be writable -- callers still open under it.
fn temp_dir() -> string:
    for name in ["TMPDIR", "TEMP", "TMP"]:
        match env(name):
            Some(v):
                if len(v) > 0:
                    return v
            None:
                pass
    if is_windows():
        return "."
    return "/tmp"

# chmod with the platform's permission-bit convention. On Windows only the
# read-only bit is meaningful; other bits are accepted and ignored by the CRT.
fn chmod(p: string, mode: int) -> Result(void, OsErr):
    if _has_nul(p) or len(p) == 0:
        return Err(BadPath)
    if mode < 0:
        return Err(BadValue)
    k := osx_chmod(p, mode)
    if k == 0:
        return Ok()
    if k == 1:
        return Err(NotFound)
    if k == 2:
        return Err(Denied)
    return Err(Failed)

# Set the process umask and return the previous value.
fn umask(mask: int) -> int:
    if mask < 0:
        die("os.umask: negative mask")
    return osx_umask(mask)

# POSIX identity. Windows has no numeric uid/gid and answers -1.
fn uid() -> int:
    return osx_getuid()

fn euid() -> int:
    return osx_geteuid()

fn gid() -> int:
    return osx_getgid()

fn egid() -> int:
    return osx_getegid()

fn ppid() -> int:
    return osx_getppid()
