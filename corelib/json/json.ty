# corelib: a JSON parser + serializer. Import with `import "core:json"`,
# serialize with `json.stringify(j)`.
#
# WHICH ENTRY POINT TO CALL. New code should call
# `parse_checked(s) -> Result(Json, JsonErr)`. It is the only one that can tell
# you the document you got back is the document you handed in. `parse(s) -> Json`
# is the lenient wrapper kept for the callers that predate the error channel: it
# runs the exact same parser and then throws the error away, returning JNull for
# the whole document. Use it only where a failure is genuinely not actionable;
# anything that reports a value to a person should use `parse_checked`.
#
# The parsed document is a recursive value-semantic tree (the `Json` enum),
# built by recursive descent and walked to serialize, with ZERO manual memory
# management -- every node and string lives in a lexical arena freed when its
# scope exits. This is the thesis (docs/thesis.md) as a real, reusable module.
# (Objects are parallel key/value arrays for iteration-order stability and
# simple equality, not because maps refuse the value: a recursive enum IS a
# legal map value -- `[]string: Tree` with `TNode(Tree, Tree)` compiles and
# runs.)
#
# ---- every input shape this parser accepts, one real example each -----------
#
#   null                  null
#   bool                  true                  false
#   integer               7        -3        0
#   float / exponent      1.5      -0.0      1e3      1E+3      2.5e-3
#   huge integer          123456789012345678901234567890        (see NUMBERS)
#   string                "tycho"
#   string escapes        "a\"b\nc\td"          (\" \\ \/ \b \f \n \r \t)
#   \u escape             "\u0041" -> A          "\u00e9" -> the 2 UTF-8 bytes of é
#   surrogate pair        "\ud83d\ude00" -> the 4 UTF-8 bytes of an emoji
#   array                 [1,"x",true,null]     []
#   object                {"a":1,"b":[2]}       {}
#   whitespace            space / tab / CR / LF between any two tokens,
#                         and before/after the whole document
#
# EVERY other input is an error carrying the byte offset of the byte that caused
# it -- see `JsonErr`, `err_reason`, `err_offset`, `err_str`. Nothing is guessed.
#
# ---- WHAT IS REFUSED, and it is now exactly what RFC 8259 refuses -----------
#
# The four leniencies this parser used to have are gone; each is now an error at
# a named byte, and the byte named is the one the writer has to fix:
#
#   [1,]  {"a":1,}      a trailing comma           -- names the COMMA
#   01  -01             a leading zero             -- names the ZERO
#   {"a":1} junk        text after the document    -- names the first junk byte
#   "a<TAB>b"           a raw control byte 00-1F   -- names the CONTROL BYTE
#
# Still accepted, and still correct: whitespace anywhere between tokens and on
# either side of the whole document, so `  {"a":1}\n ` is Ok. `0`, `-0`, `0.5`
# and `0e1` are fine -- the leading-zero rule forbids a zero FOLLOWED BY another
# digit, which is RFC 8259's `int = zero / (digit1-9 *DIGIT)`.
#
# ---- NUMBERS: which variant a number lands in, and why ----------------------
#
# The accepted number grammar is RFC 8259's, exactly:
# `-?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?`
#
#   JNum(int)            an integer that ROUND-TRIPS EXACTLY through 64 bits.
#                        Proved, not assumed: the accumulated int is rendered
#                        back to text and compared to the lexeme's own digits.
#   JFloat(v, lexeme)    everything else -- a fraction, an exponent, or an
#                        integer too big for `int`. It carries BOTH the
#                        binary64 value AND the original text.
#
# The lexeme is why this is not a new silent-wrong-value path. `1e309` would be
# an infinity and `123456789012345678901234567890` rounds in binary64, so a
# consumer that needs the digits back asks `as_lexeme` and gets the bytes the
# document actually contained; `stringify` emits that lexeme verbatim, never a
# re-rendered float, so parse -> stringify is byte-identical for every number
# above. (Re-rendering would also be LOCALE-SENSITIVE: `runtime/tycho_rt.c`'s
# `tycho_float_to_str` formats with `%g`, so `str(1.5)` is `1,5.0` under a
# comma-decimal LC_NUMERIC. Emitting the lexeme sidesteps that entirely.)
#
# A number whose VALUE binary64 cannot hold at all (`1e400`, `1e-400`) is an
# error at the first byte of the number, not an infinity and not a 0.
#
# What it still cannot do. NEITHER OF THESE IS A GRAMMAR LENIENCY -- the grammar
# this parser accepts is now exactly RFC 8259's. Both are ceilings elsewhere:
#
# gap: REPRESENTATION, not grammar. A number outside binary64's range (`1e400`,
#      `1e-400`) is well-formed RFC 8259 and is REFUSED rather than represented,
#      because representing it would mean an infinity or a 0 -- a silent wrong
#      value. The way out is an arbitrary-precision variant (`core:bignum` /
#      `core:decimal`), which is a numeric-tower decision, not a parser one.
#      Until then `as_lexeme` still returns the digits for the value that WAS
#      accepted; a refused one never enters the tree at all.
# CLOSED 2026-08-03: raw bytes >= 0x80 in a string are now validated (utf8_len
#      below, the s8.1 requirement). A raw 0xFF byte is BadUtf8, not a one-byte
#      string; `\uXXXX` escapes were already well-formed by construction.
#
# ---- OBJECTS: two decisions a signature cannot tell you ---------------------
#
# Both are asserted by corelib/test/json/main.ty, so neither can drift silently.
#
# DUPLICATE KEYS are all KEPT -- RFC 8259 leaves this to the parser and most take
# the last. `{"a":1,"a":2}` is two members and `stringify` re-emits both, so the
# round trip drops nothing; `get` answers with the FIRST. A caller wanting
# last-wins, or wanting to refuse a duplicate, has the member list in `keys`.
#
# NULL AND ABSENT ARE ONE ANSWER FROM `get` -- both JNull -- and this is the only
# place the accessors lose what the tree still holds. Ask `keys` instead: "n" is
# in it and "missing" is not. (An empty string is a third case; `kind` says
# "str".) The round trip is unaffected either way.
package json
import "core:strings"

enum Json:
    JNull
    JBool(bool)
    JNum(int)                     # an integer that round-trips through 64 bits
    JFloat(float, string)         # binary64 value + the ORIGINAL lexeme (NUMBERS, above)
    JStr(string)
    JArr([Json])
    JObj([string], [Json])        # parallel keys / values

# ---- the error channel -----------------------------------------------------
#
# Internally every recursive-descent function threads ONE extra `inout int`: the
# error code. The invariant that makes the byte offset free, and that the whole
# file depends on:
#
#   WHEN `ecode` IS NOT JE_OK, `pos` IS THE OFFSET OF THE BYTE THAT FAILED, AND
#   NO FUNCTION ADVANCES `pos` AGAIN.
#
# Every site that sets `ecode` returns immediately without touching `pos`, and
# every loop tests `ecode` in its head as well, so a future edit that forgets a
# return still terminates instead of spinning.
const JE_OK      = 0
const JE_TRUNC   = 1    # input ended inside a value, a string, or a container
const JE_BYTE    = 2    # a byte that can begin no value: `.` `+` `:` `}` junk
const JE_NUMBER  = 3    # `-` with no digit after it
const JE_FLOAT   = 4    # a malformed fraction or exponent: `1.`, `1e`, `1e+`
const JE_KEYWORD = 5    # `t`/`f`/`n` that is not `true`/`false`/`null`
const JE_ESCAPE  = 6    # any escape outside " \ / b f n r t u
const JE_KEY     = 7    # an object member that does not begin with `"`
const JE_COLON   = 8    # an object key not followed by `:`
const JE_SEP     = 9    # an element followed by neither `,` nor the closer
const JE_STUCK   = 10   # the structural guard fired: a nested parse ate nothing
const JE_RANGE   = 11   # well-formed, but binary64 holds no such value: `1e400`
const JE_UESC    = 12   # a `\u` not followed by four hex digits: `\uZZZZ`, `\u00"`
const JE_SURR    = 13   # a UTF-16 surrogate with no partner: a lone `\ud83d`
const JE_COMMA   = 14   # a trailing comma before a closer: `[1,]`, `{"a":1,}`
const JE_ZERO    = 15   # a leading zero: `01`, `-01`
const JE_TRAIL   = 16   # text after the top-level value: `{"a":1} junk`
const JE_CTRL    = 17   # a raw control byte 0x00-0x1F inside a string
const JE_UTF8    = 18   # a raw byte >= 0x80 that is not well-formed UTF-8

# WHICH BYTE THE TWO \u FAILURES NAME, because they differ and the difference is
# deliberate. JE_UESC names the OFFENDING BYTE ITSELF -- the first thing in the
# four-digit run that is not a hex digit, which is the byte the writer must fix.
# JE_SURR names the `u` of the OFFENDING ESCAPE, because there is no single bad
# byte: every byte of `\ud83d` is fine and it is the escape as a whole that has
# no partner. That matches JE_ESCAPE, which has always named the escape letter.
#
# THE SAME QUESTION FOR THE FOUR GRAMMAR FAILURES, answered the same way: name
# the byte the writer has to DELETE or CHANGE, not the byte the scanner happened
# to be standing on when it noticed.
#
#   JE_COMMA  the COMMA, not the `]` that revealed it. `[1,]` is fixed by
#             deleting byte 2; byte 3 is a perfectly good closing bracket.
#             `pos` rewinds to the comma, exactly as JE_SURR rewinds to its `u`.
#   JE_ZERO   the leading ZERO. `01` is fixed by deleting byte 0. (`-01` names
#             byte 1 -- the zero, not the sign, which is legal.)
#   JE_TRAIL  the FIRST NON-WHITESPACE byte after the document, because the
#             document itself is fine and everything from there on is the fault.
#   JE_CTRL   the CONTROL BYTE itself. It has to become an escape in place.

# The public failure. Every variant carries the byte offset, so a caller that
# only wants the position never has to know which cause it was.
enum JsonErr:
    Truncated(int)
    BadByte(int)
    BadNumber(int)
    BadFloat(int)
    BadKeyword(int)
    BadEscape(int)
    BadKey(int)
    MissingColon(int)
    MissingSep(int)
    NoProgress(int)
    NumberRange(int)
    BadUnicode(int)
    LoneSurrogate(int)
    TrailingComma(int)
    LeadingZero(int)
    TrailingText(int)
    ControlByte(int)
    BadUtf8(int)

fn err_at(code: int, off: int) -> JsonErr:
    if code == JE_COMMA:
        return TrailingComma(off)
    if code == JE_ZERO:
        return LeadingZero(off)
    if code == JE_TRAIL:
        return TrailingText(off)
    if code == JE_CTRL:
        return ControlByte(off)
    if code == JE_UTF8:
        return BadUtf8(off)
    if code == JE_UESC:
        return BadUnicode(off)
    if code == JE_SURR:
        return LoneSurrogate(off)
    if code == JE_RANGE:
        return NumberRange(off)
    if code == JE_TRUNC:
        return Truncated(off)
    if code == JE_NUMBER:
        return BadNumber(off)
    if code == JE_FLOAT:
        return BadFloat(off)
    if code == JE_KEYWORD:
        return BadKeyword(off)
    if code == JE_ESCAPE:
        return BadEscape(off)
    if code == JE_KEY:
        return BadKey(off)
    if code == JE_COLON:
        return MissingColon(off)
    if code == JE_SEP:
        return MissingSep(off)
    if code == JE_STUCK:
        return NoProgress(off)
    return BadByte(off)

fn err_offset(e: JsonErr) -> int:              # byte offset of the failure
    match e:
        Truncated(o): return o
        BadByte(o): return o
        BadNumber(o): return o
        BadFloat(o): return o
        BadKeyword(o): return o
        BadEscape(o): return o
        BadKey(o): return o
        MissingColon(o): return o
        MissingSep(o): return o
        NoProgress(o): return o
        NumberRange(o): return o
        BadUnicode(o): return o
        LoneSurrogate(o): return o
        TrailingComma(o): return o
        LeadingZero(o): return o
        TrailingText(o): return o
        ControlByte(o): return o
        BadUtf8(o): return o

fn err_reason(e: JsonErr) -> string:           # what was wrong, without the where
    match e:
        Truncated(o): return "input ended inside a value"
        BadByte(o): return "byte begins no JSON value"
        BadNumber(o): return "'-' with no digit after it"
        BadFloat(o): return "'.' or exponent with no digits after it"
        BadKeyword(o): return "not 'true', 'false' or 'null'"
        BadEscape(o): return "unsupported string escape"
        BadKey(o): return "object member does not begin with a quote"
        MissingColon(o): return "object key not followed by ':'"
        MissingSep(o): return "element followed by neither ',' nor the closer"
        NoProgress(o): return "nested parse consumed no byte"
        NumberRange(o): return "number outside the range a float can represent"
        BadUnicode(o): return "\\u escape is not followed by four hex digits"
        LoneSurrogate(o): return "UTF-16 surrogate escape with no partner"
        TrailingComma(o): return "trailing comma before the closing bracket"
        LeadingZero(o): return "number has a leading zero"
        TrailingText(o): return "text after the end of the document"
        ControlByte(o): return "raw control byte inside a string"
        BadUtf8(o): return "invalid UTF-8"

# The one-line message a caller wants on stderr: cause and byte offset together.
fn err_str(e: JsonErr) -> string:
    return err_reason(e) + " at byte " + str(err_offset(e))

# ---- parser (recursive descent; `pos` and `ecode` are threaded by inout) ----

fn skip_ws(s: string, n: int, pos: inout int):
    for pos < n and (s[pos] == 32 or s[pos] == 9 or s[pos] == 10 or s[pos] == 13):
        pos = pos + 1

# ---- \uXXXX: hex, UTF-8, and the surrogate pair ----------------------------
#
# The three constants that make the surrogate arithmetic readable. UTF-16 splits
# a code point above 0xFFFF into a LEADING surrogate D800-DBFF and a TRAILING one
# DC00-DFFF; neither half is a character on its own, which is why a lone one is
# an error here rather than a substituted U+FFFD. A replacement character is a
# guess, and this parser does not guess.
const SURR_HI_LO = 55296        # 0xD800, first leading surrogate
const SURR_HI_HI = 56319        # 0xDBFF, last leading surrogate
const SURR_LO_LO = 56320        # 0xDC00, first trailing surrogate
const SURR_LO_HI = 57343        # 0xDFFF, last trailing surrogate

fn hexval(c: int) -> int:                      # 0..15 for 0-9 a-f A-F, else -1
    if c >= 48 and c <= 57:                    # '0'..'9'
        return c - 48
    if c >= 97 and c <= 102:                   # 'a'..'f' -- hex is CASE-INSENSITIVE
        return c - 87
    if c >= 65 and c <= 70:                    # 'A'..'F'
        return c - 55
    return -1

# Read the four hex digits of a `\u` escape. `pos` ENTERS on the `u` and LEAVES
# on the LAST hex digit, so parse_string's own `pos = pos + 1` steps past the
# whole escape -- the same contract every other escape arm has.
#
# On failure nothing advances again, per the file's error invariant: JE_UESC
# leaves `pos` on the byte that is not a hex digit (which is how `"\u00"` is
# reported -- the closing quote is that byte), and JE_TRUNC leaves `pos == n`.
fn hex4(s: string, n: int, pos: inout int, ecode: inout int) -> int:
    v := 0
    for i := 0; i < 4; i += 1:
        pos = pos + 1
        if pos >= n:
            ecode = JE_TRUNC                   # `"\u00` -- input ended mid-escape
            return 0
        d := hexval(s[pos])
        if d < 0:
            ecode = JE_UESC
            return 0
        v = v * 16 + d
    return v

# A code point as its UTF-8 bytes. Division and modulo rather than shifts and
# masks because `cp` is always a non-negative int here, so the two agree exactly
# and this reads as the RFC 3629 table it is. The 4-byte arm cannot be reached
# with anything above 0x10FFFF: the only route into it is a surrogate pair, whose
# maximum is 0x10000 + 0x3FF*0x400 + 0x3FF = 0x10FFFF.
fn utf8(cp: int) -> string:
    if cp < 128:                               # 0xxxxxxx
        return chr(cp)
    if cp < 2048:                              # 110xxxxx 10xxxxxx
        return chr(192 + cp / 64) + chr(128 + cp % 64)
    if cp < 65536:                             # 1110xxxx 10xxxxxx 10xxxxxx
        return chr(224 + cp / 4096) + chr(128 + (cp / 64) % 64) + chr(128 + cp % 64)
    # 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
    return chr(240 + cp / 262144) + chr(128 + (cp / 4096) % 64) + chr(128 + (cp / 64) % 64) + chr(128 + cp % 64)

# The byte at `pos` must START a well-formed UTF-8 sequence (RFC 8259 s8.1
# allows unescaped %x20-21 / %x23-5B / %x5D-10FFFF). Returns the sequence
# length (2..4) or -1: a stray continuation, an overlong encoding, the UTF-16
# surrogate range (ED A0-BF), a value above U+10FFFF (F4 90-BF and F5-FF), or
# a truncated sequence. The `\uXXXX` escapes are validated separately (hex4 and
# the SURR pair logic); this is only the raw-bytes path.
fn utf8_len(s: string, pos: int, n: int) -> int:
    b0 := s[pos]
    if b0 < 128:
        return 1
    if b0 < 194:                    # 80-BF (a lone continuation) or C0-C1 (overlong)
        return -1
    if b0 < 224:                    # 2-byte: C2-DF
        if pos + 1 >= n:
            return -1
        b1 := s[pos + 1]
        if b1 < 128 or b1 > 191:
            return -1
        return 2
    if b0 < 240:                    # 3-byte: E0-EF
        if pos + 2 >= n:
            return -1
        b1 := s[pos + 1]
        if b0 == 224 and b1 < 160:      # E0 80-9F: overlong
            return -1
        if b0 == 237 and b1 >= 160:     # ED A0-BF: UTF-16 surrogates
            return -1
        if b1 < 128 or b1 > 191:
            return -1
        b2 := s[pos + 2]
        if b2 < 128 or b2 > 191:
            return -1
        return 3
    if b0 < 245:                    # 4-byte: F0-F4
        if pos + 3 >= n:
            return -1
        b1 := s[pos + 1]
        if b0 == 240 and b1 < 144:      # F0 80-8F: overlong
            return -1
        if b0 == 244 and b1 > 143:      # F4 90-BF: above U+10FFFF
            return -1
        if b1 < 128 or b1 > 191:
            return -1
        b2 := s[pos + 2]
        b3 := s[pos + 3]
        if b2 < 128 or b2 > 191 or b3 < 128 or b3 > 191:
            return -1
        return 4
    return -1                       # F5-FF: above U+10FFFF

fn parse_string(s: string, n: int, pos: inout int, ecode: inout int) -> string:
    pos = pos + 1                              # skip opening "
    start := pos
    # Fast path: scan the escape-free span up to the closing " or the first '\'.
    # The common JSON string has no escapes, so this takes it in one substr --
    # one allocation instead of a chr()+append per character (parse_string was
    # ~20% of a parse's CPU; the per-char append + chr() temp dominated it).
    # `s[pos] >= 32` is the RFC 8259 s7 rule: unescaped is %x20-21 / %x23-5B /
    # %x5D-10FFFF, so a raw control byte ends the span and is an error below.
    for pos < n and s[pos] != 34 and s[pos] != 92 and s[pos] >= 32:
        if s[pos] >= 128:                      # a raw byte must be part of a
            k := utf8_len(s, pos, n)           # well-formed UTF-8 sequence (s8.1)
            if k < 0:
                ecode = JE_UTF8
                return substr(s, start, pos)
            pos = pos + k
        else:
            pos = pos + 1
    r := substr(s, start, pos)                 # the escape-free prefix (the whole string in the common case)
    if pos >= n:
        ecode = JE_TRUNC                       # ran off the end with no closing "
        return r
    if s[pos] < 32:
        ecode = JE_CTRL                        # `"a<TAB>b"` -- must be escaped
        return r
    if s[pos] == 34:
        pos = pos + 1                          # skip closing "
        return r
    # Slow path: an escape is present. `r` holds the [start, pos) prefix; continue
    # char-by-char from the first backslash (rare, so the append cost is fine here).
    for pos < n and s[pos] != 34:              # until closing "
        if s[pos] == 92:                       # backslash escape
            pos = pos + 1
            if pos >= n:
                ecode = JE_TRUNC               # `"a\` -- the escape has no body
                return r
            e := s[pos]
            if e == 110:                       # \n
                r = r + "\n"
            elif e == 116:                     # \t
                r = r + "\t"
            elif e == 34:                      # \"
                r = r + "\""
            elif e == 92:                      # backslash
                r = r + "\\"
            elif e == 47:                      # \/ -- legal JSON, means '/'
                r = r + "/"
            elif e == 98:                      # \b
                r = r + chr(8)
            elif e == 102:                     # \f
                r = r + chr(12)
            elif e == 114:                     # \r
                r = r + chr(13)
            elif e == 117:                     # \uXXXX -- decoded to UTF-8
                ustart := pos                  # the `u`; the byte JE_SURR names
                cp := hex4(s, n, &pos, &ecode)
                if ecode != JE_OK:
                    return r
                if cp >= SURR_HI_LO and cp <= SURR_HI_HI:
                    # A LEADING surrogate. The trailing half must follow at once
                    # as a second `\u`. Anything else -- end of input, a literal
                    # character, some other escape, a second leading surrogate --
                    # is a LONE surrogate and an error. `pos` rewinds to this
                    # escape's `u` so the offset names what is unpaired.
                    if pos + 2 >= n or s[pos + 1] != 92 or s[pos + 2] != 117:
                        pos = ustart
                        ecode = JE_SURR
                        return r
                    pos = pos + 2              # onto the second escape's `u`
                    lo := hex4(s, n, &pos, &ecode)
                    if ecode != JE_OK:
                        return r
                    if lo < SURR_LO_LO or lo > SURR_LO_HI:
                        pos = ustart
                        ecode = JE_SURR
                        return r
                    cp = 65536 + (cp - SURR_HI_LO) * 1024 + (lo - SURR_LO_LO)
                elif cp >= SURR_LO_LO and cp <= SURR_LO_HI:
                    pos = ustart               # a TRAILING surrogate, no leader
                    ecode = JE_SURR
                    return r
                r = r + utf8(cp)
            else:
                # Every unknown escape (`\q`, `\x`). This used to emit the escape
                # letter itself, so `"\q"` became the text `q` -- a value nobody
                # wrote. Fail closed AT the letter instead.
                ecode = JE_ESCAPE
                return r
        else:
            if s[pos] < 32:                    # the same RFC 8259 s7 rule as the
                ecode = JE_CTRL                # fast path, on the slow path too
                return r
            if s[pos] >= 128:                  # raw UTF-8: validate the sequence
                k := utf8_len(s, pos, n)
                if k < 0:
                    ecode = JE_UTF8
                    return r
                r = r + substr(s, pos, pos + k)
                pos = pos + k
                continue
            r = r + chr(s[pos])
        pos = pos + 1
    if pos >= n:
        ecode = JE_TRUNC                       # no closing " after the escape
        return r
    pos = pos + 1                              # skip closing "
    return r

# The largest `int` is 9223372036854775807. Split so the accumulator can be
# tested BEFORE the multiply that would overflow it -- signed overflow is what
# the old parser did, and it is how a 20-digit integer used to leave here as a
# wrong number at exit 0. Nothing below ever performs the overflowing multiply.
const INT_MAX_DIV10 = 922337203685477580
const INT_MAX_LAST  = 7

# Called only with `s[pos]` already known to be `-` or a digit (parse_value
# checks). Consumes at least one byte on success, which is half of why the
# array/object loops below cannot spin.
#
# Returns JNum for an integer PROVED to survive 64 bits, JFloat(value, lexeme)
# for everything else. See NUMBERS in the file header for why the lexeme is
# carried rather than the value alone.
fn parse_number(s: string, n: int, pos: inout int, ecode: inout int) -> Json:
    start := pos
    neg := false
    if s[pos] == 45:                           # '-'
        neg = true
        pos = pos + 1
    if pos >= n or s[pos] < 48 or s[pos] > 57:
        pos = start                            # `-` alone, or `-x`
        ecode = JE_NUMBER
        return JNull
    dstart := pos                              # first digit of the integer part
    # RFC 8259: `int = zero / (digit1-9 *DIGIT)`. A `0` may be the WHOLE integer
    # part (`0`, `-0`, `0.5`, `0e1` are all fine) but may not be followed by
    # another digit. The offset names the zero, which is the byte to delete.
    if s[dstart] == 48 and dstart + 1 < n and s[dstart + 1] >= 48 and s[dstart + 1] <= 57:
        pos = dstart
        ecode = JE_ZERO
        return JNull
    v := 0
    ovf := false                               # the value left the int range
    for pos < n and s[pos] >= 48 and s[pos] <= 57:
        d := s[pos] - 48
        if ovf or v > INT_MAX_DIV10 or (v == INT_MAX_DIV10 and d > INT_MAX_LAST):
            ovf = true                         # stop accumulating; keep scanning
        else:
            v = v * 10 + d
        pos = pos + 1
    dend := pos                                # one past the last integer digit
    isfloat := false
    if pos < n and s[pos] == 46:               # '.' -- a fraction
        isfloat = true
        pos = pos + 1
        fd := 0
        for pos < n and s[pos] >= 48 and s[pos] <= 57:
            pos = pos + 1
            fd = fd + 1
        if fd == 0:                            # `1.` -- a point NEEDS digits
            ecode = JE_FLOAT
            return JNull
    if pos < n and (s[pos] == 101 or s[pos] == 69):   # 'e' / 'E' -- an exponent
        isfloat = true
        pos = pos + 1
        if pos < n and (s[pos] == 43 or s[pos] == 45):
            pos = pos + 1
        ed := 0
        for pos < n and s[pos] >= 48 and s[pos] <= 57:
            pos = pos + 1
            ed = ed + 1
        if ed == 0:                            # `1e`, `1e+`
            ecode = JE_FLOAT
            return JNull
    lex := substr(s, start, pos)               # the number exactly as written
    if not isfloat and not ovf:
        iv := v
        if neg:
            iv = 0 - v
        # THE ROUND-TRIP PROOF. Render the accumulated int back to text and
        # compare it to the lexeme's own digits. Only an exact match becomes a
        # JNum; anything else falls through to the float path WITH its lexeme,
        # so a value this `int` cannot hold is never handed back as if it could.
        # The digits compared are the lexeme's own, verbatim: this used to skip
        # leading zeros first, because `01` was accepted and `str(1)` could never
        # match it. The leading-zero test above means there are none left to
        # skip, so the comparison is now against exactly what was written.
        canon := substr(s, dstart, dend)
        if neg:
            canon = "-" + canon
        if str(iv) == canon:
            return JNum(iv)
    # The float path. `lex` already matched a grammar that is a strict subset of
    # `strings.parse_float`'s, so Syntax is unreachable here; the reachable
    # failures are Overflow (`1e400`) and Underflow (`1e-400`), and both are
    # refusals rather than an infinity or a 0. A subnormal (`1e-320`) is a VALUE
    # here since 2026-08-12 -- parse_float refuses only a total underflow to 0.
    # `pos` rewinds to the first byte of the number so the reported offset names
    # the token, not its end.
    match strings.parse_float(lex):
        Ok(fv):
            return JFloat(fv, lex)
        Err(fe):
            pos = start
            ecode = JE_RANGE
            return JNull

# The structural anti-spin guard lives in this function and in parse_object.
#
# Every iteration must consume at least one byte. `before := pos` records the
# cursor; if `parse_value` returns having moved nothing, the document is
# malformed in a way this parser cannot name and it stops (JE_STUCK) instead of
# pushing another node forever. The guard does not care WHICH byte class caused
# it, which is the point -- it holds for all of them:
#
#   opener  { [                 recurses, always eats the opener
#   quote   "                   parse_string always eats the opening quote
#   t f n   true/false/null     eats 4/5 bytes or errors, never 0
#   - 0-9   -3, 7, 1.5, 1e3     parse_number eats >= 1 digit or errors
#   . + e   .5, +1, e9          JE_BYTE -- error, not a 0-byte read
#   closer  ] }                 JE_BYTE (the loop head handles the RIGHT closer)
#   , :     stray separators    JE_BYTE
#   ws      handled by skip_ws before the dispatch
#   any other byte              JE_BYTE
#
# So today no path can reach the guard. It stays anyway: it is the invariant, and
# the previous version of this loop was one missing `else` away from the OOM that
# five bytes of input (`[1.5]`) used to cause.
fn parse_array(s: string, n: int, pos: inout int, ecode: inout int) -> Json:
    pos = pos + 1                              # skip [
    xs := []Json
    skip_ws(s, n, &pos)
    for pos < n and s[pos] != 93 and ecode == JE_OK:   # until ]
        before := pos
        push(xs, parse_value(s, n, &pos, &ecode))
        if ecode != JE_OK:
            return JArr(xs)
        if pos == before:                      # cannot happen today -- see above
            ecode = JE_STUCK
            return JArr(xs)
        skip_ws(s, n, &pos)
        if pos >= n:
            ecode = JE_TRUNC
            return JArr(xs)
        if s[pos] == 44:                       # ,
            cpos := pos                        # remembered so the error can name it
            pos = pos + 1
            skip_ws(s, n, &pos)
            if pos < n and s[pos] == 93:       # `[1,]` -- a comma promises an element
                pos = cpos
                ecode = JE_COMMA
                return JArr(xs)
        elif s[pos] != 93:                     # neither , nor ]
            ecode = JE_SEP
            return JArr(xs)
    if ecode != JE_OK:
        return JArr(xs)
    if pos >= n:
        ecode = JE_TRUNC                       # `[1` -- no closing ]
        return JArr(xs)
    pos = pos + 1                              # skip ]
    return JArr(xs)

fn parse_object(s: string, n: int, pos: inout int, ecode: inout int) -> Json:
    pos = pos + 1                              # skip {
    ks := []string
    vs := []Json
    skip_ws(s, n, &pos)
    for pos < n and s[pos] != 125 and ecode == JE_OK:  # until }
        before := pos
        if s[pos] != 34:                       # a member must start with a key
            ecode = JE_KEY
            return JObj(ks, vs)
        k := parse_string(s, n, &pos, &ecode)
        if ecode != JE_OK:
            return JObj(ks, vs)
        skip_ws(s, n, &pos)
        # This used to be an unconditional `pos = pos + 1  # skip :`, which is
        # how a value the parser could not read left the cursor mid-token and the
        # next iteration read the remainder as a key. It is now checked.
        if pos >= n:
            ecode = JE_TRUNC
            return JObj(ks, vs)
        if s[pos] != 58:                       # :
            ecode = JE_COLON
            return JObj(ks, vs)
        pos = pos + 1                          # skip :
        push(ks, k)
        push(vs, parse_value(s, n, &pos, &ecode))
        if ecode != JE_OK:
            return JObj(ks, vs)
        if pos == before:                      # cannot happen today -- see above
            ecode = JE_STUCK
            return JObj(ks, vs)
        skip_ws(s, n, &pos)
        if pos >= n:
            ecode = JE_TRUNC
            return JObj(ks, vs)
        if s[pos] == 44:                       # ,
            cpos := pos                        # remembered so the error can name it
            pos = pos + 1
            skip_ws(s, n, &pos)
            if pos < n and s[pos] == 125:      # `{"a":1,}` -- a comma promises a member
                pos = cpos
                ecode = JE_COMMA
                return JObj(ks, vs)
        elif s[pos] != 125:                    # neither , nor }
            ecode = JE_SEP
            return JObj(ks, vs)
    if ecode != JE_OK:
        return JObj(ks, vs)
    if pos >= n:
        ecode = JE_TRUNC                       # `{"a":1` -- no closing }
        return JObj(ks, vs)
    pos = pos + 1                              # skip }
    return JObj(ks, vs)

fn parse_value(s: string, n: int, pos: inout int, ecode: inout int) -> Json:
    skip_ws(s, n, &pos)
    if pos >= n:
        ecode = JE_TRUNC                       # truncated / empty: fail closed
        return JNull
    c := s[pos]
    match c:
        123:                                 # {
            return parse_object(s, n, &pos, &ecode)
        91:                                   # [
            return parse_array(s, n, &pos, &ecode)
        34:                                   # "
            return JStr(parse_string(s, n, &pos, &ecode))
        116:                                  # 'true'
            e := pos + 4
            if e <= n and s[pos:e] == "true":
                pos = e
                return JBool(true)
            ecode = JE_KEYWORD
            return JNull
        102:                                  # 'false'
            e := pos + 5
            if e <= n and s[pos:e] == "false":
                pos = e
                return JBool(false)
            ecode = JE_KEYWORD
            return JNull
        110:                                  # 'null'
            e := pos + 4
            if e <= n and s[pos:e] == "null":
                pos = e
                return JNull
            ecode = JE_KEYWORD
            return JNull
        45 | 48..57:                          # '-' or a digit -- number, JNum or JFloat
            return parse_number(s, n, &pos, &ecode)
        _:
            # Everything else -- `.` `+` `:` `,` a stray closer, a control byte.
            # The old parser fell through to parse_number here, which consumed
            # nothing and returned JNum(0); that is the whole spin.
            ecode = JE_BYTE
            return JNull

# THE ENTRY POINT FOR NEW CODE. Parse a WHOLE document: the value, then optional
# whitespace, then the end of the input. Anything else after the value is an
# error naming its first byte. On failure the Err names the cause and the byte
# offset of the byte that caused it.
#
# This function used to ignore trailing text, and that was documented behaviour
# for as long as the package existed. It stopped because ignoring it is a silent
# wrong ANSWER, not merely a lenient one: `{"a":1} {"b":2}` returned the first
# object and said nothing about the second, so a caller handed two documents got
# one and could not tell. All six callers in this tree hand it exactly one
# document each -- checked, one at a time, before the change.
fn parse_checked(s: string) -> Result(Json, JsonErr):
    n := len(s)
    pos := 0
    ecode := JE_OK
    j := parse_value(s, n, &pos, &ecode)
    if ecode != JE_OK:
        return Err(err_at(ecode, pos))
    skip_ws(s, n, &pos)                        # a trailing newline is still fine
    if pos != n:
        return Err(TrailingText(pos))
    return Ok(j)

# The lenient wrapper, kept so the callers written before the error channel keep
# compiling and keep their signature. LENIENT MEANS "discards the error", NOT
# "accepts more": it runs the same parser over the same grammar and fails closed
# to JNull for the whole document rather than handing back a half-built tree.
# Prefer `parse_checked`.
fn parse(s: string) -> Json:
    match parse_checked(s):
        Ok(j):
            return j
        Err(e):
            return JNull

# ---- serializer (walk the tree, build a compact string) --------------------

fn hexdig(v: int) -> string:                   # one LOWERCASE hex digit, 0..15
    if v < 10:
        return chr(48 + v)
    return chr(87 + v)

# WHAT IS ESCAPED ON OUTPUT, AND WHY. Exactly the set RFC 8259 forbids raw
# inside a string, and nothing else:
#
#   "  \        the two that would end or re-open the string -- must escape
#   0x00-0x1F   control bytes. RFC 8259 forbids ALL of them raw. The five with
#               short forms get them (\b \f \n \r \t); the other 27 get \u00XX.
#               parse_string refuses a raw one on the way IN (JE_CTRL), so the
#               two directions now agree: such a byte can only ever enter as an
#               escape, and it only ever leaves as one. A string built in Tycho
#               rather than parsed can still hold one, which is why this arm is
#               load-bearing and not merely symmetric.
#   everything else passes through as its own bytes, DELIBERATELY:
#     /         legal raw; `\/` is permitted but not required, and escaping it
#               would make stringify(parse(x)) differ from x for no gain.
#     >= 0x80   a decoded `\uXXXX` is UTF-8 bytes by the time it reaches here,
#               and raw UTF-8 is legal in a JSON string. Re-escaping it back to
#               `\uXXXX` would need a UTF-8 DECODER and would answer a question
#               nobody asked; passing the bytes through makes parse -> stringify
#               -> parse a FIXED POINT, which is the property that matters.
#     0x7F      DEL is not a control byte for RFC 8259's purposes; legal raw.
fn esc(s: string) -> string:
    out := ""
    for i := 0; i < len(s); i += 1:
        c := s[i]
        if c == 34:                            # "
            out = out + "\\\""
        elif c == 92:                          # backslash
            out = out + "\\\\"
        elif c == 8:
            out = out + "\\b"
        elif c == 12:
            out = out + "\\f"
        elif c == 10:
            out = out + "\\n"
        elif c == 13:
            out = out + "\\r"
        elif c == 9:
            out = out + "\\t"
        elif c < 32:                           # every other control byte
            out = out + "\\u00" + hexdig(c / 16) + hexdig(c % 16)
        else:
            out = out + chr(c)
    return out

fn stringify(j: Json) -> string:
    match j:
        JNull:
            return "null"
        JBool(b):
            if b:
                return "true"
            return "false"
        JNum(x):
            return str(x)
        JFloat(v, lx):
            # The STORED LEXEME, never `str(v)`. Re-rendering a binary64 loses
            # digits (`123456789012345678901234567890` would come back as
            # `1.2345678901234568e+29`) and is locale-sensitive besides, so
            # emitting the original bytes is the only byte-identical round trip.
            return lx
        JStr(s):
            return "\"" + esc(s) + "\""
        JArr(xs):
            out := "["
            for i := 0; i < len(xs); i += 1:
                if i > 0:
                    out = out + ","
                out = out + stringify(xs[i])
            return out + "]"
        JObj(ks, vs):
            out := "{"
            for i := 0; i < len(ks); i += 1:
                if i > 0:
                    out = out + ","
                out = out + "\"" + esc(ks[i]) + "\":" + stringify(vs[i])
            return out + "}"

# ---- accessors (typed queries into the document) ---------------------------

# "null"/"bool"/"num"/"float"/"str"/"arr"/"obj"
#
# A JFloat reports "float", NOT "num", and that is a fail-closed choice made by
# reading the consumers rather than by taste. `tools/tycho-q/main.ty@json_cell`
# dispatches on this string and answers `k == "num"` with `json.as_num(j)` --
# which returns 0 for a JFloat. Folding floats into "num" would therefore turn
# every JSON float into the cell value 0 at exit 0: a silent wrong value, the
# exact class of bug this package spent two plans removing. With "float" that
# same code takes its final `return Err(...)` branch and REFUSES the cell, which
# is honest until a consumer learns the variant.
fn kind(j: Json) -> string:
    match j:
        JNull:
            return "null"
        JBool(b):
            return "bool"
        JNum(x):
            return "num"
        JFloat(v, lx):
            return "float"
        JStr(s):
            return "str"
        JArr(xs):
            return "arr"
        JObj(ks, vs):
            return "obj"

fn get(j: Json, key: string) -> Json:          # object field, else JNull
    match j:
        JObj(ks, vs):
            for i := 0; i < len(ks); i += 1:
                if ks[i] == key:
                    return vs[i]
            return JNull
        JNull:
            return JNull
        JBool(b):
            return JNull
        JNum(x):
            return JNull
        JFloat(v, lx):
            return JNull
        JStr(s):
            return JNull
        JArr(xs):
            return JNull

fn at(j: Json, i: int) -> Json:                # array element i, else JNull
    match j:
        JArr(xs):
            if i >= 0 and i < len(xs):
                return xs[i]
            return JNull
        JNull:
            return JNull
        JBool(b):
            return JNull
        JNum(x):
            return JNull
        JFloat(v, lx):
            return JNull
        JStr(s):
            return JNull
        JObj(ks, vs):
            return JNull

fn keys(j: Json) -> [string]:                  # object keys (in order), else []
    match j:
        JObj(ks, vs):
            return ks
        JNull:
            return []string
        JBool(b):
            return []string
        JNum(x):
            return []string
        JFloat(v, lx):
            return []string
        JStr(s):
            return []string
        JArr(xs):
            return []string

fn len_of(j: Json) -> int:                     # array/object element count, string byte length, else 0
    match j:
        JArr(xs):
            return len(xs)
        JObj(ks, vs):
            return len(ks)
        JStr(s):
            return len(s)
        JNull:
            return 0
        JBool(b):
            return 0
        JNum(x):
            return 0
        JFloat(v, lx):
            return 0

# JNum payload, else 0. A JFloat answers 0 HERE ON PURPOSE and the arm is
# spelled out rather than left to `_` so the choice is visible: `as_num` promises
# an exact 64-bit integer and a JFloat is precisely the number that is not one.
# Reach for `as_float` for the value, or `as_lexeme` for the digits as written.
fn as_num(j: Json) -> int:
    match j:
        JNum(x):
            return x
        JFloat(v, lx):
            return 0
        _:
            return 0

# The binary64 value: a JFloat's own, a JNum widened. 0.0 for everything else.
# Beware the widening: an `int` above 2^53 does not survive it exactly, which is
# why `as_lexeme` exists.
fn as_float(j: Json) -> float:
    match j:
        JFloat(v, lx):
            return v
        JNum(x):
            return to_float(x)
        _:
            return 0.0

# THE EXACT ANSWER. The number as the document spelled it -- a JFloat's stored
# lexeme, a JNum rendered back (which is exact by construction: parse_number only
# builds a JNum after proving that render matches the input). "" for a non-number.
# A caller needing full precision (an arbitrary-precision decimal, say) parses
# this, never `as_float`.
fn as_lexeme(j: Json) -> string:
    match j:
        JFloat(v, lx):
            return lx
        JNum(x):
            return str(x)
        _:
            return ""

fn as_str(j: Json) -> string:                  # JStr payload, else ""
    match j:
        JStr(s):
            return s
        _:
            return ""

fn as_bool(j: Json) -> bool:                   # JBool payload, else false
    match j:
        JBool(b):
            return b
        _:
            return false
