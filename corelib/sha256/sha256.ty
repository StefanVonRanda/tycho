# corelib: the SHA-256 hash (FIPS 180-4). Import with `import "core:sha256"`,
# use `sha256.hex(s)` for the 64-char hex digest or `sha256.digest(s)` for the
# 32 raw bytes.
#
# Real 32-bit arithmetic via the `u32` type: every add wraps at 2^32 natively
# (C `unsigned int`), the 32-bit NOT is `~x`, and the rotates/shifts use `>> <<`.
# SHA-256 is big-endian (message words, the length suffix, and the output are
# most-significant-first).
#
# SHA-256 is a real cryptographic digest (unlike MD5): suitable for checksums,
# content addressing, HMAC building blocks, and integrity. It is NOT a password
# hash on its own -- use a slow KDF (PBKDF2/scrypt/argon2) for passwords.
package sha256

fn pow2(n: int) -> int:                    # 2^n (for the byte-domain length suffix)
    r := 1
    i := 0
    for i < n:
        r = r * 2
        i = i + 1
    return r

fn rotr(x: u32, n: int) -> u32:            # 32-bit rotate right
    return (x >> n) | (x << (32 - n))

fn shr(x: u32, n: int) -> u32:             # logical right shift
    return x >> n

fn lo_hex(n: int) -> int:
    if n < 10:
        return 48 + n
    return 97 + (n - 10)

fn hex2(b: int) -> string:
    return chr(lo_hex(b / 16)) + chr(lo_hex(b % 16))

fn ch(x: u32, y: u32, z: u32) -> u32:
    return (x & y) ^ (~x & z)

fn maj(x: u32, y: u32, z: u32) -> u32:
    return (x & y) ^ (x & z) ^ (y & z)

fn bigsig0(x: u32) -> u32:
    return rotr(x, 2) ^ rotr(x, 13) ^ rotr(x, 22)

fn bigsig1(x: u32) -> u32:
    return rotr(x, 6) ^ rotr(x, 11) ^ rotr(x, 25)

fn smallsig0(x: u32) -> u32:
    return rotr(x, 7) ^ rotr(x, 18) ^ shr(x, 3)

fn smallsig1(x: u32) -> u32:
    return rotr(x, 17) ^ rotr(x, 19) ^ shr(x, 10)

fn to_u32_all(xs: [int]) -> [u32]:         # widen an int-literal constant table to u32
    r := []u32
    for x in xs:
        push(r, to_u32(x))
    return r

fn h_init() -> [u32]:                      # frac(sqrt(first 8 primes))
    return to_u32_all([1779033703, 3144134277, 1013904242, 2773480762, 1359893119, 2600822924, 528734635, 1541459225])

fn k_table() -> [u32]:                     # frac(cbrt(first 64 primes))
    return to_u32_all([1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221, 3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580, 3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986, 2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895, 666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037, 2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344, 430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779, 1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298])

# The 32 raw digest bytes.
#
# One-shot over a whole `string`; for a large or chunked message use the
# streaming form instead (init / update / final below), which never expands the
# message into one `int` per byte.
fn digest(msg: string) -> [int]:
    st := init()
    update(&st, to_bytes(msg))
    return final(&st)

# The 64-character lowercase hex digest.
fn hex(msg: string) -> string:
    st := init()
    update(&st, to_bytes(msg))
    return final_hex(&st)

struct State:
    h: [u32]
    pending: bytes
    total: int

fn init() -> State:
    return State(h_init(), to_bytes(""), 0)

# The compression of the 64 bytes at `src[base..base+64)`. Operates on the
# `bytes` value directly, no per-byte int expansion; the caller guarantees the
# 64 bytes exist.
# hv/kt/w are FIPS 180-4's H, K and W (a binding may not start uppercase, §3.7).
fn block(hv: inout [u32], kt: [u32], src: bytes, base: int):
    w := []u32
    t := 0
    for t < 16:
        q := base + t * 4
        push(w, (to_u32(src[q]) << 24) | (to_u32(src[q + 1]) << 16) | (to_u32(src[q + 2]) << 8) | to_u32(src[q + 3]))
        t = t + 1
    for t < 64:
        push(w, smallsig1(w[t - 2]) + w[t - 7] + smallsig0(w[t - 15]) + w[t - 16])
        t = t + 1
    a := hv[0]
    b := hv[1]
    c := hv[2]
    d := hv[3]
    e := hv[4]
    f := hv[5]
    g := hv[6]
    h := hv[7]
    i := 0
    for i < 64:
        t1 := h + bigsig1(e) + ch(e, f, g) + kt[i] + w[i]
        t2 := bigsig0(a) + maj(a, b, c)
        h = g
        g = f
        f = e
        e = d + t1
        d = c
        c = b
        b = a
        a = t1 + t2
        i = i + 1
    hv[0] = hv[0] + a
    hv[1] = hv[1] + b
    hv[2] = hv[2] + c
    hv[3] = hv[3] + d
    hv[4] = hv[4] + e
    hv[5] = hv[5] + f
    hv[6] = hv[6] + g
    hv[7] = hv[7] + h

# Absorb `data`, leaving whatever did not fill a block in `pending` (< 64
# bytes). Only concatenates when there really is a carry: `bytes + bytes`
# copies both sides, so with a chunk that is a multiple of 64 this branch is
# not taken mid-file.
fn update(st: inout State, data: bytes):
    st.total = st.total + len(data)
    kt := k_table()
    work := data
    if len(st.pending) > 0:
        work = st.pending + data
    nb := len(work) / 64
    for k := 0; k < nb; k += 1:
        block(&st.h, kt, work, k * 64)
    st.pending = work[nb * 64:len(work)]

# Pad per FIPS 180-4 (0x80, zeros to 56 mod 64, the 64-bit big-endian bit
# length), compress the tail, and emit the 32 raw digest bytes. Consumes the
# state. The padding is built as a `string` because `chr(n)` is the only way to
# make a byte from a number, and a Tycho string holds a 0x00 like any other
# byte.
fn final(st: inout State) -> [int]:
    tail := to_str(st.pending) + chr(128)
    zeros := (56 - (len(tail) % 64) + 64) % 64
    for i := 0; i < zeros; i += 1:
        tail = tail + chr(0)
    bitlen := st.total * 8
    sh := 56
    for i := 0; i < 8; i += 1:
        tail = tail + chr((bitlen / pow2(sh)) % 256)
        sh = sh - 8
    tb := to_bytes(tail)
    kt := k_table()
    nb := len(tb) / 64
    for k := 0; k < nb; k += 1:
        block(&st.h, kt, tb, k * 64)
    out := []int
    vi := 0
    for vi < 8:
        v := st.h[vi]
        push(out, to_int((v >> 24) & 255))
        push(out, to_int((v >> 16) & 255))
        push(out, to_int((v >> 8) & 255))
        push(out, to_int(v & 255))
        vi = vi + 1
    return out

# The 64-char lowercase hex digest of a streamed message. Consumes the state.
fn final_hex(st: inout State) -> string:
    b := final(&st)
    out := ""
    for i := 0; i < 32; i += 1:
        out = out + hex2(b[i])
    return out
