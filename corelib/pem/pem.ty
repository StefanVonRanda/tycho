package pem

import "core:base64"

enum PemErr:
    NoBlock
    Unterminated
    BadLabel
    BadBase64

struct Block:
    label: string
    data: bytes

fn _bad_label(label: string) -> bool:
    if len(label) == 0:
        return true
    for i := 0; i < len(label); i += 1:
        c := label[i]
        if c == 0 or c == 10 or c == 13:
            return true
    return false

fn _valid_b64(s: string) -> bool:
    if len(s) % 4 != 0:
        return false
    pad := 0
    for i := 0; i < len(s); i += 1:
        c := s[i]
        if c == 61:                            # '='
            pad += 1
            if pad > 2:
                return false
        elif pad > 0:
            return false
        elif (c >= 65 and c <= 90) or (c >= 97 and c <= 122) or (c >= 48 and c <= 57) or c == 43 or c == 47:
            pass
        else:
            return false
    return true

# The label is written verbatim between the BEGIN/END markers; it must be a
# non-empty single line. The body is Base64 wrapped at 64 columns.
fn encode(label: string, data: bytes) -> string:
    if _bad_label(label):
        die("pem.encode: label must be a non-empty single line")
    out := "-----BEGIN " + label + "-----\n"
    b := base64.encode(to_str(data))
    i := 0
    for i < len(b):
        e := i + 64
        if e > len(b):
            e = len(b)
        out = out + b[i:e] + "\n"
        i = e
    out = out + "-----END " + label + "-----\n"
    return out

fn _body_b64(body: string) -> string:
    out := ""
    for i := 0; i < len(body); i += 1:
        c := body[i]
        if c != 10 and c != 13 and c != 32 and c != 9:
            out = out + chr(c)
    return out

# First block in `s`. Text outside the markers is ignored.
fn decode(s: string) -> Result(Block, PemErr):
    b0 := find(s, "-----BEGIN ")
    if b0 < 0:
        return Err(NoBlock)
    ls := b0 + 11
    le := find(s[ls:len(s)], "-----")
    if le < 0:
        return Err(Unterminated)
    label := s[ls:ls + le]
    hdr_end := ls + le + 5
    if hdr_end < len(s) and s[hdr_end] == 13:
        hdr_end += 1
    if hdr_end < len(s) and s[hdr_end] == 10:
        hdr_end += 1
    else:
        return Err(Unterminated)
    e0 := find(s[hdr_end:len(s)], "-----END ")
    if e0 < 0:
        return Err(Unterminated)
    body := s[hdr_end:hdr_end + e0]
    els := hdr_end + e0 + 9
    ele := find(s[els:len(s)], "-----")
    if ele < 0:
        return Err(Unterminated)
    elabel := s[els:els + ele]
    if elabel != label:
        return Err(BadLabel)
    b64 := _body_b64(body)
    if not _valid_b64(b64):
        return Err(BadBase64)
    return Ok(Block(label, to_bytes(base64.decode(b64))))
