# core:decimal -- arbitrary-precision decimal (base-10 fixed point). Import with
# `import "core:decimal"`. Built on core:bignum: a Decimal is an integer coefficient
# (a bignum.Big, arbitrary size) times 10^(-scale), so it represents decimal
# fractions EXACTLY -- `0.1 + 0.2` is `0.3`, not a float's `0.30000000000000004`.
# That makes it the right type for money and any base-10-exact arithmetic.
#
# add/sub/mul/cmp are exact; the stored scale is preserved (1.50 stays "1.50").
# rescale truncates toward zero. div is the one operation with no exact answer in
# general, so it takes what it needs from the CALLER instead of inventing it:
# `div(a, b, scale, mode)` -- the target scale and the rounding mode are arguments,
# and dividing by zero is an `Err(DivByZero)` rather than an abort.
package decimal
import "core:bignum"

struct Decimal:
    coeff: bignum.Big      # signed integer coefficient
    scale: int             # digits after the decimal point (>= 0); value = coeff * 10^(-scale)

# Multiply a coefficient by 10^k (k >= 0): the scale-alignment primitive.
fn scale_up(c: bignum.Big, k: int) -> bignum.Big:
    if k <= 0:
        return c
    return bignum.mul(c, bignum.pow(bignum.from_int(10), k))

fn from_int(n: int) -> Decimal:
    return Decimal(bignum.from_int(n), 0)

# Parse "[-|+]digits[.digits]". No point -> scale 0; a trailing point -> scale 0;
# a leading point (".5") -> integer part 0. Delegates the digit parsing to bignum.
fn from_str(s: string) -> Decimal:
    n := len(s)
    point := 0 - 1
    i := 0
    for i < n and point < 0:
        if s[i] == 46:                 # '.'
            point = i
        i = i + 1
    if point < 0:
        return Decimal(bignum.from_str(s), 0)
    coeffstr := substr(s, 0, point) + substr(s, point + 1, n)   # drop the '.'
    sc := n - point - 1                # digits after the point
    return Decimal(bignum.from_str(coeffstr), sc)

# Why from_str_checked refused. from_str above stays LAX and unchanged, so no
# caller moves -- the same split core:strings has between parse_int and
# parse_int_checked.
enum DecErr:
    Empty                  # ""
    NoDigits               # a sign or a point with no digit: "-", ".", "+."
    TwoPoints              # "1.2.3"
    Garbage                # anything outside [-|+]digits[.digits]

fn err_str(e: DecErr) -> string:
    if e is Empty:
        return "empty input"
    if e is NoDigits:
        return "no digits"
    if e is TwoPoints:
        return "more than one decimal point"
    return "unexpected character"

# The STRICT sibling of from_str, for a decimal read out of a file or a wire
# format. from_str fails open and, unlike parse_int, does not fail to 0 -- it
# returns a plausible WRONG NUMBER, because the scale counts the garbage as a
# digit position: "1.5x" is coefficient 15 at scale 2, i.e. 0.15, and "1.2.3" is
# 0.012. For the type this package exists to make exact, that is the worst
# failure it could have. Accepts exactly `[-|+]digits[.digits]` and nothing else
# -- no exponent, no spaces, no thousands separator.
fn from_str_checked(s: string) -> Result(Decimal, DecErr):
    n := len(s)
    if n == 0:
        return Err(Empty)
    i := 0
    if s[0] == 45 or s[0] == 43:       # '-' or '+'
        i = 1
    digits := 0
    points := 0
    j := i
    for j < n:
        c := s[j]
        if c == 46:                    # '.'
            points = points + 1
        elif c >= 48 and c <= 57:
            digits = digits + 1
        else:
            return Err(Garbage)
        j = j + 1
    if points > 1:
        return Err(TwoPoints)
    if digits == 0:
        return Err(NoDigits)
    return Ok(from_str(s))

fn neg(a: Decimal) -> Decimal:
    return Decimal(bignum.neg(a.coeff), a.scale)

fn abs(a: Decimal) -> Decimal:
    return Decimal(bignum.abs(a.coeff), a.scale)

fn is_zero(a: Decimal) -> bool:
    return bignum.is_zero(a.coeff)

# Align both to the larger scale, then add the coefficients (exact).
fn add(a: Decimal, b: Decimal) -> Decimal:
    s := a.scale
    if b.scale > s:
        s = b.scale
    ca := scale_up(a.coeff, s - a.scale)
    cb := scale_up(b.coeff, s - b.scale)
    return Decimal(bignum.add(ca, cb), s)

fn sub(a: Decimal, b: Decimal) -> Decimal:
    return add(a, neg(b))

# Coefficients multiply; scales add -- exact, no rounding.
fn mul(a: Decimal, b: Decimal) -> Decimal:
    return Decimal(bignum.mul(a.coeff, b.coeff), a.scale + b.scale)

# Total order by value: -1 / 0 / 1. Aligns scales first, so 1.5 == 1.50.
fn cmp(a: Decimal, b: Decimal) -> int:
    s := a.scale
    if b.scale > s:
        s = b.scale
    ca := scale_up(a.coeff, s - a.scale)
    cb := scale_up(b.coeff, s - b.scale)
    return bignum.cmp(ca, cb)

# Change the scale. Increasing is exact (append zeros); decreasing TRUNCATES toward
# zero (the extra digits are dropped, not rounded).
fn rescale(a: Decimal, newscale: int) -> Decimal:
    if newscale == a.scale:
        return a
    if newscale > a.scale:
        return Decimal(scale_up(a.coeff, newscale - a.scale), newscale)
    factor := bignum.pow(bignum.from_int(10), a.scale - newscale)
    return Decimal(bignum.div(a.coeff, factor), newscale)

# ---- division --------------------------------------------------------------

# Rounding modes for `div`. There is no default -- the caller names one.
const HALF_UP = 0        # ties away from zero: 0.5 -> 1, -0.5 -> -1
const TOWARD_ZERO = 1    # drop the remainder; agrees with `rescale`, which also truncates

# A `const` does not cross a package boundary here (`decimal.HALF_UP` is "package
# 'decimal' has no variant 'HALF_UP'"), so the two modes are also readable as calls
# -- that is what a caller in another package writes.
fn half_up() -> int:
    return HALF_UP

fn toward_zero() -> int:
    return TOWARD_ZERO

# Why `div` refuses. DivByZero is an Err and not an abort because a caller
# dividing values it read from a file has to be able to report the row.
enum DivErr:
    DivByZero
    BadScale(int)        # a negative target scale
    BadMode(int)         # a mode that is neither HALF_UP nor TOWARD_ZERO

# a/b at exactly `scale` fractional digits, rounded by `mode`.
#
# a/b == (ca * 10^-sa) / (cb * 10^-sb), so the coefficient wanted at `scale` is
# ca * 10^(sb+scale) / (cb * 10^sa) -- one bignum long division, no float. Both
# sides are taken as magnitudes so the rounding question is only ever "is the
# remainder past half", and the sign is reapplied to the finished quotient.
fn div(a: Decimal, b: Decimal, scale: int, mode: int) -> Result(Decimal, DivErr):
    if bignum.is_zero(b.coeff):
        return Err(DivByZero)
    if scale < 0:
        return Err(BadScale(scale))
    if mode != HALF_UP and mode != TOWARD_ZERO:
        return Err(BadMode(mode))
    num := bignum.abs(scale_up(a.coeff, b.scale + scale))
    den := bignum.abs(scale_up(b.coeff, a.scale))
    q, r := bignum.divmod(num, den)
    if mode == HALF_UP:
        if bignum.cmp(bignum.mul(r, bignum.from_int(2)), den) >= 0:
            q = bignum.add(q, bignum.from_int(1))
    zero := bignum.from_int(0)
    aneg := bignum.cmp(a.coeff, zero) < 0
    bneg := bignum.cmp(b.coeff, zero) < 0
    if aneg != bneg:
        q = bignum.neg(q)
    return Ok(Decimal(q, scale))

# "[-]int[.frac]", frac left-zero-padded to `scale`. The stored scale is shown, so a
# value at scale 2 always prints two fractional digits (e.g. "1.50", "0.00").
fn to_str(a: Decimal) -> string:
    mag := bignum.to_str(bignum.abs(a.coeff))     # magnitude digits ("0" or positive)
    sign := ""
    if bignum.cmp(a.coeff, bignum.from_int(0)) < 0:
        sign = "-"
    if a.scale <= 0:
        return sign + mag
    nd := len(mag)
    if nd > a.scale:
        return sign + substr(mag, 0, nd - a.scale) + "." + substr(mag, nd - a.scale, nd)
    frac := mag                                   # fewer digits than the scale -> "0.<pad>mag"
    for len(frac) < a.scale:
        frac = "0" + frac
    return sign + "0." + frac
