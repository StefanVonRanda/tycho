# corelib: command-line argument parsing. Pure string math -- no FFI. Import with
# `import "core:cli"`, parse with `cli.parse(argv)`.
#
# parse(argv) sorts a raw argument vector into three buckets:
#   - options     `--key=value`             -> (key, value) pairs   (cli.get)
#   - flags       `--flag`, `-f`, `-abc`     -> boolean presence     (cli.flag)
#   - positional  everything else + all args after a bare `--`       (cli.positionals)
#
# In `parse`, values are ALWAYS attached with `=` (`--out=file`), so the parser
# needs no schema of which options take a value: `--verbose` is unambiguously a
# flag and `--out=x` unambiguously an option. A short cluster `-abc` sets flags
# a, b, c. A lone `-` is a positional (the stdin convention). `--` ends option
# parsing; every argument after it is positional even if it looks like an option.
#
# `parse_spec(argv, valued, boolean)` is the SCHEMA-CARRYING form, added because
# `--root DIR` -- the conventional Unix spelling -- cannot be recognised without
# knowing that `--root` takes a value. It is an ADDITION, not a replacement: the
# schema-free design decision above is what `parse` still is, unchanged, and
# every `=`-attached spelling means exactly the same thing in both. See
# `parse_spec` for the full rule table.
#
# The argv you pass is your program's own arguments -- do NOT include argv[0]
# (the program name). `cli.argv()` is exactly that vector, so the whole of a
# program's front door is `c := cli.parse(cli.argv())`.
package cli

struct Cli:
    keys: [string]        # option names, parallel to vals
    vals: [string]        # option values, parallel to keys
    flags: [string]       # flag names present (long and short)
    positional: [string]  # positional arguments, in order
    noval: [string]       # parse_spec: valued options that ran out of argv  (cli.missing)
    unk: [string]         # parse_spec: tokens the schema does not name       (cli.unknown)

# Your program's own arguments: the builtin `args()` with `args()[0]` -- the
# program path -- dropped, which is exactly what `parse` wants. This is a
# separate function rather than a skip inside `parse` on purpose: `parse` is a
# pure function over a vector, and the two consumers in this tree that build a
# synthetic argv (`corelib/test/cli/main.ty:14`, `examples/corelib/cli/main.ty:14`)
# have no program name in it, so a `parse` that dropped element 0 would silently
# eat their first real option. `args()[1:]` inline is the same thing.
fn argv() -> [string]:
    a := args()
    return a[1:len(a)]

# `--` prefix test (a long option or long flag).
fn is_long(s: string) -> bool:
    return len(s) >= 2 and s[0] == 45 and s[1] == 45

# a single-dash short cluster like `-v` or `-abc` (but not `-` alone).
fn is_short(s: string) -> bool:
    return len(s) >= 2 and s[0] == 45 and s[1] != 45

# Is `s` in `xs`? The schema lists are short (a handful of option names), so a
# linear scan is the right shape -- same reason the Cli itself is parallel arrays.
fn in_list(xs: [string], s: string) -> bool:
    for i := 0; i < len(xs); i += 1:
        if xs[i] == s:
            return true
    return false

# A schema entry with its dashes still on. The names here are matched against a
# token that has ALREADY had its "--" stripped, so `["--out"]` matched nothing and
# every value silently fell back to the caller's default -- found by tycho-snap
# (FRICTION #29), where a dashed schema gave `get=[DEFAULT]` with the tokens
# parked in `unknown()` that nothing forces you to read. Accepting both spellings
# cannot change an existing caller's behaviour: an entry beginning with "--" could
# not match any token before this line existed.
fn undash(s: string) -> string:
    if len(s) > 2 and s[0] == 45 and s[1] == 45:      # "--name"
        return s[2:len(s)]
    if len(s) == 2 and s[0] == 45:                    # "-f", a short flag
        return s[1:len(s)]
    return s

fn undash_all(xs: [string]) -> [string]:
    out := []string
    for x in xs:
        push(out, undash(x))
    return out

# The one parse loop. `strict` selects which of the two public entry points is
# calling: false = `parse` (schema-free, every unrecognised `--x` is a flag),
# true = `parse_spec` (schema-carrying, an unrecognised token is recorded).
fn parse_into(av_in: [string], valued_in: [string], boolean_in: [string], strict: bool) -> Cli:
    av := av_in
    valued := undash_all(valued_in)
    boolean := undash_all(boolean_in)
    keys := []string
    vals := []string
    flags := []string
    pos := []string
    noval := []string
    unk := []string
    n := len(av)
    only_pos := false
    i := 0
    for i < n:
        a := av[i]
        step := 1
        if only_pos:
            push(pos, a)
        elif a == "--":
            only_pos = true                     # end of options; `--` itself vanishes
        elif is_long(a):
            body := a[2:len(a)]                 # strip the leading "--"
            eq := find(body, "=")
            if eq >= 0:
                name := body[0:eq]
                if in_list(boolean, name):
                    push(flags, name)           # `--quiet=1`: a flag is a flag, value dropped
                elif not strict or in_list(valued, name):
                    push(keys, name)
                    push(vals, body[eq + 1:len(body)])
                else:
                    push(unk, a)
            elif in_list(valued, body):
                # `--root DIR`. The next argument is taken WHATEVER it looks like,
                # which is getopt's rule: `--root --port` sets root to "--port".
                # A schema cannot tell a missing value from a wrong one, and
                # guessing would make `--root -1` unspellable.
                if i + 1 >= n:
                    push(noval, a)
                else:
                    push(keys, body)
                    push(vals, av[i + 1])
                    step = 2
            elif not strict or in_list(boolean, body):
                push(flags, body)               # `--verbose`
            else:
                push(unk, a)
        elif is_short(a):
            bad := false
            for j := 1; j < len(a); j += 1:
                if strict and not in_list(boolean, chr(a[j])):
                    bad = true
            if bad:
                push(unk, a)                    # the whole cluster, as written
            else:
                for k := 1; k < len(a); k += 1:      # `-abc` -> a, b, c
                    push(flags, chr(a[k]))
        else:
            push(pos, a)                        # positional, incl. a lone "-"
        i += step
    return Cli(keys, vals, flags, pos, noval, unk)

# Parse an argument vector into a Cli. Schema-free: values must be `=`-attached.
fn parse(av: [string]) -> Cli:
    return parse_into(av, []string, []string, false)

# Why a `Result` and not a `die`: a typo'd option is INPUT, not a programmer
# error, so it is the caller's to report -- corelib dies only for a use-after-free
# (`corelib/pool/pool.ty@get`). What this shape buys is that the caller cannot
# forget: `parse_spec` records an unknown token in `unknown(c)` and returns a
# perfectly usable `Cli`, so a program that never asks runs on defaults with no
# sign anything was wrong (FRICTION #29's residue -- `tools/tycho-kvsrv` was
# exactly that program until 2026-08-14). A `Result` has to be matched.
enum CliErr:
    Unknown(string)        # a token the schema does not name, as written
    NoValue(string)        # a valued option with nothing after it

# `parse_spec` with the check built in: Err on the FIRST offending token, Ok on a
# clean parse. Same rule table, same buckets -- this only refuses to hand back a
# Cli that has something in `unknown` or `missing`.
fn parse_checked(av: [string], valued: [string], boolean: [string]) -> Result(Cli, CliErr):
    c := parse_spec(av, valued, boolean)
    u := unknown(c)
    if len(u) > 0:
        return Err(Unknown(u[0]))
    m := missing(c)
    if len(m) > 0:
        return Err(NoValue(m[0]))
    return Ok(c)

# Parse with a schema, which buys the space-separated spelling `--root DIR`.
# `valued` and `boolean` name LONG options and short flag letters WITHOUT their
# dashes -- the same spelling `get`/`flag` take. The full rule table:
#
#   `--name=v`,  name in valued   -> option (key `name`, value `v`)
#   `--name v`,  name in valued   -> option; the next argument is consumed as-is
#   `--name`,    name in valued, nothing after it -> recorded in `missing(c)`
#   `--name`,    name in boolean  -> flag
#   `--name=v`,  name in boolean  -> flag; `v` is DROPPED, because a boolean has
#                                    no value to carry. (`--quiet=1` sets quiet.)
#   `--name`/`--name=v`, name in neither -> recorded in `unknown(c)`, as written
#   `-abc`, every letter in boolean       -> flags a, b, c
#   `-abc`, any letter not in boolean     -> the whole cluster in `unknown(c)`
#   `-`                                   -> positional (the stdin convention)
#   `--`                                  -> ends option parsing and vanishes
#   anything else                         -> positional
#
# Nothing here reads a value for a SHORT option: `-p 80` is not a spelling this
# package has, and adding it would make `-abc` ambiguous. Use `--port 80`.
fn parse_spec(av: [string], valued: [string], boolean: [string]) -> Cli:
    return parse_into(av, valued, boolean, true)

# The value of option `key`, or `dflt` if it was not supplied. Last one wins if
# an option is repeated.
fn get(c: Cli, key_in: string, dflt: string) -> string:
    key := undash(key_in)          # `get(c, "--out", ...)` reads the same as `get(c, "out", ...)`
    out := dflt
    for i := 0; i < len(c.keys); i += 1:
        if c.keys[i] == key:
            out = c.vals[i]
    return out

# Was OPTION `key` -- a `--key=value` -- supplied at all?
#
# READ THE WORD "OPTION". This scans `c.keys` only, so a BARE `--key` is NOT here:
# it landed in `c.flags` (see the bucket table in this file's header) and `flag(c,
# key)` is the predicate for it. `has(c, "stats")` on a command line of `--stats`
# returns FALSE, and nothing can diagnose that -- both spellings compile, both
# return `bool`, and the only symptom is a branch that silently does not run.
#
# The name was kept rather than narrowed to `has_value` (FRICTION.md item 12,
# closed 2026-07-31 as working-as-intended). A rename moves the guess rather than
# removing it: the caller asking "did the user supply --stats?" would still have to
# pick between `has_value` and `flag`, and `has` is already the name in
# docs/guides/corelib.md. The fix for the trap is this paragraph, not a new symbol.
# If you want ONE call that answers "supplied in any spelling", write
# `cli.has(c, k) || cli.flag(c, k)` at the call site -- deliberately not a corelib
# function, because a caller that cannot say which of the two it means usually has
# a schema question (`parse_spec`) rather than a lookup question.
fn has(c: Cli, key_in: string) -> bool:
    key := undash(key_in)          # same both-spellings rule as `get`
    for i := 0; i < len(c.keys); i += 1:
        if c.keys[i] == key:
            return true
    return false

# Was flag `name` present? Long (`--name`) and short (`-n` -> name "n") both count.
fn flag(c: Cli, name_in: string) -> bool:
    name := undash(name_in)        # same both-spellings rule as `get`
    for i := 0; i < len(c.flags); i += 1:
        if c.flags[i] == name:
            return true
    return false

# The positional arguments, in the order they appeared.
fn positionals(c: Cli) -> [string]:
    return c.positional

# How many positionals were parsed.
fn count(c: Cli) -> int:
    return len(c.positional)

# `parse_spec` only: valued options written with no value after them, as written
# (`--port`). Empty from `parse`, which cannot have the condition.
fn missing(c: Cli) -> [string]:
    return c.noval

# `parse_spec` only: tokens the schema does not name, as written (`--bogus`,
# `--bogus=1`, `-x`). Empty from `parse`, which accepts every option name.
fn unknown(c: Cli) -> [string]:
    return c.unk
