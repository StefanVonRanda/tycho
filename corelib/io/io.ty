# corelib: filesystem I/O helpers. Import with `import "core:io"`, e.g.
# `io.read(path)` / `io.write(path, s)`. Thin, composable wrappers over the
# read_file / write_file / list_dir builtins, plus the line- and
# directory-oriented helpers those builtins don't provide directly.
#
# This is the first corelib module to COMPOSE other core modules: it imports
# core:strings (line splitting) and core:path (dir/base for `exists`).
#
# For large inputs it also provides a BOUNDED-MEMORY streaming line reader
# (open_lines / read_line / close_lines, and a fold_lines convenience) over a
# tiny libc getline shim (io_shim.c) -- unlike read_lines, which slurps the whole
# file into an array.
#
# ERROR MODEL. `read_bytes` returns `Result(bytes, io.IoErr)`: an empty file is
# Ok(empty), a missing path is Err(NotFound) and a directory is Err(IsDir). Until
# 2026-07-26 all three were the same empty `bytes`, which is how a static file
# server ends up answering a 0-byte 200 for a path it cannot serve (FRICTION.md,
# phase 7; plan.md phase 2).
#
# The rest of the module still matches the builtins' sentinels, deliberately:
# `read` is "" for a missing/unreadable file (indistinguishable from an empty
# one), `write`/`append`/`write_lines` return false if the path can't be opened,
# and `list` is [] for anything that is not a directory. Those sentinels have ONE
# meaning each on the write side. `list`'s ambiguity (an empty directory vs a
# non-directory) was never a return-type problem: it is a missing stat(2), and
# since 2026-07-26 the stat is here -- ask `is_dir(p)`, not `len(list(p)) > 0`
# (plan.md phase 4). `make_dir` / `remove` (2026-07-26, plan.md phase 5) also
# return a `Result`, for the same reason `read_bytes` does: their failures are
# ambiguous. Nothing here aborts.
package io
import "core:strings"
import "core:path"

# Why a file could not be read. Every variant is payload-free, so both spellings
# work on it: `==` for a caller who wants a one-line test, and a nested pattern
# (`Err(io.IsDir):`, since plan.md phase 3) for one already writing a `match`.
# Payload-free is KEPT: giving a variant a payload would break every `==` call site
# in the tree, and nothing here needs to say "how much".
enum IoErr:
    NotFound           # no such path
    IsDir              # the path names a directory, not a file
    Exists             # something is already there, and it is NOT a directory
                       # (make_dir only -- see make_dir for why it needs its own
                       # variant instead of folding into Failed)
    Failed             # the path exists but could not be read (permissions, ...)

# Whole file as a string ("" if missing/unreadable -- same as an empty file).
fn read(p: string) -> string:
    return read_file(p)

# Truncate `p` and write `s`. Returns false if the path can't be opened.
fn write(p: string, s: string) -> bool:
    return write_file(p, s)

# Append `s` to `p` (creating it if absent). Reads the whole file and rewrites
# it -- NOT atomic, and the file is held in memory; fine for small files.
fn append(p: string, s: string) -> bool:
    return write_file(p, read_file(p) + s)

# File split into lines (core:strings.lines: CRLF-aware, a trailing newline
# adds no empty line). A missing file yields one empty line, like lines("").
fn read_lines(p: string) -> [string]:
    return strings.lines(read_file(p))

# Write each line followed by '\n' (so the file ends with a newline). The
# inverse of read_lines for newline-terminated files.
fn write_lines(p: string, lines: [string]) -> bool:
    out := ""
    for i in range(len(lines)):
        out = out + lines[i] + "\n"
    return write_file(p, out)

# ---- streaming line reader (shim: libc getline, in io_shim.c) ---------------
# read_lines() above slurps the WHOLE file into an array, so peak memory tracks
# the file size. This reader pulls ONE line at a time into a single reused
# buffer, so peak memory is O(longest line) -- the right tool for a large log.
extern fn iox_open_lines(path: string) -> ptr        # null if the path can't be opened
extern fn iox_read_line(r: ptr) -> Option(string)    # next line (no trailing newline/CRLF); None at EOF
extern fn iox_close_lines(r: ptr)
# `status` is the read classification: 0 missing, 1 read, 2 directory, 3 other
# error. It is an `inout int`, which lowers to a tycho_int* out-param ahead of the
# two out-params the `bytes` return uses -- see the block comment on iox_read_file
# in io_shim.c.
extern fn iox_read_file(path: string, status: inout int) -> bytes
# stat(2): the same status codes, with 1 meaning "exists and is not a directory".
# A plain scalar return -- no `inout` needed, because nothing else occupies it.
extern fn iox_stat_kind(path: string) -> int
# mkdir(2) / remove(3), one entry each, in the same code space (plus FS_EXISTS).
extern fn iox_make_dir(path: string) -> int
extern fn iox_remove(path: string) -> int

# The shim's read_file status codes, named once so read_bytes reads as prose.
const RF_MISS = 0
const RF_OK   = 1
const RF_DIR  = 2
# make_dir only: occupied by a non-directory. See iox_make_dir in io_shim.c.
const FS_EXISTS = 4

# Read the whole file as raw bytes -- interior NUL bytes are preserved (unlike
# read(), whose string truncates at the first NUL). The right tool for binary
# assets (images, fonts, ...).
#
# Ok(b) on success, and an EMPTY FILE is Ok with len(b) == 0 -- a real success
# value, now distinct from Err(NotFound) and Err(IsDir). Those three were one
# value (empty `bytes`) before 2026-07-26.
fn read_bytes(p: string) -> Result(bytes, IoErr):
    st := 0
    b := iox_read_file(p, &st)
    if st == RF_OK:
        return Ok(b)
    if st == RF_MISS:
        return Err(NotFound)
    if st == RF_DIR:
        return Err(IsDir)
    return Err(Failed)

# Is `p` a directory? Ok(true) for a directory, Ok(false) for something that
# exists and is not one (a file, a fifo, a symlink to any of those -- stat(2)
# follows links, so a symlink to a directory answers Ok(true)). Err(NotFound) if
# nothing is there, Err(Failed) if it is there but unstattable (no search
# permission on a parent, a symlink loop, ...).
#
# Note which variant is ABSENT: IsDir is not an error here, it is Ok(true). Being
# a directory is the answer this function exists to give, not a failure to give
# one -- the same enum, used for its other two variants.
#
# This replaces the only directory test the corelib used to offer,
# `len(io.list(p)) > 0`, which reports an EMPTY DIRECTORY AS A FILE. That was a
# documented wrong answer in a real server (a redirect withheld for
# /emptydir; FRICTION.md phase 7, plan.md phase 4) and it was never fixable by a
# return type -- stat(2) is the missing question, not the missing answer.
fn is_dir(p: string) -> Result(bool, IoErr):
    k := iox_stat_kind(p)
    if k == RF_DIR:
        return Ok(true)
    if k == RF_OK:
        return Ok(false)
    if k == RF_MISS:
        return Err(NotFound)
    return Err(Failed)

# Create the single directory `p` (mode 0777 & ~umask). NOT `mkdir -p`: a missing
# parent is Err(NotFound), not a tree to build.
#
#   Ok(true)        created it
#   Ok(false)       it was already a directory -- nothing to do, goal already holds
#   Err(Exists)     something else is there (a file, a fifo, ...)
#   Err(NotFound)   a path component above it does not exist
#   Err(Failed)     it could not be created (permissions, read-only fs, ...)
#
# WHY A Result AND NOT A bool. Phase 1's rule is that a sentinel earns a Result
# only when it is AMBIGUOUS -- when one failure value means several things the
# caller must act on differently. `false` here would mean four things, and two of
# them are opposites: EEXIST-on-a-directory is the caller's goal ALREADY MET,
# while EEXIST-on-a-file, ENOENT and EACCES are all "you will not get it". A
# bool caller has to re-derive that with is_dir(p) after every failed make_dir,
# which is the sentinel-collision shape this plan exists to remove. So the split
# is not decoration: it is the difference between "done" and "give up", and it is
# free -- mkdir already returns EEXIST and stat already answers who is in the way.
#
# Note the Ok(bool) shape, same as is_dir's: BOTH booleans are successes. `true`
# is "I changed the filesystem", `false` is "it was already how you asked for it".
fn make_dir(p: string) -> Result(bool, IoErr):
    k := iox_make_dir(p)
    if k == RF_OK:
        return Ok(true)
    if k == RF_DIR:
        return Ok(false)
    if k == FS_EXISTS:
        return Err(Exists)
    if k == RF_MISS:
        return Err(NotFound)
    return Err(Failed)

# Remove ONE entry: a file (unlink) or an EMPTY directory (rmdir). Not recursive.
#
#   Ok(true)        it was there and is gone
#   Ok(false)       nothing was there -- "make it not exist" already holds
#   Err(Failed)     it is there and would not go: a NON-EMPTY directory, no write
#                   permission on the parent, a sticky parent you do not own, ...
#
# Same reasoning as make_dir: a bool `false` would conflate "already absent" (the
# goal) with "non-empty directory" (a bug in the caller's cleanup order) and with
# "permission denied", which are three different next moves. Ok(false) for a
# missing path is the deliberate half of that -- deleting nothing is not a
# failure, so a cleanup path does not need a match at all.
#
# There is no recursive variant on purpose. Err(Failed) on a non-empty directory
# is what stops this from being `rm -rf` behind a corelib name; a caller that
# wants a tree gone removes what it made, in order (corelib/test/io does).
fn remove(p: string) -> Result(bool, IoErr):
    k := iox_remove(p)
    if k == RF_OK:
        return Ok(true)
    if k == RF_MISS:
        return Ok(false)
    return Err(Failed)

# Open a streaming line reader over `path`. Returns a null ptr (check is_null) if
# the file can't be opened. Pair every successful open with close_lines(r).
fn open_lines(path: string) -> ptr:
    return iox_open_lines(path)

# The next line, without its trailing newline (or CRLF), or None at end of file.
# An empty line is Some("") -- distinct from EOF's None.
fn read_line(r: ptr) -> Option(string):
    return iox_read_line(r)

# Close a reader opened with open_lines (frees the file handle + line buffer).
fn close_lines(r: ptr):
    iox_close_lines(r)

# Bounded-memory streaming fold: reduce every line of `path` into `init` via
# f(acc, line), one line at a time (peak memory O(longest line), not O(file)).
# Best for scalar / small accumulators -- a large heap accumulator copied per
# line is O(n^2); for that, use an open_lines/read_line loop that mutates in
# place. A path that can't be opened folds to `init` unchanged.
fn fold_lines(path: string, init: $A, f: fn($A, string) -> $A) -> $A:
    r := iox_open_lines(path)
    acc := init
    if is_null(r):
        return acc
    done := false
    for not done:
        match iox_read_line(r):
            Some(line):
                acc = f(acc, line)
            None:
                done = true
    iox_close_lines(r)
    return acc

# Directory entry names (basenames, not full paths); [] if not a directory.
fn list(p: string) -> [string]:
    return list_dir(p)

# True if `p` names an existing entry. There is no file-exists builtin, so this
# lists the parent directory and checks membership -- O(entries in the parent),
# and it can't see through a `.`/`..`-only leaf. Good enough for the common case.
fn exists(p: string) -> bool:
    leaf := path.base(p)
    entries := list_dir(path.dir(p))
    for e in entries:
        if e == leaf:
            return true
    return false
