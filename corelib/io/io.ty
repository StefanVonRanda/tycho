# corelib: filesystem I/O helpers. Import with `import "core:io"`, e.g.
# `io.read(path)` / `io.write(path, s)`. Thin, composable wrappers over the
# read_file / write_file / list_dir builtins, plus the line- and
# directory-oriented helpers those builtins don't provide directly.
#
# This is the first corelib module to COMPOSE other core modules: it imports
# core:strings (line splitting). It also imported core:path, for the dir/base pair
# the old list-the-parent `exists` needed; the stat(2)-backed `exists` needs
# neither, so that dependency is gone (2026-07-26, the friction plan).
#
# For large inputs it also provides a BOUNDED-MEMORY streaming line reader
# (open_lines / read_line / close_lines, and a fold_lines convenience) over a
# tiny libc getline shim (io_shim.c) -- unlike read_lines, which slurps the whole
# file into an array.
#
# ERROR MODEL. `read_bytes` returns `Result(bytes, io.IoErr)`: an empty file is
# Ok(empty), a missing path is Err(NotFound) and a directory is Err(IsDir). Until
# 2026-07-26 all three were the same empty `bytes`, which is how a static file
# server ends up answering a 0-byte 200 for a path it cannot serve (FRICTION.md,
# phase 7; the option-result plan).
#
# The rest of the module still matches the builtins' sentinels, deliberately:
# `read` is "" for a missing/unreadable file (indistinguishable from an empty
# one), `write`/`append`/`write_lines` return false if the path can't be opened,
# and `list` is [] for anything that is not a directory. Those sentinels have ONE
# meaning each on the write side. `list`'s ambiguity (an empty directory vs a
# non-directory) was never a return-type problem: it is a missing stat(2), and
# since 2026-07-26 the stat is here -- ask `is_dir(p)`, not `len(list(p)) > 0`
# (the option-result plan). `make_dir` / `remove` (2026-07-26, the option-result plan) also
# return a `Result`, for the same reason `read_bytes` does: their failures are
# ambiguous. Nothing here aborts.
#
# DURABILITY. Every writer here returns once close(2) succeeded -- page cache,
# not platter. That survives the process dying, not the machine. `sync` (2026-08-12)
# is the one call that reaches the device, and a durable CREATE needs it twice:
# once on the file, once on the parent directory. See sync.
package io
import "core:strings"

# Why a file could not be read. Every variant is payload-free, so both spellings
# work on it: `==` for a caller who wants a one-line test, and a nested pattern
# (`Err(io.IsDir):`, since the friction plan) for one already writing a `match`.
# Payload-free is KEPT: giving a variant a payload would break every `==` call site
# in the tree, and nothing here needs to say "how much".
enum IoErr:
    NotFound           # no such path
    IsDir              # the path names a directory, not a file
    Exists             # something is already there, and it is NOT a directory
                       # (make_dir only -- see make_dir for why it needs its own
                       # variant instead of folding into Failed)
    Failed             # the path exists but could not be read (permissions, ...)
    Unsupported        # the operation has no implementation for this object on
                       # this platform/filesystem (sync only -- see sync for why
                       # this cannot be Failed)

# Whole file as a string. FAIL-OPEN: "" for a missing or unreadable file, which
# is indistinguishable from a genuinely empty one. Prefer read_text below when
# the difference matters -- which is most of the time.
fn read(p: string) -> string:
    return read_file(p)

# Whole file as a string, WITH the error channel read() lacks: Ok("") is a real
# empty file, Err says why there is nothing. Same three causes read_bytes
# reports, since it is read_bytes with the buffer reinterpreted -- a zero-cost
# cast of the same length-headered bytes, not a copy or a re-encode.
#
#   Ok(s)           the read happened; len(s) may be 0 for an empty file
#   Err(NotFound)   nothing is there
#   Err(IsDir)      the path names a directory
#   Err(Failed)     it exists but could not be read
fn read_text(p: string) -> Result(string, IoErr):
    b := read_bytes(p) or_return
    return Ok(to_str(b))

fn write_bytes(p: string, b: bytes) -> Result(bool, IoErr):
    st := 0
    iox_write_bytes(p, b, &st)
    if st == RF_OK:
        return Ok(true)
    if st == RF_MISS:
        return Err(NotFound)
    if st == RF_DIR:
        return Err(IsDir)
    return Err(Failed)

# Write `b` at byte offset `off` of `p`, leaving the rest of the file alone.
# NOT truncating: bytes after the write are untouched, so in-place page
# updates work. Created if absent (like write_bytes), so a store's first
# flush can lay down the file. The sibling of
# read_at -- the read side has had positional access since the beginning; the
# write side stopped at whole-file write_bytes until the tycho-kv store
# (docs/internals/plan-tycho-kv-DONE.md phase 1) needed to update pages in
# place. Same fail-closed discipline
# as write_bytes: a partial write is an error, never a silent short write.
fn write_at(p: string, off: int, b: bytes) -> Result(bool, IoErr):
    st := 0
    iox_write_at(p, off, b, &st)
    if st == RF_OK:
        return Ok(true)
    if st == RF_MISS:
        return Err(NotFound)
    if st == RF_DIR:
        return Err(IsDir)
    return Err(Failed)

# Truncate `p` and write `s`. Returns false if the path can't be opened.
fn write(p: string, s: string) -> bool:
    return write_file(p, s)

# Append `s` to `p` (creating it if absent). Reads the whole file and rewrites
# it -- NOT atomic, and the file is held in memory; fine for small files.
fn append(p: string, s: string) -> bool:
    return write_file(p, read_file(p) + s)

# File split into lines (core:strings.lines: CRLF-aware, a trailing newline
# adds no empty line). A missing file yields one empty line, like lines("").
fn read_lines(p: string) -> [string]:
    return strings.lines(read_file(p))

# Write each line followed by '\n' (so the file ends with a newline). The
# inverse of read_lines for newline-terminated files.
fn write_lines(p: string, lines: [string]) -> bool:
    out := ""
    for i := 0; i < len(lines); i += 1:
        out = out + lines[i] + "\n"
    return write_file(p, out)

# ---- streaming line reader (shim: libc getline, in io_shim.c) ---------------
# read_lines() above slurps the WHOLE file into an array, so peak memory tracks
# the file size. This reader pulls ONE line at a time into a single reused
# buffer, so peak memory is O(longest line) -- the right tool for a large log.
extern fn iox_open_lines(path: string) -> ptr        # null if the path can't be opened
extern fn iox_read_line(r: ptr) -> Option(string)    # next line (no trailing newline/CRLF); None at EOF
extern fn iox_close_lines(r: ptr)
# `status` is the read classification: 0 missing, 1 read, 2 directory, 3 other
# error. It is an `inout int`, which lowers to a tycho_int* out-param ahead of the
# two out-params the `bytes` return uses -- see the block comment on iox_read_file
# in io_shim.c.
extern fn iox_read_file(path: string, status: inout int) -> bytes
# pread(2) at an absolute offset -- the SAME FFI shape as iox_read_file, because it
# has the same halves to place. The rule that decides which half takes which slot
# is docs/spec/14-ffi.md §24.1.1, which states both arrangements: this is its
# `bytes`-payload case (a `bytes` payload cannot be an `inout`, so it takes the
# return), and iox_stat_mtime below is its mirror.
extern fn iox_read_at(path: string, off: int, n: int, status: inout int) -> bytes
# Write ALL of `b` to `path`, truncating it first -- the write side's mirror of
# iox_read_file: the same status code space, so write_bytes' Err answers match
# read_bytes' (NotFound/IsDir/Failed). All-or-nothing: a partial write is an
# error, never a short success.
extern fn iox_write_bytes(path: string, data: bytes, status: inout int)
extern fn iox_write_at(path: string, off: int, data: bytes, status: inout int)
# stat(2): the same status codes, with 1 meaning "exists and is not a directory".
# A plain scalar return -- no `inout` needed, because nothing else occupies it.
extern fn iox_stat_kind(path: string) -> int
# stat(2) again, for the field iox_stat_kind fetches and throws away. This is the
# MIRROR arrangement of docs/spec/14-ffi.md §24.1.1: the payload is a scalar, so it
# can cross as an `inout`, and the status keeps the return rather than sharing one
# integer's code space with an epoch second.
extern fn iox_stat_mtime(path: string, mtime: inout int) -> int
# utimensat(2): the write side of iox_stat_mtime, same status codes. No `inout` --
# the epoch second travels IN, so the return carries only the status.
extern fn iox_set_mtime(path: string, mtime: int) -> int
# stat(2) a third time, for st_size. Same shape as iox_stat_mtime -- a scalar
# payload in the `inout`, the status in the return -- but NOT the same directory
# answer: 2 (directory) is a real status here, not an Ok. See iox_stat_size in
# io_shim.c for why the two calls differ on that, and why this is a sibling
# rather than a second `inout` on iox_stat_mtime.
extern fn iox_stat_size(path: string, size: inout int) -> int
# mkdir(2) / remove(3), one entry each, in the same code space (plus FS_EXISTS).
extern fn iox_make_dir(path: string) -> int
extern fn iox_remove(path: string) -> int
# fsync(2), same code space plus FS_UNSUP. No `inout`: there is no payload, only
# a verdict, so the status keeps the return.
extern fn iox_sync(path: string) -> int

# The shim's read_file status codes, named once so read_bytes reads as prose.
const RF_MISS = 0
const RF_OK   = 1
const RF_DIR  = 2
# make_dir only: occupied by a non-directory. See iox_make_dir in io_shim.c.
const FS_EXISTS = 4
# sync only: it is there, and this platform cannot flush it. See iox_sync.
const FS_UNSUP = 5

# Read the whole file as raw bytes -- interior NUL bytes are preserved (unlike
# read(), which cannot report a failure). The right tool for binary assets
# (images, fonts, ...).
#
# This line used to say read()'s string "truncates at the first NUL". MEASURED
# 2026-08-10 and it does not: a 5-byte file `AB\0CD` read through read() has
# len 5 and digests identically to sha256sum. Tycho strings are length-headered
# and byte-safe. The real difference is the ERROR CHANNEL, below.
#
# Ok(b) on success, and an EMPTY FILE is Ok with len(b) == 0 -- a real success
# value, now distinct from Err(NotFound) and Err(IsDir). Those three were one
# value (empty `bytes`) before 2026-07-26.
fn read_bytes(p: string) -> Result(bytes, IoErr):
    st := 0
    b := iox_read_file(p, &st)
    if st == RF_OK:
        return Ok(b)
    if st == RF_MISS:
        return Err(NotFound)
    if st == RF_DIR:
        return Err(IsDir)
    return Err(Failed)

# Read AT MOST `n` bytes of `p` starting at absolute byte offset `off` -- pread(2),
# so no file position is disturbed and no handle is threaded through the caller.
# The point is that serving 1 KB of a 1 GB file no longer allocates 1 GB: before
# this, an offset read was expressible only as `read_bytes(p)[a:b]`, which reads
# the whole file first.
#
#   Ok(b)           the read happened; len(b) may be LESS than n, or 0
#   Err(NotFound)   nothing is there
#   Err(IsDir)      the path names a directory
#   Err(Failed)     it is there and could not be read, OR an argument was refused
#
# THE THREE BOUNDARIES, which are three different answers and not variations:
#
#   off PAST EOF is Ok with len(b) == 0, not an Err. That is pread(2)'s answer and
#   it is a complete one: the caller chose the offset, so an empty result here says
#   "there are no bytes there", unlike read_bytes' empty, which used to mean an
#   empty file OR a missing one OR a directory with no way to tell.
#
#   n RUNNING PAST EOF is a SHORT READ: Ok, with len(b) short of n and no padding.
#   `len(b)` is how the caller learns how much it got -- which is why this returns
#   a plain `bytes` and needs no separate count.
#
#   A NEGATIVE off OR n is Err(Failed), refused in the shim before open(2) so it
#   can never be sign-extended into a wild pread offset. Both are unreachable from
#   correct code -- a caller parsing a `Range:` header only ever produces digits --
#   so neither gets an IoErr variant of its own. Err(Failed) is the fail-closed
#   answer to "you asked for something that is not a read".
#
# n == 0 is Ok(empty): asking for nothing succeeds at giving nothing.
#
# THE ALLOCATION IS BOUNDED BY THE FILE, NOT BY n, and that is the property that
# makes this safe to hand a number off the wire. The shim fstats and allocates
# min(n, size - off), so `read_at(p, 0, 1000000000000)` on a 26-byte file allocates
# 26 bytes. See iox_read_at in io_shim.c for why no additional cap is imposed.
fn read_at(p: string, off: int, n: int) -> Result(bytes, IoErr):
    st := 0
    b := iox_read_at(p, off, n, &st)
    if st == RF_OK:
        return Ok(b)
    if st == RF_MISS:
        return Err(NotFound)
    if st == RF_DIR:
        return Err(IsDir)
    return Err(Failed)

# Is `p` a directory? Ok(true) for a directory, Ok(false) for something that
# exists and is not one (a file, a fifo, a symlink to any of those -- stat(2)
# follows links, so a symlink to a directory answers Ok(true)). Err(NotFound) if
# nothing is there, Err(Failed) if it is there but unstattable (no search
# permission on a parent, a symlink loop, ...).
#
# Note which variant is ABSENT: IsDir is not an error here, it is Ok(true). Being
# a directory is the answer this function exists to give, not a failure to give
# one -- the same enum, used for its other two variants.
#
# This replaces the only directory test the corelib used to offer,
# `len(io.list(p)) > 0`, which reports an EMPTY DIRECTORY AS A FILE. That was a
# documented wrong answer in a real server (a redirect withheld for
# /emptydir; FRICTION.md phase 7, the option-result plan) and it was never fixable by a
# return type -- stat(2) is the missing question, not the missing answer.
fn is_dir(p: string) -> Result(bool, IoErr):
    k := iox_stat_kind(p)
    if k == RF_DIR:
        return Ok(true)
    if k == RF_OK:
        return Ok(false)
    if k == RF_MISS:
        return Err(NotFound)
    return Err(Failed)

# When `p` was last modified, in whole seconds since the UNIX epoch -- the same
# clock `now()` reads, so `now() - mtime(p)` is an age in seconds and
# `datetime.from_unix` turns the value into a date directly.
#
#   Ok(secs)        stat(2) answered
#   Err(NotFound)   nothing is there
#   Err(Failed)     it is there and could not be stat'ed (no search permission on
#                   a parent, a symlink loop, ...)
#
# Note which variant is ABSENT, for the same reason it is absent from is_dir: a
# DIRECTORY IS Ok HERE, not Err(IsDir). A directory has a modification time and
# stat(2) reports it; refusing to pass it up would be this module throwing away a
# field the kernel already filled in, which is the exact defect this call exists
# to fix. Err(IsDir) belongs to read_bytes, where the request really is
# impossible to satisfy.
#
# WHOLE SECONDS. stat(2) carries nanoseconds on Linux and this drops them, on
# purpose: an HTTP-date is whole seconds, `now()` is whole seconds, and there is
# no caller in the tree that could use the rest. See iox_stat_mtime in
# io_shim.c for the note on adding it if one appears.
#
# This is one stat(2) per call and it does NOT share the one is_dir/exists makes.
# A caller doing both pays two; a conditional GET that answers 304 pays exactly
# this one and never opens the file.
fn mtime(p: string) -> Result(int, IoErr):
    secs := 0
    k := iox_stat_mtime(p, &secs)
    if k == RF_OK:
        return Ok(secs)
    if k == RF_MISS:
        return Err(NotFound)
    return Err(Failed)

# Set when `p` was last modified, in the same whole epoch seconds `mtime` reads
# back. This is what makes an mtime RESTORABLE: until it existed a program could
# record one into an archive and had no way to put it back, so every extracted
# file got the time it was written (FRICTION #8).
#
#   Ok(true)        the time is set; `mtime(p)` now returns `secs`
#   Err(NotFound)   nothing is there -- this does NOT create the file
#   Err(Failed)     it is there and the time could not be set (not the owner, a
#                   read-only mount, ...)
#
# A DIRECTORY IS Ok, exactly as it is for `mtime` above and for the same reason:
# a directory's modification time is a real field this module hands out, so
# refusing to hand it back would be asymmetric for no gain.
#
# THE ACCESS TIME IS NOT TOUCHED. See iox_set_mtime in io_shim.c -- the obvious
# utime(2) spelling would stamp both.
fn set_mtime(p: string, secs: int) -> Result(bool, IoErr):
    k := iox_set_mtime(p, secs)
    if k == RF_OK:
        return Ok(true)
    if k == RF_MISS:
        return Err(NotFound)
    return Err(Failed)

# How many bytes `p` holds, WITHOUT READING THEM. Until this existed the only way
# to ask was `len(read_bytes(p))`, which reads a gigabyte to learn that it is a
# gigabyte -- the same defect read_at above was added to remove, and a Range
# server built on it would allocate exactly what read_at stopped allocating.
#
#   Ok(n)           `p` is a regular file of n bytes
#   Err(NotFound)   nothing is there
#   Err(IsDir)      the path names a directory
#   Err(Failed)     it is there and has no byte length -- unstattable, or a fifo,
#                   socket or device
#
# Ok(0) IS A SUCCESS AND IT IS NOT THE FAILURE VALUE. An empty file has a length
# and that length is zero. The status rides the shim's return rather than the
# payload (see iox_stat_size in io_shim.c), so `0` is never what a failure looks
# like -- a failure is an Err and cannot be mistaken for a small file. This is the
# case a static server meets for real: a 0-byte asset must serve a 200 with
# `Content-Length: 0`, not a 500.
#
# A DIRECTORY IS Err(IsDir) HERE, WHICH IS THE OPPOSITE OF mtime ABOVE, and the
# difference is not an inconsistency. mtime returns Ok for a directory because a
# directory HAS a modification time and stat(2) reports the real one; refusing it
# would throw away an answer. st_size on a directory is not the answer to this
# question at all -- it is the size of the directory's own entry structure (4096
# on ext4, filesystem-dependent everywhere), not a count of readable bytes. So
# this is not withholding an answer, it is refusing to report a number that is not
# one. The test that settles it: size(p) is the length read_bytes(p) would return,
# and read_bytes on a directory is Err(IsDir) too. The two agree on every path.
#
# ONE stat(2), NOT SHARED with mtime's and not with read_at's fstat. A caller
# wanting size and mtime pays two; a caller wanting size and then a slice pays a
# stat and then a read, and it needs the size FIRST -- a 416 answer emits the
# length and reads nothing, and a suffix range needs the length to know where to
# start. See iox_stat_size in io_shim.c for the caller count behind the split.
fn size(p: string) -> Result(int, IoErr):
    n := 0
    k := iox_stat_size(p, &n)
    if k == RF_OK:
        return Ok(n)
    if k == RF_MISS:
        return Err(NotFound)
    if k == RF_DIR:
        return Err(IsDir)
    return Err(Failed)

# Create the single directory `p` (mode 0777 & ~umask). NOT `mkdir -p`: a missing
# parent is Err(NotFound), not a tree to build.
#
#   Ok(true)        created it
#   Ok(false)       it was already a directory -- nothing to do, goal already holds
#   Err(Exists)     something else is there (a file, a fifo, ...)
#   Err(NotFound)   a path component above it does not exist
#   Err(Failed)     it could not be created (permissions, read-only fs, ...)
#
# WHY A Result AND NOT A bool. Phase 1's rule is that a sentinel earns a Result
# only when it is AMBIGUOUS -- when one failure value means several things the
# caller must act on differently. `false` here would mean four things, and two of
# them are opposites: EEXIST-on-a-directory is the caller's goal ALREADY MET,
# while EEXIST-on-a-file, ENOENT and EACCES are all "you will not get it". A
# bool caller has to re-derive that with is_dir(p) after every failed make_dir,
# which is the sentinel-collision shape this plan exists to remove. So the split
# is not decoration: it is the difference between "done" and "give up", and it is
# free -- mkdir already returns EEXIST and stat already answers who is in the way.
#
# Note the Ok(bool) shape, same as is_dir's: BOTH booleans are successes. `true`
# is "I changed the filesystem", `false` is "it was already how you asked for it".
fn make_dir(p: string) -> Result(bool, IoErr):
    k := iox_make_dir(p)
    if k == RF_OK:
        return Ok(true)
    if k == RF_DIR:
        return Ok(false)
    if k == FS_EXISTS:
        return Err(Exists)
    if k == RF_MISS:
        return Err(NotFound)
    return Err(Failed)

# Remove ONE entry: a file (unlink) or an EMPTY directory (rmdir). Not recursive.
#
#   Ok(true)        it was there and is gone
#   Ok(false)       nothing was there -- "make it not exist" already holds
#   Err(Failed)     it is there and would not go: a NON-EMPTY directory, no write
#                   permission on the parent, a sticky parent you do not own, ...
#
# Same reasoning as make_dir: a bool `false` would conflate "already absent" (the
# goal) with "non-empty directory" (a bug in the caller's cleanup order) and with
# "permission denied", which are three different next moves. Ok(false) for a
# missing path is the deliberate half of that -- deleting nothing is not a
# failure, so a cleanup path does not need a match at all.
#
# There is no recursive variant on purpose. Err(Failed) on a non-empty directory
# is what stops this from being `rm -rf` behind a corelib name; a caller that
# wants a tree gone removes what it made, in order (corelib/test/io does).
fn remove(p: string) -> Result(bool, IoErr):
    k := iox_remove(p)
    if k == RF_OK:
        return Ok(true)
    if k == RF_MISS:
        return Ok(false)
    return Err(Failed)

# Flush `p` to the STORAGE DEVICE and return only once the kernel says it landed
# -- fsync(2). Every other writer in this module returns once close(2) succeeded,
# which reaches the page cache and stops: enough that a later process, including
# one started after a SIGKILL, reads the bytes, and NOT enough that they survive
# the machine losing power. This is the call that closes that gap.
#
#   Ok(true)          the device acknowledged the flush
#   Err(NotFound)     nothing is there
#   Err(Unsupported)  it is there and has no flush on this platform/filesystem
#   Err(Failed)       the flush was attempted and FAILED -- EIO, a dead device,
#                     ENOSPC on a delayed-allocation filesystem. THE WRITE IS
#                     LOST; this is not a retryable hiccup.
#
# A DIRECTORY IS Ok, NOT Err(IsDir), and that is the whole reason this signature
# takes a path rather than being bolted onto a writer. A file's CONTENTS and a
# file's NAME are two different pieces of disk. Syncing the file flushes the
# contents; the directory entry naming them is flushed only by syncing the PARENT
# DIRECTORY. Sync a freshly CREATED file and not its parent, and a power cut can
# hand back a file that does not exist -- data intact, unreachable. So a durable
# create is TWO calls, and this is both of them:
#
#   io.write_bytes(f, b) or_return
#   io.sync(f) or_return                 # the bytes
#   io.sync(path.dir(f)) or_return       # the NAME -- only needed on create
#
# The second sync is needed when the entry appears or disappears (create, remove,
# rename), not on every later write to a file that already exists -- which is why
# it is the caller's separate call and not a hidden syscall inside this one. An
# appending log pays it once and syncs only the file thereafter.
#
# WHY THIS, AND NOT A `write_bytes_synced(p, b)`. A bundled writer looked like the
# safer surface and is the more dangerous one, for three reasons that all point
# the same way. It does not fit the caller that demanded this: tycho-db's log
# appends with `write_at`, so a whole-file bundled call could not have served it,
# and bundling consistently would mean a synced twin of all five writers here
# rather than one orthogonal verb that composes with each. And -- decisively -- no
# name of that shape can carry the paragraph above: `write_bytes_synced` reads as
# "this is now durable" while the file's NAME may still not be, so it would ship
# the classic mistake with a label promising the opposite. One `sync` that makes
# the second call visible is the honest surface.
#
# Err(Unsupported) IS SEPARATE FROM Err(Failed) for make_dir's Exists reason: one
# failed syscall, two opposite next moves. Failed means the data is gone and a log
# that shrugs has already lied. Unsupported means the data is exactly where every
# other core:io writer leaves it and the platform has nothing stronger to offer,
# so a caller may fall back to the process-death guarantee AND SAY SO. Note what
# it is NOT: a silent Ok. A no-op reported as success would rebuild the same false
# durability claim one layer down, where nothing can see it.
fn sync(p: string) -> Result(bool, IoErr):
    k := iox_sync(p)
    if k == RF_OK:
        return Ok(true)
    if k == RF_MISS:
        return Err(NotFound)
    if k == FS_UNSUP:
        return Err(Unsupported)
    return Err(Failed)

# Open a streaming line reader over `path`. Returns a null ptr (check is_null) if
# the file can't be opened. Pair every successful open with close_lines(r).
fn open_lines(path: string) -> ptr:
    return iox_open_lines(path)

# The next line, without its trailing newline (or CRLF), or None at end of file.
# An empty line is Some("") -- distinct from EOF's None.
fn read_line(r: ptr) -> Option(string):
    return iox_read_line(r)

# Close a reader opened with open_lines (frees the file handle + line buffer).
fn close_lines(r: ptr):
    iox_close_lines(r)

# Bounded-memory streaming fold: reduce every line of `path` into `init` via
# f(acc, line), one line at a time (peak memory O(longest line), not O(file)).
# Best for scalar / small accumulators -- a large heap accumulator copied per
# line is O(n^2); for that, use an open_lines/read_line loop that mutates in
# place. A path that can't be opened folds to `init` unchanged.
fn fold_lines(path: string, init: $A, f: fn($A, string) -> $A) -> $A:
    r := iox_open_lines(path)
    acc := init
    if is_null(r):
        return acc
    done := false
    for not done:
        match iox_read_line(r):
            Some(line):
                acc = f(acc, line)
            None:
                done = true
    iox_close_lines(r)
    return acc

# Directory entry names (basenames, not full paths); [] if not a directory.
fn list(p: string) -> [string]:
    return list_dir(p)

# True if `p` names an existing entry -- ONE stat(2), via the same shim call
# is_dir uses. Until 2026-07-26 this listed the whole parent directory and checked
# membership: O(entries in the parent), blind to a `.`/`..`-only leaf (a path
# under a directory whose entries it could not enumerate), and it answered a
# question the kernel answers directly. The rewrite is a straight swap of means,
# not of meaning -- `corelib/test/io.out` records the same four answers before and
# after (FRICTION.md, the friction plan's follow-on).
#
# FAILS CLOSED, deliberately: `false` means "stat could not say yes", which folds
# an unstattable path (no search permission on a parent, a symlink loop) in with a
# missing one. That is the old behaviour too -- an unlistable parent yielded no
# entries -- and it is the safe direction for the one shape that consumes this, a
# server deciding between 200 and 404. A caller that must tell the two apart wants
# `is_dir`, whose Err(Failed) says exactly that.
fn exists(p: string) -> bool:
    k := iox_stat_kind(p)
    return k == RF_OK or k == RF_DIR
