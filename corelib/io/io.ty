package io
import "core:strings"

enum IoErr:
    NotFound           # no such path
    IsDir              # the path names a directory, not a file
    Exists             # something is already there, and it is NOT a directory
                       # (make_dir only -- see make_dir for why it needs its own
                       # variant instead of folding into Failed)
    Failed             # the path exists but could not be read (permissions, ...)
    Unsupported        # the operation has no implementation for this object on
                       # this platform/filesystem (sync only -- see sync for why
                       # this cannot be Failed)
    BadPath            # the path holds an interior NUL and names nothing -- see
                       # has_nul. NOT Failed: nothing was attempted, so a retry
                       # or a permission fix is the wrong next move.

fn has_nul(p: string) -> bool:
    for i := 0; i < len(p); i += 1:
        if p[i] == 0:
            return true
    return false

# Whole file as a string. FAIL-OPEN: "" for a missing or unreadable file, which
# is indistinguishable from a genuinely empty one. Prefer read_text below when
# the difference matters -- which is most of the time.
fn read(p: string) -> string:
    if has_nul(p):
        return ""
    return read_file(p)

# Whole file as a string, WITH the error channel read() lacks: Ok("") is a real
# empty file, Err says why there is nothing. Same three causes read_bytes
# reports, since it is read_bytes with the buffer reinterpreted -- a zero-cost
# cast of the same length-headered bytes, not a copy or a re-encode.
#
#   Ok(s)           the read happened; len(s) may be 0 for an empty file
#   Err(NotFound)   nothing is there
#   Err(IsDir)      the path names a directory
#   Err(Failed)     it exists but could not be read
fn read_text(p: string) -> Result(string, IoErr):
    if has_nul(p):
        return Err(BadPath)
    b := read_bytes(p) or_return
    return Ok(to_str(b))

fn write_bytes(p: string, b: bytes) -> Result(void, IoErr):
    if has_nul(p):
        return Err(BadPath)
    st := 0
    iox_write_bytes(p, b, &st)
    if st == RF_OK:
        return Ok()
    if st == RF_MISS:
        return Err(NotFound)
    if st == RF_DIR:
        return Err(IsDir)
    return Err(Failed)

fn write_at(p: string, off: int, b: bytes) -> Result(void, IoErr):
    if has_nul(p):
        return Err(BadPath)
    st := 0
    iox_write_at(p, off, b, &st)
    if st == RF_OK:
        return Ok()
    if st == RF_MISS:
        return Err(NotFound)
    if st == RF_DIR:
        return Err(IsDir)
    return Err(Failed)

# Truncate `p` and write `s`. Returns false if the path can't be opened.
fn write(p: string, s: string) -> bool:
    if has_nul(p):
        return false
    return write_file(p, s)

# Append `s` to `p` (creating it if absent). O_APPEND, so nothing is read back
# and the existing content is never held in memory.
fn append(p: string, s: string) -> bool:
    match append_text(p, s):
        Ok: return true
        Err(e): return false
    return false

# Append with the error channel append() lacks. The string is NOT copied on the
# way to the shim -- it travels as a pointer and a length -- which is what makes
# this the cheap way to assemble a large file from parts.
fn append_text(p: string, s: string) -> Result(void, IoErr):
    if has_nul(p):
        return Err(BadPath)
    st := 0
    iox_append_str(p, s, len(s), &st)
    return _status(st)

# Copy `src` over `dst`, truncating dst. Streaming: peak memory is the shim's
# buffer, not the file, and no byte ever becomes a Tycho value. `dst` IS NOT
# TOUCHED when `src` cannot be opened, so a caller walking a list of candidate
# sources cannot destroy its own destination with a miss.
fn copy(src: string, dst: string) -> Result(void, IoErr):
    if has_nul(src) or has_nul(dst):
        return Err(BadPath)
    st := 0
    iox_copy_file(src, dst, &st)
    return _status(st)

# The shim's status code -> the Err this package reports, in one place.
fn _status(st: int) -> Result(void, IoErr):
    if st == RF_OK:
        return Ok()
    if st == RF_MISS:
        return Err(NotFound)
    if st == RF_DIR:
        return Err(IsDir)
    return Err(Failed)

# File split into lines (core:strings.lines: CRLF-aware, a trailing newline
# adds no empty line). A missing file yields one empty line, like lines("").
fn read_lines(p: string) -> [string]:
    if has_nul(p):
        return strings.lines("")
    return strings.lines(read_file(p))

# Write each line followed by '\n' (so the file ends with a newline). The
# inverse of read_lines for newline-terminated files.
fn write_lines(p: string, lines: [string]) -> bool:
    if has_nul(p):
        return false
    out := ""
    for i := 0; i < len(lines); i += 1:
        out = out + lines[i] + "\n"
    return write_file(p, out)

# ---- streaming line reader (shim: libc getline, in io_shim.c) ---------------
# read_lines() above slurps the WHOLE file into an array, so peak memory tracks
# the file size. This reader pulls ONE line at a time into a single reused
# buffer, so peak memory is O(longest line) -- the right tool for a large log.
extern fn iox_open_lines(path: string) -> ptr        # null if the path can't be opened
extern fn iox_read_line(r: ptr) -> Option(string)    # next line (no trailing newline/CRLF); None at EOF
extern fn iox_close_lines(r: ptr)
# `status` is the read classification: 0 missing, 1 read, 2 directory, 3 other
# error. It is an `inout int`, which lowers to a tycho_int* out-param ahead of the
# two out-params the `bytes` return uses -- see the block comment on iox_read_file
# in io_shim.c.
extern fn iox_read_file(path: string, status: inout int) -> bytes
extern fn iox_read_at(path: string, off: int, n: int, status: inout int) -> bytes
# Write ALL of `b` to `path`, truncating it first -- the write side's mirror of
# iox_read_file: the same status code space, so write_bytes' Err answers match
# read_bytes' (NotFound/IsDir/Failed). All-or-nothing: a partial write is an
# error, never a short success.
extern fn iox_write_bytes(path: string, data: bytes, status: inout int)
extern fn iox_write_at(path: string, off: int, data: bytes, status: inout int)
# Same status space again. Neither call brings the payload into a Tycho value:
# copy streams the file through a fixed buffer, and append_str hands the shim the
# string's pointer and length. See copy/append_text below.
extern fn iox_copy_file(src: string, dst: string, status: inout int)
extern fn iox_append_str(path: string, data: string, n: int, status: inout int)
# stat(2): the same status codes, with 1 meaning "exists and is not a directory".
# A plain scalar return -- no `inout` needed, because nothing else occupies it.
extern fn iox_stat_kind(path: string) -> int
extern fn iox_stat_mtime(path: string, mtime: inout int) -> int
# utimensat(2): the write side of iox_stat_mtime, same status codes. No `inout` --
# the epoch second travels IN, so the return carries only the status.
extern fn iox_set_mtime(path: string, mtime: int) -> int
# stat(2) a third time, for st_size. Same shape as iox_stat_mtime -- a scalar
# payload in the `inout`, the status in the return -- but NOT the same directory
# answer: 2 (directory) is a real status here, not an Ok. See iox_stat_size in
# io_shim.c for why the two calls differ on that, and why this is a sibling
# rather than a second `inout` on iox_stat_mtime.
extern fn iox_stat_size(path: string, size: inout int) -> int
# mkdir(2) / remove(3), one entry each, in the same code space (plus FS_EXISTS).
extern fn iox_make_dir(path: string) -> int
extern fn iox_remove(path: string) -> int
# fsync(2), same code space plus FS_UNSUP. No `inout`: there is no payload, only
# a verdict, so the status keeps the return.
extern fn iox_sync(path: string) -> int

# The shim's read_file status codes, named once so read_bytes reads as prose.
const RF_MISS = 0
const RF_OK   = 1
const RF_DIR  = 2
# make_dir only: occupied by a non-directory. See iox_make_dir in io_shim.c.
const FS_EXISTS = 4
# sync only: it is there, and this platform cannot flush it. See iox_sync.
const FS_UNSUP = 5

fn read_bytes(p: string) -> Result(bytes, IoErr):
    if has_nul(p):
        return Err(BadPath)
    st := 0
    b := iox_read_file(p, &st)
    if st == RF_OK:
        return Ok(b)
    if st == RF_MISS:
        return Err(NotFound)
    if st == RF_DIR:
        return Err(IsDir)
    return Err(Failed)

fn read_at(p: string, off: int, n: int) -> Result(bytes, IoErr):
    if has_nul(p):
        return Err(BadPath)
    st := 0
    b := iox_read_at(p, off, n, &st)
    if st == RF_OK:
        return Ok(b)
    if st == RF_MISS:
        return Err(NotFound)
    if st == RF_DIR:
        return Err(IsDir)
    return Err(Failed)

fn is_dir(p: string) -> Result(bool, IoErr):
    if has_nul(p):
        return Err(BadPath)
    k := iox_stat_kind(p)
    if k == RF_DIR:
        return Ok(true)
    if k == RF_OK:
        return Ok(false)
    if k == RF_MISS:
        return Err(NotFound)
    return Err(Failed)

# When `p` was last modified, in whole seconds since the UNIX epoch -- the same
# clock `now()` reads, so `now() - mtime(p)` is an age in seconds and
# `datetime.from_unix` turns the value into a date directly.
#
#   Ok(secs)        stat(2) answered
#   Err(NotFound)   nothing is there
#   Err(Failed)     it is there and could not be stat'ed (no search permission on
#                   a parent, a symlink loop, ...)
#
# Note which variant is ABSENT, for the same reason it is absent from is_dir: a
# DIRECTORY IS Ok HERE, not Err(IsDir). A directory has a modification time and
# stat(2) reports it; refusing to pass it up would be this module throwing away a
# field the kernel already filled in, which is the exact defect this call exists
# to fix. Err(IsDir) belongs to read_bytes, where the request really is
# impossible to satisfy.
#
# WHOLE SECONDS. stat(2) carries nanoseconds on Linux and this drops them, on
# purpose: an HTTP-date is whole seconds, `now()` is whole seconds, and there is
# no caller in the tree that could use the rest. See iox_stat_mtime in
# io_shim.c for the note on adding it if one appears.
#
# This is one stat(2) per call and it does NOT share the one is_dir/exists makes.
# A caller doing both pays two; a conditional GET that answers 304 pays exactly
# this one and never opens the file.
fn mtime(p: string) -> Result(int, IoErr):
    if has_nul(p):
        return Err(BadPath)
    secs := 0
    k := iox_stat_mtime(p, &secs)
    if k == RF_OK:
        return Ok(secs)
    if k == RF_MISS:
        return Err(NotFound)
    return Err(Failed)

fn set_mtime(p: string, secs: int) -> Result(void, IoErr):
    if has_nul(p):
        return Err(BadPath)
    k := iox_set_mtime(p, secs)
    if k == RF_OK:
        return Ok()
    if k == RF_MISS:
        return Err(NotFound)
    return Err(Failed)

# How many bytes `p` holds, WITHOUT READING THEM. Until this existed the only way
# to ask was `len(read_bytes(p))`, which reads a gigabyte to learn that it is a
# gigabyte -- the same defect read_at above was added to remove, and a Range
# server built on it would allocate exactly what read_at stopped allocating.
#
#   Ok(n)           `p` is a regular file of n bytes
#   Err(NotFound)   nothing is there
#   Err(IsDir)      the path names a directory
#   Err(Failed)     it is there and has no byte length -- unstattable, or a fifo,
#                   socket or device
#
# Ok(0) IS A SUCCESS AND IT IS NOT THE FAILURE VALUE. An empty file has a length
# and that length is zero. The status rides the shim's return rather than the
# payload (see iox_stat_size in io_shim.c), so `0` is never what a failure looks
# like -- a failure is an Err and cannot be mistaken for a small file. This is the
# case a static server meets for real: a 0-byte asset must serve a 200 with
# `Content-Length: 0`, not a 500.
#
# A DIRECTORY IS Err(IsDir) HERE, WHICH IS THE OPPOSITE OF mtime ABOVE, and the
# difference is not an inconsistency. mtime returns Ok for a directory because a
# directory HAS a modification time and stat(2) reports the real one; refusing it
# would throw away an answer. st_size on a directory is not the answer to this
# question at all -- it is the size of the directory's own entry structure (4096
# on ext4, filesystem-dependent everywhere), not a count of readable bytes. So
# this is not withholding an answer, it is refusing to report a number that is not
# one. The test that settles it: size(p) is the length read_bytes(p) would return,
# and read_bytes on a directory is Err(IsDir) too. The two agree on every path.
#
# ONE stat(2), NOT SHARED with mtime's and not with read_at's fstat. A caller
# wanting size and mtime pays two; a caller wanting size and then a slice pays a
# stat and then a read, and it needs the size FIRST -- a 416 answer emits the
# length and reads nothing, and a suffix range needs the length to know where to
# start. See iox_stat_size in io_shim.c for the caller count behind the split.
fn size(p: string) -> Result(int, IoErr):
    if has_nul(p):
        return Err(BadPath)
    n := 0
    k := iox_stat_size(p, &n)
    if k == RF_OK:
        return Ok(n)
    if k == RF_MISS:
        return Err(NotFound)
    if k == RF_DIR:
        return Err(IsDir)
    return Err(Failed)

fn make_dir(p: string) -> Result(bool, IoErr):
    if has_nul(p):
        return Err(BadPath)
    k := iox_make_dir(p)
    if k == RF_OK:
        return Ok(true)
    if k == RF_DIR:
        return Ok(false)
    if k == FS_EXISTS:
        return Err(Exists)
    if k == RF_MISS:
        return Err(NotFound)
    return Err(Failed)

# `mkdir -p`: create every missing component of `p`. `Ok(true)` if at least one
# was created, `Ok(false)` if they all already existed -- the same "did I do
# anything" boolean `make_dir` returns, so a caller can tell a fresh tree from a
# reused one. `Err` names the FIRST component that failed and stops there.
fn make_dir_all(p: string) -> Result(bool, IoErr):
    if has_nul(p):
        return Err(BadPath)
    if len(p) == 0 or p == "." or p == "/":
        return Ok(false)
    rooted := p[0] == 47
    parts := split(p, "/")
    cur := ""
    made := false
    for i := 0; i < len(parts); i += 1:
        seg := parts[i]
        if len(seg) == 0 or seg == ".":
            continue
        if len(cur) == 0:
            if rooted:
                cur = "/" + seg
            else:
                cur = seg
        else:
            cur = cur + "/" + seg
        # A Windows drive letter ("C:") is a ROOT, not a creatable directory:
        # mkdir("C:") fails, so seeding `cur` with it and moving on is what makes
        # an absolute Windows destination work at all. Guarded to the first
        # segment of a non-rooted path, exactly two characters, a letter then
        # ':', so a POSIX directory named that way lower down is unaffected.
        # (A UNC root, //host/share, is not handled.)
        alpha := (seg[0] >= 65 and seg[0] <= 90) or (seg[0] >= 97 and seg[0] <= 122)
        drive := len(seg) == 2 and seg[1] == 58 and alpha
        if cur == seg and drive:
            continue
        did := make_dir(cur) or_return
        if did:
            made = true
    return Ok(made)

fn remove(p: string) -> Result(bool, IoErr):
    if has_nul(p):
        return Err(BadPath)
    k := iox_remove(p)
    if k == RF_OK:
        return Ok(true)
    if k == RF_MISS:
        return Ok(false)
    return Err(Failed)

# Flush `p` to the STORAGE DEVICE and return only once the kernel says it landed
# -- fsync(2). Every other writer in this module returns once close(2) succeeded,
# which reaches the page cache and stops: enough that a later process, including
# one started after a SIGKILL, reads the bytes, and NOT enough that they survive
# the machine losing power. This is the call that closes that gap.
#
#   Ok()              the device acknowledged the flush
#   Err(NotFound)     nothing is there
#   Err(Unsupported)  it is there and has no flush on this platform/filesystem
#   Err(Failed)       the flush was attempted and FAILED -- EIO, a dead device,
#                     ENOSPC on a delayed-allocation filesystem. THE WRITE IS
#                     LOST; this is not a retryable hiccup.
#
# A DIRECTORY IS Ok, NOT Err(IsDir), and that is the whole reason this signature
# takes a path rather than being bolted onto a writer. A file's CONTENTS and a
# file's NAME are two different pieces of disk. Syncing the file flushes the
# contents; the directory entry naming them is flushed only by syncing the PARENT
# DIRECTORY. Sync a freshly CREATED file and not its parent, and a power cut can
# hand back a file that does not exist -- data intact, unreachable. So a durable
# create is TWO calls, and this is both of them:
#
#   io.write_bytes(f, b) or_return
#   io.sync(f) or_return                 # the bytes
#   io.sync(path.dir(f)) or_return       # the NAME -- only needed on create
#
# The second sync is needed when the entry appears or disappears (create, remove,
# rename), not on every later write to a file that already exists -- which is why
# it is the caller's separate call and not a hidden syscall inside this one. An
# appending log pays it once and syncs only the file thereafter.
#
# WHY THIS, AND NOT A `write_bytes_synced(p, b)`. A bundled writer looked like the
# safer surface and is the more dangerous one, for three reasons that all point
# the same way. It does not fit the caller that demanded this: tycho-db's log
# appends with `write_at`, so a whole-file bundled call could not have served it,
# and bundling consistently would mean a synced twin of all five writers here
# rather than one orthogonal verb that composes with each. And -- decisively -- no
# name of that shape can carry the paragraph above: `write_bytes_synced` reads as
# "this is now durable" while the file's NAME may still not be, so it would ship
# the classic mistake with a label promising the opposite. One `sync` that makes
# the second call visible is the honest surface.
#
# Err(Unsupported) IS SEPARATE FROM Err(Failed) for make_dir's Exists reason: one
# failed syscall, two opposite next moves. Failed means the data is gone and a log
# that shrugs has already lied. Unsupported means the data is exactly where every
# other core:io writer leaves it and the platform has nothing stronger to offer,
# so a caller may fall back to the process-death guarantee AND SAY SO. Note what
# it is NOT: a silent Ok. A no-op reported as success would rebuild the same false
# durability claim one layer down, where nothing can see it.
fn sync(p: string) -> Result(void, IoErr):
    if has_nul(p):
        return Err(BadPath)
    k := iox_sync(p)
    if k == RF_OK:
        return Ok()
    if k == RF_MISS:
        return Err(NotFound)
    if k == FS_UNSUP:
        return Err(Unsupported)
    return Err(Failed)

# Open a streaming line reader over `path`. Returns a null ptr (check is_null) if
# the file can't be opened. Pair every successful open with close_lines(r).
fn open_lines(path: string) -> ptr:
    if has_nul(path):
        return null
    return iox_open_lines(path)

# The next line, without its trailing newline (or CRLF), or None at end of file.
# An empty line is Some("") -- distinct from EOF's None.
fn read_line(r: ptr) -> Option(string):
    return iox_read_line(r)

# Close a reader opened with open_lines (frees the file handle + line buffer).
fn close_lines(r: ptr):
    iox_close_lines(r)

# Bounded-memory streaming fold: reduce every line of `path` into `init` via
# f(acc, line), one line at a time (peak memory O(longest line), not O(file)).
# Best for scalar / small accumulators -- a large heap accumulator copied per
# line is O(n^2); for that, use an open_lines/read_line loop that mutates in
# place. A path that can't be opened folds to `init` unchanged.
fn fold_lines(path: string, init: $A, f: fn($A, string) -> $A) -> $A:
    if has_nul(path):
        return init
    r := iox_open_lines(path)
    acc := init
    if is_null(r):
        return acc
    done := false
    for not done:
        match iox_read_line(r):
            Some(line):
                acc = f(acc, line)
            None:
                done = true
    iox_close_lines(r)
    return acc

# Directory entry names (basenames, not full paths); [] if not a directory.
fn list(p: string) -> [string]:
    if has_nul(p):
        return []string
    return list_dir(p)

fn exists(p: string) -> bool:
    if has_nul(p):
        return false
    k := iox_stat_kind(p)
    return k == RF_OK or k == RF_DIR
