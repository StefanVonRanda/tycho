package http

extern fn http_get(url: string) -> ptr
extern fn http_post_bytes(url: string, body: bytes, content_type: string) -> ptr
extern fn http_status(resp: ptr) -> int
extern fn http_body(resp: ptr) -> string
extern fn http_body_bytes(resp: ptr) -> bytes
extern fn http_free(resp: ptr)

fn has_nul(s: string) -> bool:
    for i := 0; i < len(s); i += 1:
        if s[i] == 0:
            return true
    return false

# Perform a GET. Returns a response handle, or null on a transport failure --
# which is also the answer for a URL carrying an interior NUL: a truncated URL is
# not a shorter one, it is a different one.
fn get(url: string) -> ptr:
    if has_nul(url):
        return null
    return http_get(url)

# Perform a POST with a request body and Content-Type (e.g. "application/json").
# The BODY may carry interior NULs and every byte of it is sent: it crosses as
# (ptr, len), so Content-Length is len(body). A NUL in the URL or the
# Content-Type is still refused -- a truncated URL is not a shorter one, it is a
# different one, and a header cannot carry a NUL at all.
fn post(url: string, body: string, content_type: string) -> ptr:
    if has_nul(url) or has_nul(content_type):
        return null
    return http_post_bytes(url, to_bytes(body), content_type)

# The binary-safe sibling of post(): a `bytes` body, for a PNG or a protobuf.
fn post_bytes(url: string, body: bytes, content_type: string) -> ptr:
    if has_nul(url) or has_nul(content_type):
        return null
    return http_post_bytes(url, body, content_type)

# Did the request reach the server (a handle, even for a 4xx/5xx status)?
fn ok(resp: ptr) -> bool:
    return is_null(resp) == false

# The HTTP status code (e.g. 200), or 0 if the request never completed.
fn status(resp: ptr) -> int:
    if is_null(resp):
        return 0
    return http_status(resp)

# The response body ("" if the request failed). Arena-copied; see the NUL note.
fn body(resp: ptr) -> string:
    if is_null(resp):
        return ""
    return http_body(resp)

# The response body as BYTES: the full byte length, interior NULs preserved
# (body() truncates at the first NUL -- this is the binary-safe sibling).
fn body_bytes(resp: ptr) -> bytes:
    if is_null(resp):
        return to_bytes([]int)
    return http_body_bytes(resp)

# Free a response handle (C-owned memory; call exactly once).
fn release(resp: ptr):
    if is_null(resp) == false:
        http_free(resp)

# Convenience: GET a URL and return just the body ("" on failure); frees the handle.
fn get_body(url: string) -> string:
    if has_nul(url):
        return ""
    r := http_get(url)
    if is_null(r):
        return ""
    b := http_body(r)
    http_free(r)
    return b

# Convenience: GET a URL and return just the status code (0 on failure); frees the handle.
fn get_status(url: string) -> int:
    if has_nul(url):
        return 0
    r := http_get(url)
    if is_null(r):
        return 0
    s := http_status(r)
    http_free(r)
    return s
